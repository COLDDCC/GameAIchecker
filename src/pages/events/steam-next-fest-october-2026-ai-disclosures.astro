---
import { getAllGames } from '../../lib/games.js';
import { areaNames } from '../../lib/english.js';
import { siteHead, siteHeader, siteFooter } from '../../lib/site-chrome.js';
// Path of the Yaoguai is also named in the cited early-festival research sample.
const additions = new Set(['3739350']);
const games=getAllGames().filter(g=>(g.event || additions.has(String(g.appId))) && g.status==='official_disclosure').sort((a,b)=>a.name.localeCompare(b.name));
const canonical='https://gameaichecker.com/events/steam-next-fest-october-2026-ai-disclosures/';
const title='Steam Next Fest October 2026 games with AI disclosures | Game AI Checker';
const description='Reviewed Steam Next Fest October 2026 game records with official AI disclosures. Read original wording, scope and dates. Not a complete festival list.';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/logo.svg" type="image/svg+xml"/><meta name="theme-color" content="#ffffff"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://gameaichecker.com/og-home.png"/><meta name="twitter:card" content="summary_large_image"/><Fragment set:html={siteHead()}/></head>
<body><Fragment set:html={siteHeader({current:'nextfest', lang:'en', langSwitch:false})}/>
<main id="content">
<section class="wrap page-head">
<h1>Next Fest games with official AI disclosures</h1>
<p class="lead">{games.length} event-linked games in our reviewed catalogue disclose AI use. This is a selected evidence directory, not a census of Steam Next Fest or a ranking of game quality. Open a game for its original wording and review date.</p>
<p class="lead"><a href="/events/steam-next-fest-october-2026/">All Next Fest records</a> · <a href="/guides/how-to-check-steam-game-ai/">How to check a Steam AI disclosure</a></p>
</section>
<div class="wrap">
<ul class="cards">{games.map(g=><li class="disclosed"><a class="card" href={`/games/${g.slug}/`}><div class="cover"><span class="cover-label" aria-hidden="true">{g.name}</span>{g.header && <img src={g.header} alt="" loading="lazy" decoding="async" width="460" height="215" onerror="this.remove()"/>}</div><div class="card-body"><h3>{g.name}</h3><p class="meta">{g.developer}{g.reviewedAt ? ` · Reviewed ${g.reviewedAt}` : ''}</p>{g.usedAreas.length ? <ul class="areas" aria-label="Disclosed areas">{g.usedAreas.map(a=><li>{areaNames[a.key] || a.key}</li>)}</ul> : <p class="note">AI use disclosed; specific areas not stated.</p>}</div></a></li>)}</ul>
<details class="box"><summary>Selection and limits</summary><p>Each entry has an existing reviewed game record, an event link in our catalogue and official disclosure status. Full-game and demo App IDs remain distinct: the record describes the full game unless its source explicitly identifies the demo.</p><p>Additional event evidence: <a href="https://howtomarketagame.com/2026/10/21/how-sloppy-is-the-october-2026-steam-next-fest/">dated Next Fest research naming Path of the Yaoguai</a>.</p><p>Event context: <a href="https://partner.steamgames.com/doc/marketing/upcoming_events/nextfest/2026october">Valve's October 2026 Next Fest documentation</a>. Developer disclosures are self-reports. No disclosure does not prove zero AI use.</p></details>
<p><a href="/browse/">Browse all reviewed games</a></p>
</div>
</main>
<Fragment set:html={siteFooter({lang:'en'})}/>
</body></html>

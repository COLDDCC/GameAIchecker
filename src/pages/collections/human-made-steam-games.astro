---
import {getAllGames} from '../../lib/games.js';
import {siteHead, siteHeader, siteFooter} from '../../lib/site-chrome.js';
const games=getAllGames().filter(g=>g.status==='human_made').sort((a,b)=>a.name.localeCompare(b.name));
const names={ingame:'In-game generation',code:'Code',art:'Art',music:'Music',voice:'Voice',writing:'Writing',translation:'Translation',marketing:'Marketing'};
const canonical='https://gameaichecker.com/collections/human-made-steam-games/';
const title='Steam games with human-made and no-AI claims | Game AI Checker';
const description='Compare source-backed human-made claims for Steam games. See who made the claim, which areas it covers, and whether the site owner reviewed the listing.';
const siteReviewed=g=>g.humanMadeListing?.kind==='site_owner_review' && g.humanMadeListing?.verified;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/logo.svg"/><meta name="theme-color" content="#ffffff"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://gameaichecker.com/og-home.png"/><meta name="twitter:card" content="summary_large_image"/><Fragment set:html={siteHead()}/></head>
<body><Fragment set:html={siteHeader({current:'', lang:'en', langSwitch:false})}/>
<main id="content">
<section class="wrap page-head">
<h1>Steam games with human-made claims</h1>
<p class="lead">{games.length} reviewed records include a human-made claim. These are attributed claims: a statement about artwork does not certify code, music or every other area. Site-owner reviews are labeled separately and are not third-party certification.</p>
</section>
<div class="wrap">
<ul class="cards">{games.map(g=>{const claimed=g.areas.filter(a=>a.state==='claimed_none').map(a=>names[a.key]);return <li class="human"><a class="card" href={`/games/${g.slug}/`}><div class="cover"><span class="cover-label" aria-hidden="true">{g.name}</span>{g.header && <img src={g.header} alt="" loading="lazy" decoding="async" width="460" height="215" onerror="this.remove()"/>}</div><div class="card-body"><h3>{g.name}</h3><p class="meta">{g.developer}{g.reviewedAt ? ` · Reviewed ${g.reviewedAt}` : ''}</p>{claimed.length ? <ul class="areas" aria-label="Areas the claim covers">{claimed.map(a=><li>{a}</li>)}</ul> : <p class="note">Areas: see the original statement</p>}<span class="tag">{siteReviewed(g)?'Site owner review passed':'Developer self-report'}</span></div></a></li>})}</ul>
<details class="box"><summary>What this list establishes</summary><p>Each entry is selected from an existing reviewed record classified as a human-made claim. Inclusion is not a technical audit of the game's files or development history. Read the dated original statement and area notes before treating a claim as covering a particular production area.</p></details>
<p><a href="/guides/how-to-check-steam-game-ai/">How to check if a Steam game uses AI</a> · <a href="/events/steam-next-fest-october-2026-ai-disclosures/">Next Fest games with official AI disclosures</a> · <a href="/browse/">All reviewed games</a></p>
</div>
</main>
<Fragment set:html={siteFooter({lang:'en'})}/>
</body></html>

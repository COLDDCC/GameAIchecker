---
import { getAllGames } from '../../../lib/games.js';
import { languages } from '../../../lib/i18n.js';
import GameDetail from '../../../components/GameDetail.astro';
export function getStaticPaths() { return getAllGames().flatMap(game => languages.filter(lang=>lang!=='en').map(lang=>({params:{lang,slug:game.slug},props:{game,lang}}))); }
const { game, lang } = Astro.props;
---
<GameDetail game={game} lang={lang} />

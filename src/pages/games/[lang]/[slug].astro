---
import { getAllGames } from '../../../lib/games.js';
import { languages } from '../../../lib/i18n.js';
import GameDetail from '../../../components/GameDetail.astro';
export function getStaticPaths() {
  return getAllGames().flatMap(game => languages.map(lang => ({ params: { lang, slug: game.slug }, props: { game } })));
}
---
<GameDetail game={Astro.props.game} />

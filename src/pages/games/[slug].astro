---
import { getAllGames } from '../../lib/games.js';

export function getStaticPaths() {
  return getAllGames().map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
// Batch 01–02: preserve the compact refresh when Astro regenerates these pages.
const batchDetailRefresh = ["1853440-tropico-7","1889620-ai-roguelite","2295170-emberville","2800150-ai-roguelite-2d","2861080-haunted-paws","2870790-dumpster-gang","3421660-re-blade","3517740-frostrail","3519780-queen-s-cards","3629430-dreadmoor",
  // Batch 02
  "3642910-wyldheart","3670600-hexitten","3680170-mortuus","3782550-another-where","4106650-palaxin","4163270-half-grip","4348910-probably-stolen-cyberpunk-shopkeeper-sim","4487060-northgard-battlegrounds","4541470-deadzone-rogue-2-demo","4544110-project-vanguard",
  // Next Fest / player-report pages reviewed in later batches
  "2958550-deeper","3218230-archeage-chronicles","3884860-the-wolf-among-us-remastered","5200400-meat-safari","4858850-crown-cribbage","4189910-dice-in-you","2275940-rogue-hex","5012840-tooth-for-tooth","2456740-inzoi","2073850-the-finals","4949400-my-cat-scattered-games-tidy-videogame-supermarket","3265900-electronics-repair-shop","3907570-silent-authority-blood-bourbon","3837790-fathoms","5285080-stick-life-the-daily-grind","5344070-blockia","5393000-fish-with-friends","4570020-foursavent","3093990-fire-isle","4225280-corpus-et-spiritus","3465440-citadrill","4210140-brofish","4142360-paradox-tower","5272230-station-12","3432860-psycho-sleuth","5285650-warstead","4929280-act-normal","1975650-the-idle-undead","5073550-bat-flapper","3717830-grindworm","3078120-reality-drift","1889700-archrebel-tactics","2708040-keelblade-formerly-triarchy","4180840-shadowstone","4484810-winter-whiskers","3419080-the-regreening","3405680-teamcrafter","4826820-desktop-factory","2677980-choppy-waters","4490840-lurking","4450660-flick","4553100-feed-me-more-brains","4709270-deepward","864170-midnight-horde","4395320-logisticats","4093320-beastfolk-barber","4110770-apple-crumble","4462580-blighten","3616280-mr-magpie-s-harmless-card-game","4264000-orion-blue","4045480-drawquarium","3161310-hela-of-mice-magic","4410710-fields-of-aaru","4521650-farm-feast","3796150-curse-of-resthaven","4058300-deep-siren","4943260-tin-coffins","3109590-cat-cafe-manager-2-big-city-bliss","3284200-muri-wildwoods","2153760-stronghold-4","3218350-melvor-idle-2","5160800-find-the-needle","2988120-never-be-alone","3734220-guns-of-eschaton"] .includes(game.slug);
const site = (Astro.site?.toString() || 'https://gameaichecker.com').replace(/\/$/, '');
const canonical = `${site}/games/${game.slug}/`;

function formatDate(value) {
  if (!value) return '待核实';
  const iso = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return `${Number(iso[1])} 年 ${Number(iso[2])} 月 ${Number(iso[3])} 日`;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return String(value);
  return `${date.getFullYear()} 年 ${date.getMonth() + 1} 月 ${date.getDate()} 日`;
}

function formatShortDate(value) {
  if (!value) return '';
  const iso = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return String(value);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function host(value) {
  try {
    return new URL(value).hostname.replace(/^www\./, '');
  } catch {
    return value;
  }
}

function absolute(value) {
  if (!value) return `${site}/logo.svg`;
  return value.startsWith('http') ? value : `${site}${value}`;
}

function areaNote(area, game) {
  if (game.aiAreaNotes?.[area.key]) return game.aiAreaNotes[area.key];
  if (area.state === 'used') return game.aiAreaSources?.[area.key] === 'third_party' ? '第三方资料将此领域标为使用 AI；本站尚未独立核实。' : '官方披露或开发者声明中提及该领域使用生成式 AI。';
  if (area.state === 'claimed_none') return '开发者公开声称游戏为人工制作；这是开发者声明，未经独立审计。';
  if (area.state === 'none') return '有明确来源称该领域未使用 AI。';
  if (area.state === 'not_stated') return '现有官方披露未单独提及该领域，不代表确认未使用。';
  return '尚未完成可靠来源核查。';
}

const statusExplanation = game.humanMadeListing?.kind === 'site_owner_review' && game.humanMadeListing?.verified
  ? '本站负责人已审查并确认本作为 0 AI；该结论属于本站审核，并非第三方独立认证。'
  : {
  official_disclosure: '开发者已在官方渠道披露生成式 AI 使用；具体范围以原始来源为准。',
  human_made: '开发者公开声称游戏为人工制作；这是开发者声明，不是独立审计。',
  no_evidence: '本次审查未找到可核实的生成式 AI 生产声明；这不等于确认零 AI 使用。',
  community: '来自玩家投稿，尚未完成来源核查。',
  unreviewed: '尚无足够来源完成核查；未提及不等于没有使用。',
}[game.status];

const primarySource = game.evidence.find((item) => item.type === 'official_disclosure') || game.evidence.find((item) => item.url) || null;
const usedCount = game.usedAreas.length;
const claimedCount = game.areas.filter((area) => area.state === 'claimed_none').length;
const isBroadHumanClaim = claimedCount === game.areas.length && claimedCount > 0 && Boolean(game.disclosureQuote);
const hero = game.images[0] || null;
const overviewTags = Array.from(new Set([...game.tags, ...game.features])).filter(Boolean).slice(0, 8);
const ogImage = absolute(game.images[0]?.full || game.header);
const metaDescription = (game.summary || game.steamDescription || `${game.name} 的 Steam 资料、AI 使用披露与证据。`)
  .replace(/\s+/g, ' ')
  .slice(0, 155);

const correctionUrl = `https://github.com/COLDDCC/GameAIchecker/issues/new?title=${encodeURIComponent(
  `${game.name}（${game.appId || '待核实'}）页面纠错`
)}&body=${encodeURIComponent(
  `页面：${canonical}\n\n需要纠正的内容：\n\n原始来源：\n\n日期：\n`
)}`;

const shareText = `${game.name} 的 AI 使用情况与证据`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.name,
  url: canonical,
  image: game.images.slice(0, 4).map((image) => absolute(image.full)),
  description: game.summary || game.steamDescription || undefined,
  applicationCategory: game.genres.join(', ') || 'Game',
  operatingSystem: game.platforms?.join(', ') || undefined,
  author: game.developer ? { '@type': 'Organization', name: game.developer } : undefined,
  publisher: game.publisher ? { '@type': 'Organization', name: game.publisher } : undefined,
  datePublished: game.releaseISO || undefined,
  sameAs: game.steamUrl || undefined,
};
if (game.priceValue != null) {
  jsonLd.offers = {
    '@type': 'Offer',
    price: game.priceValue,
    priceCurrency: game.priceCurrency || 'CNY',
    url: game.steamUrl || canonical,
  };
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: '游戏库', item: `${site}/games/` },
    { '@type': 'ListItem', position: 3, name: game.name, item: canonical },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <meta name="theme-color" content="#ffffff" />
  <title>{game.name} AI 使用情况、证据与资料 | Game AI Checker</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Game AI Checker" />
  <meta property="og:title" content={`${game.name} — AI 使用情况与证据`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${game.name} — AI 使用情况与证据`} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c')} />
  <style is:global>
    .human-made-spotlight {border:1px solid #f2d7a6;border-radius:13px;padding:13px 15px;background:#fffdf8;margin:10px 0 16px;font-size:13px}
    .human-made-spotlight-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px;font-size:11px;color:#94600a;font-weight:700}
    .human-made-pending{border:1px solid #f2d7a6;border-radius:99px;padding:2px 8px}
    .human-made-spotlight>strong{display:block;font-size:14px}
    .human-made-spotlight p{color:#667085;margin:5px 0 8px;line-height:1.5}
    .human-made-spotlight details{margin:7px 0}.human-made-spotlight summary{cursor:pointer;color:#94600a;font-weight:600}
    .human-made-spotlight>a{font-weight:600;font-size:12px}
    :root {
      --blue: #1f8fff;
      --blue-dark: #0879d8;
      --ink: #182437;
      --muted: #667085;
      --line: #e5eaf0;
      --soft: #f8fafc;
      --radius: 18px;
      --amber: #b45309;
      --amber-bg: #fffbeb;
      --green: #047857;
      --green-bg: #ecfdf5;
      --gray: #475467;
      --gray-bg: #f2f4f7;
      --blue-bg: #eff6ff;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #fff;
      color: var(--ink);
      font: 15px/1.6 system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    }
    a { color: var(--blue-dark); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; }
    .wrap { max-width: 1240px; margin: auto; padding: 0 24px; }
    .top {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .top-inner { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; color: var(--ink); font-size: 17px; }
    .brand:hover { text-decoration: none; }
    .brand img { width: 38px; height: 32px; }
    .brand span { color: var(--blue); }
    .top-nav { display: flex; gap: 18px; flex-wrap: wrap; }
    .top-nav a { font-size: 13px; color: var(--muted); }
    .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; color: var(--muted); margin: 20px 0 14px; }
    .crumbs a { color: var(--muted); }
    .game-top { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.9fr); gap: 34px; align-items: start; }
    .media-col { min-width: 0; }
    .hero-media {
      position: relative;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      background: #f2f6fa;
      aspect-ratio: 16 / 9;
    }
    .hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: zoom-in; }
    .media-placeholder { height: 100%; display: grid; place-content: center; text-align: center; color: var(--muted); padding: 24px; }
    .media-controls {
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      justify-content: flex-end;
    }
    .media-controls button,
    .media-controls span {
      background: rgba(24, 36, 55, 0.86);
      color: #fff;
      border: 0;
      border-radius: 8px;
      padding: 7px 10px;
      font: inherit;
      font-size: 13px;
    }
    .media-controls button { cursor: pointer; }
    .media-open {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(24, 36, 55, 0.8);
      color: #fff;
      border: 0;
      border-radius: 8px;
      width: 36px;
      height: 36px;
      cursor: pointer;
      font-size: 16px;
    }
    .thumbs { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0 2px; scrollbar-width: thin; }
    .thumb {
      flex: 0 0 100px;
      border: 2px solid transparent;
      border-radius: 9px;
      overflow: hidden;
      padding: 0;
      background: #f5f7fa;
      cursor: pointer;
      aspect-ratio: 16 / 9;
    }
    .thumb.active { border-color: var(--blue); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .media-foot { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); padding-top: 8px; }
    .media-credit { font-size: 11px; color: var(--muted); margin: 2px 0 0; }
    .game-overview { margin-top: 18px; padding: 18px; background: var(--soft); border: 1px solid var(--line); border-radius: 14px; }
    .game-overview h2 { font-size: 18px; line-height: 1.3; margin: 0 0 8px; letter-spacing: -0.01em; }
    .game-overview p { margin: 0; color: #475467; font-size: 14px; line-height: 1.7; }
    .overview-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
    .overview-tags span { background: #fff; border: 1px solid var(--line); color: #344054; border-radius: 999px; padding: 5px 9px; font-size: 12px; }
    .overview-source { display: inline-block; margin-top: 12px; font-size: 12px; font-weight: 600; }
    .fact-details summary { cursor: pointer; color: var(--blue-dark); font-size: 12px; font-weight: 600; }
    .fact-details p { margin: 8px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .fact-details .link-list { margin-top: 8px; }
    .videos { margin-top: 18px; }
    .mini-title { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 10px; }
    .video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
    .video-card { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; color: var(--ink); font-size: 12px; }
    .video-card:hover { text-decoration: none; border-color: #c7d2e0; }
    .video-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
    .video-card span { display: block; padding: 8px 10px; color: var(--muted); }
    .trailer { width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; background: #0b1020; margin-bottom: 8px; display: block; }
    .info-col { padding-top: 4px; }
    .status-badge { display: inline-block; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700; margin-bottom: 12px; }
    .tone-red { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }
    .tone-amber { background: var(--amber-bg); color: var(--amber); border: 1px solid #fde68a; }
    .tone-green { background: var(--green-bg); color: var(--green); border: 1px solid #a7f3d0; }
    .tone-blue { background: var(--blue-bg); color: #1d4ed8; border: 1px solid #bfdbfe; }
    .tone-gray { background: var(--gray-bg); color: var(--gray); border: 1px solid #e4e7ec; }
    h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 8px; }
    .byline { color: var(--muted); font-size: 14px; margin: 0 0 14px; }
    .lede { font-size: 15px; line-height: 1.65; color: #344054; margin: 0 0 14px; }
    .ai-chips { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 18px; }
    .chip { background: var(--gray-bg); border: 1px solid var(--line); color: var(--gray); border-radius: 999px; padding: 5px 10px; font-size: 12px; }
    .chip.used { background: var(--amber-bg); border-color: #fde68a; color: var(--amber); font-weight: 600; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--ink);
      border-radius: 10px;
      padding: 10px 14px;
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }
    .btn:hover { text-decoration: none; border-color: #c7d2e0; }
    .btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
    .btn.primary:hover { background: var(--blue-dark); }
    .btn.active { background: var(--amber-bg); border-color: #fde68a; color: var(--amber); }
    .facts { margin: 0; border-top: 1px solid var(--line); }
    .facts > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
    .facts dt { color: var(--muted); }
    .facts dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }
    .facts code { background: var(--gray-bg); border-radius: 6px; padding: 2px 6px; font-size: 12px; }
    .copy { margin-left: 6px; border: 1px solid var(--line); background: #fff; border-radius: 6px; padding: 2px 7px; font-size: 11px; cursor: pointer; }
    .clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .link-list { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12px; }
    .section-nav {
      position: sticky;
      top: 64px;
      z-index: 20;
      display: flex;
      gap: 6px;
      overflow-x: auto;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 9px 0;
      margin: 30px 0 22px;
      scrollbar-width: none;
    }
    .section-nav::-webkit-scrollbar { display: none; }
    .section-nav a { white-space: nowrap; font-size: 13px; color: var(--muted); padding: 6px 10px; border-radius: 8px; }
    .section-nav a.active { background: var(--blue-bg); color: #1d4ed8; font-weight: 600; text-decoration: none; }
    .section { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; margin: 18px 0; background: #fff; scroll-margin-top: 130px; }
    .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 14px; }
    .eyebrow { font-size: 11px; letter-spacing: 0.12em; color: var(--blue-dark); font-weight: 800; margin-bottom: 4px; }
    h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); margin: 0; letter-spacing: -0.02em; }
    .section-meta { font-size: 12px; color: var(--muted); white-space: nowrap; }
    .section-lede { color: var(--muted); margin: 0 0 18px; max-width: 900px; }
    .section-link { font-size: 13px; }
    .status-note { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; border-radius: 10px; padding: 11px 14px; margin: 0 0 16px; font-size: 13px; }
    .status-note strong { font-size: 12px; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
    .ai-table { width: 100%; border-collapse: collapse; min-width: 680px; font-size: 13px; }
    .ai-table th { text-align: left; padding: 11px 14px; background: var(--soft); color: var(--muted); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid var(--line); }
    .ai-table td { padding: 13px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .ai-table tr:last-child td { border-bottom: 0; }
    .ai-table td strong { display: block; }
    .ai-table td small { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }
    .muted { color: var(--muted); }
    .state { display: inline-block; border-radius: 999px; padding: 4px 9px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .s-used { background: var(--amber-bg); color: var(--amber); border: 1px solid #fde68a; }
    .s-not_stated { background: var(--gray-bg); color: var(--gray); border: 1px solid #e4e7ec; }
    .s-claimed_none, .s-none { background: var(--green-bg); color: var(--green); border: 1px solid #a7f3d0; }
    .s-unreviewed { background: var(--gray-bg); color: var(--gray); border: 1px solid #e4e7ec; }
    .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--muted); margin: 12px 0 0; }
    .legend span { display: inline-flex; align-items: center; gap: 6px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .dot.used { background: #d97706; }
    .dot.not_stated { background: #98a2b3; }
    .dot.claimed_none { background: #059669; }
    .dot.unreviewed { background: #cbd5e1; }
    .quote { margin: 16px 0 0; border-left: 3px solid var(--blue); background: var(--soft); border-radius: 0 10px 10px 0; padding: 14px 16px; }
    .quote p { margin: 0 0 6px; font-size: 13px; line-height: 1.65; }
    .quote footer { font-size: 11px; color: var(--muted); }
    .callout { background: var(--soft); border: 1px solid var(--line); border-left: 3px solid var(--blue); border-radius: 10px; padding: 14px 16px; margin-top: 16px; font-size: 13px; }
    .callout strong { display: block; margin-bottom: 4px; }
    .callout p { margin: 0; color: var(--muted); }
    .source-line { font-size: 12px; color: var(--muted); margin: 12px 0 0; }
    .timeline { display: grid; gap: 10px; }
    .evidence-card { border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: #fff; }
    .evidence-top { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; color: var(--muted); margin-bottom: 6px; }
    .evidence-type { background: var(--blue-bg); color: #1d4ed8; border-radius: 999px; padding: 3px 8px; font-weight: 700; }
    .evidence-card h3 { font-size: 14px; margin: 0 0 6px; line-height: 1.45; }
    .evidence-card p { margin: 0 0 8px; color: var(--muted); font-size: 13px; }
    .evidence-card a { font-size: 12px; }
    .empty { border: 1px dashed var(--line); border-radius: 12px; padding: 22px; text-align: center; color: var(--muted); font-size: 13px; }
    .stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 16px; }
    .stat { border: 1px solid var(--line); border-radius: 12px; padding: 14px; background: var(--soft); }
    .stat span { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
    .stat strong { display: block; font-size: clamp(1.1rem, 2vw, 1.5rem); margin: 4px 0 2px; letter-spacing: -0.02em; }
    .stat small { color: var(--muted); font-size: 11px; }
    .steam-desc h3 { font-size: 14px; margin: 0 0 6px; }
    .steam-desc p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
    .dev-card { display: flex; gap: 16px; align-items: flex-start; border: 1px solid var(--line); border-radius: 14px; padding: 18px; background: var(--soft); }
    .dev-avatar { width: 52px; height: 52px; border-radius: 12px; background: linear-gradient(135deg, #1f8fff, #7c3aed); color: #fff; display: grid; place-content: center; font-weight: 800; font-size: 18px; flex: none; }
    .dev-body h3 { margin: 0 0 4px; font-size: 16px; }
    .dev-body p { margin: 0 0 10px; color: var(--muted); font-size: 13px; }
    .dev-links { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; }
    .other-games { margin-top: 18px; }
    .other-games h3 { font-size: 13px; color: var(--muted); margin: 0 0 10px; font-weight: 600; }
    .mini-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
    .mini-card { display: flex; gap: 10px; align-items: center; border: 1px solid var(--line); border-radius: 10px; padding: 8px; color: var(--ink); background: #fff; }
    .mini-card:hover { border-color: #c7d2e0; text-decoration: none; }
    .mini-card img { width: 70px; aspect-ratio: 460 / 215; object-fit: cover; border-radius: 6px; flex: none; background: #eef2f7; }
    .mini-card span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .mini-card strong { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mini-card small { font-size: 11px; color: var(--muted); }
    .game-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .game-card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #fff; color: var(--ink); display: flex; flex-direction: column; transition: transform 0.18s ease, border-color 0.18s ease; }
    .game-card:hover { border-color: #c7d2e0; text-decoration: none; transform: translateY(-2px); }
    .game-card img { width: 100%; aspect-ratio: 460 / 215; object-fit: cover; background: #eef2f7; display: block; }
    .game-card-ph { aspect-ratio: 460 / 215; display: grid; place-content: center; background: var(--soft); color: var(--muted); font-size: 12px; }
    .game-card-body { padding: 12px; display: flex; flex-direction: column; gap: 3px; }
    .game-card-body strong { font-size: 13px; line-height: 1.35; }
    .game-card-body span { font-size: 11px; color: var(--muted); }
    .game-card-body small { font-size: 11px; color: var(--muted); margin-top: 2px; line-height: 1.4; }
    .mini-status { align-self: flex-start; font-size: 10px; font-weight: 700; border-radius: 999px; padding: 2px 7px; margin-top: 4px; }
    .vote-form { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
    .vote-form select { padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--ink); font: inherit; font-size: 13px; min-width: 220px; }
    .vote-counts { display: grid; gap: 6px; margin-top: 8px; font-size: 13px; color: var(--muted); }
    .source-list { list-style: none; padding: 0; margin: 0; display: grid; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .source-list li { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 12px; padding: 11px 14px; border-bottom: 1px solid var(--line); font-size: 12px; align-items: center; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list span { color: var(--muted); }
    .source-list time { color: var(--muted); font-size: 11px; white-space: nowrap; }
    .share-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; margin: 20px 0; }
    .share-bar > span { font-size: 12px; color: var(--muted); margin-right: 4px; }
    .share-icon { width: 17px; height: 17px; flex: 0 0 auto; display: block; }
    .share-icon-reddit { width: 20px; height: 20px; }
    .share-bar .btn { gap: 8px; }
    .site-footer { border-top: 1px solid var(--line); margin-top: 30px; padding: 22px 0 40px; color: var(--muted); font-size: 12px; }
    .site-footer .wrap { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .lightbox { border: 0; padding: 0; background: transparent; max-width: min(1200px, 94vw); width: 100%; }
    .lightbox::backdrop { background: rgba(9, 14, 26, 0.86); }
    .lightbox img { width: 100%; max-height: 82vh; object-fit: contain; border-radius: 10px; background: #0b1020; }
    .lightbox button { position: absolute; top: -14px; right: -14px; width: 38px; height: 38px; border-radius: 50%; border: 0; background: #fff; color: #182437; font-size: 22px; cursor: pointer; }
    .lightbox-caption { color: #fff; font-size: 12px; text-align: center; padding-top: 8px; }
    @media (max-width: 960px) {
      .game-top { grid-template-columns: 1fr; gap: 22px; }
      .game-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .wrap { padding: 0 14px; }
      .top-inner { height: 58px; }
      .top-nav a:nth-child(n + 3) { display: none; }
      .section { padding: 16px; border-radius: 14px; scroll-margin-top: 120px; }
      .section-head { align-items: flex-start; flex-direction: column; gap: 4px; }
      .facts > div { grid-template-columns: 80px minmax(0, 1fr); }
      .game-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
      .game-card-body { padding: 9px; }
      .stat-grid { grid-template-columns: 1fr 1fr; }
      .dev-card { flex-direction: column; }
      .source-list li { grid-template-columns: 1fr; gap: 3px; }
      .share-bar .btn { flex: 1; }
      .section-nav { top: 58px; }
    }

    /* Dressmaker: compact, keyboard-accessible per-area evidence disclosure. */
    .area-evidence-detail summary { cursor:pointer;display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:6px 10px;border:1px solid #d8e4f2;border-radius:9px;background:#f6faff;color:#1263b1;font-size:12px;font-weight:700;list-style:none; }
    .area-evidence-detail summary::-webkit-details-marker { display:none; }
    .area-evidence-detail summary:hover { background:#eaf4ff;border-color:#93c5fd; }
    .area-evidence-detail summary:focus-visible { outline:3px solid #1f8fff;outline-offset:3px; }
    .area-evidence-detail[open] summary span { transform:rotate(180deg); }
    .area-evidence-body { max-width:420px;padding:10px 2px 4px;line-height:1.65; }
    .area-evidence-body p { margin:0 0 8px; }
    .area-evidence-body a { display:inline-block;margin:3px 12px 3px 0;font-weight:600; }
    .area-evidence-caveat { font-size:12px;color:#667085; }
    /* Taste-inspired refinement: faster comprehension, visible status, accessible controls. */
    .game-top { grid-template-columns:minmax(0,1.4fr) minmax(340px,.95fr); gap:clamp(18px,3vw,34px); }
    .info-col .status-badge { display:inline-flex; align-items:center; margin:0 0 10px; }\n    .info-col .ai-chips { display:none; }
    .info-col h1 { font-size:clamp(1.6rem,3vw,2.55rem);margin-bottom:6px; }
    .info-col .byline { margin-bottom:14px; }
    .ai-overview { display:block;border:1px solid #dfe8f5;border-radius:18px;background:#fff;padding:18px;text-decoration:none;color:#152b48;transition:border-color .2s,box-shadow .2s;margin:0 0 16px; }
    .ai-overview:hover { border-color:#6ca4f0;box-shadow:0 8px 24px #173d7512;text-decoration:none; }
    .ai-overview-head { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px; }
    .ai-overview-title { display:flex;align-items:center;gap:7px;font-weight:800;letter-spacing:.06em;font-size:12px; }
    .ai-overview-logo { display:inline-grid;place-items:center;width:24px;height:24px;border-radius:7px;background:#2469cb;color:#fff;font-size:11px; }
    .ai-overview-count { display:flex;align-items:baseline;gap:3px;font-size:18px;color:#78899f;font-weight:650;line-height:1; }
    .ai-overview-count strong { font-size:34px;color:#142943;letter-spacing:-.05em; }
    .ai-overview-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px; }
    .ai-overview-tile { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;min-height:78px;background:#f1f4f8;color:#738298;border-radius:10px;padding:9px 3px;text-align:center;min-width:0; }
    .ai-overview-tile.is-used { background:#2469cb;color:#fff; }\n    .ai-overview-tile:focus-visible, .btn:focus-visible, .thumb:focus-visible, .section-nav a:focus-visible { outline:3px solid #1f8fff;outline-offset:3px; }
    .ai-overview-symbol { font-size:21px;font-weight:700;line-height:1; }
    .ai-overview-name { font-size:11px;font-weight:650;line-height:1.2;overflow-wrap:anywhere; }
    .ai-overview-foot { display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:10px;color:#77879b;margin-top:12px; }
    .ai-overview-foot>span { display:inline-flex;align-items:center;gap:4px; }
    .ai-key { width:8px;height:8px;border-radius:3px;background:#e0e6ed; }
    .ai-key.used { background:#2469cb; }
    .ai-overview-arrow { margin-left:auto;color:#2469cb;font-weight:700; }
    @media(max-width:820px){.game-top{grid-template-columns:1fr}.info-col{grid-row:1}.media-col{grid-row:2}.info-col .facts{display:none}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ai-overview,.game-card,.card{transition:none!important}}
    @media(max-width:420px){.ai-overview{padding:13px}.ai-overview-grid{gap:5px}.ai-overview-tile{min-height:69px}.ai-overview-name{font-size:10px}}
  
    /* Compact detail refresh (batch 01) */
    body:has(.quick-review){background:#fcfdff}
    .quick-review{margin:14px 0 0;display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:13px 16px;border:1px solid #dce9f6;border-radius:15px;background:#f5f9ff}
    .quick-review-label{font-weight:750;font-size:13px;color:#1a3760;margin-right:auto}
    .quick-review-links{display:flex;gap:8px;flex-wrap:wrap}
    .quick-review-links a{display:inline-flex;align-items:center;gap:5px;border-radius:9px;padding:8px 12px;background:#fff;border:1px solid #d7e4f2;color:#205b9a;font-size:12px;font-weight:650;text-decoration:none}
    .quick-review-links a:hover,.quick-review-links a:focus-visible{border-color:#2787e8;background:#ecf5ff;outline-offset:2px}
    .quick-review-links a:focus-visible{outline:2px solid #1474d4}
    @media(max-width:760px){.quick-review{padding:12px;align-items:stretch}.quick-review-label{width:100%}.quick-review-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));width:100%;gap:6px}.quick-review-links a{justify-content:center;padding:9px 4px;font-size:11px}}
</style>
<link rel="stylesheet" href="/airy-detail.css" />
</head>
<body>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="/"><img src="/logo.svg" alt="" width="38" height="32" />Game <span>AI</span> Checker</a>
      <nav class="top-nav" aria-label="主导航">
        <a href="/">搜索</a>
        <a href="/games/">游戏库</a>
        <a href="/browse/">浏览</a>
        <a href="/indie-ai/">Indie AI</a>
      </nav>
    </div>
  </header>

  <main class="wrap" id="app" data-game-key={game.key} data-slug={game.slug} data-name={game.name} data-appid={game.appId || ''}>
    <nav class="crumbs" aria-label="面包屑">
      <a href="/">首页</a><span>/</span><a href="/games/">游戏库</a><span>/</span><span aria-current="page">{game.name}</span>
    </nav>

    <section class="game-top">
      <div class="media-col">
        <div class="hero-media" id="heroMedia">
          {hero ? (
            <img id="heroImg" src={hero.src} alt={`${game.name} 官方图片`} data-full={hero.full} data-fallback={hero.fallback || ''} loading="eager" fetchpriority="high" decoding="async" />
          ) : (
            <div class="media-placeholder">暂无官方图片<br /><small>Steam App ID 与商店图片待核实</small></div>
          )}
          {game.images.length > 1 && (
            <div class="media-controls">
              <button id="prevBtn" type="button" aria-label="上一张">←</button>
              <span id="mediaCount">1 / {game.images.length}</span>
              <button id="nextBtn" type="button" aria-label="下一张">→</button>
              <button id="pauseBtn" type="button" aria-label="暂停轮播">Ⅱ</button>
            </div>
          )}
          {hero && <button class="media-open" id="openLightbox" type="button" aria-label="放大查看">⤢</button>}
        </div>

        {game.images.length > 1 && (
          <div class="thumbs" id="thumbs" aria-label="图片缩略图">
            {game.images.map((image, index) => (
              <button
                class:list={['thumb', index === 0 && 'active']}
                type="button"
                data-index={index}
                data-src={image.src}
                data-full={image.full}
                aria-label={`第 ${index + 1} 张图片`}
              >
                <img src={image.thumbnail || image.src} width="160" height="90" alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}

        <div class="media-foot">
          <span id="mediaCountText">{game.images.length ? `${game.images.length} 张官方图片` : '暂无官方图片'}</span>
          {game.steamUrl && <a href={game.steamUrl} target="_blank" rel="noopener noreferrer">Steam 商店 ↗</a>}
        </div>
        <p class="media-credit">图片来自 Steam 商店页面，版权归各自权利人所有；仅用于识别游戏与展示玩法画面。</p>

        {game.movies.length > 0 && (
          <div class="videos">
            <div class="mini-title">宣传视频</div>
            <div class="video-grid">
              {game.movies.slice(0, 4).map((movie) => (
                <a class="video-card" href={game.steamUrl || '#'} target="_blank" rel="noopener noreferrer">
                  {movie.thumbnail && <img src={movie.thumbnail} alt={movie.name || '宣传视频'} loading="lazy" />}
                  <span>{movie.name || '观看宣传视频'} ↗</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {(game.steamDescription || overviewTags.length > 0) && (
          <section class="game-overview" aria-labelledby="gameOverviewTitle">
            <div class="mini-title">GAME OVERVIEW</div>
            <h2 id="gameOverviewTitle">游戏概览</h2>
            {game.steamDescription && <p>{game.steamDescription}</p>}
            {overviewTags.length > 0 && <div class="overview-tags" aria-label="游戏标签与游玩功能">
              {overviewTags.map((tag) => <span>{tag}</span>)}
            </div>}
            {game.steamDescription && game.steamUrl && <a class="overview-source" href={game.steamUrl} target="_blank" rel="noopener noreferrer">Steam 商店简介 ↗</a>}
          </section>
        )}
      </div>

      <aside class="info-col">
        <div class:list={['status-badge', `tone-${game.statusTone}`]}>{game.statusLabel}</div>
        <h1>{game.originalName || game.name}</h1>
        {game.originalName && <p class="muted">{game.name}</p>}
        {game.humanMadeListing && <div class="human-made-spotlight" aria-label="人工制作审核状态">
          {game.humanMadeListing.kind === 'site_owner_review' && game.humanMadeListing.verified ? (
            <>
              <div class="human-made-spotlight-top"><span>✓ 0% AI · 100% HUMAN</span><span class="human-made-pending">站内审核通过</span></div>
              <strong>全游戏范围 · 0 AI</strong>
              <p>已通过 Game AI Checker 站点负责人审查。此为站内审核结论；详细审核材料尚未公开，不代表第三方独立认证。</p>
              <details><summary>查看审核说明</summary><p>{game.humanMadeListing.summary}</p></details>
              <a href="#evidence">查看证据记录 ↗</a>
            </>
          ) : (
            <>
              <div class="human-made-spotlight-top"><span>✎ 人工制作线索</span><span class="human-made-pending">{game.humanMadeListing.verified ? '已有来源' : '尚未认证'}</span></div>
              <strong>{game.humanMadeListing.scope === 'art' ? '关注范围：美术与视觉素材' : game.humanMadeListing.label}</strong>
              <p>现有材料不足以证明本作 100% 未使用生成式 AI。</p>
              <details><summary>查看推荐依据与缺失证据</summary><p>{game.humanMadeListing.summary}</p></details>
              <a href="#evidence">查看证据记录 ↗</a>
            </>
          )}
        </div>}
        <p class="byline">
          {game.developer || '开发商待核实'} · {game.releaseYear || '发行年份待核实'} · {game.genres.slice(0, 3).join(' / ') || '类型待核实'}
        </p>
        <a class="ai-overview" href="#ai" aria-label={`查看 ${game.name} 的 AI 使用领域与证据，记录 ${usedCount} 个 AI 使用领域，共 8 个`}>
          <div class="ai-overview-head">
            <span class="ai-overview-title"><span class="ai-overview-logo" aria-hidden="true">▶</span> AI USE <span class="muted">{game.usedAreas.some((area) => game.aiAreaSources?.[area.key] === 'third_party') ? '含第三方整理' : '开发者披露范围'}</span></span>
            <span class="ai-overview-count"><strong>{usedCount}</strong><span>/ 8</span></span>
          </div>
          <div class="ai-overview-grid">
            {game.areas.slice(0, 8).map((area) => (
              <span class:list={['ai-overview-tile',area.state === 'used' && 'is-used']} title={`${area.label}：${area.stateLabel}${game.aiAreaSources?.[area.key] === 'third_party' ? '（第三方整理，未经本站独立核实）' : ''}`}>
                <span class="ai-overview-symbol" aria-hidden="true">{({
                  art: '◈', music: '♫', writing: '✎', translation: '文',
                  marketing: '↗', code: '⌘', voice: '◉', gameplay: '▣'
                })[area.key] || '◆'}</span>
                <span class="ai-overview-name">{area.label}</span>
              </span>
            ))}
          </div>
          <div class="ai-overview-foot"><span><i class="ai-key used"></i>有来源报告使用</span><span><i class="ai-key"></i>未标蓝不代表未使用</span><span class="ai-overview-arrow">查看证据 ↗</span></div>
        </a>

        {usedCount > 0 ? (
          <div class="ai-chips">
            {game.usedAreas.slice(0, 5).map((area) => <span class="chip used">{area.label}</span>)}
            {usedCount > 5 && <span class="chip">+{usedCount - 5}</span>}
          </div>
        ) : game.status === 'official_disclosure' ? (
          <div class="ai-chips"><span class="chip used">已披露使用 AI · 未分项</span></div>
        ) : null}

        <div class="actions">
          {game.steamUrl ? (
            <a class="btn primary" href={game.steamUrl} target="_blank" rel="noopener noreferrer">Steam 商店 ↗</a>
          ) : (
            <a class="btn primary" href={`https://store.steampowered.com/search/?term=${encodeURIComponent(game.name)}`} target="_blank" rel="noopener noreferrer">在 Steam 搜索 ↗</a>
          )}
          <button class="btn" id="saveBtn" type="button" title="仅保存在本机浏览器">☆ 收藏</button>
          <button class="btn" id="shareBtn" type="button">分享</button>
        </div>

        <dl class="facts">
          <div><dt>Steam App ID</dt><dd>{game.appId ? <><code>{game.appId}</code><button class="copy" id="copyId" type="button">复制</button></> : '待核实'}</dd></div>
          <div><dt>开发商 / 发行商</dt><dd>{game.developer || '待核实'}{game.publisher && game.publisher !== game.developer ? <> · {game.publisher}</> : ''}</dd></div>
          <div><dt>发行日期</dt><dd>{formatDate(game.releaseDate)}</dd></div>
          <div><dt>价格</dt><dd>{game.price || '待核实'}</dd></div>
          <div><dt>平台</dt><dd>{game.platforms?.join(' / ') || '待核实'}</dd></div>

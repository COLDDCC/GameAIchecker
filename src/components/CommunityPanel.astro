    clueBody: (name, id, url) => `遊戲：${name}（${id || '無 App ID'}）\n頁面：${url}\n\n疑似涉及的領域（保留適用項）：美術/動畫、音樂/配音、文字/翻譯、UI/宣傳/其他\n\n具體位置或證據連結：\n\n補充說明：\n\n提交即表示你理解：線索需經人工核實，不會自動成為已核實證據。\n`,
    clueIssue: (name) => `[玩家線索] ${name}`,

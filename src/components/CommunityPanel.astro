  en: {
    eyebrow: 'COMMUNITY · PLAYER OBSERVATIONS',
    title: 'What do players notice?',
    meta: 'Counted separately from developer disclosure',
    lede: 'Player observations are impressions, not facts about AI use, and never change the disclosure verdict on this page.',
    votes: {
      no_ai_suspected: 'No obvious signs of AI',
      some_ai_suspected: 'Some content looks AI-made',
      heavy_ai_suspected: 'A lot looks AI-made',
      all_ai_suspected: 'Looks mostly AI-generated',
    },
    loading: 'Loading player observations…',
    noscript: 'JavaScript is needed to view and submit player observations.',
    empty: 'No observations yet. Be the first.',
    total: '{n} player observations',
    people: '{n}',
    small: 'Small sample (under {min}): showing counts only, no percentages.',
    ask: 'What did you notice?',
    submit: 'Submit my observation',
    update: 'Update my observation',
    sending: 'Submitting…',
    mine: 'Your observation: {label}. You can change it any time.',
    saved: 'Recorded. Thanks for taking part.',
    changed: 'Your observation was updated.',
    unchanged: 'That is the same as your earlier choice.',
    pick: 'Choose an option first.',
    unavailable: 'Player observations are not open yet. The rest of the page is unaffected.',
    errors: {
      rate_limited: 'Too many submissions. Please try again later.',
      not_configured: 'Voting is not open yet. Please check back later.',
      invalid_feedback: 'Invalid submission. Refresh the page and try again.',
      bad_origin: 'Please submit from a gameaichecker.com page.',
      write_failed: 'The server could not save right now. Please try again later.',
      network: 'Network error. Check your connection and try again.',
      unknown: 'Submission failed ({code}). Please try again later.',
    },
    clueTitle: 'Found something specific?',
    clueText: 'A screenshot location, developer interview or production record is worth more than a vote. Clues are reviewed by a person before they enter the evidence table.',
    clueBtn: 'Submit a clue ↗',
    footer: 'Anonymous · No account · One vote per browser per game, changeable',
    methodTitle: 'How this is counted',
    method: 'Each browser counts once per game and can change its vote. More than 5 new observations from one network are kept but left out of public counts to limit vote stuffing; this cannot stop all abuse. Raw IP addresses are never stored, only keyed hashes. Below 10 observations, only counts are shown.',
    clueBody: (name, id, url) => `Game: ${name} (${id || 'no App ID'})\nPage: ${url}\n\nArea(s) (keep what applies): art/animation, music/voice, text/translation, UI/marketing/other\n\nExact location or evidence link:\n\nNotes:\n\nI understand clues are reviewed by a person and do not automatically become verified evidence.\n`,
    clueIssue: (name) => `[Player clue] ${name}`,
  },
  ja: {
    eyebrow: 'COMMUNITY · プレイヤーの観察',
    title: 'プレイヤーはどう見ている？',
    meta: '開発元の申告とは別に集計',
    lede: 'コミュニティの意見はプレイヤーの印象であり、AI 使用の事実ではありません。このページの判定にも影響しません。',
    votes: {
      no_ai_suspected: '目立った AI の痕跡はない',
      some_ai_suspected: '一部に AI 使用の疑い',
      heavy_ai_suspected: '多くの部分に AI 使用の疑い',
      all_ai_suspected: '主に AI 生成の疑い',
    },
    loading: 'プレイヤーの観察を読み込み中…',
    noscript: '表示と投稿には JavaScript が必要です。',
    empty: 'まだ投稿はありません。最初の投稿者になりましょう。',
    total: '{n} 件の観察',
    people: '{n} 件',
    small: 'サンプルが少ないため（{min} 件未満）、件数のみ表示しています。',
    ask: 'あなたの観察は？',
    submit: '観察を送信',
    update: '観察を更新',
    sending: '送信中…',
    mine: 'あなたの観察：{label}。いつでも変更できます。',
    saved: '記録しました。ご協力ありがとうございます。',
    changed: '観察を更新しました。',
    unchanged: '前回と同じ選択です。',
    pick: '選択肢を選んでください。',
    unavailable: 'プレイヤーの観察はまだ公開されていません。ページの他の内容には影響しません。',
    errors: {
      rate_limited: '送信が多すぎます。しばらくしてから再試行してください。',
      not_configured: '投票はまだ公開されていません。',
      invalid_feedback: '無効な送信です。ページを再読み込みしてください。',
      bad_origin: 'gameaichecker.com のページから送信してください。',
      write_failed: 'サーバーが保存できませんでした。しばらくしてから再試行してください。',
      network: 'ネットワークエラーです。接続を確認してください。',
      unknown: '送信に失敗しました（{code}）。',
    },
    clueTitle: '具体的な手がかりを見つけた？',
    clueText: 'スクリーンショットの場所、開発者インタビュー、制作記録などは投票より役立ちます。手がかりは人の確認を経てから根拠表に追加されます。',
    clueBtn: '手がかりを送る ↗',
    footer: '匿名 · ログイン不要 · ブラウザごとに 1 票、変更可',
    methodTitle: '集計方法',
    method: '同じゲームにはブラウザごとに 1 票で、いつでも変更できます。同一ネットワークから 5 件を超える新規投稿は保存されますが公開集計には含めません。不正を完全には防げません。生の IP アドレスは保存せず、鍵付きハッシュのみ保存します。10 件未満のときは件数のみ表示します。',
    clueBody: (name, id, url) => `ゲーム：${name}（${id || 'App ID なし'}）\nページ：${url}\n\n該当する分野（該当するものを残す）：アート/アニメーション、音楽/音声、テキスト/翻訳、UI/宣伝/その他\n\n具体的な場所または根拠リンク：\n\n補足：\n\n手がかりは人による確認が必要で、自動的に確認済みの根拠にはならないことを理解しています。\n`,
    clueIssue: (name) => `[プレイヤーの手がかり] ${name}`,
  },
};

const L = strings[lang] || strings.en;
const clueUrl = `https://github.com/COLDDCC/GameAIchecker/issues/new?title=${encodeURIComponent(L.clueIssue(gameName))}&body=${encodeURIComponent(L.clueBody(gameName, appId, pageUrl))}`;
const clientStrings = { ...L, clueBody: undefined, clueIssue: undefined, minSample: MIN_SAMPLE };
const voteEntries = Object.entries(L.votes);
---

<section class="section community" id="community" data-game-key={gameKey}>
  <div class="section-head">
    <div><div class="eyebrow">{L.eyebrow}</div><h2>{L.title}</h2></div>
    <div class="section-meta">{L.meta}</div>
  </div>
  <p class="section-lede">{L.lede}</p>

  <div class="cp-grid">
    <div class="cp-results" aria-live="polite">
      <div class="cp-total"><strong id="cpTotal">–</strong><span id="cpTotalLabel">{L.loading}</span></div>
      <ul class="cp-bars" id="cpBars">
        {voteEntries.map(([code, label]) => (
          <li data-vote={code}>
            <div class="cp-bar-head"><span>{label}</span><span class="cp-val">–</span></div>
            <div class="cp-track"><div class="cp-fill" style="width:0%"></div></div>
          </li>
        ))}
      </ul>
      <p class="cp-note" id="cpNote" hidden></p>
      <noscript><p class="cp-note">{L.noscript}</p></noscript>
    </div>

    <form class="cp-form" id="cpForm" hidden>
      <fieldset>
        <legend>{L.ask}</legend>
        {voteEntries.map(([code, label]) => (
          <label class="cp-choice">
            <input type="radio" name="vote" value={code} />
            <span>{label}</span>
          </label>
        ))}
      </fieldset>
      <button class="btn primary cp-submit" type="submit">{L.submit}</button>
      <p class="cp-msg" id="cpMsg" role="status"></p>
      <p class="cp-foot">{L.footer}</p>
    </form>
    <p class="cp-unavailable" id="cpUnavailable" hidden>{L.unavailable}</p>
  </div>

  <div class="cp-clue">
    <div>
      <strong>{L.clueTitle}</strong>
      <p>{L.clueText}</p>
    </div>
    <a class="btn" href={clueUrl} target="_blank" rel="noopener noreferrer">{L.clueBtn}</a>
  </div>

  <details class="cp-method">
    <summary>{L.methodTitle}</summary>
    <p>{L.method}</p>
  </details>
</section>

<style>
  .community [hidden] { display: none !important; }
  .community .cp-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .cp-results, .cp-form, .cp-unavailable { border: 1px solid var(--line); border-radius: 14px; padding: 16px; background: #fff; margin: 0; }
  .cp-total { display: flex; align-items: baseline; gap: 8px; margin-bottom: 12px; }
  .cp-total strong { font-size: 28px; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cp-total span { color: var(--muted); font-size: 13px; }
  .cp-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cp-bar-head { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; margin-bottom: 4px; }
  .cp-val { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cp-track { height: 8px; border-radius: 99px; background: var(--gray-bg); overflow: hidden; }
  .cp-fill { height: 100%; border-radius: 99px; background: var(--blue); transition: width .4s ease; }
  .cp-bars li.mine .cp-bar-head span:first-child { font-weight: 700; }
  .cp-bars li.mine .cp-bar-head span:first-child::after { content: ' ✓'; color: var(--blue-dark); }
  .cp-results.small .cp-track { display: none; }
  .cp-note { margin: 12px 0 0; font-size: 12px; color: var(--amber); background: var(--amber-bg); border-radius: 8px; padding: 8px 10px; }
  .cp-form fieldset { border: 0; margin: 0 0 12px; padding: 0; display: grid; gap: 8px; }
  .cp-form legend { font-weight: 700; font-size: 14px; margin-bottom: 8px; padding: 0; }
  .cp-choice { display: flex; align-items: center; gap: 10px; border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; font-size: 14px; cursor: pointer; }
  .cp-choice:hover { border-color: #c7d2e0; }
  .cp-choice:has(input:checked) { border-color: var(--blue); background: var(--blue-bg); }
  .cp-choice input { accent-color: var(--blue); margin: 0; }
  .cp-submit { width: 100%; justify-content: center; }
  .cp-submit:disabled { opacity: .6; cursor: wait; }
  .cp-msg { min-height: 1.4em; margin: 10px 0 0; font-size: 13px; color: var(--gray); }
  .cp-msg.error { color: #b42318; }
  .cp-msg.ok { color: var(--green); }
  .cp-foot { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
  .cp-unavailable { color: var(--muted); font-size: 13px; background: var(--soft); }
  .cp-clue { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 18px; padding: 14px 16px; border-radius: 14px; background: var(--soft); border: 1px dashed #cbd5e1; }
  .cp-clue p { margin: 4px 0 0; font-size: 13px; color: var(--muted); max-width: 640px; }
  .cp-clue .btn { white-space: nowrap; }
  .cp-method { margin-top: 12px; font-size: 12px; color: var(--muted); }
  .cp-method summary { cursor: pointer; }
  .cp-method p { margin: 6px 0 0; max-width: 820px; }
  @media (max-width: 760px) {
    .community .cp-grid { grid-template-columns: 1fr; }
    .cp-clue { flex-direction: column; align-items: stretch; }
  }
</style>

<script is:inline define:vars={{ S: clientStrings }}>
  (() => {
    const root = document.getElementById('community');
    const key = root?.dataset.gameKey || '';
    if (!root || !key) return;
    const $ = (id) => document.getElementById(id);
    const form = $('cpForm');
    const msg = $('cpMsg');
    const submit = form.querySelector('button[type="submit"]');
    const results = root.querySelector('.cp-results');
    const fmt = (s, vars) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');

    function voterId() {
      try {
        let id = localStorage.getItem('gac-voter');
        if (!id) {
          id = crypto.randomUUID();
          localStorage.setItem('gac-voter', id);
        }
        return id;
      } catch {
        window.__gacVoter ||= crypto.randomUUID();
        return window.__gacVoter;
      }
    }
    const voter = voterId();
    let mine = null;

    function say(text, kind = '') {
      msg.textContent = text;
      msg.className = `cp-msg ${kind}`;
    }

    function render(data) {
      const counts = data.counts || {};
      const total = Number(data.total) || 0;
      const small = total < S.minSample;
      mine = data.mine || null;
      $('cpTotal').textContent = String(total);
      $('cpTotalLabel').textContent = total ? fmt(S.total, { n: '' }).trim() : S.empty;
      results.classList.toggle('small', small);
      root.querySelectorAll('#cpBars li').forEach((li) => {
        const n = Number(counts[li.dataset.vote]) || 0;
        const pct = total ? Math.round((n / total) * 100) : 0;
        li.querySelector('.cp-val').textContent = small ? fmt(S.people, { n }) : `${pct}% · ${fmt(S.people, { n })}`;
        li.querySelector('.cp-fill').style.width = small ? '0%' : `${pct}%`;
        li.classList.toggle('mine', li.dataset.vote === mine);
      });
      const note = $('cpNote');
      note.hidden = !(total > 0 && small);
      note.textContent = fmt(S.small, { min: S.minSample });
      if (mine) {
        const input = form.querySelector(`input[value="${mine}"]`);
        if (input) input.checked = true;
        submit.textContent = S.update;
      } else {
        submit.textContent = S.submit;
      }
    }

    function unavailable() {
      form.hidden = true;
      $('cpUnavailable').hidden = false;
    }

    fetch(`/api/feedback?game=${encodeURIComponent(key)}&voter=${encodeURIComponent(voter)}`, { headers: { accept: 'application/json' } })
      .then((r) => r.json().then((d) => ({ ok: r.ok, d })))
      .then(({ ok, d }) => {
        if (!ok || d.error) throw new Error(d.error || 'unavailable');
        render(d);
        if (d.writable === false) return unavailable();
        form.hidden = false;
        if (mine) say(fmt(S.mine, { label: S.votes[mine] }));
      })
      .catch(() => {
        // Backend unreachable or not configured: show one calm notice instead
        // of an empty chart and a form that can only fail.
        results.hidden = true;
        unavailable();
      });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const vote = form.querySelector('input[name="vote"]:checked')?.value;
      if (!vote) return say(S.pick, 'error');
      if (vote === mine) return say(S.unchanged);
      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = S.sending;
      say('');
      try {
        const response = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ game: key, vote, voter }),
        });
        let data = {};
        try { data = await response.json(); } catch {}
        if (!response.ok) {
          const code = data.error || `HTTP ${response.status}`;
          say(S.errors[code] || fmt(S.errors.unknown, { code }), 'error');
          submit.textContent = label;
          return;
        }
        const wasChange = Boolean(mine);
        render(data);
        say(wasChange ? S.changed : S.saved, 'ok');
      } catch {
        say(S.errors.network, 'error');
        submit.textContent = label;
      } finally {
        submit.disabled = false;
      }
    });
  })();
</script>

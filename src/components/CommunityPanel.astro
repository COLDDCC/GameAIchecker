---
// Player observations panel: shows the aggregate first, then invites a vote,
// then points to the clue channel. Observations never change the disclosure
// verdict on the page.
const { gameKey, gameName, appId = '', pageUrl, lang = 'zh-cn' } = Astro.props;

const MIN_SAMPLE = 10;

const strings = {
  'zh-cn': {
    eyebrow: 'COMMUNITY · 玩家观察',
    title: '玩家怎么看这款游戏？',
    meta: '与开发者披露分开统计',
    lede: '社区观点仅代表玩家观察，不构成 AI 使用事实，也不会改变本页的披露结论。',
    votes: {
      no_ai_suspected: '没有明显 AI 痕迹',
      some_ai_suspected: '疑似部分内容使用 AI',
      heavy_ai_suspected: '疑似大量使用 AI',
      all_ai_suspected: '疑似主要由 AI 生成',
    },
    loading: '正在读取玩家反馈…',
    noscript: '需要启用 JavaScript 才能查看和提交玩家反馈。',
    empty: '还没有玩家反馈，你可以成为第一个。',
    total: '{n} 份玩家反馈',
    people: '{n} 人',
    small: '样本较少（不足 {min} 份），暂只显示人数，不显示百分比。',
    ask: '你的观察是什么？',
    submit: '提交我的观察',
    update: '更新我的观察',
    sending: '正在提交…',
    mine: '你的观察：{label}。可以随时修改。',
    saved: '已记录，谢谢参与。',
    changed: '已更新你的观察。',
    unchanged: '这和你之前的选择相同。',
    pick: '请先选择一项。',
    unavailable: '玩家反馈暂未开放，页面其他内容不受影响。',
    errors: {
      rate_limited: '提交过于频繁，请稍后再试。',
      not_configured: '投票服务暂未开放，请稍后再来。',
      invalid_feedback: '提交内容无效，请刷新页面后重试。',
      bad_origin: '请从 gameaichecker.com 页面提交。',
      write_failed: '服务器暂时无法保存，请稍后再试。',
      network: '网络连接失败，请检查网络后重试。',
      unknown: '提交失败（{code}），请稍后再试。',
    },
    clueTitle: '发现了具体线索？',
    clueText: '截图位置、开发者访谈、制作记录等公开来源比投票更有价值。线索经人工核实后才会进入证据表。',
    clueBtn: '提交线索 ↗',
    footer: '匿名参与 · 无需登录 · 每个浏览器每款游戏计一票，可修改',
    methodTitle: '统计方式',
    method: '每个浏览器对同一款游戏只计一票，可随时修改。同一网络下超过 5 份的新反馈会被保留但不计入公开统计，用于减少刷票，但无法完全阻止滥用。本站不保存原始 IP，只保存加密散列值。样本不足 10 份时只显示人数。',
    clueBody: (name, id, url) => `游戏：${name}（${id || '无 App ID'}）\n页面：${url}\n\n疑似涉及的领域（保留适用项）：美术/动画、音乐/配音、文本/翻译、UI/宣传/其他\n\n具体位置或证据链接（游戏内位置、截图来源、开发者访谈、商店页面等）：\n\n补充说明：\n\n提交即表示你理解：线索需经人工核实，不会自动成为已核实证据。\n`,
    clueIssue: (name) => `[玩家线索] ${name}`,
  },
  'zh-tw': {
    eyebrow: 'COMMUNITY · 玩家觀察',
    title: '玩家怎麼看這款遊戲？',
    meta: '與開發者揭露分開統計',
    lede: '社群觀點僅代表玩家觀察，不構成 AI 使用事實，也不會改變本頁的揭露結論。',

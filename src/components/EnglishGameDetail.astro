---
const { game } = Astro.props;
const site = 'https://gameaichecker.com';
const canonical = `${site}/games/en/${game.slug}/`;
const chinese = `${site}/games/${game.slug}/`;
const areaNames = {ingame:'In-game generation',code:'Code',art:'Art',music:'Music',voice:'Voice',writing:'Writing',translation:'Translation',marketing:'Marketing'};
const states = {used:'AI use disclosed',claimed_none:'Developer claims no AI',none:'Explicitly stated no use',not_stated:'Not stated',unreviewed:'Not reviewed'};
const labels = {official_disclosure:'Official AI disclosure',human_made:'Human-made claim',no_evidence:'No verified AI evidence found',community:'Unverified player report',unreviewed:'Not reviewed'};
const explanation = {
 official_disclosure:'The developer has disclosed AI use. Read the original wording below for its scope; this is a developer statement, not an independent audit.',
 human_made:'A human-made claim is recorded. Check which areas the statement actually covers; it does not independently certify every part of development.',
 no_evidence:'The review did not establish a substantiated generative-AI production claim. This does not confirm that the game is AI-free.',
 community:'A player report is recorded and remains unverified.', unreviewed:'There is not enough reviewed evidence to reach a conclusion.'
};
const ownerReviewed = game.humanMadeListing?.kind === 'site_owner_review' && game.humanMadeListing?.verified;
const answer = ownerReviewed ? 'Site owner review passed' : labels[game.status] || labels.unreviewed;
const intro = ownerReviewed ? 'The site owner has reviewed this human-made listing. This is a site review, not third-party certification.' : explanation[game.status] || explanation.unreviewed;
const description = `Does ${game.name} use AI? ${answer}. Read developer disclosures, eight AI-use areas, dated sources and review limits.`;
const types = {official_disclosure:'Official disclosure',steam_store:'Steam store',steam_page:'Steam discussion index',community:'Community report',third_party:'Third-party source',developer_statement:'Developer statement'};
const hasChinese = value => /[\u3400-\u9fff]/.test(value || '');
const host = value => { try { return new URL(value).hostname; } catch { return 'Site review record'; } };
const langOf = value => hasChinese(value) ? 'zh-CN' : 'en';
const correction = `https://github.com/COLDDCC/GameAIchecker/issues/new?title=${encodeURIComponent(`Correction: ${game.name} (${game.appId})`)}&body=${encodeURIComponent(`Page: ${canonical}\n\nCorrection:\n\nOriginal source and date:\n`)}`;
const image = game.images[0];
const used = game.areas.filter(a=>a.state==='used').map(a=>areaNames[a.key]);
const ld = {'@context':'https://schema.org','@type':'WebPage',name:`Does ${game.name} use AI?`,url:canonical,inLanguage:'en',description,dateModified:game.reviewedAt || undefined,about:{'@type':'VideoGame',name:game.name,sameAs:game.steamUrl,author:{'@type':'Organization',name:game.developer}}};
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Does {game.name} use AI? Disclosure &amp; evidence | Game AI Checker</title>
<meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large"/>
<link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={canonical}/><link rel="alternate" hreflang="zh-CN" href={chinese}/><link rel="alternate" hreflang="x-default" href={canonical}/>
<link rel="icon" type="image/svg+xml" href="/logo.svg"/>
<meta property="og:title" content={`Does ${game.name} use AI?`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="article"/>
{image && <meta property="og:image" content={new URL(image.full || image.src,site).href}/>}
<meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g,'\\u003c')}/>
<style is:global>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#182437;background:#fcfdff;line-height:1.55;color-scheme:light}*{box-sizing:border-box}body{margin:0}a{color:#1667b8;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,summary:focus-visible{outline:3px solid #1f8fff;outline-offset:4px}header{background:#fff;border-bottom:1px solid #e5eaf0}.bar,main,footer{max-width:1160px;margin:auto;padding:20px 24px}.bar{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.brand{font-weight:800;color:#182437;display:flex;align-items:center;gap:10px}.brand img{width:38px}nav{display:flex;gap:20px;flex-wrap:wrap}.crumbs,.eyebrow,.muted{color:#667085;font-size:13px}.crumbs{margin:6px 0 26px}.hero{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}h1{font-size:clamp(30px,4vw,48px);line-height:1.15;letter-spacing:-.035em;margin:12px 0 20px}h2{font-size:23px;letter-spacing:-.02em;margin:0 0 14px}.answer{border:1px solid #dce9f6;background:#eff6ff;border-radius:16px;padding:20px}.answer strong{font-size:20px}.answer p{margin:10px 0 0}.hero img{width:100%;border-radius:16px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}.button{background:#176bc1;color:#fff;padding:10px 15px;border-radius:9px;display:inline-block;font-weight:650}.button.secondary{background:white;color:#176bc1;border:1px solid #dce9f6}.facts{display:grid;grid-template-columns:1fr 1fr;gap:15px;font-size:14px}.facts dt{color:#667085}.facts dd{margin:3px 0}.section{margin:34px 0;padding-top:28px;border-top:1px solid #e5eaf0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}details{border:1px solid #e2e8f0;background:#fff;border-radius:12px;padding:14px}summary{cursor:pointer;font-weight:650}summary small{display:block;font-weight:450;color:#667085;margin-top:5px}details[data-state=used]{border-color:#7db5eb;background:#f4f9ff}.note{font-size:13px;color:#526176;margin-top:12px}blockquote{margin:14px 0 0;border-left:3px solid #71a9df;padding:8px 16px;white-space:pre-wrap;overflow-wrap:anywhere;background:#f8fafc;font-size:14px}.sources{display:grid;gap:12px}.sources details{overflow-wrap:anywhere}.source-top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.gallery img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:9px}footer{border-top:1px solid #e5eaf0;color:#667085;font-size:13px}.help{max-width:760px}.pill{font-size:12px;border:1px solid #dce9f6;border-radius:20px;padding:4px 10px;color:#526176}p{max-width:72ch}@media(max-width:760px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery{grid-template-columns:repeat(2,1fr)}.bar,main,footer{padding:18px}.hero-media{order:2}nav{gap:14px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head><body>
<header><div class="bar"><a class="brand" href="/"><img src="/logo.svg" alt=""/>Game AI Checker</a><nav aria-label="Main navigation"><a href="/browse/">Games</a><a href="/guides/how-to-check-steam-game-ai/">How to check</a><a href={chinese} lang="zh-CN">中文</a></nav></div></header>
<main><div class="crumbs"><a href="/">Home</a> / <a href="/browse/">Games</a> / {game.name}</div>
<section class="hero"><div><div class="eyebrow">AI DISCLOSURE CHECK · STEAM APP {game.appId}</div><h1>Does {game.name} use AI?</h1><div class="answer"><strong>{answer}</strong><p>{intro}</p>{game.summary && !hasChinese(game.summary) && <p>{game.summary}</p>}{used.length>0 && <p><b>Disclosed areas:</b> {used.join(', ')}.</p>}{game.status === 'official_disclosure' && used.length === 0 && <p>The disclosure does not identify the asset types. No specific area is inferred.</p>}</div><div class="actions"><a class="button" href="#disclosure">Read the evidence</a><a class="button secondary" href={game.steamUrl} target="_blank" rel="noopener noreferrer">Steam store ↗</a></div><dl class="facts"><div><dt>Developer</dt><dd>{game.developer || 'Not confirmed'}</dd></div><div><dt>Last reviewed</dt><dd>{game.reviewedAt || 'Not recorded'}</dd></div></dl></div><div class="hero-media">{image && <img src={image.src} alt={`${game.name} — official Steam image`} fetchpriority="high"/>}<p class="muted">Official Steam imagery. Rights belong to the respective owners.</p></div></section>
<section class="section" id="areas"><h2>Eight areas, separate answers</h2><p class="muted">“Not stated” means the reviewed evidence does not settle that area. Open a card for the recorded note.</p><div class="grid">{game.areas.map(area=><details data-state={area.state}><summary>{areaNames[area.key]}<small>{states[area.state] || states.unreviewed}</small></summary><p class="note">{area.state==='used'?'The reviewed official disclosure or developer statement explicitly identifies this area.':area.state==='claimed_none'?'This is a developer claim, not an independent audit.':area.state==='none'?'A reviewed statement explicitly rules out use in this area.':'No explicit area-specific conclusion is established by this record.'}</p>{game.aiAreaNotes?.[area.key] && <div class="note"><b>Original review note ({hasChinese(game.aiAreaNotes[area.key])?'Chinese':'English'})</b><p lang={langOf(game.aiAreaNotes[area.key])}>{game.aiAreaNotes[area.key]}</p></div>}<a href="#sources">Check original sources ↓</a></details>)}</div></section>
<section class="section" id="disclosure"><h2>Original disclosure</h2>{game.disclosureQuote ? <><p class="muted">Developer wording, preserved in its original language. Store wording can change after the review date.</p><blockquote lang={langOf(game.disclosureQuote)}>{game.disclosureQuote}</blockquote></> : <p>No official disclosure quotation is recorded here. This does not establish that no AI tools were used.</p>}</section>
<section class="section" id="sources"><h2>Sources &amp; review limits</h2><p class="muted">Official statements and community allegations are kept separate. Source excerpts and original review notes retain their original language.</p><div class="sources">{game.evidence.map((source,i)=><details><summary>{types[source.type] || 'Recorded source'} · {i+1}<small>{source.date || 'Date not recorded'} · {host(source.url)}</small></summary><div class="source-top"><span class="pill">{types[source.type] || source.type}</span>{source.url && <a href={source.url} target="_blank" rel="noopener noreferrer">Read original source ↗</a>}</div>{source.label && <p lang={langOf(source.label)}>{source.label}</p>}{source.excerpt && <blockquote lang={langOf(source.excerpt)}>{source.excerpt}</blockquote>}</details>)}</div>{game.reviewNote && <details style="margin-top:14px"><summary>Original review notes &amp; coverage limits<small>{hasChinese(game.reviewNote)?'Chinese review record':'English review record'}</small></summary><p lang={langOf(game.reviewNote)}>{game.reviewNote}</p></details>}<p class="help">Community posts can raise questions but do not establish an official AI-use finding. A forum homepage check is not a review of every historical post or every language.</p><a href={correction} target="_blank" rel="noopener noreferrer">Suggest a correction with a dated source ↗</a></section>
{game.images.length>1 && <section class="section"><h2>Official gallery</h2><div class="gallery">{game.images.slice(1).map((img,i)=><a href={img.full || img.src} target="_blank" rel="noopener noreferrer"><img src={img.thumbnail || img.src} alt={`${game.name} — Steam screenshot ${i+1}`} loading="lazy"/></a>)}</div></section>}
<section class="section help"><h2>Check another Steam game</h2><p>Search by game name, Steam App ID or store URL. Read the scope of the evidence before drawing a conclusion.</p><a class="button" href="/">Search games</a> <a class="button secondary" href="/guides/how-to-check-steam-game-ai/">How to check AI use</a></section>
</main><footer>Game AI Checker · Sources and review dates, not an AI detector. <a href={chinese} lang="zh-CN">中文档案</a></footer>
</body></html>

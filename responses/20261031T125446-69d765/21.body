to TSR as a workaround.[\/p][p]\u25b2 Fix: Issue where certain bullets caused continuous frame rate drops.[\/p][p]\u25b2 Fix: Occasional mouse loss during breakthrough sequences.[\/p][p]\u25b2 Fix: Random UI freeze after entering the panorama view.[\/p][p]\u25b2 Fix: Changes to resolution failing to save upon clicking Confirm.[\/p]","commentcount":5,"tags":["patchnotes","mod_reviewed","ModAct_1415716708_1785638597_0"],"language":0,"hidden":0,"forum_topic_id":"588433820963907862","event_gid":"688638619235124982","voteupcount":19,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588433820963907862","rtime32_last_modified":1793070363,"news_post_gid":"0","rtime_mod_reviewed":1785638598,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1785638407,"votes_up":19,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"809100396253438056","gidfeature2":"588433820963907862"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["693149194510140596","687517794773764658"],"last_update_event":{"rtime":1785638400,"event_gid":"688638619235124982","announcement_gid":"688638619235124983","clan_account_id":45961722}}};

null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"695402262914141139","clanid":"45950858","posterid":"0","headline":"\ud83c\udf89 We've Surpassed 10,000 Sales! Thank You!","posttime":1793705422,"updatetime":1793777324,"body":"[p][\/p][p]   We want to sincerely thank everyone who has been part of this wonderful journey, given our game a chance, and supported us along the way![\/p][p]We're still at the beginning of our journey, and we'll continue working hard to make the game even better. Every comment, suggestion, and piece of feedback you share means so much to us. [b]With your support and feedback, we truly believe we can make Dearbnb an even better game together.[\/b][\/p][p]This is just the beginning! There are many exciting updates, improvements, and new features ahead.[\/p][p][b]The Dearbnb Development Team[\/b][\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1889357040_1793706456_0","ModAct_1415716708_1793777439_4"],"language":0,"hidden":0,"forum_topic_id":"573805391546489987","event_gid":"695402262914141138","voteupcount":15,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793705400,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805391546489987","rtime32_last_modified":1793783910,"news_post_gid":"0","rtime_mod_reviewed":1793777439,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793704350,"votes_up":15,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561406856400084551","gidfeature2":"573805391546489987"},{"gid":"695402262914140230","clan_steamid":
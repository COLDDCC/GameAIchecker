							var StoreDefaults = {"PartnerEventStore":[{"gid":"695402262914141141","clan_steamid":"103582791475472266","event_name":"Dearbnb \u2013 Version 1.0 Roadmap \ud83c\udfe1","event_type":28,"appid":4338180,"server_address":null,"server_password":null,"rtime32_start_time":1793707260,"rtime32_end_time":1793709720,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c804d9c6a8f0b32c3899d52b0b1df77cc9467d08.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"695402262914141142","clanid":"45950858","posterid":"0","headline":"Dearbnb \u2013 Version 1.0 Roadmap \ud83c\udfe1","posttime":1793707317,"updatetime":1793707317,"body":"[p]Hello Dearbnb Community! [\/p][p]Thank you all for your incredible interest, support, and feedback since the beginning of our Early Access journey![\/p][p]We're working hard to make Dearbnb a much more enjoyable, balanced, and content-rich game together with you. We're carefully reviewing your feedback and taking your suggestions into consideration as we shape the future of the game.[\/p][p]Over the coming months, we're planning to bring many new features, gameplay mechanics, areas, businesses, and much more to Dearbnb![\/p][p][\/p][p][b]Development Period:[\/b] November 2026 \u2013 February 2027\n[b]Target:[\/b] February 2027 \u2013 Version 1.0 Release[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45950858\/df01a04f396f90692ecdc8b84f0a0a2b89e1f4f8.png\"][\/img][\/p][p][\/p][h2]NOVEMBER 2026 \u2013 Gameplay and Economy Improvements[\/h2][p]In the first phase, we're focusing on making the existing gameplay experience more enjoyable and balanced.[\/p][olist][*][p][b]New Shops:[\/b] Music Store, Bakery, Theater, Sports Store, Clothing Store, Sushi Restaurant, and Game Room.[\/p][\/*][*][p][b]House Rating System:[\/b] Tenants will now be able to rate houses and the services they receive.[\/p][\/*][*][p][b]Economy and Gameplay Balance:[\/b] Income, expenses, progression speed, and waiting times will be improved.[\/p][\/*][*][p][b]Steam Achievements:[\/b] Existing badges will be integrated with Steam Achievements.[\/p][\/*][*][p][b]Character Customization:[\/b] Players will be able to customize their own characters.[\/p][\/*][*][p][b]General Gameplay Improvements:[\/b] Existing mechanics will be improved to provide a smoother and more enjoyable gameplay experience.[\/p][\/*][\/olist][p][\/p][h2]DECEMBER 2026 \u2013 New Area and Major Systems[\/h2][p]In December, we're expanding the world of Dearbnb and introducing brand-new activities for players![\/p][olist][*][p][b]New Badges and Skills:[\/b] New achievement goals and skills will be added.[\/p][\/*][*][p][b]City Center \u2013 3rd Area:[\/b] Our third area will open, featuring new houses, businesses, and places to explore.[\/p][\/*][*][p][b]Personal Home System:[\/b] You'll finally have a home of your own! You'll be able to design and decorate it however you like.[\/p][\/*][*][p][b]Tenant Request System:[\/b] You'll be able to earn extra money and prestige by fulfilling your tenants' requests.[\/p][\/*][*][p][b]Shop Campaigns and Events:[\/b] You'll be able to organize marketing campaigns and special events in your shops.[\/p][\/*][*][p][b]Banking System:[\/b] New financing options will help you better manage your investments and growth.[\/p][\/*][*][p][b]New Major Businesses:[\/b] New businesses and city systems such as Airport, Tram System, Office, Concert Area, and Private School will be added.[\/p][\/*][\/olist][p][\/p][h2]JANUARY 2027 \u2013 New Content and Final Improvements[\/h2][p]In January, we'll focus on expanding the game's content while making our final preparations for [\/p][p]Version 1.0.[\/p][olist][*][p][b]New Quests:[\/b] Many more quests and new activities to keep you constantly engaged.[\/p][\/*][*][p][b]New Furniture and Items:[\/b] A large number of new decoration options across different categories.[\/p][\/*][*][p][b]New House Models:[\/b] Houses with balconies and a variety of architectural designs.[\/p][\/*][*][p][b]Flexible Business Design:[\/b] You'll be able to decorate your businesses with greater freedom and flexibility.[\/p][\/*][*][p][b]Animation Improvements:[\/b] New animations and improvements to existing ones.[\/p][\/*][*][p][b]Optimization, Bug Fixes, and Testing:[\/b] Extensive improvements to deliver a more stable, smooth, and polished gameplay experience.[\/p][\/*][\/olist][p][\/p][h2]\ud83d\ude80 FEBRUARY 2027 \u2013 VERSION 1.0 RELEASE[\/h2][p]With all these exciting additions, we're aiming to release Dearbnb Version 1.0 in February 2027![\/p][p]This roadmap highlights the main features and improvements we're planning to work on. Of course, we have even more surprises in store! Throughout development, we'll continue enriching the game with new ideas, additional content, and suggestions from our community.[\/p][p]Our goal isn't just to add more content, but to [b]create a more balanced and much more enjoyable Dearbnb experience where players can constantly discover new things and actively manage their businesses.[\/b][\/p][p]Thank you for being part of this journey with us. Every comment, suggestion, and piece of feedback means a lot to our team.[\/p][p][b]Together, we'll make Dearbnb an even better game! [\/b][\/p][p]With love,\n[b]The Dearbnb Development Team[\/b][\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1889357040_1793710182_0"],"language":0,"hidden":0,"forum_topic_id":"573805391546492469","event_gid":"695402262914141141","voteupcount":27,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805391546492469","rtime32_last_modified":1793780774,"news_post_gid":"0","rtime_mod_reviewed":1793710182,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793705929,"votes_up":27,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561406856400084551","gidfeature2":"573805391546492469"},{"gid":"695402262914141138","clan_steamid":"103582791475472266","event_name":"\ud83c\udf89 We've Surpassed 10,000 Sales! Thank You!","event_type":28,"appid":4338180,"server_address":null,"server_password":null,"rtime32_start_time":1793705400,"rtime32_end_time":1793708340,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Dearbnb has officially surpassed 10,000 sales on Steam! \",null,null,null,null,null,\"\u300a\u6c11\u5bbf\u4e3b\u7406\u4eba\u300bSteam \u9500\u91cf\u6b63\u5f0f\u7a81\u783410,000\u4efd\uff01\",\"\u300a\u6c11\u5bbf\u4e3b\u7406\u4eba\u300bSteam \u92b7\u91cf\u6b63\u5f0f\u7a81\u783410,000\u5957\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,
l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"695402262914140231","clanid":"45950858","posterid":"0","headline":"Dearbnb v0.2.62 \u2013 Patch","posttime":1793435952,"updatetime":1793675974,"body":"[h3][b]Bug Fixes[\/b][\/h3][list][*][p]Fixed an issue where Simplified Chinese text was displayed incorrectly.[\/p][\/*][*][p]Fixed a bug where one of the walls in a specific house was not affected by material changes.[\/p][\/*][*][p]Fixed an issue where some doors would remain visible when changing room focus.[\/p][\/*][*][p]Fixed a bug where the last entry in the tutorial panel would not update after changing the game language.[\/p][\/*][*][p]Fixed an issue where customers could get stuck in a certain house at the beginning of a rental period.[\/p][\/*][*][p]Fixed a bug where quest panel arrows would occasionally fail to appear.[\/p][\/*][*][p]Fixed an issue where owned properties were missing from the bankruptcy panel.[\/p][\/*][*][p]Fixed a rare issue where zone task progress would fail to update.[\/p][\/*][*][p]Fixed a bug where the tutorial could incorrectly request another expansion or request one at the wrong time.[\/p][\/*][*][p]Fixed a very rare tutorial progression issue caused by frame timing, which could prevent the second tutorial from playing correctly.[\/p][\/*][*][p]Fixed a bug where the business open\/close button did not display a tooltip.[\/p][\/*][*][p]Fixed an issue where notifications would occasionally remain visible.[\/p][\/*][*][p]Fixed a bug where time control settings were not saved correctly.[\/p][\/*][*][p]Fixed an issue where switching from paused to fast-forward speed was not saved correctly.[\/p][\/*][*][p]Fixed an error related to the exercise bicycle and gym bar.[\/p][\/*][*][p]Fixed incorrect item placement surfaces on some shelves.[\/p][\/*][\/list][h3][b]Improvements[\/b][\/h3][list][*][p]Improved localization for Asian languages.[\/p][\/*][*][p]Removed placement restrictions on hoods, allowing for more freedom when decorating.[\/p][\/*][\/list]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1415716708_1793436115_0","ModAct_768955665_1793621799_4","ModAct_1896160435_1793673238_4","ModAct_1896160435_1793674715_4","ModAct_1434573178_1793677255_4"],"language":0,"hidden":0,"forum_topic_id":"573805072991267884","event_gid":"695402262914140230","voteupcount":14,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805072991267884","rtime32_last_modified":1793677255,"news_post_gid":"0","rtime_mod_reviewed":1793677255,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793435904,"votes_up":14,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561406856400084551","gidfeature2":"573805072991267884"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["695402262914141142","695402262914141139"],"last_update_event":{"rtime":1793435940,"event_gid":"695402262914140230","announcement_gid":"695402262914140231","clan_account_id":45950858}}};

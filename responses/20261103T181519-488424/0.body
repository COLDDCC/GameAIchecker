			mutations.forEach(function(mutation) {
				mutation.addedNodes.forEach(function(node) {
					if(node.tagName === 'IFRAME') {
						node.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox');

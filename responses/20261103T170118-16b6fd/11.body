    <script>
    (function () {
        var selector = '.kg-image-card > .kg-image[width][height], .kg-gallery-image > img';
        var loading = false;

        function loadLightbox(event) {
            var target = event.target.closest && event.target.closest(selector);
            if (!target || loading) return;

            event.preventDefault();
            loading = true;
            document.removeEventListener('click', loadLightbox, true);

            var script = document.createElement('script');
            script.src = 'https://www.vlsi.kr/assets/built/lightbox.js?v=eKrppIMCVjJrjHFc';
            script.async = true;
            script.onload = function () {
                if (typeof window.lightbox === 'function') window.lightbox(selector, target);
            };
            script.onerror = function () {
                loading = false;
                document.addEventListener('click', loadLightbox, true);
            };
            document.head.appendChild(script);
        }

        document.addEventListener('click', loadLightbox, true);
    })();
    </script>


<dialog class="vk-signup-dialog" id="vk-signup-dialog" aria-labelledby="vk-signup-title">
  <button type="button" class="vk-signup-close" data-vk-signup-close aria-label="Close">×</button>
  <p class="vk-signup-eyebrow">VLSI KOREA BRIEFING</p>
  <h2 id="vk-signup-title" data-vk-member-copy="title">반도체를 읽는 안목, 메일함으로.</h2>
  <p class="vk-signup-intro" data-vk-member-copy="intro">엔지니어의 시각과 산업의 흐름을 함께. 무료로 구독하세요.</p>
  <form data-members-form="subscribe" class="vk-signup-form" data-signup-placement="profile-dialog">

      { href: "https://www.facebook.com/vlsikr", label: "Facebook", path: "M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z" },
      { href: "https://www.youtube.com/@vlsikr", label: "YouTube", path: "M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z" },
      { href: "https://mastodon.social/@vlsikr", label: "Mastodon", path: "M23.27 12.14c0-3.85-2.52-4.98-2.52-4.98C19.47.51 15.83.04 12 .02h-.07C8.1.04 4.46.5 3.2 1.16 3.2 1.16.72 1.63.2 5.31.2 12.14c0 1.06.01 2.33.07 3.67.26 5.9 2.03 11.7 12.24 12.57 2.26.2 4.2.24 5.76.21 2.83-.07 4.42-.44 4.42-.44-.09-1.97-.66-2.83-.66-2.83-1.55.16-3.59.21-4.09.18-2.17-.12-3.56-.77-3.56-.77l-.05-1.14s1.62.45 3.66.4c1.3-.03 2.54-.1 2.72-.74.03-.1.04-.23.04-.36 0 0-1.3.33-2.75.29-2.91-.08-4.3-1.22-4.61-4.09-.02-.24-.03-.47-.03-.72 0 0 2.03.5 4.61.62 1.57.08 3.05-.1 4.54-.29 2.87-.36 5.36-2.23 5.67-3.93.1-.53.15-1.14.15-1.76zM20.9 16.95h-2.56V10.7c0-1.32-.55-1.99-1.66-1.99-1.22 0-1.84.8-1.84 2.36v3.42h-2.55V11.07c0-1.56-.61-2.36-1.84-2.36-1.1 0-1.66.67-1.66 1.99v6.25H6.23V10.6c0-1.32.34-2.37 1.01-3.14.7-.8 1.61-1.21 2.75-1.21 1.31 0 2.31.51 2.97 1.52l.64 1.08.64-1.08c.66-1.01 1.66-1.52 2.97-1.52 1.14 0 2.05.41 2.75 1.21.67.77 1.01 1.82 1.01 3.14v6.35z" },
      { href: "https://blog.csdn.net/2401_84976491", label: "CSDN", letter: "C" },
      { href: "https://zenn.dev/vlsikorea", label: "Zenn", letter: "Z" },
      { href: "https://www.tumblr.com/vlsikr", label: "Tumblr", letter: "t" }
    ];
    function icon(l) {
      if (l.path) return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="' + l.path + '"/></svg>';
      return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><text x="12" y="17" text-anchor="middle" font-size="14" font-weight="700" font-family="inherit">' + l.letter + "</text></svg>";
    }
    function makeLink(l) {
      var a = document.createElement("a");
      a.href = l.href; a.target = "_blank"; a.rel = "noopener";
      a.setAttribute("aria-label", l.label); a.title = l.label;
      a.innerHTML = icon(l);
      return a;
    }
    function add() {
      var box = document.querySelector(".gh-author-social");
      if (!box || box.querySelector(".vlsi-social-toggle")) return;
      var existing = {};
      document.querySelectorAll(".gh-author-social a").forEach(function (a) { existing[a.href.replace(/\/$/, "")] = 1; });
      CORE.forEach(function (l) { if (!existing[l.href.replace(/\/$/, "")]) box.appendChild(makeLink(l)); });
      var more = document.createElement("span");
      more.className = "gh-author-social-more";
      MORE.forEach(function (l) { if (!existing[l.href.replace(/\/$/, "")]) more.appendChild(makeLink(l)); });
      box.appendChild(more);
      var btn = document.createElement("button");
      btn.type = "button"; btn.className = "vlsi-social-toggle"; btn.textContent = "+ 전체 보기";
      btn.setAttribute("aria-expanded", "false");
      btn.addEventListener("click", function () {
        var open = more.classList.toggle("open");
        btn.textContent = open ? "접기" : "+ 전체 보기";
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
      box.appendChild(btn);
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", add); else add();
  })();
  </script>
<!-- VLSI support + paid Q&A block v2 (2026-10-24, copy revised per user direction)
     APPEND to Ghost Admin > Settings > Code injection > Site Footer. Do NOT replace existing content.
     Revision vs v1: support is framed as TWO kinds — (1) pure encouragement support,
     (2) support with a question attached. Amount choice on BMC is mentioned.
     All answer-guarantee wording removed, and a short non-contract notice was added:
     support is voluntary encouragement, not a contract in exchange for an answer;
     questions about the operator's employer or questions too hard to answer may go unanswered.
     Behavior: on post pages only (body.post-template, not page-template) it appends a
     "Support (Buy Me a Coffee) + Paid Q&A" card at the very end of the article body
     (.gh-content), directly below the in-body subscribe CTA blockquote.
     Pages like /fan/, home, tag/author archives get nothing.
     Language: URL first segment (ko/en/ja have full copy; every other language falls back to en).
     Idempotent: element id "vlsi-support-qa-block" guard prevents duplicates.
     Rollback: delete this whole block (from this comment to the closing </script>) from Site Footer.
     LINK MANAGEMENT: the two URLs live in ONE place — the LINKS object at the top of the script.
 COI UPDATE 2026-10-26: paid Q&A positioning REMOVED by user decision. This block is voluntary reader support ONLY -- no Q&A product, no services promised. -->
<style>
  #vlsi-support-qa-block { margin: 40px 0 8px; padding: 22px 22px 18px; border: 1px solid rgba(0,0,0,.13);
    border-radius: 14px; background: rgba(127,127,127,.05); }
  #vlsi-support-qa-block .vsq-row + .vsq-row { margin-top: 20px; padding-top: 18px; border-top: 1px dashed rgba(0,0,0,.14); }
  #vlsi-support-qa-block .vsq-title { margin: 0 0 6px; font-size: 17px; font-weight: 700; line-height: 1.4; }
  #vlsi-support-qa-block .vsq-text { margin: 0 0 12px; font-size: 14.5px; line-height: 1.65; opacity: .85; }
  #vlsi-support-qa-block .vsq-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  #vlsi-support-qa-block .vsq-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px;
    border-radius: 999px; font-size: 14px; font-weight: 700; line-height: 1.2; text-decoration: none; }
  #vlsi-support-qa-block .vsq-btn-coffee { background: #ffdd00; color: #111; border: 1px solid #e6c700; }
  #vlsi-support-qa-block .vsq-btn-coffee:hover { background: #f5d400; }
  #vlsi-support-qa-block .vsq-btn-qa { background: transparent; color: inherit; border: 1.5px solid currentColor; }
  #vlsi-support-qa-block .vsq-btn-qa:hover { opacity: .75; }
  #vlsi-support-qa-block .vsq-note { margin: 16px 0 0; font-size: 12.5px; line-height: 1.6; opacity: .62; }
  @media (max-width: 480px) {
    #vlsi-support-qa-block { padding: 18px 16px 14px; }
    #vlsi-support-qa-block .vsq-btn { width: 100%; justify-content: center; }
  }
</style>
<script>
(function () {
  /* ==== LINK MANAGEMENT (single place) ==== */
  var LINKS = {
    support: "https://buymeacoffee.com/vlsi?utm_source=vlsi_post&utm_medium=support_block",
    /* Fixed-price Q&A product later: set qa to the product URL (e.g. BMC Extras item). Nothing else changes. */
  };
  var COPY = {
    ko: {
      supportTitle: "☕ 이 글이 도움이 됐나요?",
      supportText: "VLSI Korea는 현직 엔지니어가 운영하는 독립 미디어입니다. 글이 좋았다면 커피로 응원해 주세요 — 금액(커피 수)은 후원 페이지에서 자유롭게 고를 수 있습니다. 후원은 더 깊이 있는 반도체 분석을 계속 이어가는 힘이 됩니다.",
      supportBtn: "커피로 응원하기",
      note: "안내: 후원은 응원의 의미일 뿐, 답변과 교환되는 계약이 아닙니다. 질문을 남겨 주셔도 답변을 보장드리지는 않으며, 운영자의 소속 회사와 관련된 질문이나 답변이 어려운 질문에는 답하지 못할 수 있습니다. 답장이 없더라도 후원은 응원으로 감사히 받겠습니다. 질문은 이메일로 보내 주시면 편집자 재량으로 공개 글로 다룰 수 있으나, 답변을 보장하지는 않습니다."
    },
    en: {
      supportTitle: "☕ Found this analysis helpful?",
      supportText: "VLSI Korea is an independent publication run by a practicing semiconductor engineer. If you enjoyed this piece, cheer it on with a coffee — you can choose any amount (number of coffees) on the support page. Your support keeps in-depth semiconductor coverage going.",
      supportBtn: "Support with a coffee",
      note: "Please note: support is a voluntary gesture of encouragement, not a payment in exchange for an answer. Attaching a question doesn't guarantee a reply — I can't answer questions about my employer, and some questions may be beyond what I can address. Even when I can't reply, your support is gratefully received as the encouragement it is."
    },
    ja: {
      supportTitle: "☕ この分析が役に立ったら",
      supportText: "VLSI Koreaは現役の半導体エンジニアが運営する独立メディアです。記事が良かったら、コーヒーで応援してください — 金額（コーヒーの数）は支援ページで自由に選べます。ご支援が、深い半導体分析を続ける力になります。",
      supportBtn: "コーヒーで応援する",
      note: "ご案内：ご支援は応援の気持ちによるもので、回答と引き換えの契約ではありません。質問を添えていただいても回答をお約束するものではなく、運営者の所属会社に関するご質問や、回答が難しいご質問にはお答えできない場合があります。お返事できない場合でも、ご支援は応援としてありがたく受け取ります。"
    }
  };
  function lang() {
    var seg = (location.pathname.split("/")[1] || "").toLowerCase();
    return COPY[seg] ? seg : "en";
  }
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function build() {
    var c = COPY[lang()];
    var block = el("div");
    block.id = "vlsi-support-qa-block";
    var row1 = el("div", "vsq-row");
    row1.appendChild(el("p", "vsq-title", c.supportTitle));
    row1.appendChild(el("p", "vsq-text", c.supportText));
    var b1 = el("div", "vsq-btns");
    var a1 = el("a", "vsq-btn vsq-btn-coffee", "☕ " + c.supportBtn);
    a1.href = LINKS.support; a1.target = "_blank"; a1.rel = "noopener";
    b1.appendChild(a1); row1.appendChild(b1);
    block.appendChild(row1); 
    block.appendChild(el("p", "vsq-note", c.note));
    return block;
  }
  function init() {
    if (!document.body) return;
    if (!document.body.classList.contains("post-template")) return;
    if (document.body.classList.contains("page-template")) return;
    if (document.getElementById("vlsi-support-qa-block")) return;
    var host = document.querySelector("article.gh-article .gh-content")
      || document.querySelector(".gh-content")
      || document.querySelector("article.gh-article");
    if (!host) return;
    host.appendChild(build());
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init); else init();
})();
</script>

<!-- coffee-btn-contrast-fix-2026-10-25 -->
<style>
#vlsi-support-qa-block .vsq-btn-coffee { background: #6F4E37 !important; color: #FFFFFF !important; border-color: #54382A !important; }
#vlsi-support-qa-block .vsq-btn-coffee:hover { background: #7D5A41 !important; }
</style>

<!-- vlsi-about-locale-link -->
<script>
(function(){
  var m = location.pathname.match(/^\/(ko|en|ja|zh-tw|zh|es|pt|id|vi)(?:\/|$)/);
  if(!m || m[1]==='ko') return;
  var target = '/about-' + m[1] + '/';
  document.querySelectorAll('a[href$="/about/"]').forEach(function(a){
    try { var u = new URL(a.href); if(u.origin===location.origin && u.pathname==='/about/') a.href = target; } catch(e){}
  });
})();
</script>
<!-- vlsi-popup-exp-v1.1 -->
<!-- VLSI Korea subscribe popup A/B experiment v1.1 (2026-10-25, signup-i18n-fix).
     REPLACES the v1 block (vlsi-popup-exp-v1) at the END of codeinjection_foot.
     What changed vs v1 (R1 of GHOST-ONLY-HACKS.md):
       - The CTA anchor to the raw Portal (#/portal/signup/free) is gone.
         Each variant now carries an embedded Ghost members form
         (data-members-form="signup") with a hidden data-members-newsletter
         pinned to the newsletter of the reader's language segment, so the
         assignment is exact on every segment (dialog-grade), not Portal-default.
       - Form submit fires the existing subscribe_prompt_click GA event
         (metric definition: link click -> form submit; see APPLY.md).
       - On success (Portal adds .success to the form) the card swaps to a
         localized success view; non-Korean segments also get the Korean
         confirmation-mail preview panel (R-C3).
     Unchanged vs v1: variant assignment/persistence, trigger (35% scroll /
     25s dwell), blocked conditions, 14-day frequency cap, session-once,
     view/dismiss GA events with variant parameter.
     This block still pre-sets the old VLSIKR-POPUP:v3 session flag below so
     the legacy white popup stays suppressed. -->
<script>
try { sessionStorage.setItem('vk-own-popup-shown-v1', '1'); } catch (e) {}
</script>
<script>
/* Fallback guard: only relevant if this block was APPENDED after the v1
   block instead of replacing it (see APPLY.md). Removes the v1 root so a
   single popup shows. In the normal replacement install this finds nothing. */
try {
    var legacyPopupRoot = document.getElementById('vk-popup-exp-root');
    if (legacyPopupRoot && legacyPopupRoot.parentNode) legacyPopupRoot.parentNode.removeChild(legacyPopupRoot);
} catch (e) {}
</script>
<style>
#vk-popup-exp-root{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.72);padding:12px;box-sizing:border-box}
#vk-popup-exp-card{position:relative;width:calc(100% - 24px);max-width:430px;max-height:calc(100vh - 48px);overflow-y:auto;background:#000;color:#fff;border:1px solid #2a2a2a;border-radius:20px;padding:30px 26px 24px;box-shadow:0 30px 70px rgba(0,0,0,.8);font-family:inherit;box-sizing:border-box}
#vk-popup-exp-card *{box-sizing:border-box}
.vkexp-x{position:absolute;top:12px;right:14px;background:none;border:0;font-size:22px;line-height:1;color:#8a8a8a;cursor:pointer;padding:4px}
.vkexp-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:.24em;color:#9a9a9a}
.vkexp-title{font-size:27px;line-height:1.25;font-weight:900;letter-spacing:-.02em;margin:13px 0 0;color:#fff}
.vkexp-title-huge{font-size:34px;line-height:1.1;letter-spacing:-.01em}
.vkexp-body{font-size:14px;line-height:1.65;color:#bdbdbd;margin:12px 0 0}
.vkexp-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}
.vkexp-cell{border:1px solid #2c2c2c;border-radius:12px;padding:11px 13px;background:#0a0a0a}
.vkexp-cell-label{display:block;font-size:13px;font-weight:700;color:#eee}
.vkexp-cell-desc{display:block;font-size:11px;font-weight:500;color:#888;margin-top:3px;line-height:1.45}
.vkexp-list{margin-top:18px;border-top:1px solid #222}
.vkexp-list-row{display:flex;gap:12px;padding:11px 2px;border-bottom:1px solid #222;font-size:13.5px;font-weight:700;color:#eee}
.vkexp-list-num{font-style:normal;color:#666;font-weight:800;font-size:12px;padding-top:1px}
.vkexp-chips{margin-top:16px;font-size:12px;line-height:2}
.vkexp-chip{display:inline-block;color:#fff;border:1px solid #333;border-radius:999px;padding:3px 10px;margin:0 4px 4px 0;font-weight:700;white-space:nowrap}
.vkexp-rule{height:1px;background:#fff;opacity:.9;margin:20px 0 2px}
.vkexp-form{margin-top:20px}
.vkexp-email{display:block;width:100%;background:#141414;border:1px solid #333;border-radius:999px;padding:13px 16px;font-size:14px;color:#fff;outline:none}
.vkexp-email::placeholder{color:#777}
.vkexp-cta{display:block;width:100%;margin-top:8px;background:#fff;color:#000;font-weight:900;font-size:15.5px;text-align:center;padding:15px;border:0;border-radius:999px;text-decoration:none;cursor:pointer}
.vkexp-error{color:#ff9fa7;font-size:12.5px;line-height:1.5;margin-top:8px}
.vkexp-error:empty{display:none}
.vkexp-footer{margin-top:12px;font-size:11.5px;text-align:center;color:#777;line-height:1.5}
.vkexp-later{margin-top:11px;text-align:center;font-size:12.5px;color:#666;text-decoration:underline;cursor:pointer;background:none;border:0;width:100%;padding:0}
.vkexp-center{text-align:center}
.vkexp-center .vkexp-body{text-align:center}
.vkexp-success{margin-top:2px}
.vkexp-success-body{font-size:14px;line-height:1.65;color:#bdbdbd;margin:12px 0 0}
.vkexp-preview-note{font-size:13px;line-height:1.6;color:#e8e8e8;margin-top:16px;border:1px solid #2c2c2c;border-radius:12px;padding:12px 13px;background:#0a0a0a;text-align:left}
.vkexp-mailpreview{margin-top:10px;background:#fff;color:#111;border-radius:12px;padding:14px 16px;pointer-events:none;text-align:left}
.vkexp-mp-head{font-size:11px;font-weight:800;letter-spacing:.08em;color:#555;border-bottom:1px solid #e5e5e5;padding-bottom:8px}
.vkexp-mp-body strong{display:block;font-size:15px;margin:10px 0 6px;color:#111}
.vkexp-mp-body p{font-size:12.5px;line-height:1.55;color:#333;margin:0 0 10px}
.vkexp-mp-btn{display:block;text-align:center;background:#000;color:#fff;font-weight:700;font-size:13px;border-radius:8px;padding:10px}
.vkexp-mp-small{font-size:11px;color:#777;margin-top:8px}
</style>
<script>
(function () {
    'use strict';
    var VARIANTS = [
        {
            id: 'v1', kind: 'grid',
            eyebrow: 'VLSI KOREA — NEWSLETTER',
            title: '반도체의 모든 것, 메일 한 통으로 끝',
            body: '기술부터 투자까지. 매일 새로 쌓이는 반도체의 모든 변화를 현직 엔지니어가 골라서 정리해 보내드립니다.',
            grid: [
                ['기술', 'HBM·공정·패키징·EDA 딥다이브'],
                ['투자·시장', '실적·주가·리포트·수급'],
                ['기업·산업', '전략·공급망·지정학'],
                ['커리어', '연봉·채용·현직자 인사이트']
            ],
            cta: '무료 구독',
            footer: '무료 · 스팸 없음 · 언제든 해지 · 구독자 300명+'
        },
        {
            id: 'v2', kind: 'list',
            eyebrow: 'DAILY SILICON · EVERY MORNING',
            title: '아침 5분이면 반도체 전체가 보입니다',
            body: '뉴스는 넘치고 시간은 없습니다. 하루의 반도체를 한 통에 압축해 아침마다 보내드립니다.',
            list: [
                '오늘 꼭 알아야 할 핵심 뉴스',
                '기술 딥다이브 한 편',
                '시장과 주가의 움직임',
                '기업·산업·커리어 신호'
            ],
            cta: '매일 받아보기',
            footer: '무료 · 스팸 없음 · 언제든 해지'
        },
        {
            id: 'v3', kind: 'chips',
            eyebrow: 'VLSI KOREA — NEWSLETTER',
            title: '반도체는 매일 움직입니다. 놓치면, 격차가 됩니다',
            body: '새 공정, 대형 계약, 실적 서프라이즈, 연봉 판도까지 — 한 번 놓친 정보는 다시 돌아오지 않습니다. 중요한 것만 골라 아침마다 전해드립니다.',
            chips: ['기술', '투자', '기업', '산업', '커리어'],
            cta: '놓치지 않기 — 무료 구독',
            footer: '무료 · 스팸 없음 · 언제든 해지',
            later: '나중에 볼게요'
        },
        {
            id: 'v4', kind: 'minimal', center: true,
            eyebrow: 'VLSI KOREA',
            title: 'EVERYTHING SEMICONDUCTOR',
            body: '반도체에 관한 모든 것 — 기술, 투자, 산업, 그리고 일하는 사람들까지. 매일 아침, 메일로.',
            cta: '구독',
            footer: 'Free · No spam · Unsubscribe anytime'
        }
    ];
    var V1_INTL = {
        en: {
            id: 'v1-intl', kind: 'grid',
            eyebrow: 'VLSI KOREA — NEWSLETTER',
            title: 'Everything semiconductor, in one email',
            body: 'From technology to investing. Every day, a practicing engineer picks and distills the semiconductor changes that matter, and sends them to you.',
            grid: [
                ['Technology', 'HBM, process, packaging and EDA deep dives'],
                ['Investing & Markets', 'Earnings, stocks, reports and flows'],
                ['Companies & Industry', 'Strategy, supply chains and geopolitics'],
                ['Career', 'Salaries, hiring and insider insight']
            ],
            cta: 'Subscribe free',
            footer: 'Free · No spam · Unsubscribe anytime · Join 300+ subscribers'
        },
        ja: {
            id: 'v1-intl', kind: 'grid',
            eyebrow: 'VLSI KOREA — NEWSLETTER',
            title: '半導体のすべてを、メール1通で',
            body: '技術から投資まで。毎日積み重なる半導体の変化を、現役エンジニアが選んで整理してお届けします。',
            grid: [
                ['技術', 'HBM・プロセス・パッケージング・EDAの深掘り'],
                ['投資・市場', '決算・株価・レポート・需給'],
                ['企業・産業', '戦略・サプライチェーン・地政学'],
                ['キャリア', '年収・採用・現役インサイト']
            ],
            cta: '無料で購読',
            footer: '無料 · スパムなし · いつでも解除可 · 購読者300名+'
        }
    };
    var NEWSLETTER_BY_SEG = {
        ko: 'VLSI Korea — 한국어',
        en: 'VLSI Korea — English',
        ja: 'VLSI Korea — 日本語'
    };
    var EMAIL_PLACEHOLDER = { ko: '이메일 주소', en: 'Email address', ja: 'メールアドレス' };
    var SUCCESS_COPY = {
        ko: {
            title: '메일함을 확인해 주세요',
            body: '이메일의 확인 링크를 누르면 구독이 완료됩니다.',
            preview: null
        },
        en: {
            title: 'Check your inbox',
            body: 'Follow the confirmation link in the email to complete your subscription.',
            preview: 'One thing to know: the confirmation email itself arrives in Korean — a limitation of our mail system. If it looks like the message below, it is the right one. Tap the black button to finish.'
        },
        ja: {
            title: 'メールを送信しました',
            body: 'メールボックスを確認してください。メール内の確認リンクを押すと購読が完了します。',
            preview: '確認メールはシステムの都合で韓国語で届きます。下のようなメールが届いていれば正常です。黒いボタン「이메일을 확인해 주세요」を押すと購読が完了します。'
        }
    };
    var MAIL_PREVIEW_HTML =
        '<div class="vkexp-mp-head">VLSI KOREA</div>' +
        '<div class="vkexp-mp-body"><strong>안녕하세요,</strong>' +
        '<p>탭하시면 VLSI Korea 구독이 완료돼요! 이 링크를 사용하여 이메일 주소를 확인해 주세요.</p>' +
        '<span class="vkexp-mp-btn">이메일을 확인해 주세요</span>' +
        '<p class="vkexp-mp-small">보안을 위해 링크는 24시간 후에 만료돼요.</p></div>';
    var article = document.querySelector('article .gh-content');
    if (!article) return;
    if (!document.body || document.body.dataset.memberStatus !== 'anonymous') return;
    var DKEY = 'vk-popup-exp-dismissed', SKEY = 'vk-popup-exp-shown-v1', VKEY = 'vk-popup-exp-variant';
    var FOURTEEN_DAYS = 14 * 24 * 3600 * 1000;
    try {
        if (Date.now() - Number(localStorage.getItem(DKEY) || 0) < FOURTEEN_DAYS) return;
        if (sessionStorage.getItem(SKEY)) return;
    } catch (e) {}
    var seg = (location.pathname.split('/')[1] || 'ko').toLowerCase();
    var def, variantId, uiLang;
    if (seg === 'ko') {
        uiLang = 'ko';
        var saved = null;
        try { saved = localStorage.getItem(VKEY); } catch (e) {}
        def = null;
        for (var i = 0; i < VARIANTS.length; i++) if (VARIANTS[i].id === saved) def = VARIANTS[i];
        if (!def) {
            def = VARIANTS[Math.floor(Math.random() * VARIANTS.length)];
            try { localStorage.setItem(VKEY, def.id); } catch (e) {}
        }
        variantId = def.id;
    } else {
        uiLang = seg === 'ja' ? 'ja' : 'en';
        def = V1_INTL[uiLang];
        variantId = 'v1-intl';
    }
    var newsletterName = NEWSLETTER_BY_SEG[uiLang];
    var successCopy = SUCCESS_COPY[uiLang];
    function track(name) {
        if (typeof window.gtag === 'function') {
            window.gtag('event', name, {placement: 'own_popup_exp', variant: variantId});
        }
    }
    function stampDismissed() {
        try { localStorage.setItem(DKEY, String(Date.now())); } catch (e) {}
    }
    function mk(tag, cls, text) {
        var el = document.createElement(tag);
        if (cls) el.className = cls;
        if (text != null) el.textContent = text;
        return el;
    }
    function hideEl(el) { if (el) el.style.display = 'none'; }
    var root = mk('div');
    root.id = 'vk-popup-exp-root';
    var card = mk('div');
    card.id = 'vk-popup-exp-card';
    if (def.center) card.className = 'vkexp-center';
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-modal', 'true');
    card.setAttribute('aria-label', def.title);
    var xBtn = mk('button', 'vkexp-x', '×');
    xBtn.setAttribute('type', 'button');
    xBtn.setAttribute('aria-label', 'Close');
    card.appendChild(xBtn);
    card.appendChild(mk('div', 'vkexp-eyebrow', def.eyebrow));
    var titleEl = mk('div', 'vkexp-title' + (def.kind === 'minimal' ? ' vkexp-title-huge' : ''), def.title);
    card.appendChild(titleEl);
    if (def.kind === 'minimal') card.appendChild(mk('div', 'vkexp-rule'));
    var bodyEl = mk('p', 'vkexp-body', def.body);
    card.appendChild(bodyEl);
    var extraEl = null;
    if (def.kind === 'grid' && def.grid) {
        extraEl = mk('div', 'vkexp-grid');
        def.grid.forEach(function (pair) {
            var cell = mk('div', 'vkexp-cell');
            cell.appendChild(mk('span', 'vkexp-cell-label', pair[0]));
            cell.appendChild(mk('span', 'vkexp-cell-desc', pair[1]));
            extraEl.appendChild(cell);
        });
        card.appendChild(extraEl);
    }
    if (def.kind === 'list' && def.list) {
        extraEl = mk('div', 'vkexp-list');
        def.list.forEach(function (item, idx) {
            var row = mk('div', 'vkexp-list-row');
            row.appendChild(mk('i', 'vkexp-list-num', ('0' + (idx + 1)).slice(-2)));
            row.appendChild(mk('span', null, item));
            extraEl.appendChild(row);
        });
        card.appendChild(extraEl);
    }
    if (def.kind === 'chips' && def.chips) {
        extraEl = mk('div', 'vkexp-chips');
        def.chips.forEach(function (chip) { extraEl.appendChild(mk('span', 'vkexp-chip', chip)); });
        card.appendChild(extraEl);
    }
    var form = mk('form', 'vkexp-form');
    form.setAttribute('data-members-form', 'signup');
    var nlInput = mk('input');
    nlInput.setAttribute('type', 'hidden');
    nlInput.setAttribute('data-members-newsletter', '');
    nlInput.value = newsletterName;
    form.appendChild(nlInput);
    var srcLabel = mk('input');
    srcLabel.setAttribute('type', 'hidden');
    srcLabel.setAttribute('data-members-label', '');
    srcLabel.value = 'source:popup-' + variantId;
    form.appendChild(srcLabel);
    var emailInput = mk('input', 'vkexp-email');
    emailInput.setAttribute('type', 'email');
    emailInput.setAttribute('data-members-email', '');
    emailInput.setAttribute('required', '');
    emailInput.setAttribute('autocomplete', 'email');
    emailInput.setAttribute('placeholder', EMAIL_PLACEHOLDER[uiLang]);
    form.appendChild(emailInput);
    var submitBtn = mk('button', 'vkexp-cta', def.cta);
    submitBtn.setAttribute('type', 'submit');
    form.appendChild(submitBtn);
    var errEl = mk('p', 'vkexp-error');
    errEl.setAttribute('data-members-error', '');
    form.appendChild(errEl);
    card.appendChild(form);
    var footerEl = mk('div', 'vkexp-footer', def.footer);
    card.appendChild(footerEl);
    var laterBtn = null;
    if (def.later) {
        laterBtn = mk('button', 'vkexp-later', def.later);
        laterBtn.setAttribute('type', 'button');
        card.appendChild(laterBtn);
    }
    var successView = mk('div', 'vkexp-success');
    successView.style.display = 'none';
    successView.appendChild(mk('p', 'vkexp-success-body', successCopy.body));
    if (successCopy.preview) {
        successView.appendChild(mk('p', 'vkexp-preview-note', successCopy.preview));
        var previewCard = mk('div', 'vkexp-mailpreview');
        previewCard.innerHTML = MAIL_PREVIEW_HTML;
        successView.appendChild(previewCard);
    }
    card.appendChild(successView);
    root.appendChild(card);
    document.body.appendChild(root);
    var successShown = false;
    function showSuccess() {
        if (successShown) return;
        successShown = true;
        titleEl.textContent = successCopy.title;
        hideEl(bodyEl); hideEl(extraEl); hideEl(form); hideEl(footerEl); hideEl(laterBtn);
        successView.style.display = 'block';
        track('subscribe_prompt_success');
    }
    if (window.MutationObserver) {
        var formObserver = new MutationObserver(function () {
            if ((' ' + form.className + ' ').indexOf(' success ') >= 0) showSuccess();
        });
        formObserver.observe(form, {attributes: true, attributeFilter: ['class']});
    }
    form.addEventListener('submit', function () {
        stampDismissed();
        track('subscribe_prompt_click');
    });
    var shown = false, dwell = 0, lastTick = Date.now(), pending = false;
    function blocked() {
        return document.hidden || location.hash.indexOf('#/portal') === 0 ||
            document.querySelector('dialog[open]') ||
            document.documentElement.classList.contains('has-cookie-consent');
    }
    function show() {
        if (shown) return;
        if (blocked()) { pending = true; return; }
        shown = true;
        try { sessionStorage.setItem(SKEY, '1'); } catch (e) {}
        root.style.display = 'flex';
        track('subscribe_prompt_view');
    }
    function dismiss() {
        if (!shown) return;
        root.style.display = 'none';
        stampDismissed();
        track('subscribe_prompt_dismiss');
    }
    xBtn.addEventListener('click', dismiss);
    if (laterBtn) laterBtn.addEventListener('click', dismiss);
    root.addEventListener('click', function (ev) { if (ev.target === root) dismiss(); });
    document.addEventListener('keydown', function (ev) {
        if (shown && (ev.key === 'Escape' || ev.keyCode === 27)) dismiss();
    });
    setInterval(function () {
        var now = Date.now();
        if (!document.hidden) dwell += now - lastTick;
        lastTick = now;
        if (!shown && dwell >= 25000) show();
        if (pending && !blocked()) { pending = false; show(); }
    }, 500);
    window.addEventListener('scroll', function () {
        if (shown) return;
        var rect = article.getBoundingClientRect();
        if (rect.height > 0 && window.innerHeight - rect.top >= rect.height * 0.35) show();
    }, {passive: true});
})();
</script>

<!-- vlsi-cta-intercept-v1 -->
<!-- VLSI Korea body-CTA dialog intercept v1 (2026-10-25, signup-i18n-fix R1).
     Append at the END of codeinjection_foot (after all existing blocks).
     Problem: in-article subscribe CTAs (subscribe-cta cta.json, mid-cta)
     and other in-content links point at the raw Portal
     (https://www.vlsi.kr/#/portal/signup/free). Portal assigns the
     signup-default newsletter (Korean) regardless of the article's
     language. The theme's own dialog interceptor
     (theme 3.1.35, assets/built/member-experience.js) only matches
       [data-vk-subscribe], a[data-portal="signup"], button[data-portal="signup"],
       a[href="#/portal/signup"], a[href="https://www.vlsi.kr/#/portal/signup"]
     so the /free-suffixed content links escape it.
     This block closes the gap with the same mechanism: a capture-phase
     document click listener that opens #vk-signup-dialog (which pins the
     correct newsletter per language) instead of following the link.
     - Language default: before opening, the dialog's language select is
       set to the current page segment (when the dialog offers that
       language) and a bubbling 'change' is dispatched, so the theme
       labels() handler and the SIGNUP-SIMPLIFY ja correction re-run and
       the hidden newsletter field lands on the segment's newsletter.
     - Fallbacks: no dialog on the page (signed-in members) -> a synthetic
       click on a temporary a[data-portal="signup"] element (the theme /
       Portal path); modified clicks (ctrl/cmd/middle) and clicks while
       the dialog is already open are left untouched. -->
<script>
(function () {
    'use strict';
    var SEG_TO_DIALOG_LANG = {
        ko: 'ko', en: 'en', ja: 'ja', zh: 'zh', 'zh-tw': 'zh',
        es: 'es', vi: 'vi', ar: 'ar', he: 'he', ms: 'ms'
    };
    function isSignupPortalLink(a) {
        if (!a || a.tagName !== 'A') return false;
        var href = a.getAttribute('href') || '';
        return href.indexOf('/portal/signup') >= 0;
    }
    function openDialog() {
        var dialog = document.getElementById('vk-signup-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return false;
        var seg = (location.pathname.split('/')[1] || 'ko').toLowerCase();
        var want = SEG_TO_DIALOG_LANG[seg];
        var language = dialog.querySelector('#vk-signup-language');
        if (want && language) {
            var has = false;
            for (var i = 0; i < language.options.length; i++) {
                if (language.options[i].value === want) { has = true; break; }
            }
            if (has && language.value !== want) {
                language.value = want;
                var ev;
                try { ev = new Event('change', {bubbles: true}); }
                catch (e) { ev = document.createEvent('Event'); ev.initEvent('change', true, false); }
                language.dispatchEvent(ev);
            }
        }
        if (!dialog.open) dialog.showModal();
        var email = dialog.querySelector('[data-members-email]');
        if (email && typeof email.focus === 'function') email.focus();
        return true;
    }
    document.addEventListener('click', function (e) {
        if (e.button && e.button !== 0) return;
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!isSignupPortalLink(a)) return;
        var dialog = document.getElementById('vk-signup-dialog');
        if (dialog && dialog.open) return;
        if (a.closest && a.closest('#vk-signup-dialog')) return;
        e.preventDefault();
        if (openDialog()) {
            if (typeof window.gtag === 'function') {
                window.gtag('event', 'subscribe_dialog_open', {placement: 'cta_intercept'});
            }
            return;
        }
        var tmp = document.createElement('a');
        tmp.setAttribute('data-portal', 'signup');
        tmp.setAttribute('href', '#/portal/signup');
        tmp.style.display = 'none';
        document.body.appendChild(tmp);
        tmp.click();
        tmp.remove();
    }, true);
})();
</script>

<!-- vlsi-dialog-i18n-fix-v1 -->
<!-- VLSI Korea signup-dialog i18n fix v1 (2026-10-25, signup-i18n-fix R2 + R-C3).
     Append at the END of codeinjection_foot (after all existing blocks).
     R2 — theme 3.1.35 member-experience.js builds dialog copy as
     Object.assign({}, en, local[uiLang]): the English dictionary is the
     base and the per-language dictionary only overrides the keys it has.
     The ja dictionary is missing 7 keys (intro, interests, delivery,
     terms, privacy, success, already), so Japanese readers see those
     slots in English — including the post-submit success message.
     This block re-sets exactly those slots (marked in the theme markup
     with data-vk-member-copy) to Japanese when the page segment is ja.
     It runs on window load +80ms, the same whenReady pattern the existing
     SIGNUP-SIMPLIFY block uses, i.e. after the theme's start() copy pass.
     R-C3 — when the dialog form reaches its success state
     (.vk-signup-form.success, the theme's own CSS hook), readers whose
     chosen delivery language is not Korean get an extra panel inside the
     form: a localized note that the confirmation mail arrives in Korean,
     plus a miniature replica of that mail (white card, greeting, black
     "이메일을 확인해 주세요" button) so they can recognize it and finish.
     The panel language follows the dialog's language select at success
     time (ja -> Japanese, anything else non-ko -> English). -->
<style>
.vk-mail-preview{display:none}
.vk-signup-form.success .vk-mail-preview{display:block}
.vk-mp-note{font-size:13.5px;line-height:1.6;margin:14px 0 0}
.vk-mp-card{margin-top:10px;background:#fff;color:#111;border:1px solid #e0e0e0;border-radius:12px;padding:14px 16px;pointer-events:none}
.vk-mp-head{font-size:11px;font-weight:800;letter-spacing:.08em;color:#555;border-bottom:1px solid #e5e5e5;padding-bottom:8px}
.vk-mp-card strong{display:block;font-size:15px;margin:10px 0 6px;color:#111}
.vk-mp-card p{font-size:12.5px;line-height:1.55;color:#333;margin:0 0 10px}
.vk-mp-btn{display:block;text-align:center;background:#000;color:#fff;font-weight:700;font-size:13px;border-radius:8px;padding:10px}
.vk-mp-small{font-size:11px;color:#777;margin-top:8px}
</style>
<script>
(function () {
    'use strict';
    var JA_MISSING = {
        intro: 'エンジニアの視点と産業の流れを一緒に。無料で購読できます。',
        interests: '関心分野 · 複数選択可',
        delivery: '今すぐ受け取るニュースレターの言語',
        terms: '購読するとVLSI Koreaのメールを受け取ります。いつでも解除できます。言語・関心分野・お仕事の情報は、今後のコンテンツ企画とニュースレターの分類に使用します。任意項目を入力しなくても購読できます。',
        privacy: 'プライバシーポリシー',
        success: 'メールボックスを確認してください。メール内の確認リンクを押すと購読が完了します。',
        already: 'すでに購読中ですか？'
    };
    var PANEL_COPY = {
        ja: '確認メールはシステムの都合で韓国語で届きます。下のようなメールが届いていれば正常です。黒いボタン「이메일을 확인해 주세요」を押すと購読が完了します。',
        en: 'One thing to know: the confirmation email itself arrives in Korean — a limitation of our mail system. If it looks like the message below, it is the right one. Tap the black button to finish.'
    };
    var MAIL_CARD_HTML =
        '<div class="vk-mp-head">VLSI KOREA</div>' +
        '<strong>안녕하세요,</strong>' +
        '<p>탭하시면 VLSI Korea 구독이 완료돼요! 이 링크를 사용하여 이메일 주소를 확인해 주세요.</p>' +
        '<span class="vk-mp-btn">이메일을 확인해 주세요</span>' +
        '<p class="vk-mp-small">보안을 위해 링크는 24시간 후에 만료돼요.</p>';
    function whenReady(fn) {
        function run() { setTimeout(fn, 80); }
        if (document.readyState === 'complete') run();
        else window.addEventListener('load', run);
    }
    whenReady(function () {
        var dialog = document.getElementById('vk-signup-dialog');
        if (!dialog) return;
        var form = dialog.querySelector('form');
        if (!form) return;
        var seg = (location.pathname.split('/')[1] || 'ko').toLowerCase(); if (seg === 'subscribe-ja') seg = 'ja'; else if (seg === 'subscribe-zh-tw') seg = 'zh-tw'; else if (seg === 'subscribe') seg = 'ko';
        if (seg === 'ja') {
            dialog.querySelectorAll('[data-vk-member-copy]').forEach(function (el) {
                var key = el.getAttribute('data-vk-member-copy');
                if (key && JA_MISSING[key] != null) el.textContent = JA_MISSING[key];
            });
        }
        if (form.querySelector('.vk-mail-preview')) return;
        var panel = document.createElement('div');
        panel.className = 'vk-mail-preview';
        var note = document.createElement('p');
        note.className = 'vk-mp-note';
        panel.appendChild(note);
        var cardReplica = document.createElement('div');
        cardReplica.className = 'vk-mp-card';
        cardReplica.innerHTML = MAIL_CARD_HTML;
        panel.appendChild(cardReplica);
        form.appendChild(panel);
        function refreshPanel() {
            var language = dialog.querySelector('#vk-signup-language');
            var delivery = dialog.querySelector('#vk-signup-delivery');
            var chosen = language ? language.value : (delivery ? delivery.value : 'ko');
            if (chosen === 'ko') { panel.style.display = 'none'; return; }
            panel.style.display = '';
            note.textContent = chosen === 'ja' ? PANEL_COPY.ja : PANEL_COPY.en;
        }
        if (window.MutationObserver) {
            var obs = new MutationObserver(function () {
                if ((' ' + form.className + ' ').indexOf(' success ') >= 0) refreshPanel();
            });
            obs.observe(form, {attributes: true, attributeFilter: ['class']});
        }
        form.addEventListener('change', function () {
            if ((' ' + form.className + ' ').indexOf(' success ') >= 0) refreshPanel();
        });
    });
})();
</script>
<!-- vlsi-partnership-locale v1 (2026-10-28): route the header "Partnership" link (More menu -> /fan/) to the reader's language edition of the partnership page. Append to Ghost Admin > Settings > Code injection > Site Footer. Rollback: delete this entire block. -->
<script>
(function () {
  var seg = (location.pathname.split('/')[1] || '').toLowerCase();
  var lang = { 'en': 'en', 'ja': 'ja', 'zh-tw': 'zh-tw' }[seg] || null;
  if (!lang) {
    var mm = location.pathname.match(/-(en|ja|zh-tw)\/?$/);
    if (mm) lang = mm[1];
  }
  if (!lang) return;
  var target = '/partnership-' + lang + '/';
  function fix() {
    document.querySelectorAll('a').forEach(function (a) {
      var href = a.getAttribute('href') || '';
      if (/\/fan\/?$/.test(href) && (a.textContent || '').trim().toLowerCase() === 'partnership') {
        a.setAttribute('href', target);
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix);
  else fix();
})();
</script>


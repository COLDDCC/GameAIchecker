<!--
  Cloudflare has occasionally served Ghost's member-personalized HTML from
  cache even though the origin response is private/no-store. Reconcile the
  visible membership controls against Ghost's uncached member endpoint so an
  anonymous visitor never loses the signup path.
-->
<script>
(function () {
  'use strict';

  var memberEndpoint = '/members/api/member/?_cb=';
  var dismissKey = 'vlsikr-subscribe-prompt-dismissed-v1';

  function portalCluster(isMember) {
    if (isMember) {
      return '<a class="gh-button vk-subscribe" href="#/portal/account" data-portal="account">Account</a>';
    }
    return '<a class="vk-signin" href="#/portal/signin" data-portal="signin">Sign in</a>' +
      '<a class="gh-button vk-subscribe" href="#/portal/signup" data-portal="signup">Subscribe</a>';
  }

  function ensureAnonymousPrompt() {
    if (document.getElementById('gh-floating-bar')) return;

    var bar = document.createElement('div');
    bar.className = 'gh-floating-bar';
    bar.id = 'gh-floating-bar';
    bar.innerHTML =
      '<div class="gh-floating-bar-inner">' +
        '<div class="gh-floating-bar-text">' +
          '<strong>VLSI Korea</strong>' +
          '<span>매일 아침 10:30, 반도체 핵심 분석을 메일로 · 무료</span>' +
        '</div>' +
        '<button class="gh-button gh-floating-bar-btn" data-portal="signup">무료 구독</button>' +
        '<button class="gh-floating-bar-close" type="button" aria-label="Close">' +
          '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>' +
        '</button>' +
      '</div>';
    document.body.appendChild(bar);

    var dismissed = false;
    var shown = false;
    try {
      var dismissedAt = Number(window.localStorage.getItem(dismissKey) || 0);
      dismissed = Boolean(dismissedAt && Date.now() - dismissedAt < 7 * 24 * 60 * 60 * 1000);
    } catch (error) {}
    if (dismissed) bar.classList.add('is-dismissed');

    function revealThreshold() {
      var content = document.querySelector('.gh-content');
      if (content) {
        return window.scrollY + content.getBoundingClientRect().top + content.offsetHeight * 0.25;
      }
      return Math.max(1200, document.documentElement.scrollHeight * 0.3);
    }

    function update() {
      if (dismissed) return;
      if (window.scrollY + window.innerHeight > revealThreshold()) {
        bar.classList.add('is-visible');
        if (!shown) {
          shown = true;
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'subscribe_prompt_view', {placement: 'floating_cache_recovery'});
          }
        }
      } else {
        bar.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', update, {passive: true});
    bar.querySelector('.gh-floating-bar-close').addEventListener('click', function () {
      dismissed = true;
      bar.classList.remove('is-visible');
      bar.classList.add('is-dismissed');
      try { window.localStorage.setItem(dismissKey, String(Date.now())); } catch (error) {}
    });
    update();
  }

  function reconcile(isMember, reason) {
    var changed = false;
    document.querySelectorAll('.gh-navigation-members').forEach(function (cluster) {
      var hasAccount = Boolean(cluster.querySelector('[data-portal="account"]'));
      var hasSignup = Boolean(cluster.querySelector('[data-portal="signup"]'));
      if ((isMember && !hasAccount) || (!isMember && !hasSignup)) {
        cluster.innerHTML = portalCluster(isMember);
        changed = true;
      }
    });

    var bar = document.getElementById('gh-floating-bar');
    if (isMember) {
      if (bar) bar.remove();
    } else {
      ensureAnonymousPrompt();
    }
    document.documentElement.setAttribute('data-vlsikr-member-state', isMember ? 'member' : 'anonymous');

    if (changed && typeof window.gtag === 'function') {
      window.gtag('event', 'member_cache_reconciled', {
        rendered_state: isMember ? 'anonymous' : 'member',
        verified_state: isMember ? 'member' : 'anonymous',
        reason: reason
      });
    }
  }

  function verify() {
    fetch(memberEndpoint + Date.now(), {credentials: 'same-origin', cache: 'no-store'})
      .then(function (response) {
        if (response.status === 204) return null;
        if (response.status !== 200) throw new Error('member endpoint ' + response.status);
        return response.json();
      })
      .then(function (member) { reconcile(Boolean(member && member.email), 'api'); })
      .catch(function () {
        // Conversion-safe fallback: when the API is unavailable, prefer an
        // anonymous signup path over a cached Account-only dead end.
        reconcile(false, 'api_error');
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', verify, {once: true});
  } else {
    verify();
  }
})();
</script>

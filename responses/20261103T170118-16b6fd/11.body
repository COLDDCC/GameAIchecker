    <script id="vk-legacy-popup-block">
        (function () {
            var BLOCKED = { 'vk-popup-exp-root': true, 'vk-own-popup': true, 'gh-floating-bar': true };
            function remove(node) {
                if (node && node.parentNode) node.parentNode.removeChild(node);
            }
            function sweep() {
                Object.keys(BLOCKED).forEach(function (id) { remove(document.getElementById(id)); });
            }
            var observer = new MutationObserver(function (mutations) {
                for (var i = 0; i < mutations.length; i++) {
                    var added = mutations[i].addedNodes;
                    for (var j = 0; j < added.length; j++) {
                        var node = added[j];
                        if (node.nodeType === 1 && BLOCKED[node.id]) remove(node);
                    }
                }
            });
            observer.observe(document.documentElement, { childList: true, subtree: true });
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', sweep, { once: true });
            } else {
                sweep();
            }
        })();
    </script>

    <script id="vk-consent-bootstrap">
        (function () {
            var storageKey = 'vlsikr-cookie-consent-v1';
            var measurementId = 'G-HCPRHPJW1P';
            var callbacks = [];

            function read() {
                try {
                    var value = window.localStorage.getItem(storageKey);
                    return value === 'accepted' || value === 'rejected' ? value : 'unset';
                } catch (error) {
                    return 'unset';
                }
            }

            function clearAnalyticsCookies() {
                document.cookie.split(';').forEach(function (item) {
                    var name = item.split('=')[0].trim();
                    if (!/^_ga(?:_|$)/.test(name)) return;
                    // This product owns only host-scoped legacy analytics cookies.
                    // Shared parent-domain analytics cookies belong to other hosts.
                    document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax; Secure';
                });
            }

            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

            function applyGoogleConsent(choice) {
                var accepted = choice === 'accepted';
                window['ga-disable-' + measurementId] = choice === 'rejected';
                window.gtag('consent', choice === 'unset' ? 'default' : 'update', {
                    analytics_storage: accepted ? 'granted' : 'denied',
                    ad_storage: accepted ? 'granted' : 'denied',
                    ad_user_data: accepted ? 'granted' : 'denied',
                    ad_personalization: accepted ? 'granted' : 'denied',
                    functionality_storage: 'granted',
                    security_storage: 'granted'
                });
                if (!accepted) clearAnalyticsCookies();
            }

            function announce(choice) {
                var event;
                try {
                    event = new CustomEvent('vlsi:consent-change', {detail: {choice: choice}});
                } catch (error) {
                    event = document.createEvent('CustomEvent');
                    event.initCustomEvent('vlsi:consent-change', false, false, {choice: choice});
                }
                window.dispatchEvent(event);
            }

            function flush() {
                if (read() !== 'accepted') return;
                var pending = callbacks.slice();
                callbacks.length = 0;
                pending.forEach(function (callback) {
                    try { callback(); } catch (error) {}
                });
            }

            // Geo-split consent (2026-11-01, GA runtime 8): EEA + UK visitors
            // keep the opt-in banner flow below. Visitors from other regions
            // get analytics_storage granted automatically with no banner —
            // their jurisdictions do not require prior consent for this
            // minimized measurement, and Consent Mode v2's denied default was
            // hiding them from GA4. The region comes from Cloudflare's
            // same-origin /cdn-cgi/trace country signal (loc=XX). Any failure
            // to read the signal falls back to the EEA flow (banner + denied).
            var EEA_COUNTRIES = {
                AT: 1, BE: 1, BG: 1, HR: 1, CY: 1, CZ: 1, DK: 1, EE: 1, FI: 1,
                FR: 1, DE: 1, GR: 1, HU: 1, IE: 1, IT: 1, LV: 1, LT: 1, LU: 1,
                MT: 1, NL: 1, PL: 1, PT: 1, RO: 1, SK: 1, SI: 1, ES: 1, SE: 1,
                IS: 1, LI: 1, NO: 1, GB: 1, GI: 1
            };
            var regionState = read() === 'unset' ? 'pending' : 'stored';
            var settleRegionPromise = function () {};
            var regionPromise = new Promise(function (resolve) { settleRegionPromise = resolve; });
            function settleRegion(state) {
                if (regionState !== 'pending') return;
                regionState = state;
                settleRegionPromise(state);
            }
            function resolveRegion() {
                if (regionState !== 'pending') {
                    settleRegionPromise(regionState);
                    return;
                }
                var finished = false;
                var timer = window.setTimeout(function () { finish('fallback'); }, 2000);
                function finish(state) {
                    if (finished) return;
                    finished = true;
                    window.clearTimeout(timer);
                    settleRegion(state);
                }
                try {
                    fetch('/cdn-cgi/trace', { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (response) { return response && response.ok ? response.text() : ''; })
                        .then(function (text) {
                            var match = /(?:^|\n)loc=([A-Z]{2})/.exec(text || '');
                            var loc = match ? match[1] : '';
                            if (!loc || loc === 'XX' || loc === 'T1') { finish('fallback'); return; }
                            if (EEA_COUNTRIES[loc]) { finish('eea'); return; }
                            // Non-EEA/UK: grant analytics only. The site choice
                            // itself stays unset, so advertising, Trivet and
                            // other accept-gated features remain off, and the
                            // reader can still decline in Cookie settings.
                            window.gtag('consent', 'update', { analytics_storage: 'granted' });
                            finish('auto');
                        })
                        .catch(function () { finish('fallback'); });
                } catch (error) {
                    finish('fallback');
                }
            }

            window.VLSIConsent = {
                key: storageKey,
                get: read,
                region: function () { return regionState; },
                ready: regionPromise,
                set: function (choice) {
                    if (choice !== 'accepted' && choice !== 'rejected') return;
                    try { window.localStorage.setItem(storageKey, choice); } catch (error) {}
                    applyGoogleConsent(choice);
                    if (choice === 'accepted') flush();
                    announce(choice);
                },
                onAccept: function (callback) {
                    if (typeof callback !== 'function') return;
                    if (read() === 'accepted') {
                        window.setTimeout(callback, 0);
                    } else {
                        callbacks.push(callback);
                    }
                }
            };

            applyGoogleConsent(read());
            resolveRegion();
        })();
    </script>


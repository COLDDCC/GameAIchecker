    <!-- VLSIKR: Members API CDN cache-bust fix (Cloudflare caches 503 despite no-store) -->
<script>
(function(){
  var _origFetch = window.fetch;
  window.fetch = function(input, init) {
    var url = (typeof input === 'string') ? input : (input && input.url ? input.url : '');
    if (url.indexOf('/members/api/') !== -1) {
      var sep = url.indexOf('?') === -1 ? '?' : '&';
      var bustedUrl = url + sep + '_cb=' + Date.now();
      if (typeof input === 'string') {
        return _origFetch.call(this, bustedUrl, init).then(function(resp) {
          if (resp.status === 503) {
            return new Promise(function(resolve) {
              setTimeout(function() {
                resolve(_origFetch.call(window, url + (url.indexOf('?') === -1 ? '?' : '&') + '_cb=' + Date.now(), init));
              }, 1500);
            });
          }
          return resp;
        });
      } else {
        var newReq = new Request(bustedUrl, input);
        return _origFetch.call(this, newReq, init);
      }
    }
    return _origFetch.apply(this, arguments);
  };
})();
</script>

<!-- OneSignal Web Push v16. The deploy script stamps the public app id. -->
<script>
window.VLSIKR_ONESIGNAL_APP_ID = 'c429bc56-5b9b-41d8-9049-63ab34e8b59e';
(function () {
    var loaded = false;

    function loadOneSignal() {
        if (loaded || !window.VLSIKR_ONESIGNAL_APP_ID || window.VLSIKR_ONESIGNAL_APP_ID.indexOf('ONESIGNAL_APP_ID') !== -1) return;
        loaded = true;

    var sdk = document.createElement('script');
    sdk.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
    sdk.defer = true;
    document.head.appendChild(sdk);

    window.OneSignalDeferred = window.OneSignalDeferred || [];
    window.OneSignalDeferred.push(async function (OneSignal) {
        try {
            await OneSignal.init({
                appId: window.VLSIKR_ONESIGNAL_APP_ID,
                safari_web_id: window.VLSIKR_SAFARI_WEB_ID || undefined,
                serviceWorkerPath: '/assets/OneSignalSDKWorker.js',
                serviceWorkerParam: {scope: '/assets/'},
                notifyButton: {enable: false}
            });

            function state() {
                return {
                    supported: OneSignal.Notifications.isPushSupported(),
                    permission: Boolean(OneSignal.Notifications.permission),
                    nativePermission: window.Notification ? window.Notification.permission : 'unsupported'
                };
            }

            function announce() {
                window.VLSIKR_PUSH_STATE = state();
                document.dispatchEvent(new CustomEvent('vlsi:push-ready', {detail: window.VLSIKR_PUSH_STATE}));
            }

            window.vlsiRequestPush = async function () {
                if (!OneSignal.Notifications.isPushSupported()) return state();
                if (typeof window.vlsiTrack === 'function') window.vlsiTrack('push_permission_prompt', {placement: 'reader_hub'});
                await OneSignal.Notifications.requestPermission();
                announce();
                return state();
            };

            OneSignal.Notifications.addEventListener('permissionChange', function (permission) {
                announce();
                if (typeof window.vlsiTrack === 'function') {
                    window.vlsiTrack(permission ? 'push_permission_granted' : 'push_permission_declined', {placement: 'reader_hub'});
                }
            });
            OneSignal.User.PushSubscription.addEventListener('change', function (event) {
                if (event.current && event.current.token && (!event.previous || !event.previous.token) && typeof window.vlsiTrack === 'function') {
                    window.vlsiTrack('push_subscription_complete', {placement: 'reader_hub'});
                }
            });
            announce();
        } catch (error) {}
    });
    }

    if (window.VLSIConsent) window.VLSIConsent.onAccept(loadOneSignal);
})();
</script>
<!-- VLSIKR-CONSENT-GATED:push:v1 -->

<!-- Keep Ghost newsletter choices aligned with the reader edition. v2 (2026-10-21) -->
<!-- Replaces the v1 ko/en-only block in Code Injection > Site Footer.
     v2: handles every published language edition. It only touches a
     newsletter checkbox when that newsletter actually exists in the
     portal (so it is safe before/after plan upgrade), checks the
     edition matching the current path/browser language, and unchecks
     the OTHER language newsletters so a new signup does not silently
     receive every language. -->
<script>
(function () {
    var MAP = {
        'ko':    {slug: 'default-newsletter',   words: ['한국어', 'korean']},
        'en':    {slug: 'english',              words: ['english']},
        'ja':    {slug: 'japanese',             words: ['日本語', 'japanese']},
        'zh':    {slug: 'chinese',              words: ['中文简体', '简体中文', 'simplified chinese']},
        'zh-tw': {slug: 'chinese-traditional',  words: ['中文繁體', '繁體中文', '繁体中文', 'traditional chinese']},
        'es':    {slug: 'spanish',              words: ['español', 'spanish']},
        'pt':    {slug: 'portuguese',           words: ['português', 'portuguese']},
        'id':    {slug: 'indonesian',           words: ['bahasa indonesia', 'indonesian']},
        'vi':    {slug: 'vietnamese',           words: ['tiếng việt', 'vietnamese']}
    };

    function detectLang() {
        var m = location.pathname.match(/^\/(ko|en|ja|zh-tw|zh|es|pt|id|vi)(?:\/|$)/);
        if (m) return m[1];
        var nav = (navigator.language || 'en').toLowerCase();
        if (nav.indexOf('ko') === 0) return 'ko';
        if (nav.indexOf('ja') === 0) return 'ja';
        if (nav.indexOf('zh-tw') === 0 || nav.indexOf('zh-hk') === 0 || nav.indexOf('zh-hant') === 0) return 'zh-tw';
        if (nav.indexOf('zh') === 0) return 'zh';
        if (nav.indexOf('es') === 0) return 'es';
        if (nav.indexOf('pt') === 0) return 'pt';
        if (nav.indexOf('id') === 0) return 'id';
        if (nav.indexOf('vi') === 0) return 'vi';
        return 'en';
    }

    function setCheckbox(input, checked) {
        if (!input || input.type !== 'checkbox' || input.checked === checked) return;
        input.click();
    }

    function findBySlug(doc, slug) {
        var found = [];
        var selectors = [
            'input[data-test-newsletter*="' + slug + '"]',
            'input[type="checkbox"][value*="' + slug + '"]',
            'input[type="checkbox"][name*="' + slug + '"]',
            '[data-newsletter-slug="' + slug + '"] input[type="checkbox"]'
        ];
        selectors.forEach(function (selector) {
            try {
                doc.querySelectorAll(selector).forEach(function (input) { found.push(input); });
            } catch (error) {}
        });
        return found;
    }

    function findByText(doc, words) {
        var found = [];
        doc.querySelectorAll('label').forEach(function (label) {
            var text = (label.textContent || '').toLowerCase();
            if (!words.some(function (word) { return text.indexOf(word.toLowerCase()) !== -1; })) return;
            var input = label.querySelector('input[type="checkbox"]');
            if (!input && label.htmlFor) input = doc.getElementById(label.htmlFor);
            if (input) found.push(input);
        });
        return found;
    }

    function apply(doc) {
        if (!doc) return;
        var wanted = MAP[detectLang()];
        if (!wanted) return;
        // Wanted edition: check it if its newsletter exists in this doc.
        var wantedInputs = findBySlug(doc, wanted.slug);
        if (!wantedInputs.length) wantedInputs = findByText(doc, wanted.words);
        if (!wantedInputs.length) return; // newsletter not offered here -> leave portal untouched
        wantedInputs.forEach(function (input) { setCheckbox(input, true); });
        // Other language editions that exist here: uncheck.
        Object.keys(MAP).forEach(function (lang) {
            var entry = MAP[lang];
            if (entry.slug === wanted.slug) return;
            var inputs = findBySlug(doc, entry.slug);
            if (!inputs.length) inputs = findByText(doc, entry.words);
            inputs.forEach(function (input) { setCheckbox(input, false); });
        });
    }

    function applyEverywhere() {
        apply(document);
        document.querySelectorAll('iframe').forEach(function (frame) {
            try { apply(frame.contentDocument); } catch (error) {}
        });
    }

    document.addEventListener('click', function (event) {
        if (!event.target.closest || !event.target.closest('[data-portal="signup"], [href*="#/portal/signup"]')) return;
        [80, 220, 500, 1000, 1800, 3000].forEach(function (delay) {
            setTimeout(applyEverywhere, delay);
        });
    }, true);

    setTimeout(applyEverywhere, 300);
})();
</script>

<!-- VLSIKR-SIGNUP-SIMPLIFY:v3 + VLSIKR-POPUP:v3 (2026-10-23)
     1) Dialog: delivery select is auto-synced from the reading-language
        select; Japanese readers are assigned the Japanese newsletter
        (theme JS maps every non-Korean choice to English, so the hidden
        newsletter field is corrected after the theme handler runs).
     2) The theme article popup (55% scroll / 45s dwell, English-only copy)
        is suppressed per session and replaced by a localized popup at
        35% scroll or 25s dwell. -->
<script>
(function () {
    'use strict';
    // Suppress the theme popup for this session (its own seen-flag).
    try { sessionStorage.setItem('vlsikr-newsletter-popup-seen-v1', '1'); } catch (e) {}

    var JA_NAME = 'VLSI Korea — 日本語';
    function whenReady(fn) {
        function run() { setTimeout(fn, 80); }
        if (document.readyState === 'complete') run();
        else window.addEventListener('load', run);
    }

    /* ---------- 1) Dialog simplification ---------- */
    whenReady(function () {
        var dialog = document.getElementById('vk-signup-dialog');
        if (!dialog) return;
        var form = dialog.querySelector('form');
        var language = dialog.querySelector('#vk-signup-language');
        var delivery = dialog.querySelector('#vk-signup-delivery');
        if (!form || !language || !delivery) return;
        var news = form.querySelector('[data-members-newsletter]');
        var labelEl = form.querySelector('[data-vk-newsletter-label]');
        function syncDelivery() {
            var want = language.value === 'ko' ? 'ko' : 'en';
            if (delivery.value !== want) delivery.value = want;
        }
        function fixAll() {
            syncDelivery();
            if (language.value === 'ja' && news) {
                news.value = JA_NAME;
                if (labelEl) labelEl.value = 'newsletter:ja';
            }
        }
        // Capture: sync delivery BEFORE the theme labels() handler (bubble) reads it.
        form.addEventListener('change', syncDelivery, true);
        // Bubble: registered after the theme handler, so the ja correction lands last.
        form.addEventListener('change', fixAll, false);
        // Capture submit: registered after the theme submit handler, runs after it.
        form.addEventListener('submit', fixAll, true);
        fixAll();
    });

    /* ---------- 2) Own localized popup ---------- */
    whenReady(function () {
        var article = document.querySelector('article .gh-content');
        if (!article) return;
        if (!document.body || document.body.dataset.memberStatus !== 'anonymous') return;
        var DKEY = 'vk-own-popup-dismissed-v1', SKEY = 'vk-own-popup-shown-v1', WEEK = 7 * 24 * 3600 * 1000;
        try {
            if (Date.now() - Number(localStorage.getItem(DKEY) || 0) < WEEK) return;
            if (sessionStorage.getItem(SKEY)) return;
        } catch (e) {}
        var seg = (location.pathname.split('/')[1] || 'ko').toLowerCase(); if (seg === 'subscribe-ja') seg = 'ja'; else if (seg === 'subscribe-zh-tw') seg = 'zh-tw'; else if (seg === 'subscribe') seg = 'ko';
        var COPY = {
            ko: {t: '반도체 인사이트, 매일 아침 메일로', b: 'Daily Silicon과 실적·리포트 해설을 무료로 받아보세요.', btn: '무료 구독', x: '닫기'},
            en: {t: 'Semiconductor insight, in your inbox', b: 'Daily analysis plus earnings and report breakdowns. Free.', btn: 'Subscribe free', x: 'Close'},
            ja: {t: '半導体インサイトを、毎朝メールで', b: '市場分析と決算・レポート解説を無料でお届けします。', btn: '無料で購読', x: '閉じる'}
        };
        var c = COPY[seg] || COPY.en;
        var card = document.createElement('div');
        card.id = 'vk-own-popup';
        card.setAttribute('role', 'dialog');
        card.setAttribute('aria-label', c.t);
        card.style.cssText = 'position:fixed;left:50%;transform:translate(-50%,16px);bottom:88px;z-index:2147483000;width:calc(100% - 32px);max-width:520px;background:#ffffff;color:#111827;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 18px 50px rgba(15,23,42,.28);padding:18px 20px;opacity:0;pointer-events:none;transition:opacity .25s ease,transform .25s ease;font-family:inherit;box-sizing:border-box';
        card.innerHTML = '<button type="button" aria-label="' + c.x + '" style="position:absolute;top:8px;right:10px;background:none;border:0;font-size:20px;line-height:1;color:#6b7280;cursor:pointer;padding:4px">×</button>' +
            '<strong style="display:block;font-size:17px;line-height:1.35;margin:0 28px 6px 0">' + c.t + '</strong>' +
            '<span style="display:block;font-size:14px;line-height:1.5;color:#4b5563;margin:0 0 12px">' + c.b + '</span>' +
            '<a href="#/portal/signup/free" style="display:inline-block;background:#1d4ed8;color:#ffffff;font-weight:700;font-size:14px;padding:10px 18px;border-radius:999px;text-decoration:none">' + c.btn + '</a>';
        document.body.appendChild(card);
        var shown = false, dwell = 0, lastTick = Date.now(), pending = false;
        function blocked() {
            return document.hidden || location.hash.indexOf('#/portal') === 0 || document.querySelector('dialog[open]') || document.documentElement.classList.contains('has-cookie-consent');
        }
        function show() {
            if (shown) return;
            if (blocked()) { pending = true; return; }
            shown = true;
            try { sessionStorage.setItem(SKEY, '1'); } catch (e) {}
            card.style.opacity = '1';
            card.style.transform = 'translate(-50%,0)';
            card.style.pointerEvents = 'auto';
            if (typeof window.gtag === 'function') window.gtag('event', 'subscribe_prompt_view', {placement: 'own_popup'});
        }
        card.querySelector('button').addEventListener('click', function () {
            card.style.display = 'none';
            try { localStorage.setItem(DKEY, String(Date.now())); } catch (e) {}
            if (typeof window.gtag === 'function') window.gtag('event', 'subscribe_prompt_dismiss', {placement: 'own_popup'});
        });
        card.querySelector('a').addEventListener('click', function () {
            try { localStorage.setItem(DKEY, String(Date.now())); } catch (e) {}
        });
        setInterval(function () {
            var now = Date.now();
            if (!document.hidden) dwell += now - lastTick;
            lastTick = now;
            if (!shown && dwell >= 25000) show();
            if (pending && !blocked()) { pending = false; show(); }
        }, 500);
        window.addEventListener('scroll', function () {
            if (shown) return;
            var rect = article.getBoundingClientRect();
            if (rect.height > 0 && window.innerHeight - rect.top >= rect.height * 0.35) show();
        }, {passive: true});
    });
})();
</script>

<!-- VLSIKR: post-list/byline visibility badges -->
<script>
/* VLSI Korea — list-view visibility badge injector.
 *
 * Ghost themes render post cards, so the free/members/paid emoji next to
 * each card's date (and the byline date on post pages) is added here,
 * client-side, from a static slug->visibility map.
 *
 *   public  -> 🆓  (무료 글)
 *   paid    -> 🔒  (멤버십 글)
 *   members -> 👥  (회원 글)
 *
 * Paste into Ghost Admin > Settings > Code injection > Site Footer,
 
 * regenerated + the bridge redeployed whenever post visibility changes.
 */
(function () {
  "use strict";

  var MAP_URL = "https://vlsi-mor-bridge.vercel.app/badge-map.json";
  var CACHE_KEY = "vlsi-badge-map-v1";
  var EMOJI = { public: "🆓", paid: "🔒", members: "👥" };
  var LABEL = { public: "무료 글", paid: "멤버십 글", members: "회원 글" };
  var BADGE_CLASS = "vlsi-vis-badge";

  function getMap() {
    try {
      var cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) return Promise.resolve(JSON.parse(cached));
    } catch (e) { /* storage unavailable */ }
    return fetch(MAP_URL, { mode: "cors" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (doc) {
        var map = doc && doc.map ? doc.map : null;
        if (map) {
          try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(map)); }
          catch (e) { /* quota — ignore */ }
        }
        return map;
      })
      .catch(function () { return null; });
  }

  function slugFromUrl(url) {
    try {
      var path = new URL(url, window.location.href).pathname;
      var parts = path.split("/").filter(function (s) { return s.length; });
      return parts.length ? parts[parts.length - 1] : null;
    } catch (e) {
      return null;
    }
  }

  function makeBadge(visibility) {
    var span = document.createElement("span");
    span.className = BADGE_CLASS;
    span.textContent = EMOJI[visibility];
    span.setAttribute("title", LABEL[visibility]);
    span.setAttribute("aria-label", LABEL[visibility]);
    span.style.marginLeft = "6px";
    span.style.fontStyle = "normal";
    return span;
  }

  var DATE_TEXT = /20\d{2}\s?[.\-/년]\s?\d{1,2}/;

  function findDateEl(scope) {
    var t = scope.querySelector("time");
    if (t) return t;
    var leaves = scope.querySelectorAll(
      "span, div, p, li, a, [class*='date'], [class*='meta']");
    for (var i = 0; i < leaves.length; i++) {
      var el = leaves[i];
      if (el.children.length === 0 && DATE_TEXT.test(el.textContent || "")) {
        return el;
      }
    }
    return null;
  }

  function insertBadge(anchorEl, visibility) {
    if (!anchorEl || !EMOJI[visibility]) return;
    var host = anchorEl.parentElement || anchorEl;
    if (host.querySelector("." + BADGE_CLASS)) return; // already badged
    anchorEl.insertAdjacentElement("afterend", makeBadge(visibility));
  }

  function badgeCard(article, map) {
    if (article.dataset.vlsiBadged) return;
    var links = article.querySelectorAll("a[href]");
    var slug = null;
    for (var i = 0; i < links.length; i++) {
      var s = slugFromUrl(links[i].getAttribute("href"));
      if (s && Object.prototype.hasOwnProperty.call(map, s)) {
        slug = s;
        break;
      }
    }
    if (!slug) return;
    var dateEl = findDateEl(article);
    if (dateEl) {
      insertBadge(dateEl, map[slug]);
      article.dataset.vlsiBadged = "1";
    }
  }

  function badgePostPage(map) {
    var slug = slugFromUrl(window.location.href);
    if (!slug || !Object.prototype.hasOwnProperty.call(map, slug)) return;
    var article = document.querySelector(
      "article.gh-article, main article, article");
    if (!article) return;
    var dateEl = findDateEl(article);
    if (dateEl) insertBadge(dateEl, map[slug]);
  }

  function run(map) {
    if (!map) return;
    var cards = document.querySelectorAll("article");
    for (var i = 0; i < cards.length; i++) badgeCard(cards[i], map);
    badgePostPage(map);
  }

  function init() {
    getMap().then(function (map) {
      if (!map) return;
      run(map);
      // Cards can appear later (load-more / infinite scroll).
      var pending = null;
      var observer = new MutationObserver(function () {
        if (pending) return;
        pending = setTimeout(function () {
          pending = null;
          run(map);
        }, 400);
      });
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(function () { observer.disconnect(); }, 60000);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

<!-- VLSI author-social v2 (2026-10-24, user decision: representative few + expandable full view)
       Paste APPENDED to Ghost Admin > Settings > Code injection > Site Footer. Do NOT replace existing content.

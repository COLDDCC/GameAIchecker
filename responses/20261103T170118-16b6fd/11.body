    var bar = document.getElementById('gh-floating-bar');
    if (isMember) {
      if (bar) bar.remove();
    } else {
      ensureAnonymousPrompt();
    }
    document.documentElement.setAttribute('data-vlsikr-member-state', isMember ? 'member' : 'anonymous');

    if (changed && typeof window.gtag === 'function') {
      window.gtag('event', 'member_cache_reconciled', {
        rendered_state: isMember ? 'anonymous' : 'member',
        verified_state: isMember ? 'member' : 'anonymous',
        reason: reason
      });
    }
  }

  function verify() {
    fetch(memberEndpoint + Date.now(), {credentials: 'same-origin', cache: 'no-store'})
      .then(function (response) {
        if (response.status === 204) return null;
        if (response.status !== 200) throw new Error('member endpoint ' + response.status);
        return response.json();
      })
      .then(function (member) { reconcile(Boolean(member && member.email), 'api'); })
      .catch(function () {
        // Conversion-safe fallback: when the API is unavailable, prefer an
        // anonymous signup path over a cached Account-only dead end.
        reconcile(false, 'api_error');
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', verify, {once: true});
  } else {
    verify();
  }
})();
</script>

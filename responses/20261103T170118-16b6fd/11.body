<!-- vlsi-signup-head-guard-v1 -->
<!-- VLSI Korea signup head guard v1 (2026-10-26, header Portal leak fix).
     Append at the END of codeinjection_head.
     Problem (verified live 2026-10-26 18:21-26 KST, Japanese article):
       the first header Subscribe click in a page view opened Ghost's
       native Portal in Korean (no language choice, no language-matched
       newsletter), while later clicks opened the custom dialog with the
       article language preselected. The custom-dialog interceptors
       (theme member-experience.js and the foot cta-intercept-v1 block)
       only register at end-of-body / on deferred init, so a click that
       lands before they are live escapes to Portal's native hash
       handling. A first-time visitor's first action is exactly that
       click -- JP-geo signups landing in en/ko newsletters (41 members,
       0 in ja) are the member-record fingerprint of this leak.
     Fix: register the capture-phase click guard from <head>, before the
     page is interactive. On a signup-link click it swallows the native
     navigation, waits (poll, up to 3s) for #vk-signup-dialog if the
     dialog is not in the DOM yet, then opens it with the page segment's
     language preselected -- the same open logic as cta-intercept-v1.
     It NEVER falls back to Portal on anonymous pages (that fallback
     was the leak). Signed-in members are left untouched (the theme
     does not render the dialog for them and their header action is
     account, not signup). Modified clicks are left untouched. -->
<script>
(function () {
    'use strict';
    if (window.__vlsiSignupHeadGuard) return;
    window.__vlsiSignupHeadGuard = true;
    var SEG_TO_DIALOG_LANG = {
        ko: 'ko', en: 'en', ja: 'ja', zh: 'zh', 'zh-tw': 'zh',
        es: 'es', vi: 'vi', ar: 'ar', he: 'he', ms: 'ms'
    };
    function isSignupLink(a) {
        if (!a || a.tagName !== 'A') return false;
        var href = a.getAttribute('href') || '';
        if (href.indexOf('/portal/signup') >= 0) return true;
        if (a.getAttribute('data-portal') === 'signup') return true;
        return false;
    }
    function isAnonymous() {
        var b = document.body;
        if (!b || !b.dataset) return true; // body not parsed yet -> assume visitor
        var s = b.dataset.memberStatus;
        return !s || s === 'anonymous';
    }
    function openDialog(dialog) {
        var seg = (location.pathname.split('/')[1] || 'ko').toLowerCase();
        var want = SEG_TO_DIALOG_LANG[seg];
        var language = dialog.querySelector('#vk-signup-language');
        if (want && language && language.options) {
            var has = false;
            for (var i = 0; i < language.options.length; i++) {
                if (language.options[i].value === want) { has = true; break; }
            }
            if (has && language.value !== want) {
                language.value = want;
                var ev;
                try { ev = new Event('change', { bubbles: true }); }
                catch (e) { ev = document.createEvent('Event'); ev.initEvent('change', true, false); }
                language.dispatchEvent(ev);
            }
        }
        if (!dialog.open && typeof dialog.showModal === 'function') dialog.showModal();
        var email = dialog.querySelector('[data-members-email]');
        if (email && typeof email.focus === 'function') email.focus();
        if (typeof window.gtag === 'function') {
            window.gtag('event', 'subscribe_dialog_open', { placement: 'head_guard' });
        }
        return true;
    }
    function handle(a) {
        var dialog = document.getElementById('vk-signup-dialog');
        if (dialog) {
            if (dialog.open) return;
            openDialog(dialog);
            return;
        }
        // Dialog not in DOM yet (interceptors/theme still initialising):
        // hold the click and poll briefly instead of leaking to Portal.
        var waited = 0;
        var timer = setInterval(function () {
            waited += 100;
            var d = document.getElementById('vk-signup-dialog');
            if (d) {
                clearInterval(timer);
                if (!d.open) openDialog(d);
            } else if (waited >= 3000) {
                clearInterval(timer);
                // Give up silently: no Portal fallback (that was the leak).
                // The visitor can click again once the page has settled.
                if (window.console && console.info) {
                    console.info('[vlsi] signup dialog not ready; click held by head guard');
                }
            }
        }, 100);
    }
    document.addEventListener('click', function (e) {
        if (e.button && e.button !== 0) return;
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!isSignupLink(a)) return;
        if (a.closest && a.closest('#vk-signup-dialog')) return;
        if (!isAnonymous()) return;
        var dialog = document.getElementById('vk-signup-dialog');
        if (dialog && dialog.open) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        handle(a);
    }, true);
})();
</script>

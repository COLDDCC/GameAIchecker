		    <!-- OS Account Perks Token - Must load BEFORE ad scripts -->
        <script>
    (function() {
      'use strict';
      window.GAMURS_wordpress_blocks = window.GAMURS_wordpress_blocks || {};

      function getCookie(name) {
        var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? decodeURIComponent(match[2]) : null;
      }

      function decodeJWT(token) {
        try {
          var parts = token.split('.');
          if (parts.length !== 3) return null;
          var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          return JSON.parse(atob(payload));
        } catch (e) { return null; }
      }

      var token = getCookie('os_perks_token');
      var payload = token ? decodeJWT(token) : null;
      var isValid = payload && payload.exp && (payload.exp * 1000 > Date.now());
      var verified = false;

      window.GAMURS_wordpress_blocks.perks = {
        isLoggedIn: function() { return isValid; },
        isAdFree: function() { return isValid && payload.adFree === true; },
        isVerified: function() { return verified; },
        getUsername: function() { return isValid ? payload.username : null; },
        getAvatarUrl: function() { return isValid ? payload.avatar_url : null; },
        getTier: function() { return isValid ? payload.tier : 'free'; },
        getUserId: function() { return isValid ? payload.sub : null; },
        logout: function() {
          document.cookie = 'os_perks_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.operationsports.com';
          window.location.reload();
        }
      };

      if (isValid) {
        document.documentElement.classList.add('os-perks-logged-in');
        if (payload.adFree) document.documentElement.classList.add('os-perks-ad-free');

        (function setSnowplowUserId() {
          if (typeof window.snowplow === 'function') {
            window.snowplow('setUserId', payload.sub);
          } else {
            setTimeout(setSnowplowUserId, 50);
          }
        })();
      }

      if (token) {
        fetch('https://account.operationsports.com/api/perks/verify', {
          credentials: 'include'
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.valid) {
            verified = true;
            payload = data.payload;
            isValid = true;
          } else {
            isValid = false;
            payload = null;
            verified = false;
            document.documentElement.classList.remove('os-perks-logged-in');
            document.documentElement.classList.remove('os-perks-ad-free');
          }
        })
        .catch(function() {});
      }
    })();
    </script>

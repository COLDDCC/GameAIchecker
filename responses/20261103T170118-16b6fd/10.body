		margin-top: 20px;
    color: #ffffff !important;
    display: inline-block;
    background: #281b41;
    padding: 10px 30px;
}

#twitch-covid a:hover {
	background: #ffffff;
	color: #281b41 !important;
	transition: all 0.5s ease;
}

.egTextAlignCenter {
	text-align: center;
}

body #div-gpt-ad-1503962238334-4 {
    text-align: center;
    min-height: 250px;
    display: flex !important;
}

body #mvp-foot-wrap {
	z-index: 5 !important;
}

body .mvp-to-top {
	z-index: 6 !important;
}

#mvp-site {
	padding-bottom: 7rem;
}

.primis-player-container {
	margin: 1rem 0;
}

div[id^=primis_playerSekindoSPlayer][style*='overflow: visible'] {
	bottom: 100px !important;

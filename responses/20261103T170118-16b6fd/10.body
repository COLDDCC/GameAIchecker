	<style>
.wp-block-gamurs-header-nav .os-perks-toggle-hide { display: none; }
.wp-block-gamurs-header-nav .os-perks-avatar-container {
	position: relative;
	display: inline-flex;
	align-items: center;
}
.wp-block-gamurs-header-nav .os-perks-avatar-button {
	cursor: pointer;
	border-radius: 50%;
	border: 2px solid var(--wp--custom--top-nav--color-fg);
}
.wp-block-gamurs-header-nav .os-perks-tier-free .os-perks-avatar-button {
	border-color: var(--wp--custom--top-nav--color-fg);
}
.wp-block-gamurs-header-nav .os-perks-tier-bronze .os-perks-avatar-button {
	border-color: #cd7f32;
}
.wp-block-gamurs-header-nav .os-perks-tier-silver .os-perks-avatar-button {
	border-color: #c0c0c0;
}
.wp-block-gamurs-header-nav .os-perks-tier-gold .os-perks-avatar-button {
	border-color: #ffd700;
}
.wp-block-gamurs-header-nav .os-perks-avatar-img {
	width: 32px;
	height: 32px;
	border-radius: 50%;
	object-fit: cover;
	cursor: pointer;
}
.wp-block-gamurs-header-nav .os-perks-dropdown {
	position: absolute;
	top: 100%;
	right: 0;
	margin-top: 8px;
	background: var(--wp--custom--top-nav--color-bg);
	border: 1px solid var(--wp--custom--top-nav--color-fg);
	border-radius: 4px;
	min-width: 120px;
	display: none;
	z-index: 100;
}
.wp-block-gamurs-header-nav .os-perks-dropdown.dropdown-show { display: block; }
</style>
<script>
(function() {
	var perks = window.GAMURS_wordpress_blocks?.perks;
	if (!perks) return;

	var isLoggedIn = perks.isLoggedIn();

	// Toggle visibility
	document.querySelectorAll('.os-perks-login').forEach(function(el) {
		el.classList.toggle('os-perks-toggle-hide', isLoggedIn);
	});
	document.querySelectorAll('.os-perks-account').forEach(function(el) {
		el.classList.toggle('os-perks-toggle-hide', !isLoggedIn);
	});

	if (isLoggedIn) {
		// Set tier class for border color
		var tier = perks.getTier() || 'free';
		var avatarUrl = perks.getAvatarUrl();
		document.querySelectorAll('.os-perks-avatar-container').forEach(function(container) {
			container.classList.add('os-perks-tier-' + tier);

			// Display avatar image if available
			if (avatarUrl) {
				var img = container.querySelector('.os-perks-avatar-img');
				var iconBtn = container.querySelector('.wp-block-gamurs-button');
				if (img && iconBtn) {
					img.src = avatarUrl;
					img.style.display = 'block';
					iconBtn.style.display = 'none';
				}
			}
		});
	}

	// Dropdown toggle
	document.querySelectorAll('.os-perks-avatar-button').forEach(function(btn) {
		btn.addEventListener('click', function(e) {
			e.preventDefault();
			var dropdown = btn.parentElement.querySelector('.os-perks-dropdown');
			if (dropdown) dropdown.classList.toggle('dropdown-show');
		});
	});

	// Close dropdown when clicking outside
	document.addEventListener('click', function(e) {
		if (!e.target.closest('.os-perks-avatar-container')) {
			document.querySelectorAll('.os-perks-dropdown').forEach(function(d) {
				d.classList.remove('dropdown-show');
			});
		}
	});
})();
</script>

		<script>
	try {
		(function() {
			var commentCountsToFill = document.querySelectorAll('.scVBConnectorCommentCount');
			if (commentCountsToFill.length === 0) {
				return;
			}
			var postIds =
				Array.from(
				new Set(
					Array.from(commentCountsToFill).map(element => element.dataset.postId)
				)
				);
			if (postIds.length === 0) {
				return;
			}
			fetch('/wp-json/scVbConnector/v1/comment_counts?post_ids=' + postIds.join(','))
			.then((response) => response.json())
			.then((data) => {
				commentCountsToFill.forEach(element => {
					var postId = element.dataset.postId;
					var commentCount = data[postId] < 0 ? 0 : data[postId];
					if (commentCount === 0) {
					element.textContent = 'Comment';
					} else if (commentCount === 1) {
					element.textContent = '1 Comment';
					} else {
					element.textContent = commentCount + ' Comments';
					}
				})
			});
		})();
	} catch (e) {
		console.log(e)
	}

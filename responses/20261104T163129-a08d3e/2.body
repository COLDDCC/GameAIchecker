						<a class="hoverunderline commentthread_author_link " href="https://steamcommunity.com/id/swiggadoradante" onclick="return Forum_AuthorMenu( this, 36212821, '562546398187460384' );" data-miniprofile="36212821">
							<bdi>Whispierre<span class="forum_author_action_pulldown"></span></bdi></a>

															<div id="author_menu_36212821_562546398187460384" class="popup_block_new forum_author_menu" style="display: none;">
			<div class="popup_body popup_menu">
				<a class="popup_menu_item tight" href="https://steamcommunity.com/id/swiggadoradante">View Profile</a>
				<a class="popup_menu_item tight" href="https://steamcommunity.com/id/swiggadoradante/posthistory/">View Posts</a>

															<div id="author_menu_30658044_562546073917381008" class="popup_block_new forum_author_menu" style="display: none;">
			<div class="popup_body popup_menu">
				<a class="popup_menu_item tight" href="https://steamcommunity.com/id/braxus7">View Profile</a>

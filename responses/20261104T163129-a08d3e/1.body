				<div class="commentthread_comment_actions" >
														<a class="forum_comment_action forum_comment_action_trigger" data-tooltip-type="selector" data-tooltip-content="#forum_comment_actions_menu_567049339876416999">
					<span><i class="ico16 arrow_down"></i></span>

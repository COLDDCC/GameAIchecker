<script>
/* Site search. Every [data-rg-search] form goes to /search/<slug>; a [data-rg-suggest] box inside one
   offers games, genres, companies, walkthroughs and news from /search/suggest/<slug> as you type
   (arrow keys to move, Enter to open, Esc to close). */
(function () {
  var IMG = 'https://cdn.nivoli.com/cdn-cgi/image/w=72,h=96,fit=cover,f=auto/rpggamers/images/games/';
  function slug(q) { return q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  document.querySelectorAll('form[data-rg-search]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var on = f.querySelector('.rg-sug a.on');
      if (on) { location.href = on.href; return; }
      var s = slug(f.querySelector('input[name=q]').value);
      location.href = s ? '/search/' + s : '/search/';
    });
    var input = f.querySelector('[data-rg-suggest]');
    if (!input) {return;}
    var box = document.createElement('div'), timer = 0, last = '', cache = {};
    box.className = 'rg-sug'; box.hidden = true; box.setAttribute('role', 'listbox');
    f.appendChild(box);
    function render(s, d) {
      var h = '', link = function (url, inner) { return '<a href="' + esc(url) + '" role="option">' + inner + '</a>'; };
      if (d[0].length) { h += '<h6>Games</h6>' + d[0].map(function (g) { return link('/game/' + g[1], '<span class="cov"' + (g[3] ? ' style="background-image:url(' + esc(IMG + g[3]) + ')"' : '') + '></span>' + esc(g[0]) + (g[2] ? '<small>' + esc(g[2]) + '</small>' : '')); }).join(''); }
      if (d[1].length) { h += '<h6>Genres, worlds &amp; platforms</h6>' + d[1].map(function (x) { return link(x[1], esc(x[0]) + '<small>' + esc(x[2]) + '</small>'); }).join(''); }
      if (d[2].length) { h += '<h6>Companies</h6>' + d[2].map(function (c) { return link('/company/' + c[1], esc(c[0]) + '<small>' + c[2] + ' game' + (c[2] == 1 ? '' : 's') + '</small>'); }).join(''); }
      if (d[3].length) { h += '<h6>Walkthroughs</h6>' + d[3].map(function (w) { return link('/walkthrough/' + w[1], esc(w[0])); }).join(''); }
      if (d[4].length) { h += '<h6>News</h6>' + d[4].map(function (n) { return link(n[1], esc(n[0])); }).join(''); }
      if (!h) { h = '<p class="none">Nothing matches yet.</p>'; }
      box.innerHTML = h + '<a class="all" href="/search/' + s + '">All results for &ldquo;' + esc(input.value.trim()) + '&rdquo; &rarr;</a>';
      box.hidden = false;
    }
    function update() {
      var s = slug(input.value);
      if (s.length < 2) { box.hidden = true; last = s; return; }
      if (s === last && !box.hidden) {return;}
      last = s;
      if (cache[s]) { render(s, cache[s]); return; }
      fetch('/search/suggest/' + s).then(function (r) { return r.json(); }).then(function (d) {
        cache[s] = d;
        if (slug(input.value) === s) { render(s, d); }
      }).catch(function () {});}
    input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(update, 160); });
    input.addEventListener('focus', function () { if (box.innerHTML && slug(input.value).length >= 2) { box.hidden = false; } });
    input.addEventListener('keydown', function (e) {
      var items = [].slice.call(box.querySelectorAll('a')), i = items.indexOf(box.querySelector('a.on'));
      if (e.key === 'Escape') { box.hidden = true; return; }
      if (box.hidden || !items.length || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) {return;}
      e.preventDefault();
      if (i >= 0) {items[i].classList.remove('on');}
      i = e.key === 'ArrowDown' ? (i + 1) % items.length : (i <= 0 ? items.length : i) - 1;
      items[i].classList.add('on'); items[i].scrollIntoView({ block: 'nearest' });
    });
    document.addEventListener('click', function (e) { if (!f.contains(e.target)) { box.hidden = true; } });
  });
})();
</script>

<div id="v3-lightbox" class="v3-lightbox" role="dialog" aria-modal="true" aria-label="Media viewer">
  <button class="v3-lightbox-close" type="button" aria-label="Close">✕</button>

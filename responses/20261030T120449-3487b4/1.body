$J( function() { InitializeCommentThread( "ForumTopic", "ForumTopic_103582791475292422_762932533852784879_574929704291811770", {"feature":"762932533852784879","feature2":"574929704291811770","owner":"103582791475292422","commentthreadid":"659128573","total_count":10,"start":0,"pagesize":15,"has_upvoted":0,"upvotes":0,"votecountid":null,"voteupid":null,"commentcountid":null,"subscribed":false,"extended_data":"{\"topic_permissions\":{\"can_view\":1,\"can_post\":1,\"can_reply\":1,\"is_banned\":0,\"can_delete\":0,\"can_edit\":0},\"original_poster\":34901804,\"topic_gidanswer\":\"0\",\"forum_appid\":3948460,\"forum_public\":1,\"forum_type\":\"General\",\"forum_gidfeature\":\"0\"}","oldestfirst":true,"comments_raw":{"574929704291841945":{"text":"You have no power here.","author":"JiggleBill"},"574929704291884957":{"text":"And I'm here for it.","author":"\udb40\udc21\udb40\udc21"},"574930130477022487":{"text":"ok, and?","author":"igor360"},"574930130477124946":{"text":"[quote=The Dreamer in Carcosa]Worthless AI slop [\/quote]\njeez shut the hell up, its not like its generative ai or anything related to giant ai data centers, holy cringe","author":"FatherHonesty@bandit"},"574930130477140392":{"text":"[quote=FatherHonesty@bandit;574930130477124946][quote=The Dreamer in Carcosa]Worthless AI slop [\/quote]\njeez shut the hell up, its not like its generative ai or anything related to giant ai data centers, holy cringe [\/quote]\nlol, it's literally what it is.","author":"\udb40\udc21\udb40\udc21"},"574930130477223317":{"text":"[quote=FatherHonesty@bandit;574930130477124946][quote=The Dreamer in Carcosa]Worthless AI slop [\/quote]\njeez shut the hell up, its not like its generative ai or anything related to giant ai data centers, holy cringe [\/quote]\nThe ai does generate the responses the sister gives you.","author":"Catzilla01"},"565923139446385963":{"text":"[quote=Catzilla01;574930130477223317][quote=FatherHonesty@bandit;574930130477124946]\njeez shut the hell up, its not like its generative ai or anything related to giant ai data centers, holy cringe [\/quote]\nThe ai does generate the responses the sister gives you. [\/quote]\nWell yeah, but that's an inconvenient truth that invalidates their whole stance and proves mine, so we all just have to ignore that.","author":"The Dreamer in Carcosa"},"565923139446450470":{"text":"[quote=The Dreamer in Carcosa;565923139446385963][quote=Catzilla01;574930130477223317]\nThe ai does generate the responses the sister gives you. [\/quote]\nWell yeah, but that's an inconvenient truth that invalidates their whole stance and proves mine, so we all just have to ignore that. [\/quote]\n\n\nYou don't have a point though.","author":"JiggleBill"},"565923440615252490":{"text":"This is really all it takes to make the chuds angry lmao","author":"WildReaper29"},"565923440615259269":{"text":"[quote=OneBallPaul;565923440615252490]This is really all it takes to make the chuds angry lmao [\/quote]\nI know, right?","author":"The Dreamer in Carcosa"}},"track_navigation":true}, 'https://steamcommunity.com/comment/ForumTopic/', 40 ); } );

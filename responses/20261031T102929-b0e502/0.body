<style>
.gi5-app-banner {
  container-type: inline-size;
  overflow: hidden;
  background: #233fdf;
  color: #fff;
  font-family: "IBM Plex Sans", Arial, sans-serif;
  letter-spacing: 0;
}

.gi5-app-banner *, .gi5-app-banner *::before, .gi5-app-banner *::after {
  box-sizing: border-box;
}

.gi5-app-banner img {
  display: block;
  border: 0;
}

.gi5-app-banner__inner {
  --gi5-desktop-column: min(450px, calc(50% - 64px));
  position: relative;
  max-width: 1280px;
  height: auto;
  min-height: 320px;
  margin: 0 auto;
  display: flex;
  align-items: center;
}

.gi5-app-banner__copy {
  position: relative;
  z-index: 2;
  width: var(--gi5-desktop-column);
  max-width: 450px;
  margin-left: calc(50% - 32px - var(--gi5-desktop-column));
  padding: 40px 0;
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.gi5-app-banner .gi5-app-banner__copy h2 {
  position: relative;
  isolation: isolate;
  margin: 0;
  padding: 0;
  color: #fff;
  font-family: "kensington", Impact, sans-serif;
  font-size: 48px;
  font-weight: 900;
  font-style: normal;
  line-height: 1;
  letter-spacing: 0;
  word-spacing: 1px;
  text-transform: uppercase;
  text-box-trim: trim-both;
  text-box-edge: cap alphabetic;
}

.gi5-app-banner__last-line, .gi5-app-banner__highlight {
  white-space: nowrap;
}

.gi5-app-banner__highlight {
  position: relative;
  isolation: auto;
  display: inline-block;
}

.gi5-app-banner__highlight::before {
  content: "";
  position: absolute;
  z-index: -1;
  left: -8%;
  top: -40%;
  width: 116%;
  height: 180%;
  background: url("/sites/default/files/2026/10/21/dc510cf2/highlight.webp") center / 100% 100% no-repeat;
  transform: scale(1.15, -1);
  pointer-events: none;
}

.gi5-app-banner .gi5-app-banner__copy p {
  position: relative;
  z-index: 3;
  margin: 0;
  padding: 0;
  color: #fff;
  font-size: 18px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: -.02em;
  text-box-trim: trim-both;
  text-box-edge: cap alphabetic;
  max-width: 400px;
}

.gi5-app-banner__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
}

.gi5-app-banner a.gi5-app-banner__button {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  width: 136px;
  margin: 0;
  padding: 10px 12px;
  border: 2px solid #ff77d9;
  border-radius: 0;
  background: #ff77d9;
  color: #323b71 !important;
  font: 600 16px/20px "IBM Plex Sans", Arial, sans-serif;
  letter-spacing: .04em;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
}

.gi5-app-banner a.gi5-app-banner__button:hover, .gi5-app-banner a.gi5-app-banner__button:focus-visible {
  background: #233fdf;
  border-color: #ff77d9;
  color: #ff77d9 !important;
}

.gi5-app-banner a.gi5-app-banner__button:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 4px;
}

.gi5-app-banner__listing {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.gi5-app-banner .gi5-app-banner__app-icon {
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  max-width: none;
  margin: 0;
}

.gi5-app-banner__listing > div {
  padding-top: 1px;
}

.gi5-app-banner__app-name {
  display: block;
  color: #fff;
  font-family: "Biennale", "IBM Plex Sans", sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.gi5-app-banner__rating {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-top: 4px;
  color: #ff9941;
  font-size: 11px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -.02em;
}

.gi5-app-banner .gi5-app-banner__rating img {
  flex: 0 0 auto;
  width: 51.2px;
  height: 10.4px;
  max-width: none;
  margin: 0;
}

.gi5-app-banner__platforms {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 16px;
}

.gi5-app-banner .gi5-app-banner__platforms img[alt="Android"] {
  flex: 0 0 auto;
  width: 27.269564px;
  height: 32px;
  max-width: none;
  margin: 0;
}

.gi5-app-banner .gi5-app-banner__platforms img[alt="iOS"] {
  flex: 0 0 auto;
  width: 22.792px;
  height: 28px;
  max-width: none;
  margin: 0;
}

.gi5-app-banner a.gi5-app-banner__platform-link {
  position: relative;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent !important;
  filter: none !important;
  mix-blend-mode: normal;
  text-decoration: none;
}

.gi5-app-banner a.gi5-app-banner__platform-link img {
  opacity: 1 !important;
  filter: none !important;
  transform: none;
}

.gi5-app-banner a.gi5-app-banner__platform-link:hover img,
.gi5-app-banner a.gi5-app-banner__platform-link:focus-visible img {
  transform: translateX(-64px);
  filter: drop-shadow(64px 0 0 #ff77d9) !important;
}

.gi5-app-banner a.gi5-app-banner__platform-link:focus-visible {
  outline: 2px solid #ff77d9;
  outline-offset: 4px;
}

.gi5-app-banner__art {
  position: absolute;
  inset: 0;
  overflow: visible;
  pointer-events: none;
}

.gi5-app-banner img.gi5-app-banner__scenery {
  display: block;
  position: absolute;
  left: calc(50% + 16px);
  top: -16.2%;
  width: calc(50% - 16px + max(0px, (100cqw - 1280px) / 2));
  height: 116.2%;
  max-width: none;
  object-fit: cover;
  object-position: right top;
  clip-path: polygon(160px 0, 100% 0, 100% 100%, 64px 100%, 0 50%);
}

.gi5-app-banner__phone {
  position: absolute;
  left: calc(50% + 122px);
  top: -90px;
  width: auto;
  height: 688px;
  aspect-ratio: 918.066345 / 1403.039795;
  object-fit: cover;
  max-width: none;
  transform: rotate(-16.13deg);
}

@media (min-width: 761px) and (max-width: 1000px) {
  .gi5-app-banner .gi5-app-banner__copy h2 {
    font-size: 44px;
  }

  .gi5-app-banner .gi5-app-banner__copy p {
    font-size: 17px;
  }

}

@media (min-width: 761px) and (max-width: 900px) {
  .gi5-app-banner__copy {
    padding: 56px 0;
  }
}

@media (max-width: 760px) {
  .gi5-app-banner__inner {
    display: block;
    height: auto;
    --gi5-mobile-gap: 24px;
    --gi5-mobile-art-height: 300px;
    min-height: 0;
    max-height: none;
    padding: 32px 24px calc(var(--gi5-mobile-art-height) + var(--gi5-mobile-gap));
  }

  .gi5-app-banner__copy {
    position: static;
    display: flex;
    gap: var(--gi5-mobile-gap);
    width: auto;
    max-width: 400px;
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }

  .gi5-app-banner .gi5-app-banner__copy h2 {
    z-index: 2;
    font-size: 44px;
    line-height: .95;
  }

  .gi5-app-banner__last-line {
    display: block;
  }

  .gi5-app-banner__highlight::before {
    top: calc(50% - .776786em);
    width: 2.464286em;
    height: 1.553571em;
  }

  .gi5-app-banner .gi5-app-banner__copy p {
    position: relative;
    z-index: 3;
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
  }

  .gi5-app-banner__actions {
    display: block;
  }

  .gi5-app-banner a.gi5-app-banner__button {
    position: relative;
    z-index: 2;
  }

  .gi5-app-banner__art {
    top: auto;
    height: var(--gi5-mobile-art-height);
    overflow: hidden;
  }

  .gi5-app-banner img.gi5-app-banner__scenery {
    left: 0;
    top: 0;
    width: 100%;
    height: max(100%, 65.25cqw);
    object-position: center top;
    clip-path: polygon(0 18.375cqw, 70.75% 0, 100% 26.75cqw, 100% 100%, 0 100%);
  }

  .gi5-app-banner__phone {
    left: 14.2%;

    top: -3.515cqw;
    width: 80%;
    height: auto;
  }

  .gi5-app-banner__art::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 160px;
    background: linear-gradient(to bottom, transparent, #222 65%);
  }

  .gi5-app-banner__listing {
    position: absolute;
    z-index: 2;
    left: 24px;
    right: 76px;
    bottom: 11px;
    text-align: left;
  }

  .gi5-app-banner__platforms {
    position: absolute;
    z-index: 2;
    right: 24px;
    bottom: 15px;
    flex-direction: row;
    gap: 12px;
  }

}

@media (max-width: 450px) {
  .gi5-app-banner a.gi5-app-banner__button {
    width: 100%;
  }
}

@media (max-width: 374px) {
  .gi5-app-banner__inner {
    padding-left: 16px;
    padding-right: 16px;
  }

  .gi5-app-banner .gi5-app-banner__copy h2 {
    font-size: 40px;
  }

  .gi5-app-banner__listing {
    left: 16px;
    right: 60px;
  }

  .gi5-app-banner__app-name {
    font-size: 12px;
  }

  .gi5-app-banner__platforms {
    right: 16px;
  }

}

</style></div>
      
      </div>
</div>
              <div class="field__item">  <div class="paragraph paragraph--type--code paragraph--view-mode--default">
          
            <div class="clearfix text-formatted field field--name-field-code field--type-text-long field--label-hidden gi5-field-code gi5-text-long field__item"><section class="gi5-app-banner" aria-label="Game Informer magazine app">
  <div class="gi5-app-banner__inner">
    <div class="gi5-app-banner__art" aria-hidden="true">
      <img class="gi5-app-banner__scenery" src="/sites/default/files/2026/10/21/bfd09586/backdrop-desktop.webp" alt="A Personal Crusade" />
      <img class="gi5-app-banner__phone" src="/sites/default/files/2026/10/21/37e850a6/phone3.webp" alt="A Personal Crusade" />
    </div>
    <div class="gi5-app-banner__copy">
      <h2>Make Your <span class="gi5-app-banner__last-line">Commute <span class="gi5-app-banner__highlight">Count</span></span></h2>
      <p>Bad signal or dead zones? Download your issues before you leave and read anywhere.</p>
      <div class="gi5-app-banner__actions">
        <a class="gi5-app-banner__button" href="/app" target="_blank">Get the app</a>
        <div class="gi5-app-banner__listing">
          <img class="gi5-app-banner__app-icon" src="/sites/default/files/2026/10/21/b9a050fa/app-icon.webp" width="48" height="48" alt="A Personal Crusade" />
          <div>
            <span class="gi5-app-banner__app-name">Game Informer Magazine</span>
            <span class="gi5-app-banner__rating" aria-label="Rated 4.8 out of 5">
              <span aria-hidden="true">4.8</span><img src="/sites/default/files/2026/10/21/5f63d33c/stars.webp" width="64" height="13" alt="A Personal Crusade" />
            </span>
          </div>
        </div>
        <div class="gi5-app-banner__platforms" aria-label="Available for iOS and Android">
          <a class="gi5-app-banner__platform-link" href="https://apps.apple.com/us/app/game-informer-magazine/id6752615812" aria-label="Get the app on the App Store" target="_blank">
            <img class="gi5-app-banner__apple" src="/sites/default/files/2026/10/21/bd91705b/apple.webp" alt="iOS">
          </a>
          <a class="gi5-app-banner__platform-link" href="https://play.google.com/store/apps/details?id=com.gameinformer.app" aria-label="Get the app on Google Play" target="_blank">
            <img src="/sites/default/files/2026/10/21/da26b960/android.webp" width="41" height="48" alt="Android">
          </a>
        </div>
      </div>
    </div>
  </div>
</section></div>
      

<script>
  const buildZoomers = () => {
    if (!window.BrockmanZoomer) return;
    document.querySelectorAll('.zoomer:not([data-init])').forEach((target) => {
      const zoomer = new BrockmanZoomer({
        target,
        loc: {
          about: "About this image",
          all: "All",
          close: "Close",
          controls: "Controls",
          info: "Info",
          overlay: "Overlay images",
          thumbnails: "Thumbnails",
          title: "Zoomer",
          zoom: "Zoom",
        },
      });
      zoomer.run();
    });
  };

  window.addEventListener('articleScripts', buildZoomers);
  window.addEventListener('articleLoaded', buildZoomers);

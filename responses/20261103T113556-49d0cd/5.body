<script>
  const runCopyToClipboard = () => {
    const checkboxTemplate = document.getElementById('copy-to-clipboard-checkbox-template');
    if (window.BrockmanCopyToClipboard && !window.brockmanCopyToClipboard) {
      window.brockmanCopyToClipboard = new BrockmanCopyToClipboard({
        loc: {
          copy: 'Copy',
          copied: 'Copied',
        },
        checkboxTemplate,
      });
    }
  };
  window.addEventListener('articleScripts', runCopyToClipboard);
  window.addEventListener('articleLoaded', runCopyToClipboard);
</script>
<script>
  const buildTables = () => {
      if (!window.BrockmanTables) return;
      if (!window.brockmanTables) window.brockmanTables = new BrockmanTables({
        device: 'hd',
        loc: {
          checklist: "Checklist",
          filter: "Filter table",
          nothingFound: "No rows match this search term.",
          reset: "Clear search",
          sort: "Sort by column",
        },
      });
      window.brockmanTables.addTables();
  };
  window.addEventListener('articleScripts', buildTables);
  window.addEventListener('articleLoaded', buildTables);
</script>
<script>
  const buildCompetitions = () => {
    if (!window.BrockmanCompetition) return;
    document.querySelectorAll('.competition-container:not([data-init])').forEach((element) => {
      const competition = new BrockmanCompetition({
        element,
        loc: {
          genericError: "Sorry, there was an error loading this content. Try reloading the page.",
          noAnswerError: "Select an answer.",
          submitError: "Sorry, there was an error. Try reloading the page.",
          successMessage: "We\u0027ve received your entry. Thanks for entering, and good luck!",
        },
      });
      competition.run();
    });
  };

  window.addEventListener('articleScripts', buildCompetitions);
  window.addEventListener('articleLoaded', buildCompetitions);
</script>

  <script>

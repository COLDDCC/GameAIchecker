nput\"},{\"id\":76,\"description\":\"Mouse Only Option\"},{\"id\":79,\"description\":\"Save Anytime\"}],\"genres\":[{\"id\":\"2\",\"description\":\"Strategy\"},{\"id\":\"23\",\"description\":\"Indie\"},{\"id\":\"25\",\"description\":\"Adventure\"},{\"id\":\"3\",\"description\":\"RPG\"},{\"id\":\"4\",\"description\":\"Casual\"}],\"userDefinedTags\":[{\"id\":11,\"name\":\"Strategy\"},{\"id\":21,\"name\":\"Indie\"},{\"id\":22,\"name\":\"Casual\"},{\"id\":25,\"name\":\"Hand-drawn\"},{\"id\":30,\"name\":\"2D\"},{\"id\":35,\"name\":\"RPG\"},{\"id\":56,\"name\":\"Loot\"},{\"id\":57,\"name\":\"Singleplayer\"},{\"id\":67,\"name\":\"Adventure\"},{\"id\":91,\"name\":\"Dark Fantasy\"},{\"id\":93,\"name\":\"Combat\"},{\"id\":104,\"name\":\"Idler\"},{\"id\":132,\"name\":\"Dark\"},{\"id\":160,\"name\":\"Resource Management\"},{\"id\":206,\"name\":\"Strategy RPG\"},{\"id\":226,\"name\":\"Party-Based RPG\"},{\"id\":262,\"name\":\"Hack and Slash\"},{\"id\":310,\"name\":\"Automation\"},{\"id\":329,\"name\":\"Auto Battler\"},{\"id\":448,\"name\":\"incremental\"}],\"screenshots\":[{\"screenshotId\":0,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/b3dbcdb66e0819d662a41a56c18def9d67b46551/ss_b3dbcdb66e0819d662a41a56c18def9d67b46551.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/b3dbcdb66e0819d662a41a56c18def9d67b46551/ss_b3dbcdb66e0819d662a41a56c18def9d67b46551.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":1,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/448b80899d8436a9087ed4b9c8745be9bcb98b7b/ss_448b80899d8436a9087ed4b9c8745be9bcb98b7b.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/448b80899d8436a9087ed4b9c8745be9bcb98b7b/ss_448b80899d8436a9087ed4b9c8745be9bcb98b7b.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":2,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/0b360d7c1c52b026027130f6b20162b95b6c013d/ss_0b360d7c1c52b026027130f6b20162b95b6c013d.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/0b360d7c1c52b026027130f6b20162b95b6c013d/ss_0b360d7c1c52b026027130f6b20162b95b6c013d.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":3,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/206dbdf2e645af13ff5f7a6425751176a99af12e/ss_206dbdf2e645af13ff5f7a6425751176a99af12e.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/206dbdf2e645af13ff5f7a6425751176a99af12e/ss_206dbdf2e645af13ff5f7a6425751176a99af12e.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":4,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/9f607bb289be794b69c71817be0bb0ae611ebd00/ss_9f607bb289be794b69c71817be0bb0ae611ebd00.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/9f607bb289be794b69c71817be0bb0ae611ebd00/ss_9f607bb289be794b69c71817be0bb0ae611ebd00.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":5,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/ac011f3bd006dabad2b4d8a6d09dc6d2259b7d37/ss_ac011f3bd006dabad2b4d8a6d09dc6d2259b7d37.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/ac011f3bd006dabad2b4d8a6d09dc6d2259b7d37/ss_ac011f3bd006dabad2b4d8a6d09dc6d2259b7d37.1920x1080.jpg?t=1790736075\"},{\"screenshotId\":6,\"pathThumbnail\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/4990b3a90bd92d86742b39f290e0b72cf6ce98e3/ss_4990b3a90bd92d86742b39f290e0b72cf6ce98e3.600x338.jpg?t=1790736075\",\"pathFull\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4243990/4990b3a90bd92d
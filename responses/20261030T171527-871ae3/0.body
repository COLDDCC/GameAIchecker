sx-185155107" title="Romania (opens in a new window)" target="_blank" rel="noopener noreferrer">Romania (opens in a new window)</a><a href="https://sea.ign.com/" class="interface jsx-1132626198 navigation-item global-sidebar-item jsx-1115554155 jsx-185155107" title="Southeast Asia">Southeast Asia</a><a href="https://www.ign.com/?setccpref=ES" class="interface jsx-1132626198 navigation-item global-sidebar-item jsx-1115554155 jsx-185155107" title="Spain (opens in a new window)" target="_blank" rel="noopener noreferrer">Spain (opens in a new window)</a><a href="https://www.ign.com/?setccpref=TR" class="interface jsx-1132626198 navigation-item global-sidebar-item jsx-1115554155 jsx-185155107" title="Turkey (opens in a new window)" target="_blank" rel="noopener noreferrer">Turkey (opens in a new window)</a><a href="https://www.ign.com/?setccpref=UK" class="interface jsx-1132626198 navigation-item global-sidebar-item jsx-1115554155 jsx-185155107" title="United Kingdom (opens in a new window)" target="_blank" rel="noopener noreferrer">United Kingdom (opens in a new window)</a><a href="https://www.ign.com/?setccpref=US" class="interface jsx-1132626198 navigation-item global-sidebar-item jsx-1115554155 jsx-185155107" title="United States (opens in a new window)" target="_blank" rel="noopener noreferrer">United States (opens in a new window)</a></span></div></span></div><span class="stack jsx-3547261442 global-sidebar-legal"><div class="interface jsx-1132626198 legal-text small">©<!-- -->2026<!-- --> IGN a brand of IGN Entertainment, Inc. All Rights Reserved. No part of this website or its content may be reproduced without the copyright owner’s permission. IGN® and IGN Entertainment are trademarks or registered trademarks of IGN Entertainment, Inc.</div></span></span></div></span></div></nav><span class="stack jsx-2509706801 jsx-1192436910 sidebar-back-to-top"><button class="button-text jsx-729543028 button button--secondary jsx-3027214138 jsx-4263301944 contained small" type="button">Back To Top</button></span></div><div data-cy="global-sidebar-footer" class="jsx-4120930023 global-sidebar-footer"><span style="margin-left:36px"></span></div></div><div class="jsx-3169697164 adunit-wrapper"><div class="jsx-3169697164 bobble bobble- pogocnt pg-article"><div data-mix-name="fourBy" data-pos="" data-pogo-hide="1" class="jsx-343126785 pogo-slot"></div></div></div></header><main data-cy="page-main-content" id="main-content" tabindex="-1" class="jsx-1483978097"><span id="content" tabindex="-1" class="jsx-262682205"></span><div data-cy="page-header" class="jsx-3209398698 page-header page-content"><div class="interface jsx-1132626198 jsx-51192294 bold small"><a class="link jsx-1337145738 jsx-2426100147 underlined" data-cy="site-breadcrumb" href="/">Home</a><span aria-hidden="true" style="margin:0 8px;color:var(--theme-elements-text-default)">›</span><a class="link jsx-1337145738 jsx-2426100147 underlined" data-cy="site-breadcrumb" href="/games/reblade-the-death-spiral">ReBlade: The Death Spiral</a></div><h1 class="display-title jsx-684634384 jsx-560310519" data-cy="article-headline">ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite</h1><h2 data-cy="article-sub-headline" class="title3 jsx-12333944 jsx-37621054">We got the first hands-on with developer ChillyRoom’s upcoming hack-and-slash cyberpunk action-RPG.</h2></div><div class="jsx-1120709024 page-content"><output class="box-wrapper jsx-2673806401 watch-read-video" data-cy="watch-read-video"><span data-cy="video-view-trigger"><div class="rounded jsx-1986132135"><div class="jsx-2277167929 video jsx-2008855984 aspect-ratio aspect-ratio-16-9"><div class="jsx-2189758939 loading jsx-2347718207"><span class="ign-icon icon-loading jsx-2750866048 jsx-1271180528" role="img" aria-hidden="false" data-cy="icon-loading" aria-label="Loading" style="mask:url(https://kraken.ignimgs.com/_next/static/media/LoadingSpinner.700933d0.svg?cors=1) no-repeat center center / contain;background:white"></span></div><div class="badge jsx-1349606671 jsx-3647116352"><span class="ign-icon icon-play jsx-2750866048 jsx-1044454891" role="img" aria-hidden="false" data-cy="icon-play" aria-label="Play" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Play.59e5540b.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></div></div></div></span></output><section class="jsx-1384944967 byline"><div class="jsx-1384944967 byline-row"><span class="stack jsx-59817748 jsx-702910195 byline-stack"><span class="stack jsx-3647836811 jsx-4269505506 article-authors"><section data-cy="author-avatars" class="jsx-1825775112 author-avatars avatars-1"><div class="rounded jsx-444076027 jsx-1730475047 author-thumb profile-thumb jsx-3097962137 aspect-ratio aspect-ratio-1-1"><img alt="Alessandro Fillari Avatar" decoding="async" class="progressive-image profile-thumb-img jsx-249361588 jsx-2338608387 expand" loading="lazy" src="https://assets-prd.ignimgs.com/avatars/63c98757c4a57f00016414cd/8hUQUiea_400x400-1677269836814.jpg?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80" srcSet="https://assets-prd.ignimgs.com/avatars/63c98757c4a57f00016414cd/8hUQUiea_400x400-1677269836814.jpg?crop=1%3A1&amp;width=21&amp;format=jpg&amp;auto=webp&amp;quality=80 1x, https://assets-prd.ignimgs.com/avatars/63c98757c4a57f00016414cd/8hUQUiea_400x400-1677269836814.jpg?crop=1%3A1&amp;width=21&amp;dpr=2&amp;format=jpg&amp;auto=webp&amp;quality=80 2x" data-cy="progressive-image"/></div></section><div data-cy="caption" class="caption jsx-1762799490">By <a class="link jsx-1337145738 article-author underlined" data-cy="article-author" href="/person/afillari">Alessandro Fillari</a></div></span><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490 byline-date">Updated<!-- -->: <time dateTime="2026-10-20T17:18:00Z">Oct 20, 2026 5:18pm UTC</time></div><div class="jsx-3449795453 divider jsx-428691023"></div><div data-cy="caption" class="caption jsx-1762799490"><a class="link jsx-1337145738 jsx-2474574152 underlined" data-cy="styled-link" href="/articles/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite#comments"><span class="stack jsx-3647836811"><span class="ign-icon icon-comment jsx-2750866048 jsx-4173866675" role="img" aria-hidden="false" data-cy="icon-comment" aria-label="Comments" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Comment.e2c389d0.svg?cors=1) no-repeat center center / contain;background:currentColor"></span>2 comments</span></a></div></span><div class="jsx-1384944967 byline-action"><a href="https://www.google.com/preferences/source?q=https://www.ign.com" class="button-text jsx-729543028 button button--secondary jsx-3027214138 contained centered small" target="_blank"><img class="ign-icon icon-google jsx-2750866048 jsx-3701596282" role="presentation" aria-hidden="true" data-cy="icon-google" alt="" loading="eager" src="https://kraken.ignimgs.com/_next/static/media/Google.9e99a9d7.svg?cors=0"/><span class="button-text jsx-729543028 small">Add IGN on Google</span></a></div></div><div class="jsx-3449795453 divider jsx-3709034244"></div></section><div class="jsx-3169697164 adunit-wrapper"><div class="jsx-3169697164 bobble bobble-0 pogocnt pg-article"><div data-pogo="top" data-mix-name="leaderboardOnly" data-pos="0" class="jsx-343126785 top pogo-slot"></div></div></div></div><div class="jsx-462858067 page-content"><div class="jsx-462858067 side-by-side"><div data-cy="article-content" class="jsx-462858067 article-content page-0"><section data-cy="article-subtitle" class="article jsx-3932497636 article-section jsx-242790214" data-autopogo="true"><section class="article-page"><p data-cy="paragraph" class="paragraph jsx-2269604527"><em><strong>Key Preview Takeaways:</strong></em></p><ul class="list jsx-4224303756" data-cy="list"><li><em>Combat leans heavily into parrying.</em></li><li><em>The demo we played shows promise, but we’re hoping for more depth in the final version.</em></li><li><em>The concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077.</em></li></ul><div data-cy="accent-divider" class="jsx-3449795453 divider jsx-2786329600"></div><p data-cy="paragraph" class="paragraph jsx-2269604527">No other gameplay maneuver has had as much impact on modern action games as the parry. This ultimate skill suits both aggressive and defensive playstyles, letting you stylishly tip the scales of battle unscathed. Games like Sekiro, Lies of P, and the recent Onimusha: Way of the Sword lean into that focused combat style action fans have embraced. The upcoming ReBlade: The Death Spiral looks set to join that growing catalog of top-level action games that give you the tools and the satisfaction of tearing through enemies&#x27; defenses – this time within the framework of a roguelite.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Developer ChillyRoom has created a blend of a dungeon-crawling roguelite and fast-paced action-brawler, which leans into the idea of a cunning cybernetic warrior slashing and parrying through an ever-changing setting. In our hands-on with the ReBlade: The Death Spiral demo, we got to play over two hours of varied runs. This early hands-on made for a compelling onboarding experience for a stylish isometric roguelite action game, but we hope the full game shows much more of its core strengths in action.</p><h3 data-cy="title3" class="title3 jsx-12333944 jsx-3517023867">Chinese Mythology by way of Cyberpunk</h3><output class="box-wrapper jsx-2673806401" data-cy="article-video"><div class="jsx-2277167929 video jsx-2008855984 aspect-ratio aspect-ratio-16-9"><div class="badge jsx-1349606671 jsx-3647116352"><span class="ign-icon icon-play jsx-2750866048 jsx-1044454891" role="img" aria-hidden="false" data-cy="icon-play" aria-label="Play" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Play.59e5540b.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></div></div></output><p data-cy="paragraph" class="paragraph jsx-2269604527">ReBlade: The Death Spiral&#x27;s core concept centers on the steady exploration of a far-future megacity steeped in the mystique of Chinese mythology. Set in a sprawling metropolis ruled by cyborg gangs and warlords reimagined as deities and mythological figures, you play a nameless android who crawls out of the trash heap, damaged but still ready for a fight. They soon chart a path of destruction across the ruthless neon city, aiming to stop the cycle of violence and uncover the truth of their origins.</p><div class="display-title jsx-684634384 jsx-2659527929 quote-container" data-cy="quoteBox">The concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077.<span class="stack jsx-2959124702 jsx-326843967"><div class="jsx-3449795453 divider jsx-428691023"></div><span>“</span></span></div><p data-cy="paragraph" class="paragraph jsx-2269604527">The concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077, offering a visually stylized, brutal world to cut a path through. It has all the trappings of a dystopian sci-fi thriller, making a solid and infrequently seen framework for a roguelite brawler. It focuses on the protagonist as they cut their path through the procedurally generated upper layers of the metropolis. Along the way, she&#x27;ll collect new weapons with slick abilities like chain lightning and fire-burst damage, plus new chip modifiers that further buff her stats. She can even use her heightened cyborg strength to pull off cool finishers and kick bombs back at vulnerable foes.</p><output class="box-wrapper jsx-2673806401" data-cy="article-video"><div class="jsx-2277167929 video jsx-2008855984 aspect-ratio aspect-ratio-16-9"><div class="badge jsx-1349606671 jsx-3647116352"><span class="ign-icon icon-play jsx-2750866048 jsx-1044454891" role="img" aria-hidden="false" data-cy="icon-play" aria-label="Play" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Play.59e5540b.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></div></div></output><p data-cy="paragraph" class="paragraph jsx-2269604527">All the familiar elements of an action-RPG roguelite are here, but the cyberpunk-style and setting, plus the focus on fast, parry-heavy brawler action gives ReBlade a different flavor and perspective than its contemporaries. However, the overall narrative, at least as far as I can tell from this demonstration, is fairly light. It mostly relies on vibes and environmental storytelling to sell the setting and the protagonist&#x27;s motivations. That&#x27;s not necessarily a major negative, and the visual style and tone certainly helps ground ReBlade. However, after several runs, it still left me wanting more context and reasons to invest in the journey.</p><h3 data-cy="title3" class="title3 jsx-12333944 jsx-3517023867">Cyber-City Dungeon Crawl</h3><p data-cy="paragraph" class="paragraph jsx-2269604527">ReBlade really puts its weight on the core action of its many runs. Starting in the lower rungs of the megacity, you fight everything from lowly machine drones to hulking bruisers lurking on different floors. The action flows akin to other isometric top-down action-brawlers like Hades, and it does a good job of conveying the fast pace of combat. Using combo attacks, sub-weapon skills, buffs, and that all-important parry, I cut my way past enemy defenses. Landing a series of deflects is very satisfying, and it&#x27;s especially cool to rapidly deflect enemy blaster shots back at surrounding enemies. Seriously, it felt immensely fun to pull off lightning-fast parries like this one during my different runs.</p><output class="box-wrapper jsx-2673806401" data-cy="article-slideshow"><span data-cy="slideshow-view-trigger"><div data-cy="slideshow-preview" class="jsx-1711207865 slideshow-preview"><h3 class="title5 jsx-62124236 jsx-1085005187" data-cy="slideshow-preview-title">ReBlade: The Death Spiral - First Screenshots</h3><div data-cy="slideshow-images-container" class="jsx-1711207865 images-container"><button type="button" data-cy="hero-image" aria-label="Open Slideshow" class="jsx-1711207865 hero-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/><span class="button-text jsx-729543028 button button--primary jsx-3027214138 jsx-4266531355 row-pagination-button next contained centered round large" data-cy="paginate next" title="Open Slideshow"><span class="ign-icon right-chevron jsx-2750866048 jsx-2919720488" role="presentation" aria-hidden="true" data-cy="right-chevron" style="mask:url(https://kraken.ignimgs.com/_next/static/media/RightChevron.272be43c.svg?cors=1) no-repeat center center / contain;background:currentColor"></span></span></button><div data-cy="slideshow-images-list" class="scrollbar jsx-3524787213 jsx-4268464690 images-list"><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/><div class="rounded jsx-412047461 overlay progressive-image jsx-2338608387 expand" data-cy="slideshow-image-overlay"><div data-cy="element-caption" class="caption jsx-1762799490">View 12 Images</div></div></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button><button data-cy="gallery-image" type="button" aria-label="Open Slideshow" class="jsx-1711207865 gallery-image"><img alt="" aria-hidden="true" decoding="async" role="presentation" class="progressive-image jsx-2277167929 image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></button></div></div></div></span></output><p data-cy="paragraph" class="paragraph jsx-2269604527">Even with the low-level gear you’re issued with at the start, ReBlade&#x27;s combat fundamentals really do give you a sense of style and mastery when fighting enemies. I mostly stuck with the standard sword, which offers a balance of speed and power that I tend to favor, but I also had fun with the speedy twin blades and the heavier axe-and-shield combo. The action is further heightened by the more advanced weapons you&#x27;ll find in dungeons and at various shops along the way. You can even swap certain buffs and perks between your gear to improve a favorite weapon found during a run. Tapping further into the cyberpunk angle, your protagonist can also augment themselves with different chips which add special modifiers to attacks, such as amplifying elemental damage or boosting recovery.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">In an interesting change of pace from more linear roguelites, ReBlade lets you choose which path you want to take through its world. For each layer of the city, you&#x27;re given choices about which areas to hit up, most of which are only available for a limited time before they disappear. This progression style let me focus on which weapon or performance upgrades and resource-gathering stages I wanted to pursue first. I really appreciated having a bit of choice in what loot I wanted, especially when I needed to save up cash before heading to one of the few shops that appear on the map. </p><div class="display-title jsx-684634384 jsx-2659527929 quote-container" data-cy="quoteBox">While I like the ReBlade&#x27;s focus on core action, I still felt some aspects of the roguelite structure were a bit underbaked and not fully realized as of this time, at least in this section of the game.<span class="stack jsx-2959124702 jsx-326843967"><div class="jsx-3449795453 divider jsx-428691023"></div><span>“</span></span></div><p data-cy="paragraph" class="paragraph jsx-2269604527">ReBlade&#x27;s combat really kicks into high gear during the boss encounters, which put the offense and defensive skills you&#x27;ve cultivated throughout a run to the test. These bosses blend cybernetic warlords and Chinese mythology, making the battles feel like the game is walking a fine line between a high-fantasy martial arts epic and a hard sci-fi action movie. I was really impressed by each boss&#x27;s look and the design surrounding each battle; it delivered a showstopping finish to each layer. My favorite was a mysterious, wraith-like cyborg known as The Black, who fought like a cyber-enhanced grim reaper.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">While I enjoyed ReBlade&#x27;s spectacle and fast action, I found the demo sometimes felt a bit too generous. I didn&#x27;t have much trouble getting through the two layers, especially when I found some great weapons that helped me clear enemies quickly. Moreover, you&#x27;re also given a set of extra lives to help with runbacks on tougher challenges – which is very rare to see in a roguelite. While I like the ReBlade&#x27;s focus on core action, I still felt some aspects of the roguelite structure were a bit underbaked and not fully realized as of this time, at least in this section of the game.</p><p data-cy="paragraph" class="paragraph jsx-2269604527">Still, this early demo offered some slick fights to dive into. With an eye-catching setting and seriously satisfying combat and parry action, developer ChillyRoom&#x27;s cyberpunk roguelite concept shows solid promise as an action-RPG. While I hope ReBlade: The Death Spiral showcases a much deeper side in the full game, this early demo gets its stylized, grim world off to a solid start, and it&#x27;s already got me ready to deflect and whittle down the cyborg opposition.</p><div data-cy="accent-divider" class="jsx-3449795453 divider jsx-2786329600"></div><p data-cy="paragraph" class="paragraph jsx-2269604527">While you&#x27;re here, check out these recent previews of other big upcoming games we&#x27;ve checked out recently!</p><ul class="list jsx-4224303756" data-cy="list"><li><a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/the-legend-of-zelda-ocarina-of-time-remake-is-more-different-than-you-think-ign-preview">The Legend of Zelda: Ocarina of Time Remake</a></li><li><a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/phantom-blade-zero-might-be-this-years-most-stylish-action-game-ign-preview">Phantom Blade Zero</a></li><li><a class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" href="/articles/exodus-plays-exactly-how-a-new-mass-effect-should-ign-hands-on-preview">Exodus</a></li></ul><div data-cy="accent-divider" class="jsx-3449795453 divider jsx-2786329600"></div><p data-cy="paragraph" class="paragraph jsx-2269604527"><em>Alessandro Fillari is a longtime games media professional. Talk video games with him on BlueSky at </em><a href="https://bsky.app/profile/afillari.bsky.social" class="link jsx-1337145738 jsx-3925284146 underlined" data-cy="styled-link" target="_blank" rel="noopener noreferrer">@afillari.bsky.social</a><em>.</em></p></section></section><span class="stack jsx-1475529924"></span></div><div class="jsx-462858067 right-rail"><div class="jsx-448876066 sticky-wrapper"><div class="jsx-3169697164 adunit-wrapper"><div class="jsx-3169697164 bobble bobble-0 pogocnt pg-article"><div data-pogo="sidebar" data-mix-name="tallAd" data-pos="0" class="jsx-343126785 sidebar pogo-slot"></div></div></div><aside aria-label="Recommended content" class="jsx-1247231955 ign-recommends"><h3 data-cy="title3" class="title3 jsx-12333944 jsx-1795996210 ign-recommends-headline"><svg data-cy="icon-logo" viewBox="0 0 76 24" title="IGN" class="ign-icon icon-logo icon-logo-original jsx-2750866048 jsx-1989405728"><title>IGN Logo</title><path class="dpad" fill="currentColor" stroke="none" d="M5.38 7.65a7.85 7.85 0 0 1 2.26-2.26c.13-1.18.31-2.26.52-3.21a10.605 10.605 0 0 0-6 6c.95-.22 2.03-.39 3.21-.52M16.34 5.36v.02c.9.59 1.67 1.37 2.27 2.27 1.18.13 2.26.31 3.21.52a10.627 10.627 0 0 0-6.02-6.01c.22.95.4 2.02.54 3.2M7.64 18.62c-.9-.59-1.67-1.37-2.27-2.27h-.03c-1.19-.14-2.26-.32-3.19-.54 1.07 2.75 3.26 4.95 6.01 6.02-.22-.95-.39-2.03-.52-3.21M18.64 16.35h-.03c-.59.9-1.37 1.67-2.27 2.27v.03c-.14 1.17-.32 2.25-.54 3.19a10.59 10.59 0 0 0 6.03-6.03c-.94.22-2 .4-3.19.54M10.04 0h3.9c.85 1.85 1.2 4.59 1.3 5.52.04.22.06.43.06.63L12 9.11 8.7 6.15c0-.17.02-.35.05-.55.1-.95.43-3.75 1.29-5.61M8.7 17.83c0 .17.02.35.05.55.1.95.43 3.75 1.29 5.61h3.9c.85-1.84 1.2-4.59 1.3-5.52.04-.22.06-.43.06-.64L12 14.87l-3.3 2.96ZM6.16 8.68c-.17 0-.35.02-.55.05-.95.12-3.75.45-5.61 1.31v3.9c1.84.85 4.59 1.19 5.52 1.3.22.04.43.06.64.06L9.11 12 6.16 8.7ZM24 10.02c-1.86-.86-4.66-1.19-5.61-1.29-.2-.03-.38-.05-.55-.05l-2.96 3.3 2.96 3.3c.2 0 .41-.02.64-.06.93-.11 3.68-.45 5.52-1.3v-3.9Z"></path><path class="ign-path" fill="currentColor" stroke="none" d="M42.83 13.9V10h10.45c1.06 0 1.93.86 1.93 1.92v4.63c0 2.38-1.91 4.36-4.33 4.36h-6.69c-4.96 0-8.97-4-8.97-8.94s4.04-8.95 8.98-8.95h10.36v4.11H44.2c-2.67 0-4.86 2.17-4.86 4.84s2.16 4.83 4.86 4.83h6.91v-2.91h-8.27ZM33.86 3h-4.07v16.02c0 1.05.86 1.91 1.91 1.91h2.15V3M74.37 3.01h-2.18v13.81s0 .08-.03.11a.29.29 0 0 1-.24.14c-.09 0-.16-.04-.25-.15L64.83 4.93a4.347 4.347 0 0 0-3.72-2.11h-.07c-2.39 0-4.32 1.93-4.32 4.32v11.88c0 1.05.86 1.91 1.91 1.91h2.17V7.14s.02-.09.04-.13a.29.29 0 0 1 .24-.14c.09 0 .18.03.24.14l6.88 12.07c.76 1.27 2.12 2.05 3.69 2.05h.07c2.39 0 4.32-1.93 4.32-4.32V4.92c0-1.05-.85-1.91-1.91-1.91"></path></svg>Recommends</h3><span class="stack jsx-3547261442 ign-recommends-items"><div class="jsx-3169697164 adunit-wrapper"><div class="jsx-3169697164 bobble bobble- pogocnt pg-article"><div data-pogo="native" data-mix-name="threeBy" data-pos="" class="jsx-343126785 native pogo-slot"></div></div></div><div data-cy="content-item" class="content-item jsx-2981448069 column" data-id="8248f313-66fc-4b2f-a487-0b047e664f54"><a data-cy="item-body" class="item-body" aria-label="Avatar: Seven Havens Season 1 Finale Review and Recap" href="/articles/avatar-seven-havens-season-1-finale-episodes-10-13-review-and-recap"><div class="item-thumbnail"><span><img alt="Avatar: Seven Havens Season 1 Finale Review and Recap" decoding="async" class="progressive-image jsx-2277167929 item-image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></span></div><span class="stack jsx-659253495 item-details" data-cy="item-details"><span class="interface jsx-1132626198 jsx-4254096439 item-title bold" data-cy="item-title">Avatar: Seven Havens Season 1 Finale Review and Recap</span></span></a></div><div data-cy="content-item" class="content-item jsx-2981448069 column" data-id="180b998e-88cc-4576-80ab-f4793adfb489"><a data-cy="item-body" class="item-body" aria-label="The Elder Scrolls 6 Is Reportedly Subtitled &#x27;Sentinel&#x27;, New Story Details Revealed Ahead of Rumored Announcement" href="/articles/the-elder-scrolls-6-is-reportedly-subtitled-sentinel-new-story-details-revealed-ahead-of-rumored-announcement"><div class="item-thumbnail"><span><img alt="The Elder Scrolls 6 Is Reportedly Subtitled &#x27;Sentinel&#x27;, New Story Details Revealed Ahead of Rumored Announcement" decoding="async" class="progressive-image jsx-2277167929 item-image aspect-ratio aspect-ratio-16-9 jsx-2605834259 jsx-2338608387 hover-opacity" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-cy="progressive-image"/></span></div><span class="stack jsx-659253495 item-details" data-cy="item-details"><span class="interface jsx-1132626198 jsx-4254096439 item-title bold" data-cy="item-title">The Elder Scrolls 6 Is Reportedly Subtitled &#x27;Sentinel&#x27;, New Story Details Revealed Ahead of Rumored Announcement</span><span class="stack jsx-59817748 jsx-3492383812 item-more-data"><div data-cy="caption" class="caption jsx-1762799490 jsx-2088664416 comment-count data small"><span class="ign-icon icon-comment jsx-2750866048 jsx-2145005295" role="img" aria-hidden="false" data-cy="icon-comment" aria-label="Comments" style="mask:url(https://kraken.ignimgs.com/_next/static/media/Comment.e
bute","name":"ChillyRoom"}}],"primaryObject":{"__typename":"Object","primaryImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2026/01/26/reblade-the-death-spiral-button-1769444785419.jpg"},"franchises":[],"genres":[{"__typename":"Attribute","slug":"action"},{"__typename":"Attribute","slug":"rpg"},{"__typename":"Attribute","slug":"roguelike"}],"merchant":null,"affiliateLink":null,"objectRegions":[{"__typename":"ObjectRegion","releases":[{"__typename":"Release","id":"de0063c9-b086-47ed-b884-0c029ade7ba4","date":"2049-12-31","estimatedDate":true,"timeframeYear":"TBA/TBA","platformAttributes":[{"__typename":"Attribute","id":4473466,"name":"PC","slug":"pc"}]}],"id":2382250,"name":null,"region":"US"}],"id":"6c871bbc-4691-47be-a830-a85b2e3d30d9","url":"/games/reblade-the-death-spiral","slug":"reblade-the-death-spiral","type":"Game","metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"ReBlade: The Death Spiral","alt":[],"short":null}}},"objects":[{"__typename":"Object","id":"6c871bbc-4691-47be-a830-a85b2e3d30d9","url":"/games/reblade-the-death-spiral","slug":"reblade-the-death-spiral","type":"Game","merchant":null,"affiliateLink":null,"metadata":{"__typename":"Metadata","names":{"__typename":"Names","name":"ReBlade: The Death Spiral","alt":[],"short":null}},"objectRegions":[{"__typename":"ObjectRegion","id":2382250,"name":null,"region":"US","releases":[{"__typename":"Release","id":"de0063c9-b086-47ed-b884-0c029ade7ba4","date":"2049-12-31","platformAttributes":[{"__typename":"Attribute","id":4473466,"name":"PC","slug":"pc"}]}]}],"franchises":[]}],"seoTitle":"ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite","ogTitle":"ReBlade: The Death Spiral Brings the Parry Rush to the Roguelite Genre | IGN Preview","nonIndexable":false,"isPaywalled":false,"abTests":[{"__typename":"ABTest","id":71964,"represents":"promoTitle","values":["ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite","ReBlade: The Death Spiral Brings the Parry Rush to the Roguelite Genre | IGN Preview"],"winnerIndex":0}],"sponsorships":[],"contentCategory":{"__typename":"ContentCategory","id":2,"name":"Preview"},"brand":{"__typename":"Brand","id":155,"slug":null,"name":"IGN Game Previews","logoLight":null,"logoDark":null},"sequenceNumber":null,"id":"0c4e2a09-d048-427f-b733-c6844bfb6f5c","type":"Article","title":"ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite - IGN","subtitle":"We got the first hands-on with developer ChillyRoom’s upcoming hack-and-slash cyberpunk action-RPG.","promoteAt":null,"publishDate":"2026-10-20T16:52:49.085Z","slug":"reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","feedTitle":"ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite","feedImage":{"__typename":"Image","url":"https://assets-prd.ignimgs.com/2026/10/20/reblade-preview-blogroll-1792515184243.jpg"},"v3Id":null,"url":"/articles/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","heroVideoContentId":"b9e5f725-7cec-4e01-b06d-cd016cd2fa07","heroVideoContentSlug":"reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","processedHtml":"\u003csection class=\"article-page\"\u003e\u003cp\u003e\u003cem\u003e\u003cstrong\u003eKey Preview Takeaways:\u003c/strong\u003e\u003c/em\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cem\u003eCombat leans heavily into parrying.\u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem\u003eThe demo we played shows promise, but we’re hoping for more depth in the final version.\u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem\u003eThe concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077.\u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e\u003csection data-transform=\"mobile-ad-break\"\u003e\u003c/section\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003eNo other gameplay maneuver has had as much impact on modern action games as the parry. This ultimate skill suits both aggressive and defensive playstyles, letting you stylishly tip the scales of battle unscathed. Games like Sekiro, Lies of P, and the recent Onimusha: Way of the Sword lean into that focused combat style action fans have embraced. The upcoming ReBlade: The Death Spiral looks set to join that growing catalog of top-level action games that give you the tools and the satisfaction of tearing through enemies\u0026#39; defenses – this time within the framework of a roguelite.\u003c/p\u003e\u003cp\u003eDeveloper ChillyRoom has created a blend of a dungeon-crawling roguelite and fast-paced action-brawler, which leans into the idea of a cunning cybernetic warrior slashing and parrying through an ever-changing setting. In our hands-on with the ReBlade: The Death Spiral demo, we got to play over two hours of varied runs. This early hands-on made for a compelling onboarding experience for a stylish isometric roguelite action game, but we hope the full game shows much more of its core strengths in action.\u003c/p\u003e\u003ch3\u003eChinese Mythology by way of Cyberpunk\u003c/h3\u003e\u003csection data-transform=\"ignvideo\" data-slug=\"reblade-the-death-spiral-official-steam-next-fest-demo-trailer\" data-loop=\"\"\u003e\u003c/section\u003e\u003cp\u003eReBlade: The Death Spiral\u0026#39;s core concept centers on the steady exploration of a far-future megacity steeped in the mystique of Chinese mythology. Set in a sprawling metropolis ruled by cyborg gangs and warlords reimagined as deities and mythological figures, you play a nameless android who crawls out of the trash heap, damaged but still ready for a fight. They soon chart a path of destruction across the ruthless neon city, aiming to stop the cycle of violence and uncover the truth of their origins.\u003c/p\u003e\u003csection data-transform=\"quoteBox\"\u003eThe concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077.\u003c/section\u003e\u003cp\u003eThe concept feels like a mix of Alita: Battle Angel and Cyberpunk 2077, offering a visually stylized, brutal world to cut a path through. It has all the trappings of a dystopian sci-fi thriller, making a solid and infrequently seen framework for a roguelite brawler. It focuses on the protagonist as they cut their path through the procedurally generated upper layers of the metropolis. Along the way, she\u0026#39;ll collect new weapons with slick abilities like chain lightning and fire-burst damage, plus new chip modifiers that further buff her stats. She can even use her heightened cyborg strength to pull off cool finishers and kick bombs back at vulnerable foes.\u003c/p\u003e\u003csection data-transform=\"ignvideo\" data-slug=\"reblade-the-death-spiral-official-announcement-trailer\" data-loop=\"\"\u003e\u003c/section\u003e\u003cp\u003eAll the familiar elements of an action-RPG roguelite are here, but the cyberpunk-style and setting, plus the focus on fast, parry-heavy brawler action gives ReBlade a different flavor and perspective than its contemporaries. However, the overall narrative, at least as far as I can tell from this demonstration, is fairly light. It mostly relies on vibes and environmental storytelling to sell the setting and the protagonist\u0026#39;s motivations. That\u0026#39;s not necessarily a major negative, and the visual style and tone certainly helps ground ReBlade. However, after several runs, it still left me wanting more context and reasons to invest in the journey.\u003c/p\u003e\u003ch3\u003eCyber-City Dungeon Crawl\u003c/h3\u003e\u003cp\u003eReBlade really puts its weight on the core action of its many runs. Starting in the lower rungs of the megacity, you fight everything from lowly machine drones to hulking bruisers lurking on different floors. The action flows akin to other isometric top-down action-brawlers like Hades, and it does a good job of conveying the fast pace of combat. Using combo attacks, sub-weapon skills, buffs, and that all-important parry, I cut my way past enemy defenses. Landing a series of deflects is very satisfying, and it\u0026#39;s especially cool to rapidly deflect enemy blaster shots back at surrounding enemies. Seriously, it felt immensely fun to pull off lightning-fast parries like this one during my different runs.\u003c/p\u003e\u003csection data-transform=\"slideshow\" data-slug=\"reblade-the-death-spiral-first-screenshots\" data-value=\"reblade-the-death-spiral-first-screenshots\" data-type=\"slug\" data-caption=\"\"\u003e\u003c/section\u003e\u003cp\u003eEven with the low-level gear you’re issued with at the start, ReBlade\u0026#39;s combat fundamentals really do give you a sense of style and mastery when fighting enemies. I mostly stuck with the standard sword, which offers a balance of speed and power that I tend to favor, but I also had fun with the speedy twin blades and the heavier axe-and-shield combo. The action is further heightened by the more advanced weapons you\u0026#39;ll find in dungeons and at various shops along the way. You can even swap certain buffs and perks between your gear to improve a favorite weapon found during a run. Tapping further into the cyberpunk angle, your protagonist can also augment themselves with different chips which add special modifiers to attacks, such as amplifying elemental damage or boosting recovery.\u003c/p\u003e\u003cp\u003eIn an interesting change of pace from more linear roguelites, ReBlade lets you choose which path you want to take through its world. For each layer of the city, you\u0026#39;re given choices about which areas to hit up, most of which are only available for a limited time before they disappear. This progression style let me focus on which weapon or performance upgrades and resource-gathering stages I wanted to pursue first. I really appreciated having a bit of choice in what loot I wanted, especially when I needed to save up cash before heading to one of the few shops that appear on the map. \u003c/p\u003e\u003csection data-transform=\"quoteBox\"\u003eWhile I like the ReBlade\u0026#39;s focus on core action, I still felt some aspects of the roguelite structure were a bit underbaked and not fully realized as of this time, at least in this section of the game.\u003c/section\u003e\u003cp\u003eReBlade\u0026#39;s combat really kicks into high gear during the boss encounters, which put the offense and defensive skills you\u0026#39;ve cultivated throughout a run to the test. These bosses blend cybernetic warlords and Chinese mythology, making the battles feel like the game is walking a fine line between a high-fantasy martial arts epic and a hard sci-fi action movie. I was really impressed by each boss\u0026#39;s look and the design surrounding each battle; it delivered a showstopping finish to each layer. My favorite was a mysterious, wraith-like cyborg known as The Black, who fought like a cyber-enhanced grim reaper.\u003c/p\u003e\u003cp\u003eWhile I enjoyed ReBlade\u0026#39;s spectacle and fast action, I found the demo sometimes felt a bit too generous. I didn\u0026#39;t have much trouble getting through the two layers, especially when I found some great weapons that helped me clear enemies quickly. Moreover, you\u0026#39;re also given a set of extra lives to help with runbacks on tougher challenges – which is very rare to see in a roguelite. While I like the ReBlade\u0026#39;s focus on core action, I still felt some aspects of the roguelite structure were a bit underbaked and not fully realized as of this time, at least in this section of the game.\u003c/p\u003e\u003cp\u003eStill, this early demo offered some slick fights to dive into. With an eye-catching setting and seriously satisfying combat and parry action, developer ChillyRoom\u0026#39;s cyberpunk roguelite concept shows solid promise as an action-RPG. While I hope ReBlade: The Death Spiral showcases a much deeper side in the full game, this early demo gets its stylized, grim world off to a solid start, and it\u0026#39;s already got me ready to deflect and whittle down the cyborg opposition.\u003c/p\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003eWhile you\u0026#39;re here, check out these recent previews of other big upcoming games we\u0026#39;ve checked out recently!\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003ca href=\"https://www.ign.com/articles/the-legend-of-zelda-ocarina-of-time-remake-is-more-different-than-you-think-ign-preview\"\u003eThe Legend of Zelda: Ocarina of Time Remake\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.ign.com/articles/phantom-blade-zero-might-be-this-years-most-stylish-action-game-ign-preview\"\u003ePhantom Blade Zero\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.ign.com/articles/exodus-plays-exactly-how-a-new-mass-effect-should-ign-hands-on-preview\"\u003eExodus\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003csection data-transform=\"divider\"\u003e\u003c/section\u003e\u003cp\u003e\u003cem\u003eAlessandro Fillari is a longtime games media professional. Talk video games with him on BlueSky at \u003c/em\u003e\u003ca href=\"https://bsky.app/profile/afillari.bsky.social\"\u003e@afillari.bsky.social\u003c/a\u003e\u003cem\u003e.\u003c/em\u003e\u003c/p\u003e\u003c/section\u003e","showCommerceDisclaimer":false,"showArticlePaywall":false,"review":null,"articleId":"0c4e2a09-d048-427f-b733-c6844bfb6f5c","isCommunity":"no","resource":"article","pageType":"article","twitterCard":"summary_large_image","hasAds":true,"extraAds":false,"isPreview":false,"pageTitle":"ReBlade: The Death Spiral First Preview – Parrying Through the Cyberpunk Roguelite","image":"https://assets-prd.ignimgs.com/2026/10/20/reblade-preview-blogroll-1792515184243.jpg?width=1280\u0026format=jpg\u0026auto=webp\u0026quality=80","description":"With an eye-catching setting and seriously satisfying combat and parry action, developer ChillyRoom's cyberpunk roguelite concept shows solid promise as an action-RPG.","category":"Preview","categories":["Preview"],"objectId":"6c871bbc-4691-47be-a830-a85b2e3d30d9","objectSlug":"reblade-the-death-spiral","videoSeries":null,"genreSlugs":["action","rpg","roguelike"],"platforms":["PC"],"platformSlugs":["pc"],"editPage":{"type":"article","params":{"id":"0c4e2a09-d048-427f-b733-c6844bfb6f5c"}},"additionalDataLayer":{"content":{"contentId":"0c4e2a09-d048-427f-b733-c6844bfb6f5c","objectIds":["6c871bbc-4691-47be-a830-a85b2e3d30d9"]}},"commercePage":false,"articleType":"Article","hrefLangs":{"x-default":"https://www.ign.com/articles/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en":"https://www.ign.com/articles/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-us":"https://www.ign.com/articles/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-za":"https://za.ign.com/reblade-the-death-spiral/243814/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","zh":"https://www.ign.com.cn/reblade-the-death-spiral/63654/ignlou-yi-zhi-cheng-shang-shou-qian-zhan-zai-sai-bo-peng-ke-roguelite-zhong-dan-fan-yi-qie","en-in":"https://in.ign.com/reblade-the-death-spiral/274983/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-se":"https://nordic.ign.com/reblade-the-death-spiral/114521/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-pk":"https://pk.ign.com/reblade-the-death-spiral/262909/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-sg":"https://sea.ign.com/reblade-the-death-spiral/250709/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite","en-my":"https://sea.ign.com/reblade-the-death-spiral/250709/reblade-the-death-spiral-first-preview-parrying-through-the-cyberpunk-roguelite"},"schema":[{"@context":"http://schema.org/","mainEntityOfPage":{"@type":"WebPag
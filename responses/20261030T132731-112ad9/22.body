							var StoreDefaults = {"PartnerEventStore":[{"gid":"679637761984039523","clan_steamid":"103582791475358543","event_name":"Coming Soon: updated Demo for Steam Next Fest!","event_type":28,"appid":3727090,"server_address":null,"server_password":null,"rtime32_start_time":1791548820,"rtime32_end_time":1791551700,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Here's everything you need to know about it\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"431ada503666712a1e7dbdb78bd3648f26a31316.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c386575bda51dbd6c944d2f5f17fae606ee9c7d3.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679637761984039524","clanid":"45837135","posterid":"0","headline":"Coming Soon: updated Demo for Steam Next Fest!","posttime":1791548147,"updatetime":1791802146,"body":"[p]Hey everyone, we have big news today: [\/p][p][\/p][p][b]Horses of Hoofprint Bay will be participating in Steam Next Fest (Oct 19-26) with an updated Demo!\u00a0[\/b]\n[\/p][p]What you need to know:\u00a0[\/p][p][b]1\ufe0f\u20e3The October Demo will remain limited to 25 days of playtime.[\/b]\u00a0[\/p][p]2\ufe0f\u20e3The October Demo will more closely represent the first 25 days of the \u201cactual\u201d game: Due to the rebalancing we\u2019ve done, that means you will start with a horse that has much lower stats, and you will most likely not be able to progress quite so far.\u00a0[\/p][p]3\ufe0f\u20e3The October Demo will contain various new features such as walking your horse (with\/without foals), Caprilli tests, new Trail ride environments, desensitization training, face markings and appaloosa patterns.\u00a0[\/p][p]4\ufe0f\u20e3Because the new Demo contains all the changes made to the game in the past months, save games from the October Demo WILL be compatible with the full game upon release. Save games from the February Demo will NOT be made compatible.\u00a0[\/p][p]5\ufe0f\u20e3The February Demo will stay available on a separate Steam branch. You will remain able to access and play it by switching branches on Steam: Once the new Demo is out, right-click on the game in your library and select Properties. Select Game Versions and Betas and then select February Demo to access the old Demo.\u00a0[\/p][p]6\ufe0f\u20e3The Demo (February and October) will stay available after the full game releases, so anyone hesitant to buy can still get a taste of the game before purchasing.\u00a0[\/p][p][\/p][p]The Steam Next Fest is an important way for us to reach more people before release. Our visibility in the Festival will depend on the game\u2019s performance during the first 1-2 days (how many people play it and for how long), so we invite everyone to spend some time playing the updated October Demo when the festival begins, to help us get more visibility!\u00a0 [\/p][p]In order to make sure everything in the new demo works as expected, we\u2019ll be inviting a new batch of playtesters very soon, who will get access to the October Demo in advance. [\/p][p][\/p][p]One additional heads up: Between the Next Fest demo and the release on November 4th, we'll have very little time for further improvements and fixes. We'll need to strictly prioritize what is still feasible, even though we're sure you'll find some bugs and make some very cool suggestions. Even so, we hugely appreciate anyone taking the time to send us feedback and bug reports, because that will give us a good overview of what needs to be addressed urgently. [\/p][p][\/p][p]We're VERY excited for all of you to see everything we've been working on and give it a try for yourself \ud83d\ude0d[\/p]","commentcount":12,"tags":["mod_reviewed","ModAct_1434411615_1791548455_0","ModAct_773020726_1791803643_4"],"language":0,"hidden":0,"forum_topic_id":"583936269909000915","event_gid":"679637761984039523","voteupcount":191,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791548820,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"583936269909000915","rtime32_last_modified":1793307072,"news_post_gid":"0","rtime_mod_reviewed":1791803643,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791547557,"votes_up":191,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"664969988086506364","gidfeature2":"583936269909000915"},{"gid":"704403121118381116","clan_steamid":"103582791475358543","event_name":"Out Now: Release Date Reveal Trailer","event_type":28,"appid":3727090,"server_address":null,"server_password":null,"rtime32_start_time":1787313600,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Watch our latest Trailer right here! \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"5f6709efbded6af8880b74ba0ffe1deacb6491ef.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"5e0b8c05f4aeefbf3e9a0b5c4ea1e701da47dd94.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"704403121118381117","clanid":"45837135","posterid":"0","headline":"Out Now: Release Date Reveal Trailer","posttime":1787313631,"updatetime":1787314123,"body":"[p]We\u2019re thrilled to finally share the release date for Horses of Hoofprint Bay! See for yourself in our brand new Release Date Reveal Trailer right here:\u00a0[\/p][previewyoutube=\"Hh-NAZQaw4U;full\"][\/previewyoutube][p]And so we don\u2019t keep the information for anyone unable to watch a video right now: the game is scheduled to release on [b]November 4th 2026[\/b]!\u00a0\u00a0[\/p][p]We still have plenty to do until then \u2013 from testing, balancing and bugfixing to adding and refining some additional content \u2013 but we are confident that we\u2019ll have a good version of this game ready for you all by November 4th!\u00a0[\/p][p]The game will go straight into a full release, no Early Access, no feature addition roadmaps. We\u2019ll of course keep a close eye on people\u2019s experiences at launch to make sure everything is working as intended and fix bugs as necessary, but for the most part, we want to release a finished game and not promise any major updates beyond that.\u00a0[\/p][p]If you\u2019re interested in what\u2019s been changing since the Demo version, take a look at our latest [url=\"https:\/\/store.steampowered.com\/news\/app\/3727090\/view\/714534951362494572?l=english\"]Dev Update right here[\/url]: With the recent addition of Cross Country Competitions, Desensitization Training, Horse Personality Traits and more, there are quite a few cool new things to look forward to at release!\u00a0[\/p][p]And one more thing: [b]we\u2019ll be at[\/b] [b]Gamescom in Cologne next week[\/b]! If you are nearby, make sure to come say Hello at the Games Bavaria booth E-051g in Hall 10.2, to try the latest version of Horses of Hoofprint Bay with our super cool home-made Saddle Controller[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45837135\/48c2bcce0ba35b6523edd8986b99ab4f9cda0f13.png\"][\/img][\/p]","commentcount":11,"tags":["mod_reviewed","ModAct_1434411615_1787314850_0"],"language":0,"hidden":0,"forum_topic_id":"585057730992279573","event_gid":"704403121118381116","voteupcount":153,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1787313600,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"585057730992279573","rtime32_last_modified":1793252599,"news_post_gid":"0","rtime_mod_reviewed":1787314850,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1787310920,"votes_up":153,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"664969988086506364","gidfeature2":"585057730992279573"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["679637761984039524","704403121118381117"],"last_update_event":[]}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<h2 class="bb_tag" ><strong>Your very own barn </strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/fb2edcf2ea4b30dde3e73f01fd95bedf.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/fb2edcf2ea4b30dde3e73f01fd95bedf.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/fb2edcf2ea4b30dde3e73f01fd95bedf.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >You’ve finally saved up the money to get a plot of land with a run-down shack of a stable – It’s not much but it’s yours. Time for you and your trusted mare to start training, so you can participate in tournaments in the nearby town and grow your ramshackle yard into the stud farm of your dreams!</p><h2 class="bb_tag" ><strong>Take Care of your Horse(s)</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/91adc8899f30e9036008a14afa60c793.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/91adc8899f30e9036008a14afa60c793.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/91adc8899f30e9036008a14afa60c793.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >Groom and comb your horses in crisp, satisfying care interactions that are grounded in realism without being tedious. Use your brush and hoofpick to avoid saddle sores and abscesses, and treat scrapes and injuries appropriately when they happen. </p><h2 class="bb_tag" ><strong>Train, Compete, Explore</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/27c7b762caf9061030cd5525959b1e23.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/27c7b762caf9061030cd5525959b1e23.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/27c7b762caf9061030cd5525959b1e23.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >Complete training exercises and build up your horse’s strength and confidence to qualify for competitions and earn prize money in show jumping and cross country. Take your horses out on trail rides for a change of pace and scenery – Whether it's in the forest, along the beach or through the mountains, you get to enjoy beautiful vistas and you never know what you might find along the way!</p><h2 class="bb_tag" ><strong>Breed &amp; Evolve</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/6940656b2366d75bd3718a61e17b125a.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/6940656b2366d75bd3718a61e17b125a.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/6940656b2366d75bd3718a61e17b125a.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >Breed adorable foals to improve your stock over time. Foals will inherit a mix of their parents' coloring, white patterns and even personality traits. Carefully plan your stallion and mare pairings to bring out the best in your offspring, whether you’re going for looks or stats.</p><h2 class="bb_tag" ><strong>Upgrade &amp; Manage </strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/f1b24f9ca063bced93f0631ac2c2d7f4.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/f1b24f9ca063bced93f0631ac2c2d7f4.webm?t=1792750123" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" >Save up for upgrading your buildings to make space for more horses and better meeting their needs. Hire staff to stay on top of care and training for a growing herd. Advanced building stages will unlock new training courses, staff applications and a high tech breeding station lab allows you to preview possible foals and sell more stud services. </p><h2 class="bb_tag" ><strong>Learn about the game and real horses</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/1338dbba537d7e783f1e23056acf8c03.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/1338dbba537d7e783f1e23056acf8c03.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/1338dbba537d7e783f1e23056acf8c03.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >Horses of Hoofprint Bay is made by three horse girls who care a lot about these animals. While not every aspect of the game is completely realistic, we strive to be accurate and educational in every way that doesn’t compromise gameplay fun. An in-game library contains a lot of relevant equestrian knowledge about in-game and real life horses!</p><h2 class="bb_tag" ><strong>Customize and Modify</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/c8c3a5bb94478bbaf9702ce127aa8a71.poster.avif?t=1792750123" width=900 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/c8c3a5bb94478bbaf9702ce127aa8a71.webm?t=1792750123" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3727090/extras/c8c3a5bb94478bbaf9702ce127aa8a71.mp4?t=1792750123" type="video/mp4"></video></span></p><p class="bb_paragraph" >Edit the appearance of your character and tack items with built-in color picking tools, or even modify the game files to your liking to create custom color palettes. Whether you prefer sticking to a curated selection of available customization items and color combos, or want to start digging into easily accessible textures and text files to alter the appearance of horses and characters is entirely up to you.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>This game is made entirely by humans without the assistance of generative AI.</i> </p>						</div>
					</div>
				
				
				

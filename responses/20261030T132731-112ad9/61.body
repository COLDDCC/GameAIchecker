get up to all sorts of nonsense.[\/p][h2][\/h2][h2]What's the deal??[\/h2][p]During our community playtests and streamed showcases, you can expect:[\/p][list][*][p]Questing![\/p][\/*][*][p]Fishing![\/p][\/*][*][p]Gambling??[\/p][\/*][*][p]Drinking some tasty brews[\/p][\/*][*][p]Inhaling unknowable substances...[\/p][\/*][*][p]Fighting Goblins!![\/p][\/*][\/list][p]Seriously though, you should swing by and see what Debauchery & Magic is all about.[\/p]","commentcount":4,"tags":["workshop","mod_reviewed","ModAct_487176015_1792023041_0"],"language":0,"hidden":0,"forum_topic_id":"572677904481217591","event_gid":"669505296465396207","voteupcount":35,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572677904481217591","rtime32_last_modified":1792966623,"news_post_gid":"0","rtime_mod_reviewed":1792023042,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792021556,"votes_up":35,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"572677904481217590","gidfeature2":"572677904481217591"},{"gid":"680765564125185804","clan_steamid":"103582791475418059","event_name":"Alpha 0.0.75 \u2014 Smoother Adventures & Everyday Fixes","event_type":12,"appid":4189120,"server_address":null,"server_password":null,"rtime32_start_time":1793318220,"rtime32_end_time":1793322001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Controller recovery, safer dungeon transitions, animation fixes and dungeon polish.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Better controller recovery, cleaner dungeon travel, inventory and recycler fixes, improved animations, and a targeted first-hit loading fix.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"bd36d9fbae6c9b868e2d89efaaf73d00f5d9c324.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6cdc7cd426e933fa483ededc2d3614bd6a8221b8.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"680765564125185805","clanid":"45896651","posterid":"0","headline":"Alpha 0.0.75 \u2014 Smoother Adventures & Everyday Fixes","posttime":1793318264,"updatetime":1793318264,"body":"Alpha 0.0.75 focuses on smoother everyday play: better controller recovery, cleaner dungeon transitions, animation fixes, and a collection of inventory, combat and dungeon improvements. Here\u2019s what\u2019s changing since Alpha 0.0.74.\n\n[h1]The highlights[\/h1]\n[list]\n[*][b]Leave the old interaction behind:[\/b] dungeon travel now cleans up fishing and other active interactions so old menus and input locks don\u2019t follow you into the next area.\n[*][b]Better controller recovery:[\/b] improved recovery after reconnecting a controller or returning focus to the game.\n[*][b]More natural movement:[\/b] corrected consumable, mounted weapon and sitting poses, plus skateboard trick scoring fixes.\n[*][b]Everyday fixes:[\/b] addressed a stash duplication issue, recycler progress interruptions and inventory selection problems.\n[\/list]\n\n[hr][\/hr]\n[h1]Performance & Combat[\/h1]\n[list]\n[*]Moved elemental matchup-data loading into startup preparation instead of loading it on the first combat hit. This targets a reported first-hit freeze; it is not a general FPS or first-equip performance claim.\n[*]Added elemental indicators to damage numbers, including neutral, strong and weak matchup variants.\n[\/list]\n\n[h1]Dungeon Travel & Interactions[\/h1]\n[list]\n[*]Added fishing interruption when dungeon travel relocates your character, clearing the fishing presentation and preventing old cast messages from reopening the fishing menu or leaving movement blocked.\n[*]Added travel cleanup for dialogue, shops, crafting, upgrading, stash access, painting, resource gathering and table\/gambling interactions. Late replies from the previous interaction are rejected, and cleanup releases the camera\/input locks owned by that interaction.\n[*]Protected the painting window from late updates belonging to a canvas you have already left.\n[*]Preserved completed catch rewards and completed transactions during cleanup.\n[\/list]\n\n[h1]Inventory, Recycler & Controls[\/h1]\n[list]\n[*]Fixed Norwedenpower stash transfers that could appear to duplicate the item, with item identity and indivisible-transfer handling corrected.\n[*]Preserved completed recycler cycles while the output is full, so collecting output does not restart work that has already finished.\n[*]Fixed inventory selection repeatedly scrolling while mouse input should own the selection.\n[*]Fixed inventory slot click sounds continuing after closing the inventory.\n[*]Improved controller input recovery after reconnecting, regaining window focus and returning from overlays, with protection against held inputs carrying into a new context.\n[*]Beer items now display remaining uses out of their maximum uses.\n[*]Relaxed character and game-name filtering to allow ordinary profanity while retaining the existing slur and other prohibited-term protections.\n[\/list]\n\n[h1]Animations, Mounts & Skateboarding[\/h1]\n[list]\n[*]Improved how cigarette, beer and mushroom gestures blend with locomotion, including swimming, instead of overriding the upper-body pose unnecessarily.\n[*]Mushrooms can now be consumed while riding mounts or skateboarding, alongside the other supported consumables.\n[*]Disabled the weapon\u2019s left-arm grip IK while mounted to prevent distorted or missing-looking arms.\n[*]Preserved authored spine poses during emotes, addressing the backward-leaning sitting pose.\n[*]Fixed spinning ollie-grab rotation attribution when releasing the grab, including missing degrees and incorrect separate spin scoring.\n[*]Fixed stale movement being restored after Unstuck prediction correction, addressing the falling\/sprinting speed exploit.\n[\/list]\n\n[h1]Dungeons & World Polish[\/h1]\n[list]\n[*]Improved recovery for enemies embedded in geometry when a navigation triangle still exists beneath them, addressing the Crypt stair trapping case.\n[*]Patched holes in a Goblin Cave parkour room.\n[*]Added a clearer sign at the Crypt entrance.\n[*]Reduced puzzle rune-entry totem hitboxes to prevent overlapping interaction targets.\n[\/list]\n\n[h1]Menus & Online Sign-in[\/h1]\n[list]\n[*]Fixed delayed menu-scene loads leaving main-menu visuals active over the world after entering gameplay.\n[*]Improved online sign-in error messages so an unexpected server response or service refusal is not incorrectly presented as an internet-connection problem. This improves diagnosis; it does not bypass or repair service-side authentication failures.\n[\/list]\n\n[hr][\/hr]\n[b]Multiplayer reminder:[\/b] everyone joining a session needs the updated build. Update both host and clients, then start a fresh hosted session.\n\nThank you to everyone sending us reports, logs and clips. They help us track down the awkward interactions and hard-to-reproduce issues that are easy to miss in testing.\n\n[b]Please keep the reports and suggestions coming. See you in Debauchery & Magic![\/b]\n\n[img]{STEAM_CLAN_IMAGE}\/45896651\/f47febc0f5f89dfa3003519b9363d25206a638d2.gif[\/img]","commentcount":3,"tags":["patchnotes","mod_reviewed","ModAct_1447510170_1793318984_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173178567","event_gid":"680765564125185804","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173178567","rtime32_last_modified":1793332471,"news_post_gid":"0","rtime_mod_reviewed":1793318985,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793313502,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"572677904481217590","gidfeature2":"571553273173178567"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["669505296465396208"],"last_update_event":{"rtime":1793318220,"event_gid":"680765564125185804","announcement_gid":"680765564125185805","clan_account_id":45896651}}};
						</script>
					


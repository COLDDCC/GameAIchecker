							var StoreDefaults = {"PartnerEventStore":[{"gid":"705534184444133882","clan_steamid":"103582791475597499","event_name":"Too Deep to Quit - Update 1.1.0 is coming to Steam Next Fest!","event_type":14,"appid":4182190,"server_address":null,"server_password":null,"rtime32_start_time":1792169340,"rtime32_end_time":1792173601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"922b17799fc1303541982be347a85fdf49e86d00.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"54cec60c0ea862aed25c9d858ed3f982ffabaff2.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"705534184444133883","clanid":"46076091","posterid":"0","headline":"Too Deep to Quit - Update 1.1.0 is coming to Steam Next Fest!","posttime":1792169395,"updatetime":1792169395,"body":"[p]Hey fellow adventurers![\/p][p][\/p][p]We're participating in Steam Next Fest! and we're bringing a major update with us.[\/p][p]We've been listening closely to your feedback, and Update 1.1.0 brings a major overhaul to [i]Too Deep to Quit[\/i]. We've reworked core gameplay systems, redesigned parts of the experience, introduced new items, and made significant improvements across the board.[\/p][p]Thank you for all your feedback and support! Your comments help us understand what needs to change and how we can make the game better.[\/p][p]Already played [i]Too Deep to Quit[\/i]? We'd love to welcome you back to try the new version! We've made many changes based on player feedback, and we're eager to hear whether you enjoy the new experience.[\/p][p][\/p][h2]GAMEPLAY OVERHAUL[\/h2][p]We've reworked the core gameplay to create a more challenging and engaging experience.[\/p][p]- Reworked gameplay systems and overall game balance.[\/p][p]- Reduced player health and increased trap and enemy damage.[\/p][p]- Reworked piranha behaviour to make encounters more challenging.[\/p][p]- Adjusted character movement speed to better fit the game's pacing.[\/p][p]- Added the ability to pick up and throw teammates.[\/p][p]- All players must now reach the next room to unlock the way forward.[\/p][p][\/p][h2]LEVEL DESIGN[\/h2][p]- Reworked level design to improve the overall gameplay experience.[\/p][p]- Reviewed colliders and fixed out-of-bounds issues.[\/p][p][\/p][h2]SHOP REWORK[\/h2][p]The statue offering system has been replaced with a shop where you can exchange treasures for useful equipment.[\/p][p]- Reworked the offering system into a treasure-trading shop.[\/p][p]- Added new power-ups and items to purchase.[\/p][p][\/p][h2]ITEMS & EQUIPMENT[\/h2][p]- Defibrillator: Teammates can now only be revived using a Defibrillator or a campfire.[\/p][p]- Cursed Treasures: New high-value treasures that come with additional risks, offering an extra challenge for adventurers.[\/p][p]- Updated the map to make information easier to read.[\/p][p]- Removed the Grappling Hook and curse consumables.[\/p][p][\/p][h2]UX & QUALITY OF LIFE[\/h2][p]- Added end-of-run statistics and a recap of your expedition.[\/p][p]- Treasures now display their value in gold.[\/p][p]- Healing items now display the amount of health they restore.[\/p][p]- Added a postcard introducing the game's narrative.[\/p][p]- Added more accessibility options.[\/p][p]- Improved the overall user experience and interface.[\/p][p][\/p][h2]SOUND & MUSIC[\/h2][p]- Enhanced and rebalanced the overall sound design.[\/p][p]- Added contextual music for the Jungle, Cave, Temple, and Action sequences.[\/p][p][\/p][h2]COSMETICS[\/h2][p]- Added a new bob-cut hairstyle.[\/p][p][\/p][h2]PERFORMANCE[\/h2][p]- Various GPU, CPU, and network optimizations to improve performance.[\/p][p][\/p][h2]THANK YOU FOR YOUR FEEDBACK![\/h2][p]Update 1.1.0 reflects the feedback you've shared with us, and we're committed to continuing to improve [i]Too Deep to Quit[\/i] alongside our community.[\/p][p]If you've played the game before, come back during Steam Next Fest and give the new version a try! We'd love to hear what you think about the changes, what feels better, and what we can still improve.[\/p][p]If you're discovering the game for the first time, welcome to the adventure![\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1607812438_1792171211_0"],"language":0,"hidden":0,"forum_topic_id":"565922740068969139","event_gid":"705534184444133882","voteupcount":29,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565922740068969139","rtime32_last_modified":1793043527,"news_post_gid":"0","rtime_mod_reviewed":1792171211,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792164289,"votes_up":29,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"807973945275903206","gidfeature2":"565922740068969139"},{"gid":"699903960312447945","clan_steamid":"103582791475597499","event_name":"Too Deep To Quit Demo out NOW!!!","event_type":31,"appid":4182190,"server_address":null,"server_password":null,"rtime32_start_time":1791475860,"rtime32_end_time":1792081801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Adventure calls!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"65cde186f467780ad6ae4f7ce2be1b7952959944.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"1092c35fb8f8eecc5893cb74cf64efdf31c20365.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"699903960312447946","clanid":"46076091","posterid":"0","headline":"Too Deep To Quit Demo out NOW!!!","posttime":1791475906,"updatetime":1791475906,"body":"[p]Start your journey by venturing into the depths of the jungle. Explore the first biome, push through dense vegetation, and uncover the path that leads deeper into the unknown. [\/p][p][\/p][p]But this is only the beginning! Somewhere deep within the jungle, an ancient temple awaits ![\/p][p][\/p][p][url=\"https:\/\/store.steampowered.com\/app\/4677170\/\"]GET THE DEMO HERE[\/url][\/p][p][url=\"https:\/\/discord.gg\/cf5a7ruWFt\"]GIVE US FEEDBACK HERE[\/url] on our Discord server![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46076091\/512a238184f5e337dddf28c8584022aa536142bc.gif\"][\/img][\/p]","commentcount":7,"tags":["mod_reviewed","ModAct_871423085_1791478016_0"],"language":0,"hidden":0,"forum_topic_id":"583936269908914613","event_gid":"699903960312447945","voteupcount":38,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"583936269908914613","rtime32_last_modified":1792025852,"news_post_gid":"0","rtime_mod_reviewed":1791478016,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791446556,"votes_up":38,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"807973945275903206","gidfeature2":"583936269908914613"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["705534184444133883","699903960312447946"],"last_update_event":{"rtime":1792169340,"event_gid":"705534184444133882","announcement_gid":"705534184444133883","clan_account_id":46076091}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/567822ac247b20192c4d0ff9be3001c7.poster.avif?t=1791531119" width=616 height=278 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/567822ac247b20192c4d0ff9be3001c7.webm?t=1791531119" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/567822ac247b20192c4d0ff9be3001c7.mp4?t=1791531119" type="video/mp4"></video></span></p><p class="bb_paragraph" ><strong>Too Deep To Quit</strong> is a 1-4 player co-op survival exploration game. Gather your team of adventurers, brave the dangers of cursed temples, and claim the ultimate treasure.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" > </p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/d1c0772b7b1cc2c4946ea58fea9bd3cb.avif?t=1791531119" width=616 height=83 /></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/cbde07d5155d2cb67e61131932a956c2.poster.avif?t=1791531119" width=616 height=278 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/cbde07d5155d2cb67e61131932a956c2.webm?t=1791531119" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/cbde07d5155d2cb67e61131932a956c2.mp4?t=1791531119" type="video/mp4"></video></span></p><p class="bb_paragraph" >A true adventurer knows how to improvise. These cursed temples hold a lot more than just gold, they’re packed with the leftovers of the poor saps who came before you. Check every dark corner for whatever keeps you breathing.</p><p class="bb_paragraph" style="text-align: center"> </p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/a81c931ee64232efb85aaf490bfca7a5.avif?t=1791531119" width=616 height=83 /></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/fe1c7e2061a728ae83618c7f6d128ef1.poster.avif?t=1791531119" width=616 height=278 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/fe1c7e2061a728ae83618c7f6d128ef1.webm?t=1791531119" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/fe1c7e2061a728ae83618c7f6d128ef1.mp4?t=1791531119" type="video/mp4"></video></span></p><p class="bb_paragraph" >Sure, starving to death is bad, but getting squashed by the walls is definitely worse. Every hallway is a literal death trap waiting for the clumsy guy in your squad to mess up.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/85994961aa516d1b0e369e65e561c963.avif?t=1791531119" width=616 height=83 /></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/2f0b9ab5af0df08f2e596d9507953b66.poster.avif?t=1791531119" width=616 height=278 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/2f0b9ab5af0df08f2e596d9507953b66.webm?t=1791531119" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/2f0b9ab5af0df08f2e596d9507953b66.mp4?t=1791531119" type="video/mp4"></video></span></p><p class="bb_paragraph" >If the traps don’t get you, the locals will. These forgotten temples are the perfect breeding ground for anything that slithers, stings, or bites. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/a217414723493305c4d991fadc06415a.avif?t=1791531119" width=616 height=83 /></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/8d1e2c3c807a8965b90395f87211173c.poster.avif?t=1791531119" width=616 height=278 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/8d1e2c3c807a8965b90395f87211173c.webm?t=1791531119" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4182190/extras/8d1e2c3c807a8965b90395f87211173c.mp4?t=1791531119" type="video/mp4"></video></span></p><p class="bb_paragraph" >It belongs in a museum... but it’ll look way better in your bank account. Deep within these ruins lie priceless artifacts and solid gold idols just waiting to be claimed.</p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
				<div class="sysreq_contents">
							<div class="game_area_sys_req sysreq_content active" data-os="win">
											<div class="game_area_sys_req_leftCol">

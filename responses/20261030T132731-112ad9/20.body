zed_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":true,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_community\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[\"83520f924ae3ca37610aca319655ad8a2dd758b6.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[\"efc57ca864266a221baaa54c8fc46451ac6f3ad0.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[114172898],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"714541292743296356","clanid":"46083003","posterid":"0","headline":"Steam Next Fest Starts Today - Hellforged Is In!","posttime":1792408328,"updatetime":1792408384,"body":"[p][b]Hey Hellforgers![\/b][\/p][p]Steam Next Fest kicks off today, and [b]Hellforged is part of the lineup![\/b] Jump into our updated demo, meet [b]Yllarion, the Arrok Hunter[\/b], and take the fight beneath the ruins.[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4692610\/Hellforged_Demo\/\"][\/dynamiclink][\/p][h3]A new hunter, here for a limited time[\/h3][p]Yllarion is available as part of a [b]special two-week appearance in the demo, ending October 29[\/b]. Line up enemies with [b]Broadhead Shot[\/b], unleash a barrage with [b]Rapid Fire[\/b], and lead the horde straight into [b]Hunter\u2019s Snare[\/b].[\/p][p]Try new builds, find your favourite combinations, and see how far you can push him in the Undercrypt. After October 29, the demo returns to its two-character roster as we focus on preparing Hellforged for launch.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46083003\/c169e1095768a61e7153ae7c27a6ab21eab34965.png\"][\/img][\/p][h3]Explore the updated demo[\/h3][p]Alongside our newest hero, you\u2019ll find [b]hand-drawn icons throughout the game[\/b] and [b]lore books[\/b] to discover during your runs. Bring those journals back to camp and uncover more about the world\u2014and what happened beneath the ruins.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46083003\/09610463d59589030f9fdcfe441004a9a4fe9c44.png\"][\/img][\/p][p][\/p][h3]Help us make some noise![\/h3][p]We\u2019d love your help pushing [b]Hellforged among the top demos at Next Fest[\/b]. If you enjoy your time in the Undercrypt, [b]tell a friend, share a clip, or let your favourite creator know about the game[\/b]. Every recommendation helps more players discover Hellforged.[\/p][p]And keep the feedback coming! Share your builds and let us know what you think on [b]Discord or in the Steam Community[\/b]. Your feedback helps us make the game better.[\/p][p][url=\"https:\/\/store.steampowered.com\/app\/4692610\/Hellforged_Demo\/\"][b]Play the updated demo[\/b][\/url][b], give Yllarion a try before October 29, and wishlist Hellforged to support us![\/b][\/p][p]\nSee you in Hell.[\/p][p][i][b]The MoonPyre & Grindstone Teams[\/b][\/i][\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1889321037_1792415033_0"],"language":0,"hidden":0,"forum_topic_id":"565922930124487708","event_gid":"714541292743296355","voteupcount":59,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565922930124487708","rtime32_last_modified":1793310447,"news_post_gid":"0","rtime_mod_reviewed":1792415033,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792402398,"votes_up":59,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"807975131067624658","gidfeature2":"565922930124487708"},{"gid":"714541292743295373","clan_steamid":"103582791475604411","event_name":"The Next Fest Demo Update Is Live! Play Yllarion Now","event_type":28,"appid":4554250,"server_address":null,"server_password":null,"rtime32_start_time":1792068240,"rtime32_end_time":1792068540,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"682c1222b65783c7b6c7ee8bfa68bc176c3991d9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b9655bf3841f1366b88a52244c37e3cc592b1d7b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"714541292743295374","clanid":"46083003","posterid":"0","headline":"The Next Fest Demo Update Is Live! Play Yllarion Now","posttime":1792068255,"updatetime":1792068261,"body":"[p][b]Hey Hellforgers![\/b][\/p][p]Why wait until Monday? Our Steam Next Fest demo update is [b]live now[\/b], giving you a head start with our newest hero, [b]Yllarion, the Arrok Hunter![\/b][\/p][p]Steam Next Fest kicks off on [b]October 19[\/b], but you can jump in today, try his abilities, and start putting together some new builds.[\/p][h3]Meet your new hunter[\/h3][p]Line up enemies with [b]Broadhead Shot[\/b], unleash a barrage of arrows with [b]Rapid Fire[\/b], and lure the horde into [b]Hunter\u2019s Snare[\/b]. Yllarion brings a new way to tackle the Undercrypt, and we would love to see what you can do with him.[\/p][p][b]Yllarion will be playable in the demo for the next two weeks.[\/b] After that, the demo will return to its two-character roster as we focus on preparing Hellforged for launch. Make sure to give him a try while he is here![\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46083003\/c169e1095768a61e7153ae7c27a6ab21eab34965.png\"][\/img][\/p][h3]More to discover[\/h3][p]This update also brings:[\/p][list][*][p][b]Hand-crafted icons:[\/b] Every previously AI-generated icon has now been replaced with hand-drawn artwork. Hellforged no longer contains any AI-generated content.[\/p][\/*][*][p][b]Lore books:[\/b] Find journals during your runs and read them back at camp to uncover more about the world and what happened beneath the ruins.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/46083003\/09610463d59589030f9fdcfe441004a9a4fe9c44.png\"][\/img][\/p][h3]Play it, tell us what you think, and spread the word![\/h3][p]Your feedback helps us shape Hellforged. Let us know how Yllarion feels, share your builds, and tell us what could be better on [b]Discord or in the Steam Community[\/b].[\/p][p]And if you are enjoying the demo, [b]tell a friend, share a clip, or let your favourite creator know about it![\/b] Every recommendation helps us reach more players and head into Next Fest with the biggest possible impact.[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4692610\/Hellforged_Demo\/\"][\/dynamiclink][\/p][p][b]Update the demo and jump in. If you have yet to wishlist Hellforged, we would love your support![\/b][\/p][p]See you in Hell.[\/p][p][i][b]The MoonPyre & Grindstone Teams[\/b][\/i][\/p]","commentcount":8,"tags":["mod_reviewed","ModAct_1847323374_1792069945_0"],"language":0,"hidden":0,"forum_topic_id":"565922505040243421","event_gid":"714541292743295373","voteupcount":63,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792068240,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565922505040243421","rtime32_last_modified":1793314294,"news_post_gid":"0","rtime_mod_reviewed":1792069945,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792037854,"votes_up":63,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"807975131067624658","gidfeature2":"565922505040243421"},{"gid":"694273826363541594","clan_steamid":"103582791475604411","event_name":"Demo Patch Notes - 0.1.22","event_type":12,"appid":4554250,"server_address":null,"server_password":null,"rtime32_start_time":1791290880,"rtime32_end_time":1791295201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694273826363541595","clanid":"46083003","posterid":"0","headline":"Demo Patch Notes - 0.1.22","posttime":1791290884,"updatetime":1791290884,"body":"[p]Hello, Hellforged adventurers! \u2694\ufe0f[\/p][p]Patch 0.1.22 is here! We've officially removed all remaining AI-generated artwork from the game. This update also brings responsiveness and performance improvements. Check out the full breakdown below![\/p][p][\/p][h3]\ud83c\udfae Gameplay \ud83c\udfae[\/h3][list][*][p][b]New Artwork:[\/b] Removed all remaining AI-generated artwork.[\/p][\/*][*][p][b]Inventory Responsiveness:[\/b] Improved inventory and stash responsiveness, especially with large item collections.[\/p][\/*][*][p][b]Salvaging Performance:[\/b] Improved performance when salvaging items in bulk or returning them to your inventory.[\/p][\/*][*][p][b]Dynamic Performance:[\/b] The game now automatically disables terrain blending and reduces scenery detail when low frame rates are detected to keep gameplay smooth.[\/p][\/*][*][p][b]Visual Effects:[\/b] Updated barrier shields and Voodoo Doll beam effects.[\/p][\/*][*][p][b]Impact & Death Effects:[\/b] Updated green slime death effects and goo and poison impact effects.[\/p][p] [\/p][\/*][\/list][h3]\ud83d\udd27 Fixes \ud83d\udd27[\/h3][list][*][p][b]Ranged Attacks:[\/b] Fixed ranged basic attacks firing off-target when aiming with the mouse; projectiles now account for their launch position when aiming at the cursor.[\/p][\/*][*][p][b]Salvage Window:[\/b] Fixed returning items from the salvaging window losing stack amounts or removing items that could not be returned to the inventory.[\/p][\/*][*][p][b]Card Icons:[\/b] Fixed blurry icons on cards.[\/p][\/*][*][p][b]UI Elements:[\/b] Fixed newly displayed UI elements retaining color inside grayed-out sections.[\/p][\/*][*][p][b]Camp Lighting:[\/b] Fixed camp light rays obstructing the view.[\/p][p][\/p][\/*][\/list][p]Thank you for playing and sharing your feedback. Jump back into the Undercrypt, try the changes, and let us know what you think![\/p][p][i]\u2014 The MoonPyre & Grindstone Teams[\/i][\/p]","commentcount":7,"tags":["patchnotes","mod_reviewed","ModAct_1691520782_1791292490_0"],"language":0,"hidden":0,"forum_topic_id":"583936001036277838","event_gid":"694273826363541594","voteupcount":40,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"583936001036277838","rtime32_last_modified":1793176102,"news_post_gid":"0","rtime_mod_reviewed":1791292490,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791290864,"votes_up":40,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"807975131067624658","gidfeature2":"583936001036277838"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["714541292743296356","714541292743295374"],"last_update_event":{"rtime":1791290880,"event_gid":"694273826363541594","announcement_gid":"694273826363541595","clan_account_id":46083003}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >Hellforged is a loot-driven, extraction bullet-heaven game where you are in control of the chaos around you. Battle through hordes of bloodthirsty demons and loot epic gear with powerful modifiers and effects that offer exciting new ways to fight. Unlock new sources of power and become the master of chaos to break the Blackpyre once and for all. <br> <br><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5b02d34a91d676d27bb39dd3eae610c7.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5b02d34a91d676d27bb39dd3eae610c7.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5b02d34a91d676d27bb39dd3eae610c7.mp4?t=1793095003" type="video/mp4"></video></span>Every run is a tense loot heist. Explore the map to capture locations, unlock chests, take on challenging quests, or risk capturing rifts for endgame resources. In order to secure your hard-earned gear, you have to decide if you are willing to risk it all for even greater rewards or if you would rather recover and return to fight with new equipment next time. The choice is yours!</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6757a1653c92804e817158567d19a792.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6757a1653c92804e817158567d19a792.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6757a1653c92804e817158567d19a792.mp4?t=1793095003" type="video/mp4"></video></span><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/ff5c60b41d10586eafab6e5994d69c7f.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/ff5c60b41d10586eafab6e5994d69c7f.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/ff5c60b41d10586eafab6e5994d69c7f.mp4?t=1793095003" type="video/mp4"></video></span>Play as one of the legendary survivors of the shattered expedition. Choose from distinct character classes, each wielding wildly unique and devastating powers.</p><p class="bb_paragraph" >‎</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6d08c6f6f58799fbc9ed72e5b84b52f8.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6d08c6f6f58799fbc9ed72e5b84b52f8.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/6d08c6f6f58799fbc9ed72e5b84b52f8.mp4?t=1793095003" type="video/mp4"></video></span><strong> </strong> </p><p class="bb_paragraph" >‎</p><p class="bb_paragraph" >‎<span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/b6f491ae855e5d20a58a00dc188bf310.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/b6f491ae855e5d20a58a00dc188bf310.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/b6f491ae855e5d20a58a00dc188bf310.mp4?t=1793095003" type="video/mp4"></video></span>Take your build to the next level by spending talent points in the Eternal Tree, specializing in paths that perfectly synergize with your combat style. Push your limits to conquer hundreds of achievements that are far more than mere cosmetics, as they also unlock new abilities, relics, and powers, alongside elusive secret achievements waiting to be uncovered. Control your fate by using the Arsenal to literally build your deck before every run, handpicking exactly which upgrades and abilities will drop for you during the expedition.</p><p class="bb_paragraph" >‎</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/2609c81ca83cc56e8ef8e5ec518a5a13.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/2609c81ca83cc56e8ef8e5ec518a5a13.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/2609c81ca83cc56e8ef8e5ec518a5a13.mp4?t=1793095003" type="video/mp4"></video></span><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5fd2ab7cf099c8b5bde16c584ecff277.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5fd2ab7cf099c8b5bde16c584ecff277.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/5fd2ab7cf099c8b5bde16c584ecff277.mp4?t=1793095003" type="video/mp4"></video></span>Every run brings back resources to help you prepare for the next expedition. Rebuild the ruins of your camp and unlock new ways to improve your character. Enhance your equipment in various ways and craft a combat style that is uniquely yours. Discover overpowered combinations through impactful synergies that dynamically shift your strategy. Set an enemy ablaze and strike them with a lightning ability to trigger massive explosions that clear the screen when combined with the correct talisman.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e09ac75fcca23ad6dc93112b4a9bbdf8.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e09ac75fcca23ad6dc93112b4a9bbdf8.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e09ac75fcca23ad6dc93112b4a9bbdf8.mp4?t=1793095003" type="video/mp4"></video></span><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/28e9f5f9d82b9a485bb668acf14b3287.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/28e9f5f9d82b9a485bb668acf14b3287.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/28e9f5f9d82b9a485bb668acf14b3287.mp4?t=1793095003" type="video/mp4"></video></span>Channel your gathered chaos to summon devastating bosses that test the absolute limits of your arsenal, rewarding you with greatly boosted loot. Prove your supremacy to the world by climbing the online leaderboards, where you can fight for the top spot against your friends and the best players globally. Only the strongest will survive. Tread lightly, adapt quickly, and strike hard.</p><p class="bb_paragraph" >‎</p><p class="bb_paragraph" >‎<span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/9b0aa93237af2dc6328255325cdcd563.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/9b0aa93237af2dc6328255325cdcd563.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/9b0aa93237af2dc6328255325cdcd563.mp4?t=1793095003" type="video/mp4"></video></span> </p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/f661a85ab74356195be0cd95e97d9f9d.poster.avif?t=1793095003" width=1170 height=244 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/f661a85ab74356195be0cd95e97d9f9d.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/f661a85ab74356195be0cd95e97d9f9d.mp4?t=1793095003" type="video/mp4"></video></span></p><p class="bb_paragraph" >Every month, a new Trial puts your build through a different sin-soaked gauntlet, from greed to wrath and beyond. Climb the live leaderboard and claim exclusive in-game titles if you make it to the top.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e3ef7270d7e6dc6df97ee2faf21da5db.poster.avif?t=1793095003" width=1170 height=488 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e3ef7270d7e6dc6df97ee2faf21da5db.webm?t=1793095003" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4554250/extras/e3ef7270d7e6dc6df97ee2faf21da5db.mp4?t=1793095003" type="video/mp4"></video></span></p>						</div>
					</div>
				
				
				

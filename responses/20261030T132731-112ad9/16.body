ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"699905228356460058","clanid":"45791729","posterid":"0","headline":"Arctic Drive is in the Top 50 of most-played demos last Next Fest + v0.19.2!","posttime":1793117245,"updatetime":1793197491,"body":"[h2]\ud83c\udfc6 Arctic Drive made the Top 50 most-played demos of Next Fest! \ud83c\udfc6[\/h2]\nYes, you read that right: out of 7,000+ demos, Arctic Drive was the [b]47th most-played[\/b] demo of the last Next Fest. Thank you all so much for your support!\n\nWe're thrilled you're enjoying the demo, especially since it's only a small taste of the full game coming to [b]Early Access on November 25th[\/b]. We have so much more planned, and seeing our community grow and get this excited before launch gives us a huge boost of energy and confidence in our vision.\n[h2]New DEMO patch v0.19.2 is live![\/h2][p]\ud83e\udd1d Thank you so much for your feedback and support! [\/p][p][\/p][h3]\ud83c\udf81 FEEDBACK SURVEY \ud83c\udf81[\/h3][p]Your feedback helps us shape the game, so take a couple of minutes and try your luck:\n\ud83d\udc49 [url=\"https:\/\/arctic-drive.firstlook.gg\/client\/survey\/v2\/c8b15683-3e4b-4738-8511-f0466614a392\"]Fill in the survey here[\/url] [\/p][p][\/p][h3]\ud83d\udefb ADDITIONS, FIXES & IMPROVEMENTS \ud83d\udefb[\/h3][p]\n\u2705 New revival kits for 2\u20134 player groups, plus a car radiator at the spawn point\n\u2705 Improved starting area, with fences so players don't miss the road\n\u2705 Improved demo objectives: the radio turns off after 2 repeats, the storm stops after 180 seconds, and objective markers work better\n\u2705 Days are much longer, with a better balance of daylight and night\n\u2705 Rebalanced hydration, pee needs, stamina cost per jump, mixture effects, loot and damage\n\u2705 Fixed players peeing far too much in containers\n\u2705 Vehicle deformation is more consistent across vehicle sizes, and crashing into breakable objects works properly[\/p][p]\u2705 New revival kits for 2\u20134 player groups, plus a car radiator at the spawn point\n\u2705 Radiators have been improved and will now display a message when there is no water in them when you drive\n\u2705 Fixed cargo boxes not opening every time, and made air drops less likely to land upside down\n\u2705 Shopping carts push better and get stuck in cars less often\n\u2705 Trailers are easier to attach\n\u2705 Better seat settings and hand positions on the Warden steering wheel, a fixed 2-seat backseat, and a fixed seat issue in 4-player games\n\u2705 Improved exhaust smoke on cars and generators\n\u2705 Heavier items no longer get blown away by the blizzard so quickly\n\u2705 The jerrycan now fits in the trunk\n\u2705 Fuel tooltips are clearer and color-coded\n\u2705 Improved multiplayer stability: better Steam joining (including from China), Steam-to-Steam play without crossplay, better lobby handling, fixed host spawn issues and many network sync fixes\n\u2705 Better performance: texture streaming, better compression, GPU instancing and optimized assets\n\u2705 Exposed atmosphere graphics settings and fixed refresh-rate inconsistencies\n\u2705 The game no longer gets stuck when it can't write save files on your PC (for example because of permission settings)\n\u2705 Fixed translations that didn't show up\n\u2705 Fixed the player icon setting, long player names, and underwear not disappearing properly\n\u2705 Lots of fixes to items, POIs and various bugs all over the map[\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_1691520782_1793117972_0","ModAct_1691520782_1793123567_4","ModAct_1894963720_1793203520_4"],"language":0,"hidden":0,"forum_topic_id":"564797531878896880","event_gid":"699905228356460057","voteupcount":27,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797531878896880","rtime32_last_modified":1793302943,"news_post_gid":"0","rtime_mod_reviewed":1793203520,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793116336,"votes_up":27,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"595161023680578433","gidfeature2":"564797531878896880"},{"gid":"699904683928454316","clan_steamid":"103582791475313137","event_name":"Steam Next Fest is here! \ud83d\ude97","event_type":28,"appid":4009490,"server_address":null,"server_password":null,"rtime32_start_time":1792429620,"rtime32_end_time":1793029020,"comment_count":0,"creator_steamid":"0","last_update_ste
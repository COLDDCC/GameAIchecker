null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"699904683928454317","clanid":"45791729","posterid":"0","headline":"Steam Next Fest is here! \ud83d\ude97","posttime":1792429678,"updatetime":1792429678,"body":"[p]Now is the time for us to shine, every player helps us get closer to the goal of getting to the top of most played demos during the Next Fest, so we need your help! \n\nInvite your friends to play, wishlist the game and help us on our drive to Early Access:\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4009490\/Arctic_Drive\/\"][\/dynamiclink]\nAlso we got something fun for you lined up now and next week, be sure to participate and keep an eye out for our challenges to win prizes: [url=\"https:\/\/discord.com\/channels\/1420390659877113998\/1561734004213026816\/1561740808678539417\"]https:\/\/discord.com\/channels\/1420390659877113998\/1561734004213026816\/1561740808678539417[\/url]\n\nAnd if you hadn't already check out our Official Demo Gameplay Overview trailer here: [\/p][previewyoutube=\"I3X7G3zAKKY;full\"][\/previewyoutube][p]\nSee you on the road! \u2744\ufe0f\ud83c\udf28\ufe0f[\/p]","commentcount":4,"tags":["workshop","mod_reviewed","ModAct_783923276_1792440864_0"],"language":0,"hidden":0,"forum_topic_id":"567048876338529925","event_gid":"699904683928454316","voteupcount":17,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567048876338529925","rtime32_last_modified":1793190498,"news_post_gid":"0","rtime_mod_reviewed":1792440865,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792420804,"votes_up":17,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"595161023680578433","gidfeature2":"567048876338529925"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["699905228356460058","699904683928454317"],"last_update_event":{"rtime":1793117220,"event_gid":"699905228356460057","announcement_gid":"699905228356460058","clan_account_id":45791729}}};

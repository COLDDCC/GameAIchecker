ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"667254131059072632","clanid":"45021623","posterid":"0","headline":"Benny's Backrooms Early Access Released!","posttime":1793118588,"updatetime":1793118831,"body":"[p][i]THE TIME HAS COME![\/i] [\/p][h1][b]Benny\u2019s Backrooms is now LIVE on STEAM![\/b] [\/h1][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/2562390\/Bennys_Backrooms\/\"][\/dynamiclink][\/p][h2][b]For two weeks, it will be [u]20% off[\/u]![\/b][\/h2][p]An [i]expansive labyrinth[\/i] of [b]randomly-generated levels[\/b] awaits your arrival! Explore the Backrooms, discover new creatures, and extract the resources you need to survive your day job as an employee of [b]Alcazar[\/b]. You can choose to explore [b]alone[\/b] or with [b]friends[\/b] in [i][b]online co-op[\/b][\/i]![\/p][p]Getting this game to where it is today has been a [i]long journey[\/i], and we couldn\u2019t have done it without your support. Thank you all![\/p][p][\/p][previewyoutube=\"QEnpP14AGvc;full\"][\/previewyoutube][h3]Join our [b]community[\/b] on [b][i][u][url=\"https:\/\/discord.com\/invite\/gamename\"]Discord[\/url][\/u][\/i][\/b] to find fellow recruits to play with! \u02d0steamhappy\u02d0[\/h3][p][\/p][p]See you in the Backrooms, and [i]good luck[\/i].[\/p][list][*][p][i][b]The GameName Team[\/b][\/i][\/p][\/*][\/list]","commentcount":1,"tags":["mod_reviewed","ModAct_1691520782_1793119263_0"],"language":0,"hidden":0,"forum_topic_id":"571552997743758358","event_gid":"667254131059072631","voteupcount":16,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552997743758358","rtime32_last_modified":1793294740,"news_post_gid":"0","rtime_mod_reviewed":1793119264,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793117282,"votes_up":16,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"832747107402331561","gidfeature2":"571552997743758358"},{"gid":"667254765243073035","clan_steamid":"103582791474543031","event_name":"Hotfix 2 - v8271","event_type":12,"appid":2562390,"server_address":null,"server_password":null,"rtime32_start_time":1793224980,"rtime32_end_time":1793230201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"667254131059072823\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"667254765243073036","clanid":"45021623","posterid":"0","headline":"Hotfix 2 - v8271","posttime":1793225007,"updatetime":1793225007,"body":"[b]Changes[\/b]\n[list]\n[*]Buffed stamina suit upgrades from 10% increase to 25% increase.\n[*]Removed stamina fully empty regen delay punishment (reduced from 2s regen delay to 1.4s, the same as the non-empty regen delay).\n[*]Added brightness setting.\n[*]Added controller support to the Alcazar terminal (controller support is still only partial).\n[*]Minor UI changes to PEP chests.\n[*]Textured [spoiler]Benny statue[\/spoiler].\n[\/list]\n[b]Bugfixes[\/b]\n[list]\n[*]Secondary skin colors and hat colors now show the proper icon if they are achievement locked.\n[*]Potential fix for issue where some graphics cards with upscaling enabled resulted in a black screen.\n[*]Fixed issues relating to winning the game not counting as a level completion.\n[*]Fixed bug where Benny could not look into cabinets.\n[*]Fixed issue where [spoiler]Schools[\/spoiler] could generate a wall inside a doorframe, leading to a softlock.\n[*]Various level geometry fixes.\n[*]Fixed an issue where the [spoiler]Schools Extractor[\/spoiler] achievement was unachievable.\n[\/list]","commentcount":1,"tags":["patchnotes","mod_reviewed","ModAct_1751656904_1793226242_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173076822","event_gid":"667254765243073035","voteupcount":10,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173076822","rtime32_last_modified":1793306554,"news_post_gid":"0","rtime_mod_reviewed":1793226242,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793224866,"votes_up":10,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"832747107402331561","gidfeature2":"571553273173076822"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["667254765243074434","667254131059072632"],"last_update_event":{"rtime":1793224980,"event_gid":"667254765243073035","announcement_gid":"667254765243073036","clan_account_id":45021623}}};

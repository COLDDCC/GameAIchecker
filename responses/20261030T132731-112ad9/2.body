																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"714541292743296351","clan_steamid":"103582791475854357","event_name":"25,000 Wishlists in 10 Days + Next Fest Update","event_type":13,"appid":5138990,"server_address":null,"server_password":null,"rtime32_start_time":1792404240,"rtime32_end_time":1792409401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"25,000 wishlists in under 10 days, thank you! New: speedrunner settings, more polish and bug fixes.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The demo passed 25,000 wishlists in under 10 days, thank you!\\nThis update brings speedrunner settings, a tiny Halloween easter egg, more polish and bug fixes.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"2f1e2c7c61eb8f1911e85c74905827db117d4efa.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"031e664ebb4aa09f5a122bd5975ec71d8a25a679.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"714541292743296352","clanid":"46332949","posterid":"0","headline":"25,000 Wishlists in 10 Days + Next Fest Update","posttime":1792404263,"updatetime":1792404263,"body":"[h2][b][u]25,000 wishlists in less than 10 days[\/u][\/b][\/h2][p]Unharvest just passed 25,000 wishlists in less than 10 days, the demo is part of Steam Next Fest, and it's close to 150 reviews. Thank you so much for playing, reviewing and sharing all your feedback <3[\/p][p][\/p][h2][b]New[\/b][\/h2][list][*][p]Added speedrunner-friendly settings.[\/p][\/*][*][p]Added a tiny Halloween easter egg.[\/p][\/*][\/list][p][\/p][h2][b]Quality of Life[\/b][\/h2][list][*][p]Sorry about the bird jumpscare, they're now quieter and much less scary.[\/p][\/*][*][p]Changed keybinds now show correctly.[\/p][\/*][\/list][p][\/p][h2][b]Polish & Performance[\/b][\/h2][list][*][p]Better performance overall, with more improvements coming as I keep working on the full game.[\/p][\/*][*][p]Various bug fixes and small polish.[\/p][\/*][\/list][p][\/p][p]Thank you for playing & reviewing the game. I can't wait for everyone to experience the full game <3[\/p][p]- SkorpionDev[\/p]","commentcount":9,"tags":["mod_reviewed","ModAct_1425146861_1792405081_0"],"language":0,"hidden":0,"forum_topic_id":"573804280379630702","event_gid":"714541292743296351","voteupcount":34,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804280379630702","rtime32_last_modified":1793186705,"news_post_gid":"0","rtime_mod_reviewed":1792405081,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792401378,"votes_up":34,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"592943711836493701","gidfeature2":"573804280379630702"},{"gid":"694274460775091002","clan_steamid":"103582791475854357","event_name":"1,000 Wishlists in 2 Days + QoL Update","event_type":13,"appid":5138990,"server_address":null,"server_password":null,"rtime32_start_time":1791591960,"rtime32_end_time":1791595801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Thank you! Plus controller polish, settings improvements, performance and bug fixes\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The demo hit 1,000 wishlists in just 2 days, thank you!\\nThis update brings controller polish, exact settings values, better performance and a pile of bug fixes.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"d4ccc3b61e4e9ba1e7a91c1e8ead93410246aa88.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"8b56932dc53658f0a44937e54c3aa2648fd23d3a.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694274460775091003","clanid":"46332949","posterid":"0","headline":"1,000 Wishlists in 2 Days + QoL Update","posttime":1791591953,"updatetime":1791591953,"body":"[h2][b][u]1,000 wishlists in 2 days[\/u][\/b][\/h2][p]The demo has only been out for two days, and Unharvest has already passed 1,000 wishlists. Thank you so much for playing and for all the feedback.[\/p][p][\/p][h2][b]Quality of Life[\/b][\/h2][list][*][p]Hover or select a slider in the settings to see its exact value.[\/p][\/*][*][p]Critical withers now stand out more.[\/p][\/*][*][p]Added a tree stump to sit and unwind.[\/p][\/*][\/list][p][\/p][h2][b]Controller[\/b][\/h2][list][*][p]Smoother analog stick walking.[\/p][\/*][*][p]Cleaner switching between mouse and controller.[\/p][\/*][*][p]Upgrade tree: no more double hover sounds, and the view stays within the tree.[\/p][\/*][*][p]Collection: moving between papers with the d-pad no longer skips papers.[\/p][\/*][*][p]Menus light up correctly again after opening the wishlist page.[\/p][\/*][\/list][p][\/p][h2][b]Performance[\/b][\/h2][list][*][p]Improved performance when withering a lot of wheat at once.[\/p][\/*][\/list][p][\/p][h2][b]Bug Fixes[\/b][\/h2][list][*][p]Fixed the game sometimes not fully closing.[\/p][\/*][*][p]Fixed missing languages in the in-game language list.[\/p][\/*][*][p]Fixed several menu selection and hover issues.[\/p][\/*][\/list][p][\/p][p]Thank you for playing & reviewing the game <3[\/p][p]- SkorpionDev[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1890460210_1791592969_0"],"language":0,"hidden":0,"forum_topic_id":"592943711836493702","event_gid":"694274460775091002","voteupcount":25,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"592943711836493702","rtime32_last_modified":1792972748,"news_post_gid":"0","rtime_mod_reviewed":1791592970,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791590347,"votes_up":25,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"592943711836493701","gidfeature2":"592943711836493702"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["714541292743296352","694274460775091003"],"last_update_event":{"rtime":1792404240,"event_gid":"714541292743296351","announcement_gid":"714541292743296352","clan_account_id":46332949}}};
						</script>
					


							var StoreDefaults = {"PartnerEventStore":[{"gid":"715668461242548554","clan_steamid":"103582791475454753","event_name":"Hotfix 0.3.11","event_type":13,"appid":4272370,"server_address":null,"server_password":null,"rtime32_start_time":1793165640,"rtime32_end_time":1793170801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"0adc9a61d989208ad113e96bf0001208654f085f.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ccfd890d240c047e2d64ded3a1ea1be0ac42112c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715668461242548555","clanid":"45933345","posterid":"0","headline":"Hotfix 0.3.11","posttime":1793165623,"updatetime":1793165638,"body":"[h1]Hotfix & Balance Patch Is Live![\/h1][p][\/p][p]Hey everyone![\/p][p][\/p][p]First of all, thank you for all the feedback and bug reports! We've been listening, and we've just released a small hotfix and balance patch to make things a little smoother and more enjoyable.[\/p][p][\/p][p][b]Here's what's changed:[\/b][\/p][list][*][p][b]Item prices have been rebalanced[\/b] to make things feel more fair and rewarding.[\/p][\/*][*][p]Fixed a bug that prevented the [b]Drill Escape[\/b] from being completed.[\/p][\/*][*][p]Fixed several bugs in the [b]Arena[\/b]. You can now find loot in there too! That is, if you can survive long enough to grab it...[\/p][\/*][*][p]Fixed an issue where a specific achievement would only unlock for one player in the same session.[\/p][\/*][*][p]Fixed and adjusted several sound effects that were a little too loud.[\/p][\/*][*][p]And plenty of other small fixes and improvements![\/p][p][\/p][\/*][\/list][p]We're continuing to work on the game, and your reports and suggestions are a huge help in making it better.[\/p][p][\/p][p][b]Seriously, thank you all for playing, sharing your feedback, and sticking with us![\/b] It means a lot to us, and we're excited to keep improving the game with your help.[\/p][p][\/p][p]See you in the mines! \u26cf\ufe0f[\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_1598046824_1793167266_0"],"language":0,"hidden":0,"forum_topic_id":"572679173079850735","event_gid":"715668461242548554","voteupcount":12,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679173079850735","rtime32_last_modified":1793254943,"news_post_gid":"0","rtime_mod_reviewed":1793167267,"featured_app_tagid":0,"referenced_appids":[],"build_id":26262689,"build_branch":"","unlisted":0,"rtime_created":1793165600,"votes_up":12,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"757303032542259771","gidfeature2":"572679173079850735"},{"gid":"683016095346461743","clan_steamid":"103582791475454753","event_name":"Coal Duty: Out Now in Early Access","event_type":10,"appid":4272370,"server_address":null,"server_password":null,"rtime32_start_time":1793120400,"rtime32_end_time":1793125801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"3152d21cf4d0fffd73bce378bf5059b8c27d96f2.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016095346461744","clanid":"45933345","posterid":"0","headline":"Coal Duty: Out Now in Early Access","posttime":1793117128,"updatetime":1793117128,"body":"[p]Hello miners,[\/p]\n[p]The mine is open. [b]Coal Duty is out now in Early Access.[\/b] Five of us started this as the co-op horror game we actually wanted to play. As of today you get to find out whether we managed it.[\/p]\n[p](Full operational capacity has been reached. The state thanks you in advance for your service.)[\/p]\n[h2]\u26cf\ufe0f What you can do today[\/h2]\n[p][b]Meet the quota[\/b] Descend with up to four friends into freshly generated mines, fill the cart and come back up. Push deeper for a better haul and worse company.[\/p]\n[p][b]Meet the locals[\/b] The mines are home to dozens of distinct creatures. Some are blind. Some are fast. Some look like coal until they aren't.[\/p]\n[p][b]Spend your tickets[\/b] Between shifts there are the barracks, the workshop, the tavern and a certain smuggler in the restricted area. You did not hear that here.[\/p]\n[p][b]Plan your escape[\/b] The escape machine is real and the endings it leads to are in. Some miners have reportedly escaped. The state does not confirm this.[\/p]\n[h2]\ud83d\udc77 If you played the demo[\/h2]\n[p]The six-descent cap is gone. The Easy and Hard mine floors are open alongside the Medium one you know, there are far more items and more variety in the chambers, and the creatures you have not met yet are waiting. It is around 5 hours to reach the first ending, with plenty more for anyone who digs deeper or chases the alternate route.[\/p]\n[h2]\ud83d\uddfa\ufe0f Where this goes next[\/h2]\n[p]This is the start, not the finish. We expect 12 to 18 months in Early Access, and what you tell us decides what we build next. New escape routes and endings, new creatures, new biomes and expanded hub activities are all on the roadmap, but your feedback sets the order. We're in Discord every day and we read everything.[\/p]\n[h2]\u2764\ufe0f Thank you, genuinely[\/h2]\n[p]More than 5,000 of you asked for playtest access, thousands of you played the demo through Next Fest and you have failed the quota in ways we never predicted. This build is the shape it's in because of you, from difficulty balancing all the way down to the snow that was appearing under a table.[\/p]\n[h2]\ud83d\udccb Two things that really help this week[\/h2]\n[p]Leave an honest review. Reviews are how Steam decides whether to show a small game to anyone at all. Whatever you actually thought is what we want to read.[\/p]\n[p]And come tell us what happened down there. The fastest way to reach us is Discord. [url=\"https:\/\/discord.gg\/4hrWcSeYqc\"][b]Join the Union[\/b][\/url][\/p]\n[p]See you down there.[\/p]\n[p]Corecrew[\/p]\n[p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4272370\/\"][\/dynamiclink][\/p]\n","commentcount":0,"tags":["mod_reviewed","ModAct_1691520782_1793117835_0"],"language":0,"hidden":0,"forum_topic_id":"562546024123494479","event_gid":"683016095346461743","voteupcount":12,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562546024123494479","rtime32_last_modified":1793208611,"news_post_gid":"0","rtime_mod_reviewed":1793117835,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792509777,"votes_up":12,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"757303032542259771","gidfeature2":"562546024123494479"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["715668461242548555","683016095346461744"],"last_update_event":{"rtime":1793165640,"event_gid":"715668461242548554","announcement_gid":"715668461242548555","clan_account_id":45933345}}};
						</script>
					


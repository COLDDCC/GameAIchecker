							var StoreDefaults = {"PartnerEventStore":[{"gid":"697653428543823258","clan_steamid":"103582791475777749","event_name":"BreathBound Steam Scream Fest Update Notes (Oct 26, 2026)","event_type":13,"appid":5000870,"server_address":null,"server_password":null,"rtime32_start_time":1793116800,"rtime32_end_time":1793120401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"5ab843f350bc7db5525ced903a2cf4125fc909ca.png\",null,null,null,null,null,\"cf966df3d14b11a8290458dc0c430918c7330ee6.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c90252e7e384e7123ffa8481a44fda9ee8469217.png\",null,null,null,null,null,\"9fa0e179bd81006205b83f89c2c3e7660219b2e2.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"697653428543823259","clanid":"46256341","posterid":"0","headline":"BreathBound Steam Scream Fest Update Notes (Oct 26, 2026)","posttime":1793115882,"updatetime":1793116843,"body":"[p]Hey Wardens, happy Scream Fest! [\/p][p]It\u2019s your friendly neighborhood Xiao Jiangjiang here, the one who doesn\u2019t bite~ \ud83e\udddf\u200d\u2640\ufe0f[\/p][p]This update brings new features, a bunch of quality-of-life improvements, and fixes for several issues you ran into while playing. We\u2019ve rounded up the highlights below. As for what else has changed inside the old mansion... we\u2019ll leave that for you and your squad to discover![\/p][hr][\/hr][h3]New Features[\/h3][list][*][p]Added a Breath-Holding toggle for rooms. Hosts can now choose whether breath-holding is allowed in a match (on by default). Up for the ultimate challenge? Try a no-breath-holding run![\/p][\/*][*][p]Added an in-match difficulty display so you can always check what you\u2019re up against.[\/p][\/*][*][p]Added a language switch option to the main menu.[\/p][\/*][*][p]In Nightmare mode, rats will now sneak off and drink the chicken blood.[\/p][\/*][\/list][hr][\/hr][h3]Improvements[\/h3][list][*][p]Adjusted some collisions and gameplay layouts in the Old Mansion on Hard and Nightmare difficulties, and improved scene visuals on Normal difficulty.[\/p][\/*][*][p]Reworked boss fights across difficulties with richer moves and sound effects, plus better attack feedback.[\/p][\/*][*][p]Improved the look of characters, zombies, and some items.[\/p][\/*][*][p]Improved some ambient sound effects and the results screen music.[\/p][\/*][\/list][hr][\/hr][h3]Bug Fixes[\/h3][list][*][p]Fixed abnormal boss movement, collision, and attacks in certain situations.[\/p][\/*][*][p]Fixed a collision issue in Nightmare mode that let players pass through the moon gate.[\/p][\/*][*][p]Fixed an issue where players could be unexpectedly teleported to high places during combat.[\/p][\/*][*][p]Fixed an issue where losing a key item could prevent the level from progressing.[\/p][\/*][*][p]Fixed display issues with some character outfits.[\/p][\/*][*][p]Fixed missing translations, garbled text, and wording issues in some languages.[\/p][\/*][*][p]Improved the error message and troubleshooting guidance shown when Steam services fail to start.[\/p][\/*][\/list][hr][\/hr][p]Thank you for all your support, Wardens! If you run into any problems, please let us know through the community and include your difficulty level, what happened, and a screenshot or video. You report the bugs, I\u2019ll file the tickets and go ring the bell outside the programmers\u2019 door. \ud83d\udd14[\/p][p][\/p][p]Have a spooky good time this Scream Fest! Grab your squad and we\u2019ll see you in the mansion. Roast your teammates all you want, just don\u2019t actually seal them away~[\/p][p][\/p][p]\u2014 Your friendly Xiao Jiangjiang who doesn\u2019t bite & the BreathBound dev team[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5000870\/%E5%83%B5%E5%B0%B8%E9%A9%BE%E5%88%B0\/\"][\/dynamiclink][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5063510\/%E5%83%B5%E5%B0%B8%E9%A9%BE%E5%88%B0_Demo\/\"][\/dynamiclink][\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1894626024_1793116565_0"],"language":0,"hidden":0,"forum_topic_id":"569301416225576780","event_gid":"697653428543823258","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301416225576780","rtime32_last_modified":1793184108,"news_post_gid":"0","rtime_mod_reviewed":1793116565,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793115478,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585058652581316628","gidfeature2":"569301416225576780"},{"gid":"697653428543822368","clan_steamid":"103582791475777749","event_name":"Steam Scream Fest | Over 450,000 Demo Downloads! Let\u2019s Scream Together!","event_type":28,"appid":5000870,"server_address":null,"server_password":null,"rtime32_start_time":1793095980,"rtime32_end_time":1793099580,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"5ab843f350bc7db5525ced903a2cf4125fc909ca.png\",null,null,null,null,null,\"cf966df3d14b11a8290458dc0c430918c7330ee6.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"9270981f7225329793f9edf8f3a9d1301fddf698.png\",null,null,null,null,null,\"1592085a1e021f398398f6d8fec5e6562889edbe.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"697653428543822369","clanid":"46256341","posterid":"0","headline":"Steam Scream Fest | Over 450,000 Demo Downloads! Let\u2019s Scream Together!","posttime":1793096013,"updatetime":1793118496,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46256341\/c439c6927aa7cd9ec2d3e5c1e53d40ae6fc4f019.png\"][\/img][\/p][p]Hey, teammates! Xiao Jiangjiang is back! \ud83e\udddf\u200d\u2642\ufe0f[\/p][p][\/p][p][b]BreathBound is taking part in Steam Scream Fest![\/b] This Halloween, why not grab a few friends and explore a haunted Chinese mansion together?[\/p][p][\/p][p]The lights flicker. Footsteps echo down the corridor. Your teammate suddenly holds their breath\u2014before you ask what they saw, be careful: your voice could give you away, too![\/p][p][\/p][p]BreathBound is a [b]1\u20134 player co-op horror game built around managing your breathing and sound[\/b]. Gather supplies, complete objectives, and watch each other\u2019s backs as jiangshi hunt you through the mansion. Stay quiet when danger is near\u2014and when someone needs rescuing\u2026 try not to leave them behind![\/p][p][\/p][p]\ud83c\udf83 [b]Play the demo for free and join the adventure![\/b][\/p][p][\/p][h3][b]The BreathBound demo has surpassed 450,000 downloads and ranked #49 on the Most Popular Demos chart among more than 8,000 games participating in this edition of Steam Next Fest![\/b][\/h3][p][\/p][h3][b]Steam Next Fest: The 50 Most-Played Demos of the October 2026 Event[\/b][\/h3][h3][url=\"https:\/\/store.steampowered.com\/sale\/nextfestmostplayed\"]https:\/\/store.steampowered.com\/sale\/nextfestmostplayed[\/url][\/h3][p][\/p][p]Thank you to everyone who has joined our growing \u201cinfected\u201d community\u2014and for all your suggestions, feedback, and hilarious co-op stories. Your little jiangshi has been reading them all![\/p][p][\/p][p]Whether you\u2019re stepping into the mansion for the first time or bringing new friends along for another run, we\u2019d love to see you take on the challenge. Afterward, tell us what had you holding your breath\u2014and what had your whole team laughing![\/p][p][\/p][p]\ud83d\udc49 [b]Download the demo on Steam! If you enjoy it, please add BreathBound to your wishlist and share your feedback on our Steam page![\/b][\/p][p][\/p][p]Your little jiangshi will be waiting for you in the mansion this Halloween.[\/p][p][\/p][p]Since you\u2019re here\u2026 stay for a game, won\u2019t you? \u2764\ufe0f[\/p][p][\/p][p]\u2014The BreathBound Development Team[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5000870\/%E5%83%B5%E5%B0%B8%E9%A9%BE%E5%88%B0\/\"][\/dynamiclink][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5063510\/%E5%83%B5%E5%B0%B8%E9%A9%BE%E5%88%B0_Demo\/\"][\/dynamiclink][\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1866137740_1793096742_0","ModAct_1691520782_1793119107_4"],"language":0,"hidden":0,"forum_topic_id":"569301416225550309","event_gid":"697653428543822368","voteupcount":2,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793095980,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301416225550309","rtime32_last_modified":1793119107,"news_post_gid":"0","rtime_mod_reviewed":1793119107,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793091133,"votes_up":2,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585058652581316628","gidfeature2":"569301416225550309"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["697653428543823259","697653428543822369"],"last_update_event":{"rtime":1793116800,"event_gid":"697653428543823258","announcement_gid":"697653428543823259","clan_account_id":46256341}}};
						</script>
					


																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"719045526774880574","clan_steamid":"103582791474950393","event_name":"dev_log.txt v3.0","event_type":28,"appid":3432980,"server_address":null,"server_password":null,"rtime32_start_time":1793289600,"rtime32_end_time":1793293200,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"RELOADING.october-2026\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"A roundup of dev logs from October\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"8b13cc3dd16f1b930e771577a4ddad7a041ea83e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c3165f6ceb18d6cdd1cc65e408a6837b74cafd42.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"719045526774880575","clanid":"45428985","posterid":"0","headline":"dev_log.txt v3.0","posttime":1793289633,"updatetime":1793289633,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/37e84d2d78d2923d0ef5db856fe819b1c4213dab.png\"][\/img][\/p][p][b]02\/10\/26[\/b][\/p][p]Hey folks, work is continuing on the full game:[\/p][list][*][p]About 75 new cartridges added\u00a0[\/p][\/*][*][p]Very substantial performance gains while on the range (several dozen fps) due to several optimizations[\/p][\/*][*][p]Spotter now shows accuracy with cartridge taken into account (chambered cart. or next cart. in magazine) as well as weapon accuracy alone[\/p][\/*][*][p]More visible \"leave range\" button[\/p][\/*][*][p]New starter air pistol configuration[\/p][\/*][*][p]Tutorial improvements[\/p][\/*][*][p]Progress on next weapons[\/p][\/*][*][p]Dozens and dozens of fixes[\/p][\/*][\/list][p][\/p][p]Shorter update than usual but each of these cartridges demands its own mesh, thumbnail, and dozens of individual parameters, so it's a lot of work![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/ad2d1a2b8f60ab6d8fda147c7649cf98f8a7d1f1.png\"][\/img][\/p][p][b]09\/10\/26[\/b][\/p][list][*][p]Ricochet is in! And bullets \"hug walls\", and can tumble on ricochet depending on multiple factors (in the first screenshot you can see the angle looks wildly high but in the top down view you see the bullet does hug the wall)[\/p][\/*][*][p]Ricochet chance of course also depends on cartridge props, hit surface hardness, angle and projectile speed[\/p][\/*][*][p]Added new parts to the .44 pistol[\/p][\/*][*][p]New parts for the KRASA[\/p][\/*][*][p]New parts for the .22[\/p][\/*][*][p]Weapons and cartridges setup[\/p][\/*][*][p]Complete cartridges collection, over 300 cartridges to play with now[\/p][\/*][*][p]Obv. a lot of demo debug[\/p][\/*][*][p]Progress on localization[\/p][\/*][*][p]Collecting feedback and bugs and planning updates[\/p][\/*][\/list][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/6cea18189315d4feccb6122b83403bd68fd16d25.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/7c6d8250f3807a634ae8a23b1be66707a22e963c.png\"][\/img][\/p][p][b]16\/10\/26[\/b][\/p][p]Now here's what's cooking:[\/p][list][*][p]Very focused on demo fixes and QoL, next update should come soon, including counting sequence speedup, mouse sensitivity settings, sights highlight settings, various bug fixes, display MOA as positive value always[\/p][\/*][*][p]Progress and polish on the 357 revolver including a good number of new parts (Did someone say PPC build?)[\/p][\/*][*][p]Same for the M16[\/p][\/*][*][p]More SGW57 parts[\/p][\/*][*][p]Display recoil info in more detail in weapon props (needs tooltip at the moment ; the displayed values correspond to recoil absorption translation, rotation, and recoil restabilization of translation and rotation) This is necessary because certain parts have a total of 0 only because individual values cancel out[\/p][\/*][\/list][list][*][p]New parts for the 12.7 rifle[\/p][\/*][*][p]Add many new rail adapters, scope mounts, scope mounts with backup sights[\/p][\/*][*][p]New parts for volcanic including shorter barrel with 3 round mag, and competition barrel with 3 round mag and grippable handguard; plus front sight options, and a silly threaded front sight with suppressor available. Now nearing 800 switchable parts and attachments as you can see in the showcase![\/p][\/*][\/list][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/63d5bbea1bb8753ec160227b5d4e4f86fd4a95b7.png\"][\/img][\/p][p][b]23\/10\/26[\/b][\/p][p]This week:[\/p][list][*][p]Work on the game soundtrack has begun - still lots to do[\/p][\/*][*][p]Soundtrack manager system[\/p][\/*][*][p]New design in progress for the Hit and Miss cards, for more clarity and improved performance[\/p][\/*][*][p]New NPCs and quests, new locations[\/p][\/*][*][p]Demo with new languages has shipped![\/p][\/*][\/list][p][\/p][p]I guess that's it. Thank you to everyone who is playing the demo through Next Fest, keep spreading the word![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/c7ddae1a43ffecb20e8db5e0bfceb410992c8ff2.png\"][\/img][\/p][p][b]That\u2019s it for October! Thanks for all of your support on the demo release too, I am collecting bugs and feedback like crazy and taking in your thoughts :)[\/b]\n[\/p][p][url=\"https:\/\/discord.gg\/Bj6VweMXv6\" style=\"button\" buttoncolor=\"#e63737\"]Join the official Discord![\/url][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/6245f5aacf30aeb8e04564f442b3c4eb1ce12ddc.png\"][\/img][\/p]","commentcount":8,"tags":["mod_reviewed","ModAct_1827889981_1793290840_0"],"language":0,"hidden":0,"forum_topic_id":"572679173079990221","event_gid":"719045526774880574","voteupcount":68,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793289600,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679173079990221","rtime32_last_modified":1793331794,"news_post_gid":"0","rtime_mod_reviewed":1793290841,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793010454,"votes_up":68,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"604168947372442663","gidfeature2":"572679173079990221"},{"gid":"702156483742139491","clan_steamid":"103582791474950393","event_name":"Next_Fest.exe","event_type":28,"appid":3432980,"server_address":null,"server_password":null,"rtime32_start_time":1792420200,"rtime32_end_time":1792423200,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Play the new demo\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Play the Ballistic.exe Demo in Steam Next Fest.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"6b9784eeb5c3c50b16fa04b3a6ef88ed24091a55.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e26a6bc370e7d36bac8010aa590f20a7dbc08034.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"702156483742139492","clanid":"45428985","posterid":"0","headline":"Next_Fest.exe","posttime":1792420232,"updatetime":1792420232,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/e2a6e6e1c0cf18c9d8bea900b8e1e7c9b122b452.png\"][\/img][\/p][h3]This is just a reminder that I have an extremely boring demo you should play.\u00a0[\/h3][h3][b]Steam Next Fest[\/b] is running from 19th to 26th October.[\/h3][p][\/p][p][b]There have been some fixes and quality of life updates for you all too:[\/b][\/p][list][*][p]Added rear and front sight highlighting options - including \"off\" setting (note that this will also disable the peep sight blur effect on rear sight).[\/p][\/*][*][p]Added mouse sensitivity settings, with separate settings for weapon manipulation, aim and bunker.[\/p][\/*][*][p]Added an alternative binding to Middle Mouse Button to rotate around the weapon (Alt + right click - note that \"Alt\" can be rebound to another key).[\/p][\/*][*][p]Card counting sequence is now faster and gets even faster as more cards are counted.[\/p][\/*][*][p]Accuracy (MOA) property is now always displayed as a positive number; just remember that lower is better![\/p][\/*][\/list][list][*][p]Fixed some weapon parts causing the player to be teleported up when shouldering \/ aiming.[\/p][\/*][*][p]Fixed jump sound triggering while jumping mid-air.[\/p][\/*][*][p]Fixed some typos![\/p][\/*][\/list][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45428985\/420536b68420dc4b939a1f7672a080b767950b89.png\"][\/img][\/p][h3]While you\u2019re here, maybe you should:[\/h3][p][\/p][p][url=\"https:\/\/discord.gg\/Bj6VweMXv6\" style=\"button\" buttoncolor=\"#e63737\"]Join the official Discord![\/url][\/p]","commentcount":19,"tags":["mod_reviewed","ModAct_1889321037_1792424308_0"],"language":0,"hidden":0,"forum_topic_id":"570426530135649263","event_gid":"702156483742139491","voteupcount":143,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792420200,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426530135649263","rtime32_last_modified":1793292640,"news_post_gid":"0","rtime_mod_reviewed":1792424308,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792419561,"votes_up":143,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"604168947372442663","gidfeature2":"570426530135649263"},{"gid":"719045526774878943","clan_steamid":"103582791474950393","event_name":"Languages Added [DEMO]","event_type":12,"appid":3432980,"server_address":null,"server_password":null,"rtime32_start_time":1792677600,"rtime32_end_time":1792683001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"More languages have been added to the demo!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"3e60e44988bf06a54237e9542b8bb30e1afefd9d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"295d46e6c3a461ecb0f8b15c0a32c22b5f47eb1b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"719045526774878944","clanid":"45428985","posterid":"0","headline":"Languages Added [DEMO]","posttime":1792677640,"updatetime":1792678208,"body":"[h3]Hey guys! [\/h3][h3]I've added some more languages, super excited to see this open up the opportunity for more players to access the demo![\/h3][p][\/p][p][b]List of added languages:[\/b][\/p][list][*][p]Spanish[\/p][\/*][*][p]French[\/p][\/*][*][p]German[\/p][\/*][*][p]Russian[\/p][\/*][*][p]Korean[\/p][\/*][*][p]Portuguese (Brazil)[\/p][\/*][*][p]Japanese[\/p][\/*][*][p]Simplified Chinese[\/p][\/*][*][p]Traditional Chinese[\/p][\/*][\/list][p][\/p][h3]Any bugs and feedback you can drop in our Steam Subforums OR...[\/h3][p][\/p][h3]Don't forget to:[\/h3][p][\/p][p][url=\"https:\/\/discord.gg\/Bj6VweMXv6\" style=\"button\" buttoncolor=\"#e63737\"]Join the official Discord![\/url][\/p][p][\/p]","commentcount":5,"tags":["patchnotes","mod_reviewed","ModAct_1847323374_1792677987_0","ModAct_1847323374_1792678351_4"],"language":0,"hidden":0,"forum_topic_id":"562545439722886866","event_gid":"719045526774878943","voteupcount":47,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792677600,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562545439722886866","rtime32_last_modified":1793292638,"news_post_gid":"0","rtime_mod_reviewed":1792678351,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792674727,"votes_up":47,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"604168947372442663","gidfeature2":"562545439722886866"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["719045526774880575","702156483742139492"],"last_update_event":{"rtime":1792677600,"event_gid":"719045526774878943","announcement_gid":"719045526774878944","clan_account_id":45428985}}};
						</script>
					


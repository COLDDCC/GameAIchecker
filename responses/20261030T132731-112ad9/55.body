							var StoreDefaults = {"PartnerEventStore":[{"gid":"713416027239619086","clan_steamid":"103582791474544839","event_name":"Steam Next Fest Wrap-Up","event_type":28,"appid":2781660,"server_address":null,"server_password":null,"rtime32_start_time":1793218620,"rtime32_end_time":1793222220,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Screenshot Competition Results, 100k Wishlists, Road to Release\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"66a7100893d415aeb7f7449b7dbc463bf1e4c90b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"713416027239619087","clanid":"45023431","posterid":"0","headline":"Steam Next Fest Wrap-Up","posttime":1793218654,"updatetime":1793218654,"body":"[p][b]This was an extremely eventful week! From a huge update and Steam Next Fest to a screenshot competition, let\u2019s recap what happened.[\/b] [\/p][p][\/p][p]First, we want to thank the [b]108,000 players[\/b] who tried out the demo for Dawn of Defense since it came out! We also surpassed [b]100k wishlists[\/b] during Next Fest which is just crazy! [\/p][p][\/p][p]We wanted to thank every person who submitted feedback through our form, as that has really helped us take the game in the right direction. If you played the game and have any thoughts, [url=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSfacfHn8UxWj5k7obYYZCkAboo3eey8QGDz2sz6bROBhZMdSA\/viewform\"]let us know[\/url], as we are still looking over the feedback to make some final tweaks before release.[\/p][p][\/p][p]Speaking of release, [b]Dawn of Defense is coming out on November 17th! [\/b]We are extremely excited and still hard at work reworking the tutorial, adding difficulty modifiers, deeper meta-progression trees, fixing bugs, polishing UI, and a few other stuff![\/p][p][\/p][p]Lastly, to celebrate Next Fest and the Forgotten Powers update, we hosted a screenshot competition where the best submissions could get the full game for free! We got a bunch of participants, but ultimately had to pick the 3 best. Here are the winners: [\/p][p][u]Reinforcements! - By Dutch[\/u] [img src=\"{STEAM_CLAN_IMAGE}\/45023431\/1602a3395d42dac924de53b62e4ae0c484de9f3e.png\"][\/img][\/p][p][u]All 3 Fortresses Defeated - By THE RAT[\/u] [img src=\"{STEAM_CLAN_IMAGE}\/45023431\/7fa74c303eb62be99de039d50f53f39f4b3a88ba.png\"][\/img][\/p][p][u]Infinite Range Insanity - By O_Austria_W[\/u] [img src=\"{STEAM_CLAN_IMAGE}\/45023431\/4cbe8d0cf540f822ead3503a679310f1f677b5ef.png\"][\/img][\/p][p]Congratulations to all the winners and their wonderful screenshots of the Forgotten Powers update![\/p][p][b]That's all for today, see you at release![\/b] [\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1878895840_1793220164_0"],"language":0,"hidden":0,"forum_topic_id":"567049673541517928","event_gid":"713416027239619086","voteupcount":25,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049673541517928","rtime32_last_modified":1793315308,"news_post_gid":"0","rtime_mod_reviewed":1793220165,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793057523,"votes_up":25,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"4518884147858578322","gidfeature2":"567049673541517928"},{"gid":"713416027239615554","clan_steamid":"103582791474544839","event_name":"How Meta-progression Fixed our Game's Biggest Problem","event_type":28,"appid":2781660,"server_address":null,"server_password":null,"rtime32_start_time":1792602120,"rtime32_end_time":1792692000,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Randomness in games is great, right? Well, not exactly.\",null,null,null,null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"0678d5439db1075eaf1b77da9eb4124764aeb7a8.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"713416027239615555","clanid":"45023431","posterid":"0","headline":"How Meta-progression Fixed our Game's Biggest Problem","posttime":1792602122,"updatetime":1792602122,"body":"[p][b]Randomness in games is great, right? Well, not exactly.[\/b][\/p][p][\/p][h2]The Good[\/h2][p]By randomising different elements of our game, we greatly increased replay value, as each run is different, and the player has to adapt to whatever the game throws at them. They are unable to use their same winning strategy over and over again and instead have to come up with ideas on the fly. Moreover, they encounter new and different enemies, upgrades and map layouts each time, creating an exciting sense of discovery.[\/p][h2]The Bad[\/h2][p]But randomisation also has major drawbacks. Being a strategy game, players can find it very unsatisfying to have a perfectly thought out plan just for it to explode in their faces when the RNG gods go against them. Some runs also have very weak starts, and without a good incentive to continue regardless, players just end up resetting until they get a solid start, which sucks out the fun from the game and makes runs they do play very similar, which was the whole point of randomness in the first place. So, it's important to draw a clear line where randomness should and should not interfere.[\/p][h2]Randomness in Our Game[\/h2][p]In Dawn of Defense, there are two main areas where randomness comes into play: the map layout and Runestone upgrades. For those of you who haven\u2019t played the game before, let\u2019s go over what each of these are.[\/p][p]Firstly, the map is procedurally generated to be different each run. This means resources may spawn in greater or smaller quantities, and they may be very close to the player or several isles away. Also, since the map has height variation, it greatly affects where you can place your towers and how effective those positions are. There are other aspects of map generation that affect gameplay, but this alone has a major impact on the player\u2019s strategy and the difficulty of the run.[\/p][p]On the other hand, our game has randomised upgrades in the form of Runestones. After every wave successfully beaten, players would be given a choice between three completely randomised Runestones. Some of these Runestones weren\u2019t just stat boosts, but unlocked completely new towers and units.[\/p][h2] [img src=\"{STEAM_CLAN_IMAGE}\/45023431\/01cc62396492fae6eaec0fb97563634208ed2690.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45023431\/07f3f74dc3dfd6e1ebf8be7181f5b6fd48b7e551.png\"][\/img][\/h2][h2]The Ugly[\/h2][p]While these systems did add variety, we realised that randomness was sometimes having too much influence over the player's success.[\/p][p]Since resources could spawn in very different locations, some runs would give players a strong starting position, while others would force them to work much harder just to get established. The same problem applied to Runestones. Because the available upgrades were completely randomised, players could end up with choices that didn't fit their current strategy or provide the tools they needed to deal with a particular challenge. And when Runestones could unlock entirely new towers and units, missing the right upgrade could have a much bigger impact than simply missing out on a stat boost.[\/p][p]This created a problem for us as game designers. We wanted players to adapt their strategies, but we didn't want them to feel like their strategies were irrelevant because they hadn't been lucky enough. When a run started badly and the upgrades weren't cooperating, restarting could feel like the most sensible option.[\/p][h2]The Solution[\/h2][p]Rather than removing randomness entirely, we decided to give players more ways to influence it.[\/p][p]One of our biggest changes was introducing meta-progression. Instead of every run being completely isolated, players can now make permanent progress that carries over between runs. This gives players a reason to keep going to unlock these upgrades, even when a particular run is weak and doesn't turn out as planned.[\/p][p]We also reworked how Runestone choices work by introducing Runestone families. Instead of treating every Runestone as an entirely separate random possibility, we grouped them according to their related effects. This allows players to gradually develop a particular playstyle while still leaving room for unexpected upgrades. With this plus the ability to reroll them a few times per run, makes them much more in control.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45023431\/5ec72e7ab7d39b55b7e03b371a818ea34225efbc.png\"][\/img][\/p][h2]The Beauty of Meta-progression[\/h2][p]After every run, win or lose (although you get more for winning), the player gets Runes which they can spend on the new massive skiltree to unlock permanent upgrades. Some are simple stat boosts, which although not as exciting, still fill a solid role in the game. But others introduce completely new runestones into the pool or unlock towers, units and other interesting features.[\/p][p]This changes how failure feels. Previously, a disappointing run could feel like wasted time, especially if the player struggled to get a good start. Now, even if a run doesn't go particularly well, players can still work towards their long-term progression and unlock upgrades that help them in subsequent attempts.[\/p][p]But there's another important aspect to this system: it naturally accommodates players with different skill levels.[\/p][p]More experienced players might be able to beat the game within their first couple of runs, even with relatively few permanent upgrades. Less experienced players, on the other hand, can take more runs to get there, gradually investing in the skill tree until they have the upgrades they need to overcome the game's challenges.[\/p][p]This means players aren't all expected to succeed at the same pace. Skilled players can rely more heavily on their understanding of the game's mechanics, while players who need more help can build up their power over time. And of course, it massively boosts replayability and gives players an in-game incentive to keep playing.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45023431\/e18bf4cba758a1bfb90f1c157ac94ff4c091db1a.png\"][\/img][\/p][p]This huge update is out right now, so be sure to check it out! Thanks for reading![\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1847323374_1792605699_0"],"language":0,"hidden":0,"forum_topic_id":"572678538884352453","event_gid":"713416027239615554","voteupcount":25,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884352453","rtime32_last_modified":1793218051,"news_post_gid":"0","rtime_mod_reviewed":1792605700,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792594751,"votes_up":25,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"4518884147858578322","gidfeature2":"572678538884352453"},{"gid":"713416027239615612","clan_steamid":"103582791474544839","event_name":"Performance Improvement Patch","event_type":12,"appid":2781660,"server_address":null,"server_password":null,"rtime32_start_time":1792613040,"rtime32_end_time":1792618201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"We significantly improved performance in the current Demo\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"713416027239615613","clanid":"45023431","posterid":"0","headline":"Performance Improvement Patch","posttime":1792613071,"updatetime":1792613071,"body":"[p]You may have run into performance issues in our latest Demo update, and we're really sorry if that spoiled your experience![\/p][p][\/p][p][b]The good news:[\/b] this patch should fix them and significantly improve performance.[\/p][p][\/p][p]We wish you fast frames and strong defenses! \ud83d\udd25\u2694\ufe0f[\/p][p][\/p][p][\/p][p][u]0.19.4d \u2013 Patch Notes[\/u][\/p][p]- Performance improvements[\/p][p]- Fixed the display of bold Asian fonts[\/p][p]- Small UI and UX improvements[\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1751656904_1792614212_0"],"language":0,"hidden":0,"forum_topic_id":"572678538884369210","event_gid":"713416027239615612","voteupcount":5,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884369210","rtime32_last_modified":1792893588,"news_post_gid":"0","rtime_mod_reviewed":1792614212,"featured_app_tagid":0,"referenced_appids":[],"build_id":26115382,"build_branch":"","unlisted":0,"rtime_created":1792612942,"votes_up":5,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"4518884147858578322","gidfeature2":"572678538884369210"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["713416027239619087","713416027239615555"],"last_update_event":{"rtime":1792613040,"event_gid":"713416027239615612","announcement_gid":"713416027239615613","clan_account_id":45023431}}};

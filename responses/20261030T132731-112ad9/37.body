							var StoreDefaults = {"PartnerEventStore":[{"gid":"702157662356243342","clan_steamid":"103582791475826419","event_name":"Day 3 of Daily Updates! (Pretty big one)","event_type":13,"appid":4356780,"server_address":null,"server_password":null,"rtime32_start_time":1793281500,"rtime32_end_time":1793286001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"cf9294f90cfc0171dea97b7eb54a0b7f5c3cddfd.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"0ef1088955b4518df4074e5e351d595516533c63.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"702157662356243343","clanid":"46305011","posterid":"0","headline":"Day 3 of Daily Updates! (Pretty big one)","posttime":1793281559,"updatetime":1793281559,"body":"[p]Hi everyone![\/p][p]It's Screen Stocks' [b]third day[\/b], and I have a pretty update for you all! Thanks to all of the feedback [url=\"https:\/\/discord.gg\/zfsX5XZJZj\"]on Discord[\/url] and the Steam Community Forums, we've been able to squash tons of bugs and we've even added more content... [\/p][p]Here's a list of the bugs we've fixed:[\/p][list][*][p]Frozen trade buttons should be entirely fixed[\/p][\/*][*][p]Closing a trade right after an auto action triggers no longer locks the stock at times[\/p][\/*][*][p]The game no longer sends trades to the server that it knows will fail, meaning they will not lock your stock[\/p][\/*][*][p]Fixed an issue where shares sometimes reappeared after you closed them[\/p][\/*][*][p]Clicking buy\/short twice in a row no longer gets your second trade rejected for cooldown[\/p][\/*][*][p]Fixed closing trade behaviour to prevent leftover shares even when auto actions are involved[\/p][\/*][*][p]Auto actions now trigger even if the price has passed the target[\/p][\/*][*][p]No more \u201c0 shares \/ $0\u201d positions that won\u2019t close[\/p][\/*][*][p]Leftover positions no longer block you from buying or shorting the other way[\/p][\/*][*][p]Auto-actions no longer fail or reset their timer without trading[\/p][\/*][*][p]Auto-actions on busy stocks (like $BASE) now go through basically instantly instead of up to 20s or more[\/p][\/*][*][p]\u201cAvailable\u201d stock updates instantly after you sell[\/p][\/*][*][p]Auto-actions now show straight away when the price is already past your target[\/p][\/*][*][p]No more negative net worth after going public[\/p][\/*][*][p]Auto-actions no longer show wrong numbers right after going public[\/p][\/*][\/list][p]On a separate note... Since you guys are so crazy good at manipulating the market, some players have been progressing through the \"Going Public\" levels faster than expected. Because of this, we've added 10 more! [b]There are now bonuses for up to 25 times you go public[\/b]![\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46305011\/d7f0aa5e283fb0c7b0a957e32031a821a51c8a0a.png\"][\/img][\/p][p]Lastly, we've also added more server connection points to the game such as [b]Hong Kong[\/b]. If you live in Asia, the game should be much more stable for you now![\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4356780\/Screen_Stocks\/\"][\/dynamiclink]I hope you keep on enjoying Screen Stocks, and [u][b]I would REALLY appreciate it if you reviewed the full game. It's the best thing you can do to support the game if you're enjoying it![\/b][\/u][\/p][p]- Conrad, Lead Developer[\/p]","commentcount":1,"tags":["workshop","mod_reviewed","ModAct_1847323374_1793282927_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173133936","event_gid":"702157662356243342","voteupcount":11,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173133936","rtime32_last_modified":1793327399,"news_post_gid":"0","rtime_mod_reviewed":1793282927,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793281051,"votes_up":11,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"567045558745878081","gidfeature2":"571553273173133936"},{"gid":"702157662356242904","clan_steamid":"103582791475826419","event_name":"Thank you for first 24h! + New Update","event_type":13,"appid":4356780,"server_address":null,"server_password":null,"rtime32_start_time":1793203920,"rtime32_end_time":1793208601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"cf9294f90cfc0171dea97b7eb54a0b7f5c3cddfd.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"35f0ddad3278723539d15ab122b7d2288bb817b3.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"702157662356242905","clanid":"46305011","posterid":"0","headline":"Thank you for first 24h! + New Update","posttime":1793203926,"updatetime":1793203926,"body":"[p]Hi everyone! [\/p][p]It's been about a day since Screen Stocks released, and I can't thank you all enough for how incredible it has been! Over the past 24 hours we've been working on doing some updates, here's some of what we've pushed:[\/p][list][*][p]Fixed a bug that caused some players to have the buy\/short buttons greyed out.[\/p][\/*][*][p]Fixed a bug that caused your net worth graph not to update.[\/p][\/*][*][p]Fixed a bug that caused some players from China to have additional lag.[\/p][\/*][*][p]Lots of small optimisations to make the game's experience smoother.[\/p][\/*][\/list][p]We're still working on more, and if you find any other bugs please report them in the Steam community forums or on Discord! [url=\"https:\/\/discord.gg\/zfsX5XZJZj\"]If you join the Discord[\/url], people are also having lots of fun manipulating the market and making $BASE do crazy patterns...[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46305011\/3a9ac5c119498596cbb1904beaf1fc6e0838ed0e.png\"][\/img][\/p][p][b]If you're based in China and the game is stuck on \"Loading...\"[\/b], it might be that your internet provider is not allowing access to the game's server because the game is hosted overseas. If this is the case, try to use a game accelerator (\u6e38\u620f\u52a0\u901f\u5668) like UU or Xunyou! [\/p][p]If the game is not yet listed in your game accelerator of choice, you may need to add it yourself manually or accelerate all traffic.[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4356780\/Screen_Stocks\/\"][\/dynamiclink]I hope you keep on enjoying Screen Stocks, and [u][b]I would REALLY appreciate it if you reviewed the full game. It's the best thing you can do to support the game if you're enjoying it![\/b][\/u][\/p][p]- Conrad, Lead Developer[\/p][p][\/p]","commentcount":1,"tags":["workshop","mod_reviewed","ModAct_1894963720_1793209992_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173049898","event_gid":"702157662356242904","voteupcount":12,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173049898","rtime32_last_modified":1793303308,"news_post_gid":"0","rtime_mod_reviewed":1793209992,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793202649,"votes_up":12,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"567045558745878081","gidfeature2":"571553273173049898"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["702157662356243343","702157662356242905"],"last_update_event":{"rtime":1793281500,"event_gid":"702157662356243342","announcement_gid":"702157662356243343","clan_account_id":46305011}}};
						</script>
					


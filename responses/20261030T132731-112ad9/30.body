ull,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"674006359399728389","clanid":"46215616","posterid":"0","headline":"The Free Demo Is Out Now!","posttime":1791298855,"updatetime":1791298855,"body":"[h1]The free demo is out now.[\/h1]\n\nThe Never Sort By Color demo is live and free. The Pile is waiting for you, and so is your workshop.\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5229070\/Never_Sort_By_Color_Demo\/\"][\/dynamiclink]\nThe demo does not hold back on the Pile. You get the whole mountain, every brick of it, with a limited set of upgrades and models to build.\n\nFound a bug, a clever sorting trick, or a drawer layout you are proud of? Post it in the [url=https:\/\/steamcommunity.com\/app\/4876650\/discussions\/]Steam discussions[\/url] or use the feedback form on the pause menu to email me directly.\n\nThe full game follows on November 10.\n\nSort by part. Always by part.\n[b]Never. Sort. By. Color.[\/b]\n\n- Bryan\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4876650\/Never_Sort_By_Color\/\"][\/dynamiclink]\n","commentcount":9,"tags":["workshop","ModAct_1894963720_1791300991_2_31","mod_reviewed","ModAct_1894963720_1791300993_0"],"language":0,"hidden":0,"forum_topic_id":"588439600674172768","event_gid":"674006359399728388","voteupcount":37,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791298800,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588439600674172768","rtime32_last_modified":1793022637,"news_post_gid":"0","rtime_mod_reviewed":1791300994,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790105232,"votes_up":37,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568166367991203829","gidfeature2":"588439600674172768"},
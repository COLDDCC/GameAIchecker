null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"687516524528796411","clanid":"46215616","posterid":"0","headline":"100,000 Wishlists","posttime":1791126035,"updatetime":1791126035,"body":"[h1]One hundred thousand.[\/h1]\n\n100,000 of you have wishlisted Never Sort By Color. This started as me, a workshop, and a Pile nobody had seen. Now it is a crowd of people who know exactly why you never sort by color.\n\nThank you. Every repost, every video, every friend you sent the trailer to: it worked.\n\nNext up is the free demo on October 6, then the full game on November 10. Back to the workshop. That Pile is not going to sort itself.\n\nSort by part. Always by part.\n[b]Never. Sort. By. Color.[\/b]\n\n- Bryan\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4876650\/Never_Sort_By_Color\/\"][\/dynamiclink]","commentcount":0,"tags":["workshop","mod_reviewed","ModAct_1889321037_1791126812_0"],"language":0,"hidden":0,"forum_topic_id":"588439600673921379","event_gid":"687516524528796410","voteupcount":38,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791126000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588439600673921379","rtime32_last_modified":1793091151,"news_post_gid":"0","rtime_mod_reviewed":1791126812,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1789140722,"votes_up":38,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568166367991203829","gidfeature2":"588439600673921379"},{"gid":"705535362075722059","clan_steamid":"103582791475737024","event_name":"October 28 Update","event_type":12,"appid":4876650,"server_address":null,"server_password":null,"rtime32_start_time":1793170440,"rtime32_end_time":1793174401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Names under the crosshair, square placement, scooping fixes and lost saves found\",\"Namen unter dem Fadenkreuz, gerades Abstellen, Schaufel-Fixes und wiedergefundene Spielst\u00e4nde\",\"Noms sous le r\u00e9ticule, pose align\u00e9e, correctifs de la pelle et sauvegardes retrouv\u00e9es\",\"Nomi sotto il mirino, posizionamento allineato, correzioni alla paletta e salvataggi ritrovati\",\"\uc870\uc900\uc120 \uc544\ub798 \uc774\ub984 \ud45c\uc2dc, \ubc18\ub4ef\ud55c \ubc30\uce58, \uc2a4\ucff1 \uc218\uc815, \uc0ac\ub77c\uc9c4 \uc800\uc7a5 \ubcf5\uad6c\",\"Nombres bajo la mira, colocaci\u00f3n alineada, arreglos de la pala y partidas recuperadas\",\"\u51c6\u661f\u4e0b\u65b9\u663e\u793a\u540d\u79f0\u3001\u6446\u653e\u5bf9\u9f50\u3001\u94f2\u5b50\u4fee\u590d\u548c\u627e\u56de\u4e22\u5931\u7684\u5b58\u6863\",\"\u6e96\u661f\u4e0b\u65b9\u986f\u793a\u540d\u7a31\u3001\u64fa\u653e\u5c0d\u9f4a\u3001\u93df\u5b50\u4fee\u6b63\u8207\u627e\u56de\u907a\u5931\u7684\u5b58\u6a94\",\"\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0434 \u043f\u0440\u0438\u0446\u0435\u043b\u043e\u043c, \u0440\u043e\u0432\u043d\u0430\u044f \u0440\u0430\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430, \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\u0432\u043a\u0430 \u0438 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f\",\"\u0e0a\u0e37\u0e48\u0e2d\u0e43\u0e15\u0e49\u0e40\u0e1b\u0e49\u0e32\u0e40\u0e25\u0e47\u0e07 \u0e27\u0e32\u0e07\u0e02\u0e2d\u0e07\u0e44\u0e14\u0e49\u0e15\u0e23\u0e07 \u0e41\u0e01\u0e49\u0e01\u0e32\u0e23\u0e15\u0e31\u0e01\u0e23\u0e27\u0e21 \u0e41\u0e25\u0e30\u0e01\u0e39\u0e49\u0e40\u0e0b\u0e1f\u0e17\u0e35\u0e48\u0e2b\u0e32\u0e22\",\"\u7167\u6e96\u306e\u4e0b\u306b\u540d\u524d\u3092\u8868\u793a\u3001\u7f6e\u3044\u305f\u7269\u304c\u307e\u3063\u3059\u3050\u3001\u30b9\u30af\u30fc\u30d7\u306e\u4fee\u6b63\u3001\u6d88\u3048\u305f\u30bb\u30fc\u30d6\u306e\u5fa9\u6d3b\",null,\"Nazwy pod celownikiem, r\u00f3wne stawianie, poprawki szufli i odnalezione zapisy\",null,null,null,null,null,null,null,null,\"Ni\u015fang\u00e2h alt\u0131nda isimler, d\u00fczg\u00fcn yerle\u015ftirme, kep\u00e7e d\u00fczeltmeleri ve bulunan kay\u0131tlar\",\"Nomes sob a mira, posicionamento alinhado, corre\u00e7\u00f5es da p\u00e1 e salvamentos encontrados\",null,null,null,\"\u041d\u0430\u0437\u0432\u0438 \u043f\u0456\u0434 \u043f\u0440\u0438\u0446\u0456\u043b\u043e\u043c, \u0440\u0456\u0432\u043d\u0435 \u0440\u043e\u0437\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044f, \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u043e\u0432\u043a\u0430 \u0439 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f\",null,\"T\u00ean d\u01b0\u1edbi t\u00e2m ng\u1eafm, \u0111\u1eb7t \u0111\u1ed3 ngay ng\u1eafn, s\u1eeda l\u1ed7i x\u00fac v\u00e0 t\u00ecm l\u1ea1i b\u1ea3n l\u01b0u\",null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"705535362075722060","clanid":"46215616","posterid":"0","headline":"October 28 Update","posttime":1793170481,"updatetime":1793170481,"body":"[h1]October 28 update[\/h1]\n\nThe name of whatever you aim at now sits under the crosshair, placement snaps square to the room, scooping into a carried bin keeps every brick, and lost saves come back.\n\n[h2]Lost saves[\/h2]\n[list]\n[*]On some PCs, Windows doesn't always hand the game a Documents folder when it starts. The game then saved inside its own install folder and couldn't find that save on the next launch. It now always uses the real Documents folder and also finds saves left in the install folder. Two players lost long games this way, and both saves were safe.\n[*]If you started a new game after a save went missing, the new game could take the old save's name and keep it hidden. The old save now shows up in Load as its own entry.\n[\/list]\n\n[h2]Easier to read[\/h2]\n[list]\n[*]The name of the brick you aim at now sits just under the crosshair instead of in the corner. A player found that glancing at the corner all session strained her eyes, especially when telling similar plates and tiles apart.\n[*]Bins, books, models, cabinet drawers and buttons name themselves there too. Drawers show their label, whether they're open and how many bricks are inside, and buttons say what they do, like \"Radio - Next Track\".\n[*]Sorter's Eye pulses white and dark blue, and some parts that lost their outline a few meters away now light up from across the room.\n[*]Sorter's Eye also works while you hold a bin labeled for a single part, and marks every loose piece of that part.\n[*]The label menu has a search box. Type a name or a part number and it searches the whole catalog, and \"2x4\" finds \"2\u00d74\".\n[*]Two different pieces were both called \"3\u00d73 Dish\". One is now \"Dinner Plate\". A player pointed it out.\n[*]The decorative fan was translated as an electric fan in every language but English. It's a folding fan now. A player reported the Japanese.\n[*]The spend indicator in the top left no longer pulses every minute.\n[*]The Restore Missing Pieces button fits its text in every language.\n[\/list]\n\n[h2]Placing things[\/h2]\n[list]\n[*]Bins, cabinets and everything else you set down start square to the room, facing whichever way you're mostly looking, so separate drawer sets line up. Holding the rotate key or stick still lands on 15 degree steps, so you can't overshoot. A player asked for this.\n[*]Instruction books can be rotated while closed or while you're placing them. Opening a book straightens it, and rotating an open book in your hand still spins its model.\n[*]A stack of bins could be set down with the upper bins inside a wall, and their bricks spilled onto the floor. The whole stack has to fit now. A player had two sorted bins spill this way.\n[\/list]\n\n[h2]Bins[\/h2]\n[list]\n[*]Scooping several bricks into a carried bin dropped every brick still in the air as soon as the first one landed. They all land in the bin now. A player reported it.\n[*]Bricks scooped in quick succession could end up overlapping inside the bin.\n[*]Setting a bin down while bricks are still flying into it leaves them loose in the bin like the rest.\n[*]Bins and drawers now match their walls exactly, so bricks no longer sit inside the plastic. The Wide Bin still takes a 32x32 baseplate.\n[*]Bricks no longer sink into the back corner of the Bin and Wide Bin.\n[\/list]\n\n[h2]Controller and keys[\/h2]\n[list]\n[*]B crouches on a controller in Walk and Explore modes and follows your Walk \/ Crouch hold or toggle setting. LB is just Scoop now, so it no longer ducks you. Ctrl still crouches on keyboard. A player asked for this.\n[*]The flashlight on a controller is LB + RB, so zoom works while you hold Scoop.\n[*]The tutorial showed Ctrl twice, which looked like you had to hold both. A player tried.\n[*]Labeling a bin no longer stands you up when crouch is set to toggle. A player reported it.\n[\/list]\n\n[h2]Models and water[\/h2]\n[list]\n[*]Boats set down on water sit at their water line instead of on top of it. That covers the warships, both tugboats and the Lifeguard Boat with Trailer.\n[*]Models splash when you put them on water, lift them out, or drive or fly them into it.\n[*]The spider web on the Secret Agents Home Riviera Extension was upside down and poking out the bottom.\n[\/list]\n\n[h2]Fixes[\/h2]\n[list]\n[*]Plates poured near the wooden pillars could sink into the tatami, where only Sorter's Eye and the Magnet Glove could reach them. The pillars and the floor are fixed. A player reported it.\n[*]On a controller, the shop's buy confirmation now shows which button is selected. On a Steam Deck it looked like the popup wasn't responding. A player reported it.\n[*]More sounds can play at once, so busy moments cut fewer of them off.\n[*]The fan's back is no longer see-through. A player noticed.\n[\/list]\n\nSort by part. Always by part.\n[b]Never. Sort. By. Color.[\/b]\n\n- Bryan\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4876650\/Never_Sort_By_Color\/\"][\/dynamiclink]","commentcount":10,"tags":["patchnotes","mod_reviewed","ModAct_1294976491_1793172534_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630419823","event_gid":"705535362075722059","voteupcount":18,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630419823","rtime32_last_modified":1793332665,"news_post_gid":"0","rtime_mod_reviewed":1793172534,"featured_app_tagid":0,"referenced_appids":[],"build_id":26263972,"build_branch":"","unlisted":0,"rtime_created":1793170373,"votes_up":18,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568166367991203829","gidfeature2":"565923773630419823"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["674006359399728389","687516524528796411"],"last_update_event":{"rtime":1793170440,"event_gid":"705535362075722059","announcement_gid":"705535362075722060","clan_account_id":46215616}}};
						</script>
					


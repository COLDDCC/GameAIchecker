null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"704401217928825093\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"689771494788564300","clanid":"46095478","posterid":"0","headline":"Demo Language Update #4 v0.2.00","posttime":1792407097,"updatetime":1792407097,"body":"[h1]LANGUAGE UPDATE [\/h1][p][\/p][p]We have past the [b]200,000 wishlists[\/b] mark which puts us in the [b]top 250[\/b] of most anticipated games...[\/p][h1]\ud83e\udd2fThis is nuts\ud83e\udd2f[\/h1][p]We are very thankful for your enthutiasm! Although we're only a small team working on our free time, we want to make sure the final experience will be well-designed and polished, from start to finish, hence the longer development cycle. We know the trend goes more towards fastly shipped, cheaper games but we prefer to take our time to craft something we really enjoy![\/p][p][\/p][p]Meanwhile, for the next fest, we've just released an update including 13 new languages:[\/p][p][\/p][h3][b]Languages added:[\/b] [\/h3][list][*][p]French [\/p][\/*][*][p]Italian [\/p][\/*][*][p]German [\/p][\/*][*][p]Spanish - Spain[\/p][\/*][*][p]Spanish - Latin America[\/p][\/*][*][p]Simplified Chinese[\/p][\/*][*][p]Korean[\/p][\/*][*][p]Japanese [\/p][\/*][*][p]Polish [\/p][\/*][*][p]Portuguese[\/p][\/*][*][p]Brazil Portuguese[\/p][\/*][*][p]Portugal Russian[\/p][\/*][*][p]Czech[\/p][\/*][\/list][p][\/p][h3][b]Others[\/b][\/h3][list][*][p]Added a button to reset your stats points[\/p][\/*][*][p]Fixed some softlocks situations[\/p][\/*][*][p]Other minor tweaks[\/p][\/*][\/list][p]\n[img src=\"{STEAM_CLAN_IMAGE}\/46095478\/382f5df0f2f9e67b0a5955fca4af68bfe367d554.gif\"][\/img][\/p]","commentcount":9,"tags":["patchnotes","mod_reviewed","ModAct_768955665_1792413550_0"],"language":0,"hidden":0,"forum_topic_id":"571552431431812738","event_gid":"689771494788564299","voteupcount":105,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552431431812738","rtime32_last_modified":1793290250,"news_post_gid":"0","rtime_mod_reviewed":1792413551,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792327837,"votes_up":105,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594062684485360991","gidfeature2":"571552431431812738"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":[],"last_update_event":{"rtime":1792407060,"event_gid":"689771494788564299","announcement_gid":"689771494788564300","clan_account_id":46095478}}};

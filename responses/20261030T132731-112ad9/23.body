ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"652616887841063564","clanid":"46010606","posterid":"0","headline":"v1.5.5 Update Notes","posttime":1792375601,"updatetime":1792375601,"body":"[p]v1.5.5\n\n[\/p][h2]Adjustments[\/h2][list][*][p] Adjusted the production chances and growth speeds of some high-rarity plants [\/p][\/*][*][p] Adjusted the game window size, [\/p][\/*][*][p] Put up some advertisements for the Master Carrot,[\/p][\/*][\/list][p]\n[\/p][h2]Bug Fixes and Improvements[\/h2][list][*][p] Fixed an issue that caused the game window position to change automatically in certain situations, [\/p][\/*][*][p] Fixed an issue that restricted window dragging on some macOS devices, [\/p][\/*][*][p] Fixed abnormal UI scrolling speeds on some devices, [\/p][\/*][*][p] Fixed an issue that caused mute to stop working in certain situations, [\/p][\/*][*][p] Fixed an issue that caused UI elements to appear in the wrong positions in certain situations, [\/p][\/*][*][p] Fixed issues with incorrect encyclopedia status displays and claiming rewards for the Wooden Fish, [\/p][\/*][*][p] Attempted to fix an issue where the school bell would ring after reopening the game following PC sleep, [\/p][\/*][*][p] Improved the game's audio, [\/p][\/*][*][p] Reduced the game's disk space usage, [\/p][\/*][*][p] Adjusted some visual elements, UI, and text, [\/p][p][\/p][\/*][*][p][img src=\"{STEAM_CLAN_IMAGE}\/46010606\/4caf379d380f9c3f44dc4c0181433252c2712f6c.png\"][\/img][\/p][\/*][\/list]","commentcount":0,"tags":["mod_reviewed","ModAct_1896160435_1792376401_0"],"language":0,"hidden":0,"forum_topic_id":"574930130477054792","event_gid":"652616887841063563","voteupcount":5,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930130477054792","rtime32_last_modified":1793208005,"news_post_gid":"0","rtime_mod_reviewed":1792376402,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792375388,"votes_up":5,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"805722696534224559","gidfeature2":"574930130477054792"},{"gid":"667252863011915849","clan_steamid":"103582791475532014","event_name":"Keyboard Farm\u2019s New Demo Is Here! Come on Back, Farmers!","event_type":14,"appid":4364880,"server_address":null,"server_password":null,"rtime32_start_time":1791526080,"rtime32_end_time":1791531001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"New Features Await You!\",null,null,null,null,null,\"\u5168\u65b0\u529f\u80fd\u7b49\u4f60\u6765\u73a9\uff01\",\"\u5168\u65b0\u529f\u80fd\u7b49\u4f60\u4f86\u73a9\uff01\",null,null,\"\u65b0\u6a5f\u80fd\u304c\u76db\u308a\u3060\u304f\u3055\u3093\uff01\u305c\u3072\u904a\u3093\u3067\u307f\u3066\u304f\u3060\u3055\u3044\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,\"7ef49984911fc203d75ddbb91c86a4852fbf7762.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"a347739c7beca06db6b1f4a1bb5438011ee282ff.png\",null,null,null,null,null,\"9a88a0fd3fe97e58d28d6fa8d061dfe924909d77.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"667252863011915850","clanid":"46010606","posterid":"0","headline":"Keyboard Farm\u2019s New Demo Is Here! Come on Back, Farmers!","posttime":1791526087,"updatetime":1791526557,"body":"[h1][b]Keyboard Farm\u2019s New Demo Is Here! Come on Back, Farmers![\/b][\/h1][p]Hey, farmers! Thanks for waiting! The brand-new Demo for [i]Keyboard Farm[\/i] is now available![\/p][p]We\u2019ve spent some time polishing and improving the game, and there\u2019s plenty of new content waiting for you on the farm. Whether you\u2019re a familiar face from our previous Playtest or a newcomer who\u2019s just discovered this little world on your keyboard, come on in and see what\u2019s changed![\/p][p]\ud83c\udf35 [b]More Tiles and Plants[\/b][\/p][p]There\u2019s always more land to cultivate! The new Desert tile has arrived, and tiles such as Ponds and Woodlands can now support a greater variety of plants. Keep expanding your farm and make your little keyboard world more vibrant than ever![\/p][p]\u2728 [b]A Brand-New Area Buff System[\/b][\/p][p]Special keycaps are here! Buy them from the shop to grant buffs to nearby crops.[\/p][p]Will you carefully plan your layout to maximize profits, or arrange everything to match your own aesthetic? The choice is yours![\/p][p]\ud83c\udfeb [b]A Special Building: The School![\/b][\/p][p]Who knew you could study vocabulary on a farm?[\/p][p]Purchase the School building to unlock a word game. Wait, wasn\u2019t this supposed to be a relaxing farming game? How did we end up studying again...?[\/p][p]\ud83d\udda5\ufe0f [b]A Brand-New Mini Mode[\/b][\/p][p]Want your farm to keep you company without taking up too much space on your desktop? Switch to Mini Mode with just one click and enjoy farming in a more compact layout.[\/p][p]Stay discreet on your desktop, keep it tucked away while you type. Your farm can have its own way of sneaking in a little downtime, too![\/p][p]\ud83d\udee0\ufe0f [b]More Improvements and Adjustments[\/b][\/p][p]Alongside the new content, we\u2019ve made plenty of improvements to the visuals, interactions, UI, and overall stability, all to make your farming experience smoother and more enjoyable.[\/p][p]And of course, we\u2019d love your help giving the new version a once-over! If you run into any issues or have suggestions, let us know through the in-game [b]Bug Feedback[\/b] feature.[\/p][p]\ud83d\udcac [b]Come Hang Out with Fellow Farmers![\/b][\/p][p]Want to show off your farm, share tips, or send suggestions to the development team? Join our group on Xiaohongshu (RedNote), or visit the Steam store page to find our QQ group.[\/p][p]We\u2019ll carefully review every piece of feedback. Happy farming![\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1911576989_1791527407_0"],"language":0,"hidden":0,"forum_topic_id":"585062169816842368","event_gid":"667252863011915849","voteupcount":9,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"585062169816842368","rtime32_last_modified":1792143264,"news_post_gid":"0","rtime_mod_reviewed":1791527407,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791514267,"votes_up":9,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"805722696534224559","gidfeature2":"585062169816842368"},{"gid":"652616887841064629","clan_steamid":"103582791475532014","event_name":"10.20 Update Notes","event_type":12,"appid":4364880,"server_address":null,"server_password":null,"rtime32_start_time":1792478280,"rtime32_end_time":1792483201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"652616887841064630","clanid":"46010606","posterid":"0","headline":"10.20 Update Notes","posttime":1792478290,"updatetime":1792478290,"body":"[p][\/p][list][*][p]Added Korean language support.\n[\/p][\/*][*][p]Fixed some known bugs.[\/p][p]\n[img src=\"{STEAM_CLAN_IMAGE}\/46010606\/4caf379d380f9c3f44dc4c0181433252c2712f6c.png\"][\/img][\/p][\/*][\/list]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1426387032_1792479016_0"],"language":0,"hidden":0,"forum_topic_id":"574930130477169198","event_gid":"652616887841064629","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930130477169198","rtime32_last_modified":1792673901,"news_post_gid":"0","rtime_mod_reviewed":1792479017,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792478283,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"805722696534224559","gidfeature2":"574930130477169198"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["652616887841063564","667252863011915850"],"last_update_event":{"rtime":1792478280,"event_gid":"652616887841064629","announcement_gid":"652616887841064630","clan_account_id":46010606}}};

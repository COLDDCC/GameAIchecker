							var StoreDefaults = {"PartnerEventStore":[{"gid":"690897394695406757","clan_steamid":"103582791475545071","event_name":"Next Fest Demo update","event_type":13,"appid":3979370,"server_address":null,"server_password":null,"rtime32_start_time":1792234320,"rtime32_end_time":1792238401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"9d18cadcccc891646a08445e2fd3a270e274b273.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"42b00f81494b35a8c14e72a402076e51c2f99680.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"690897394695406758","clanid":"46023663","posterid":"0","headline":"Next Fest Demo update","posttime":1792234384,"updatetime":1792234384,"body":"[p]Hello everybody! Thanks to your huge interest in the demo, more than [b]50k unique players[\/b] in two weeks, it's a huge achievement for us![\/p][p]\nWe are very sorry for the problems with update launch at night of 17 October, now everything is fixed and playable[\/p][p]\nAfter demo release we had something, we wanted to fix and update, so here it is.[\/p][list][*][p]At first we focused on [b]physics and graphics optimization[\/b]. [\/p][\/*][*][p]Also there were some problems with [b]hoomans stucking[\/b], so fixed that too.[\/p][\/*][*][p][b]Fixed fabrics[\/b], now they all work as intended - logically \"soft\" surfaces (cushions, carpets, cloth)  [b]remove fall damage[\/b][\/p][\/*][*][p]Items from the List now [b]spawn twice[\/b] as much[\/p][\/*][*][p]Fixed tooltip for opening the window[\/p][\/*][*][p][b]Hooman eyesight was a bit reduced[\/b], though we are continuing working on it[\/p][\/*][*][p]In Jeff's house the mission start points were moved a bit towards the house[\/p][\/*][*][p][b]Greatly reduced[\/b] the spawn points of Code Crate and it's Stickers (like ~10-15 per map right now)[\/p][\/*][*][p]Reworked the [b]end mission UI,[\/b] just because we wanted to.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/6a75e5221b2514b9e3c2cab60176cdb05aad6652.gif\"][\/img][\/p][\/*][\/list][p]Now about [b]additions[\/b][\/p][list][*][p]Added some new items and hats[img src=\"{STEAM_CLAN_IMAGE}\/46023663\/867f6e10b23dcd0c3884e690fe6d93751c1ce480.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/b957c4f8002930bcc1e80a5d389a630af6ebad4b.png\"][\/img][\/p][\/*][*][p]Added light scenarios to the Hub[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/b36f498d944d69c58d7adeba8f3b9656901c14e0.gif\"][\/img][\/p][\/*][\/list][p]That's all for now, will meet you at Steam Next Fest![\/p][p]Later we will talk about our future plans[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1434278705_1792235079_0"],"language":0,"hidden":0,"forum_topic_id":"565922740069056345","event_gid":"690897394695406757","voteupcount":4,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565922740069056345","rtime32_last_modified":1792412962,"news_post_gid":"0","rtime_mod_reviewed":1792235080,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792233845,"votes_up":4,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"807973539029309174","gidfeature2":"565922740069056345"},{"gid":"678511227668793723","clan_steamid":"103582791475545071","event_name":"Demo released!","event_type":31,"appid":3979370,"server_address":null,"server_password":null,"rtime32_start_time":1791333600,"rtime32_end_time":1791337200,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Just as planned\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"2e51418849f1d289af7fa7984c2f8050e0bd6103.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b4ad26289f56717c4aff14b31da74a7b00186cf7.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"678511227668793724","clanid":"46023663","posterid":"0","headline":"Demo released!","posttime":1791333638,"updatetime":1791333638,"body":"[p]Hey everyone! Glad to see you here![\/p][p]On the 2nd of October we released our Demo, just as planned. The first build was pretty unstable, but we fixed everything related to critical issues, like connection problems. Now everything should work like a charm.[\/p][p]So, what's [b]new[\/b] in demo.[\/p][list][*][p][b]Hub.[\/b] Now you can chill with your buddies between missions[img src=\"{STEAM_CLAN_IMAGE}\/46023663\/c38dcb8bc6270d8092230dce3d2d38f1cce095d8.png\"][\/img][\/p][\/*][*][p][b]Slot machine.[\/b] You know...[\/p][\/*][*][p][b]Ranks. That's easy - [\/b]do missions, get promotions, open new maps and equipment[\/p][\/*][*][p][b]Cosmetics. [\/b]Spend your hard earned money in the shop on [b]Beards[\/b] and [b]Hats[\/b]. Stock updates after every mission, so check regularly[img src=\"{STEAM_CLAN_IMAGE}\/46023663\/63e6c73e6da2ad39e38e4a2dcb06b399b35ed0f8.png\"][\/img][\/p][\/*][*][p][b]2 New maps - Jeff's House[\/b] and [b]Mad Veteran[\/b]. [\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/b3e0cbf46698c2c951584907b79bf169766f51f7.png\"][\/img][\/p][\/*][*][p][b]Tools. Drone [\/b]and[b] Wirecutters[\/b].[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/646dfdac20a93e5a3d07d945b236d53919cf1fa0.png\"][\/img][\/p][\/*][*][p][b]Weapons.[\/b] But not for you[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/9da0bb83feefc1138cd21f9350de3f4a235b8945.png\"][\/img][\/p][\/*][*][p][b]Traps. [\/b]The deadly ones[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46023663\/61ab171e9c35e33647298a8976c7e38dfbeaa77b.png\"][\/img][\/p][\/*][\/list][p]What was improved[\/p][list][*][p][b]More Items[\/b] to steal[\/p][\/*][*][p][b]Interactive items[\/b][\/p][\/*][*][p][b]Human behavior[\/b] as well as [b]his awareness[\/b] were upgraded a bit. So be careful[\/p][\/*][*][p][b]First House[\/b] was a bit improved. [\/p][\/*][\/list][p]There is a lot more in the backend part, but you don't need it i think.[\/p][p]So, overall, we made what we wanted since Playtest and now keep going forward. We have a plan, but not a specific roadmap. Firstly, we want to have a super-stable demo before Next Fest, and after we achieve it - we will add a lot more things to the actual gameplay.[\/p][p]We are now working on localizations, so they'll be ready in 2-3 days, i believe.[\/p][p]Thanks to everyone, who have already played the demo and i hope more people will try it out.[\/p][p]If you want to tell us something - ideas, problems, overall feedback, curses - There are Feedback and Discord buttons in game. We are checking it time to time. [\/p][p]Cya[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1751555285_1791335178_0","ModAct_1751555285_1791335194_2_31"],"language":0,"hidden":0,"forum_topic_id":"583936269908717249","event_gid":"678511227668793723","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"583936269908717249","rtime32_last_modified":1792275890,"news_post_gid":"0","rtime_mod_reviewed":1791335179,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791312123,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"807973539029309174","gidfeature2":"583936269908717249"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["690897394695406758","678511227668793724"],"last_update_event":{"rtime":1792234320,"event_gid":"690897394695406757","announcement_gid":"690897394695406758","clan_account_id":46023663}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/65744ae4742ed77bc4e4278a3453939d.poster.avif?t=1792235900" width=780 height=280 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/65744ae4742ed77bc4e4278a3453939d.webm?t=1792235900" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/65744ae4742ed77bc4e4278a3453939d.mp4?t=1792235900" type="video/mp4"></video></span>Become one of the followers of Gnomic Resistance and pave the way to overthrow human domination!</p><p class="bb_paragraph" >Steal filthy (or shiny) human things to replenish the Resistance treasury.</p><h2 class="bb_tag" ><strong>Mission</strong></h2><p class="bb_paragraph" >You will have a To-Steal list, so keep to it to avoid punishment.  Mission - first, Mission must be done. </p><p class="bb_paragraph" >Have finished To-Steal list and have more time? Loot for yourself, it's your future wealth!<br>At first you will be given simple mission in nearly abandoned houses without any security, but later, as you become Pillar of Resistance, you will be given difficult and significant tasks, that only your team can fulfill</p><h2 class="bb_tag" ><strong>Upgrades</strong></h2><p class="bb_paragraph" >By doing missions you will rise in rank and Resistance will give you access to new equipment that will be useful on more difficult mission. Assault ladders, drones, night vision, item detectors - everything will be yours, just do your job properly.</p><p class="bb_paragraph" ><strong>Keychains</strong></p><p class="bb_paragraph" >Find keychains in missions, sell them or use for your team to get some useful perks.</p><h2 class="bb_tag" ><strong>Car</strong></h2><p class="bb_paragraph" >Your car is your teammate - without it you will be unable to do your job properly, so keep it in tact, upgrade to fulfill your team's needs. On the mission it's your safehouse and hub with various tools.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/6d755095338525f18f6d09da1279d7c4.poster.avif?t=1792235900" width=780 height=438 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/6d755095338525f18f6d09da1279d7c4.webm?t=1792235900" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3979370/extras/6d755095338525f18f6d09da1279d7c4.mp4?t=1792235900" type="video/mp4"></video></span></p><h2 class="bb_tag" ><strong>Danger</strong></h2><p class="bb_paragraph" >Humans are intelligent, sometimes, so they will react and find a new ways to counter you.</p><p class="bb_paragraph" >Their houses vary not just by size but also by diffuculty. The richier the house - the stricter it's security systems. You will face fully closed &quot;bunkers&quot; with cameras and detectors and, maybe, even something worse than this...</p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
				<div class="sysreq_contents">
							<div class="game_area_sys_req sysreq_content active" data-os="win">
											<div class="game_area_sys_req_leftCol">
							<ul>
								<strong>Minimum:</strong><br><ul class="bb_ul"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> WIndows 10</li></ul>							</ul>
						</div>
																<div class="game_area_sys_req_rightCol">
							<ul>
								<strong>Recommended:</strong><br><ul class="bb_ul"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> WIndows 10</li></ul>							</ul>
						</div>
										<div style="clear: both;"></div>

									</div>
					</div>
	</div>
	<script type="text/javascript">
		$J( function() {
			var $Tabs = $J('.sysreq_tab');
			var $Content = $J('.sysreq_content');

			$Tabs.click( function() {
				var $Tab = $J(this);
				$Tabs.removeClass('active');
				$Tab.addClass('active');

				$Content.removeClass('active');
				$Content.filter('[data-os=' + $Tab.data('os') + ']').addClass('active');

				$Content.trigger('gamepage_autocollapse_expand');
			});
		} );
	</script>

				
								

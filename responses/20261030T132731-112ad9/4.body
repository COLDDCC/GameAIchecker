																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"717918992460679181","clan_steamid":"103582791475747473","event_name":"Demo Patch 1.0.1","event_type":28,"appid":4910490,"server_address":null,"server_password":null,"rtime32_start_time":1792464300,"rtime32_end_time":1792467780,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"5c82495015f9874132db4f2967b5095e8d4934ee.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"717918992460679182","clanid":"46226065","posterid":"0","headline":"Demo Patch 1.0.1","posttime":1792464275,"updatetime":1792464868,"body":"[p]Hey everyone,[\/p][p][\/p][p]It's been a wild day! I've had fun watching everyone find all the new tidbits and play with the new systems. I've fixed some of the major bugs that have come up as well as some balancing. [\/p][p][\/p][list][*][p]Fixed an issue where enemies wouldn't swing at a player, and will just do circles.[\/p][\/*][*][p]Improved the internal aggro system that controls enemies. Should feel a bit more robust now in co-op situations.[\/p][\/*][*][p]Fixed an issue where Priest bow could not hit the orbs from the Skeleton Knight.[\/p][\/*][*][p]Fixed an issue where Guardian was able to stun *REDACTED* and *REDACTED*[\/p][\/*][*][p]Adjusted ring drop rates for higher size parties.[\/p][p][b]Dev note[\/b]: Each player has two ring slots, so what I initially decided to do was to scale the ring drop rates linearly with player count. Say an enemy has a 15% chance to drop a ring on solo. That 15% roll happened for each player in the game. So in a four player game, each enemy would have a 60% chance to drop a ring. This causes a bit of a spreadsheet simulator and isn't the goal or intention I have for how I designed rings. So I've lowered the ceiling and reduced the drop rate increases that come with having more players.[\/p][\/*][*][p]Fixed a couple geometry holes.[\/p][\/*][*][p]Fixed various death collisions.[\/p][\/*][*][p]Fixed a crash that occurred when Warrior parried a friendly fire projectile.[\/p][\/*][*][p]Pryomancer's fireball and meteor storm now do reduced self damage. [\/p][\/*][*][p][b]Dev note[\/b]: I'm going to get a little experimental here. This was the best nerf I had in mind that wouldn't ruin the fun of his kit. This also makes interesting decisions with whether or not to use the flame thrower when compared to another attack when in close quarters. I'm not married to this, so let me know what you all think of this. [\/p][\/*][\/list][p]Misc. [\/p][list][*][p][b]Dev note[\/b]: I've noticed a lot of issues when players have the game installed on a HDD as compared to an SSD. If you are able to, please install the demo on an SSD for the most optimal experience. Long loading times and audio related stuttering are just some of the issues I have discovered with HDD's and the game. I will try my best to alleviate these issues, but these things are somewhat internal to the engine.[\/p][p][\/p][\/*][\/list][p]And that's it.[b] Thank you all for checking out our new demo! [\/b]I'm really glad to see everyone liking the new weapon and rings system, there's a ton to expand and add! [\/p][p][\/p][p]Marcus[\/p][p][\/p]","commentcount":6,"tags":["mod_reviewed","ModAct_1426387032_1792467890_0"],"language":0,"hidden":0,"forum_topic_id":"573804280379713371","event_gid":"717918992460679181","voteupcount":59,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792464300,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804280379713371","rtime32_last_modified":1793322443,"news_post_gid":"0","rtime_mod_reviewed":1792467891,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792463365,"votes_up":59,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"589559342037004842","gidfeature2":"573804280379713371"},{"gid":"717918992460677812","clan_steamid":"103582791475747473","event_name":"Ignite the Depths Is Participating in This Months Steam Next Fest!","event_type":28,"appid":4910490,"server_address":null,"server_password":null,"rtime32_start_time":1792089780,"rtime32_end_time":1792093140,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"5c82495015f9874132db4f2967b5095e8d4934ee.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"717918992460677813","clanid":"46226065","posterid":"0","headline":"Ignite the Depths Is Participating in This Months Steam Next Fest!","posttime":1792089602,"updatetime":1792089796,"body":"[p]Hey everyone,[\/p][p][\/p][p]We're releasing a public demo for this month's Next Fest! [b]We'll be releasing the demo on October 19th at 9:00 AM PST[\/b]. We'll notify wishlisters via email when we release the demo. There's been a lot of work done since the initial public playtest that I'd like to highlight so you can know what to expect.[\/p][p][\/p][h1]A Full Loot Experience[\/h1][p][\/p][p]One of the biggest changes comes from how you interact with progression in the game. Weapons are now loot, with an entire affinity system behind them. Rings are also in the game, allowing players to equip two rings to help enhance or inspire build crafting. There's over 60 different attributes a ring can affect, with the possibility of them being negative or positive added on top. In total, there's about 285,610,000 different ring variations, not including the percentage differences a stat line might have. All loot is generated on the fly, with six different rarities in total.[\/p][p][\/p][carousel][img src=\"{STEAM_CLAN_IMAGE}\/46226065\/50dc7de76cc0109cc73fe6aa21f64ea4156522a3.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/46226065\/d7ccc9b53a1a8696421693cd7257f1ee69f1ca06.png\"][\/img][\/carousel][p][\/p][h1]More Features and QOL[\/h1][p][\/p][p]I've also added set difficulty options along with a couple of modifiers. Nightmare will give all players a great challenge and adds some unique circumstances that aren't in the game otherwise. Turning on friendly fire might ensue chaos, as your mage can't call down a meteor storm without telling everyone to get out of the way. Or just trolling your friends with 'accidental' PvP. Turning off passive healing will put more pressure on the healer of the group. Permade- well, we all know what that means.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46226065\/48aaf2dc13cbcab1bab3eaf84908ea4c03d54df7.png\"][\/img][\/p][p]I've also added a well-requested feature: torches! Some areas are now designed to be used with a torch. I've found it fun to design tension in some areas using it. You are left vulnerable with a torch out, as it uses a different weapon 'slot'.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46226065\/7d5cf079a8edaa134bf0985d0848c2f2d097f18e.png\"][\/img][\/p][p]I've also redesigned many areas that you may know from the playtest, and expanded in some. Expect more secrets, and some new enemies that I'll be keeping a secret about for now.[\/p][p][\/p][h1]Other Cool Things[\/h1][p][\/p][p]I'm intentionally leaving out a ton of new things that've been added (Go play the demo!), but I'll highlight a couple more things that are direct responses to some of the feedback I received in the feedback form.[\/p][p][\/p][list][*][p][b]FOV slider[\/b][\/p][\/*][*][p][b]Hitbox inconsistencies fixed[\/b][\/p][\/*][*][p][b]Ring rerolling[\/b][\/p][\/*][*][p][b]Priest rework[\/b][\/p][\/*][*][p][b]New enemies[\/b][\/p][\/*][*][p][b]New and improved SFX (death sound, combat music, etc)[\/b][\/p][p][\/p][\/*][\/list][p]While there has been a ton added compared to the playtest, the content is still relatively the same. The full game has a ton more content, locations, and entirely new dimensions, but we're still keeping the demo relatively short (about an hour of playtime). We still want you all excited for the full game![\/p][p][\/p][p]That's all I'm going to go over for today. I'll see you all on demo launch day.[\/p][p][\/p][p]Thank you,[\/p][p]Marcus[\/p][p][\/p]","commentcount":10,"tags":["mod_reviewed","ModAct_487176015_1792095090_0"],"language":0,"hidden":0,"forum_topic_id":"573803804385009714","event_gid":"717918992460677812","voteupcount":78,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792089780,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573803804385009714","rtime32_last_modified":1793322448,"news_post_gid":"0","rtime_mod_reviewed":1792095090,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792089510,"votes_up":78,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"589559342037004842","gidfeature2":"573803804385009714"},{"gid":"693149828915400438","clan_steamid":"103582791475747473","event_name":"Ignite the Depths Demo 1.0.2","event_type":12,"appid":4910490,"server_address":null,"server_password":null,"rtime32_start_time":1792643640,"rtime32_end_time":1792648801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Hey everyone. This patch is mostly about combat.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"5c82495015f9874132db4f2967b5095e8d4934ee.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"693149828915400439","clanid":"46226065","posterid":"0","headline":"Ignite the Depths Demo 1.0.2","posttime":1792643649,"updatetime":1792643649,"body":"[p]Hey everyone,[\/p][p][\/p][p]This patch is mostly about combat.[\/p][p][\/p][p][b]Combat Changes[\/b][\/p][list][*][p]Enemies will now register hits on players much more consistently. This is largely to prevent circle strafing.[\/p][\/*][*][p]Goblin and Skeleton base movement speed has been moderately increased. This is to make kiting a bit more challenging.[\/p][\/*][*][p]Some skeletons will now have iron helmets which cannot be hit through.[\/p][\/*][*][p][b]Dev note[\/b]: All three changes listed above have the goal of making combat against common enemies more engaging. Not necessarily harder. Feedback about these changes will directly be used to dictate how to move forward.[\/p][\/*][\/list][p][b]Bug Fixes & Adjustments[\/b][\/p][list][*][p]Fixed a rare issue where orbs from the Skeleton Knight could spawn in interiors.[\/p][\/*][*][p]Patched up a couple more geometry holes.[\/p][\/*][*][p]Priest's self healing orbs now do not stack. They will heal one after another now. Before this unintentionally turned the Priest invincible in some instances.[\/p][\/*][*][p]Reduced Pyromancer's self damage by a large amount.[\/p][\/*][*][p]Fixed enemy navigation issues in lava wave room.[\/p][p][\/p][\/*][\/list][p]Thank you,[\/p][p]Marcus[\/p][p][\/p]","commentcount":7,"tags":["patchnotes","mod_reviewed","ModAct_1751692459_1792644565_0"],"language":0,"hidden":0,"forum_topic_id":"569300839163903031","event_gid":"693149828915400438","voteupcount":33,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569300839163903031","rtime32_last_modified":1793291289,"news_post_gid":"0","rtime_mod_reviewed":1792644565,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792643491,"votes_up":33,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"589559342037004842","gidfeature2":"569300839163903031"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["717918992460679182","717918992460677813"],"last_update_event":{"rtime":1792643640,"event_gid":"693149828915400438","announcement_gid":"693149828915400439","clan_account_id":46226065}}};
						</script>
					


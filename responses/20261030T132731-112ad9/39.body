le_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"712289492929610895","clanid":"46213990","posterid":"0","headline":"Demo Patch v1.03","posttime":1792348093,"updatetime":1792348093,"body":"[p]Many bugfixes!\n[\/p][list][*][p]Fixed bugs related to soccer goals not counting[\/p][\/*][*][p]Added system to respawn soccer ball if it is ever lost out of the map[\/p][\/*][*][p]Improved consistency of ragdoll leap and stand up detection[\/p][\/*][*][p]Improved air movement to be more consistent [\/p][\/*][*][p]Reduced bugs that were introducing extra latency in various areas[\/p][\/*][*][p]Fixed bindings for controller[\/p][\/*][*][p]Fixed missing collider for bronze hoop on the hoop jump map[\/p][\/*][*][p]Fixed rock paper scissors sometimes not locking you onto the platform, the loser is now guaranteed to be killed[\/p][\/*][\/list][p][\/p][p]Improvements\/Balance[\/p][list][*][p]Added slight extra cooldown to punch after you land a punch to reduce the chance of being stunlocked by many punches[\/p][\/*][*][p]Improved punch window consistency to reduce the likelihood of a trade[\/p][\/*][*][p]Improved timings around standing up from a ragdoll and using items (including punching)[\/p][\/*][\/list][p][\/p][p]Happy Gambling![\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1894963720_1792348954_0"],"language":0,"hidden":0,"forum_topic_id":"571552431431761045","event_gid":"712289492929610894","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552431431761045","rtime32_last_modified":1792601914,"news_post_gid":"0","rtime_mod_reviewed":1792348954,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792347737,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"571552004573422528","gidfeature2":"571552431431761045"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["707786527706452774"],"last_update_event":{"rtime":1792348080,"event_gid":"712289492929610894","announcement_gid":"712289492929610895","clan_account_id":46213990}}};

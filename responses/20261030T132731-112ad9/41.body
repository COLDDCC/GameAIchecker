_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"fa3501eb76ddfa6bdf6ba0bebeddbd6b5906755b.png\",null,null,null,\"fa3501eb76ddfa6bdf6ba0bebeddbd6b5906755b.png\",null,\"fa3501eb76ddfa6bdf6ba0bebeddbd6b5906755b.png\",\"fa3501eb76ddfa6bdf6ba0bebeddbd6b5906755b.png\",null,null,\"fa3501eb76ddfa6bdf6ba0bebeddbd6b5906755b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"17f977030509e1849bc1b9113c798a86acee3875.png\",null,null,null,\"f6183e53d996915fb513fc1e0a7bd81270b86857.png\",null,\"416510d7ebcb4740bb7da66ebef9fe24395ba6e2.png\",\"be27a81d2705165f3b572390e9381d9e91909927.png\",null,null,\"ed06fe490bd4cf3b06389169deb6d3ff43a5da55.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"670628025926156352\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"670628025926156355","clanid":"45146673","posterid":"0","headline":"Demo 1.0.11 Patch Notes","posttime":1792360306,"updatetime":1792360306,"body":"[list][*][p]Rebalances loot distribution[\/p][\/*][*][p]Rebalances bleed to have twice the duration but half the damage per tick[\/p][p][\/p][\/*][*][p]Increases Bull health[\/p][\/*][*][p]Increases Biler health[\/p][\/*][*][p]Increases Skeleton Standard Bearer damage[\/p][\/*][*][p]Increases Skeleton Unarmed damage[\/p][\/*][*][p]Increases Bog Reaver turn rate[\/p][\/*][*][p]Increases Bloater melee damage[\/p][p][\/p][\/*][*][p]Reduces Bloater explosion radius[\/p][\/*][*][p]Reduces Fencer damage[\/p][\/*][*][p]Reduces Elite Fencer damage[\/p][\/*][*][p]Reduces Orb Weaver turn rate[\/p][\/*][*][p]Reduces Orb Weaver jump height[\/p][p][\/p][\/*][*][p]Removes building requirements from starting dyes[\/p][\/*][*][p]Removes building prerequisites to craft Building Supplies[\/p][p][\/p][\/*][*][p]Fixes rare issue where players could spawn at world origin when loading in[\/p][\/*][*][p]Fixes character acid vfx not playing correctly[\/p][\/*][*][p]Fixes character fire vfx not playing correctly[\/p][\/*][*][p]Fixes character lightning vfx not playing correctly[\/p][\/*][*][p]Fixes not being able to swap one-handed and two-handed weapons when both are equipped[\/p][\/*][*][p]Fixes players losing grounding when turning over a ledge at high speeds[\/p][\/*][*][p]Fixes ogre look at causing twitchy\/jerky animations[\/p][\/*][*][p]Fixes player ragdolls being very stiff[\/p][\/*][*][p]Fixes spear overhead swing counting as a thrusting attack[\/p][\/*][*][p]Fixes some falling traps passing through the ground[\/p][\/*][*][p]Fixes item selection window not showing all items available in stash[\/p][\/*][*][p]Fixes composite items not randomizing materials properly[\/p][\/*][*][p]Fixes separated hoses not animating correctly on distant characters[\/p][\/*][*][p]Fixes clipping between Riding Boots and Padded Hoses[\/p][\/*][*][p]Fixes tracked camp buildings not being untracked after being constructed[\/p][\/*][*][p]Fixes item duplication using quick move and context menu move on the same item[\/p][\/*][*][p]Fixes Rock Bolt having the wrong name[\/p][\/*][*][p]Fixes trebuchets having bad colliders[\/p][\/*][*][p]Fixes broken right arm on Ogre ragdoll[\/p][\/*][*][p]Fixes customization not resetting on items when quitting the game during preview[\/p][\/*][*][p]Fixes Elite Fencer paired attack activating too early[\/p][\/*][*][p]Fixes Dagger position in hand[\/p][\/*][*][p]Fixes Bog Reaver still turning at the end of attacks[\/p][\/*][*][p]Fixes hairstyle clipping at some distances[\/p][\/*][*][p]Fixes arrows and bolts being too zoomed in when configurating[\/p][\/*][*][p]Fixes ability to sprint without losing stamina when overencumbered[\/p][\/*][*][p]Fixes Bead Grip breaking visuals in the configuration screen[\/p][\/*][*][p]Fixes configurator not zooming out when adding part to item[\/p][\/*][*][p]Fixes quick use items unequipping when configuring the belt[\/p][\/*][*][p]Fixes Legplate & Boots clipping issues[\/p][\/*][*][p]Fixes players being duplicated when loading into the game[\/p][\/*][*][p]Fixes player getting stuck in an incorrect animation after interacting while casting a spell[\/p][\/*][*][p]Fixes Undead Sorcerer ragdoll issues[\/p][\/*][*][p]Fixes throwing reticle staying too long when giving no input after throwing[\/p][\/*][*][p]Fixes Fallen Knight spawning stomp VFX when alerted[\/p][\/*][*][p]Fixes broken arm placement when swapping from crossbow to consumable[\/p][\/*][*][p]Fixes quick-move not dropping item on ground if container is full[\/p][\/*][*][p]Fixes contact not clearing barter window when swapping contact[\/p][\/*][*][p]Fixes misaligned portcullis in Drained Passage in Moor[\/p][\/*][*][p]Fixes Tentacle rotation not syncing for all players[\/p][\/*][*][p]Fixes Tentacle model disappearing when on the edge of the screen[\/p][p][\/p][\/*][*][p]Improves icon rendering quality[\/p][\/*][*][p]Improves ogre attack selection[\/p][\/*][*][p]Improve hair performance \/ model quality for characters[\/p][\/*][*][p]Improves main menu \/ title screen[\/p][\/*][*][p]Improves ragdolls for larger enemies[\/p][\/*][*][p]Improves rendering quality of UI shapes[\/p][\/*][*][p]Improves interactable highlighting and fixes related wallhack issues[\/p][\/*][*][p]Improves enemy foley sfx[\/p][\/*][*][p]Improves ogre roar animation[\/p][\/*][*][p]Improves Grasper hitboxes[\/p][\/*][*][p]Improves biomass vfx performance[\/p][\/*][*][p]Improves skilltree visuals[\/p][\/*][*][p]Improves Leaping Crab landing animation[\/p][\/*][*][p]Improves LOD for all enemy characters[\/p][\/*][*][p]Improves Cinderheart VFX[\/p][\/*][*][p]Improves consistency between quick move and context move inventory actions[\/p][\/*][*][p]Improves configuration UI[\/p][\/*][*][p]Improves Elite Fencer attack animations[\/p][\/*][*][p]Improves smoke VFX[\/p][\/*][*][p]Improves Offer icon in the context menu[\/p][\/*][*][p]Improves Request icon in the context menu[\/p][\/*][*][p]Improves Elite Fencer attack distance[\/p][\/*][*][p]Improves bow visuals on remote clients[\/p][\/*][*][p]Improves Orb Weaver attack animation speeds[\/p][\/*][*][p]Improves lighting in Drained Passage in Moor[\/p][\/*][*][p]Improves Leaping Crab death vfx[\/p][\/*][*][p]Improves Bog Reaver death vfx[\/p][p][\/p][\/*][*][p]Adds new faces[\/p][\/*][*][p]Adds new ogre grab attacks[\/p][\/*][*][p]Adds sfx to weapons when attacking[\/p][\/*][*][p]Adds missing sfx to spear animations[\/p][\/*][*][p]Adds nibbling roar animation[\/p][\/*][*][p]Adds foley to Biler animations[\/p][\/*][*][p]Adds foley to Grasper animations[\/p][\/*][*][p]Adds foley to Corpse animations[\/p][\/*][*][p]Adds foley to all player animations[\/p][\/*][*][p]Adds skill icons for industry branch in the skilltree[\/p][\/*][*][p]Adds Alembic or Cauldron as a requirement to craft dyes[\/p][\/*][*][p]Adds Building Supplies as a reward to more tasks[\/p][\/*][*][p]Adds lantern for the Smuggler\u2019s Landing grave site[\/p][\/*][*][p]Adds new sort actions, sort by rarity and sort by type[\/p][\/*][*][p]Adds Bollock Dagger[\/p][\/*][*][p]Adds Rondell Dagger\u00a0[\/p][\/*][*][p]Adds break free toggle option[\/p][\/*][*][p]Adds scan and anticipation sounds when discovering items[\/p][\/*][*][p]Adds Undead Sorcerer Ragdoll[\/p][\/*][*][p]Adds drop button to context menu on quick bind bar[\/p][\/*][*][p]Adds audio when switching between contacts[\/p][\/*][*][p]Adds Throw Away emote[\/p][\/*][*][p]Adds Don't Know emote[\/p][\/*][*][p]Adds Point Forward emote[\/p][\/*][*][p]Adds sfx to Thunderstone when held[\/p][\/*][*][p]Adds Orb Weaver Paired Attack[\/p][\/*][*][p]Adds Elite Fencer Swipe Attack[\/p][\/*][*][p]Adds colour customization to Harpy Plume[\/p][\/*][*][p]Adds sfx to Thunderstone[\/p][\/*][\/list]","commentcount":8,"tags":["patchnotes","mod_reviewed","ModAct_1787316731_1792361173_0"],"language":0,"hidden":0,"forum_topic_id":"570426530135580668","event_gid":"670628025926156354","voteupcount":74,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426530135580668","rtime32_last_modified":1793288451,"news_post_gid":"0","rtime_mod_reviewed":1792361174,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788959903,"votes_up":74,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"4434442922917123408","gidfeature2":"570426530135580668"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["681891464032027577","681890829846976116"],"last_update_event":{"rtime":1792360260,"event_gid":"670628025926156354","announcement_gid":"670628025926156355","clan_account_id":45146673}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><i>Begin your journey on foreboding grounds above ancient, mysterious ruins. Driven by an insatiable thirst for glory, power, and untold riches, you will battle innumerable deadly creatures and uncover dark secrets as you pursue your damned ambitions.</i></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/1136205c219da7b7816689ef26548c66.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Form a party with up to four other friends, or, if you're brave enough, enter the darkness alone.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f06584d8352d0cd117b7dfc6427ce86a.poster.avif?t=1792764392" width=1170 height=490 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f06584d8352d0cd117b7dfc6427ce86a.webm?t=1792764392" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f06584d8352d0cd117b7dfc6427ce86a.mp4?t=1792764392" type="video/mp4"></video></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/70e744ea31e46cfebba20c101484d5ad.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Assemble weapons from individual components: swords, maces, axes, polearms, spears, bows, or crossbows—the choice is yours. Customise all gear with materials, tints, and liveries to perfectly suit your playstyle and sense of fashion.</p><p class="bb_paragraph" > <span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/710e4f71682f83231a7e6a4f756041eb.poster.avif?t=1792764392" width=1170 height=490 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/710e4f71682f83231a7e6a4f756041eb.webm?t=1792764392" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/710e4f71682f83231a7e6a4f756041eb.mp4?t=1792764392" type="video/mp4"></video></span><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/1b114a21c0de0ab6cd7385a8aaae368e.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Death means losing your character and everything they carry, permanently. If you want to return out alive with your hard-earned loot—be careful and deliberate. Anything stored in your base camp is safe.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/226e46d0017dc1b49d5616a4535f63b9.poster.avif?t=1792764392" width=1170 height=490 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/226e46d0017dc1b49d5616a4535f63b9.webm?t=1792764392" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/226e46d0017dc1b49d5616a4535f63b9.mp4?t=1792764392" type="video/mp4"></video></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/63bf5dc5e47a633477d5594de1005dd3.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Return with resources from the depths to repair and upgrade your base of operations—exploit upgrades to assist with your next venture for more riches and antediluvian knowledge.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/fa9e46cc89666cbf5ceb947e40d3d318.poster.avif?t=1792764392" width=1170 height=490 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/fa9e46cc89666cbf5ceb947e40d3d318.webm?t=1792764392" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/fa9e46cc89666cbf5ceb947e40d3d318.mp4?t=1792764392" type="video/mp4"></video></span></p><p class="bb_paragraph" > <span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/ce5dc924448216ec9a629aba62c74ff4.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Nightmarish creatures, deadly traps, unstable structures, hidden drops, and toxic gasses—you have been warned.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline crossorigin="anonymous" poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/79f51cd1b277171c703399e3bebe302d.poster.avif?t=1792764392" width=780 height=250 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/79f51cd1b277171c703399e3bebe302d.webm?t=1792764392" type="video/webm; codecs=vp9"></video></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/4e5b46569a5c8b8f33deaf2c5d447801.avif?t=1792764392" width=1131 height=131 /></span></p><p class="bb_paragraph" >Cast aside piety and reach beyond the Empyrean to make deals with dark gods in exchange for forbidden power, but remember—everything comes at a price.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f48b85f707e8a4d466ae79fe7fc5de31.poster.avif?t=1792764392" width=1170 height=490 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f48b85f707e8a4d466ae79fe7fc5de31.webm?t=1792764392" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3126410/extras/f48b85f707e8a4d466ae79fe7fc5de31.mp4?t=1792764392" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p>						</div>
					</div>

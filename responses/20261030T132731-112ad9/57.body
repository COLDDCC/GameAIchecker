ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"698779328450663025","clanid":"46176282","posterid":"0","headline":"Ski-E-O! Ski Resort Tycoon - Release Date Trailer","posttime":1792776051,"updatetime":1792776069,"body":"[p]Hey all! I'm proud to announce that [b]Ski-E-O! Ski Resort Tycoon[\/b] launches into [b]Early Access on November 12th![\/b] \ud83c\udfbf[\/p][p]Enjoy the trailer![\/p][previewyoutube=\"XXK8HrIWPa4;full\"][\/previewyoutube][p]Thank you to everyone who has supported the project so far through wishlists, community feedback, bug reports, and a ton (a [i]TON[\/i]) of playtesting. \u2764\ufe0f[\/p][h2]\u2b50 Wishlist to get notified the moment it releases![\/h2][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4493130\/SkiEO_Ski_Resort_Tycoon\/\"][\/dynamiclink][\/p][hr][\/hr][h1]\ud83c\udf89 Discord Community Events[\/h1][p]During Steam Next Fest, I'm hosting [b]two community events[\/b] on our Discord server. Join in to earn exclusive roles and Steam Gift Cards![\/p][p]\ud83d\udcc5 [b]October 19\u201327, 2026[\/b][\/p][p][\/p][h2]\ud83d\udcf8 Event #1: Share Your Moments[\/h2][p]Stunning mountain views, your amazing resorts, moments worth remembering: we want to see them![\/p][list][*][p][b]How:[\/b] Post your original screenshots (JPG or PNG) in [url=\"https:\/\/discord.com\/channels\/1476002317626114111\/1476649382681252054\"]#share-your-moments[\/url][\/p][\/*][*][p][b]\ud83c\udfc6 Prize:3 winners[\/b] each get a [b]$20 Steam Gift Card[\/b] and a special Discord vanity role!\n[\/p][\/*][\/list][h2]\ud83d\udd75\ufe0f Event #2: Find the Unexpected Guest[\/h2][p]Something has snuck into the [b]Ski-E-O demo[\/b]... if you can find it, prove it![\/p][list][*][p][b]How:[\/b] Post a screenshot of the \"Guest\" (JPG or PNG) in [url=\"https:\/\/discord.com\/channels\/1476002317626114111\/1560082346001043536\"]#unexpected-guest[\/url][\/p][\/*][*][p][b]\ud83c\udf96\ufe0f Reward:[\/b] The exclusive [b]\"Resort Overseer\"[\/b] role!\n[\/p][\/*][\/list][hr][\/hr][h2]\ud83d\udcac Enjoying the demo? Please leave a review![\/h2][p]It really does help a small indie project like this one. Thank you! \ud83d\ude4f[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5012760\/SkiEO_Ski_Resort_Tycoon_Demo\/\"][\/dynamiclink][\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1890460210_1792788272_0"],"language":0,"hidden":0,"forum_topic_id":"574930338697174769","event_gid":"698779328450663024","voteupcount":14,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":
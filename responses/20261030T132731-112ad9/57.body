"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"698779328450664099","clanid":"46176282","posterid":"0","headline":"# Patch CL6906 - Controller hotfix","posttime":1792822851,"updatetime":1792823282,"body":"[p]- Pressing A on panel buttons works every time now, including Assign a Liftie in the tutorial.[\/p][p]- B closes Advanced Settings on the New Game screen.[\/p][p]- Start pauses the game without taking the last point off a trail you're drawing.[\/p][p]- Info panels like Staff, Hubs, Weather, the event calendar, Reputation and guest happiness free up the cursor, so you can steer to their buttons with the stick.[\/p][p]- The green check for trails, fences, ropes, park features and queue lines is easier to hit. Pressing A close to it counts.[\/p][p]- Lifts and buildings are easier to select. No need to line the crosshair up exactly on a station or cable.[\/p][p]- Dialogs confirm with A reliably.[\/p][p]- Holding A on a slider or lever when a report pops up no longer leaves it stuck.[\/p][p]- In Report a Bug, A ticks the attachment boxes and Start sends the report.[\/p][p]- X in the grading tool only removes a point now, and X won't remove trail points behind an open panel.[\/p][p]- Press X to open the \"due for a promotion\" reminder.[\/p][p][\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1434573178_1792822962_0","ModAct_1434573178_1792823435_4"],"language":0,"hidden":0,"forum_topic_id":"574930637987778445","event_gid":"698779328450664098","voteupcount":4,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930637987778445","rtime32_last_modified":1793112544,"news_post_gid":"0","rtime_mod_reviewed":1792823436,"featured_app_tagid":0,"referenced_appids":[],"build_id":26174979,"build_branch":"","unlisted":0,"rtime_created":1792822825,"votes_up":4,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585056462065217782","gidfeature2":"574930637987778445"}],
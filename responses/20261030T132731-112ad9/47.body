:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"689772763384120175","clanid":"46144564","posterid":"0","headline":"ShredDead v1.0.1","posttime":1793271930,"updatetime":1793272143,"body":"Thanks for all your feedback, both positive and negative! Your comments help me improve the game, and your suggestions will help shape future updates.\n\n[h3]Gameplay & Balance[\/h3]\n\n[list]\n[*] Prestige now starts with 5 points instead of 1.\n[*] Buffed several Prestige bonuses and reduced the cost of others.\n[*] Increased the base damage of items.\n[*] Buffed the Flamethrower.\n[*] Added a new Skill Tree upgrade that enables automatic grenade firing.\n[*] Rebalanced the final wave, making it stronger, especially on difficulties 2 and 3.\n[\/list]\n\n[h3]UI & Controls[\/h3]\n\n[list]\n[*] Fixed PlayStation and Nintendo button glyphs.\n[*] Added keyboard key glyphs.\n[*] Extended the zoom-out range in the Skill Tree.\n[*] Adjusted the positions of the Statistics and Horde buttons.\n[*] Made several minor UI and visual improvements.\n[\/list]","commentcount":8,"tags":["mod_reviewed","ModAct_773020726_1793272767_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630547299","event_gid":"689772763384120174","voteupcount":66,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630547299","rtime32_last_modified":1793333427,"news_post_gid":"0","rtime_mod_reviewed":1793272767,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793271931,"votes_up":66,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"565920396927514587","gidfeature2":"565923773630547299"},{"gid":"690898029101717965","clan_steamid":"103582791475665972","event_name":"ShredDead is out now!","event_type":10,"appid":4704520,"server_address":null,"server_password":null,"rtime32_start_time":1793034780,"rtime32_end_time":1793039401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ae1aec5dc27e54bc32f5b056e77d7fa1ee7b70cb.
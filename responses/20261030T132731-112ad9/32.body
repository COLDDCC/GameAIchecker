							var StoreDefaults = {"PartnerEventStore":[{"gid":"694275728822243916","clan_steamid":"103582791475777859","event_name":"All updates so far :","event_type":14,"appid":5064170,"server_address":null,"server_password":null,"rtime32_start_time":1792672140,"rtime32_end_time":1792675801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Completely reworked maps, HUD and menus rework, massive balance and performance improvements, new characters and weapons in the demo... read the full list in the post\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"2c62bae76ed2b0083c4e11dfa4832beaf4e66296.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"8172a5d35a76767aa71bcc9879a474be891987ac.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694275728822243917","clanid":"46256451","posterid":"0","headline":"All updates so far :","posttime":1792672171,"updatetime":1792672171,"body":"[p]I have been actively updating the demo in the past weeks and posted all the updates on the [url=\"https:\/\/discord.gg\/mfkwwEtHhJ\" style=\"pill\"]official discord[\/url] of the game, so here's a big summary of what happened :[\/p][p][\/p][h1]Go Next \u2014 Patch notes (Sept 24 \u2192 Oct 1) \n\n[b]Character changes[\/b][\/h1][list][*][p]Agent Bald: new passive, Contract. Every 25 s a nearby enemy is marked, kill it within 20 s for a gold bounty and a permanent +3% crit damage.[\/p][\/*][*][p]Frogette: her Tongue is now a real attack.[\/p][\/*][*][p]Mustafa: His Firecrackers now chain-react with +100% damage per link.[\/p][\/*][\/list][p] [b]Maps[\/b] New skies: [\/p][list][*][p]Medieval Fortress: mountains, distant castles, birds, day moon.[\/p][\/*][*][p]Coliseum Ruins: a moonlit night with the Milky Way and shooting stars.[\/p][\/*][\/list][p] [b]Progression & balance[\/b][\/p][list][*][p]Your build now travels between maps[\/p][\/*][\/list][p] [b]Armour rework:[\/b] [\/p][list][*][p]Each slot has its own role on level-up cards.[\/p][\/*][*][p]Looted pieces fuse (two of a rank make the next rank), x1.10 stats per rank.[\/p][\/*][*][p]Drops: elites 5%, bosses 30%, chests 5%.[\/p][\/*][\/list][p] [b]Totems:[\/b][\/p][list][*][p]Level-up card Pickup Range raised.[\/p][\/*][*][p]Trousers give Extra Jumps again.[\/p][\/*][*][p]Elite Spawn and Chest Drop now have diminishing returns.[\/p][\/*][*][p]Judgment Arrow: +30% damage per bounce, plus a new Bounce Damage card stat.[\/p][\/*][*][p]Cursed Yo-Yo can no longer kill you.[\/p][\/*][*][p]Chests dropped by elites and bosses open on touch, and within your pickup range.[\/p][\/*][\/list][p] [b]Leaderboard:[\/b][\/p][list][*][p]Click a score to see the run: weapons and levels, top 5 weapon damage, items.[\/p][\/*][*][p]Ranked rows show win rate, average time and more.[\/p][\/*][\/list][p] [b]Quality of life:[\/b][\/p][list][*][p]New dash gauge: three pixel arrows that refill one step per second.[\/p][\/*][*][p]New airdrop crate and parachute with a landing marker. Chests are thrown out of the monster that drops them.[\/p][\/*][*][p]Starting a run sends your character plunging into the menu's black hole.[\/p][\/*][\/list][p] [b]Steam Deck & controller[\/b][\/p][list][*][p]Steam Deck preset (60 fps), minimum text size, on-screen keyboard.[\/p][\/*][*][p]Upgrade tree: right stick pans, triggers zoom.[\/p][\/*][*][p]Windows fit 16:10 screens.[\/p][\/*][*][p]Co-op anvil: D-pad down + Interact places a weapon.[\/p][\/*][\/list][p] [b]Co-op[\/b][\/p][list][*][p]Leaving the phone booth is a team vote.[\/p][\/*][*][p]Resources: one drop, one player.[\/p][\/*][*][p]Map generation is more consistent between players.[\/p][\/*][*][p]New character to unlock [\/p][\/*][*][p]+ 1 cool new weapon in the demo[\/p][\/*][*][p]2 new bosses on coliseum and 2 new monsters + improved visibility\/textures on already existing monsters[\/p][\/*][*][p]2 new amazing tracks[\/p][\/*][*][p]reworked pause menu[\/p][\/*][*][p]reworked dash animation and sound + new dash reset mechanic upon collecting ressources (50% of a dash charge)[\/p][\/*][*][p]new cool monsters on the pyramid necropolis map[\/p][\/*][*][p]reworked the projectile of shotgun and 9mm[\/p][\/*][*][p]and many more cool things to discover in game[\/p][\/*][\/list][p][\/p][h1][b][u]Go Next \u2014 Patch notes (Oct 1\u20137) [\/u][\/b][\/h1][p][\/p][p]The black hole now shows in the sky and grows as you progress [b]Coliseum Ruins[\/b] [\/p][list][*][p]New superboss: the Olympus war chariot (replaces Gladiatus)[\/p][\/*][*][p]New boss: Scorpius, which burrows and strikes with its tail (replaces the Lion)[\/p][\/*][*][p]New monsters: Horse Gladiator and Statue on a Hoverboard[\/p][\/*][*][p]The keep stairs are gone[\/p][\/*][\/list][p] [b]Pyramid Necropolis[\/b] [\/p][list][*][p]New monster: Pyramignon[\/p][\/*][*][p]New boss: Solar Scarab, which rolls sun balls (replaces the Golem)[\/p][\/*][\/list][p] [b]All maps[\/b] [\/p][list][*][p]Every map now has one ranged monster[\/p][\/*][*][p]Monsters swim in deep water and dive after you[\/p][\/*][*][p]Monsters only spawn where you can see them[\/p][\/*][*][p]Buildings fade only when they block your view[\/p][\/*][\/list][p] [b]Balance[\/b] [\/p][list][*][p]5 weak weapons bug-fixed[\/p][\/*][*][p]Zeus Lightning bugs fixed: dropped bolts and bounces on corpses[\/p][\/*][*][p]Coronabirus clouds now hit directly[\/p][\/*][*][p]XP gain bonus now caps at \u00d715 (was \u00d720)[\/p][\/*][*][p]Airdrop crate boosts now add up instead of multiplying[\/p][\/*][*][p]Forging always takes 1 minute, whatever the rarity[\/p][\/*][\/list][p] [b]Controls & movement[\/b] [\/p][list][*][p]New manual aim: hold right mouse button or LT[\/p][\/*][*][p]New dash effect: manga-style afterimages[\/p][\/*][*][p]Air dive landing shatters the ground and deals damage[\/p][\/*][*][p]Fixed legs splaying at the top of a wall-run[\/p][\/*][*][p]Fixed bouncing when you land a slide on a slope[\/p][\/*][\/list][p] [b]UI[\/b] [\/p][list][*][p]New Profile window with your run history[\/p][\/*][*][p]New in-game Wiki in the main menu[\/p][\/*][*][p]Top-3 ranked players fly past in the main menu[\/p][\/*][*][p]New effects for Level Up text, XP\/gold gains, the Horde banner and the combo counter[\/p][\/*][*][p]New dungeon-style chest window[\/p][\/*][*][p]Loot Smoothie window is now a blender machine[\/p][\/*][*][p]Power-up timers are more compact[\/p][\/*][*][p]Ranked podium stands out more[\/p][\/*][*][p]Anvil: a different model for each rarity[\/p][\/*][*][p]New visuals for kill altars and all 4 trial totems[\/p][\/*][*][p]14\u201317 totems per map[\/p][\/*][\/list][p] [b]Co-op[\/b] [\/p][list][*][p]Friends' invites now pop up in game with a JOIN button[\/p][\/*][*][p]Nobody can join once a run has started[\/p][\/*][*][p]Team leaderboards now have one card per squad[\/p][\/*][*][p]Fixed guests losing sync on weak connections[\/p][\/*][\/list][p][\/p][p][\/p][h1][b][u]PATCH NOTE (7 october to 15 october)[\/u][\/b] [\/h1][p][\/p][h2][b]New character: Al Pachinko[\/b][\/h2][p][\/p][p][b]Shrines replace the statues: The old statues and their random \u00d71.15 boosts are gone. Five new shrines take their place.[\/b][\/p][p][\/p][h2][b]Gameplay & balance[\/b][\/h2][list][*][p][b]Attack speed past the cap now becomes damage.[\/b] Stacking attack speed is never a wasted pick.[\/p][\/*][*][p]**Zeus Lightning buffed[\/p][\/*][\/list][p] [\/p][h2][b]Maps[\/b][\/h2][list][*][p][b]Medieval Fortress: added houses and many details [\/b]Coliseum Ruins[b]: reworked the crocodile monster and added many new details to the map decor [\/b][\/p][\/*][\/list][p][\/p][h2][b]Visuals & feel[\/b][\/h2][p][b]- [\/b]The phone booth now flies away[b] when you travel and crash-lands on the next map. - [\/b]New weapon animations [\/p][list][*][p]Anvils now look different for each rarity. Divine+ anvils get an aura so you can't miss them[\/p][\/*][*][p]New cursed-chest look.[\/p][\/*][*][p]Treasure Pods now blink and shake before turning hostile.[\/p][\/*][*][p]Airdrop crates whistle on the way down.[\/p][\/*][*][p]When more than 600 XP souls are on the ground, the souls that absorb the extra XP turn rainbow.[\/p][\/*][*][p]Bouncer's Badge now shows a stamp when it blocks a hit.[\/p][\/*][\/list][p] [\/p][h2][b]UI[\/b][\/h2][list][*][p][b]Next-chest gauge[\/b] under your gold: it shows how much the next chest costs and turns green when you can afford it.[\/p][\/*][*][p][b]New FEEDBACK button[\/b] in the main menu: send a bug report or an idea straight to our Discord, with your logs attached if you want.[\/p][\/*][*][p]**Co-op lobby rebuilt[\/p][\/*][\/list]","commentcount":2,"tags":["mod_reviewed","ModAct_1866137740_1792672510_0"],"language":0,"hidden":0,"forum_topic_id":"573804438794454073","event_gid":"694275728822243916","voteupcount":13,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804438794454073","rtime32_last_modified":1793324461,"news_post_gid":"0","rtime_mod_reviewed":1792672510,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792671849,"votes_up":13,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"573804438794454072","gidfeature2":"573804438794454073"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["694275728822243917"],"last_update_event":{"rtime":1792672140,"event_gid":"694275728822243916","announcement_gid":"694275728822243917","clan_account_id":46256451}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><strong><u>YOUR WEAPONS FIRE THEMSELVES. EVERYTHING ELSE IS ON YOU.</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/4f67042c97cb50bcad4f9b73a6c48e97.poster.avif?t=1792604135" width=800 height=450 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/4f67042c97cb50bcad4f9b73a6c48e97.webm?t=1792604135" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/4f67042c97cb50bcad4f9b73a6c48e97.mp4?t=1792604135" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Go Next is a third-person horde survivor where the guns are automatic and the movement isn't. Hundreds of monsters come at you from every side, and your weapons shred them without you lifting a finger. Your job is to stay alive. Run up the walls, chain a dash into a slide into a bunny-hop, and never stand still.</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>10 worlds</strong></p></li><li><p class="bb_paragraph" ><strong>46 weapons</strong></p></li><li><p class="bb_paragraph" ><strong>111 items</strong></p></li><li><p class="bb_paragraph" ><strong>20 playable characters</strong></p></li><li><p class="bb_paragraph" ><strong>Online co-op for up to 4 players</strong></p></li><li><p class="bb_paragraph" ><strong>Ranked seasons and Steam leaderboards</strong></p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>MOVEMENT IS THE MECHANIC</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/897be0dfbd573f128762cff069dabb33.poster.avif?t=1792604135" width=800 height=450 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/897be0dfbd573f128762cff069dabb33.webm?t=1792604135" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/897be0dfbd573f128762cff069dabb33.mp4?t=1792604135" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Most horde survivors give you a joystick and a flat field. Go Next gives you fortress ramparts, pyramid walls, city rooftops and a set of moves built to use all of them.</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Wall-run, wall-climb, vault.</strong> Run along a wall, sprint straight up it, vault over the top. Walls are routes, not obstacles.</p></li><li><p class="bb_paragraph" ><strong>Dash, slide, dive-slam.</strong> Your momentum carries from one move into the next. Slam down from the air into the middle of the horde.</p></li><li><p class="bb_paragraph" ><strong>Quake-style bunny-hopping.</strong> Time your jumps right and you keep gaining speed.</p></li><li><p class="bb_paragraph" ><strong>An earned double jump</strong> to get over the crowd, not through it.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" >Speed is survival. Standing still is how runs end.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>START WEAK. END ABSURD.</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/228ccc6a9ddb2d68d8faab784644830b.poster.avif?t=1792604135" width=800 height=450 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/228ccc6a9ddb2d68d8faab784644830b.webm?t=1792604135" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/228ccc6a9ddb2d68d8faab784644830b.mp4?t=1792604135" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Every level-up offers three cards and you pick one. A run starts with one weapon and ends with the screen full of planets, lightning and black holes.</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>4 weapon slots.</strong> Each weapon levels up to 50, and further at the anvil. There are 11 rarity tiers, from Common to Galaxy.</p></li><li><p class="bb_paragraph" ><strong>46 weapons with personality:</strong> a Solar System that orbits up to 30 planets around you, Zeus Lightning, a pocket Black Hole, a Wheel of Fortune, Heads or Tails, Mjolnir, a Goblin Catapult, a Dragon Egg and more.</p></li><li><p class="bb_paragraph" ><strong>111 items</strong> across 5 tiers, from Common to Cosmic.</p></li><li><p class="bb_paragraph" ><strong>Armour that grows with you.</strong> Hat, ring, belt and trousers level up from armour cards, rank up from elite drops and follow you from map to map.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>THE MAP IS FULL OF DEALS</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/3e336de4b5c7bc4d388605b5e5898efb.poster.avif?t=1792604135" width=800 height=450 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/3e336de4b5c7bc4d388605b5e5898efb.webm?t=1792604135" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/3e336de4b5c7bc4d388605b5e5898efb.mp4?t=1792604135" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >You can't win standing in one spot, so the map gives you reasons to move.</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Totem challenges</strong> that test you: chase it, defend it, overcharge it.</p></li><li><p class="bb_paragraph" ><strong>Shrines</strong> that offer a clear deal: trade HP for gold, gamble on a capsule machine, or jump the clock a minute ahead and pocket its kills.</p></li><li><p class="bb_paragraph" ><strong>Cursed chests</strong> with better loot, guarded by elites.</p></li><li><p class="bb_paragraph" ><strong>Kill altars, parachute airdrops, a wandering merchant</strong> and the <strong>anvil</strong>.</p></li><li><p class="bb_paragraph" ><strong>Resources to harvest.</strong> Every world and its monsters drop their own resources, which you spend to unlock new weapons and items.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>10 WORLDS, EACH WITH ITS OWN RULES</u></strong></p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" >Every world has its own bosses, and some have a superboss.</p></li><li><p class="bb_paragraph" ><strong>At 10:00, the monsters stop walking.</strong> Every regular enemy takes off and flies straight at you.</p></li><li><p class="bb_paragraph" >They swim, too. Water is not a safe zone.</p></li><li><p class="bb_paragraph" >On the Extraterrestrial Base, a <strong>black hole starts eating the planets, one per minute.</strong></p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>20 CHARACTERS, NO LOCKED WEAPONS</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >A gangster who settles everything with a coin toss, an 80s gym-rat Zeus, a plague doctor, a game-show host with a wheel on his back, a scientist who carries a black hole, and 15 more. Each one has a unique passive, their own strengths and weaknesses, and a signature starting weapon. Any character can find any weapon.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>PROGRESSION THAT CARRIES OVER</u></strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/42ab41a59902233250a7b56fd4d195ef.poster.avif?t=1792604135" width=800 height=450 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/42ab41a59902233250a7b56fd4d195ef.webm?t=1792604135" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5064170/extras/42ab41a59902233250a7b56fd4d195ef.mp4?t=1792604135" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Every world drops its own resources. Spend them between runs:</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" >In the <strong>Upgrade Tree</strong>: one branch per world, opening up new weapons, new items and 52 passives.</p></li><li><p class="bb_paragraph" >In <strong>Unlocks</strong>: browse your whole collection and keep the weapons and items you don't want out of your runs.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" >Everything starts locked, so every run opens up something new.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong><u>BRING YOUR FRIENDS, THEN BEAT THEM</u></strong></p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Online co-op for up to 4 players</strong> through Steam lobbies, public or friends-only, with invites straight from Steam.</p></li><li><p class="bb_paragraph" ><strong>Leaderboards</strong> for solo, duo, trio and squad runs.</p></li><li><p class="bb_paragraph" ><strong>Ranked seasons</strong>, from Bronze to Grandmaster.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" >Full controller support · 18 languages</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Survive. Snowball. Go next.</strong></p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
					<div class="sysreq_tabs">

93249_1792904208_0"],"language":0,"hidden":0,"forum_topic_id":"573804739774504584","event_gid":"675135430408017935","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804739774504584","rtime32_last_modified":1792904208,"news_post_gid":"0","rtime_mod_reviewed":1792904208,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792903535,"votes_up":0,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"583936513907197186","gidfeature2":"573804739774504584"},{"gid":"675135430408017928","clan_steamid":"103582791475795331","event_name":"Dreampair desktop DEMO is live at Steam Next Fest!","event_type":13,"appid":5082780,"server_address":null,"server_password":null,"rtime32_start_time":1792899660,"rtime32_end_time":1792904401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"d1e682e5e1c9466b2cd016210ed6be872b62b986.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"675135430408017929","clanid":"46273923","posterid":"0","headline":"Dreampair desktop DEMO is live at Steam Next Fest!","posttime":1792899701,"updatetime":1792905122,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46273923\/0ed11109d6a74bb66d744f31134554c95fecc2af.jpg\"][\/img][\/p][p][b]Hi everyone!\n[\/b]\nThank you so much for playing the demo. I've been reading your reviews and community feedback, and I'm so happy you're enjoying it!\n\nNext Fest ends on [b]Oct 26, 10:00 AM PDT[\/b], so there's about a day left. \nThe demo will stay available after the event ends. \nplease add Dreampair to your wishlist and tell your friends. It means a lot to a solo-developed game. Dreampair does not use generative AI, and it won't in the future either. \nYour support helps this small indie project keep going. Thank you!  \n\n\n[img src=\"{STEAM_CLAN_IMAGE}\/46273923\/262109e333d7d212f31996a6566a6c112d42b238.png\"][\/img][\/p][h2]Next Fest Event[\/h2][p]There's a surprise guest hiding in the demo.\nYou can only meet it during Next Fest, so find it before it's gone!\n\n[\/p][h2]Recent fixes[\/h2][list][*][p]Custom eye spacing now stays at its default\n[\/p][\/*][*][p]Your chosen eyebrows are kept when expressions change\n[\/p][\/*][*][p]Re-registering a custom part under the same name applies the new image right away\n[\/p][\/*][*][p]If you uploaded custom images earlier, please upload them once more\n[\/p][\/*][\/list]","commentcount":0,"tags":["mod_reviewed","ModAct_1870293249_1792900072_0","ModAct_1870293249_1792905705_4"],"language":0,"hidden":0,"forum_topic_id":"573804739774499979","event_gid":"675135430408017928","voteupcount":2,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804739774499979","rtime32_last_modified":1793213993,"news_post_gid":"0","rtime_mod_reviewed":1792905706,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792898522,"votes_up":2,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"583936513907197186","gidfeature2":"573804739774499979"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["675135430408017936","675135430408017929"],"last_update_event":{"rtime":1792899660,"event_gid":"675135430408017928","announcement_gid":"675135430408017929","clan_account_id":46273923}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Software</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/3b111dd5d00985ee448a3e514999ae8e.avif?t=1793141688" width=780 height=374 /></span></p><p class="bb_paragraph" style="text-align: center"><strong>Hi everyone! Dreampair is a customizable desktop companion for character pair lovers.</strong></p><p class="bb_paragraph" style="text-align: center"><strong>Create your favorite character pairs right on your desktop!</strong></p><p class="bb_paragraph" style="text-align: center"><strong>Stay productive with our Focus Mode, and don't forget to add it to your wishlist to show your support!</strong></p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><strong>Key Features</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/f1cf4dff5fd1e5279cd9fb10d1b4dd48.avif?t=1793141688" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras_big/f1cf4dff5fd1e5279cd9fb10d1b4dd48.webp?t=1793141688 width=1560 height=882 /></span></p><p class="bb_paragraph" ><strong>Desktop Interactions</strong></p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Solo &amp; Pair Actions:</strong> dance duets, hold hands, play tag, fight, exchange gifts, fly around, and more.</p></li><li><p class="bb_paragraph" ><strong>User Interaction:</strong> Pair reacts to your cursor, pick up characters, feed them Food</p></li><li><p class="bb_paragraph" ><strong>Pet</strong> : A little pet stays with your pair and roams around your screen.</p></li><li><p class="bb_paragraph" ><strong>Custom Dialogue</strong>: Create custom conversations, greetings, nicknames, and unique catchphrases.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/b27b3cac83c703007e41bd528b6ab06d.avif?t=1793141688" alt=""width=896 height=605 /></span></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/9f290c233a54e221cdc8793b234a9bd0.avif?t=1793141688" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras_big/9f290c233a54e221cdc8793b234a9bd0.webp?t=1793141688 width=1560 height=1179 /></span></p><p class="bb_paragraph" ><strong>Character Pair Customization</strong> </p><ul class="bb_ul"><li><p class="bb_paragraph" >A variety of customizations to express your creativity</p></li><li><p class="bb_paragraph" >support for up to 30 pairs!</p></li><li><p class="bb_paragraph" ><strong>Support for multiple pair types</strong> lovers / family / friends / enemies  </p></li></ul><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/1562f46370c38f7e2db781e2e8551681.avif?t=1793141688" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras_big/1562f46370c38f7e2db781e2e8551681.webp?t=1793141688 width=1560 height=977 /></span></p><p class="bb_paragraph" ><strong>Create &amp; Share Custom Parts</strong></p><ul class="bb_ul"><li><p class="bb_paragraph" >Add and use your own custom parts.</p></li><li><p class="bb_paragraph" >Export and share your profile files and custom parts with other users. <br><strong> </strong> </p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/5080746e2dcd8d5cbd631ee6958eca78.poster.avif?t=1793141688" width=616 height=402 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/5080746e2dcd8d5cbd631ee6958eca78.webm?t=1793141688" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/5080746e2dcd8d5cbd631ee6958eca78.mp4?t=1793141688" type="video/mp4"></video></span></p><p class="bb_paragraph" ><strong>Bubble Talk (Custom Dialogues)</strong><br>Create your own conversations for your characters.<br>characters will talk to each other automatically!<br>Schedule specific lines to appear at set times and days of the week.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras/e8975aab1ea911fd1a7daaca5cac33e1.avif?t=1793141688" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5082780/extras_big/e8975aab1ea911fd1a7daaca5cac33e1.webp?t=1793141688 width=1560 height=1026 /></span></p><p class="bb_paragraph" ><strong>Focus Mode</strong></p><ul class="bb_ul"><li><p class="bb_paragraph" >Focus Timer</p></li><li><p class="bb_paragraph" >To-do Checklist</p></li><li><p class="bb_paragraph" >Water Tracker</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Pair Connect</strong></p><p class="bb_paragraph" >Connect with friends via Steam and Share reactions</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >...and many more features to come!</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >No AI was used for any of the art. All visual assets are 100% human-made.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >_______</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >UI Sound Effects by lolurio</p><p class="bb_paragraph" >Music: &quot;blossom&quot;, &quot;regrowth wip&quot;, &quot;town&quot; by chajamakesmusic</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Licensed under CC BY 4.0 </p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
					<div class="sysreq_tabs">
									<div class="sysreq_tab active" data-os="win">
						Windows					</div>

							var StoreDefaults = {"PartnerEventStore":[{"gid":"746066581090468405","clan_steamid":"103582791475294940","event_name":"Cranked Demo Update - Patch Notes","event_type":13,"appid":3989790,"server_address":null,"server_password":null,"rtime32_start_time":1792177440,"rtime32_end_time":1792182601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"TRICKS! \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"07f4a93832e17428942d6c5b18b48c580fb85b1c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"746066581090468406","clanid":"45773532","posterid":"0","headline":"Cranked Demo Update - Patch Notes","posttime":1792177481,"updatetime":1792177481,"body":"[h1]Cranked Update - October 16, 2026[\/h1]\n\n[h2]New Stuff[\/h2]\n[list]\n[*] Our first tricks have landed in Cranked! No handers and no footed can can. These are early versions and still a WIP.\n[list]\n[*] RB + R stick up (keyboard: Left Ctrl + Space) - no hander\n[*] RB + R stick right (keyboard: Left Ctrl + Right Arrow) - no footed can can\n[*] Tricks count for trick challenges and score in the Freeride event\n[\/list]\n[*] Trail Builder: build your own maps in a new in-game editor. Patreon members only for now. Very early test, so expect rough edges and tell us what breaks.\n[*] Player Profile: lifetime stats, achievements, trail records and showcase pins now track your riding\n[*] Sign in with Steam: your rider and progress follow your Steam account to any machine\n[*] New Race Gate Color Assistance setting: the next gate glows in a colour you pick\n[*] New Lead Foot setting: choose which foot sits forward when you stop pedaling\n[*] New Achievement Pop-ups setting\n[*] New Show Mini Leaderboard setting: toggle whether the mini leaderboard stays up while you race Fast Time and Downhill events\n[\/list]\n\n[h3]New Trails[\/h3]\n[list]\n[*] Perfect Blue\n[*] Pitch Black\n[\/list]\n\n[h2]Improvements[\/h2]\n[list]\n[*] Bunny hops no longer need a hold: crouch and flick up for a full hop, flick from neutral for a half hop\n[*] Downhill event improvements:\n[list]\n[*] Timer for grace period\n[*] Spectator chat and voice chat now show up while spectating\n[*] 20-second double-beep warning to let you know you're about to drop in\n[*] An improved full finals results leaderboard\n[\/list]\n[*] Event finishes always say what the run did to your standing\n[*] Spectate camera eases in when terrain blocks the view instead of snapping to the rider\n[*] Remote riders now turn their heads\n[*] Chat and voice icons stay on screen with the HUD hidden\n[*] Jumps post one toast line again: length, height, airtime\n[*] Crash g-force now reads a realistic figure\n[*] Live readout says Manual without pedalling, Wheelie once the pedals turn\n[*] Vertigo has its difficulty rating; Acrophobia and Radiation Ridge trail lines follow their race gates\n[*] New pedal animation\n[*] Forest grass is narrower and shorter across the whole map\n[*] Rider stays steady over the bike through rough terrain\n[*] Screen space cavity effect turned off in the Forest\n[\/list]\n\n[h2]Bug Fixes[\/h2]\n[list]\n[*] HUD button prompts show the key you actually have, and follow rebinds\n[*] Resolution setting shows the size the game is really running\n[*] Fixed some trails where the timing gate splits were off\n[*] Lobby, map markers and player list show everyone on the server again\n[*] A failed online join always returns you to the main menu with the reason\n[*] Fixed start position for the Lakeside Freeride event\n[*] Lakeside Freeride tricks count for gold more reliably\n[*] Distant Forest bushes no longer show neon-lime dots\n[*] Landing from a teleport or respawn no longer counts as a jump\n[\/list]\n\n[h2]Balance Changes[\/h2]\n[list]\n[*] Brake force increased by 50%, and the e-bike brakes have been improved to be the same as the trail bike\n[*] Swiveling sideways under braking has been nerfed a bit\n[*] Whips count with the bike up to 65 degrees off on landing\n[*] Event length now follows the trail's world record: 8 to 15 minutes depending on the trail, for Fast Time and downhill qualifying\n[\/list]","commentcount":0,"tags":["mod_reviewed","ModAct_1878895840_1792183493_0"],"language":0,"hidden":0,"forum_topic_id":"568174540165776338","event_gid":"746066581090468405","voteupcount":16,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568174540165776338","rtime32_last_modified":1793303457,"news_post_gid":"0","rtime_mod_reviewed":1792183494,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792177369,"votes_up":16,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"688617061539125587","gidfeature2":"568174540165776338"},{"gid":"686393161428241297","clan_steamid":"103582791475294940","event_name":"Cranked Demo Update - Patch Notes","event_type":13,"appid":3989790,"server_address":null,"server_password":null,"rtime32_start_time":1791576060,"rtime32_end_time":1791581401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Multiplayer performance, DH race mode improvements, and more! \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b4aae47dce5d9ec06d1cbee64518c1833e00c72e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"686393161428241298","clanid":"45773532","posterid":"0","headline":"Cranked Demo Update - Patch Notes","posttime":1791576068,"updatetime":1791576068,"body":"[h1]Cranked Update - October 9, 2026[\/h1]\n\n[h2]New Stuff[\/h2]\n[list]\n[*] New PB Messages setting hides other riders' PB chat lines. World records get their own message and always show.\n[*] The map can be rebound in Controls\n[*] Server browser shows each server's region, lists official servers first, then everything A-Z\n[\/list]\n\n[h2]Improvements[\/h2]\n[list]\n[*] Big multiplayer performance pass: riders beyond 150 m are no longer replicated, other riders' bike lights only switch on near you, E-bike riders cost less to render, and event leaderboards and spectating stay smooth on busy servers\n[*] Nametags of far-away riders are hidden (they were unreadable dots anyway)\n[*] Downhill finals: top 15 only, faster drops, AFK riders skipped, and a compact live board\n[*] Downhill qualifying follows Restart At Checkpoints. With it off, restart sends you back to the top. Finals is unchanged.\n[*] Voting before a Downhill Race counts: the vote that opens is the Downhill's, keeps your vote, and says which event it is for\n[*] Fast Time events no longer start when they could run into a scheduled Downhill Race\n[*] Closing a local Downhill event closes it on every station\n[*] ONLINE picks a server with room instead of always the same one. A full server now says so, and a failed join keeps the menu backdrop.\n[*] Respawning in third person no longer swings or zooms the camera: it starts behind you, at its resting spot\n[*] B in drone mode gets you back on the bike where you crashed instead of sending you to your spawn marker\n[*] The Control Hints setting hides the drone view hints too\n[*] The Social menu opens on the Lobby tab\n[*] Text chat is left-aligned, with long messages wrapping neatly under themselves\n[*] Trail waypoints point to the start of the trail, not its map label\n[*] Map opens on you (and your drone), the drone icon is back and matches your player marker, and event standings fit on screen\n[*] FPS Cap greys out while V-Sync is on (V-Sync sets the framerate)\n[*] Acrophobia has had a full revamp\n[*] Radiation Ridge tweaked based on your feedback\n[*] T-shirts re-skinned: smoother armpits and shoulders, the male tee no longer shows the pants when riding, hoodie cuff fix, texture updates, and a female cargo pants refresh\n[\/list]\n\n[h2]Bug Fixes[\/h2]\n[list]\n[*] Chat and voice keep going while you spectate\n[*] Possible fix for wheels clipping into objects. Let us know if this feels better or if they still clip.\n[*] Fixed the bike pitching in weird directions during spins\n[*] Fixed a duplicate gate on ROYGBIV causing false race fails\n[*] Fixed a trail issue on Gusto\n[*] 1199 checkpoint restarts no longer drop you under the map\n[*] Distant bushes in Forest no longer show up as pale mint dots\n[*] Screen space cavity no longer outlines riders, bikes or grass\n[*] The Lift Pass can no longer get stuck after a milestone reveal\n[*] One Armed Scissor, Rock Merchant and Prancy Stardust count as ridden once you have ridden both halves\n[*] Vote trail colours are fixed on the map\n[*] Customization is no longer dark on the Low quality setting\n[*] Rad Dog t-shirt skinning fixed\n[*] The FPS Limit value no longer overlaps the slider at 240 fps\n[*] \"Disconnected\" is spelled right in chat when a player leaves\n[\/list]\n\n[h2]Balance Changes[\/h2]\n[list]\n[*] In-Air Rotation Assist now defaults to Lean Only\n[\/list]","commentcount":7,"tags":["mod_reviewed","ModAct_1751656904_1791576773_0"],"language":0,"hidden":0,"forum_topic_id":"582810614213144708","event_gid":"686393161428241297","voteupcount":15,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582810614213144708","rtime32_last_modified":1793303459,"news_post_gid":"0","rtime_mod_reviewed":1791576774,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791575999,"votes_up":15,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"688617061539125587","gidfeature2":"582810614213144708"},{"gid":"703282928078034662","clan_steamid":"103582791475294940","event_name":"Cranked Patch Notes","event_type":12,"appid":3989790,"server_address":null,"server_password":null,"rtime32_start_time":1792870800,"rtime32_end_time":1792875601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Bunch of improvements to the replay editor\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"e3da8138109ee8c159b5e336d8e3026e3d531e25.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"07f4a93832e17428942d6c5b18b48c580fb85b1c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"703282928078034663","clanid":"45773532","posterid":"0","headline":"Cranked Patch Notes","posttime":1792870857,"updatetime":1792870857,"body":"[h1]Cranked Update - October 23, 2026[\/h1]\n\n[h2]Improvements[\/h2]\n[h3]Replay Editor[\/h3]\n[list]\n[*] Video export: new encoder, sharper exports with no dropped frames, exports now work on Mac and Linux\n[*] Choose where videos and photos save, in Videos and Screenshots folders\n[*] Export at 30 or 60 fps\n[*] Camera turns and moves slower when zoomed in, and held scrub speeds up\n[*] Free camera goes up to 400 mm with no tilt limits, and orbit can go under the bike\n[*] Keyframes only select when you're exactly on them, and mouse drag scrubs the timeline\n[\/list]\n\n[h2]Bug Fixes[\/h2]\n[list]\n[*] Customize from the main menu shows the gear you've earned instead of everything locked\n[*] Replay editor: the 8-15 mm lens's inner ring is gone, with fewer hitches when zooming\n[*] Replay editor: chairs and props no longer pop in on the first frame of a cut\n[\/list]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1751656904_1792871458_0"],"language":0,"hidden":0,"forum_topic_id":"568175240219262533","event_gid":"703282928078034662","voteupcount":8,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175240219262533","rtime32_last_modified":1793302823,"news_post_gid":"0","rtime_mod_reviewed":1792871458,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792870736,"votes_up":8,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"688617061539125587","gidfeature2":"568175240219262533"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["746066581090468406","686393161428241298"],"last_update_event":{"rtime":1792870800,"event_gid":"703282928078034662","announcement_gid":"703282928078034663","clan_account_id":45773532}}};
						</script>
					


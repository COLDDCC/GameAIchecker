null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"671757096278034084","clanid":"46008704","posterid":"0","headline":"Check out our demo in this Next Fest! \ud83d\udc1a","posttime":1792429776,"updatetime":1792429776,"body":"[p]Hello friends!\n[\/p][p]Just popping by quickly today to say our Sandcastle demo is included in Steam Next Fest which has just kicked off! Be sure to check it out, get creative, and share your builds with us! We can\u2019t wait to see what you get up to.\u00a0\n[\/p][p]We have some very exciting news on the way soon so keep your eyes peeled for more announcements \ud83d\udc40\n[\/p][p]-Bubblebird Studio[\/p][p]\n[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_783923276_1792441039_0"],"language":0,"hidden":0,"forum_topic_id":"569300630414396465","event_gid":"671757096278034083","voteupcount":67,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569300630414396465","rtime32_last_modified":1793314299,"news_post_gid":"0","rtime_mod_reviewed":1792441039,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792420670,"votes_up":67,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"845132006378657318","gidfeature2":"569300630414396465"},{"gid":"672876654794637448","clan_steamid":"103582791475530112","event_name":"First demo out now!","event_type":28,"appid":3216520,"server_address":null,"server_password":null,"rtime32_start_time":1786032060,"rtime32_end_time":1786035660,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Get ready to dive in \ud83c\udf0a\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7dcfff6ea8456a4330ebad11ef42c221650edcbf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"672876654794637449","clanid":"46008704","posterid":"0","headline":"First demo out now!","posttime":1786032072,"updatetime":1786033116,"body":"[p]Hello beach lovers![\/p][p][\/p][p]I\u2019m so excited to announce that Sandcastle\u2019s first demo is OUT NOW! You can check out our very special demo trailer here:[\/p][p][\/p][previewyoutube=\"1miveZK4mXU;full\"][\/previewyoutube][p][\/p][p]I can\u2019t wait for you all to dive in, but first I\u2019d like to say a huuuuuuggeeeee thank you for 185k wishlists! I\u2019m so amazed that so many of you have found my game![\/p][p][\/p][p]Secondly, a big thank you to the Wholesome team for including [i]Sandcastle [\/i]in the Wholesome Games Steam Celebration this week! Be sure to go check out all the other lovely titles![\/p][p][\/p][p]Okay now you can go ahead and start building, digging, collecting and most of all having fun![\/p][p][\/p][p]I hope you love the demo \u2665\ufe0f[\/p][p]-Bubblebird Studio[\/p][p]\n[\/p]","commentcount":40,"tags":["mod_reviewed","ModAct_1889321037_1786032471_0","ModAct_1889321037_1786032697_4","ModAct_1889321037_1786034714_4"],"language":0,"hidden":0,"forum_topic_id":"588434161796254108","event_gid":"672876654794637448","voteupcount":232,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1786032060,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588434161796254108","rtime32_last_modified":1792672649,"news_post_gid":"0","rtime_mod_reviewed":1786034715,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1785929481,"votes_up":232,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"845132006378657318","gidfeature2":"588434161796254108"},{"gid":"689766422328378961","clan_steamid":"103582791475530112","event_name":"Demo 0.31.0 Patch","event_type":12,"appid":3216520,"server_address":null,"server_password":null,"rtime32_start_time":1787583120,"rtime32_end_time":1787587201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Better water simulation and more!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"47f8e602972a4aeb7d1a16b85db8161a52759263.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"689766422328378962","clanid":"46008704","posterid":"0","headline":"Demo 0.31.0 Patch","posttime":1787583168,"updatetime":1787583168,"body":"[p]Hi![\/p][p][\/p][p]The first patch for Sandcastle Demo is available! The main improvement is the water simulation: digging holes won't make water appear from nowhere anymore, and in general, the amount of water stays much more stable now![\/p][p]I've also reduced the speed at which the sand collapses by default! The sun intensity and clouds will now also affect how quickly the sand dries.[\/p][p][\/p][p]Here is the full list of changes:[\/p][list][*][p]Improved: Removed cursor toggle hotkey, changed HUD visibility toggle hotkey to F8[\/p][\/*][*][p]Fixed: Water simulation reworked to fix infinite spawn[\/p][\/*][*][p]Fixed: Water doesn't glitch in corners anymore[\/p][\/*][*][p]Fixed: No more water spawning when shoveling[\/p][\/*][*][p]Fixed: Water level stays more stable[\/p][\/*][*][p]Improved: Slowed down erosion and evaporation speed by default[\/p][\/*][*][p]Improved: Demo chip placed on left and hint chip moved in header[\/p][\/*][*][p]Added: Audio volume sliders[\/p][\/*][*][p]Improved: Sun intensity and cloud shadows will impact sand drying speed[\/p][\/*][*][p]Fixed: Console and controls editor windows height adapts to screen[\/p][\/*][*][p]Improved: Time scale resets when leaving the beach[\/p][\/*][*][p]Added: Water viscosity supported, with a slider in the simulation settings[\/p][\/*][*][p]Improved: More color contrast between dry and wet sand[\/p][\/*][*][p]Improved: More stable boundary condition (water)[\/p][\/*][*][p]Improved: UI footer hides when using a tool[\/p][\/*][*][p]Improved: Settings are grouped in categories (general video, audio)[\/p][\/*][*][p]Removed: Air & ground swap buffers (Reduces memory footprint and CPU cycles)[\/p][\/*][*][p]Improved: Water waves presets (calmer, in general)[\/p][\/*][*][p]Fixed: Sliders sliding sound not triggered on initial value set[\/p][\/*][*][p]Fixed: Small translation errors[\/p][\/*][*][p]Fixed: Click on background of water and resolution selection windows close them[\/p][\/*][*][p]Added: Cross version compatibility system[\/p][\/*][*][p]Fixed: Play time properly reset on beach change[\/p][\/*][*][p]Fixed: Better support for ultrawide screens[\/p][\/*][*][p]Fixed: Water visibility glitches on steep ground[\/p][\/*][*][p]Added: Support for negative water inflow for future tools[\/p][\/*][\/list][p][\/p][p]Let me know what you think![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46008704\/945646b2aade7e1890245931827ac61a94bf8762.gif\"][\/img][\/p]","commentcount":17,"tags":["patchnotes","mod_reviewed","ModAct_1894963720_1787585545_0"],"language":0,"hidden":0,"forum_topic_id":"591813437999486604","event_gid":"689766422328378961","voteupcount":82,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"591813437999486604","rtime32_last_modified":1792869781,"news_post_gid":"0","rtime_mod_reviewed":1787585545,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1787579605,"votes_up":82,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"845132006378657318","gidfeature2":"591813437999486604"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["671757096278034084","672876654794637449"],"last_update_event":{"rtime":1787583120,"event_gid":"689766422328378961","announcement_gid":"689766422328378962","clan_account_id":46008704}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >Sandcastle is the ultimate sandbox game. Unlock a variety of tools to gather wet sand, shape towering walls, carve intricate battlements, and engineer elaborate moats designed to withstand or divert the encroaching waves.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/d7dc6bb7dcad73bac5d7b86b941ea2d8.poster.avif?t=1791209243" width=1170 height=420 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/d7dc6bb7dcad73bac5d7b86b941ea2d8.webm?t=1791209243" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/d7dc6bb7dcad73bac5d7b86b941ea2d8.mp4?t=1791209243" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>No rush, just relax</strong></p><p class="bb_paragraph" >There are no ticking clocks. Only the slow rhythm of the tide and the warm glow of the sun. Discover secret treasures washed ashore or buried deep into the sand, each adding a touch of personality to your sandy masterpiece.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/9e194cf6848b1ded5c07cc1e1e898703.poster.avif?t=1791209243" width=1170 height=390 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/9e194cf6848b1ded5c07cc1e1e898703.webm?t=1791209243" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/9e194cf6848b1ded5c07cc1e1e898703.mp4?t=1791209243" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Physics simulation</strong></p><p class="bb_paragraph" >Beneath the whimsy lies a unique water and sand physics simulation that brings your creations to life. Sand compacts, crumbles, and holds its shape depending on moisture and pressure, while waves flow, pool, and gently erode your walls just as they would in reality. Carve too thin and a tower may slump; reinforce with damp sand and it will stand proud against the tide. The result is a tactile, authentic sand castle crafting experience that feels just like building one on a real beach: sun-warmed, hands-on, and wonderfully satisfying.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/1dc30fabe8a277491e6af06240c88c81.poster.avif?t=1791209243" width=1170 height=458 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/1dc30fabe8a277491e6af06240c88c81.webm?t=1791209243" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/1dc30fabe8a277491e6af06240c88c81.mp4?t=1791209243" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Beach customization</strong></p><p class="bb_paragraph" >Collect starfishes to unlock customization options: Sand type, beach layout, size... Give your beach its own character and charm. Peaceful atolls ringed by turquoise waters, quiet lagoons with gentle shallows, sweeping sand barriers shaped by the breeze, and winding deltas where little streams meet the sea. Every shoreline offers a fresh canvas, inviting you to build, decorate, and relax in a new seaside setting.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/2eab48898f5f172a40ffea7012ad9050.poster.avif?t=1791209243" width=1170 height=462 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/2eab48898f5f172a40ffea7012ad9050.webm?t=1791209243" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/2eab48898f5f172a40ffea7012ad9050.mp4?t=1791209243" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Features</strong></p><ul class="bb_ul"><li><p class="bb_paragraph" >Beaches with unique water and sand physic simulation</p></li><li><p class="bb_paragraph" >Many tools to craft your castle with precision</p></li><li><p class="bb_paragraph" >10 different beach layouts to unlock (lagoon, island, sand barrier, delta...)</p></li><li><p class="bb_paragraph" >Colorful and relaxing tropical sceneries</p></li><li><p class="bb_paragraph" >Many hidden objects to find and collect</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/40ec44464a89f97ffa6ae771785be68d.poster.avif?t=1791209243" width=1170 height=464 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/40ec44464a89f97ffa6ae771785be68d.webm?t=1791209243" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3216520/extras/40ec44464a89f97ffa6ae771785be68d.mp4?t=1791209243" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p>						</div>
					</div>
				
				
				

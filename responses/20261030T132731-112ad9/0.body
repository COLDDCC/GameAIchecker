ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"708912427613296269","clanid":"46212581","posterid":"0","headline":"Last weekend of Steam Next Fest!","posttime":1792837845,"updatetime":1792837845,"body":"It's the last weekend of Steam Next Fest! The Banana Airways demo is free on Steam.\n\nBanana Airways reached the top 20 demos of Steam Next Fest by players online at the same time (out of 7,000+), with over 1,000 people playing at once.\nThanks to everyone who flew with us!\n\nGrab up to 5 friends, fix the plane, serve the coffee and keep an eye on the baby. Leave him alone and he might take the controls :)\n\nIf you had fun, a wishlist helps us a ton during Next Fest :)","commentcount":2,"tags":["mod_reviewed","ModAct_1889357040_1792838289_0"],"language":0,"hidden":0,"forum_topic_id":"564797531878367005","event_gid":"708912427613296268","voteupcount":2,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797531878367005","rtime32_last_modified":1793156487,"news_post_gid":"0","rtime_mod_reviewed":1792838290,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792760513,"votes_up":2,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"567048404945138604","gidfeature2":"564797531878367005"},{"gid":"708912427613293759","clan_steamid":"103582791475733989","event_name":"Demo Update: Early Adopter Badge, Host Migration and a New Very Low Preset","event_type":13,"appid":4835560,"server_address":null,"server_password":null,"rtime32_start_time":1792624620,"rtime32_end_time":1792629001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Now live in the free demo: a gift for everyone who has been flying with us since the beginning\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Now live in the free demo: claim your Early Adopter badge from the main menu! Plus: hosts can now kick disruptive players, host migration and a new Very Low preset.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"faeecdc6c4022b58c4a9708324c36ceb968fb240.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"3d98987ea072dd874bbb222366f48f494ccfd29c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"708912427613293760","clanid":"46212581","posterid":"0","headline":"Demo Update: Early Adopter Badge, Host Migration and a New Very Low Preset","posttime":1792624680,"updatetime":1792624680,"body":"[i]This update is live now in the free Banana Airways demo.[\/i]\n\n[h2]\ud83c\udfc5 Early Adopter Badge[\/h2]\nAlready beat the game? Jump in and claim yours: it's waiting for you on the main menu.\nThis one is a gift for you. We never expected this much support, and we want to reward everyone who has been flying with us since the beginning.\nNew to Banana Airways? Beat First Class to earn it, then tell us what you think in a quick survey.\n\n[h2]\ud83d\udee1\ufe0f Hosts Can Now Kick Players[\/h2]\nYou asked for it on Discord, and it's here: [b]hosts can now kick disruptive players out of their flight[\/b], from the Esc menu or the TAB panel. Kicked players can't rejoin that flight.\n\n[h2]\u2708\ufe0f Quality of Life[\/h2]\n[list]\n[*][b]The flight goes on when the host leaves.[\/b] If the host disconnects, another player becomes the new host and the whole crew keeps flying together.\n[*][b]Crew panel:[\/b] hold [b]TAB[\/b] to see who's on board without stopping the game. Right-click for options: view profile, add friend or mute.\n[*][b]Crew alerts:[\/b] you'll get a notice when a crewmate falls off the plane or leaves the flight.\n[*][b]New \"Very Low\" graphics preset[\/b] for lower-end PCs and integrated graphics. Much smoother on weaker machines.\n[\/list]\n\n[h2]\ud83c\udf0f Localization[\/h2]\n[list]\n[*]Improved many Chinese texts.\n[\/list]\n\n[h2]\ud83d\udd27 Fixes and Optimizations[\/h2]\n[list]\n[*]Various visual fixes and optimizations.\n[*]Various collider fixes.\n[\/list]\n\nThank You Bananas","commentcount":1,"tags":["mod_reviewed","ModAct_803139239_1792626905_0"],"language":0,"hidden":0,"forum_topic_id":"564797239535488869","event_gid":"708912427613293759","voteupcount":1,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797239535488869","rtime32_last_modified":1793156437,"news_post_gid":"0","rtime_mod_reviewed":1792626905,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792622598,"votes_up":1,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"567048404945138604","gidfeature2":"564797239535488869"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["708912427613296269","708912427613293760"],"last_update_event":{"rtime":1792624620,"event_gid":"708912427613293759","announcement_gid":"708912427613293760","clan_account_id":46212581}}};
						</script>
					


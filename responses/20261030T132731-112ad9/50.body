																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"701031762452547243","clan_steamid":"103582791475768005","event_name":"Update 1.0.8: interchanges ban turns across the main road, one-click turn bans","event_type":13,"appid":5028050,"server_address":null,"server_password":null,"rtime32_start_time":1793305020,"rtime32_end_time":1793309401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"0334f2468b7b3ea3e2e53cc441c6b6dc8925e100.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"dc78f402b90e880e0892a3d86bb673baab56f988.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"701031762452547244","clanid":"46246597","posterid":"0","headline":"Update 1.0.8: interchanges ban turns across the main road, one-click turn bans","posttime":1793305040,"updatetime":1793305040,"body":"[p]Update 1.0.8 is out. Steam installs it automatically. Most of it came from your reports, here in the discussions and on Discord.[\/p]\n\n[img]{STEAM_CLAN_IMAGE}\/46246597\/2d79df121b2518a7b4ef094c6f1f8cbbee3d61e3.png[\/img]\n\n[h2] New [\/h2]\n[list]\n[*][b]Interchanges ban the turns across the main road.[\/b] On roads without a median, a new interchange puts no-turn signs where a ramp meets the main road, so cars use the ramps instead of turning across traffic. The signs are in the price.\n[*][b]Ban left and U-turns.[\/b] A new button in the lane connector removes the left turns and U-turns at a junction in one click. Apply to place the signs, Cancel to drop it. Reset junction now also removes the turn bans there.\n[*][b]Centre line goes on.[\/b] The centre line now continues where two different roads meet and into junctions, and it stays solid where a turn is not allowed.\n[*]Custom traffic light phases are kept when you add a receiving lane next to a turn lane.\n[*]A right-turn lane before a slip road off a one-way road now leads straight into the slip road, so trucks no longer cross every lane to reach it.\n[\/list]\n[p][\/p]\n[h2] Smaller changes [\/h2]\n[list]\n[*]When a building's countdown is close to running out, the game pauses once so you have time to react. You can turn it off in Settings.\n[*]Challenges: Keep Building stops a running test so you can fix your roads, and it is also there after a pass.\n[*]Brightness slider in Settings, under Graphics.\n[*]Loading another city could in rare cases mix the two cities into one. Fixed, and a load that fails now returns to the menu without touching the save.\n[*]No orange dead-end marker is left on a road end after a roundabout or interchange joins it.\n[*]Visual fixes for stop lines and sidewalks where roads of different width meet.\n[\/list]\n[p][\/p]\n[h2] Since 1.0.7 [\/h2]\n[p]The two 1.0.7 hotfixes were only announced on Discord. The main changes in them:[\/p]\n[list]\n[*]Traffic lights keep your green times, custom phases and phase order when you add a turn lane, upgrade a road or connect a new road. Turn lanes are kept when you upgrade the road.\n[*]Turn lanes work on bridges, and turn lanes from both ends of a road can meet.\n[*]Much less lag right after building or upgrading a road.\n[*]STOP signs: cars wait for a gap instead of cutting in and blocking roundabouts.\n[*]With two left-turn lanes, cars use both.\n[*]Continue no longer opens an older city when the newest save is damaged.\n[*]Roundabouts on angled roads no longer turn red after the first click.\n[*]Linux \/ Steam Deck: the window opens properly.\n[\/list]\n[p][\/p]\n[p]Thanks to everyone who posted feedback and bug reports. Keep them coming, here in the discussions or on Discord. The full game comes out on November 3.[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_487176015_1793305414_0"],"language":0,"hidden":0,"forum_topic_id":"570427373261098846","event_gid":"701031762452547243","voteupcount":6,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570427373261098846","rtime32_last_modified":1793323279,"news_post_gid":"0","rtime_mod_reviewed":1793305414,"featured_app_tagid":0,"referenced_appids":[],"build_id":26306609,"build_branch":"","unlisted":0,"rtime_created":1793304999,"votes_up":6,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"580552862448315225","gidfeature2":"570427373261098846"},{"gid":"719045526774880833","clan_steamid":"103582791475768005","event_name":"Demo update 1.0.7: ground-level bridges and tunnels, interchanges anywhere","event_type":13,"appid":5028050,"server_address":null,"server_password":null,"rtime32_start_time":1793040060,"rtime32_end_time":1793044801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"f13d75da74490cb79b5aec0c70749927e242792d.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c6f3395eec699462382dfc7fd7e865fe099d8c6a.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"719045526774880834","clanid":"46246597","posterid":"0","headline":"Demo update 1.0.7: ground-level bridges and tunnels, interchanges anywhere","posttime":1793040068,"updatetime":1793040068,"body":"[p]The demo has a new update, 1.0.7. Steam installs it automatically. Most of it came from your reports, here in the discussions and on Discord.[\/p]\n\n[img]{STEAM_CLAN_IMAGE}\/46246597\/2cbaeb4a3c527f62fc31dd891d5c665b70ff256a.jpg[\/img]\n\n[h2] New [\/h2]\n[list]\n[*][b]Ground-level bridge and tunnel.[\/b] The Bridge and Tunnel buttons now have levels; press B or T again to switch. A ground-level bridge crosses a river at road height with no ramps, and a ground-level tunnel goes straight through a mountain. One drag becomes road on land, bridge over water and tunnel through rock.\n[*][b]Interchanges anywhere.[\/b] The Interchange tool no longer needs an existing crossing. On open ground the preview follows the cursor: click to place it, then turn each road (it snaps to nearby roads and to right angles). On a single road it lines up with that road, and at a road's dead end it carries the road on. It builds its own roads in the class you pick, and one Ctrl+Z on pause takes it all back.\n[*][b]Custom rules.[\/b] When you start a New City, a Custom rules panel lets you make single rules harder than the difficulty you picked. The city's name shows it, for example \"Easy +2\".\n[*][b]Undo shows what it gives back.[\/b] While paused, a tag next to your balance shows how much you can still get back. Ctrl+Z also puts back the trees a build cleared, and their cost. Converting a road and converting it back in the same pause returns the money.\n[*][b]Convert by dragging.[\/b] Drag the Convert tool across roads to convert every road you cross.\n[*][b]Drag panels aside.[\/b] The traffic light, sign and turn-ban panels can be dragged by their title. Double-click the title to put them back.\n[*][b]Car horns setting.[\/b] Turn car horns off in Settings.\n[*][b]Camera button.[\/b] Photo mode and Follow car are now in a button on the top bar. The Delete key demolishes, like X.\n[\/list]\n[p][\/p]\n[h2] Traffic [\/h2]\n[list]\n[*]Multi-lane roundabouts: the outer lane exits and the inner lanes go round, so an inner lane no longer cuts across the outer one.\n[*]Traffic lights show a left or right arrow for a turn that has its own phase. New lights start with a green time that fits the road.\n[*]On a road with a bus lane, buses turn left from the turn lane instead of across the straight lanes.\n[*]Cars on a road merging into a divided road at a shallow angle (like a bridge coming down beside it) no longer cut across the median and turn back.\n[*]A car changing into a lane with a queue no longer gets stuck next to it.\n[*]The warning about a road that never gets a green no longer appears by mistake after you switch a light's preset.\n[*]Bus lines explain long waits by their real cause: the line just started, buses stuck in traffic (including a jammed hub), buses bunched together, or too few buses. A new line's first bus picks up passengers at the hub.\n[*]Trucks with a trailer now bend in turns.\n[\/list]\n[p][\/p]\n[h2] Building roads [\/h2]\n[list]\n[*]Roundabouts refuse much less: roads inside the ring are removed, crossing roads become exits, and nearby side streets join it. When a ring really can't fit, it says why.\n[*]Ctrl+Z on a roundabout or interchange puts the crossing back as it was.\n[*]Interchanges work on roads drawn in pieces, the cloverleaf fits better, and turn lanes or bus lanes at the crossing are taken off instead of refusing the build.\n[*]Roads can be built right up to a riverbank.\n[*]Extending a road by a short straight piece is no longer refused as too short.\n[*]The turn-lane tool names the kinds that fit when the one you picked doesn't. A turn-lane edit that can't join the road back is refused instead of leaving the road in pieces.\n[*]A curve drawn across a junction no longer stacks duplicate roads.\n[*]A bridge or tunnel dragged across another bridge or tunnel no longer lays a tangle of tiny pieces or cuts the roads it passes over or under.\n[*]Lane connector: asks Apply or Discard before you leave, sits above the toolbar, and clicks on a line select its lane.\n[*]One-way tunnels show their direction.\n[*]Divided roads are now called \"2-Lane Divided Road\" and \"4-Lane Divided Highway\", and their buttons explain what the median does.\n[*]Visual fixes for bridge ramps, bridge columns, curved one-way merges and split bridges.\n[\/list]\n[p][\/p]\n[h2] Game [\/h2]\n[list]\n[*]Menus grow with the window, so they are no longer half size on a 4K screen. The UI Scale slider shows the size the interface really gets.\n[*]The interface no longer shakes at some window sizes.\n[*]The challenge list scrolls, with the title and Back button always on screen.\n[*]The tutorial runs only on Easy. The Home button works during the tutorial.\n[*]Trip reports stay up long enough to read.\n[*]Junction letters stay readable at any zoom, and junction panels stay open while you move the camera.\n[*]While following a car, how to stop is shown on screen the whole time.\n[*]Settings such as car horns and building detail distance are remembered between launches.\n[*]City Holiday: a queue that empties during the holiday drops its overload bar at once.\n[*]One soundtrack was much louder than the others; it now plays at the same level.\n[\/list]\n[p][\/p]\n[p]Thanks to everyone who posted feedback and bug reports. Keep them coming, here in the discussions or on Discord. The full game comes out on November 3.[\/p]","commentcount":5,"tags":["mod_reviewed","ModAct_783923276_1793041488_0"],"language":0,"hidden":0,"forum_topic_id":"569301136948078529","event_gid":"719045526774880833","voteupcount":23,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301136948078529","rtime32_last_modified":1793290348,"news_post_gid":"0","rtime_mod_reviewed":1793041488,"featured_app_tagid":0,"referenced_appids":[],"build_id":25857270,"build_branch":"","unlisted":0,"rtime_created":1793037872,"votes_up":23,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"580552862448315225","gidfeature2":"569301136948078529"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["701031762452547244","719045526774880834"],"last_update_event":{"rtime":1793305020,"event_gid":"701031762452547243","announcement_gid":"701031762452547244","clan_account_id":46246597}}};
						</script>
					


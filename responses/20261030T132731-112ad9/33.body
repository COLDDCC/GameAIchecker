l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"669505296465397894\",\"clone_from_sale_enabled\":false,\"library_spotlight\":true}","announcement_body":{"gid":"680765564125184464","clanid":"45889178","posterid":"0","headline":"Spirit Crossing is launching on November 16, 2026!","posttime":1793200145,"updatetime":1793210248,"body":"[h2]Spirit Crossing is launching on November 16, 2026![\/h2][p][\/p][p][b]You will be able to continue playing the Steam demo until November 9, 2026. All of your Steam demo progress will transfer to the full game at launch.[\/b]\n\nIf you haven't already, giving us a wishlist will help us immensely in the coming weeks![\/p][p][\/p][p]\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/2321960\/Spirit_Crossing\/\"][\/dynamiclink][\/p][p]Thank you so much to all of our long-term play-testers who followed us from mobile, our new PC play-testers from this year, and all of you who've just recently joined us with the launch of our demo.\n\nWe wouldn't be here sharing news like this without all of your support, feedback and tremendous knacks for bug finding. [\/p][p][\/p][p]We\u2019ll be in [url=\"https:\/\/discord.gg\/spirit-crossing\"]Discord[\/url] and in the [url=\"https:\/\/steamcommunity.com\/app\/2321960\/discussions\/\"]discussion forums[\/url] to continue answering your questions as we head toward launch. <3\n [\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/fea06cdfeb9fd036f856a32aa70606adc6b47288.gif\"][\/img]Thank you,\n[i]All the Spry Foxes[\/i]\n[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1894963720_1793204418_0","ModAct_1894963720_1793213135_4"],"language":0,"hidden":0,"forum_topic_id":"573805072990950038","event_gid":"680765564125184463","voteupcount":44,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793200140,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805072990950038","rtime32_last_modified":1793321532,"news_post_gid":"0","rtime_mod_reviewed":1793213135,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793200010,"votes_up":44,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"842866071372353010","gidfeature2":"573805072990950038"},{"gid":"669505296465397894","clan_steamid":"103582791475410586","event_name":"Enjoy the Spirit Crossing demo TODAY during Steam Next Fest!","event_type":28,"appid":2321960,"server_address":null,"server_password":null,"rtime32_start_time":1792432860,"rtime32_end_time":1792433340,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Welcome to your strange new home. \ud83c\udfe0\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"07989510bbba036a18e1964a4bc73ed702c346bc.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ad668004f4014d02c52c19dcf11793dc16b110b3.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"669505296465397895","clanid":"45889178","posterid":"0","headline":"Enjoy the Spirit Crossing demo TODAY during Steam Next Fest!","posttime":1792432913,"updatetime":1793200166,"body":"[p]We\u2019re launching Spirit Crossing later this year, so now\u2019s your last chance to hop in for free, get acquainted with the game's features, meet some little square bears (and of course, people too), and let us know what you think! [\/p][p]\n\ud83e\udea7 [b]NOTE:[\/b] [b]All your demo progress  *will[\/b]*[b] transfer at launch! \n\n[\/b]  [img src=\"{STEAM_CLAN_IMAGE}\/45889178\/7f840106fd2a1828789a64a68248ce73eafc0e33.png\"][\/img][\/p][h3]\ud83d\udce8 Looking to invite a friend? Check out our recruit codes!\n[\/h3][olist][*][p]Generate an Invite Code from the starting screen by clicking on \"Recruit Friends\". In-game, you can do this from the main menu under \"Recruit\". You can also find a \"Recruit\" button on your Friends list, accessible from the main menu.[\/p][\/*][*][p]Look for the \"Generate Invite Code\" option.[\/p][\/*][*][p]Share the code with your friend![\/p][\/*][\/olist][p]\n\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/2321960\/Spirit_Crossing\/\"][\/dynamiclink][\/p][p]If you've been playing the playtest version of the game, this means you'll need to hop over to the demo version of the game today. You can install it by clicking through to the store page above. This will be the same exact game and all of your progress from the playtest will still be present, don't worry! There will even be a small reward waiting for you as a thanks for hopping over.  If this is your first time playing, we\u2019re very excited for you to get started. Let\u2019s tell you a little bit about this game we\u2019ve been working on.. [\/p][p][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/c539874aa3830bd3b46ab53a5c3e48dcef1efcbc.png\"][\/img][\/p][p]Spirit Crossing is our whimsical multiplayer game set in the Crosslands, a storm-swept world above the clouds. Here, you can build a home, help spirits, progress friendships with NPCs, and mingle with other players - all at your own pace.\n\nMake a friend, or just quietly share the same little corner of the world. Our game is built around small acts of kindness, and the way even brief connections can make us feel a little less alone.[\/p][p]\n\n\n[img src=\"{STEAM_CLAN_IMAGE}\/45889178\/623e597e58859d772ed3f441516d5a69ad405732.png\"][\/img][\/p][p]Over the past year and a half, we\u2019ve built a wonderful community of playtesters who have helped shape Spirit Crossing into the game it is today. They share beautiful and hilarious screenshots with us daily, make memes of our beloved characters, give us helpful feedback when things don\u2019t feel quite right (and extremely gracious feedback when things do), and continuously remind us why we started working on this game to begin with.[\/p][p]\n\n[img src=\"{STEAM_CLAN_IMAGE}\/45889178\/fea06cdfeb9fd036f856a32aa70606adc6b47288.gif\"][\/img][\/p][p][\/p][p] We\u2019ll be hanging out in [url=\"https:\/\/discord.gg\/spirit-crossing\"]Discord[\/url] and in the [url=\"https:\/\/steamcommunity.com\/app\/2321960\/discussions\/\"]discussion forums[\/url] throughout Steam Next Fest to answer your questions and respond to your feedback. Before the fest is done, we\u2019ll also be back with another news post to share more about our plans for the game at launch![\/p][p]\n\nThank you,\n[i]All the Spry Foxes[\/i]\n[\/p]","commentcount":19,"tags":["mod_reviewed","ModAct_487176015_1792443551_0","ModAct_1894963720_1793204435_4"],"language":0,"hidden":0,"forum_topic_id":"574930130477118718","event_gid":"669505296465397894","voteupcount":110,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792432860,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930130477118718","rtime32_last_modified":1793246974,"news_post_gid":"0","rtime_mod_reviewed":1793204435,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792429373,"votes_up":110,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"842866071372353010","gidfeature2":"574930130477118718"},{"gid":"694273194214818826","clan_steamid":"103582791475410586","event_name":"15.4 Update: Feast of Bears \ud83d\udc3b","event_type":13,"appid":2321960,"server_address":null,"server_password":null,"rtime32_start_time":1790268240,"rtime32_end_time":1790272801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Autumn has arrived, bringing the Feast of Bears seasonal event along with it! Get witchy, express yourself and more.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Grab your comfiest sweater, because Autumn has arrived in Spirit Crossing with an un-bear-lievable celebration \ud83d\udc3b, new spooky items, and more ways to express yourself in-game. \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"8e9d8fe3640f5e629567345120a2da031333e38a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"685a253952c4219bb81e3c1a3f21268c54f28728.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"694273194214818827","clanid":"45889178","posterid":"0","headline":"15.4 Update: Feast of Bears \ud83d\udc3b","posttime":1790268291,"updatetime":1792434624,"body":"[p]Greetings, wanderers! The 15.4 update is here, and it brings exciting changes including the Feast of Bears seasonal event, a revamp of waystations\u2019 crafting stations and recipes, improvements to tournaments rewards and the pickaxe harvesting mechanic, brand new flairs so you can express yourself and show a lot more of your personality to others, and more!\n\nView the 15.4 trailer and check out the list of changes below:[\/p][p][\/p][previewyoutube=\"T853V7mwNH0;full\"][\/previewyoutube][p][\/p][h1][b]Feast of Bears[\/b][\/h1][p][\/p][p]The leaves are falling in the Crosslands, which means we\u2019re approaching the time for the yearly bear hibernation, and the Feast of Bears celebrations starting on September 30th!! \ud83c\udf42[\/p][p]During this seasonal event, Bears, Humans and Spirits alike express their gratitude for surviving another year, and Bears try to eat as much food as [i]bear-ly[\/i] possible to celebrate the traditional hibernation throughout the winter. It is also a time to reflect on their ancestors and honor the Bears\u2019 origins.[\/p][p]So gather your friends and help the bears in your life observe the Feasting season as they harvest rainbow corn, build offering tables, light candles, and celebrate with dancing and feasting aplenty! If you belong to a waystation, you can also contribute to the Bear Feast Fund to receive additional rewards. Or simply visit the Feast of Bears Merch Store in the Village to buy your very own bear-themed decor and clothing!\u00a0[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/3576c4b2930a37b48f5139d58878746d006bb2af.png\"][\/img][\/p][p][\/p][h1][b]Crafting Stations Rework[\/b][\/h1][p]Since the tool enhancements are now 100% guaranteed to happen, some use cases of the crafting stations\u2019 happiness system became obsolete. It also felt redundant having to have multiple of the same crafting stations, but in different levels, with different (or duplicate) recipes, which was chaotic to coordinate. For that reason, we\u2019re applying a complete rework to crafting stations, based on your feedback and to set the groundwork for upcoming balancing changes before the game is released:[\/p][p][\/p][h2][b]Waystation Crafting Stations[\/b][\/h2][list][*][p]\ud83c\udf1f We are unifying Waystation\u2019s crafting stations to simplify and reduce confusion, redundancy and streamline crafting in waystations \u2013 meaning they no longer have \u201cupgraded\u201d versions[\/p][\/*][*][p]\ud83c\udf1f Crafting stations no longer have recipe limits or require recipe fragments to install crafting recipes on them[\/p][list][*][p]\ud83c\udf1f This will allow for anyone to add recipes to crafting stations, without needing to collect \u201cvotes\u201d (in the form of Recipe Fragments) to make them possible \u2013 you added them, they\u2019re there;[\/p][\/*][\/list][\/*][*][p]Now Waystation Crafting Stations can only contain basic Common and Uncommon recipes[\/p][list][*][p]Seasonal event exclusive Recipes are no longer allowed in waystations crafting stations;[\/p][\/*][*][p]Active members of waystations will all receive Recipe Fragments and Beacon Sparks to compensate for the Recipes that are no longer allowed in waystation crafting stations;[\/p][\/*][*][p]With the removal of recipe caps simplifying installation, we felt this limitation was necessary. Otherwise, Waystation crafting stations would likely end up having every single recipe in the game, which would undermine an individual player\u2019s sense of progression. [\/p][\/*][\/list][\/*][*][p]We\u2019ve also removed the \u201cHappiness\u201d levels from crafting tables;[\/p][\/*][*][p]\ud83c\udf1f Crafting Stations descriptions now mention that the Architect Role is required to purchase them and is locked for lower roles;[\/p][\/*][\/list][p][\/p][h2][b]Crafting and Recipe Fragments[\/b][\/h2][list][*][p]Recipes can be bought with Recipe Fragments, instead of Beacon Sparks. Now is a good time to take the dust off of your unused Recipe Fragments![\/p][\/*][*][p]Recipe Fragments can also be obtained by:[\/p][list][*][p]Purchasing them from Joule, Rudi, in the Decorologist\u2019s Decor Shop or in the Waystation Vending Machine;[\/p][\/*][*][p]Finding them in Wilderness Pots and Chaos Shrines;[\/p][\/*][*][p]Repairing decor items to complete Waystation Goals now grants Recipe Fragments instead of Beacon Energy (Communal Goals will still give out Beacon Energy);[\/p][\/*][\/list][\/*][*][p]Recipe Fragments can be recycled for 3 Coins each;[\/p][\/*][*][p]We have reviewed Decor Item Rarities for consistency; for example, we increased the rarity of some reward drops, and we decreased the rarity of more mainstream Recipes (such as Driftwood)[\/p][\/*][*][p]We have added new Recipe Bundles and Recipes in Crosslanders\u2019 Shops![\/p][\/*][\/list][p][\/p][h2][b]Spark Nails[\/b][\/h2][list][*][p]We have added a new crafting resource \u2013 Spark Nail \u2013 that is required to craft Epic and Legendary items[\/p][\/*][*][p]Each [b]Epic[\/b] decor requires [b]1 Nail Spark[\/b], and each [b]Legendary[\/b] one requires [b]3 Nail Sparks[\/b];[\/p][\/*][*][p]There\u2019s a small chance to find Nails in Wilderness Pots and Chaos Shrines;[\/p][\/*][*][p]You can purchase Nail Bundles from Joule\u2019s, Mr. Kit\u2019s, and Deconneciour\u2019s Shops, or from your Waystation Vending Machine[\/p][list][*][p]Available in bundles of 5 for 1 Beacon Spark[\/p][\/*][*][p]Joule sells bundles of\u00a0 3 for 30 Shrinework Parts[\/p][\/*][\/list][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/cdba6d47cef25818ddfb04871ce498c024efd05a.png\"][\/img][\/p][p][\/p][h1]Wilderness Activities[\/h1][list][*][p]\ud83c\udf1fSweet Spot Mechanic: Based on your feedback, we have adjusted the pickaxe harvesting skill-check to make it easier to succeed by increasing the sweet spots size. We have also made the final hit of a co-op Sweet Spot activity always succeed.[\/p][\/*][*][p]\ud83c\udf1f We have also implemented an accessibility setting that allows players to substantially reduce the speed of the Sweet Spot harvesting check, to help players who are struggling with them. You can change that in your game settings \u2013 your rewards will still be the same.[\/p][\/*][*][p]\ud83c\udf1fAs per your request and feedback, proposals in the Wilderness are now limited to 20 per day per player. [\/p][\/*][*][p]\ud83c\udf1f We tweaked the Wilderness Mural contribution limits to 1 square per person to enable more players to take part in it, following your suggestion! \ud83e\udedf[\/p][\/*][\/list][p][\/p][h2][b]Tournaments[\/b][\/h2][list][*][p]\ud83c\udf1f Fishing and Blot Tournaments now run multiple times on the days they are scheduled, matching the Foot Race Tournament.[\/p][\/*][*][p]Major Tournaments Rewards have been added for \u201cTop 25%\u201d and \u201cTop 10%\u201d, replacing the old \u201cTop 15%\u201d and \u201cTop 10\u201d.[\/p][\/*][*][p]\ud83c\udf1f Now, when you turn in Fish or Blot for a tournament, you will automatically receive the amount of Paper or Ink you would have received from purifying it![\/p][list][*][p][i]Please note: you need to have space available in your inventory to receive it. If you don\u2019t, it will be sent to you via Mail.[\/i][\/p][\/*][\/list][\/*][\/list][p][\/p][h1]Economy Balancing Changes[\/h1][p][\/p][list][*][p]\ud83c\udf1f We made hairstyles tradeable once again![\/p][\/*][*][p]\ud83c\udf1f Lunar Rocks and Spore Wood Nodes now work with Tool Enhancements, meaning you can get more resources (with tools with the Bounty enhancement) or more Coins (using tools with the Riches enhancement) from each harvestable node;[\/p][\/*][*][p]A small number of Patterns were marked as tradeable incorrectly \u2013 this was fixed with this update and all Patterns have been made not tradeable;[\/p][\/*][*][p]\ud83c\udf1f We have added [b]4 new Tuber sources[\/b] to each Wilderness;[\/p][\/*][*][p]You can also trade Furniture items from the \u201cSimple\u201d Set;[\/p][\/*][*][p]Clothing Beacon Spark costs are now based on item type, not just the rarity of the item, to make the cost more balanced.[\/p][list][*][p]This means that Hats, Shoes, Glasses, Headcoverings, and Legs items got a lot cheaper[\/p][\/*][*][p]Most Mythic items also got cheaper[\/p][\/*][*][p]Rare Dresses, Torsos, Hats, and Backpacks got a tiny bit more expensive[\/p][\/*][*][p]Epic Dresses, Torsos, Hats, and Leg items got a bit cheaper[\/p][\/*][\/list][\/*][\/list][p][\/p][h2]Wilderness Pot Loot Changes[\/h2][list][*][p]\ud83c\udf1f We have heard your feedback that you would rather have fewer Pots but better rewards from Wilderness Pots, so now each Pot can now be harvested once per Wilderness, instead of daily. [\/p][\/*][*][p]\ud83c\udf1f As a result, you are much more likely to get Decor, Clothing, Recipes, and Gifts from Pots than before \u2013 45% of Pots will yield one of these types of items. [\/p][\/*][*][p]\ud83c\udf1f Small Salvage has been completely removed from the Wilderness Pots loot pool. You\u2019ll also get a higher quantity of Shrineworks Parts, Fluffalo Treats, Blot Bells, and Recipe Fragments per drop.[\/p][\/*][\/list][p][\/p][h2]Songs[\/h2][list][*][p]We have removed the \u201cMaple Tree\u201d and \u201cTen Tea Trot\u201d songs from the Village Vending Machine. \u201cApple Blossom Time\u201d, \u201cSignificant Snowperson\u201d, and \u201cSpiral Song\u201d were also removed from Guido\u2019s shop. [\/p][list][*][p]Candlewic\u2019s Level 15 song reward is now \u201cThe Art of Fugue\u201d[\/p][\/*][*][p]The original reward, the \u201cFrosted Fugue\u201d song, had been incorrectly assigned to him. Players who are already at Level 15 with Candlewic can recover the Frosted Fugue Song in the Entry Lands or Wilderness.[\/p][\/*][\/list][\/*][*][p]These songs will return in future world and waystation-exclusive events that are planned for upcoming game updates. We\u2019re doing this clean up now to make sure rewards are exciting throughout all activities, and so that you have things to look forward to! [\/p][\/*][\/list][p][\/p][p][\/p][h1]Player Houses & Build Mode[\/h1][h2]Player Houses[\/h2][list][*][p]\ud83c\udf1f You can now place the main Wilderness Traversables (jump pads, launch pads, lift fans, and ladders) in your Home for all of those hard to reach nooks and crannies! [\/p][\/*][*][p]\ud83c\udf1f You can also dye Potted Plant Pots to achieve that matching indoor jungle looks you\u2019ve been looking for![\/p][\/*][*][p]\ud83c\udf1f Home crafting tables can now be accessed by players with the \u201cGuest\u201d permissions or higher (it was previously \u201cDecorator\u201d and above)[\/p][\/*][*][p]We\u2019re reviewing how Potted Plants work, and while we are investigating better solutions, Potted Plants will no longer die, only wither. They can be watered as usual to recover fully \ud83d\udca7[\/p][\/*][\/list][p][\/p][h2]Build Mode & Decor Changes[\/h2][list][*][p]We did some Autumn Cleaning with the Fences to simplify and remove redundant fences (why did we have three different Stone Fences???)[\/p][list][*][p]All Building Fence Kit items and furniture tagged as Fence are now in the Structures tab instead of Decor to simplify and avoid confusion;[\/p][\/*][*][p]We have retired both the City Stone Wall Fence and National Park Stone Fence because they looked too similar to the other Stone Wall Panel, but not as versatile;[\/p][\/*][*][p]The Stone Wall Panel now has the \u201cNatural\u201d tag to make sure you have Fences that fulfills your Tree Happiness needs;[\/p][\/*][*][p]All City Stone Wall Fences or National Park Stone Fences placed in homes and waystations will automatically be replaced with the Building Kit Stone Wall Panel (no need to rebuild! They\u2019re the same size), and any place you found those craftable or for sale will now have the Stone Wall Panel instead [\/p][\/*][*][p]\ud83c\udf1f You can now place objects and decor on top of any flat top Fences![\/p][\/*][*][p]We also renamed some fences-that-were-actually-railings to \u201cRailings\u201d (for example, the Metal Fence is now called Metal Railing);[\/p][\/*][\/list][\/*][*][p]We have added [b]two brand new Decor Sets[\/b] that will be available as rewards for progressing your Friendship with Major Spirits or by purchasing them in their shops;[\/p][list][*][p]September Major Spirits Decor Set including 5 large statues and 17 turnip-themed decor items for all of your haunting decor needs. [\/p][\/*][*][p]November Major Spirits Decor Set, including 5 statues[\/p][\/*][\/list][\/*][*][p]The Pirate Decor Set now includes 11 new Pirate Decor items[\/p][\/*][*][p]\ud83c\udf1f We also updated the Talavera Set to include some additional Wall Tiles[\/p][\/*][*][p]\ud83c\udf1fLunar Ceiling Stickers are now easier to select and move after initial placement[\/p][\/*][*][p]We have added Fire and Candles to Decor Sets as interactive decor[\/p][\/*][\/list][p][\/p][h1]Socialization and Customization[\/h1][h2]Flairs[\/h2][list][*][p]Want to add a little bit more ~Flair to your character, and show others more about your personality? \ud83d\udc85 Flairs are a new type of equipable \u201ctags\u201d in-game, alongside Moods. They will appear in your profile when other players interact with you.[\/p][\/*][*][p]Flairs can be obtained from:[\/p][list][*][p]Leveling up Friendship with Major Spirits[\/p][\/*][*][p]Leveling up Friendship with Crosslanders[\/p][\/*][*][p]Completing specific Errands[\/p][\/*][*][p]Executing [i]specific actions[\/i] \ud83d\udc40 (try out some shenanigans!)[\/p][\/*][\/list][\/*][*][p]You can add or remove Flairs by accessing the Menu > Character > Text Bubble icon (same spot the Moods are!)[\/p][\/*][*][p]You can select up to [b]3 Flairs at once[\/b], and they will show up in your Profile when inspecting players or by clicking \u201cView Friend\u201d in the Friends List[\/p][\/*][*][p]If you have already completed the requirements for a certain Flair but by any chance don\u2019t see them as unlocked, you can go to Dusty\u2019s in the Entry Lands or the Wilderness to recover them;[\/p][\/*][*][p]\ud83c\udf81 Beta Testers \u2013 meaning you, the players who joined the playtest or played through this Beta stage! \u2013 will unlock the exclusive \u201cBeta Tester\u201d Flair! Thank you all for being a part of this! \ud83d\udc9d[\/p][\/*][*][p]Keep your eyes peeled because we\u2019ll be adding more Flairs in the future![\/p][\/*][\/list][p][\/p][h2][b]Friends List Improvements[\/b][\/h2][list][*][p]The Friends List received a new and improved look![\/p][list][*][p]Now you can sort your friends by Friendship level and online status, or filter by location[\/p][\/*][\/list][\/*][*][p]You can also mark them as Favorites, and they will show up on the \u201cFavorites\u201d tab[\/p][\/*][*][p]Your Connections \u2013 meaning players you have automatically met by playing music or doing activities together \u2013 now show up in a separate tab as well. Increase your friendship level with them to Level 2 to make them a Friend.[\/p][\/*][*][p]Blocked and Muted players now show up in separate tabs \u2013 you can manage them, unmute or unblock them from there if you wish to.[\/p][\/*][\/list][p][\/p][h2][b]Expression Menu Changes and Features[\/b][\/h2][list][*][p]We have changed the UI for the Expressions Menu to bring improvements and new features![\/p][\/*][*][p]For example, now you can set up Custom Expression Presets to have all of your most used expressions on hand more easily![\/p][list][*][p]To set up Quick Expressions, access the Expressions menu (press X on KB&M or click the Emote icon on Mobile), then select \u201cEdit\u201d.[\/p][\/*][\/list][\/*][*][p]You can also access your emotes more easily with the vertical emote sidebar \u2013 let us know what expressions you\u2019d like to see here![\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/621087a3975046ccfcbb4a671c732da635d7fc63.jpg\"][\/img][\/p][p][\/p][h2]Customization[\/h2][list][*][p]Season Exclusive categories can now be found in the Stylesmith\u2019s Clothing Store and the Chromatist\u2019s Dye Shops \u2013 this means that these items are only available for the current season.[\/p][\/*][*][p][b]Two brand new Clothing Sets[\/b] have been added to the rotation![\/p][list][*][p]You can find the Spa Clothing Set in the Taylor\u2019s Clothing Store, and the Witch Clothing Set in the Stylesmith\u2019s Clothing Store as an Autumn Exclusive set[\/p][\/*][\/list][\/*][*][p]\ud83c\udf1f New color variations of Rudi\u2019s Armor are available in his shop (did someone say dyeable Buckets? \ud83d\udc40)[\/p][\/*][*][p]Luna now has an exclusive Clothing Dye Station that you can use while she is in the Wilderness[\/p][\/*][*][p]\ud83c\udf1f By popular demand, the Fall Femme dress with the Sweater and Scarf now has a torso variant available \u2013 with just the Sweater and Scarf, but without the skirt!)[\/p][\/*][*][p]We\u2019re removing Backpacks from most Shop rotations, as they will be returning as purchasable items in world scenarios and waystation-exclusive events[\/p][list][*][p]For now, we\u2019re keeping 1 offer of Backpack available per day in the Waystation Vending Machine so you can still obtain them. Get them while you can![\/p][\/*][\/list][\/*][\/list][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/7f840106fd2a1828789a64a68248ce73eafc0e33.png\"][\/img][\/p][h1][b]Narrative & Quests[\/b][\/h1][h2][b]Friendship Quest Arcs[\/b][\/h2][list][*][p]As you may be aware, Villagers unlock special friendship quest arcs at friendship levels 2, 5, 9, and (still in development) 13. As we prepare for launch, we are revisiting and updating these arcs to bring them all to a consistent standard and ensure the narrative is still consistent.[\/p][\/*][*][p]We have replaced some Villager Quest arcs for Hardtack, Kasu, and Roomie at friendship levels 9, 5, and 9 respectively.[\/p][list][*][p]All players who reach the appropriate Friendship level (or have passed it) with those Crosslanders will get the new versions of these quest arcs, even if they have previously completed the old quest arcs.[\/p][\/*][\/list][\/*][*][p]We have also updated or polished multiple older Villager friendship quest arcs. These are more minor changes, so players who already completed the old versions of these quests will not be re-offered the changes.[\/p][list][*][p]Amano (Friendship level 9)[\/p][\/*][*][p]Candlewick (Friendship levels 2 and 9)[\/p][\/*][*][p]Joule (Friendship levels 1 and 2)\u00a0[\/p][\/*][*][p]Kasu (Friendship levels 1 and 2)[\/p][\/*][*][p]Marj (Friendship level 9)[\/p][\/*][*][p]Nibbit (Friendship level 9)[\/p][\/*][\/list][\/*][\/list][h2][b]Major Spirits Progression[\/b][\/h2][list][*][p]We have completely revamped some Major Spirits friendship progression so it matches most of the Crosslanders \u2013 this means that you can now give Gifts to spirits, and each has their own shop with different offers![\/p][\/*][*][p][b]How does it work now?[\/b][\/p][list][*][p]Each Spirit now has 10 Friendship levels now. New conversations and transformations are unlocked as your friendship progresses[\/p][\/*][*][p]Reaching Friendship Lvl 7 and Friendship lvl 10 with them will grant you special rewards![\/p][\/*][\/list][\/*][*][p]This change only applies to this month\u2019s Major Spirits. You\u2019ll be able to finish the questline for the Spirits that show up in September without the new progression system integrated. Spirits released in future updates of the game will have the new progression track.[\/p][\/*][*][p]Friendship progression with this month\u2019s Major Spirits, and all Spirits previously encountered during the playtest (except August\u2019s Major Spirit Family) will be reset in 15.4.[\/p][list][*][p][b]Why?[\/b] Our long-term playtest participants have re-experienced content that was only meant to be experienced once prior to launch, and this has caused certain things to break. This wouldn\u2019t be an issue if we were doing regular progress wipes like most MMOs do during development, but we\u2019ve been trying to avoid doing that. This limited reset enables us to avoid future problems and edge cases, while continuing to preserve most of your progress.[\/p][\/*][*][p]August\u2019s Major Spirit Family will be available throughout September [i]without[\/i] the new track.[\/p][\/*][\/list][\/*][\/list][p][\/p][h1]Art & UI[\/h1][list][*][p]The Settings menu was slightly reorganized. Now the Streamer Mode is separated from the General Settings to make things easier to find![\/p][\/*][*][p]\ud83c\udf1f We have polished the First Person camera, improving position and angle based on your feedback![\/p][\/*][*][p]\ud83c\udf1f You can check out placed proposals in the Decor Management (Storage) UI![\/p][\/*][*][p]\ud83c\udf1f We have added some more textures, foliage and colors to the Wilderness based on your feedback[\/p][list][*][p]There is now a lot more foliage on the terrain in the Wilderness, as well as materials for caves and forest areas. Foliage can be turned off by turning Foliage Detail to Low in the Video Settings Menu[\/p][\/*][*][p]\ud83c\udf1f Winter and Autumn Season visual updates \u2013 we have polished both seasons to make them more vibrant and add more variation[\/p][\/*][\/list][\/*][*][p]We also applied some changes to the lighting and shading \ud83c\udf1e\ud83c\udf1a[\/p][list][*][p]We have adjusted nighttime visuals \u2013 now nighttime is darker, but a little bit shorter in overall length[\/p][\/*][*][p]Ceiling lights provide a more cozy ambient lighting at night: to offset the darker nighttime visuals, ceiling lights have been adjusted to illuminate interiors spaces appropriately[\/p][\/*][*][p]Now Campfire decor items light up when you sit by them \ud83d\udd25[\/p][\/*][\/list][\/*][*][p]We have resized the Wilderness Lift Pad visually \u2013 it looks a little bit smaller in size to match game dimensions, but the lift area is still the same[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45889178\/c16663dbc0273a739aa65a0280a4fa56e52c7979.png\"][\/img][\/p][p][\/p][h1]Quality of Life Improvements \ud83d\udd27[\/h1][list][*][p]\ud83c\udf1f We have increased the options for the Motion Sickness reticle in the Settings[\/p][\/*][*][p]\ud83c\udf1f Your Beacon Sparks are now visible in the Inventory header bar[\/p][\/*][*][p]\ud83c\udf1f Nibbit\u2019s sign was moved so you are less likely to accidentally interact with it when trying to talk to her[\/p][\/*][\/list][p][\/p][h1]Game Tech Optimizations\ud83d\udd27[\/h1][list][*][p]\ud83c\udf1f We know there\u2019s been more server lag and disconnects than you (and we!) would like in the past couple of updates, so we made an effort to optimize the server and hopefully improve both of those issues. There\u2019s more work to be done; we will continue to focus on this as we prepare for launch.[\/p][\/*][*][p]\ud83c\udf1f Further optimization work to speed up server loading and reduce the amount of time you spend looking at loading screens. (Hopefully we\u2019re 2-3s faster now. Every little bit adds up!)[\/p][\/*][*][p]Reduction in the amount of data we transmit from server to client. So if you\u2019re playing on a mobile device, we\u2019ll use less of your bandwidth.[\/p][\/*][\/list][p][\/p][h1]Bug Fixes \ud83d\udc1b[\/h1][list][*][p]Fixed a bug where Roomie couldn\u2019t be picked up in Build Mode;[\/p][\/*][*][p]Fixed the thickness of the Photo Mode line at higher resolutions;[\/p][\/*][*][p]Fixed situations where the chat translation button fails to appear even when you\u2019re looking at chat text in another language[\/p][\/*][*][p]Fixed bugs that caused music to not play sometimes;[\/p][\/*][*][p]Fixed a bug where harvestables would remain blocked the day after a Raging Spirit was nearby[\/p][\/*][*][p]Fixed a bug where Legendary Chaos Shrine coin rewards were not granted[\/p][\/*][*][p]Fixed a bug with unlocked items still appearing in the Locked section of Shops[\/p][\/*][*][p]Fixed a bug where Waystation tree stumps couldn\u2019t be harvested[\/p][\/*][*][p]Fixed a bug where Strangers couldn\u2019t see each other\u2019s chat if they were both sitting on a fishing pier[\/p][\/*][\/list][p][\/p][p]Thank you for your continued support![\/p][p][\/p]","commentcount":3,"tags":["workshop","mod_reviewed","ModAct_1607812438_1790272446_0","ModAct_1607812438_1790274298_4","ModAct_487176015_1792443533_4"],"language":0,"hidden":0,"forum_topic_id":"585060903247066377","event_gid":"694273194214818826","voteupcount":32,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"585060903247066377","rtime32_last_modified":1793095876,"news_post_gid":"0","rtime_mod_reviewed":1792443533,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790181511,"votes_up":32,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"842866071372353010","gidfeature2":"585060903247066377"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["680765564125184464","669505296465397895"],"last_update_event":{"rtime":1790268240,"event_gid":"694273194214818826","announcement_gid":"694273194214818827","clan_account_id":45889178}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8a662e18e01736386929923506e98c22.poster.avif?t=1793313658" width=780 height=200 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8a662e18e01736386929923506e98c22.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8a662e18e01736386929923506e98c22.mp4?t=1793313658" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>&quot;Imagine Sky: Children of the Light with a dash of Animal Crossing's homey charm&quot;</i> - MMORPG dot com</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Welcome to <i>Spirit Crossing</i>, a whimsical multiplayer game set in a storm-swept world above the clouds. Build a home, help spirits, and cross paths with other players, all on your own terms. Make a friend, or just quietly share the same little corner of the world. Our game is built around small acts of kindness, and the way even brief connections can make us feel a little less alone.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>Spirit Crossing</i> is launching this November; <strong>wishlist on Steam today!</strong></p><p class="bb_paragraph" ></p><h2 class="bb_tag" > <strong>Restore a World of Spirits</strong><br><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8dad146b41761e8fd5e5802ce6ea4dc1.poster.avif?t=1793313658" width=780 height=180 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8dad146b41761e8fd5e5802ce6ea4dc1.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/8dad146b41761e8fd5e5802ce6ea4dc1.mp4?t=1793313658" type="video/mp4"></video></span></h2><p class="bb_paragraph" >Magical storms sweep across the Crosslands, wreaking havoc on spirits and humans alike. Each day brings new quests to rebuild your community, heal troubled spirits, and restore joy through music. As you learn the language of the spirits, they will reward you with unique items and surprising revelations about their stories and struggles.</p><p class="bb_paragraph" style="text-align: center"></p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><strong>Show Off Your Style</strong> </h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/df328440abe8c13541f01b71a5fef1f1.poster.avif?t=1793313658" width=780 height=180 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/df328440abe8c13541f01b71a5fef1f1.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/df328440abe8c13541f01b71a5fef1f1.mp4?t=1793313658" type="video/mp4"></video></span></p><p class="bb_paragraph" >Show off your unique style with hundreds of designs for every fashionista. Customize your look with hairstyles, dyes, and mix-and-match outfits, then bring it all to life with dozens of expressive emotes. Come as you are, or try on someone new!</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><strong>Decorate Your Space</strong> </h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/cbcb0c0d6d7dff91137c44930b39866a.poster.avif?t=1793313658" width=780 height=180 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/cbcb0c0d6d7dff91137c44930b39866a.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/cbcb0c0d6d7dff91137c44930b39866a.mp4?t=1793313658" type="video/mp4"></video></span></p><p class="bb_paragraph" >A mountain peak escape all to yourself? Now we’re talking! Design the ultimate space to host your friends, from cozy cottage to full-blown castle. Then fill it with enough furniture, plants, rugs, lamps, and tiny trinkets to ensure no shelf goes tragically undecorated. (Oh, and your home might come pre-furnished with a fuzzy, friendly roommate. 🐻)</p><h2 class="bb_tag" ></h2><h2 class="bb_tag" ><strong>Cozy Campfires &amp; Impromptu Jam Sessions</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/0c763d61ccbc2b94c5ca061a1f39445f.poster.avif?t=1793313658" width=780 height=180 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/0c763d61ccbc2b94c5ca061a1f39445f.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/0c763d61ccbc2b94c5ca061a1f39445f.mp4?t=1793313658" type="video/mp4"></video></span></p><p class="bb_paragraph" >Just like in the real world, storms occasionally roll in and interrupt your exploring. But that's a feature, not a bug. In <i>Spirit Crossing</i>, take shelter around communal bonfires with other wanderers. Share a song or conversation, or just simply enjoy the flickering firelight during one of the most magical parts of the game.</p><h2 class="bb_tag" > <br><strong>Play Together or By Yourself</strong><br><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/59ef7f1a706ac5a722249b33b923c096.poster.avif?t=1793313658" width=780 height=180 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/59ef7f1a706ac5a722249b33b923c096.webm?t=1793313658" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/59ef7f1a706ac5a722249b33b923c096.mp4?t=1793313658" type="video/mp4"></video></span></h2><p class="bb_paragraph" >In <i>Spirit Crossing</i>, other players appear as shadows. Share a high five or an activity, and they'll bloom into color, revealing the person behind the silhouette. Maybe you make a new friend. Or maybe you just fish with each other for ten peaceful minutes and call it good.<br><br><br>Not in the mood to meet or chat with new people? No pressure, you can opt out of meeting others for however long you might want to. Stay a mysterious shadow, lend a hand when you feel like it, and disappear before anyone can make it weird. 🤗</p><h2 class="bb_tag" > <br><strong>What Will it Cost?</strong></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/c2b38f9b96ee054c1d39b377bf002121.avif?t=1793313658" width=616 height=180 /></span></p><p class="bb_paragraph" ><i>Spirit Crossing</i> will launch with an upfront price that gives players full access to the complete game experience in perpetuity. We will also offer a completely optional monthly “Cozy Club” membership for players who want to continue supporting our studio and future <i>Spirit Crossing</i> development. Our Cozy Club members will be able to customize their flying pet fluffalo, collect exclusive flairs, access a limited resource exchange shop, and more! We’re intentionally avoiding microtransactions in <i>Spirit Crossing</i>, so you can focus on enjoying your game, not stressing about your wallet. 💸 </p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><strong>What’s With the Bears?</strong> </h2><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2321960/extras/28e5c5584a3f6e857a85b3485ce6e792.avif?t=1793313658" width=616 height=180 /></span></p><p class="bb_paragraph" >Our studio has been making games for almost twenty years. We invented the Merge game genre with <i>Triple Town</i>, and have since released many other original games, including the hit life-sim, <i>Cozy Grove</i>, and the delightfully silly word puzzle game, <i>Alphabear</i>.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><i>Spirit Crossing</i> has been in development for over five years. At the heart of this project is our belief that games should bring people together, encourage kindness, and reduce loneliness in this chaotic world we live in. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Come join our growing community on Discord today!</p><p class="bb_paragraph" ><br><strong>~ Spirit Crossing encourages players to chat and make new friends. You must be at least 13 years old to play Spirit Crossing. ~</strong></p>						</div>
					</div>
				
				
				

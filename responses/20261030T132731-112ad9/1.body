							var StoreDefaults = {"PartnerEventStore":[{"gid":"719042992158016760","clan_steamid":"103582791475479812","event_name":"ReBlade: The Death Spiral Demo OUT NOW!","event_type":28,"appid":3489340,"server_address":null,"server_password":null,"rtime32_start_time":1792463280,"rtime32_end_time":1792464900,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Our First Public Demo Is Here!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"9a25dfab1400cf20d6b12ffa572d0d9127c7fb94.jpg\",null,null,null,null,null,\"5c321e09194fef4231f335b39ab96ddb6deae584.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"719042992158016761","clanid":"45958404","posterid":"0","headline":"ReBlade: The Death Spiral Demo OUT NOW!","posttime":1792461403,"updatetime":1792479954,"body":"[p]Greetings everyone![\/p][p]Since revealing [i]ReBlade: The Death Spiral[\/i] earlier this year, we've received so much support and interest from players around the world. Thank you to everyone who's been following our journey![\/p][p]We're a small team of eight developers from ChillyRoom, brought together by our love for action games. This is our first independent game, and while development has come with its challenges, we're excited to finally share a major milestone with you!\n[\/p][p][b]Our very first public demo is NOW AVAILABLE on Steam, just in time for October's Steam Next Fest![\/b][\/p][p]We'd love for you to jump in and give it a try! It will be available from [b]19th Oct to 10th Nov![\/b]\n [\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3489340\/ReBlade_The_Death_Spiral\/\"][\/dynamiclink]We've worked hard to polish this demo as much as possible, but there's still plenty of room for improvement. Your feedback will be incredibly valuable as we continue developing the game, and we'd love to hear your thoughts and suggestions![\/p][p]We hope you enjoy your time with the demo, and most importantly, [b]have fun![\/b][\/p][p][\/p][h2]Share your feedback with us![\/h2][p]If you have any suggestions, thoughts, or encounter any issues while playing the demo, please share them with us through the forms below:[\/p][list][*][p][b][url=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSeMmRqUHR5rGB-PLXITSuOtEIm29pxXUJur6dU_REfqhhWKKA\/viewform\"]Demo Feedback Form[\/url][\/b][\/p][\/*][*][p][b][url=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSeeU5d5LPxR-zpIfOrhOBOo4FBH5CpPRGMwWm5g1HO_1xWgUw\/viewform\"]Bug Report Form[\/url][\/b][\/p][\/*][\/list][p]You can also join our [b][url=\"https:\/\/discord.gg\/ZWB2ARVdN2\"]official Discord server[\/url][\/b] to chat with the community and share your experiences![\/p][p]If you enjoy the demo, we'd also really appreciate it if you left a comment on the demo's Steam discussion page![\/p][p][\/p][h2]ReBlade Demo FAQ[\/h2][p]Here are a few things you might want to know before jumping into the demo![\/p][p][\/p][h3]Q1: What content is available in the demo?[\/h3][p]The demo features [b]three distinct weapons[\/b], each offering a different combat style.[\/p][p]You'll also be able to explore [b]three trials[\/b], consisting of one main trial and two side trials.[\/p][p]Each trial features a standard difficulty and [b]three additional difficulty tiers[\/b] for players looking to test their skills![\/p][p][\/p][h3]Q2: Will the demo include any story content?[\/h3][p]This demo focuses primarily on gameplay and combat, so story content will not be included.[\/p][p]You'll be able to experience the game's narrative in the full release![\/p][p][\/p][h3]Q3: How difficult is the game? Can I enjoy it if I'm not experienced with action games?[\/h3][p][i]ReBlade: The Death Spiral[\/i] is an action game that requires some familiarity with action combat, but we want players of different skill levels to find their own way to enjoy it.[\/p][p]If you're new to action games, we recommend starting with the [b]Shield Axe[\/b], which offers a more beginner-friendly playstyle. You can also strengthen your character through the game's progression system to make your experience more manageable.[\/p][p]For experienced players looking to push their limits, we've also prepared additional difficulty tiers to put your skills to the test![\/p][p][\/p][h3]Q4: Will my demo save data carry over to the full game? Where can I find my demo save files?[\/h3][p]As we're still actively developing the game, several underlying systems and frameworks will undergo changes before the full release.[\/p][p]To ensure a stable experience, [b]save data from the demo will NOT carry over to the full game.[\/b][\/p][p]Thank you for your understanding![\/p][p]You can find your demo save files at the following location:[\/p][p][c]C:\\\\Users\\\\<Your user folder>\\\\AppData\\\\LocalLow\\\\ChillyRoom\\\\ReBlade_ The Death Spiral\\\\<SteamID>[\/c][\/p][p][\/p][p]That's all for now! Thank you again for all your support, and we hope you have a great time with the demo! If you enjoyed our game, please share your thoughts with us on Steam or social media.[\/p][p]And if you haven't already, be sure to [b]wishlist ReBlade: The Death Spiral[\/b] to stay up to date with future updates and announcements![\/p][p][\/p][p]Follow us for more updates![\/p][p][\/p][p]Twitter: [url=\"https:\/\/x.com\/ReBladeG\"]https:\/\/x.com\/ReBladeG[\/url][\/p][p]TikTok: [url=\"https:\/\/www.tiktok.com\/@rebladegame\"]https:\/\/www.tiktok.com\/@rebladegame[\/url][\/p][p]Discord:[url=\"https:\/\/discord.gg\/ZWB2ARVdN2\"]https:\/\/discord.gg\/ZWB2ARVdN2[\/url][\/p][p]Instagram: [url=\"https:\/\/www.instagram.com\/rebladegame\"]https:\/\/www.instagram.com\/rebladegame[\/url][\/p][p][\/p]","commentcount":23,"tags":["ModAct_1426387032_1792462241_2_31","mod_reviewed","ModAct_1426387032_1792462243_0","ModAct_1426387032_1792468283_4","ModAct_1866137740_1792480122_4"],"language":0,"hidden":0,"forum_topic_id":"568174730608258527","event_gid":"719042992158016760","voteupcount":169,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792463280,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568174730608258527","rtime32_last_modified":1793285855,"news_post_gid":"0","rtime_mod_reviewed":1792480122,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790248566,"votes_up":169,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"686370212389375706","gidfeature2":"568174730608258527"},{"gid":"707787161892553011","clan_steamid":"103582791475479812","event_name":"[v0.14.52] Bug Fixes & Improvements","event_type":12,"appid":3489340,"server_address":null,"server_password":null,"rtime32_start_time":1793176020,"rtime32_end_time":1793179801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"707787161892553012","clanid":"45958404","posterid":"0","headline":"[v0.14.52] Bug Fixes & Improvements","posttime":1793176074,"updatetime":1793176074,"body":"[p]Hello everyone!\n[\/p][p]We hope you've been enjoying the ReBlade demo so far! We've continued working on fixing known bugs and making improvements to provide a smoother gameplay experience.[\/p][p]Here's what's included in this update:[\/p][list][*][p]Fixed an issue where the Shield Axe's guard-breaking effect would not work properly under certain conditions.[\/p][\/*][*][p]Fixed an issue where entering the Prologue with certain starting chips could prevent skill points from being restored, potentially blocking progression.[\/p][\/*][*][p]Fixed a UI issue where weapons with too many attributes could cause the chip UI at the bottom of the screen to overlap important information, such as weapon recycling prices, when picking up weapons.[\/p][\/*][*][p]Fixed an issue where the cloud save system could cause save data to reset.[\/p][\/*][\/list][p][\/p][p]If you have any thoughts, suggestions, or encounter any issues while playing the demo, we'd love to hear from you! Feel free to share your feedback through our [url=\"https:\/\/forms.gle\/EqckHm73bU2kaLzi7\"]Demo Feedback Form[\/url] or report bugs through our [url=\"https:\/\/forms.gle\/yQiCKBW8eqPcDY8g8\"]Bug Report Form[\/url].[\/p][p][\/p][hr][\/hr][p][\/p][h2]Spiral Up Games Publisher Sale Is Now Live![\/h2][p]Our annual [b]Spiral Up Games Publisher Sale[\/b] is officially underway! During the sale, games published by Spiral Up Games are available at [b]all-time low prices[\/b], so don't miss out![\/p][p][b][url=\"https:\/\/store.steampowered.com\/publisher\/spiralupgames\/sale\/SpiralUpAnnualSales2026\"]Check Out the Publisher Sale Here![\/url][\/b][\/p][p][\/p][p][\/p][p][img src=\"https:\/\/clan.fastly.steamstatic.com\/images\/\/45958404\/2654f1cb30da9ee256e4c7b429b19fbc16087e64.jpg\" style=\"border-width: medium; border-style: none; border-color: currentcolor; border-image: none; -webkit-user-drag: none; display: block; max-width: 100%; z-index: -1; position: relative;\"][\/img]\n[\/p][p][\/p][p][\/p][p]\n[\/p][p][\/p][p][\/p][p][\/p][p]\n[\/p]","commentcount":1,"tags":["patchnotes","mod_reviewed","ModAct_1415716708_1793176201_0"],"language":0,"hidden":0,"forum_topic_id":"569301473354104118","event_gid":"707787161892553011","voteupcount":27,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301473354104118","rtime32_last_modified":1793298847,"news_post_gid":"0","rtime_mod_reviewed":1793176201,"featured_app_tagid":0,"referenced_appids":[],"build_id":25096586,"build_branch":"","unlisted":0,"rtime_created":1793157846,"votes_up":27,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"686370212389375706","gidfeature2":"569301473354104118"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["719042992158016761"],"last_update_event":{"rtime":1793176020,"event_gid":"707787161892553011","announcement_gid":"707787161892553012","clan_account_id":45958404}}};
						</script>
					


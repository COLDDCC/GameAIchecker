																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"688645594881722608","clan_steamid":"103582791475493268","event_name":"Steam Next Fest is Live! (And we need your help in the dungeons)","event_type":28,"appid":3106270,"server_address":null,"server_password":null,"rtime32_start_time":1792481940,"rtime32_end_time":1792483620,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Jump into the HELLCARD II demo during Steam Next Fest, bring your co-op party, and help us climb the festival charts!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"10d1edd68d58188316d9d11cc1e2f317b019434c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"f410a90c5229c2b330c460d5ae16a6c127774960.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688645594881722609","clanid":"45971860","posterid":"0","headline":"Steam Next Fest is Live! (And we need your help in the dungeons)","posttime":1792481959,"updatetime":1792693493,"body":"[p]Hello everyone!\n\nSteam Next Fest has officially kicked off, and [b]HELLCARD II[\/b] is right in the middle of the action! While our demo has been out in the wild for a little bit now, this week is a massive milestone for us and for the game's visibility ahead of our full release in Q1 2027. \n\nIn the spirit of our usual candid transparency: [b]we need your help to bump up our player numbers during the festival![\/b]\n\n[\/p][h1]Why Playing Right Now Matters (Even for Veterans!)[\/h1][p]If you know anything about how the Steam algorithm works during Next Fest, you know it loves a crowd. The more people actively playing the demo at the same time, the higher [b]HELLCARD II[\/b] climbs on the festival charts. That visibility brings in fresh blood, which means more co-op partners for you down the line (and more feedback for us to make the game as good as it can possibly be).\n\nSo, even if you already raided the [b]Lich Vault[\/b] back in September or participated in the beta playtest, booting up the demo for a run or two this week helps us out immensely. Better yet, drag up to three friends into a lobby with you\u2014more players in a party means bigger numbers on the board (and more people to blame when a run goes sideways \u02d0archduck\u02d0).\n\n[\/p][h1]What\u2019s Waiting in the Demo?[\/h1][p]If you haven\u2019t jumped in yet, here is what you can sink your teeth into right now:\n[\/p][list][*][p][b]The Soul Heist mode:[\/b] Explore a full interactive pop-up storybook mode taking place in Blackmail Manor adventure. Along with selected side quests, random room encounters, and choices that actually unlock new paths and doors. [\/p][\/*][*][p][b]Five Playable Heroes:[\/b] Take the [b]Sorcerer, Ranger, Berserker, Paladin, and Cleric[\/b] for a spin. Unlock new equipment that persists between runs, changes how your heroes look, and reshapes your starting deck options.\n[\/p][\/*][*][p][b]4-Player Co-Op (or Solo!):[\/b] Team up with three friends online, or go in alone and command the entire party yourself.\n[\/p][\/*][*][p][b]Recent Polish & Fixes:[\/b] We\u2019ve been updating the build since the demo first dropped, so if you haven't played in a few weeks, now is a great time to see what has changed. There were balance changes, bugfixes, and, last but far from least, many more languages added to the game.\n[\/p][\/*][\/list][p]\n[\/p][h1]Don't Forget the \"Break HELLCARD II\" Challenge![\/h1][p]While you are in there boosting our Next Fest numbers, you might as well try to break our game. Our [b]Break HELLCARD II Community Challenge[\/b] is live right now! \n\nYour mission is simple: push the demo\u2019s cards, equipment, and party synergies as far as they will go - and then a bit further. We\u2019ve already seen one screenshot that made our programmer do a double take, so the bar is set high. Find the most absurd, game-breaking build you can, grab a screenshot or a clip, and share it with us in the forums or on Discord!\n\n[\/p][hr][\/hr][p]\n[\/p][h1]How to Jump In:[\/h1][olist][*][p]Head over to the [url=\"https:\/\/store.steampowered.com\/app\/3106270\/HELLCARD_II\/\"]HELLCARD II Store Page[\/url] and hit [b]Download Demo[\/b].\n[\/p][\/*][*][p]Play a run (or ten) while Next Fest is live from [b]October 19th to October 26th[\/b].\n[\/p][\/*][*][p][b]Wishlist and Follow[\/b] the game if you haven't already and make the Steam algorithm very happy \u02d0paperheart\u02d0.\n[\/p][\/*][\/olist][p]\n[dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3106270\/HELLCARD_II\/\"][\/dynamiclink]\n\nThank you all so much for the support, the bug reports, and the chaotic co-op stories so far. Jump into the Heist, make some noise in the charts, and let us know what you think!\n\nAs always,\nStay safe in the paper dungeons \u02d0archduck\u02d0Konstanty and the whole Thing Trunk team \u02d0paperheart\u02d0[\/p]","commentcount":6,"tags":["mod_reviewed","ModAct_1866137740_1792482748_0","ModAct_1827889981_1792695006_4"],"language":0,"hidden":0,"forum_topic_id":"706660344651861074","event_gid":"688645594881722608","voteupcount":30,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792481940,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660344651861074","rtime32_last_modified":1793192993,"news_post_gid":"0","rtime_mod_reviewed":1792695006,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792480005,"votes_up":30,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"804594265870285482","gidfeature2":"706660344651861074"},{"gid":"688645594881720985","clan_steamid":"103582791475493268","event_name":"Patchnotes and Break The Demo Update","event_type":13,"appid":3106270,"server_address":null,"server_password":null,"rtime32_start_time":1792087020,"rtime32_end_time":1792090801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"10d1edd68d58188316d9d11cc1e2f317b019434c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"f410a90c5229c2b330c460d5ae16a6c127774960.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688645594881720986","clanid":"45971860","posterid":"0","headline":"Patchnotes and Break The Demo Update","posttime":1792087049,"updatetime":1792087049,"body":"[p]We finally got the changelog window up and working, so please expect more verbose updates from now on \u02d0Archduck\u02d0 I will append the full changelog at the bottom. Aside from the balance changes the most prominent change are the new languages. Please report any issues with translations (both visual and language problems).\n\nIn other news, it's \n[\/p][h2]4 Days Until the \u201cBreak HELLCARD II\u201d Demo Challenge[\/h2][p]We have a juicy contender already with a screen that did make our programmer do a double take. [b]278k damage in one hit[\/b] isn't something we had on our bingo card. [\/p][p]Yes I know, the actual value is sized for ants on the screenshot, but it's there.   [\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45971860\/350ec9514819a9fbbc464c482d43f37bbdcb4bfc.jpg\"][\/img][\/p][p]Let's see if anything tops that \u02d0Archduck\u02d0 [\/p][p]If you are interested in participating, check the details in this post and show us that the game can be broken:[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/news\/app\/3106270\/view\/670630562731395651\"][\/dynamiclink] [\/p][h2]Update 0.1.26101407[\/h2][p]\n[b]Translations[\/b][\/p][list][*][p] Added French, German, Japanese, Brazilian Portuguese, and Spanish translations.[\/p][\/*][\/list][p] [b]Bug Fixes[\/b] [\/p][list][*][p] Fixed Fire and Ice weapon VFX.[\/p][\/*][*][p] Added new sound effects.[\/p][\/*][*][p] Fixed the Frozen effect affecting dead heroes.[\/p][\/*][*][p] Added indicators for Elite and Boss enemies.[\/p][\/*][*][p] Fixed various UI issues.[\/p][\/*][*][p] Added changelog screen.[\/p][\/*][*][p] Fixed a softlock caused by Bloodscript cards when a hero died.[\/p][\/*][*][p] Fixed card descriptions and text coloring.[\/p][\/*][\/list][p]\n[b]Balance Changes[\/b][\/p][list][*][p] Reworked the Soul Heist boss fight with new mechanics and balance changes.[\/p][\/*][*][p] Changed the Soul Heist algorithm controlling negative location occurrences.[\/p][\/*][*][p] Reduced Terrorize's mana cost to 1.[\/p][\/*][*][p] Changed Things To Come from Rare to Legendary.[\/p][\/*][*][p] Changed How It's Done to also Take 2 Attack cards.[\/p][\/*][*][p] Reduced Arrow Guard's mana cost to 1 and increased its effect to 2\u00d7INT Block.[\/p][\/*][*][p] Reduced Bug'em's mana cost to 1.[\/p][\/*][*][p] Reduced Crawling Ants' mana cost to 0.[\/p][\/*][*][p] Reduced Flu-Flu Fletching's mana cost to 0.[\/p][\/*][*][p] Reduced Lucky Charm's mana cost to 0.[\/p][\/*][*][p] Reduced Obsidian Arrowheads' mana cost to 0.[\/p][\/*][*][p] Reduced Profiled Nock's mana cost to 1.[\/p][\/*][*][p] Changed Singular Focus so it no longer discards non-Arrow cards already in hand. Newly drawn non-Arrow cards are still discarded.[\/p][\/*][*][p] Changed Second Degree Burns' additional cost from 1 Exhaust to 1 Discard.[\/p][\/*][*][p] Increased Flash Fire's proximity damage to 12.[\/p][\/*][*][p] Reduced Conjure Refreshments' mana cost to 0.[\/p][\/*][*][p] Increased Morning Dew's mana gain to 3.[\/p][\/*][*][p] Reduced Alms of Might's mana cost to 1.[\/p][\/*][*][p] Reduced Hoar Frost's cost to 1 Mana and 1 Discard.[\/p][\/*][*][p] Reduced Fluffle Of Bunnies' Skill card requirement from 8 to 6.[\/p][\/*][*][p] Increased Lacerate's damage to 3\u00d7STR.[\/p][\/*][*][p] Increased Gains Over Brains' STR gain to 2.[\/p][\/*][*][p] Reduced Inspiring Bravado's mana cost to 1.[\/p][\/*][*][p] Increased Shattering Smite's damage in your Sector to 15\u00d7WIS.[\/p][\/*][*][p] Reduced Things To Come's mana cost to 2.[\/p][\/*][\/list][p][\/p][p]As always,  \nStay Safe in Paper Dungeons \u02d0archduck\u02d0[\/p][p]Konstanty[\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_871423085_1792088631_0"],"language":0,"hidden":0,"forum_topic_id":"706660083369602859","event_gid":"688645594881720985","voteupcount":44,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369602859","rtime32_last_modified":1793192996,"news_post_gid":"0","rtime_mod_reviewed":1792088631,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792077525,"votes_up":44,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"804594265870285482","gidfeature2":"706660083369602859"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["688645594881722609","688645594881720986"],"last_update_event":{"rtime":1792087020,"event_gid":"688645594881720985","announcement_gid":"688645594881720986","clan_account_id":45971860}}};
						</script>
					


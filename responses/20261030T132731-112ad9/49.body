																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"679639030033292854","clan_steamid":"103582791475097575","event_name":"Steam Next Fest is Done!","event_type":28,"appid":3509380,"server_address":null,"server_password":null,"rtime32_start_time":1793118480,"rtime32_end_time":1793120400,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7e985fd438fb516ab04b21edd81ad2af8f8bc7d7.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679639030033292855","clanid":"45576167","posterid":"0","headline":"Steam Next Fest is Done!","posttime":1793118498,"updatetime":1793118498,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/7e985fd438fb516ab04b21edd81ad2af8f8bc7d7.png\"][\/img][\/p][p][\/p][p]Steam Next Fest has officially ended!\u00a0[\/p][p]...and it was amazing for GrimKeep. Making a game, even if you think it's the best since sliced bread, you can never know how it'll do. Technically, we still don't know until we launch, but maybe, just maybe, we can take SNF as an indicator. In that case, GrimKeep is in a very good place!\u00a0\n[\/p][p]Despite the huge influx of games this time, GrimKeep stood out and here are some things we saw during the event:[\/p][list][*][p]Each day had a higher player count than the day before.[\/p][\/*][*][p]Our demo reviews landed on a \"Very Positive\" rating.[\/p][\/*][*][p]We had many players that played way more hours than we expected.[\/p][\/*][*][p]We doubled our wishlist and follower count.[\/p][\/*][*][p]GrimKeep was in the top 1% of all demos played.[\/p][p][\/p][\/*][\/list][p][b]Thank you thank you thank you[\/b] for playing our game and for all the amazing feedback we\u2019ve gotten so far!! The latter might be the most valuable thing for us. We'll talk more about this in a future dev log, but here are the big headers:\u00a0[\/p][list][*][p]The demo was difficult. Too difficult. After the first few days, only about 12% of players had managed to defeat the boss. We scrambled during the SNF to get an update out to improve this. See post about that here: [url=\"https:\/\/store.steampowered.com\/news\/app\/3509380\/view\/679639030033290741?l=english\"][u]LINK[\/u][\/url][\/p][\/*][*][p]How attack and defense is calculated was not clear enough. We\u2019re working on that.[\/p][\/*][*][p]You helped us find a lot of small issues, like spelling and grammar errors, missing tooltips, odd interactions, and so on. Also added to the list of fixes to do![\/p][\/*][\/list][p]\nBy the time you\u2019re seeing this, the GrimKeep demo is no longer available. But not to worry, the launch is very soon. About a month actually on [b]November 30![\/b]\u00a0[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/f9624785a6d022dc140a70585bef02309cf4d252.png\"][\/img][\/p][p]\nHope to see all of you playing the full game soon!\n[\/p][p]\u2013 The GrimKeep Team[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/05b6be20cb812cbe73a0762bd1e60d1b9f1d71d5.png\"][\/img][\/p]","commentcount":8,"tags":["mod_reviewed","ModAct_1691520782_1793119109_0"],"language":0,"hidden":0,"forum_topic_id":"571552997743758250","event_gid":"679639030033292854","voteupcount":26,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552997743758250","rtime32_last_modified":1793317245,"news_post_gid":"0","rtime_mod_reviewed":1793119109,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793116175,"votes_up":26,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"601902470980009237","gidfeature2":"571552997743758250"},{"gid":"679639030033290741","clan_steamid":"103582791475097575","event_name":"Dev Update: Balance Pass","event_type":28,"appid":3509380,"server_address":null,"server_password":null,"rtime32_start_time":1792767360,"rtime32_end_time":1792768620,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Quick update on what we're doing to address the findings and feedback we're getting on the demo. \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"bc5c3cb381c342e12a0698e33f3bf8f3c7176cdd.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6eb7d5d8ec7f7e018112c7d9fce520a7cb57e50d.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679639030033290742","clanid":"45576167","posterid":"0","headline":"Dev Update: Balance Pass","posttime":1792767374,"updatetime":1792767374,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/6eb7d5d8ec7f7e018112c7d9fce520a7cb57e50d.jpg\"][\/img][\/p][p][\/p][p][b]We're blown away by the amazing reception to the GrimKeep demo[\/b], and we would like to thank you for all the top notch feedback on things that still need improvement. We have read through all of it and decided to tackle the one that has been mentioned the most:[\/p][p][\/p][h2][b]THE GAME IS VERY HARD[\/b][\/h2][p][\/p][p]In the full game, the first map, \"The Outskirts\", is only the start of your run. Since the Outskirts is the entire demo, we made it a bit more difficult to better represent the full game. It seems we overdid it though, so now we're reining it in! Here's what we've done in today's update:[\/p][list][*][p]The Huntress has a stronger starting item.[\/p][\/*][*][p]Increased Death\u2019s free re-rolls to 3.[\/p][\/*][*][p]The enemies at the second half of the map, including the elites and the bosses, have had a nerfing overhaul, mainly health and damage numbers.[\/p][\/*][*][p]The Tumid's actions have been tweaked.[\/p][\/*][*][p]Gold gain has increased.[\/p][\/*][*][p]Health costs on store items have been decreased.[\/p][\/*][*][p]Elites appear slightly later in the map on average.[\/p][\/*][*][p]Lower cost of buying extra re-rolls from The Gambler.[\/p][\/*][*][p]Lower cost of resetting sacrifices at The Mystic.[\/p][\/*][*][p]Lowered the cost of \"Rich Start I\" from 5 to 3 skill points. \n[\/p][\/*][\/list][h3][b]Tutorial[\/b]\n[\/h3][list][*][p]Added tutorial steps and UI highlighting to make it easier to discover the Sacrifice mechanic.[\/p][\/*][*][p]Added tooltip to sacrifices text\n[\/p][\/*][\/list][h3][b]NEW Dice and Items[\/b]\n[\/h3][list][*][p]We have added 4 new types of dice:[\/p][list][*][p]Low Die - only has 1,2,3 faces.[\/p][\/*][*][p]High Die - only has 4,5,6 faces.[\/p][\/*][*][p]Die of 6 - only has sixes.[\/p][\/*][*][p]Die of 1 - only has ones.[\/p][\/*][\/list][\/*][*][p]Added Unidentified Crystal item[\/p][\/*][*][p]Added Ring of Truth item[\/p][\/*][*][p]Added Left Monkey Paw[\/p][\/*][*][p]Added Right Monkey Paw[\/p][p][\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/b2a9a67a6d134412c14fe5bc3ef0d592827d1a11.png\"][\/img][\/p][p]We can't say this enough, thank you for playing and sharing your thoughts with us. This will be the last weekend to try the demo, so don't miss out![\/p][p][\/p][p]Keep it grim,\n\u2014 The GrimKeep team[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_783923276_1792782190_0"],"language":0,"hidden":0,"forum_topic_id":"571552638979776093","event_gid":"679639030033290741","voteupcount":37,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552638979776093","rtime32_last_modified":1793287605,"news_post_gid":"0","rtime_mod_reviewed":1792782190,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792756554,"votes_up":37,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"601902470980009237","gidfeature2":"571552638979776093"},{"gid":"688645594881721188","clan_steamid":"103582791475097575","event_name":"Demo Patch Notes: 0.0.4188","event_type":12,"appid":3509380,"server_address":null,"server_password":null,"rtime32_start_time":1792512060,"rtime32_end_time":1792517401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ec3ac278ac6b027b35fca9ee02f8986704b641ce.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688645594881721189","clanid":"45576167","posterid":"0","headline":"Demo Patch Notes: 0.0.4188","posttime":1792512084,"updatetime":1792512084,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45576167\/ec3ac278ac6b027b35fca9ee02f8986704b641ce.png\"][\/img][\/p][p][\/p][p]Hello everyone,  [\/p][p][\/p][p]We made a few updates to the demo that you can now enjoy! \nThis list includes all fixes since version 0.0.4018.[\/p][p][\/p][h3][b]Combat[\/b][\/h3][list][*][p]The Anger now becomes deadly when it acts, so its intent always shows the damage you'll actually take[\/p][\/*][*][p]If the enemy's next attack would kill you and you still have a sacrifice left, the sacrifices counter on the combo sheet shakes to remind you[\/p][\/*][*][p]The tutorial has a new step that explains sacrifices[\/p][\/*][\/list][h3][b]Journey & encounters[\/b][\/h3][list][*][p]The Duplicator no longer traps you when your inventory is full. You can confirm leaving an item behind[\/p][\/*][\/list][h3][b]Enemies[\/b][\/h3][list][*][p]Many enemies have shorter names (The Infernal Grimalkin is now The Grimalkin, The Accursed Portal is now The Portal), and enemy descriptions have been rewritten[\/p][\/*][*][p]Small reduction of difficulty on some enemies, including bosses.[\/p][\/*][*][p]The Huntress has a stronger starting item.[\/p][\/*][\/list][h3][b]Interface[\/b][\/h3][list][*][p]The pause menu has been redesigned, and you can now see your character's stats there[\/p][\/*][*][p]Dice and upgrade items have new icons on their item cards[\/p][\/*][*][p]The upgrade tooltip now explains that upgrades take effect immediately and don't use an item slot[\/p][\/*][*][p]On the death screen, the roll button shows how many free re-rolls you have left, and the tip reminds you about sacrifices[\/p][\/*][*][p]The victory screen has new artwork[\/p][\/*][\/list][h3][b]Controls & settings[\/b][\/h3][list][*][p]New haptics setting: turn controller vibration on or off[\/p][\/*][*][p]Roll selected dice setting: re-roll works with every die selected and no longer wastes a re-roll when none are selected[\/p][\/*][\/list][h3][b]Languages[\/b][\/h3][list][*][p]Leftover placeholder text has been replaced with the final text[\/p][\/*][*][p]All languages: enemy names and descriptions updated to match English, and missing encounter translations filled in[\/p][\/*][*][p]Chinese translation fixes across items, abilities, encounters and menus (for example Enchanted Mirror and Eye Glasses).[\/p][\/*][*][p]Fixed missing characters in Chinese, Japanese and Korean text[\/p][\/*][\/list][h3][b]Fixes[\/b][\/h3][list][*][p]Fixed saves made right at the start of a run being rejected as corrupted[\/p][\/*][*][p]Fixed save & quit on the death screen breaking your save. Quitting there now ends the run, like give up[\/p][\/*][*][p]Fixed your dice hand and bag getting out of sync (e.g. Unidentified Potion with an empty bag), and dice getting lost during discards[\/p][\/*][*][p]Fixed attack and re-roll getting locked when a heal removed a status effect at the start of your turn[\/p][\/*][*][p]Fixed delete and sell sometimes acting on the wrong item, or doing nothing[\/p][\/*][*][p]Fixed back\/cancel no longer working after you visit settings[\/p][\/*][*][p]Fixed a rare hang at startup after the intro[\/p][\/*][*][p]Fixed the end screen showing only one copy of an item you held twice[\/p][\/*][*][p]Fixed item names getting cut off on the end screen[\/p][\/*][*][p]Fixed A Presence in the Gloom mentioning an item you didn't get[\/p][\/*][\/list][p][\/p][p]Thank you soooo so much for all the positive messages and feedback <3 \n [\/p][p]\u2014\u00a0The GrimKeep Team[\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1691520782_1792514209_0"],"language":0,"hidden":0,"forum_topic_id":"572678319862109848","event_gid":"688645594881721188","voteupcount":6,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678319862109848","rtime32_last_modified":1793126323,"news_post_gid":"0","rtime_mod_reviewed":1792514209,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792160070,"votes_up":6,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"601902470980009237","gidfeature2":"572678319862109848"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["679639030033292855","679639030033290742"],"last_update_event":{"rtime":1792512060,"event_gid":"688645594881721188","announcement_gid":"688645594881721189","clan_account_id":45576167}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >GrimKeep is a roguelite dice-builder in a nightmare fairytale. Find items, roll your dice, and optimize your build to fire off massive damage. Cut through the horrors in the cursed city to get to the Princess. Then end her.</p><h2 class="bb_tag" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/7a96873bd64c32a228041adad0048927.poster.avif?t=1792426599" width=1170 height=652 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/7a96873bd64c32a228041adad0048927.webm?t=1792426599" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/7a96873bd64c32a228041adad0048927.mp4?t=1792426599" type="video/mp4"></video></span></h2><h2 class="bb_tag" ><strong>Big Damage Isn't Rolled. It's Built.</strong></h2><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Find items</strong> and try out different combinations for maximum damage.</p></li><li><p class="bb_paragraph" ><strong>Roll the dice</strong> for powerful combos that fire off your items’ bonuses and multipliers.</p></li><li><p class="bb_paragraph" ><strong>Tune your bag </strong>by acquiring dice with special abilities such as poison, healing or gold.</p></li><li><p class="bb_paragraph" ><strong>Further enhance your build at the Crucible. </strong>Melt items and their abilities into something new.</p></li><li><p class="bb_paragraph" ><strong>Outsmart the enemies</strong> by tactically using your defense, stuns, and heals. Your strategy determines how far you will make it.</p></li><li><p class="bb_paragraph" ><strong>Use what you learned</strong> to optimize your next run, or try a totally different build.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/b4f7c828820d5ebc7b5f7dae06ceee06.poster.avif?t=1792426599" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/b4f7c828820d5ebc7b5f7dae06ceee06.webm?t=1792426599" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/b4f7c828820d5ebc7b5f7dae06ceee06.mp4?t=1792426599" type="video/mp4"></video></span></p><h2 class="bb_tag" ><strong>A Rotten Nightmare Fairytale</strong></h2><p class="bb_paragraph" >The city is cursed and you must do what you can to set things right.</p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Choose your path</strong> on the map and assess the risks and rewards at every crossroads.</p></li><li><p class="bb_paragraph" ><strong>You are the hero of this fairytale</strong>. Play as The Huntress or The Beast and unlock more characters as you progress. Each with unique strengths to build and tune around.</p></li><li><p class="bb_paragraph" ><strong>Take a chance</strong> at encounters with curious strangers in the city. You may or may not regret it.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/2e2a54962257e00099e1498dcce53681.poster.avif?t=1792426599" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/2e2a54962257e00099e1498dcce53681.webm?t=1792426599" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/2e2a54962257e00099e1498dcce53681.mp4?t=1792426599" type="video/mp4"></video></span></p><h2 class="bb_tag" ><strong>What’s In the Game</strong></h2><ul class="bb_ul"><li><p class="bb_paragraph" >200+ items with endless combinations</p></li><li><p class="bb_paragraph" >60+ unique monsters</p></li><li><p class="bb_paragraph" >7 playable heroes</p></li><li><p class="bb_paragraph" >7 dice types</p></li><li><p class="bb_paragraph" >30 hero skills to unlock</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/66f17d6e7bb1b2a0506fbf74d0ed4c68.poster.avif?t=1792426599" width=1170 height=664 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/66f17d6e7bb1b2a0506fbf74d0ed4c68.webm?t=1792426599" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3509380/extras/66f17d6e7bb1b2a0506fbf74d0ed4c68.mp4?t=1792426599" type="video/mp4"></video></span></p><h2 class="bb_tag" ><strong>Made With Love</strong></h2><p class="bb_paragraph" >GrimKeep is made by a small dev team and we’re pouring our hearts into this game! We love to share our (sometimes chaotic) journey with you and always appreciate hearing what you think.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p>						</div>
					</div>
				
				
				

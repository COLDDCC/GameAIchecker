,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"714541292743297180","clanid":"46465630","posterid":"0","headline":"Meet Desktop Duck","posttime":1792507448,"updatetime":1792507448,"body":"[p]Hey everyone,[\/p][p][\/p][p]Thank you for checking out [b]Desktop Duck[\/b] during [b]Steam Next Fest[\/b]! We're a small team of two, and we've been building Desktop Duck on the side for about two years. We're so happy to finally let you meet Duck.[\/p][p][\/p][h2]The Demo is OUT NOW[\/h2][p]It's a small slice of Desktop Duck for now. We'd rather grow it alongside you than guess what you want, so what you tell us decides what comes next. [\/p][p][\/p][p]Hit [b]Download Demo[\/b] on the store page to get started. [\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/5354610?beta=0\"][\/dynamiclink][\/p][h2]Getting to know your duck[\/h2][list][*][p][b]Say hi.[\/b] The first time you launch, your duck walks you through a short setup and a quick lesson.[\/p][\/*][*][p][b]Move it.[\/b] Drag your duck and set it down gently.[\/p][\/*][*][p][b]Throw it.[\/b] Drag your duck and let go mid-swing.[\/p][\/*][*][p][b]Pet it.[\/b] Hold the middle mouse button (or Ctrl + click) on your duck and move your mouse back and forth.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46465630\/ff1c4b7d39185e7ab3fb94448a40cbe1c5a7efad.gif\"][\/img][\/p][p][\/p][\/*][*][p][b]Focus together.[\/b] Open [b]Today [\/b]page and click [b]\"Start Focus Session\" [\/b]from the menu, set the timer and press [b]Start[\/b]. [\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46465630\/9c72c7381a1894dbe613417e44b95fe9361743e0.gif\"][\/img][\/p][p][\/p][\/*][*][p][b]Claim gifts.[\/b] Time with your duck earns points. When it tells you a gift is ready, open the [b]Bag[\/b] from the menu and click the banner to unwrap it.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46465630\/c41e001f3e894b2a597a85d672dabbe59c502123.gif\"][\/img][\/p][\/*][\/list][p][\/p][h2]Help us shape Desktop Duck[\/h2][p]Tell us in our [url=\"https:\/\/discord.com\/invite\/customcrosshair\"]Discord[\/url] or on the Steam discussions page. Active community members in the Discord also have a [b]chance to get early access[\/b] to the full game before launch.[\/p][p][\/p][p]We'd love to hear:[\/p][list][*][p]What made you smile, and what got in the way[\/p][\/*][*][p]What you wish your duck could do[\/p][\/*][*][p]Any bugs, odd behavior or crashes[\/p][\/*][\/list][p][\/p][h2]What's coming in the full game[\/h2][list][*][p][b]More gifts and a full collection.[\/b] Earn feathers and spend them on gifts, and build up your collection. Over 110+ cosmetics to collect[\/p][\/*][*][p][b]Friends.[\/b] Your friends' ducks can join you on your desktop and send emotes.[\/p][\/*][*][p][b]Screen time Stats. [\/b]Get insights about your day.[\/p][\/*][*][p][b]Website Blocking. [\/b]If you like a  new productivity tool, Duck can close websites you tell it to close.[\/p][\/*][\/list][p][\/p][h2]That's all for now![\/h2][p]Thank you so much for checking out Desktop Duck. This is just the start, and there's a lot more to come. If you enjoy your duck, [b]adding Desktop Duck to your wishlist[\/b] is the best way to support us and keep it growing.[\/p][p][\/p][p]We look forward to your feedback![\/p]","commentcount":5,"tags":["mod_reviewed","ModAct_1894626024_1792509581_0"],"language":0,"hidden":0,"forum_topic_id":"571552431431910517","event_gid":"714541292743297179","voteupcount":27,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552431431910517","rtime32_last_modified":1793313508,"news_post_gid":"0","rtime_mod_reviewed":1792509582,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792439873,"votes_up":27,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"571552431431910515","gidfeature2":"571552431431910517"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["710038961706238434","714541292743297180"],"last_update_event":[]}};
						</script>
					


174b12.png\",\"5866413834640212ef922b4d6950bf5d2c087eac.png\",\"0e38f7e42884168d067898980296aea1105deab4.png\",null,\"386a9353fcfcb3e71b4f406921bb642a36f7b27c.png\",null,null,\"e6d8b6b551368e170ed98ceb093f52cc45223ae1.png\",null,\"5f2d220f425312ed4d0ffe977551fecf78b874fb.png\",null,\"6979ee821788a1df747ee0cd4daf1b6eadcff987.png\",\"5866413834640212ef922b4d6950bf5d2c087eac.png\",null,\"37834d171b35ddc7547f8d2b4e3cb57cd0dc2007.png\",null,\"f1654bce393680748beb6d69c2bca9f4454f94ea.png\",null,\"ba61fee7f0871bb5e165bad3cf7ed6faa38bfbad.png\",null,\"0a5e7ce027f4994426df2cb4bae1b8f5ee4ea43b.png\",null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"710038961706238434","clanid":"46465630","posterid":"0","headline":"Desktop Duck Out Now!","posttime":1793286566,"updatetime":1793286566,"body":"[p]The day has finally come. [b]Desktop Duck is out now on Steam![\/b][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46465630\/90ed317306ccef400f790ea8a424c6fa4129d17c.gif\"][\/img][\/p][p][\/p][p]Desktop Duck is [b]20% off for the next two weeks[\/b] to celebrate launch.[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3901850\/Desktop_Duck\/?utm_source=steam&utm_medium=announcement&utm_campaign=launch\"][\/dynamiclink][\/p][h3][b]So what's new?[\/b][\/h3][list][*][p]Over 120 cosmetics to collect[\/p][\/*][*][p]15+ items to unlock in the Store[\/p][\/*][*][p]Keep Up minigame with Steam leaderboards[\/p][\/*][*][p]Photo Booth[\/p][\/*][*][p]Multiplayer with up to 4 ducks in a Party[\/p][\/*][*][p]To-do list, Website Blocking and Homes[\/p][\/*][\/list][p]And so much more.[\/p][p][\/p][hr][\/hr][p][\/p][h3][b]\ud83c\udf81 FREE Launch Party Pack[\/b][\/h3][p]To celebrate the release of Desktop Duck, everyone who launches the game during the launch party gets a gift waiting in their bag. Just start Desktop Duck with Steam running and it's yours.[\/p][p][\/p][p][b]Launch Party Pack[\/b][\/p][list][*][p]Party Hat[\/p][\/*][*][p]Party Blower[\/p][\/*][*][p]Confetti typing effect[\/p][\/*][\/list][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46465630\/9678c5a159af42aeb07e613132a0a14dffda57ae.gif\"][\/img][\/p][p][\/p][p][b]Coming from Crosshair X or Mouse X?[\/b] There is a special gift in your bag too, as a thank you for supporting us. Own either one on the same Steam account and it arrives alongside the Launch Party Pack.[\/p][p][\/p][hr][\/hr][p][\/p][h3][b]What's next?[\/b][\/h3][p]Launch is just the start. [\/p][p][\/p][p]We have more hats, more minigames and more for the duck to do on the way, and [b]the Discord is where it all gets decided[\/b]. Vote in polls, request features, see what we're working on, and report anything the duck does that it shouldn't. Our playtesters shaped this release from there, and you can shape the next one.[\/p][p][url=\"https:\/\/discord.com\/invite\/customcrosshair\"]Join our Discord[\/url][\/p][p][\/p][hr][\/hr][p][\/p][h3][b]One last ask [\/b][\/h3][p]If you enjoy your duck, [b]please leave a review on Steam.[\/b] Launch week reviews make a huge difference for a small team, and every one of them gets read.[\/p][p][\/p][hr][\/hr][p][\/p][p]Thank you to everyone who played the demo and wishlisted, and [b]a huge shoutout to our playtesters[\/b] in [url=\"https:\/\/discord.com\/invite\/customcrosshair\"]our Discord[\/url]. Every bug report, clip and suggestion made it in. Desktop Duck would not be what it is today without you.[\/p][p][\/p][p]Thank you for being here on day one,[\/p][p][\/p][p]\ud83e\udd86\ud83d\udc96[\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_770318842_1793286606_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451580735","event_gid":"710038961706238433","voteupcount":18,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175573451580735","rtime32_last_modified":1793332758,"news_post_gid":"0","rtime_mod_reviewed":1793286607,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793207681,"votes_up":18,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"571552431431910515","gidfeature2":"568175573451580735"},{"gid":"714541292743297179","clan_steamid":"103582791475987038","event_name":"Meet Desktop Duck","event_type":28,"appid":3901850,"server_address":null,"server_password":null,"rtime32_start_time":1792507440,"rtime32_end_time":1792509960,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Try it free and tell us what to build next\",\"Probier es kostenlos aus und sag uns, was wir als N\u00e4chstes bauen sollen\",\"Essaie-le gratuitement et dis-nous quoi cr\u00e9er ensuite\",\"Provalo gratis e dicci cosa costruire dopo\",\"\ubb34\ub8cc\ub85c \ud50c\ub808\uc774\ud558\uace0 \ub2e4\uc74c\uc5d0 \ub9cc\ub4e4 \uac83\uc744 \uc54c\ub824 \uc8fc\uc138\uc694\",\"Pru\u00e9balo gratis y dinos qu\u00e9 crear a continuaci\u00f3n\",\"\u514d\u8d39\u8bd5\u73a9\uff0c\u544a\u8bc9\u6211\u4eec\u63a5\u4e0b\u6765\u505a\u4ec0\u4e48\",null,\"\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u043d\u0430\u043c \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435\",null,\"\u7121\u6599\u3067\u904a\u3093\u3067\u3001\u6b21\u306b\u4f5c\u308b\u3082\u306e\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\",\"Experimenta gr\u00e1tis e diz-nos o que criar a seguir\",\"Wypr\u00f3buj za darmo i powiedz nam, co zrobi\u0107 dalej\",null,\"Probeer het gratis en vertel ons wat we hierna moeten maken\",null,null,\"Testa gratis och ber\u00e4tta vad vi ska bygga h\u00e4rn\u00e4st\",null,\"Vyzkou\u0161ej ho zdarma a \u0159ekni n\u00e1m, co m\u00e1me ud\u011blat d\u00e1l\",null,\"\u00dccretsiz dene, s\u0131rada ne yapaca\u011f\u0131m\u0131z\u0131 bize s\u00f6yle\",\"Experimente de gra\u00e7a e diga o que devemos criar em seguida\",null,\"\u0394\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03ad \u03c4\u03bf \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03ba\u03b1\u03b9 \u03c0\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03c4\u03b9 \u03bd\u03b1 \u03c6\u03c4\u03b9\u03ac\u03be\u03bf\u03c5\u03bc\u03b5 \u03bc\u03b5\u03c4\u03ac\",null,\"\u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e \u0439 \u043f\u0456\u0434\u043a\u0430\u0436\u0438, \u0449\u043e \u043d\u0430\u043c \u0440\u043e\u0431\u0438\u0442\u0438 \u0434\u0430\u043b\u0456\",\"Pru\u00e9balo gratis y dinos qu\u00e9 crear a continuaci\u00f3n\",\"Ch\u01a1i th\u1eed mi\u1ec5n ph\u00ed v\u00e0 cho ch\u00fang t\u1edb bi\u1ebft n\u00ean l\u00e0m g\u00ec ti\u1ebfp theo\",null,\"Coba gratis dan beri tahu kami apa yang perlu dibuat selanjutnya\",null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"ef91c409c7276a0d9e568ba97070c768ee2c9df5.png\",\"58706632882fef330264f0ef51c60224e1da9edb.png\",\"359b267bffb8d7155cb9b5d62f8d211cfcd527b9.png\",\"672c26ab0c859f1586f0bd19bd1a9aa760ae5754.png\",\"b80b1da43fcf12b22b1113395288f514ca9d9caa.png\",\"06e9944abf44bd8f0f04d32a91de4eb3475ac4c2.png\",\"ea719b9eb2dffa7f8fd17ad72cadf43d74ee52fa.png\",null,\"e04211a9844cb061844b6c62ef29781d0fd9ab45.png\",null,\"956f1834c29809a41cfb4e042c8192143deba348.png\",\"f9145f90bee985391e0c18cf00485d659c27fa36.png\",\"0f05d155abda486c1a195b440d6e4a6fae86c9f5.png\",null,\"48272bfff0ff2db7e5579bd922f947a4403490ed.png\",null,null,\"4f4bf6adf467a05cd54047e4e5badd493332eacd.png\",null,\"b7c498cd57a93ba534aa9918af6a84b6a15e77f3.png\",null,\"3e66d5eccef0e3ce09f8a25b4962a24b307d3c50.png\",\"433115211a431bc22f65761f66d070d6b31b8f32.png\",null,\"f7c5b8b89f75c5d8
																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"705535362075722316","clan_steamid":"103582791475736742","event_name":"S.O.N.A.R. is OUT NOW","event_type":10,"appid":4096830,"server_address":null,"server_password":null,"rtime32_start_time":1793286420,"rtime32_end_time":1793291401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"d42c643152a088a1fe2fbe783467ffbdc5076603.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"705535362075722317","clanid":"46215334","posterid":"0","headline":"S.O.N.A.R. is OUT NOW","posttime":1793286445,"updatetime":1793286445,"body":"[p]All hands on deck![\/p][p]The moment has finally arrived: grab your gear, rally your crewmates, and prepare for immediate disaster. [b]S.O.N.A.R. - Submarine Operators Not Actually Ready[\/b] is officially [b]OUT NOW on Steam![\/b][\/p][p]Thank you. If you\u2019re reading this, you\u2019re most likely part of the amazing community that helped us bring this game to life. All your feedback, long hours of testing, and endless balancing have finally led us to this moment.[\/p][p][\/p][h3][b]WHAT IS S.O.N.A.R.?[\/b][\/h3][p]S.O.N.A.R. is a chaotic 1\u20136 player coop submarine simulator where teamwork is essential, panic is guaranteed, and sinking is always just one wrong button away.[\/p][list][*][p][b]1 to 6 Player Coop:[\/b] Coordinate via proximity voice chat to pilot, manage stations, fire weapons, repair leaks, and stop fires before you reach the ocean floor.[\/p][\/*][*][p][b]Open World Survival Mode:[\/b] Over 100+ hours of sandbox exploration, discovering ports, buying upgrades, and deep sea survival across a massive map.[\/p][\/*][*][p][b]6v6 Team Deathmatch: [\/b]Engage in thrilling submarine-vs-submarine combat across 8 epic maps. Dominate the ocean and claim your spot at the top of the leaderboards![\/p][\/*][*][p][b]Unlock new uniforms[\/b], weapons and food as you level up.[\/p][\/*][*][p][b]Steam Deck Verified:[\/b] Fully optimized controls and performance out of the box so you can wreck submarines anywhere, anytime.[\/p][p][\/p][\/*][\/list][h3][b]SPECIAL LAUNCH DISCOUNT[\/b][\/h3][p]To celebrate launch day, [b]S.O.N.A.R.[\/b] is available right now for [b]$9.99 \/ 9.34\u20ac[\/b] but you can grab it at a [b]15% launch discount[\/b] for a limited time! With regional price adjustments.\u00a0[\/p][p]At this price, it\u2019s the perfect excuse for an all night coop session with your friends![\/p][h3][b]SUPER FAN SUPPORTER PACK: WE ADVISE NOT TO BUY THIS...[\/b][\/h3][p]Alongside the game, we are releasing the [b]Super Fan Supporter Pack[\/b] for those who want to flex exclusive cosmetics underwater.[\/p][p]Honestly, we [b]strongly advise NOT to buy it[\/b], it\u2019s completely unnecessary, offers zero gameplay advantages, and is a terrible use of your hard earned cash... [b]UNLESS[\/b] you actually want Abylight to keep making these absurdly crazy games! If you insist on fueling our chaotic game development, we certainly won't stop you! \ud83d\ude09[\/p][p][\/p][h3][b]Grab S.O.N.A.R. today, assemble your crew, and try not to drown![\/b][\/h3][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4096830\/SONAR_Submarine_Operators_Not_Actually_Ready\/\"][\/dynamiclink][\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_770318842_1793286513_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451580585","event_gid":"705535362075722316","voteupcount":37,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793286420,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175573451580585","rtime32_last_modified":1793330252,"news_post_gid":"0","rtime_mod_reviewed":1793286513,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793267475,"votes_up":37,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"578299159633827525","gidfeature2":"568175573451580585"},{"gid":"705535362075722164","clan_steamid":"103582791475736742","event_name":"S.O.N.A.R. is Steam Deck Verified","event_type":28,"appid":4096830,"server_address":null,"server_password":null,"rtime32_start_time":1793198220,"rtime32_end_time":1793199600,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"8a2b14b13d76161f62bde3ac3a846d2d64a1914e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"705535362075722165","clanid":"46215334","posterid":"0","headline":"S.O.N.A.R. is Steam Deck Verified","posttime":1793198223,"updatetime":1793198379,"body":"[p]All hands on deck! We have some massive news to share with you today\u2026 and a ridiculously fun feature to reveal right before we hit the big launch![\/p][p][\/p][h3][b]S.O.N.A.R. is Official Steam Deck Verified![\/b][\/h3][p]We are thrilled to announce that [b]S.O.N.A.R. Submarine Operators Not Actually Ready[\/b] has officially received the [b]Steam Deck Verified[\/b] green checkmark! You can now take your underwater chaos, submarine navigation, and crew antics anywhere you go, with fully optimized controls and seamless portable performance on day one.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46215334\/f92de3fd04e670b17455493a0c02d4ed753fdb6f.png\"][\/img][\/p][p][\/p][h3][b]Top 50 Most-Played Demo at Steam Next Fest![\/b][\/h3][p]A huge [b]THANK YOU[\/b] to our amazing community! Thanks to all of you who dived into the deep ocean with us, [b]S.O.N.A.R. made it into the top 50 most played demos during Steam Next Fest![\/b] Seeing thousands of crews attempt to keep their submarines afloat (and fail spectacularly) has been an absolute blast.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46215334\/6d9703631d7539625a457509958492ed7068fdb0.jpg\"][\/img][\/p][p][\/p][h3][b]New Feature Alert: The Human Torpedo![\/b][\/h3][p]To celebrate, we\u2019ve added a brand new, completely unhinged maneuver to the game.[\/p][p]Ever felt like one of your crewmates wasn't pulling their weight? [b]You can now physically push a teammate inside a torpedo tube and launch them directly into the sea![\/b][\/p][p]Pull the lever, and enjoy a unique launch animation with some [i]very[\/i] surprising in game effects. Who needs standard torpedoes when you have expendable friends?\u00a0[\/p][p][\/p][p][dynamiclink href=\"https:\/\/youtu.be\/AMn2YZlRFuY\"][\/dynamiclink][\/p][h3][b]LAUNCHING TOMORROW![\/b][\/h3][p]The wait is almost over. [b]S.O.N.A.R. launches officially TOMORROW![\/b][\/p][p]Make sure to [b]add S.O.N.A.R. to your Steam Wishlist[\/b] right now so you get notified the second the game goes live, and don't miss out on our special launch discount![\/p][p]\n[\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1894963720_1793203768_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451474813","event_gid":"705535362075722164","voteupcount":25,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793198220,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175573451474813","rtime32_last_modified":1793320480,"news_post_gid":"0","rtime_mod_reviewed":1793203769,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793196014,"votes_up":25,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"578299159633827525","gidfeature2":"568175573451474813"},{"gid":"705535362075723184","clan_steamid":"103582791475736742","event_name":"Changelog 1.0.1.0.","event_type":12,"appid":4096830,"server_address":null,"server_password":null,"rtime32_start_time":1793290024,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"705535362075723185","clanid":"46215334","posterid":"0","headline":"Changelog 1.0.1.0.","posttime":1793290024,"updatetime":1793290024,"body":"- Added a small fix to make sure everyone who played the demo or joined a playtest gets their exclusive skin during these first few days after launch.\n- Fixed an issue with pipe leaks on the lower deck.","commentcount":2,"tags":["patchnotes","mod_reviewed","ModAct_1827889981_1793291328_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451585086","event_gid":"705535362075723184","voteupcount":16,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175573451585086","rtime32_last_modified":1793326485,"news_post_gid":"0","rtime_mod_reviewed":1793291328,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793290024,"votes_up":16,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"578299159633827525","gidfeature2":"568175573451585086"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["705535362075722317","705535362075722165"],"last_update_event":{"rtime":1793290024,"event_gid":"705535362075723184","announcement_gid":"705535362075723185","clan_account_id":46215334}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				

					<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="game_area_reviews" class="game_area_description">
						<h2>Reviews</h2>
												<p>“S.O.N.A.R. is a great simulator of stress, panic and chaos.”<br><a href="https://steamcommunity.com/linkfilter/?u=https%3A%2F%2Fvgtimes.com%2Fvideo-game-previews%2F171204-preview-sonar.html" target="_blank" rel=" noopener"  >VG-Times</a><br></p>
					</div>
				
				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>Join our community on Discord</h2>				<p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/f08f5d8281bfc6e187bdba65f2d72b2c.avif?t=1793286593" width=1500 height=300 /></span></p></p>
			</div>
			</div>				<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >S.O.N.A.R. is a 1–6 player online co-op submarine simulator where teamwork is essential, panic is inevitable, and sinking is always just one wrong button away. Coordinate with your crew, use sonar to detect threats, and operate a cutting-edge submarine through combat operations, stealth infiltrations, and treasure recovery missions. Repair catastrophic malfunctions, recalibrate complex systems, and desperately hope that the person sitting next to you isn't just randomly pressing buttons.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/146cae65373806c2dbecabc0faf487fa.avif?t=1793286593" width=1241 height=476 /></span></p><h2 class="bb_tag" >UNDERWATER MISSIONS</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/b11bfedf433abacb0e949f099c376a33.poster.avif?t=1793286593" width=800 height=168 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/b11bfedf433abacb0e949f099c376a33.webm?t=1793286593" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/b11bfedf433abacb0e949f099c376a33.mp4?t=1793286593" type="video/mp4"></video></span></p><p class="bb_paragraph" >The oceans are under enemy control. Gather a team of highly trained specialists (or at least people who claim they know what they're doing) and complete dangerous missions beneath the waves.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >- Locate hostile vessels with sonar and send them to the bottom of the sea. Preferably before they do the same to you.</p><p class="bb_paragraph" >- Protect valuable cargo ships. Because apparently the military couldn't find anyone else to babysit them.</p><p class="bb_paragraph" >- Hunt for treasures. Use sonar to search the ocean floor for lost riches, forgotten artifacts, and evidence of previous crews' poor decisions.</p><p class="bb_paragraph" >- Slip past enemy destroyers undetected. Stay quiet. Stay hidden. And whatever you do, don't sneeze.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >COOPERATION</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/da5fc33a2619fbdb3a7976be11b64085.poster.avif?t=1793286593" width=1170 height=218 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/da5fc33a2619fbdb3a7976be11b64085.webm?t=1793286593" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/da5fc33a2619fbdb3a7976be11b64085.mp4?t=1793286593" type="video/mp4"></video></span></p><p class="bb_paragraph" >Up to four crew members must work together to manage nine critical stations, including navigation, diving, sonar, periscope operations, engineering, and damage control. Your sonar operator tracks contacts while the rest of the crew keeps the submarine alive. When the sub catches fire or starts taking on water from twelve different holes at once, communication is the only thing standing between you and becoming fish food. </p><p class="bb_paragraph" >Use proximity voice chat to:</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >- Shout urgent orders.</p><p class="bb_paragraph" >- Warn everyone about imminent disaster.</p><p class="bb_paragraph" >- Explain why the catastrophe is definitely someone else's fault.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >And if a crewmate starts reading the manual during a torpedo attack, give ’em a friendly slap back to reality! </p><p class="bb_paragraph" >Nothing says &quot;successful mission&quot; quite like a victory dance while all hell breaks loose.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >CUSTOMIZATION</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/240851f940acf16a28d8a86d26be1a2a.poster.avif?t=1793286593" width=800 height=150 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/240851f940acf16a28d8a86d26be1a2a.webm?t=1793286593" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4096830/extras/240851f940acf16a28d8a86d26be1a2a.mp4?t=1793286593" type="video/mp4"></video></span></p><p class="bb_paragraph" >In S.O.N.A.R. every character is unique. Choose from dozens of uniforms, hats, and questionable fashion choices. Customize your equipment before deployment and unlock new gear as you level up. If you're going to make terrible decisions underwater, you should at least look good doing it.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >SURVIVAL</h2><p class="bb_paragraph" >Machines aren't the only things that break down. Humans do too.</p><p class="bb_paragraph" >Manage your crew's food supplies, rest schedules, and overall well-being. Neglect them for too long and they'll become exhausted, seasick, delirious, or mysteriously incapable of following simple instructions.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Health Tip: You really, really don't want to be vomiting inside your diving helmet when it's your turn to load the torpedoes.</p><p class="bb_paragraph" >Trust us on this one.</p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">

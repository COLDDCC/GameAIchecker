ht_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[700792893],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"685268529568551611","clanid":"46277000","posterid":"0","headline":"Watch DEADLINE demo gameplay","posttime":1792690899,"updatetime":1792691172,"body":"[p]Get a look at the [b]DEADLINE: Afterlife Processing[\/b] demo, available now during [b]Steam Next Fest[\/b]![\/p][p]Every soul has a file. Read their records, weigh their choices and decide where they go: heaven or hell. Some verdicts are easy. Most aren\u2019t.[\/p][p]Play the demo now and tell us how many souls you got right \u2696\ufe0f[\/p][p]Join our Discord: [url=\"https:\/\/discord.gg\/PHnJgxH8nA\"]https:\/\/discord.gg\/PHnJgxH8nA[\/url][\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_1691520782_1792692910_0"],"language":0,"hidden":0,"forum_topic_id":"567049039351286682","event_gid":"685268529568551610","voteupcount":8,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049039351286682","rtime32_last_modified":1793124356,"news_post_gid":"0","rtime_mod_reviewed":1792692911,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792689729,"votes_up":8,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"569300630414509145","gidfeature2":"567049039351286682"},{"gid":"685268529568551487","clan_steamid":"103582791475798408","event_name":"Next Fest update: thank you, and here\u2019s everything we fixed","event_type":13,"appid":5142140,"server_address":null,"server_password":null,"rtime32_start_time":1792665960,"rtime32_end_time":1792670401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Seven demo updates in one week, all thanks to you\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Seven updates since Next Fest began: no more getting stuck, full controller support, smoother performance and more.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"47363c2b44e8c6a1a2f6d9823a60fda248921d73.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"685268529568551488","clanid":"46277000","posterid":"0","headline":"Next Fest update: thank you, and here\u2019s everything we fixed","posttime":1792665992,"updatetime":1792666158,"body":"[p]Hey everyone! \ud83d\udc4b[\/p][p]Next Fest has been a wild ride, and we\u2019ve been reading [b]every[\/b] bug report, review and Discord message, even when we were too busy fixing things to reply. Thank you, seriously. Since the fest started we\u2019ve pushed [b]seven updates[\/b] to the demo, almost all of them because of you.[\/p][p]Here\u2019s what changed:[\/p][p][b]\ud83d\udd13 No more getting stuck[\/b][\/p][list][*][p]The office door no longer stays locked after punching in[\/p][\/*][*][p]You can\u2019t get trapped in the office at the end of a shift anymore[\/p][\/*][*][p]The upgrade form no longer disappears or gets stuck behind anything[\/p][\/*][*][p]Restarting from the menu now gives you a truly fresh run[\/p][\/*][*][p]The last shift is much clearer about what\u2019s left to do[\/p][\/*][\/list][p][b]\ud83c\udfae Controls[\/b][\/p][list][*][p][b]Full controller support[\/b], menus and settings included[\/p][\/*][*][p]The big lever: just [b]hold right-click \/ RT[\/b], no more dragging your mouse off the desk[\/p][\/*][*][p]Doors open with a click[\/p][\/*][*][p]A clear prompt when it\u2019s time to leave for the day[\/p][\/*][\/list][p][b]\u26a1 Runs better[\/b][\/p][list][*][p]Much lighter on graphics cards by default, plus a frame limit option[\/p][\/*][*][p]Fixed guide pages blending together on some PCs[\/p][\/*][*][p]Alt-tab works properly[\/p][\/*][*][p]Motion blur can now be turned off[\/p][\/*][\/list][p][b]\u2795 And[\/b] a [b]Wishlist on Steam[\/b] button in the menus, in case you want to keep an eye on us \ud83d\ude04[\/p][p]We\u2019ve also read that some of you got a bit lost here and there, so we\u2019ve made changes all over to keep things as clear as possible, and we\u2019re not done yet. Please keep the feedback coming. As a solo developer, every single report genuinely helps.[\/p][p]If you find anything else, the [b]Report a Bug[\/b] button in the pause menu goes straight to us, or come say hi on Discord. We\u2019re listening, even when we\u2019re quiet.[\/p][p]See you at your station. \ud83d\udd8b\ufe0f[\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_773020726_1792666420_0"],"language":0,"hidden":0,"forum_topic_id":"567049039351255617","event_gid":"685268529568551487","voteupcount":14,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049039351255617","rtime32_last_modified":1793241933,"news_post_gid":"0","rtime_mod_reviewed":1792666420,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792665746,"votes_up":14,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"569300630414509145","gidfeature2":"567049039351255617"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["685268529568552188","685268529568551611"],"last_update_event":{"rtime":1792665960,"event_gid":"685268529568551487","announcement_gid":"685268529568551488","clan_account_id":46277000}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/bf41a1aa564ce6d8ee49538a280caeb8.avif?t=1792972542" width=616 height=213 /></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center">Welcome to the Dispositions Section. Your post is Station 9. The dead are waiting for you, don't let them pile up. Where the line starts is not your concern. It ends at your press. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c8991cbe31c8fdaf91b58828f4686ede.poster.avif?t=1792972542" width=800 height=530 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c8991cbe31c8fdaf91b58828f4686ede.webm?t=1792972542" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c8991cbe31c8fdaf91b58828f4686ede.mp4?t=1792972542" type="video/mp4"></video></span></p><p class="bb_paragraph" >Every soul is a life split into three fragments, printed in amber on a terminal that's probably older than you. Some fragments are confessions. Some are alibis. Some are just what the neighbors saw. The record is all you get, and the record is rarely the whole story. </p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/6b879df37414b2a5dff565d527a42d06.poster.avif?t=1792972542" width=800 height=530 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/6b879df37414b2a5dff565d527a42d06.webm?t=1792972542" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/6b879df37414b2a5dff565d527a42d06.mp4?t=1792972542" type="video/mp4"></video></span></p><p class="bb_paragraph" >The rules are on the board. Numbered, amended, always right. Theft? Descend. Charity? Ascend. Got any questions? Consult the board. When no directive quite fits, the operator decides. Always careful.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c997657224be2bbc5126778419e05cc8.poster.avif?t=1792972542" width=800 height=530 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c997657224be2bbc5126778419e05cc8.webm?t=1792972542" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/c997657224be2bbc5126778419e05cc8.mp4?t=1792972542" type="video/mp4"></video></span></p><p class="bb_paragraph" >Set the verdict. Pull the lever. The seal comes down, and the soul is paperwork now. Carry it to Disposition A or Disposition B. Gold or Red. Two exits. No appeals.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/07d7b7da0861ec896344dcb5ba4ea983.poster.avif?t=1792972542" width=800 height=530 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/07d7b7da0861ec896344dcb5ba4ea983.webm?t=1792972542" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/07d7b7da0861ec896344dcb5ba4ea983.mp4?t=1792972542" type="video/mp4"></video></span></p><p class="bb_paragraph" >Every processed soul prints a slip. Every slip is money. At the window, the catalog sells what money can buy: better boots, a faster line, upgrades for your press, machines for the parts of the job you like least. Every page of the catalog makes the next shift easier, hopefully. And there's always another page.</p><p class="bb_paragraph" ></p><ul class="bb_ul"><li><p class="bb_paragraph" >Read the written lives of the dead, three fragments each.</p></li><li><p class="bb_paragraph" >A rulebook that never stops growing. Rules shift, rules get amended. Keep up. </p></li><li><p class="bb_paragraph" >One room. One machine. A line with no end.</p></li><li><p class="bb_paragraph" >Earn by the soul, spend on the machine. The catalog always has more.</p></li><li><p class="bb_paragraph" >No health bars, no minimaps, no menus. The interface is the room: paper, machines, and ink.</p></li><li><p class="bb_paragraph" >A handcrafted soundscape. Every stamp, every gear.</p></li></ul><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center">The line won't wait. Take your number.<br> <br><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5142140/extras/51ff489ed2ec780e44359d2b53d05a03.avif?t=1792972542" width=615 height=152 /></span></p>						</div>
					</div>
					<div class="game_page_autocollapse">
		<div id="game_area_content_descriptors" class="game_area_description">
			<h2>Mature Content Description</h2>
			<p>The developers describe the content like this:</p>
			<p><i>
			DEADLINE: Afterlife Processing is a game about judging the souls of the dead in a bureaucratic afterlife. Its mature content is purely thematic and text-based: you are tasked with reading short descriptions of human lives, which may include non-graphic descriptions of death, crimes (such as theft, fraud, and killings), moral wrongdoing, and occasionally references to alcohol. Nothing violent or sexual is depicted on screen; the souls are abstract glowing spheres, and all sensitive content exists as brief, matter-of-fact text. The game's themes include death, guilt, and judgment, and are treated seriously and may weigh on some players, but there is absolutely no gore, no explicit content, and no depicted violence.				</i>
			</p>
		</div>
	</div>
	
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">

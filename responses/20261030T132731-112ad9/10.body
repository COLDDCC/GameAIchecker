egoryids&quot;:[62],&quot;controller_categoryids&quot;:[28,55]},&quot;reviews&quot;:null,&quot;basic_info&quot;:null,&quot;tags&quot;:[],&quot;assets&quot;:null,&quot;release&quot;:null,&quot;platforms&quot;:null,&quot;game_rating&quot;:{&quot;type&quot;:null,&quot;rating&quot;:null,&quot;descriptors&quot;:[],&quot;interactive_elements&quot;:null,&quot;agency&quot;:null,&quot;banned&quot;:null,&quot;esrb_online_music_not_rated&quot;:null,&quot;esrb_online_interactions_not_rated&quot;:null,&quot;survey_interactive_elements&quot;:[],&quot;required_age&quot;:null,&quot;use_age_gate&quot;:null,&quot;descriptor_images&quot;:[],&quot;content_survey_notes&quot;:&quot;DEADLINE: Afterlife Processing is a game about judging the souls of the dead in a bureaucratic afterlife. Its mature content is purely thematic and text-based: you are tasked with reading short descriptions of human lives, which may include non-graphic descriptions of death, crimes (such as theft, fraud, and killings), moral wrongdoing, and occasionally references to alcohol. Nothing violent or sexual is depicted on screen; the souls are abstract glowing spheres, and all sensitive content exists as brief, matter-of-fact text. The game's themes include death, guilt, and judgment, and are treated seriously and may weigh on some players, but there is absolutely no gore, no explicit content, and no depicted violence.&quot;,&quot;image_url&quot;:null,&quot;image_target&quot;:null},&quot;is_coming_soon&quot;:1,&quot;best_purchase_option&quot;:null,&quot;purchase_options&quot;:[],&quot;self_purchase_option&quot;:null,&quot;screenshots&quot;:null,&quot;trailers&quot;:null,&quot;supported_languages&quot;:[],&quot;store_url_path_override&quot;:null,&quot;free_weekend&quot;:null,&quot;unlisted&quot;:null,&quot;game_count&quot;:null,&quot;internal_name&quot;:null,&quot;full_description_bbcode&quot;:null,&quot;is_free_temporarily&quot;:null,&quot;assets_without_overrides&quot;:null,&quot;user_filter_failure&quot;:null,&quo
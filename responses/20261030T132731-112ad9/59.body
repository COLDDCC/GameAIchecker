ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688646863473082699","clanid":"46236963","posterid":"0","headline":"Oct 28 Update","posttime":1793162731,"updatetime":1793162731,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46236963\/439b8cf33399dea26d17daa5a4ae1aabb59dda96.png\"][\/img][\/p][p]Demo:[\/p][p]When mouse hovers over a hyperlink, that hyperlink is displayed by human text. (For those concerned about cybersecurity, the previous link was a jump scare. I'm sorry I underestimated this issue.)[\/p][p]A few typo fixed.[\/p][p]A few glyphs reworked.[\/p][p]\"Annotation text stacking in the same cell\" should be really fixed this time.[\/p][p]In small game 1, win condition is written below card row.[\/p][p]More names have been added to the credits. Please contact me if your name is missing.[\/p][p][\/p][p]Full game:[\/p][p]One more message in chapter 5.[\/p][p]Replaced 8 th message in epilogue.[\/p][p]Removed some text that simply describes a detailed and unnecessary scientific concept.[\/p][p]Alien notepad now has a cursor.[\/p][p][\/p][p]Another thing I'd like to mention is:[\/p][p]Someone is developing font and input method for this.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46236963\/07a5bbb6b8cbf49b50fa560efd60406ab97a33a1.gif\"][\/img][\/p][p]Maybe we really can have an alien language community.[\/p][p]Even if not, it is really encouraging my game had an input method before release. I think I might be proud of this for many years.[\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1598046824_1793164693_0"],"language":0,"hidden":0,"forum_topic_id":"574930972896693303","event_gid":"688646863473082698","voteupcount":34,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930972896693303","rtime32_last_modified":1793318921,"news_post_gid":"0","rtime_mod_reviewed":1793164694,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793162594,"votes_up":34,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585056119637005474","gidfeature2":"574930972896693303"},{"gid":"688646229288032408","clan_steamid":"103582791475758371","event_name":"Release Date: Nov 2nd","event_type":28,"appid":1858720,"server_address":null,"server_password":null,"rtime32_start_time":1793005020,"rtime32_end_time":1793008620,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,nul
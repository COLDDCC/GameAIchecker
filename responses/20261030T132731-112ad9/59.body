,\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688646229288032409","clanid":"46236963","posterid":"0","headline":"Release Date: Nov 2nd","posttime":1793005057,"updatetime":1793005057,"body":"[p]Title says it all.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46236963\/4fcdbfc43b31667ac449972efe863bf9fcba88ce.png\"][\/img][\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1425146861_1793005890_0"],"language":0,"hidden":0,"forum_topic_id":"573804739774639587","event_gid":"688646229288032408","voteupcount":28,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804739774639587","rtime32_last_modified":1793280538,"news_post_gid":"0","rtime_mod_reviewed":1793005890,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793005049,"votes_up":28,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585056119637005474","gidfeature2":"573804739774639587"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["688646863473082699","688646229288032409"],"last_update_event":{"rtime":1793162700,"event_gid":"688646863473082698","announcement_gid":"688646863473082699","clan_account_id":46236963}}};

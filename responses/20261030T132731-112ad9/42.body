							var StoreDefaults = {"PartnerEventStore":[{"gid":"674009530499077782","clan_steamid":"103582791475699132","event_name":"DEMO UPDATE","event_type":28,"appid":720830,"server_address":null,"server_password":null,"rtime32_start_time":1792778400,"rtime32_end_time":1792781640,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,null,null,null,null,null,null,\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"674009530499077783","clanid":"46177724","posterid":"0","headline":"DEMO UPDATE","posttime":1792778452,"updatetime":1792778452,"body":"[p][b]DEMO UPDATE[\/b]\n\n[img src=\"{STEAM_CLAN_IMAGE}\/46177724\/b37c2b49cc65a8b6bd5b45db6d0a863085937c6d.png\"][\/img][\/p][p]Thank you to everyone who has downloaded the Subtransit Drive demo, given it a try, and shared their feedback! We're keeping a close eye on your comments and continuing to improve the game.\n\nWe've just released a major update for the demo, featuring bug fixes, new features, and a number of gameplay improvements.\n\n[b]What's changed:[\/b]\n\n[\/p][quote][p][b]UI and Settings[\/b]\nAdded support for ultrawide displays.\nUI and map scaling can now be adjusted independently.\nAdded missing UI icons.\nFixed the display of delays and rush hour.\nFixed an issue with mouse sensitivity settings not being saved.\n\n[b]Gameplay and Train Systems[\/b]\nAdded the train timetable (press T).\nAdded active vigilance reminders when braking under the ARS system, as well as alerts for train system messages, including \"High Current\".\nAdded per-car train system control via the MFDU.\nAdded the ability to disable the PROST and COS systems.\nFixed trains getting stuck in the turnaround siding at Tretyakovskaya when starting a session heading toward the siding.\nFixed an issue that could eject players from the train when attempting to sit back down in the driver's seat.\n\n[b]Trains and Visual Fixes[\/b]\nFixed an issue with train selection on the map. Trains are now correctly distinguished from one another and have their own unique sounds again.\nAdded a selectable 81-760 variant featuring LED headlights.\nFixed several visual issues on the map, including incorrectly displayed lights and doors.\nFixed the flashlight being excessively bright.\n\n[b]Compatibility and Stability[\/b]\nA potential fix has been implemented for an issue preventing the game from launching on Windows 10 version 1809 and earlier. Further verification is ongoing.[\/p][\/quote][p]\n\nThank you for helping us make Subtransit Drive better! We're continuing to improve the demo and look forward to hearing your feedback.[\/p]","commentcount":10,"tags":["mod_reviewed","ModAct_1787316731_1792791165_0"],"language":0,"hidden":0,"forum_topic_id":"567049039351386447","event_gid":"674009530499077782","voteupcount":67,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049039351386447","rtime32_last_modified":1793256646,"news_post_gid":"0","rtime_mod_reviewed":1792791165,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792778000,"votes_up":67,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"571542424813338273","gidfeature2":"567049039351386447"},{"gid":"685267895163290337","clan_steamid":"103582791475699132","event_name":"Subtransit Drive comes to Steam Next Fest!","event_type":31,"appid":720830,"server_address":null,"server_password":null,"rtime32_start_time":1792418400,"rtime32_end_time":1793023200,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Starting October 19, you can try the Subtransit Drive Demo on Steam and take your first trip along a fully realized metro line.\",\"Ab dem 19. Oktober k\u00f6nnt ihr die Subtransit Drive-Demo auf Steam ausprobieren und eure erste Fahrt auf einer vollst\u00e4ndig nachgebildeten Metrolinie erleben.\",null,null,null,null,\"\u5404\u4f4d\u5217\u8f66\u957f\uff0c\u4f60\u4eec\u597d\uff01\u4ece 10 \u6708 19 \u65e5\u8d77\uff0c\u4f60\u53ef\u4ee5\u5728 Steam \u4e0a\u514d\u8d39\u8bd5\u73a9 \u300aSubtransit Drive\u300b\u7684 Demo \u6f14\u793a\u7248\uff0c\u5e76\u5728\u4e00\u6761\u5b8c\u5168\u771f\u5b9e\u8fd8\u539f\u7684\u5730\u94c1\u7ebf\u8def\u4e0a\u5f00\u542f\u4f60\u7684\u9996\u6b21\u9a7e\u9a76\u4e4b\u65c5\u3002\",null,\"\u0423\u0436\u0435 19 \u043e\u043a\u0442\u044f\u0431\u0440\u044f \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0434\u0435\u043c\u043e\u0432\u0435\u0440\u0441\u0438\u044e Subtransit Drive \u0432 Steam \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0432 \u043f\u043e\u0435\u0437\u0434\u043a\u0443 \u043f\u043e \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u043c\u0435\u0442\u0440\u043e.\",null,\"\u904b\u8ee2\u58eb\u306e\u7686\u3055\u3093\u3001\u3053\u3093\u306b\u3061\u306f\uff0110\u670819\u65e5\u3088\u308a\u3001Steam\u306b\u3066**\u300eSubtransit Drive\u300f\u306e\u4f53\u9a13\u7248\uff08\u30c7\u30e2\uff09**\u304c\u30d7\u30ec\u30a4\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u30ea\u30a2\u30eb\u306b\u518d\u73fe\u3055\u308c\u305f\u5730\u4e0b\u9244\u306e\u8def\u7dda\u3067\u3001\u8a18\u5ff5\u3059\u3079\u304d\u521d\u904b\u884c\u3078\u3068\u51fa\u767a\u3057\u307e\u3057\u3087\u3046\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"46331724abf26c7de9b9a768455e010ddefca28f.png\",\"46331724abf26c7de9b9a768455e010ddefca28f.png\",null,null,null,null,\"46331724abf26c7de9b9a768455e010ddefca28f.png\",null,\"46331724abf26c7de9b9a768455e010ddefca28f.png\",null,\"46331724abf26c7de9b9a768455e010ddefca28f.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,null,null,null,\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,\"e4588c80c4a00027f06ede823a5bd4e896f4d03a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"685267895163290338","clanid":"46177724","posterid":"0","headline":"Subtransit Drive comes to Steam Next Fest!","posttime":1792159268,"updatetime":1792159268,"body":"[p]Greetings, Drivers! Starting October 19, you can try the Subtransit Drive Demo on Steam and take your first trip along a fully realized metro line.[\/p][p][\/p][p]In this demo, you will get access to one train, the updated rank system, and a chance to experience our game on PC.[\/p][p][\/p][p]We would love to hear your feedback! It will help us make the necessary adjustments and improve the gaming experience before the full release of version 1.6 on iOS, Android, and PC.[\/p][p][\/p][p]See you on the tracks! [\/p]","commentcount":53,"tags":["mod_reviewed","ModAct_1607812438_1792159533_0"],"language":0,"hidden":0,"forum_topic_id":"569300439979268980","event_gid":"685267895163290337","voteupcount":177,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792159200,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569300439979268980","rtime32_last_modified":1793285694,"news_post_gid":"0","rtime_mod_reviewed":1792159533,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792133959,"votes_up":177,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"571542424813338273","gidfeature2":"569300439979268980"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["674009530499077783","685267895163290338"],"last_update_event":[]}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/6967fc9107b81d51b032196e37f72904.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/6967fc9107b81d51b032196e37f72904.webp?t=1792608240 width=1560 height=93 /></span></p><p class="bb_paragraph" >Subtransit Drive is a realistic subway simulator lovingly crafted by railway enthusiasts and simulation developers. Follow the timetable, obey signals, manage train systems, and keep the line running smoothly during rush hour. Every trip demands attention, precision, and knowledge of the railway infrastructure.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/f8bec9ffbe85153d19f9f1b98eacce0e.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/f8bec9ffbe85153d19f9f1b98eacce0e.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >Start a route on your own or with friends. An exact copy of a real metro line with detailed tunnel geometry, track profile, and infrastructure layout is already waiting for you in the game, and several more are currently in development. </p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/45595e34916c81041d39b64791eff04b.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/45595e34916c81041d39b64791eff04b.webp?t=1792608240 width=1560 height=93 /></span></p><p class="bb_paragraph" >Every lever, button, and switch in the cab is fully functional. Every action has an effect on the interconnected systems throughout the train just as it would in real-world operation. Electrical and pneumatic schematics were fully recreated for every car: each circuit and valve behaves exactly as it does in an authentic train.</p><p class="bb_paragraph" >Each wheelset is simulated independently on both rails rather than along a simplified centerline. Weight affects inertia, and every coupler is subject to realistic load limits.</p><p class="bb_paragraph" >The track is recreated to centimeter accuracy, including the placement of rail joints. Real-time suspension simulation reproduces body roll, pitch, vibration, and weight transfer as the train moved along the track. </p><p class="bb_paragraph" >Bring a train online from a cold-and-dark state, manage electrical and braking systems, and respond to abnormal operating conditions. </p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/a30a2fb22c09e4260200976bd473ad7c.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/a30a2fb22c09e4260200976bd473ad7c.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >Every acceleration and braking maneuvers are calculated using a detailed model of interactions between all vehicle systems. The suspension adapts in real time to train mass and passenger distribution, creating a convincing sense of driving a living, dynamic piece of rolling stock.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/5afdfc32a7b35d364cf76576d7ae047c.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/5afdfc32a7b35d364cf76576d7ae047c.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >A dynamic passenger flow system recreates the daily rhythm of a major city: morning rush hours in residential districts, evening congestion in the city center, and constantly shifting passenger demand throughout the network.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/ea2b35888141f14ddab92b5ac73a261b.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/ea2b35888141f14ddab92b5ac73a261b.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >Every sound originates from the object that produces it and features realistic Doppler effects. Engine sounds and individual relay recordings were captured from real subway trains, while the smooth traction motor audio recreates the atmosphere familiar to millions of passengers across former Soviet metro systems.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/8c1cf7489615c3f45f5583a49c9d3967.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/8c1cf7489615c3f45f5583a49c9d3967.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >Cross-platform multiplayer allows players to collectively recreate the operation of a real underground network, where every participant becomes part of a single transportation system.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/e57d8beb5ef2719a05310d1238a437b8.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/e57d8beb5ef2719a05310d1238a437b8.webp?t=1792608240 width=1560 height=93 /></span></h2><p class="bb_paragraph" >You decide the scenario. Drive as long as you want, start and end your journey anywhere on the network. The route system continues to expand with future updates.</p><h2 class="bb_tag" ></h2><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras/bb3095ab3e0adc7520f6a4a27ee79891.avif?t=1792608240" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/720830/extras_big/bb3095ab3e0adc7520f6a4a27ee79891.webp?t=1792608240 width=1560 height=93 /></span></p><p class="bb_paragraph" >Build your career as a train operator by steadily advancing through the ranks. Earn promotions through flawless train handling, disciplined operation, and mastery of every system aboard your train.</p><p class="bb_paragraph" ></p>						</div>
					</div>
				
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
					<div class="sysreq_tabs">
									<div class="sysreq_tab active" data-os="win">
						Windows					</div>
									<div class="sysreq_tab " data-os="linux">
						SteamOS + Linux					</div>
								<div style="clear: left;"></div>
			</div>
				<div class="sysreq_contents">
							<div class="game_area_sys_req sysreq_content active" data-os="win">
											<div class="game_area_sys_req_leftCol">
							<ul>
								<strong>Minimum:</strong><br><ul class="bb_ul"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10/11 64-bit <br></li><li><strong>Processor:</strong> Intel® Core™ i5 (6th gen) or AMD equivalent<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia GeForce GTX 1050 | AMD RX 570<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 12 GB available space<br></li><li><strong>Additional Notes:</strong> HDD Supported, SSD Recommended</li></ul>							</ul>
						</div>
																<div class="game_area_sys_req_rightCol">
							<ul>

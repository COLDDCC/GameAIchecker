l,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"719044892364376142","clanid":"46181472","posterid":"0","headline":"Oar'some Adventures @ NextFest","posttime":1792470344,"updatetime":1792470344,"body":"[h1]Hi Everyone![\/h1][p][\/p][h3][b]Nextfest[\/b] is now [b]live[\/b]! We look forward to seeing all the new players jump in and give the demo a go! [\/h3][h3]A new Demo Update just went live, giving you a little teaser of the full map coming with our release later this year! We've also included a number of bug fixes and performance improvements to make the experience better for everyone.[\/h3][p][\/p][h3]We've been hard at work getting the game ready for release. As always,  please let us know if you run into any bugs or issues! [\/h3][p][\/p][h1]What's Next?[\/h1][h3]We'd also like to share our plans for the upcoming release! Here's a look at our current roadmap.[\/h3][h3][img src=\"{STEAM_CLAN_IMAGE}\/46181472\/d1b143caa7b045ae6470f13d79fada13e9c8177e.png\"][\/img][\/h3][h3]Finally, we just wanted to extend a massive thank you to everyone who has played, shared feedback and wishlisted Oar'Some Adventures. Your support has helped us in so many ways.[\/h3][p][\/p][h3]We hope you enjoy the updated demo and are hyped for the release later this year![\/h3]","commentcount":2,"tags":["mod_reviewed","ModAct_1426387032_1792471155_0"],"language":0,"hidden":0,"forum_topic_id":"568174730608265456","event_gid":"719044892364376141","voteupcount":11,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568174730608265456","rtime32_last_modified":1793070764,"news_post_gid":"0","rtime_mod_reviewed":1792471156,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792455202,"votes_up":11,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"589561964325252644","gidfeature2":"568174730608265456"},{"gid":"710033254358450185","clan_steamid":"103582791475702880","event_name":"Oar'some Adventurers Demo Now Live!","event_type":28,"appid":4555210,"server_address":null,"server_password":null,"rtime32_start_time":1787708280,"rtime32_end_time":1787711820,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Play the demo now!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Oar'some Adventures Demo is now live! Gather your friends and jump in!\",
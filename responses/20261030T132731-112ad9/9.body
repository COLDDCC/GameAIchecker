v\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"710033254358450186","clanid":"46181472","posterid":"0","headline":"Oar'some Adventurers Demo Now Live!","posttime":1787708318,"updatetime":1787708318,"body":"[h1]Hey Everyone! [\/h1][h3][\/h3][h3]Our Demo has just gone live! Grab some friends and jump in! We look forward to seeing all the fun things you all get up to![\/h3][h3][url=\"{STEAM_CLAN_IMAGE}\/46181472\/2dbfa19bcb29115c34febb438e1633d7ffec7400.png\"][img src=\"{STEAM_CLAN_IMAGE}\/46181472\/62a4fa9a4c2136806c08c2cf68763e3b4ebc082a.png\"][\/img][\/url][\/h3][h3]We'd love to hear more about your experience! Feel free to jump in our [url=\"https:\/\/discord.gg\/RzAZaeZzXv\" buttoncolor=\"#2c9ce2\"]Discord[\/url] and have a chat with the devs! Or just leave us a comment here and we'll be sure to respond where we can! [\/h3][p][\/p][h3]If you enjoyed your experience please don't forget to add Oar'some Adventures to your wishlist, it helps Indie devs like us get our game out to awesome people like you![\/h3][p][url=\"{STEAM_CLAN_IMAGE}\/46181472\/0c54be04a900e60f9b817dc0e8712d1732a61438.png\"][img src=\"{STEAM_CLAN_IMAGE}\/46181472\/52ce6fab02fc3e9865c671d349d9a0febead7bf4.png\"][\/img][\/url][\/p][h3]Stay Tuned as we continue to work towards our full release![\/h3][h3]Thank you all for playing! [\/h3][p][\/p][h3][img src=\"{STEAM_CLAN_IMAGE}\/46181472\/0492ee2b7ea3a26125c1e02fd881210589b5b55f.gif\"][\/img][\/h3]","commentcount":11,"tags":["mod_reviewed","ModAct_1598046824_1787709647_0"],"language":0,"hidden":0,"forum_topic_id":"589561964325252645","event_gid":"710033254358450185","voteupcount":17,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"589561964325252645","rtime32_last_modified":1792648444,"news_post_gid":"0","rtime_mod_reviewed":1787709647,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1787702381,"votes_up":17,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"589561964325252644","gidfeature2":"589561964325252645"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["719044892364376142","710033254358450186"],"last_update_event":[]}};

s in.\n\n[h2]What's next[\/h2]\nWe're opening another playtest in about three weeks, in mid-November. Click [b]Request Access[\/b] on the store page to get in.\n\n[url=https:\/\/store.steampowered.com\/app\/4362490\/]Wishlist the game[\/url] to get a notification when it launches.\n\nSee you in the next playtest.","commentcount":0,"tags":["mod_reviewed","ModAct_1866137740_1793086930_0"],"language":0,"hidden":0,"forum_topic_id":"562545740486053775","event_gid":"704408827984878280","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562545740486053775","rtime32_last_modified":1793304645,"news_post_gid":"0","rtime_mod_reviewed":1793086930,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793086650,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"562542623246561083","gidfeature2":"562545740486053775"},{"gid":"760703279879423782","clan_steamid":"103582791475789193","event_name":"Steam Next Fest Dev Stream: Demo Gameplay","event_type":11,"appid":4362490,"server_address":null,"server_password":null,"rtime32_start_time":1792490460,"rtime32_end_time":1793034000,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Devs play free demo during Steam Next Fest\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"streaming the demo on our store page for Steam Next Fest. Survive the nights with us, ask questions in chat, then grab the free demo and wishlist.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"l
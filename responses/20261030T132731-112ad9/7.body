uct_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"716793092553836108","clanid":"46093477","posterid":"0","headline":"\u2728 The Reshine Demo Is Out Now!","posttime":1792422242,"updatetime":1792422242,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46093477\/6d2265b4f30ff4cb8d2c0c27683d39ca8d608bae.png\"][\/img][\/p][p]The wait is over! The Reshine demo is now available on Steam, and we can't wait for you to try it![\/p][p]Take forgotten antiques apart, clean away years of dirt and rust, restore every little detail, and carefully put everything back together.\n[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4668060\/Reshine_Demo\/\"][\/dynamiclink][\/p][p]No deadlines. No shop management. No pressure. Just cozy, satisfying restoration at your own pace.[\/p][p]\ud83c\udfae [b]Give the demo a try and let us know what you think![\/b][\/p][p]Thank you for being part of this journey. \u2764\ufe0f[\/p]","commentcount":14,"tags":["mod_reviewed","ModAct_1889321037_1792429715_0"],"language":0,"hidden":0,"forum_topic_id":"573804280379657251","event_gid":"716793092553836107","voteupcount":51,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804280379657251","rtime32_last_modified":1793260660,"news_post_gid":"0","rtime_mod_reviewed":1792429716,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792422194,"votes_up":51,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"803471531442215451","gidfeature2":"573804280379657251"},{"gid":"716793092553835592","clan_steamid":"103582791475614885","event_name":"\u2728 Reshine Demo Launches in Less Than 24 Hours!","event_type":28,"appid":4253570,"server_address":null,"server_password":null,"rtime32_start_time":1792346160,"rtime32_end_time":1792349760,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6b7ee7e0718565e200df41240160231ed96e9b10.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"716793092553835593","clanid":"46093477","posterid":"0","headline":"\u2728 Reshine Demo Launches in Less Than 24 Hours!","posttime":1792346192,"updatetime":1792346192,"body":"[p]We're so excited. Seriously, [b]the Reshine demo launches tomorrow, October 19th[\/b], and we can hardly wait for you to play it.[\/p][p]After a long journey of making, testing, listening, and polishing, we're finally getting ready to open the doors to everyone. But before we turn the page, we want to take a moment to say something important.[\/p][p][b]Thank you. From the bottom of our hearts. \u2764\ufe0f[\/b][\/p][p]We're closing the public playtest build, and looking back at nearly [b]100,000 players[\/b] who signed up and gave Reshine a try is honestly hard to put into words.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46093477\/074b643a7994eb0e7e10952b6a2fd3f6ac0a3bb7.gif\"][\/img][\/p][p]Thank you to everyone who played, shared their thoughts, reported issues, and helped us figure out what Reshine should become. Your feedback has had an enormous impact on the game's direction, and your suggestions helped shape the experience we're preparing to share with you tomorrow.[\/p][p]We're a small team, and having so many people take an interest in what we're making means the world to us. Reshine wouldn't be where it is today without you.[\/p][hr][\/hr][h2]\ud83c\udfb5 A little something special before launch[\/h2][p]To celebrate this journey, we'd also like to share something we've been looking forward to showing you: [b]a behind-the-scenes look at the music of Reshine[\/b], created by our composer, Kounine.[\/p][p]The music is such an important part of the atmosphere we're building, and we thought you'd enjoy seeing some of the ideas and creative work that went into it.[\/p][p]\ud83c\udfa7 [b]Watch the music design video here:[\/b][\/p][p][\/p][p][dynamiclink href=\"https:\/\/www.youtube.com\/watch?v=6SRNavfYRg8\"][\/dynamiclink][\/p][hr][\/hr][h2]Tomorrow, a new chapter begins.[\/h2][p]The public playtest is coming to a close, but the demo is almost here. We can't wait for you to explore the forgotten objects waiting to be restored, discover the little details we've been working on, and experience Reshine for yourselves.[\/p][p]And, of course, we'd love to hear what you think![\/p][p][b]Thank you for being part of this journey.[\/b] Whether you've been with us since the first playtest or are just discovering Reshine now, we're happy to have you here.[\/p][p]See you tomorrow! \u2728[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1894963720_1792346906_0"],"language":0,"hidden":0,"forum_topic_id":"573804084819321109","event_gid":"716793092553835592","voteupcount":35,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804084819321109","rtime32_last_modified":1793260663,"news_post_gid":"0","rtime_mod_reviewed":1792346907,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792337389,"votes_up":35,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"803471531442215451","gidfeature2":"573804084819321109"},{"gid":"711164227423834696","clan_steamid":"103582791475614885","event_name":"A patch (ID 4718) for demo has just arrived","event_type":12,"appid":4253570,"server_address":null,"server_password":null,"rtime32_start_time":1792683180,"rtime32_end_time":1792688401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6b7ee7e0718565e200df41240160231ed96e9b10.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"716793092553837147\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"711164227423834697","clanid":"46093477","posterid":"0","headline":"A patch (ID 4718) for demo has just arrived","posttime":1792683208,"updatetime":1792683208,"body":"[p]Hello,[\/p][p][\/p][p]This is a small patch with one important change that we heard you asking for: it was way too easy to accidentally click on an already fully painted part and reset its color. To prevent that from happening again, the color won't reset when clicking on such a part anymore; you can just go back and continue working on the remaining parts :)[\/p][p][\/p][p][\/p][p]Patch notes:[\/p][list][*][p]Paint color resets only when a new color is chosen, not when color selection panel appears[\/p][\/*][*][p]Fixed broken tool hiding animation when pressing Back during color choosing[\/p][\/*][*][p]Fixed saving customization options when making them before starting the restoration of any object[\/p][\/*][*][p]No longer showing parts' 3D widgets when they're fully restored[\/p][\/*][*][p]Implemented new accessibility setting: Reduced laser flickering[\/p][\/*][*][p]Fixed a weird yellow blink on one edge of the vinyl record [\/p][\/*][*][p]Fixed a typo in the Polish entry message[\/p][\/*][\/list]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1827889981_1792686354_0"],"language":0,"hidden":0,"forum_topic_id":"569300839163961349","event_gid":"711164227423834696","voteupcount":13,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569300839163961349","rtime32_last_modified":1793159827,"news_post_gid":"0","rtime_mod_reviewed":1792686355,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792683176,"votes_up":13,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"803471531442215451","gidfeature2":"569300839163961349"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["716793092553836108","716793092553835593"],"last_update_event":{"rtime":1792683180,"event_gid":"711164227423834696","announcement_gid":"711164227423834697","clan_account_id":46093477}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >Take apart, clean and bring new life to long forgotten objects in Reshine - a cozy restoration game that will take you on a journey through history, all within the safe space of your own attic.</p><p class="bb_paragraph" >Reshine is a chill, relaxing experience. Simple and intuitive controls, minimalistic UI, straightforward gameplay. There are no complicated systems, no management, no stress.</p><p class="bb_paragraph" >  <br><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/bfb54212056424529a190079af1f23ef.poster.avif?t=1793286743" width=1170 height=584 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/bfb54212056424529a190079af1f23ef.webm?t=1793286743" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/bfb54212056424529a190079af1f23ef.mp4?t=1793286743" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/915732bb4ea7773b765263707b850054.avif?t=1793286743" width=392 height=66 /></span> </p><p class="bb_paragraph" >  Listen to the rainfall, as you slowly work in a quiet attic, where the time seems to have stopped. Surrounded by relics of the past, take apart each object piece by piece. There’s no rush, you can follow your own rhythm, discovering how everything fits together as you go. With nothing to get wrong, you’re free to simply unwind and enjoy the process.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/5ebd8e616dcb39453f636c20f6510796.poster.avif?t=1793286743" width=1170 height=584 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/5ebd8e616dcb39453f636c20f6510796.webm?t=1793286743" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/5ebd8e616dcb39453f636c20f6510796.mp4?t=1793286743" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/331a679d14ad80b015be24e5e8301503.avif?t=1793286743" width=392 height=66 /></span> </p><p class="bb_paragraph" >The parts need to be restored to their former glory. Clean away the dust, sand down rough edges, and gently remove the rust using a variety of tools. Pick colors that feel right for you and repaint the surface until it looks good as new. Go in any order you want and just sit back, relax and watch the object come back to life.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9e2b96b984656b51e17422c5ae779dbc.poster.avif?t=1793286743" width=1170 height=584 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9e2b96b984656b51e17422c5ae779dbc.webm?t=1793286743" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9e2b96b984656b51e17422c5ae779dbc.mp4?t=1793286743" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/3fa4ed330714c2076958a8a1eec6e955.avif?t=1793286743" width=430 height=66 /></span></p><p class="bb_paragraph" >When every part looks like new, you can slowly bring everything back together. Piece by piece, watch the object take shape again. Before you know it, it’s looking like its old self again, or maybe even better.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9fcaf50e890cdc1200a31026e7d248a6.poster.avif?t=1793286743" width=1170 height=584 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9fcaf50e890cdc1200a31026e7d248a6.webm?t=1793286743" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/9fcaf50e890cdc1200a31026e7d248a6.mp4?t=1793286743" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/61629407a09c94defd83b40217f24f9b.avif?t=1793286743" width=430 height=66 /></span></p><p class="bb_paragraph" >And that's it! Compare your final result with the object before restoration to see how much it has changed. You can repeat the restoration as many times as you want, to try different colors or just relive the experience. But, most importantly, more old treasures await you!</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/60cc65e77e1845262bb182e5809c2909.poster.avif?t=1793286743" width=1170 height=584 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/60cc65e77e1845262bb182e5809c2909.webm?t=1793286743" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4253570/extras/60cc65e77e1845262bb182e5809c2909.mp4?t=1793286743" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" ></p>						</div>
					</div>
				
				
				

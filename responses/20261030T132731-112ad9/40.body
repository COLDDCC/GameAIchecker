um_topic_id":"572677904481300824","event_gid":"675134795999609576","voteupcount":23,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572677904481300824","rtime32_last_modified":1793331537,"news_post_gid":"0","rtime_mod_reviewed":1792128287,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792096612,"votes_up":23,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"589561710754621732","gidfeature2":"572677904481300824"},{"gid":"676260062267703501","clan_steamid":"103582791475798399","event_name":"The Gravhounds Demo is Coming!\ud83c\udfae","event_type":28,"appid":2440760,"server_address":null,"server_password":null,"rtime32_start_time":1791405000,"rtime32_end_time":1791407880,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"db7115a00a7a3491d79ea3167319c333214679a7.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"47f732eba48769e1b45e0335213f540fb8591d08.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"684139458559214563\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"676260062267703502","clanid":"46276991","posterid":"0","headline":"The Gravhounds Demo is Coming!\ud83c\udfae","posttime":1791404385,"updatetime":1791405283,"body":"[h2][b]Hey Gravhounds![\/b][\/h2][p]After a successful Open Playtest where [b]20k+[\/b] testers deployed to alien planets (and survived the hordes), we\u2019re thrilled to announce that the [b]Gravhounds Demo is coming October 12th, 2026[\/b]!\n[\/p][p]The demo will allow you to visit [b]2 Solar Systems[\/b] with [b]7 planets[\/b], and you\u2019ll be able to choose between four different Gravhounds, Selene, Zane, Dozer and Finn![\/p][p]\n[img src=\"{STEAM_CLAN_IMAGE}\/46276991\/0e8c4c5ecadc4bab5a11cee75b0a7ef37a8451c4.png\"][\/img][\/p][p][\/p][p]Also note that Demo progress does[b] not carry on into[\/b] our Early Access Release planned for November, 2026 but that the feedback that you share from your sessions most certainly will.\u00a0\n[\/p][p]If you have thoughts after playing the demo come share them with us in [u][url=\"https:\/\/discord.com\/invite\/gravhounds\"]Discord[\/url][\/u]![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276991\/0e8721403709838ab7c9ea1e31f2253b7bf6913c.png\"][\/img][\/p][p][\/p][h2][b]\ud83d\udce2What\u2019s New Since the Playtests[\/b][\/h2][p][\/p][p]Thanks to all of you who joined our Playtests and provided feedback bug reports and shared your thoughts. Your input has helped us implement a few changes for the demo:\n[\/p][p][b]Highlights[\/b]:[\/p][list][*][p][b]Jump into Multiplayer right away: [\/b]we\u2019ve added the option to skip tutorials and jump in from the main menu. (You still need to complete a tutorial for solo play).[\/p][\/*][*][p][b]Smoother movement and combat.[\/b] Free ground dash, better pipeline grinding, stronger grenades, and weapon and enemy rebalancing.[\/p][\/*][*][p][b]Faster Progression[\/b]. Reworked Research Point rewards.[\/p][\/*][*][p][b]Lots of fixes. [\/b]Steadier multiplayer, better performance, a tougher (and healable) Coffee Cat and less COSMO chatter.\n[\/p][\/*][\/list][h3][b]\ud83c\udf9a\ufe0fNew Mod Deck Builder[\/b][\/h3][p][\/p][p]One of the biggest points of feedback we saw from the Playtest has been a desire for more autonomy to balance out RNG, so we\u2019ve worked hard to implement a new Mod Deck Builder:[\/p][p]Unlocking more Mods used to make it harder to get the ones you wanted. Now you can choose. Build a deck of 10 common Mods and up to 2 Showstoppers, and reward pods will only draw from that deck. Swap it between expeditions to try new builds.[\/p][p]This is our first version based on your feedback so if you were in the Playtest, let us know what you think? And if you\u2019re new to the game drop us your thoughts as well on how you think this feels from your perspective.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276991\/d4c0a5757d724ff550f8b7526139beea9d1c3a6d.png\"][\/img][\/p][p]We\u2019ve [b]changed a lo[\/b]t and if you want the [b]full detailed breakdown of what we\u2019ve done[\/b], including the changelog, we\u2019ve just launched our first of many Devlogs!\n[\/p][h3][b]\u22d8 [\/b][url=\"https:\/\/store.steampowered.com\/news\/app\/2440760\/view\/676260062267703968?l=english\"]GET THE FULL DEBRIEF FROM OUR FIRST DEVLOG HERE[\/url][b] \u22d9[\/b][\/h3][p][\/p][h3][b]\u2b50Playtest by the Numbers[\/b][\/h3][p]We\u2019ve got some interesting telemetry for those interested in the numbers:[\/p][p][\/p][p]\u23f0 [b]Total playtime[\/b] for this Playtest was just shy of 50,000 hours.[\/p][p]\ud83c\udfae [b]Average time pr. player[\/b] was around 2h 24m.[\/p][p]\ud83e\ude90 [b]Average success rate[\/b] was around 70%, with Purrmafrost coming in at just over 50%![\/p][p]\ud83d\udc36 [b]Zane was your most popular character[\/b] with approx. 30% of you choosing to play as him.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276991\/d17d05645a6df2cd5b006298fdb5755b9dc178c5.png\"][\/img][\/p][p]If you read this far, thanks for locking in and we look forward to you diving in the Demo on October 12th! [\/p][p][\/p][h3][b]\ud83d\udce1 [\/b]Stay in the loop with all things Gravhounds:[\/h3][list][*][p]Join the Pack on [url=\"https:\/\/discord.com\/invite\/gravhounds\"]Discord[\/url]![\/p][\/*][*][p]Follow us on [url=\"https:\/\/x.com\/Gravhounds\"]X[\/url], [url=\"https:\/\/www.instagram.com\/octopuspanicgames\/\"]Instagram [\/url]and [url=\"https:\/\/www.tiktok.com\/@gravhoundsgame\"]TikTok[\/url].[\/p][p][\/p][\/*][\/list][p]\ud83d\udc19[i] Team Octopus Panic [\/i][\/p][p][\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1447510170_1791404871_0"],"language":0,"hidden":0,"forum_topic_id":"594069369071417950","event_gid":"676260062267703501","voteupcount":39,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791405000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"594069369071417950","rtime32_last_modified":1793331577,"news_post_gid":"0","rtime_mod_reviewed":1791404871,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791378649,"votes_up":39,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"589561710754621732","gidfeature2":"594069369071417950"},{"gid":"675134795999609242","clan_steamid":"103582791475798399","event_name":"Gravhounds - Demo Patch 1","event_type":12,"appid":2440760,"server_address":null,"server_password":null,"rtime32_start_time":1792002600,"rtime32_end_time":1792008001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"675134795999609243","clanid":"46276991","posterid":"0","headline":"Gravhounds - Demo Patch 1","posttime":1792002649,"updatetime":1792002649,"body":"[p]We've released a small update focused on stability, with a handful of gameplay and UI fixes. [\/p][p]Thanks to everyone sharing feedback and bug reports, they\u2019ve been a huge help. [\/p][p][\/p][p][b]Crash Fixes[\/b][\/p][list][*][p]Addressed crashes involving turrets, the multitool, and the compass.[\/p][\/*][\/list][p][b]Build Kit information[\/b][\/p][list][*][p]Kit details now appear when you look at a Build Kit or hold one. Previously, you had to do both. We also fixed information and markers appearing from too far away.[\/p][\/*][\/list][p][b]Skitter Behavior[\/b][\/p][list][*][p]Fixed an issue that could leave Skitters jumping back and forth repeatedly. [\/p][\/*][\/list][p][b]Turret Fixes[\/b][\/p][list][*][p]Fixed turrets endlessly smoking when joining a session in progress, and prevented two turrets from being placed on the same pipeline node.[\/p][\/*][\/list][p][b]Payout Animation[\/b][\/p][list][*][p]Fixed issues with the payout animation and added a safeguard to prevent it from getting stuck.[\/p][\/*][\/list][p][b]Hive Bomb UI[\/b][\/p][list][*][p]Fixed an issue with the on-screen overlay while Hive Bomb is active.[\/p][\/*][\/list][p]Keep the feedback coming Gravhounds![\/p]","commentcount":3,"tags":["patchnotes","mod_reviewed","ModAct_1447510170_1792005179_0"],"language":0,"hidden":0,"forum_topic_id":"572677904481192856","event_gid":"675134795999609242","voteupcount":11,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572677904481192856","rtime32_last_modified":1793331535,"news_post_gid":"0","rtime_mod_reviewed":1792005179,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792002590,"votes_up":11,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"589561710754621732","gidfeature2":"572677904481192856"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["675134795999609577","676260062267703502"],"last_update_event":{"rtime":1792002600,"event_gid":"675134795999609242","announcement_gid":"675134795999609243","clan_account_id":46276991}}};
						</script>
					


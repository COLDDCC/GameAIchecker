calized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"687520329382235251","clanid":"45671454","posterid":"0","headline":"Utility Cart & Employees Overtime - Public Beta Test","posttime":1792880331,"updatetime":1792880331,"body":"[h2]Kitchen update for you all \ud83c\udf54[\/h2][p]\nWe\u2019re currently working on the next update for Burger Shift, and we wanted to share what\u2019s coming soon!\n\n\ud83d\uded2 [b]Utility Cart:[\/b] You\u2019ll soon be able to purchase a handy utility cart to help haul items around and keep your workstations nice and organized.\n\n\u23f0 [b]Overtime Upgrade:[\/b] A new perk in the upgrade shop. Keeps your hired employees working a bit longer after the shift ends to wrap things up!\n\n[b]Want to try it early?[\/b]\nWe\u2019ve just opened a new [b]Beta branch[\/b] on Steam so you can jump in and test out the new features before they officially drop.\n\nIf you give it a spin, be sure to share your thoughts and feedback on Discord or the Community Hub!\n\n[i](Note: A save modified on the public-beta branch may not work properly if you switch back to the live build. Consider backing up your save first!)[\/i]  Thanks as always for your support, and happy shifting! \ud83c\udf5f [\/p][p][\/p][h3]How to switch to the Beta branch if you want to play it in advance:[\/h3][list][*][p]Right-click Burger Shift in your Steam Library \u2794 Properties...[\/p][\/*][*][p]Click the Game Versions & Betas tab on the left.[\/p][\/*][*][p]Select the public-beta branch.[\/p][\/*][*][p]Steam will download a quick update, and you're good to clock in! [\/p][\/*][\/list]","commentcount":0,"tags":["mod_reviewed","ModAct_1890460210_1792882311_0"],"language":0,"hidden":0,"forum_topic_id":"574930637987847430","event_gid":"687520329382235250","voteupcount":6,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930637987847430","rtime32_last_modified":1793706277,"news_post_gid":"0","rtime_mod_reviewed":1792882312,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792601285,"votes_up":6,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568165608207736422","gidfeature2":"574930637987847430"},{"gid":"693146024068252208","clan_steamid":"103582791475192862","event_name":"\ud83c\udf54 Burger Shift: Team Rush is available right now on Steam! \ud83c\udf5f","event_type":10,"appid":3804930,"server_address":null,"server_password":null,"rtime32_start_time":1789140480,"rtime32_end_time":1789144201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"The grills are hot, the fryers are ready, and the kitchen is open for business.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"242298bb0c9f06097caebf3deee212d9aebb28ef.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"693146024068252209","clanid":"45671454","posterid":"0","headline":"\ud83c\udf54 Burger Shift: Team Rush is available right now on Steam! \ud83c\udf5f","posttime":1789140506,"updatetime":1789140619,"body":"[h1]\ud83c\udf54 Burger Shift: Team Rush is available right now on Steam! \ud83c\udf5f [\/h1][p] \nStep behind the counter and run your own fast-food restaurant with your friends! From cooking delicious combos to keeping the drive-thru moving, you get to manage every fun part of the kitchen together. \n[\/p][h3]\ud83d\udc68\u200d\ud83c\udf73 What Awaits in Your Restaurant:[\/h3][list][*][p] \ud83c\udf54 [b]Cook Delicious Menus:[\/b] Flip fresh burgers, fry up golden fries and chicken nuggets, and serve cool soft-serve ice cream to keep your customers happy. [\/p][\/*][*][p] \ud83d\ude97 [b]Drive-Thru & Takeaway Fun:[\/b] Hand out quick meals at the window and pack up to-go orders alongside dining room service. [\/p][\/*][*][p] \ud83d\udc65 [b]Play Together or Hire Help (1\u20138 Players):[\/b] Team up with friends to split up the kitchen stations, or hire friendly Employees to keep tables clean and ingredients stocked. [\/p][\/*][*][p] \ud83d\udcc8 [b]Upgrade & Expand:[\/b] Earn cash from every shift to buy upgrades for your kitchen, improve your staff, unlock new recipes, and collect fun trinkets for your restaurant. [\/p][\/*][\/list][p]\nA big thank you to everyone who tested the game and supported us throughout development. We hope you have a blast running your kitchen!\n\nLet us know what you think in a Steam review, and see you on the shift! \ud83d\udece\ufe0f\u2728\n\n\u2014 [b]Nova Telum Studio[\/b][\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_1847323374_1789142666_0"],"language":0,"hidden":0,"forum_topic_id":"500617242799631721","event_gid":"693146024068252208","voteupcount":44,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"500617242799631721","rtime32_last_modified":1792001267,"news_post_gid":"0","rtime_mod_reviewed":1789142666,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1789139864,"votes_up":44,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"568165608207736422","gidfeature2":"500617242799631721"},{"gid":"703279756977636076","clan_steamid":"103582791475192862","event_name":"Hotfix: Missing Waste Oil Jugs Are Back","event_type":12,"appid":3804930,"server_address":null,"server_password":null,"rtime32_start_time":1789769319,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"703279756977636077","clanid":"45671454","posterid":"0","headline":"Hotfix: Missing Waste Oil Jugs Are Back","posttime":1789769319,"updatetime":1789769319,"body":"Some players' waste oil jugs had run away from their kitchens! We\u2019ve tracked them down and put them back, so if you lost yours, it should now be right where it belongs.\nV.1.0.10","commentcount":1,"tags":["patchnotes","mod_reviewed","ModAct_1878895840_1789769454_0"],"language":0,"hidden":0,"forum_topic_id":"564794139169960846","event_gid":"703279756977636076","voteupcount":12,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564794139169960846","rtime32_last_modified":1792703599,"news_post_gid":"0","rtime_mod_reviewed":1789769455,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1789769319,"votes_up":12,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568165608207736422","gidfeature2":"564794139169960846"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["687520329382235251","693146024068252209"],"last_update_event":{"rtime":1789769319,"event_gid":"703279756977636076","announcement_gid":"703279756977636077","clan_account_id":45671454}}};

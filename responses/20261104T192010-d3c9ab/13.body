ull,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683004046342095911","clanid":"45566953","posterid":"0","headline":"Robot Hospice Streaming Guidelines and Proper Use of the Work","posttime":1780795374,"updatetime":1780801160,"body":"[h1][b]Robot Hospice Streaming Guidelines and Proper Use of the Work[\/b][\/h1][p][\/p][p]Dokogames permits streaming, content creation, and fan activities related to [i]Robot Hospice[\/i] (hereinafter referred to as \u201cthe Game\u201d), including reviews, impressions, discussions, and other fan-created content shared on social media, in accordance with the following guidelines.[\/p][p][\/p][h2][b]Permitted Uses[\/b][\/h2][list][*][p]For personal use, you may post gameplay videos, livestream the Game, and share screenshots or images on personal websites, blogs, video-sharing platforms, and social media.[\/p][\/*][*][p]You may post, stream, and share content from any part of the Game.[\/p][\/*][*][p][b]Please Note:[\/b]\nIf your content contains scenes that significantly reveal story elements, we kindly ask that you provide appropriate spoiler warnings (such as \u201cSpoilers\u201d) to avoid diminishing the experience of players who have not yet played the Game.[\/p][\/*][*][p]When sharing content related to the Game, please include the title of the Game and a link to the Steam Store page whenever possible.[\/p][p][\/p][p][b]Game Title:[\/b] Robot Hospice[\/p][p][b]Steam Store Page:[\/b][url=\"https:\/\/store.steampowered.com\/app\/3590010\/Robot_Hospice\/\"]https:\/\/store.steampowered.com\/app\/3590010\/Robot_Hospice\/[\/url][\/p][\/*][\/list][p][\/p][h2][b]Fan Works and Derivative Creations[\/b][\/h2][list][*][p]We warmly welcome fan art and other fan-created works inspired by [i]Robot Hospice[\/i]. If you share artwork, writing, videos, or other creative works based on the Game, we would appreciate it if you could use the hashtag [b]#RobotHospice[\/b].[\/p][\/*][*][p]If you plan to present or distribute fan works in places where they may be viewed by a broad audience (such as public online platforms or events), please carefully review Section 3, \u201cProper Use of the Work.\u201d[\/p][p][\/p][\/*][\/list][h2][b]Proper Use of the Work[\/b][\/h2][list][*][p]Please do not claim to be an official representative of the Game, and do not redistribute the Game itself or any of its internal assets or data.[\/p][\/*][*][p]Please refrain from activities that may constitute harassment, defamation, violations of public order and morals, or violations of applicable laws.[\/p][\/*][*][p]Please do not use the Game or its content in connection with religious activities, political activities, or antisocial activities.[\/p][\/*][*][p]If Dokogames determines that any activity violates these guidelines or otherwise presents a problem, we may request that you discontinue the use of the Game in connection with such activity. In such cases, please promptly comply with the request and cease the relevant activity.[\/p][p][\/p][\/*][\/list][h2][b]Disclaimer[\/b][\/h2][list][*][p]Dokogames shall not be liable for any damages or losses arising from the use of these guidelines.[\/p][\/*][*][p]Please note that these guidelines may be revised or updated without prior notice.[\/p][p][\/p][\/*][\/list][h2][b]Final Note[\/b][\/h2][p]We hope that the time you spend with [i]Robot Hospice[\/i] becomes a truly meaningful and unforgettable experience.[\/p][p]We would be grateful if you would cherish your choices throughout your journey and experience the story in your own way.[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1434411615_1780796021_0","ModAct_1415716708_1780800034_4","ModAct_1434411615_1780801349_4"],"language":0,"hidden":0,"forum_topic_id":"568162597763849731","event_gid":"683004046342095910","voteupcount":35,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1780795320,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568162597763849731","rtime32_last_modified":1793230426,"news_post_gid":"0","rtime_mod_reviewed":1780801350,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1780791994,"votes_up":35,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"568162597763849730","gidfeature2":"568162597763849731"},{"gid":"690896761055611685","clan_steamid":"103582791475088361","event_name":"Ver. 1.0.3 Update","event_type":12,"appid":3590010,"server_address":null,"server_password":null,"rtime32_start_time":1791619514,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"690896761055611686","clanid":"45566953","posterid":"0","headline":"Ver. 1.0.3 Update","posttime":1791619514,"updatetime":1791619514,"body":"Version 1.0.3 is now available!\n\nChanges\n\n* Improved the Simplified Chinese localization following a professional Localization QA (LQA) review.\n* Fixed inconsistencies in some text.\n* Improved the visibility of certain in-game events.","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1434278705_1791620525_0"],"language":0,"hidden":0,"forum_topic_id":"592943711836522717","event_gid":"690896761055611685","voteupcount":10,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"592943711836522717","rtime32_last_modified":1792536284,"news_post_gid":"0","rtime_mod_reviewed":1791620525,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791619514,"votes_up":10,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568162597763849730","gidfeature2":"592943711836522717"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["706648578449211486","683004046342095911"],"last_update_event":{"rtime":1791619514,"event_gid":"690896761055611685","announcement_gid":"690896761055611686","clan_account_id":45566953}}};

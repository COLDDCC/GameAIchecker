ll,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"706661899563958285","clanid":"45783955","posterid":"0","headline":"Maid Cafe Simulator Roadmap Is Here!","posttime":1793758142,"updatetime":1793758142,"body":"Hello, managers! This is Accelix.\n\nHere's our [b]roadmap[\/b] for the coming months!\nIn November, you'll be able to [b]take cheki photos with your maids[\/b], and we're adding [b]Thai, Portuguese (Brazil), Indonesian, and French[\/b].\n\n[img]{STEAM_CLAN_IMAGE}\/45783955\/5cb12ad1c413ead58f1d4df130015b3053b8e98d.png[\/img]\n\n[i]Dates and content may change as development continues. We'll share the details of each update when it releases.[\/i]\nYou can also find this roadmap on our [url=https:\/\/store.steampowered.com\/app\/3232690]store page[\/url] anytime.\n\nLet us know what you think on Discord or in the Steam discussions!\n\nThank you!","commentcount":3,"tags":["mod_reviewed","ModAct_1751692459_1793758848_0"],"language":0,"hidden":0,"forum_topic_id":"567050311117583416","event_gid":"706661899563958284","voteupcount":23,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567050311117583416","rtime32_last_modified":1793786582,"news_post_gid":"0","rtime_mod_reviewed":1793758848,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793758110,"votes_up":23,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"811335793676156707","gidfeature2":"567050311117583416"},{"gid":"706660627797512351","clan_steamid":"103582791475305363","event_name":"Our 19th Update - v1.21","event_type":13,"appid":3232690,"server_address":null,"server_password":null,"rtime32_start_time":1792735320,"rtime32_end_time":1792740601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Story Mode, new Maid School uniforms, Jennie and Momo joining even earlier, Bond changes and more in v1.21.\",null,null,null,\"\uc2a4\ud1a0\ub9ac \ubaa8\ub4dc\uc640 \uba54\uc774\ub4dc \uc2a4\ucfe8 \uad50\ubcf5 \ucd94\uac00, \uc81c\uac08\uae08\uc790\u00b7\ubaa8\uad6c\uad6c \ud569\ub958 \uc55e\ub2f9\uae40, \uc778\uc5f0\ub3c4 \uac1c\ud3b8 \ub4f1 v1.21 \uc5c5\ub370\uc774\ud2b8 \ub0b4\uc6a9\uc744 \uc548\ub0b4\ub4dc\ub9bd\ub2c8\ub2e4.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c4c27eb57bdc5a7ba54ceee63aec00dc0301a4dc.png\",null,null,null,\"c4c27eb57bdc5a7ba54ceee63aec00dc0301a4dc.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"706660627797512352","clanid":"45783955","posterid":"0","headline":"Our 19th Update - v1.21","posttime":1792735353,"updatetime":1792735353,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45783955\/32f68d9e6e8a111358c93bdc49fb1e0b90fe854c.png\"][\/img][\/p][p]Hello, managers! This is Accelix.  [\/p][p]Thank you for all the reviews and bug reports since the v1.20 update. This update adds a Story Mode for those who want to enjoy the story at a more relaxed pace, and shortens the road to meeting Jennie and Momo once again. The maids also have new school uniforms. We've also changed Bond so it grows through text messages and bond stories, without having to pet the maids every day.  [\/p][p]Here's everything that's changed since the v1.20 update.[\/p][p]\n\n[\/p][h2]\u2728 New Features[\/h2][p][b]Story Mode[\/b]\n[\/p][list][*][p]When starting a new game, you can now choose between Normal Mode and Story Mode\n[\/p][\/*][*][p]In Story Mode, cafe XP, Bond and income are doubled, and most of the challenge of running the cafe is removed\n[\/p][\/*][*][p]The mode is saved per save file, and you can check it on the load screen and in the pause menu\n[\/p][\/*][*][p]Once chosen, the mode can't be changed later\n[\/p][\/*][*][p]Existing saves continue in Normal Mode. To play Story Mode, please start a new game\n[\/p][\/*][\/list][p][b]New Outfits[\/b]\n[\/p][list][*][p]Maid School summer and winter uniforms added for all five maids. They're available from the start in the wardrobe and for filming night performances\n[\/p][\/*][\/list][p][b]Skip in Story Replay[\/b]\n[\/p][list][*][p]While replaying a story on the laptop, you can now leave right away with the Skip button in the pause menu\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83c\udf1f Progression & Balance[\/h2][p][b]Jennie and Momo join even earlier[\/b]\n[\/p][list][*][p]The 1-star Maidchelin stage now needs Cafe Lv7 (was Lv8), and the Latte recipe can be bought in the shop from Lv7\n[\/p][\/*][*][p]The 2-star Maidchelin inspection and Jennie and Momo's joining story now need Cafe Lv11 (was Lv12)\n[\/p][\/*][*][p]XP needed for Cafe Lv6-10 reduced by about 30%\n[\/p][\/*][*][p]Kitchen expansion removed from the requirements for Episodes 5 and 7. Expanding the hall is now enough\n[\/p][\/*][*][p]The Espresso recipe can now be bought in the shop from Cafe Lv6 ($6). It used to be available only through Mina's wish, which could block preparing the 1-star menu\n[\/p][\/*][*][p]The 1-star menu guide is now split into two steps: \"Reach Cafe Lv7\" and \"Buy the Espresso, Steamed Milk and Latte recipes\"\n[\/p][\/*][\/list][p][b]Story progression[\/b]\n[\/p][list][*][p]Yuki's joining story no longer plays automatically when you go to sleep. It now starts when you talk to Yuki in front of the shop the next morning\n[\/p][\/*][*][p]Episode 5 also starts in the morning, when you talk to Yuki before opening, instead of at night\n[\/p][\/*][*][p]\"Wait until evening\" has been changed to \"Close the cafe for today\"\n[\/p][\/*][*][p]The first hall expansion is now guided through Mina's wish instead of a main quest\n[\/p][\/*][*][p]Jennie's Bond Story 3 now unlocks at night after closing, instead of in the morning\n[\/p][\/*][*][p]Bond stories that only unlock at night (Momo's, Jennie's Story 3) now show the \"at night after closing\" condition in the replay lock hint\n[\/p][\/*][\/list][p][b]Bond[\/b]\n[\/p][list][*][p]Reading a maid's text message to the end now gives +10 Bond with that maid, with an on-screen notification. This applies to messages read after the update\n[\/p][\/*][*][p]Watching a bond story to the end gives +50 Bond with that maid\n[\/p][\/*][*][p]The daily Bond cap from petting has been lowered from 40 to 20 per maid, in exchange for the new text message and bond story rewards above\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83e\uddf9 Maids[\/h2][list][*][p]Maids can now gift cooking stations. As your bond deepens, they'll gift higher-tier Blenders, Brewers and Shakers. Existing food gifts can also be received at more bond levels\n[\/p][\/*][*][p]Furniture gifts are added to a maid's gift list once that furniture's shop level is reached\n[\/p][\/*][*][p]A \"Gift on its way!\" notification now appears when a maid sends a gift by delivery\n[\/p][\/*][*][p]Energy lost when failing Perform or Play tasks increased from 1 to 5, since failing barely cost any energy before\n[\/p][\/*][*][p]When tidying boxes on the floor, maids now fill box shelves first, and if there's no room, empty the ingredients onto the ingredient shelf\n[\/p][\/*][*][p]Feeding reactions now have motions and expressions that match each maid's personality\n[\/p][\/*][*][p]Jennie now likes cola too. Fixed her saying a goodnight line when fed in the morning\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udc95 Wishes & NPCs[\/h2][list][*][p]A Deliveroid now appears next to the vending machine in front of the shop during business hours, with tips about Maidroids\n[\/p][\/*][*][p]The puppy now notices and praises your cafe level, Maidchelin stars, number of recipes learned and special bonds with your maids\n[\/p][\/*][*][p]The regular otaku now tells you about \"Doki,\" the local currency\n[\/p][\/*][*][p]New wishes: Mina's game table wish and Jennie's \"check her traits\" wish\n[\/p][\/*][*][p]The dialogue options for asking a maid about her wish and for reporting a wish you've fulfilled are now more varied. When reporting a wish, you'll now say something specific to that wish (e.g. \"I put your name on the work schedule\") instead of \"I made your wish come true\"\n[\/p][\/*][*][p]Mina's box-throwing wish now happens during the day. If you get it at night, the boxes appear the next morning. You'll also be shown how to hold Q to throw when you get the wish\n[\/p][\/*][*][p]The chalkboard and 2-seat table wishes are now Mina-only. Fixed them skipping without dialogue or appearing for two maids at once when given to other maids\n[\/p][\/*][*][p]The Maidchelin Association's 2- and 3-star letters now show the main story star marker\n[\/p][\/*][*][p]Added a \"How to use shelves\" help tip. The \"Use two stations for higher-tier recipes\" tip now appears at Lv6-7, when you get your first higher-tier recipe\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udda5\ufe0f UI & Convenience[\/h2][list][*][p]The station recipe selection screen now shows sale prices. Festival menu items show their raised prices\n[\/p][\/*][*][p]While a maid is cooking, the recipe icon's border shows the progress\n[\/p][\/*][*][p]Stations without a registered recipe now show \"Register recipe\" instead of \"Cook\"\n[\/p][\/*][*][p]Adjusted text size so long menu names at stations aren't cut off\n[\/p][\/*][*][p]Turning off the indoor lights is now saved, even after expanding or loading\n[\/p][\/*][*][p]Turning off the lights now dims the room slightly instead of making it pitch dark\n[\/p][\/*][*][p]The filming night phone stand now appears every night after closing (was every 5 days)\n[\/p][\/*][*][p]During filming night performances, the number key for the camera you're currently using is highlighted\n[\/p][\/*][*][p]Hall expansion descriptions in the Expansion app now show how many maids can work at each stage (3, 4 or 5)\n[\/p][\/*][*][p]When your work schedule is full, you'll now see whether expanding the hall will add more slots\n[\/p][\/*][*][p]Fixed the wardrobe and filming night outfit lists not scrolling when the cursor is over an outfit, and made scrolling faster\n[\/p][\/*][*][p]The icon for a failed drink now matches the cup shape when you hold it\n[\/p][\/*][*][p]Play time is now recorded while in stories, the wardrobe and filming night\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udd0a Sound[\/h2][list][*][p]Maids now react with their voice when you open their stats or successfully upgrade their abilities\n[\/p][\/*][\/list][p]\n[\/p][h2]\u26a1 Performance[\/h2][list][*][p]Improved frame rate during busy business hours with many customers\n[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udc1b Bug Fixes[\/h2][list][*][p]Fixed the judge disappearing and being unable to sleep after reloading, if you quit without saving after the Maidchelin results conversation. Saves already in this state are corrected when loaded\n[\/p][\/*][*][p]Fixed the screen freezing when a story failed to load. It now returns to the game\n[\/p][\/*][*][p]Fixed saves failing to load or maid records disappearing after the maid or Maidroid lineup changed\n[\/p][\/*][*][p]Fixed values from a previous save mixing in when loading saves multiple times\n[\/p][\/*][*][p]Fixed money being deducted early during the screen transition when buying an expansion\n[\/p][\/*][*][p]Fixed leaving to the title screen during a filming night performance counting as a completed performance\n[\/p][\/*][*][p]Fixed some screen animations freezing when opening and closing menus quickly\n[\/p][\/*][*][p]Fixed clicks near the edge of a button being canceled because the button shrank when pressed (e.g. the shop + button)\n[\/p][\/*][*][p]Fixed chairs staying tilted after a customer sat in them\n[\/p][\/*][*][p]Polished how chairs and the vending machine shake. Hitting the vending machine no longer pushes it out of place\n[\/p][\/*][*][p]Fixed customers who had sat down standing stiffly while paying or waiting in line\n[\/p][\/*][*][p]Fixed Maidroid skirts flipping over or clipping through their bodies\n[\/p][\/*][*][p]Fixed held items showing through walls\n[\/p][\/*][*][p]Fixed customers who played at the game table not leaving social media reviews, and \"all the seats were taken\" reviews appearing in cafes without a game table or Dance Stage\n[\/p][\/*][*][p]Fixed the \"changed the sign\" social media post appearing before the sign was actually changed\n[\/p][\/*][*][p]Fixed dialogue previews in the story replay list showing as @name@\n[\/p][\/*][*][p]Fixed Yuki's side hair looking bent on the main menu, and Omu's 3-star outfit making her mouth look white\n[\/p][\/*][*][p]Reduced customers opening their mouths too wide when speaking in stories\n[\/p][\/*][*][p]Fixed the Expansion app banner title overflowing to two lines and getting cut off in some languages\n[\/p][\/*][*][p]Fixed the \"PREMIUM ORANGE\" typo on the lemon packaging\n[\/p][\/*][*][p]Fixed the regular otaku's feet floating above the ground\n[\/p][\/*][*][p]And many more display and translation fixes\n[\/p][\/*][\/list][p]\nA lot of this update also started from your gameplay videos and bug reports.\nWe'll keep working to get your feedback in as quickly as we can.\nIf you run into a problem while playing, you can report it right from the game \u2014 just press F8, or open the ESC menu.\n\nThank you![\/p]","commentcount":6,"tags":["mod_reviewed","ModAct_1911576989_1792736195_0"],"language":0,"hidden":0,"forum_topic_id":"572678538884512585","event_gid":"706660627797512351","voteupcount":107,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884512585","rtime32_last_modified":1793690191,"news_post_gid":"0","rtime_mod_reviewed":1792736196,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792659968,"votes_up":107,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"811335793676156707","gidfeature2":"572678538884512585"},{"gid":"706660627797514916","clan_steamid":"103582791475305363","event_name":"Our 20th Update - v1.21.12 Hotfix","event_type":12,"appid":3232690,"server_address":null,"server_password":null,"rtime32_start_time":1793078940,"rtime32_end_time":1793082601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Fixed skirts clipping and shaking when maids sit down\",null,null,null,\"\uba54\uc774\ub4dc\uac00 \uc549\uc744 \ub54c \uce58\ub9c8\uac00 \uad00\ud1b5\ud558\uac70\ub098 \ub5a8\ub9ac\ub358 \ubb38\uc81c\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e293d8b03b72f82dbe55f6c3acb657157f313583.png\",null,null,null,\"e293d8b03b72f82dbe55f6c3acb657157f313583.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"742688880388473791\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"706660627797514917","clanid":"45783955","posterid":"0","headline":"Our 20th Update - v1.21.12 Hotfix","posttime":1793078968,"updatetime":1793078968,"body":"Hello, managers! This is Accelix.\n\nBased on your feedback, we have released a hotfix addressing issues with the maids' costumes.\n\n[h2]\u2728 New Content[\/h2]\n[list]\n[*][b][Demo][\/b] You can now choose from [b]10 summer and winter uniforms[\/b] for all five maids in the demo version.\n[\/list]\n\n[h2]\ud83d\udc57 Costume Fixes[\/h2]\n[list]\n[*]Fixed an issue where [b]summer and winter uniform skirts[\/b] clipped through the legs or appeared unnaturally disconnected at the waist when sitting on a chair.\n[*]Fixed an issue where [b]skirts shook or clipped through the body[\/b] when sitting in certain costumes for Momo and Jennie.\n[*]Fixed an issue where the [b]aprons, neck ribbons, and halos[\/b] on certain costumes appeared unnatural.\n[*]Refined the skirts and the appearance of ears and tails on Momo's and Yuki's exclusive costumes.\n[\/list]\n\n[hr][\/hr]\n\nIf you encounter an issue while playing, please let us know by pressing [b]F8[\/b] or selecting [b][Report Bug][\/b] in the ESC menu. Every report helps us immensely, and we will review and address them as quickly as possible.\n\nThank you, as always. \ud83d\ude47","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1426387032_1793081346_0"],"language":0,"hidden":0,"forum_topic_id":"572678840008359484","event_gid":"706660627797514916","voteupcount":30,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678840008359484","rtime32_last_modified":1793686822,"news_post_gid":"0","rtime_mod_reviewed":1793081346,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793065359,"votes_up":30,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"811335793676156707","gidfeature2":"572678840008359484"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["706661899563958285","706660627797512352"],"last_update_event":{"rtime":1793078940,"event_gid":"706660627797514916","announcement_gid":"706660627797514917","clan_account_id":45783955}}};
						</script>
					


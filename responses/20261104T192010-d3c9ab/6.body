ng a [b]Steam review[\/b]. It really helps a small indie game like this![\/p][p][\/p][p]Thanks for playing, and welcome to Chomp Garden! \ud83c\udf31[\/p][p][\/p][p]-Chao[\/p]","commentcount":0,"tags":["ModAct_1434278705_1790168203_2_10","mod_reviewed","ModAct_1434278705_1790168204_0"],"language":0,"hidden":0,"forum_topic_id":"587312703064836875","event_gid":"704406293371159393","voteupcount":22,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"587312703064836875","rtime32_last_modified":1791891553,"news_post_gid":"0","rtime_mod_reviewed":1790168205,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790166457,"votes_up":22,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"659359514129235784","gidfeature2":"587312703064836875"},{"gid":"705530288588980911","clan_steamid":"103582791475559809","event_name":"Chomp Garden Launches September 23! \ud83c\udf31","event_type":28,"appid":4457150,"server_address":null,"server_password":null,"rtime32_start_time":1788446640,"rtime32_end_time":1788450060,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"321aeb459c3840a393aa2c51601056f09c21e3b6.png\",null,null,null,null
l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"703282293670674565","clanid":"45290653","posterid":"0","headline":"\ud83d\udee0\ufe0f Hotfix 1.1.1 is now live! \ud83d\udee0\ufe0f","posttime":1791977715,"updatetime":1791977715,"body":"[p]We've just released a new hotfix to address several recipe issues. Here's what's been fixed:[\/p][p][\/p][p][b]\ud83c\udf5d Recipes & Cooking[\/b][\/p][p]- Seafood Pasta: Fixed an issue where the can of tomato sauce was not consumed.[\/p][p]- Spaghetti alle Vongole: Fixed an issue where parsley was not consumed during assembly.[\/p][p]- Seafood Salad: Fixed an issue where lemon and oil were not consumed.[\/p][p]- Mussels in Tomato Sauce: Fixed an issue where oil was required for the recipe but never used.[\/p][p]- Tagliatelle al Rag\u00f9: Updated the recipe labels to match the new recipe layout.[\/p][p][\/p][p][b]\ud83d\udda5\ufe0f UI[\/b][\/p][p]- Fixed an issue where the recipe name in the pinned recipe was displayed in a handwritten font.[\/p][p][\/p][p]Thank you for staying in touch with us and sharing your reports \u2764\ufe0f Happy cooking! \ud83c\udf5d[\/p]","commentcount":8,"tags":["mod_reviewed","ModAct_1866137740_1791978607_0"],"language":0,"hidden":0,"forum_topic_id":"573803804384872651","event_gid":"703282293670674564","voteupcount":167,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573803804384872651","rtime32_last_modified":1793707982,"news_post_gid":"0","rtime_mod_reviewed":1791978607,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791977704,"votes_up":167,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"591769371817360109","gidfeature2":"573803804384872651"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["669506565056759833","703282293670674565"],"last_update_event":[]}};

nced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"669506565056759833","clanid":"45290653","posterid":"0","headline":"\ud83c\udf83 Happy Halloween! \ud83d\udc7b","posttime":1793431718,"updatetime":1793431718,"body":"[p]BOO! Did you hear that? \ud83d\udc40[\/p][p][\/p][p]Spooky noises are echoing through the streets, mysterious creatures are lurking around your caf\u00e9, and something wickedly delicious is cooking in the kitchen![\/p][p][\/p][p]It's time to carve some pumpkins, put up your spookiest decorations, and whip up a Halloween feast so tasty it'll wake the dead! \ud83d\udc80\ud83c\udf5d[\/p][p][\/p][p]We wish you a frightfully fun night full of treats, tricks, and unforgettable moments![\/p][p][\/p][p]And a HUGE thank you for all your love and support! \u2764\ufe0f You're the magic ingredient that keeps us going and inspires us to make the game even better![\/p][p][\/p][p]Stay spooky, keep cooking, and don't let the ghosts steal your dinner! \ud83d\udc7b\ud83c\udf83[\/p][p]\n[\/p]","commentcount":9,"tags":["mod_reviewed","ModAct_1809568072_1793432404_0"],"language":0,"hidden":0,"forum_topic_id":"570427373261255053","event_gid":"669506565056759832","voteupcount":136,"votedowncount":8,"ban_c
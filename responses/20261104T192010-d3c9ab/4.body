alized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715663387750565265","clanid":"45872404","posterid":"0","headline":"Thank You & Big Announcement!","posttime":1788718518,"updatetime":1788718518,"body":"[h1]Tales of Fear - Episode One is coming 2027![\/h1]\n\nWe\u2019d like to take this opportunity to say a huge thank you to everyone who played it, showed interest in it, and, above all, left an honest review on Steam. We are literally blown away by how well Episode Zero of Tales of Fear was received by you all. We read every one of your comments and take your feedback very seriously.\n\n[img]{STEAM_CLAN_IMAGE}\/45872404\/d3c983e8b269ade5cd68f58bbb8a543030942f3f.png[\/img]\n\n[h3]What will the next episode be like?[\/h3]\n[hr][\/hr]\nMany of you couldn't believe that Episode Zero is free. We wanted to gather as much feedback as possible to see if the concept would be well-received by you, and the response was overwhelming! We thought it was the perfect way to introduce the series, but in order for us to continue at all, the next episodes will have a small price tag. We're currently planning to charge around 5-8\u20ac for the next episode. There will be three stories, all of which tend to be a bit longer and have more content to explore.\n\n[h3]Whats next?[\/h3]\n[hr][\/hr]\nWe\u2019d love to start developing the next episode right away, but we still have two smaller projects lined up that we\u2019d like to finish first. They are both part of a local museum exhibition here in Austria.\n\n\nhttps:\/\/store.steampowered.com\/app\/4624140\/Murder_Castle\/?curator_clanid=39707175\nhttps:\/\/store.steampowered.com\/app\/1864570\/Sender_Unknown\/?curator_clanid=39707175\n\nWe'll definitely keep you up to date as soon as we have more news!","commentcount":18,"tags":["mod_reviewed","ModAct_871423085_1788719372_0"],"language":0,"hidden":0,"forum_topic_id":"587311122576723710","event_gid":"715663387750565264","voteupcount":162,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"587311122576723710","rtime32_last_modified":1793545822,"news_post_gid":"0","rtime_mod_reviewed":1788719372,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788717361,"votes_up":162,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"691999715068216317","gidfeature2":"587311122576723710"},{"gid":"715662753890567278","clan_steamid":"103582791475393812","event_name":"Tales of Fear - Episode Zero OUT NOW!","event_type":10,"appid":4191350,"server_address":null,"server_password":null,"rtime32_start_time":1788282240,"rtime32_
ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"715663387750563986\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"717920261052041305","clanid":"45872404","posterid":"0","headline":"Bug Fixes & Improvements - 31.10.26","posttime":1793403729,"updatetime":1793708037,"body":"[p][b]Bugs fixed:[\/b][\/p][list][*][p]Fixed an issue where door knocking audio wouldn't stop if the door was opened too early[\/p][\/*][*][p]Fixed some missing translations[\/p][\/*][\/list][p][\/p][p][b]Improvements:[\/b][\/p][list][*][p]Added a new voiceline when turning up the cooling system[\/p][\/*][*][p]Refined and polished some dialogue texts[\/p][\/*][*][p]Improved the Reveal Screen to make it clear you are viewing reveals rather than replaying story chapters[\/p][\/*][*][p]Added sensitive content warnings[\/p][\/*][*][p]Added credits for the radio song:[i] Peace like a River by Holzina[\/i][\/p][\/*][*][p]Made performance improvements[\/p][\/*][\/list]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_803139239_1793404648_0","ModAct_1889357040_1793710347_4"],"language":0,"hidden":0,"forum_topic_id":"565923773630724361","event_gid":"717920261052041304","voteupcount":23,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630724361","rtime32_last_modified":1793722731,"news_post_gid":"0","rtime_mod_reviewed":1793710348,"featured_app_tagid":0,"referenced_appids":[],"build_id":26336767,"build_branch":"","unlisted":0,"rtime_created":1793403710,"votes_up":23,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"691999715068216317","gidfeature2":"565923773630724361"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["715663387750565265","715662753890567279"],"last_update_event":{"rtime":1793403720,"event_gid":"717920261052041304","announcement_gid":"717920261052041305","clan_account_id":45872404}}};

ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715662753890567279","clanid":"45872404","posterid":"0","headline":"Tales of Fear - Episode Zero OUT NOW!","posttime":1788282281,"updatetime":1790087644,"body":"[h1]Hello everyone![\/h1][p] The time has finally come: after about 10 months of development, the first episode of Tales of Fear is finally available! As previously announced, the first episode (actually Episode Zero) is free for everyone. We\u2019d like to get as much feedback as possible with this new concept, so please feel free to let us know what you think here on Steam or on our Discord server as usual. We read every single opinion, and your feedback is essential for the future development of Tales of Fear.  [\/p][p][\/p][p]The first episode includes 3 different chapters with a total playtime of about one and a half hours. Each chapter differs significantly in atmosphere and gameplay. What makes this special is that at least one story is true, and it's up to you to figure out which one. After each episode, you can decide whether you think the story is true. Then you can see how people around the world voted on the story.  [\/p][h3]Whats next?[\/h3][hr][\/hr][p]Your feedback shapes the future of Tales of Fear. We\u2019ve learned a lot during development and aim to make the next episode, which will be a paid release, even bigger and better.\n\nWe thank you in advance for playing Tales of Fear and hope you have lots of fun playing the game!\n\nIf you enjoyed it and would like to support us, feel free to check out our other games: [url=\"https:\/\/store.steampowered.com\/developer\/mediatale\"]https:\/\/store.steampowered.com\/developer\/mediatale[\/url][\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1889321037_1788283314_0","ModAct_1889321037_1790088974_4"],"language":0,"hidden":0,"forum_topic_id":"587310751669063541","event_gid":"715662753890567278","voteupcount":66,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"587310751669063541","rtime32_last_modified":1793711198,"news_post_gid":"0","rtime_mod_reviewed":1790088974,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788279258,"votes_up":66,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"691999715068216317","gidfeature2":"587310751669063541"},{"gid":"717920261052041304","clan_steamid":"103582791475393812","event_name":"Bug Fixes & Improvements - 31.10.26","event_type":12,"appid":4191350,"server_address":null,"server_password":null,"rtime32_start_time":1793403720,"rtime32_end_time":1793408401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,nul
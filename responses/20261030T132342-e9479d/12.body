am\/apps\/5186030\/edd06ef86b4be90f692d45ee0d533b0608450239\/capsule_184x69.jpg?t=1793322765","website":"https:\/\/nextstage.co.kr\/","pc_requirements":{"minimum":"<strong>Minimum:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Windows 10 64-bit<br><\/li><li><strong>Processor:<\/strong> Intel Core i5-8400 or AMD Ryzen 5 2600<br><\/li><li><strong>Memory:<\/strong> 16 GB RAM<br><\/li><li><strong>Graphics:<\/strong> NVIDIA GeForce GTX 1660 6 GB or AMD Radeon RX 5600 XT<br><\/li><li><strong>DirectX:<\/strong> Version 12<br><\/li><li><strong>Storage:<\/strong> 10 GB available space<br><\/li><li><strong>Sound Card:<\/strong> DirectX-compatible sound card<br><\/li><li><strong>Additional Notes:<\/strong> Some visual effects are limited on GPUs without hardware ray tracing support.<\/li><\/ul>","recommended":"<strong>Recommended:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Windows 10\/11 64-bit<br><\/li><li><strong>Processor:<\/strong> Intel Core i7-9700 or AMD Ryzen 7 3700X<br><\/li><li><strong>Memory:<\/strong> 16 GB RAM<br><\/li><li><strong>Graphics:<\/strong> NVIDIA GeForce RTX 3060 12 GB or AMD Radeon RX 6700 XT 12 GB<br><\/li><li><strong>DirectX:<\/strong> Version 12<br><\/li><li><strong>Storage:<\/strong> 10 GB available space<br><\/li><li><strong>Sound Card:<\/strong> DirectX-compatible sound card<br><\/li><li><strong>Additional Notes:<\/strong> SSD recommended. To experience the full intended visual quality, please use a GPU that supports hardware ray tracing.<\/li><\/ul>"},"mac_requirements":[],"linux_requirements":[]}}}
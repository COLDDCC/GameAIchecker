cheme:"https",netloc:"indiegame.com",hostname:"indiegame.com",favicon:"https://imgs.search.brave.com/QGiOxM2f466A6NnfzYmxhjjZbBRnq5GYcx-mzVFADO4/rs:fit:32:32:1:0/g:ce/aHR0cDovL2Zhdmlj/b25zLnNlYXJjaC5i/cmF2ZS5jb20vaWNv/bnMvMjRlZDQ2ZDEy/OGI1MWM1YmI2Njkz/NjU1OWFlYTRmZmQ0/YzhjZjMwMDFmN2Ux/MDBhMGMzZTQ0ZDQy/MWIyMjgzMS9pbmRp/ZWdhbWUuY29tLw",path:"  › home  › banana airways lands in steam next fest’s top 25: buenos aires duo’s 6-player co-op flight attendant chaos sim targets q1 2027"},thumbnail:{src:"https://imgs.search.brave.com/BFjYOoLlxXaAykmo7nBVXcR70zgyZ13tDhSErdABxhc/rs:fit:200:200:1:0/g:ce/aHR0cHM6Ly9pbmRp/ZWdhbWUuY29tL3dw/LWNvbnRlbnQvdXBs/b2Fkcy8yMDI2LzEw/L0JhbmFuYS1BaXJ3/YXlzX01haW5DYXBz/dWxlLmpwZw",original:"https://indiegame.com/wp-content/uploads/2026/10/Banana-Airways_MainCapsule.jpg",logo:false,is_tripadvisor:false,bo_serp_visible:true},age:"3 days ago",locations:void 0,video:void 0,movie:void 0,faq:void 0,recipe:void 0,qa:void 0,book:void 0,rating:void 0,article:void 0,product:void 0,product_cluster:void 0,cluster_type:void 0,cluster:void 0,similar_pages:void 0,creative_work:void 0,music_recording:void 0,review:void 0,software:void 0,content_type:void 0,side:void 0,descriptionLength:153,organization:{type:"organization",name:"인디게임닷컴",url:void 0,thumbnail:void 0,contactPoints:[]}},{title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",full_title:void 0,description:"Banana Airways is a chaotic six-player airline co-op with a free Steam demo. Demo details, the 2027 release window, co-op roles and how it compares to Dear Passengers.",page_age:"2026-10-29T00:00:00",profile:{name:"RandoPlay",long_name:"randoplay.com"},language:"en",type:"search_result",subtype:"faq",is_live:false,deep_results:void 0,meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"},thumbnail:{src:"https://imgs.search.brave.com/x0uksbgTSco14-gyihjDNysmnviMAunoqYYBQb6H3d0/rs:fit:200:200:1:0/g:ce/aHR0cHM6Ly9yYW5k/b3BsYXkuY29tL2d1/aWRlLWFzc2V0cy9i/YW5hbmEtYWlyd2F5/cy1oZXJvLndlYnA",original:"https://randoplay.com/guide-assets/banana-airways-hero.webp",logo:false,is_tripadvisor:false,bo_serp_visible:true},age:"1 day ago",locations:void 0,video:void 0,movie:void 0,faq:{items:[{question:"Is the Banana Airways demo free?",answer:"Yes. The demo is free on Steam and does not require a purchase. It has been available since October 15, 2026, and it was one of the demos featured in Steam Next Fest.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}},{question:"When does Banana Airways release?",answer:"Steam currently lists a planned Q1 2027 release for the full game. No final date or price has been announced, so treat that window as a plan rather than a promise.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}},{question:"How many players does Banana Airways support?",answer:"Up to six players in online co-op, and the game can also be played solo. Steam lists Single-player, Multi-player, Co-op and Online Co-op, but no shared or split-screen mode.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}},{question:"Does Banana Airways run on Mac?",answer:"The demo ships a native Apple Silicon build and Steam lists macOS 12 or later with an M1 chip as the minimum. The full game listing currently shows Windows PC only, so Mac support for the release is not confirmed.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}},{question:"Is Banana Airways the same game as Dear Passengers?",answer:"No. They are separate games from different studios that happen to share an airline co-op premise. Banana Airways is developed by Eggscape Entertainment, while Dear Passengers is developed by FLEXUS.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}},{question:"Is there split-screen or local co-op?",answer:"Not according to the Steam listing, which lists online co-op only. Each player needs their own copy running on their own machine.",title:"Banana Airways: Demo, Release Date and Co-op | RandoPlay",url:"https://randoplay.com/guides/banana-airways",meta_url:{scheme:"https",netloc:"randoplay.com",hostname:"randoplay.com",favicon:b,path:"  › home  › banana airways guide"}}]},recipe:void 0,qa:void 0,book:void 0,rating:void 0,article:{author:[{type:"person",name:"RandoPlay"}],date:"Oct 29, 2026",publisher:{type:"organization",name:"RandoPlay",url:"https://randoplay.com/"}},product:void 0,product_cluster:void 0,cluster_type:void 0,cluster:void 0,similar_pages:void 0,creative_work:void 0,music_recording:void 0,review:void 0,software:void 0,content_type:void 0,side:void 0,descriptionLength:171},{title:"¡El Vuelo Más Desastroso de la Historia en Banana Airways! - YouTube",url:"https://www.youtube.com/watch?v=khbFlwENMe4",full_title:void 0,description:"Sobrevivir a los Vuelos Caoticos en Banana Airways requiere nervios de acero. Mira cómo gestionamos las emergencias a bordo.Probamos este nuevo juego que se ...",page_age:"2026-10-13T21:30:38",profile:{name:"YouTube",long_name:"youtube.com"},language:"en",
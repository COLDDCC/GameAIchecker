$J( function() { InitializeCommentThread( "ForumTopic", "ForumTopic_103582791475854357_594068393279130313_569300839163876152", {"feature":"594068393279130313","feature2":"569300839163876152","owner":"103582791475854357","commentthreadid":"660321377","total_count":10,"start":0,"pagesize":15,"has_upvoted":0,"upvotes":0,"votecountid":null,"voteupid":null,"commentcountid":null,"subscribed":false,"extended_data":"{\"topic_permissions\":{\"can_view\":1,\"can_post\":1,\"can_reply\":1,\"is_banned\":0,\"can_delete\":0,\"can_edit\":0},\"original_poster\":143131877,\"topic_gidanswer\":\"0\",\"forum_appid\":5138990,\"forum_public\":1,\"forum_type\":\"General\",\"forum_gidfeature\":\"0\"}","oldestfirst":true,"comments_raw":{"569300839163892083":{"text":"booo","author":"wbirch15"},"569300839163898213":{"text":"Obligatory AI expert accusing a game of having AI art.  Can mark that bingo cell.","author":"erandomone"},"569300839163911761":{"text":"[quote=erandomone;569300839163898213]Obligatory AI expert accusing a game of having AI art.  Can mark that bingo cell. [\/quote]\nNot trying to be malicious. Just had a suspicion and wanted to ask if it's true or not","author":"Owlie"},"569300839163912229":{"text":"For what it's worth, I don't think so.","author":"Shapechanger"},"569300839163913047":{"text":"its fucking stick figure art? If you use AI for stick figure art your either the dumbest human alive, or entirely unable to physically draw. A toddler can draw stick figures dude.","author":"Bob"},"569300839163969655":{"text":"Smoothest brain in the world","author":"BlueSun"},"569301136947857357":{"text":"The entire game was lol","author":"Waffle"},"569301136947972900":{"text":"[quote=Owlie;569300839163911761][quote=erandomone;569300839163898213]Obligatory AI expert accusing a game of having AI art.  Can mark that bingo cell. [\/quote]\nNot trying to be malicious. Just had a suspicion and wanted to ask if it's true or not [\/quote]\n\nyou are accusing stick figures of being AI. there is a point where suspicion crosses the line into ignorant accusations.","author":"Max58201"},"569301136948008052":{"text":"[quote=Owlie] No hate for generative AI usage [\/quote]\n\nyeah no shit, you would never try to draw something lol","author":"Frizzle"},"569301136948021649":{"text":"unkindly, go fuck yourself you AI Deranged Karen. Preferably with a plague coated rod.","author":"chazdragoon"}},"track_navigation":true}, 'https://steamcommunity.com/comment/ForumTopic/', 40 ); } );
</script>

h)/%5B...slug%5D/page-c6eb0f520e6c5bb0.js\"],\"BannerPlacement\"]\n58:I[3807,[\"875\",\"static/chunks/875-43e9430d612a8ec2.js\",\"630\",\"static/chunks/630-b8844248d5106ea1.js\",\"987\",\"static/chunks/987-fada7d646cc31ff0.js\",\"676\",\"static/chunks/676-17c6271481c36f22.js\",\"732\",\"static/chunks/app/(english)/%5B...slug%5D/page-c6eb0f520e6c5bb0.js\"],\"HorizontalBanner\"]\n32:[\"$\",\"$L3c\",null,{}]\n33:[\"$\",\"p\",null,{\"className\":\"mb-6 mt-5 border-b border-border pb-6 text-base leading-8 text-muted-foreground sm:text-lg\",\"children\":\"Unharvest review details how this reverse farming demo delivers rapid plague progression, somber atmospheric shifts, and 25 minutes of play.\"}]\n34:[\"$\",\"div\",null,{\"className\":\"mb-8\",\"children\":[\"$\",\"$L3d\",null,{\"videoId\":\"pLcfKKqf1dY\",\"title\":\"Unharvest review: Reverse Farming Incremental Demo Impressions\",\"image\":\"/images/covers/reviews/unharvest-review.webp\",\"label\":\"Play video\"}]}]\n"])</script><script>self.__next_f.push([1,"35:[\"$\",\"$L3e\",null,{\"headings\":[{\"id\":\"core-reverse-farming-loop-and-controls\",\"text\":\"Core Reverse-Farming Loop and Controls\",\"level\":2},{\"id\":\"skill-tree-upgrades-and-progression-mechanics\",\"text\":\"Skill Tree Upgrades and Progression Mechanics\",\"level\":2},{\"id\":\"environmental-storytelling-and-field-lore\",\"text\":\"Environmental Storytelling and Field Lore\",\"level\":2},{\"id\":\"teased-full-game-content-and-planned-features\",\"text\":\"Teased Full Game Content and Planned Features\",\"level\":2},{\"id\":\"community-reception-and-demo-performance\",\"text\":\"Community Reception and Demo Performance\",\"level\":2},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"when-does-unharvest-release\",\"text\":\"When does Unharvest release?\",\"level\":3},{\"id\":\"what-platforms-run-unharvest\",\"text\":\"What platforms run Unharvest?\",\"level\":3},{\"id\":\"how-long-does-the-unharvest-demo-take-to-beat\",\"text\":\"How long does the Unharvest demo take to beat?\",\"level\":3},{\"id\":\"can-you-sit-on-the-tree-stump-in-the-demo\",\"text\":\"Can you sit on the tree stump in the demo?\",\"level\":3}],\"label\":\"Table of Contents\"}]\n"])</script><script>self.__next_f.push([1,"36:[\"$\",\"div\",null,{\"data-link-area\":\"body_link\",\"className\":\"article-body mt-8 max-w-none\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Unharvest turns standard agricultural simulations upside down by casting players as a malevolent force draining life from crops rather than cultivating them. Developed and published by SkorpionDev, the PC demo offers a focused 23 to 30-minute slice of reverse-farming incremental gameplay ahead of its planned December 7, 2026 release date. The title pairs minimalist clicking mechanics with a striking audiovisual transformation that tracks the systematic destruction of a peaceful wheat field.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"core-reverse-farming-loop-and-controls\",\"children\":\"Core Reverse-Farming Loop and Controls\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The game starts players in a peaceful, sunny wheat field bordered by a small creek, a fence, a scarecrow, and a distant windmill. Movement uses standard WASD navigation, while initial harvesting relies entirely on manual left-clicking to wither individual stalks. Draining life yields resource points that track in the upper left corner of the screen alongside a completion percentage gauge that tracks field clearance from 0.00% to 100%.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The opening minutes require deliberate manual input, as the base wither action carries a three-second cooldown and clears only one stalk at a time. Pressing Tab opens the upgrade tree, where players reinvest gathered points into expanding efficiency. The progression ramps rapidly once initial thresholds are cleared, transitioning the experience from isolated clicks to massive automated destruction across the field.\"}],\"\\n\",[\"$\",\"$L3f\",null,{\"size\":\"300x250\",\"className\":\"my-10 not-prose\"}],\"\\n\",[\"$\",\"div\",null,{\"role\":\"region\",\"aria-label\":\"Scrollable data table\",\"tabIndex\":0,\"className\":\"table-frame\",\"children\":[\"$\",\"table\",null,{\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"Feature\"}],[\"$\",\"th\",null,{\"children\":\"Base Demo State\"}],[\"$\",\"th\",null,{\"children\":\"Fully Upgraded Demo State\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Primary Input\"}],[\"$\",\"td\",null,{\"children\":\"Single left-click per stalk\"}],[\"$\",\"td\",null,{\"children\":\"Hold-to-wither and automatic wither while walking\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Base Action Speed\"}],[\"$\",\"td\",null,{\"children\":\"3.0-second wither cooldown\"}],[\"$\",\"td\",null,{\"children\":\"Cooldown reduced near zero (down to 0.03 seconds)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Stalk Harvest Yield\"}],[\"$\",\"td\",null,{\"children\":\"1 stalk per action\"}],[\"$\",\"td\",null,{\"children\":\"Up to 20 stalks per manual trigger\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Secondary Ability\"}],[\"$\",\"td\",null,{\"children\":\"Locked\"}],[\"$\",\"td\",null,{\"children\":\"Locust Swarm ability unleashed via right-click\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"Spore Propagation\"}],[\"$\",\"td\",null,{\"children\":\"Locked\"}],[\"$\",\"td\",null,{\"children\":\"Up to 50% spread chance across a 15-meter radius\"}]]}]]}]]}]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"skill-tree-upgrades-and-progression-mechanics\",\"children\":\"Skill Tree Upgrades and Progression Mechanics\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Progression flows through distinct branches that drastically alter interaction speeds:\"}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Harvest Output and Speed\"}],\": Early upgrades reduce the wither cooldown from 3 seconds down to 2 seconds and 1 second, before reaching fractions of a second at costs ascending to 25,000 points. Simultaneously, stalk capacity rises incrementally from 1 to 2, 3, 5, 8, and ultimately 20 stalks per action.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Control Improvements\"}],\": Unlocking \\\"Hold to wither\\\" at 1,000 points eliminates repetitive mouse clicking. Later in the tree, players can acquire the ability to wither crops simply by walking over them, enabling passive field clearing.\"]}],\"\\n\",\"$L40\",\"\\n\",\"$L41\",\"\\n\",\"$L42\",\"\\n\"]}],\"\\n\",\"$L43\",\"\\n\",\"$L44\",\"\\n\",\"$L45\",\"\\n\",\"$L46\",\"\\n\",\"$L47\",\"\\n\",\"$L48\",\"\\n\",\"$L49\",\"\\n\",\"$L4a\",\"\\n\",\"$L4b\",\"\\n\",\"$L4c\",\"\\n\",\"$L4d\",\"\\n\",\"$L4e\",\"\\n\",\"$L4f\",\"\\n\",\"$L50\",\"\\n\",\"$L51\",\"\\n\",\"$L52\",\"\\n\",\"$L53\",\"\\n\",\"$L54\",\"\\n\",\"$L55\"]}]\n"])</script><script>self.__next_f.push([1,"37:[\"$\",\"p\",null,{\"data-link-area\":\"body_link\",\"data-game-identity\":true,\"className\":\"text-sm leading-6 text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Unharvest\"}],[\"$\",\"span\",null,{\"children\":[\" · \",\"Platform\",\": \",\"Windows PC\"]}],[\"$\",\"span\",null,{\"children\":[\" · \",\"Developer\",\": \",\"SkorpionDev\"]}],[]]}]\n"])</script><script>self.__next_f.push([1,"38:[\"$\",\"section\",null,{\"data-link-area\":\"related\",\"aria-labelledby\":\"related-guides\",\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"related-guides\",\"className\":\"section-title mb-5\",\"children\":\"Related guides\"}],[\"$\",\"div\",null,{\"className\":\"card-grid\",\"children\":[[\"$\",\"$L14\",\"guide/unharvest-guide\",{\"prefetch\":false,\"href\":\"/guide/unharvest-guide\",\"className\":\"article-card group\",\"draggable\":false,\"children\":[[\"$\",\"div\",null,{\"className\":\"article-card-cover\",\"children\":[\"$\",\"picture\",null,{\"children\":[[\"$\",\"source\",null,{\"type\":\"image/avif\",\"srcSet\":\"/images/covers/guide/unharvest-guide.360.avif 360w, /images/covers/guide/unharvest-guide.640.avif 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\"}],[\"$\",\"img\",null,{\"src\":\"/images/covers/guide/unharvest-guide.640.webp\",\"srcSet\":\"/images/covers/guide/unharvest-guide.360.webp 360w, /images/covers/guide/unharvest-guide.640.webp 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\",\"width\":\"640\",\"height\":\"360\",\"alt\":\"Unharvest Guide: Demo Walkthrough, Upgrades, and Lore Locations\",\"loading\":\"lazy\",\"decoding\":\"async\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"article-card-body\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Guide: Demo Walkthrough, Upgrades, and Lore Locations\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-3\",\"children\":\"Clear the Unharvest demo with optimized upgrade routes, locust swarm mechanics, spore spread strategies, and all collectible lore note locations.\"}]]}]]}],[\"$\",\"$L14\",\"guide/unharvest-locusts\",{\"prefetch\":false,\"href\":\"/guide/unharvest-locusts\",\"className\":\"article-card group\",\"draggable\":false,\"children\":[[\"$\",\"div\",null,{\"className\":\"article-card-cover\",\"children\":[\"$\",\"picture\",null,{\"children\":[[\"$\",\"source\",null,{\"type\":\"image/avif\",\"srcSet\":\"/images/covers/guide/unharvest-locusts.360.avif 360w, /images/covers/guide/unharvest-locusts.640.avif 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\"}],[\"$\",\"img\",null,{\"src\":\"/images/covers/guide/unharvest-locusts.640.webp\",\"srcSet\":\"/images/covers/guide/unharvest-locusts.360.webp 360w, /images/covers/guide/unharvest-locusts.640.webp 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\",\"width\":\"640\",\"height\":\"360\",\"alt\":\"Unharvest Locusts: How to Unlock Swarms and Upgrade Plague Builds\",\"loading\":\"lazy\",\"decoding\":\"async\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"article-card-body\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Locusts: How to Unlock Swarms and Upgrade Plague Builds\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-3\",\"children\":\"Unlock Unharvest locusts for 10,000 souls, trigger swarm strikes with right-click, and boost cooldown, speed, and duration to clear entire fields.\"}]]}]]}],[\"$\",\"$L14\",\"guide/unharvest-plague-spreading\",{\"prefetch\":false,\"href\":\"/guide/unharvest-plague-spreading\",\"className\":\"article-card group\",\"draggable\":false,\"children\":[[\"$\",\"div\",null,{\"className\":\"article-card-cover\",\"children\":[\"$\",\"picture\",null,{\"children\":[[\"$\",\"source\",null,{\"type\":\"image/avif\",\"srcSet\":\"/images/covers/guide/unharvest-plague-spreading.360.avif 360w, /images/covers/guide/unharvest-plague-spreading.640.avif 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\"}],[\"$\",\"img\",null,{\"src\":\"/images/covers/guide/unharvest-plague-spreading.640.webp\",\"srcSet\":\"/images/covers/guide/unharvest-plague-spreading.360.webp 360w, /images/covers/guide/unharvest-plague-spreading.640.webp 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\",\"width\":\"640\",\"height\":\"360\",\"alt\":\"Unharvest Plague Spreading Mechanics, Upgrades, and Farm Clearing\",\"loading\":\"lazy\",\"decoding\":\"async\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"article-card-body\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Plague Spreading Mechanics, Upgrades, and Farm Clearing\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-3\",\"children\":\"Unharvest plague spreading relies on upgrading fungal spores, unlocking locust swarms, and using auto-wither to clear the entire field.\"}]]}]]}],[\"$\",\"$L14\",\"guide/unharvest-plague-upgrades\",{\"prefetch\":false,\"href\":\"/guide/unharvest-plague-upgrades\",\"className\":\"article-card group\",\"draggable\":false,\"children\":[[\"$\",\"div\",null,{\"className\":\"article-card-cover\",\"children\":\"$L56\"}],\"$L57\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"3b:[\"$\",\"$L58\",null,{}]\n"])</script><script>self.__next_f.push([1,"40:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Fungal Spores\"}],\": Unlocking spores for 100 points introduces passive plague spread. Once active, withering crops has a baseline 10% chance to infect neighboring stalks. Successive upgrades expand spread probability to 25%, 40%, and 50%, while increasing spread radius from 3 meters to 15 meters.\"]}]\n41:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Locust Swarm\"}],\": Purchased for 10,000 points, this active ability unleashes a destructive swarm using right-click. Upgrades govern swarm travel speed, active duration, area radius, and cooldown reduction from its initial 60-second timer down to 30 seconds.\"]}]\n42:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Critical Withering\"}],\": Branching upgrades add critical wither chance alongside rewards that double resource yields when critical hits trigger.\"]}]\n43:[\"$\",\"p\",null,{\"children\":\"A late-tier cooldown reduction upgrade listed at 100,000 points exists in the menu, though playthroughs show that clearing 100% of the demo field often finishes before accumulating that total unless players heavily farm critical multipliers.\"}]\n44:[\"$\",\"h2\",null,{\"id\":\"environmental-storytelling-and-field-lore\",\"children\":\"Environmental Storytelling and Field Lore\"}]\n45:[\"$\",\"p\",null,{\"children\":\"The visual tone shifts radically as field completion advances. At low percentages, the landscape features bright skies, flying butterflies, and gentle wind audio. As withering passes 50% and approaches 85%, dark clouds gather, birds flee the area, and red or black visual distortions appear around the screen borders. Ambient notes and environmental landmarks left behind across the farm reveal fragmentary narrative clues when players interact with them:\"}]\n"])</script><script>self.__next_f.push([1,"46:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Warning\"}],\": A child-like drawing showing a sunlit field with an approaching black mass.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Feast\"}],\": Notes detailing crickets and unharvested crops.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Omen\"}],\": Imagery depicting the Four Horsemen of the Apocalypse, aligning with player theories regarding Pestilence or Death.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Visitor\"}],\": An illustration portraying a horned, towering figure matching the player character's perspective.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Unpaid and Prayer\"}],\": Scattered scraps hinting at abandoned labor, debt, and desperate religious appeals.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Field Landmarks\"}],\": Interactions with the abandoned scythe (\\\"Still sharp. Won't matter.\\\"), the motionless windmill (\\\"The mill stopped. Nobody came to fix it.\\\"), the watching scarecrow, and a tombstone (\\\"They'll be back for the rest.\\\").\"]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"47:[\"$\",\"p\",null,{\"children\":\"Upon wiping out every remaining stalk, the counter strikes 100%, displaying a prompt stating \\\"Nothing left\\\" before presenting the end-of-demo screen.\"}]\n48:[\"$\",\"h2\",null,{\"id\":\"teased-full-game-content-and-planned-features\",\"children\":\"Teased Full Game Content and Planned Features\"}]\n49:[\"$\",\"p\",null,{\"children\":\"The demo interface directly identifies several features reserved for the full commercial release. Locked nodes in the upgrade menu confirm that future versions will include rat plagues, multiple swarm counts, and a blight mechanic. The closing screen highlights that the full game will introduce new plagues, different historical eras, and fields beyond wheat crops.\"}]\n4a:[\"$\",\"p\",null,{\"children\":\"On the official Steam discussion boards, developer SkorpionDev confirmed that additional lore, events, and mechanics are planned. In response to player feedback regarding finding isolated crop remnants on larger maps, the developer stated that tracking tools for remaining patches are under consideration. The developer also noted plans to introduce escalating challenge as human populations react to spreading plagues.\"}]\n4b:[\"$\",\"h2\",null,{\"id\":\"community-reception-and-demo-performance\",\"children\":\"Community Reception and Demo Performance\"}]\n4c:[\"$\",\"p\",null,{\"children\":\"Steam players and community reviewers widely praise the relaxing yet unsettling audio design, rating the demo favorably for its tactile feedback. Players report average completion times between 23 and 30 minutes, noting that progression feels fast and rewarding once spores and swarm mechanics synergize. Technical feedback has been largely stable across Windows 10 and 11, though minor player reports on Steam forums mention frame drops during heavy harvesting animations and isolated Unity player initialization errors on unsupported Windows 7 operating systems.\"}]\n4d:[\"$\",\"h2\",null,{\"id\":\"frequently-asked-questions\",\"children\":\"Frequently Asked Questions\"}]\n4e:[\"$\",\"h3\",null,{\"id\":\"when-does-unharvest-release\",\"childr"])</script><script>self.__next_f.push([1,"en\":\"When does Unharvest release?\"}]\n4f:[\"$\",\"p\",null,{\"children\":\"According to the game's official Steam store page, Unharvest is scheduled to release on December 7, 2026.\"}]\n50:[\"$\",\"h3\",null,{\"id\":\"what-platforms-run-unharvest\",\"children\":\"What platforms run Unharvest?\"}]\n51:[\"$\",\"p\",null,{\"children\":\"Unharvest is confirmed for Windows PC. The official system requirements specify Windows 10 as minimum and Windows 11 as recommended.\"}]\n52:[\"$\",\"h3\",null,{\"id\":\"how-long-does-the-unharvest-demo-take-to-beat\",\"children\":\"How long does the Unharvest demo take to beat?\"}]\n53:[\"$\",\"p\",null,{\"children\":\"Playthrough records and community reports show the demo takes approximately 23 to 30 minutes to achieve 100% field clearance.\"}]\n54:[\"$\",\"h3\",null,{\"id\":\"can-you-sit-on-the-tree-stump-in-the-demo\",\"children\":\"Can you sit on the tree stump in the demo?\"}]\n55:[\"$\",\"p\",null,{\"children\":\"A tree stump prompt reading \\\"click to sit\\\" appears near the end of the field, allowing players to pause and survey the withered landscape before final completion.\"}]\n56:[\"$\",\"picture\",null,{\"children\":[[\"$\",\"source\",null,{\"type\":\"image/avif\",\"srcSet\":\"/images/covers/guide/unharvest-plague-upgrades.360.avif 360w, /images/covers/guide/unharvest-plague-upgrades.640.avif 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\"}],[\"$\",\"img\",null,{\"src\":\"/images/covers/guide/unharvest-plague-upgrades.640.webp\",\"srcSet\":\"/images/covers/guide/unharvest-plague-upgrades.360.webp 360w, /images/covers/guide/unharvest-plague-upgrades.640.webp 640w\",\"sizes\":\"(min-width: 640px) 270px, 78vw\",\"width\":\"640\",\"height\":\"360\",\"alt\":\"Unharvest Plague Upgrades: Skill Tree List and Ability Guide\",\"loading\":\"lazy\",\"decoding\":\"async\"}]]}]\n57:[\"$\",\"div\",null,{\"className\":\"article-card-body\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Plague Upgrades: Skill Tree List and Ability Guide\"}],[\"$\",\"p\",null,{\"className\":\"line-clamp-3\",\"children\":\"Unharvest plague upgrades include spores, locust swarms, and walking decay to wipe out crops across the d
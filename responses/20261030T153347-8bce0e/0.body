u0440\\u0430 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u0435\\u043d\\u0430 \\u0432 \\u0432\\u0430\\u0448 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0436\\u0435\\u043b\\u0430\\u0435\\u043c\\u043e\\u0433\\u043e. \\u041a\\u043e\\u0433\\u0434\\u0430 \\u043e\\u043d\\u0430 \\u0432\\u044b\\u0439\\u0434\\u0435\\u0442, \\u0432\\u0430\\u043c \\u043d\\u0430 \\u043f\\u043e\\u0447\\u0442\\u0443 \\u043f\\u0440\\u0438\\u0434\\u0451\\u0442 \\u0443\\u0432\\u0435\\u0434\\u043e\\u043c\\u043b\\u0435\\u043d\\u0438\\u0435.\\n\\n[b]\\u041a\\u0430\\u043a \\u0443\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u044c \\u00ab\\u0418\\u0433\\u0440\\u0430\\u043c \\u0431\\u044b\\u0442\\u044c\\u00bb?[\\\/b]\\n\\u0421\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u0438\\u0433\\u0440\\u044b \\u0432 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435 \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u043e\\u0432 \\u043e\\u0442\\u0441\\u043e\\u0440\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u044b \\u0441\\u043b\\u0443\\u0447\\u0430\\u0439\\u043d\\u044b\\u043c \\u043e\\u0431\\u0440\\u0430\\u0437\\u043e\\u043c. \\u0421\\u043e \\u0441\\u0440\\u0435\\u0434\\u044b Steam \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0435\\u0442 \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438\\u0433\\u0440\\u043e\\u043a\\u0430\\u043c \\u043f\\u0440\\u043e\\u0434\\u0443\\u043a\\u0442\\u044b \\u043d\\u0430 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0435 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445, \\u0441\\u043e\\u0431\\u0440\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0432 \\u043f\\u0435\\u0440\\u0432\\u044b\\u0435 \\u0434\\u043d\\u0438 \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u044f.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]\\u0e27\\u0e34\\u0e18\\u0e35\\u0e40\\u0e02\\u0e49\\u0e32\\u0e23\\u0e48\\u0e27\\u0e21\\u0e21\\u0e2b\\u0e01\\u0e23\\u0e23\\u0e21\\u0e40\\u0e19\\u0e01\\u0e0b\\u0e4c[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]\\u0e40\\u0e25\\u0e48\\u0e19\\u0e40\\u0e14\\u0e42\\u0e21: [\\\/b]\\u0e17\\u0e31\\u0e19\\u0e17\\u0e35\\u0e17\\u0e35\\u0e48\\u0e04\\u0e38\\u0e13\\u0e0a\\u0e35\\u0e49\\u0e40\\u0e21\\u0e32\\u0e2a\\u0e4c\\u0e44\\u0e1b\\u0e1a\\u0e19\\u0e40\\u0e01\\u0e21\\u0e43\\u0e14\\u0e01\\u0e47\\u0e15\\u0e32\\u0e21 \\u0e04\\u0e38\\u0e13\\u0e08\\u0e30\\u0e40\\u0e2b\\u0e47\\u0e19\\u0e1b\\u0e38\\u0e48\\u0e21\\u0e43\\u0e2b\\u0e49\\u0e15\\u0e34\\u0e14\\u0e15\\u0e31\\u0e49\\u0e07\\u0e40\\u0e14\\u0e42\\u0e21\\u0e17\\u0e35\\u0e48\\u0e2a\\u0e32\\u0e21\\u0e32\\u0e23\\u0e16\\u0e40\\u0e25\\u0e48\\u0e19\\u0e44\\u0e14\\u0e49 \\u0e25\\u0e2d\\u0e07\\u0e2a\\u0e31\\u0e01\\u0e40\\u0e01\\u0e21\\u0e2a\\u0e34! \\u0e2b\\u0e23\\u0e37\\u0e2d\\u0e2a\\u0e31\\u0e01\\u0e42\\u0e2b\\u0e25\\u0e01\\u0e47\\u0e44\\u0e14\\u0e49 \\n\\n[b]\\u0e40\\u0e1e\\u0e34\\u0e48\\u0e21\\u0e40\\u0e01\\u0e21\\u0e17\\u0e35\\u0e48\\u0e04\\u0e38\\u0e13\\u0e0a\\u0e37\\u0e48\\u0e19\\u0e0a\\u0e2d\\u0e1a\\u0e43\\u0e19\\u0e2a\\u0e34\\u0e48\\u0e07\\u0e17\\u0e35\\u0e48\\u0e2d\\u0e22\\u0e32\\u0e01\\u0e44\\u0e14\\u0e49:[\\\/b] \\u0e40\\u0e08\\u0e2d\\u0e40\\u0e01\\u0e21\\u0e17\\u0e35\\u0e48\\u0e04\\u0e38\\u0e13\\u0e2d\\u0e22\\u0e32\\u0e01\\u0e23\\u0e39\\u0e49\\u0e27\\u0e48\\u0e32\\u0e08\\u0e30\\u0e40\\u0e1b\\u0e34\\u0e14\\u0e15\\u0e31\\u0e27\\u0e40\\u0e21\\u0e37\\u0e48\\u0e2d\\u0e44\\u0e2b\\u0e23\\u0e48\\u0e43\\u0e0a\\u0e48\\u0e44\\u0e2b\\u0e21? \\u0e0a\\u0e35\\u0e49\\u0e40\\u0e21\\u0e32\\u0e2a\\u0e4c\\u0e44\\u0e1b\\u0e1a\\u0e19\\u0e40\\u0e01\\u0e21\\u0e43\\u0e14\\u0e01\\u0e47\\u0e44\\u0e14\\u0e49 \\u0e41\\u0e25\\u0e49\\u0e27\\u0e04\\u0e25\\u0e34\\u0e01\\u0e44\\u0e2d\\u0e04\\u0e2d\\u0e19\\u0e23\\u0e39\\u0e1b\\u0e14\\u0e32\\u0e27\\u0e17\\u0e35\\u0e48\\u0e21\\u0e38\\u0e21\\u0e1a\\u0e19\\u0e02\\u0e27\\u0e32\\u0e40\\u0e1e\\u0e37\\u0e48\\u0e2d\\u0e40\\u0e1e\\u0e34\\u0e48\\u0e21\\u0e40\\u0e01\\u0e21\\u0e19\\u0e31\\u0e49\\u0e19\\u0e43\\u0e19\\u0e2a\\u0e34\\u0e48\\u0e07\\u0e17\\u0e35\\u0e48\\u0e2d\\u0e22\\u0e32\\u0e01\\u0e44\\u0e14\\u0e49\\u0e02\\u0e2d\\u0e07\\u0e04\\u0e38\\u0e13 \\u0e04\\u0e38\\u0e13\\u0e44\\u0e14\\u0e49\\u0e08\\u0e30\\u0e44\\u0e14\\u0e49\\u0e23\\u0e31\\u0e1a\\u0e2d\\u0e35\\u0e40\\u0e21\\u0e25\\u0e41\\u0e08\\u0e49\\u0e07\\u0e40\\u0e15\\u0e37\\u0e2d\\u0e19\\u0e40\\u0e21\\u0e37\\u0e48\\u0e2d\\u0e40\\u0e01\\u0e21\\u0e19\\u0e31\\u0e49\\u0e19\\u0e27\\u0e32\\u0e07\\u0e08\\u0e33\\u0e2b\\u0e19\\u0e48\\u0e32\\u0e22\\n\\n[b]\\u0e21\\u0e2b\\u0e01\\u0e23\\u0e23\\u0e21\\u0e40\\u0e19\\u0e01\\u0e0b\\u0e4c\\u0e08\\u0e31\\u0e14\\u0e2b\\u0e21\\u0e27\\u0e14\\u0e2b\\u0e21\\u0e39\\u0e48\\u0e2d\\u0e22\\u0e48\\u0e32\\u0e07\\u0e44\\u0e23?[\\\/b]\\n\\u0e21\\u0e2b\\u0e01\\u0e23\\u0e23\\u0e21\\u0e40\\u0e19\\u0e01\\u0e0b\\u0e4c\\u0e40\\u0e23\\u0e34\\u0e48\\u0e21\\u0e02\\u0e36\\u0e49\\u0e19\\u0e42\\u0e14\\u0e22\\u0e2b\\u0e21\\u0e27\\u0e14\\u0e2b\\u0e21\\u0e39\\u0e48\\u0e2a\\u0e48\\u0e27\\u0e19\\u0e43\\u0e2b\\u0e0d\\u0e48\\u0e08\\u0e30\\u0e44\\u0e14\\u0e49\\u0e23\\u0e31\\u0e1a\\u0e01\\u0e32\\u0e23\\u0e08\\u0e31\\u0e14\\u0e40\\u0e23\\u0e35\\u0e22\\u0e07\\u0e41\\u0e1a\\u0e1a\\u0e2a\\u0e38\\u0e48\\u0e21 \\u0e08\\u0e32\\u0e01\\u0e19\\u0e31\\u0e49\\u0e19 Steam \\u0e08\\u0e30\\u0e19\\u0e33\\u0e2a\\u0e34\\u0e48\\u0e07\\u0e17\\u0e35\\u0e48\\u0e44\\u0e14\\u0e49\\u0e40\\u0e23\\u0e35\\u0e22\\u0e19\\u0e23\\u0e39\\u0e49\\u0e43\\u0e19\\u0e0a\\u0e48\\u0e27\\u0e07\\u0e2a\\u0e2d\\u0e07\\u0e2a\\u0e32\\u0e21\\u0e27\\u0e31\\u0e19\\u0e41\\u0e23\\u0e01\\u0e02\\u0e2d\\u0e07\\u0e21\\u0e2b\\u0e01\\u0e23\\u0e23\\u0e21\\u0e44\\u0e1b\\u0e43\\u0e0a\\u0e49\\u0e40\\u0e1e\\u0e37\\u0e48\\u0e2d\\u0e1b\\u0e23\\u0e31\\u0e1a\\u0e1b\\u0e23\\u0e38\\u0e07\\u0e01\\u0e32\\u0e23\\u0e41\\u0e19\\u0e30\\u0e19\\u0e33\\u0e40\\u0e01\\u0e21\\u0e43\\u0e2b\\u0e49\\u0e1c\\u0e39\\u0e49\\u0e40\\u0e25\\u0e48\\u0e19\\u0e44\\u0e14\\u0e49\\u0e14\\u0e35\\u0e22\\u0e34\\u0e48\\u0e07\\u0e02\\u0e36\\u0e49\\u0e19\\u0e15\\u0e31\\u0e49\\u0e07\\u0e41\\u0e15\\u0e48\\u0e27\\u0e31\\u0e19\\u0e1e\\u0e38\\u0e18\\u0e40\\u0e1b\\u0e47\\u0e19\\u0e15\\u0e49\\u0e19\\u0e44\\u0e1b..\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Next\\u30d5\\u30a7\\u30b9\\u306e\\u697d\\u3057\\u307f\\u65b9[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]\\u4f53\\u9a13\\u7248\\u3092\\u30d7\\u30ec\\u30a4\\uff1a[\\\/b]\\u30b2\\u30fc\\u30e0\\u306b\\u30ab\\u30fc\\u30bd\\u30eb\\u3092\\u5408\\u308f\\u305b\\u308b\\u3068\\u3001\\u30d7\\u30ec\\u30a4\\u53ef\\u80fd\\u306a\\u4f53\\u9a13\\u7248\\u3092\\u30a4\\u30f3\\u30b9\\u30c8\\u30fc\\u30eb\\u3059\\u308b\\u30dc\\u30bf\\u30f3\\u304c\\u8868\\u793a\\u3055\\u308c\\u307e\\u3059\\u3002\\u3044\\u304f\\u3064\\u3067\\u3082\\u3001\\u597d\\u304d\\u306a\\u3060\\u3051\\u304a\\u8a66\\u3057\\u304f\\u3060\\u3055\\u3044\\u3002 \\n\\n[b]\\u304a\\u6c17\\u306b\\u5165\\u308a\\u3092\\u30a6\\u30a3\\u30c3\\u30b7\\u30e5\\u30ea\\u30b9\\u30c8\\u306b\\u8ffd\\u52a0\\uff1a[\\\/b]\\u30ea\\u30ea\\u30fc\\u30b9\\u6642\\u306b\\u304a\\u77e5\\u3089\\u305b\\u3092\\u53d7\\u3051\\u53d6\\u308a\\u305f\\u3044\\u30b2\\u30fc\\u30e0\\u3092\\u898b\\u3064\\u3051\\u307e\\u3057\\u305f\\u304b\\uff1f\\u304a\\u597d\\u304d\\u306a\\u30b2\\u30fc\\u30e0\\u306b\\u30ab\\u30fc\\u30bd\\u30eb\\u3092\\u5408\\u308f\\u305b\\u3001\\u53f3\\u4e0a\\u306e\\u661f\\u306e\\u30a2\\u30a4\\u30b3\\u30f3\\u3092\\u30af\\u30ea\\u30c3\\u30af\\u3057\\u3066\\u30a6\\u30a3\\u30c3\\u30b7\\u30e5\\u30ea\\u30b9\\u30c8\\u306b\\u8ffd\\u52a0\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\\u305d\\u306e\\u30b2\\u30fc\\u30e0\\u306e\\u30ea\\u30ea\\u30fc\\u30b9\\u6642\\u306b\\u3001\\u30e1\\u30fc\\u30eb\\u3067\\u901a\\u77e5\\u304c\\u5c4a\\u304f\\u3088\\u3046\\u306b\\u306a\\u308a\\u307e\\u3059\\u3002\\n\\n[b]Next\\u30d5\\u30a7\\u30b9\\u306e\\u30b2\\u30fc\\u30e0\\u306f\\u3069\\u306e\\u3088\\u3046\\u306b\\u914d\\u7f6e\\u3055\\u308c\\u307e\\u3059\\u304b\\uff1f[\\\/b]\\nNext\\u30d5\\u30a7\\u30b9\\u306f\\u3001\\u307b\\u3068\\u3093\\u3069\\u306e\\u30bb\\u30af\\u30b7\\u30e7\\u30f3\\u3067\\u30b2\\u30fc\\u30e0\\u304c\\u30e9\\u30f3\\u30c0\\u30e0\\u306b\\u914d\\u7f6e\\u3055\\u308c\\u305f\\u72b6\\u614b\\u3067\\u59cb\\u307e\\u308a\\u307e\\u3059\\u3002 Steam\\u306f\\u3001\\u30d5\\u30a7\\u30b9\\u304c\\u59cb\\u307e\\u3063\\u3066\\u304b\\u3089\\u6700\\u521d\\u306e\\u6570\\u65e5\\u9593\\u306e\\u30a2\\u30af\\u30c6\\u30a3\\u30d3\\u30c6\\u30a3\\u3092\\u5206\\u6790\\u3057\\u3001\\u6c34\\u66dc\\u65e5\\u4ee5\\u964d\\u306f\\u30d7\\u30ec\\u30a4\\u30e4\\u30fc\\u306b\\u6700\\u9069\\u306a\\u30b2\\u30fc\\u30e0\\u3092\\u304a\\u3059\\u3059\\u3081\\u3059\\u308b\\u3088\\u3046\\u306b\\u306a\\u308a\\u307e\\u3059\\u3002\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Como aproveitar ao m\\u00e1ximo[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Joga demos:[\\\/b] passa o cursor por cima de qualquer jogo e encontrar\\u00e1s imediatamente um bot\\u00e3o para instalar a demo. Experimenta uma! Ou v\\u00e1rias! \\n\\n[b]Adiciona os teus favoritos \\u00e0 lista de desejos:[\\\/b] encontraste um jogo e queres saber mais sobre ele quando for lan\\u00e7ado? Passa o cursor por cima de qualquer jogo e clica na estrela no canto superior direito para o adicionares \\u00e0 lista de desejos. Ir\\u00e1s receber uma notifica\\u00e7\\u00e3o por e\\u2011mail quando esse jogo for lan\\u00e7ado.\\n\\n[b]Como \\u00e9 o Next Fest organizado?[\\\/b]\\nO Next Fest come\\u00e7a com a maioria das sec\\u00e7\\u00f5es organizadas aleatoriamente. O Steam baseia-se no que aprendeu durante os primeiros dias do Next Fest para melhor recomendar jogos aos utilizadores de quarta-feira em diante.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Jak korzysta\\u0107 z Festiwalu Steam Next[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Grajcie w dema:[\\\/b] najed\\u017acie kursorem na dowoln\\u0105 gr\\u0119, a od razu zobaczycie przycisk instalacji grywalnego dema. Wypr\\u00f3bujcie jedno albo dwa! Albo ca\\u0142y tuzin. \\n\\n[b]Dodawajcie ulubione tytu\\u0142y do listy \\u017cycze\\u0144:[\\\/b] znale\\u017ali\\u015bcie gr\\u0119 i chcieliby\\u015bcie us\\u0142ysze\\u0107 o niej, kiedy zostanie wydana? Najed\\u017acie na dowoln\\u0105 gr\\u0119 i kliknijcie ikon\\u0119 gwiazdki w prawym g\\u00f3rnym rogu, by doda\\u0107 j\\u0105 do listy \\u017cycze\\u0144. Otrzymacie stylowy e-mail z powiadomieniem w dniu premiery.\\n\\n[b]Jak zorganizowany jest Festiwal Steam Next?[\\\/b]\\nSteam Next rozpoczyna si\\u0119 z wi\\u0119kszo\\u015bci\\u0105 sekcji posortowan\\u0105 losowo. Zaczynaj\\u0105c od \\u015brody, Steam u\\u017cywa tego, czego nauczy si\\u0119 w pierwszych dniach wydarzenia, by lepiej poleca\\u0107 gry graczom.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]S\\u00e5dan fungerer forfestivalen[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Spil demoer: [\\\/b]Hold musen over et spil, s\\u00e5 vises der straks en knap til at installere den spilbare demo. Pr\\u00f8v det med et spil! Eller med flere. \\n\\n[b]Tilf\\u00f8j dine favoritter til \\u00f8nskelisten:[\\\/b] Er der et spil, du gerne vil h\\u00f8re om, n\\u00e5r det bliver udgivet? Hold musen over et spil, og klik p\\u00e5 stjerneikonet i \\u00f8verste h\\u00f8jre hj\\u00f8rne for at tilf\\u00f8je det til din \\u00f8nskeliste. Du f\\u00e5r besked via e-mail, n\\u00e5r spillet bliver udgivet.\\n\\n[b]Hvordan er forfestivalen organiseret?[\\\/b]\\nN\\u00e5r forfestivalen starter, er de fleste sektioner sorteret tilf\\u00e6ldigt. Steam bruger, hvad det l\\u00e6rer i de f\\u00f8rste par dage af forfestivalen, til at give bedre anbefalinger til spillere fra og med onsdag.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Hoe werkt het Next Festival?[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Speel demo's:[\\\/b] beweeg je muis over een spel om de knop te vinden waarmee je de speelbare demo kunt installeren. Probeer er eens eentje! Of probeer ze allemaal. \\n\\n[b]Zet je favorieten op je verlanglijst:[\\\/b] heb je een spel gevonden waarvoor je een melding wilt ontvangen als het uitkomt? Beweeg je muis over het spel en klik op het sterpictogram in de rechterbovenhoek om het toe te voegen aan je verlanglijst. Je ontvangt dan een e-mail wanneer dat spel wordt uitgebracht.\\n\\n[b]Hoe is het Next Festival ingedeeld?[\\\/b]\\nBij de start van het Next Festival zijn de meeste secties willekeurig ingedeeld. Steam probeert vervolgens in de eerste dagen van het festival meer te leren over de voorkeuren van spelers en vanaf woensdag worden de aanbevelingen op basis van die kennis aangepast.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Vinkit Next Festiin[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Pelaa demoja[\\\/b] \\u2013 Demon asennuspainike ilmestyy, kun pid\\u00e4t hiirt\\u00e4 mink\\u00e4 tahansa pelin kohdalla. Kannattaa kokeilla. Demoja nimitt\\u00e4in piisaa! \\n\\n[b]Lis\\u00e4\\u00e4 suosikkisi toivelistalle[\\\/b] \\u2013 L\\u00f6ysitk\\u00f6 pelin, jonka julkaisua haluat pit\\u00e4\\u00e4 silm\\u00e4ll\\u00e4? Kun pid\\u00e4t hiirt\\u00e4 mink\\u00e4 tahansa pelin kohdalla ja klikkaat t\\u00e4htikuvaketta yl\\u00e4oikealla, peli lis\\u00e4t\\u00e4\\u00e4n toivelistallesi. Saat ilmoituksen s\\u00e4hk\\u00f6postitse, kun peli julkaistaan.\\n\\n[b]Miten pelit j\\u00e4rjestell\\u00e4\\u00e4n Next Festiss\\u00e4?[\\\/b]\\nNext Festin alkaessa useimmat osiot ovat satunnaisessa j\\u00e4rjestyksess\\u00e4. Steamin algoritmi tutkii k\\u00e4ytt\\u00e4jien selaustietoja muutaman ensimm\\u00e4isen p\\u00e4iv\\u00e4n aikana ja antaa niiden perusteella keskiviikosta alkaen osuvampia suosituksia.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Slik fungerer f\\u00f8rslippfestivalen[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Spill demoer:[\\\/b] Hold over et hvilket som helst spill, s\\u00e5 finner du umiddelbart en knapp for \\u00e5 installere den spillbare demoen. Pr\\u00f8v \\u00e9n! Eller flere. \\n\\n[b]Legg favoritter p\\u00e5 \\u00f8nskelisten:[\\\/b] Fant du et spill du vil h\\u00f8re om n\\u00e5r det kommer ut? Hold over hvilket som helst spill og trykk p\\u00e5 stjerneikonet \\u00f8verst i h\\u00f8yre hj\\u00f8rne for \\u00e5 legge det til p\\u00e5 \\u00f8nskelisten. Du f\\u00e5r beskjed p\\u00e5 e-post n\\u00e5r spillet kommer ut.\\n\\n[b]Hvordan er f\\u00f8rslippfestivalen organisert?[\\\/b]\\nF\\u00f8rslippfestivalen starter med de fleste seksjonene i tilfeldig rekkef\\u00f8lge. Steam bruker hva det l\\u00e6rer i l\\u00f8pet av de f\\u00f8rste dagene av festivalen til \\u00e5 tilby bedre anbefalinger til spillere fra og med onsdag.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]S\\u00e5 h\\u00e4r fungerar f\\u00f6rfestivalen[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Spela demor:[\\\/b] Hovra med muspekaren \\u00f6ver ett spel s\\u00e5 visas en knapp f\\u00f6r att installera den spelbara demon. Prova ett spel! Eller prova flera. \\n\\n[b]L\\u00e4gg till dina favoriter p\\u00e5 \\u00f6nskelistan:[\\\/b] Hittade du ett spel som du vill bli meddelad om n\\u00e4r det sl\\u00e4pps? Hovra med muspekaren \\u00f6ver ett spel och klicka p\\u00e5 stj\\u00e4rnikonen i det \\u00f6vre h\\u00f6gra h\\u00f6rnet f\\u00f6r att l\\u00e4gga till spelet p\\u00e5 \\u00f6nskelistan. Du f\\u00e5r d\\u00e5 ett e-postmeddelande n\\u00e4r spelet sl\\u00e4pps.\\n\\n[b]Hur \\u00e4r f\\u00f6rfestivalen upplagd?[\\\/b]\\nN\\u00e4r f\\u00f6rfestivalen startar \\u00e4r de flesta sektionerna slumpm\\u00e4ssigt sorterade. Det Steam l\\u00e4r sig under de f\\u00f6rsta dagarna av festivalen anv\\u00e4nds sedan f\\u00f6r att fr\\u00e5n och med onsdagen kunna ge spelare b\\u00e4ttre spelrekommendationer.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]\\u00cdgy J\\u00f6v\\u0151 Fesztezz[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]J\\u00e1tssz dem\\u00f3kkal:[\\\/b] Vidd az egeret b\\u00e1rmelyik j\\u00e1t\\u00e9k f\\u00f6l\\u00e9, \\u00e9s azonnal tal\\u00e1lni fogsz egy gombot a j\\u00e1tszhat\\u00f3 dem\\u00f3 telep\\u00edt\\u00e9s\\u00e9hez. Pr\\u00f3b\\u00e1lj ki egyet! Vagy egy tucatot. \\n\\n[b]K\\u00edv\\u00e1ns\\u00e1glist\\u00e1zd kedvenceidet:[\\\/b] Tal\\u00e1lt\\u00e1l egy j\\u00e1t\\u00e9kot, amir\\u0151l szeretn\\u00e9l hallani, amikor kiad\\u00e1sra ker\\u00fcl? Menj az eg\\u00e9rrel b\\u00e1rmelyik j\\u00e1t\\u00e9k f\\u00f6l\\u00e9, \\u00e9s kattints a csillag ikonra a jobb fels\\u0151 sarokban, hogy hozz\\u00e1add a k\\u00edv\\u00e1ns\\u00e1glist\\u00e1dhoz. Kapni fogsz egy men\\u0151 e-mail-\\u00e9rtes\\u00edt\\u00e9st a j\\u00e1t\\u00e9k kiad\\u00e1sakor.\\n\\n[b]Hogyan van rendszerezve a J\\u00f6v\\u0151 Feszt?[\\\/b]\\nA J\\u00f6v\\u0151 Feszt kezdetekor a legt\\u00f6bb szakasz v\\u00e9letlenszer\\u0171en van rendezve. A Steam a fesztiv\\u00e1l els\\u0151 n\\u00e9h\\u00e1ny napja alatt szerzett tapasztalatait haszn\\u00e1lja fel, hogy szerd\\u00e1t\\u00f3l kezdve jobban tudjon j\\u00e1t\\u00e9kokat aj\\u00e1nlani a j\\u00e1t\\u00e9kosoknak.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Festivalov\\u00fd pr\\u016fvodce[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Hrajte demoverze:[\\\/b] Naje\\u010fte my\\u0161\\u00ed na libovolnou hru, kter\\u00e1 V\\u00e1m padne do oka, a bez dal\\u0161\\u00edch prodlev dostanete tla\\u010d\\u00edtko pro nainstalov\\u00e1n\\u00ed jej\\u00ed bezplatn\\u00e9 demoverze. Zkuste jednu. Nebo t\\u0159eba sto! \\n\\n[b]P\\u0159id\\u00e1vejte si favority do seznamu p\\u0159\\u00e1n\\u00ed:[\\\/b] Narazili jste na hru, u n\\u00ed\\u017e byste r\\u00e1di dostali echo, a\\u017e vyjde v pln\\u00e9 verzi? Naje\\u010fte na ni my\\u0161\\u00ed a v prav\\u00e9m horn\\u00edm rohu vyskakovac\\u00edho ok\\u00e9nka klikn\\u011bte na ikonku s hv\\u011bzdou. Hra bude p\\u0159id\\u00e1na do Va\\u0161eho seznamu p\\u0159\\u00e1n\\u00ed, a jakmile ji v\\u00fdvoj\\u00e1\\u0159i vypust\\u00ed do sv\\u011bta, budete promptn\\u011b informov\\u00e1ni e-mailem.\\n\\n[b]Podle \\u010deho jsou \\u0159azeny hry?[\\\/b]\\nV\\u011bt\\u0161ina sekc\\u00ed festivalu je do za\\u010d\\u00e1tku \\u0159azena n\\u00e1hodn\\u011b. Poznatky z prvn\\u00edch p\\u00e1r dn\\u016f jsou pot\\u00e9 od st\\u0159edy pou\\u017eity pro lep\\u0161\\u00ed doporu\\u010dov\\u00e1n\\u00ed podle z\\u00e1jm\\u016f jednotliv\\u00fdch n\\u00e1v\\u0161t\\u011bvn\\u00edk\\u016f festivalu.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Cum participi la Festivalul Next[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Joac\\u0103 demouri:[\\\/b] deplaseaz\\u0103 cursorul deasupra oric\\u0103rui joc, iar un buton de instalare pentru versiunea demo va ap\\u0103rea imediat. \\u00cencearc\\u0103 unul! Sau mai multe. \\n\\n[b]Adaug\\u0103 jocurile preferate \\u00een lista de dorin\\u021be:[\\\/b] ai g\\u0103sit un joc care-\\u021bi place \\u0219i vrei s\\u0103 afli c\\u00e2nd va fi lansat? Deplaseaz\\u0103 cursorul deasupra jocului dorit \\u0219i apas\\u0103 pictograma \\u00een form\\u0103 de stea aflat\\u0103 \\u00een partea dreapt\\u0103 sus pentru a-l ad\\u0103uga \\u00een lista ta de dorin\\u021be. De \\u00eendat\\u0103 ce acesta va fi lansat, vei primi prin e-mail o notificare elegant\\u0103.\\n\\n[b]Cum este organizat Festivalul Next?[\\\/b]\\nFestivalul Next \\u00eencepe cu majoritatea sec\\u021biunilor sortate aleatoriu. Steam utilizeaz\\u0103 statisticile din primele zile ale festivalului pentru a recomanda juc\\u0103torilor titluri mai pertinente \\u00eencep\\u00e2nd de miercuri.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Next Fest'te Yap\\u0131lacaklar[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Demolar\\u0131 Oynay\\u0131n:[\\\/b] Herhangi bir oyunun \\u00fczerine geldi\\u011finiz anda oynanabilir demoyu y\\u00fcklemek i\\u00e7in bir buton g\\u00f6receksiniz. Hadi birini deneyin! Ya da onlarcas\\u0131n\\u0131. \\n\\n[b]Favorilerinizi \\u0130stek Listesine Ekleyin:[\\\/b] \\u00c7\\u0131kt\\u0131\\u011f\\u0131 zaman haberdar olmak istedi\\u011finiz bir oyun mu buldunuz? Herhangi bir oyunun \\u00fczerine gelin ve istek listenize eklemek i\\u00e7in sa\\u011f \\u00fcst k\\u00f6\\u015fedeki y\\u0131ld\\u0131z simgesine t\\u0131klay\\u0131n. O oyun \\u00e7\\u0131kt\\u0131\\u011f\\u0131nda, size \\u015f\\u0131k bir e-posta bildirimi g\\u00f6nderilir.\\n\\n[b]Next Fest nas\\u0131l bir d\\u00fczene sahip?[\\\/b]\\nNext Fest ba\\u015flad\\u0131\\u011f\\u0131nda \\u00e7o\\u011fu b\\u00f6l\\u00fcm rastgele s\\u0131ralan\\u0131r. Steam, festivalin ilk birka\\u00e7 g\\u00fcn\\u00fcnden edindi\\u011fi verilerle \\u00c7ar\\u015famba g\\u00fcn\\u00fcnden itibaren oyunculara daha iyi oyun \\u00f6nerileri sunar.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]Como participar do Steam Vem A\\u00ed[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]Jogue demonstra\\u00e7\\u00f5es:[\\\/b] ao passar o cursor do mouse sobre qualquer jogo, voc\\u00ea imediatamente encontrar\\u00e1 um bot\\u00e3o para instalar a demonstra\\u00e7\\u00e3o jog\\u00e1vel. Experimente uma delas! Ou umas dez. \\n\\n[b]Adicione os seus favoritos \\u00e0 lista de desejos:[\\\/b] achou um jogo e quer ficar por dentro do seu lan\\u00e7amento? Passe o cursor sobre qualquer jogo e clique no \\u00edcone de estrela no canto superior direito para adicion\\u00e1-lo \\u00e0 sua lista de desejos. Voc\\u00ea receber\\u00e1 um e-mail elegante quando o jogo for lan\\u00e7ado.\\n\\n[b]Como o Steam Vem A\\u00ed \\u00e9 organizado?[\\\/b]\\nO Steam Vem A\\u00ed come\\u00e7a ordenando aleatoriamente os jogos na maioria das se\\u00e7\\u00f5es. A partir de quarta-feira, o Steam usa as estat\\u00edsticas dos primeiros dias para melhor recomendar jogos aos usu\\u00e1rios.\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]\\u041a\\u0430\\u043a \\u0434\\u0430 \\u0443\\u0447\\u0430\\u0441\\u0442\\u0432\\u0430\\u0442\\u0435 \\u0432 \\u201eSteam \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u0430 \\u043d\\u0430 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u043e\\u044f\\u0449\\u0438\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0438\\u201c[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]\\u041f\\u0443\\u0441\\u043a\\u0430\\u0439\\u0442\\u0435 \\u0434\\u0435\\u043c\\u043e\\u0442\\u0430[\\\/b] \\u2014 \\u0437\\u0430\\u0434\\u0440\\u044a\\u0436\\u0442\\u0435 \\u043a\\u0443\\u0440\\u0441\\u043e\\u0440\\u0430 \\u043d\\u0430 \\u043c\\u0438\\u0448\\u043a\\u0430\\u0442\\u0430 \\u0441\\u0438 \\u0432\\u044a\\u0440\\u0445\\u0443 \\u043a\\u043e\\u044f\\u0442\\u043e \\u0438 \\u0434\\u0430 \\u0435 \\u0438\\u0433\\u0440\\u0430 \\u0438 \\u0432\\u0435\\u0434\\u043d\\u0430\\u0433\\u0430 \\u0449\\u0435 \\u043e\\u0442\\u043a\\u0440\\u0438\\u0435\\u0442\\u0435 \\u0431\\u0443\\u0442\\u043e\\u043d \\u0437\\u0430 \\u0438\\u043d\\u0441\\u0442\\u0430\\u043b\\u0438\\u0440\\u0430\\u043d\\u0435 \\u043d\\u0430 \\u0433\\u043e\\u0442\\u043e\\u0432\\u043e \\u0437\\u0430 \\u043f\\u0443\\u0441\\u043a\\u0430\\u043d\\u0435 \\u0434\\u0435\\u043c\\u043e. \\u0418\\u0437\\u043f\\u0440\\u043e\\u0431\\u0432\\u0430\\u0439\\u0442\\u0435 \\u043d\\u044f\\u043a\\u043e\\u0435! \\u0418\\u043b\\u0438 \\u0438\\u0437\\u043f\\u0440\\u043e\\u0431\\u0432\\u0430\\u0439\\u0442\\u0435 \\u0446\\u044f\\u043b\\u0430 \\u0434\\u0443\\u0437\\u0438\\u043d\\u0430. \\n\\n[b]\\u0414\\u043e\\u0431\\u0430\\u0432\\u0435\\u0442\\u0435 \\u043b\\u044e\\u0431\\u0438\\u043c\\u0438\\u0442\\u0435 \\u0441\\u0438 \\u043a\\u044a\\u043c \\u0441\\u043f\\u0438\\u0441\\u044a\\u043a\\u0430 \\u0441 \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f[\\\/b] \\u2014 \\u043e\\u0442\\u043a\\u0440\\u0438\\u043b\\u0438 \\u0441\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0430, \\u0437\\u0430 \\u0447\\u0438\\u0435\\u0442\\u043e \\u043f\\u0443\\u0441\\u043a\\u0430\\u043d\\u0435 \\u0438\\u0441\\u043a\\u0430\\u0442\\u0435 \\u0434\\u0430 \\u0431\\u044a\\u0434\\u0435\\u0442\\u0435 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0438\\u0440\\u0430\\u043d\\u0438? \\u0417\\u0430\\u0434\\u0440\\u044a\\u0436\\u0442\\u0435 \\u043a\\u0443\\u0440\\u0441\\u043e\\u0440\\u0430 \\u043d\\u0430 \\u043c\\u0438\\u0448\\u043a\\u0430\\u0442\\u0430 \\u0441\\u0438 \\u0432\\u044a\\u0440\\u0445\\u0443 \\u043a\\u043e\\u044f\\u0442\\u043e \\u0438 \\u0434\\u0430 \\u0435 \\u0438\\u0433\\u0440\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043a\\u043d\\u0435\\u0442\\u0435 \\u0432\\u044a\\u0440\\u0445\\u0443 \\u0438\\u043a\\u043e\\u043d\\u0430\\u0442\\u0430 \\u0432\\u044a\\u0432 \\u0444\\u043e\\u0440\\u043c\\u0430 \\u043d\\u0430 \\u0437\\u0432\\u0435\\u0437\\u0434\\u0430 \\u0432 \\u0433\\u043e\\u0440\\u043d\\u0438\\u044f \\u0434\\u0435\\u0441\\u0435\\u043d \\u044a\\u0433\\u044a\\u043b, \\u0437\\u0430 \\u0434\\u0430 \\u044f \\u0434\\u043e\\u0431\\u0430\\u0432\\u0438\\u0442\\u0435 \\u043a\\u044a\\u043c \\u0441\\u0432\\u043e\\u044f \\u0441\\u043f\\u0438\\u0441\\u044a\\u043a \\u0441 \\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u044f. \\u0429\\u0435 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442\\u0435 \\u0438\\u0437\\u043f\\u0438\\u043f\\u0430\\u043d\\u043e \\u0438\\u0437\\u0432\\u0435\\u0441\\u0442\\u0438\\u0435 \\u043f\\u043e \\u0435-\\u043f\\u043e\\u0449\\u0430, \\u043a\\u043e\\u0433\\u0430\\u0442\\u043e \\u0438\\u0433\\u0440\\u0430\\u0442\\u0430 \\u0431\\u044a\\u0434\\u0435 \\u043f\\u0443\\u0431\\u043b\\u0438\\u043a\\u0443\\u0432\\u0430\\u043d\\u0430.\\n\\n[b]\\u041a\\u0430\\u043a \\u0435 \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0438\\u0440\\u0430\\u043d \\u201eSteam \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u0430 \\u043d\\u0430 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u043e\\u044f\\u0449\\u0438\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0438\\u201c?[\\\/b]\\n\\u201eSteam \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u044a\\u0442 \\u043d\\u0430 \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u043e\\u044f\\u0449\\u0438\\u0442\\u0435 \\u0438\\u0433\\u0440\\u0438\\u201c \\u0441\\u0442\\u0430\\u0440\\u0442\\u0438\\u0440\\u0430 \\u0441 \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435\\u0442\\u043e \\u0441\\u0435\\u043a\\u0446\\u0438\\u0438, \\u0441\\u043e\\u0440\\u0442\\u0438\\u0440\\u0430\\u043d\\u0438 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u043b\\u043d\\u043e. Steam \\u0438\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430 \\u0442\\u043e\\u0432\\u0430, \\u043a\\u043e\\u0435\\u0442\\u043e \\u043d\\u0430\\u0443\\u0447\\u0430\\u0432\\u0430 \\u043f\\u0440\\u0435\\u0437 \\u043f\\u044a\\u0440\\u0432\\u0438\\u0442\\u0435 \\u043d\\u044f\\u043a\\u043e\\u043b\\u043a\\u043e \\u0434\\u043d\\u0438 \\u043d\\u0430 \\u0444\\u0435\\u0441\\u0442\\u0438\\u0432\\u0430\\u043b\\u0430, \\u0437\\u0430 \\u0434\\u0430 \\u043f\\u0440\\u0435\\u043f\\u043e\\u0440\\u044a\\u0447\\u0430 \\u043f\\u043e-\\u0434\\u043e\\u0431\\u0440\\u0435 \\u0438\\u0433\\u0440\\u0438 \\u043d\\u0430 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0438\\u0442\\u0435\\u043b\\u0438\\u0442\\u0435 \\u043e\\u0442 \\u0441\\u0440\\u044f\\u0434\\u0430 \\u043d\\u0430\\u0441\\u0435\\u0442\\u043d\\u0435..\\n\\n[\\\/classname]\\n\\n[\\\/classname]\&quot;,\&quot;[classname=EventDescCont]\\n\\n[classname=EventDescTitle]\\u039f\\u03b4\\u03b7\\u03b3\\u03af\\u03b5\\u03c2 \\u0393\\u03b9\\u03bf\\u03c1\\u03c4\\u03ae\\u03c2 \\u0395\\u03c0\\u03b5\\u03c1\\u03c7\\u03cc\\u03bc\\u03b5\\u03bd\\u03c9\\u03bd[\\\/classname]\\n\\n[classname=EventDescText]\\n[b]\\
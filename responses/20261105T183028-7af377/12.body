							var StoreDefaults = {"PartnerEventStore":[{"gid":"710039599284486957","clan_steamid":"103582791475495512","event_name":"Starlight Farm v0.4.0 The Old Farm, Redrawn","event_type":14,"appid":4317160,"server_address":null,"server_password":null,"rtime32_start_time":1793840040,"rtime32_end_time":1793844001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"151f03ed65b98cf4683471185fbd2a57a634d2ea.png\",null,null,null,\"8411f33e44f1577bc241b256753a5936904f915b.png\",null,\"c2f5539ee31d81c7327473af0ee749e3c05c0714.png\",null,\"ae73625a137db08b65c65a7b02bc320f37a328f1.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"710039599284486958","clanid":"45974104","posterid":"0","headline":"Starlight Farm v0.4.0 The Old Farm, Redrawn","posttime":1793840097,"updatetime":1793840201,"body":"This update redraws the whole Old Farm and gives the farmer a new look with all-new animations.\n\n[img]{STEAM_CLAN_IMAGE}\/45974104\/20b3916ac60dab1a8d13833549fce87e266fe7ae.png[\/img]\n\n[h2]A New Old Farm[\/h2]\n\n[list]\n[*]The farm map has been redrawn: the farmhouse, restaurant, market stalls, wooden bridge, river and jetty now have much more detailed pixel art.\n[*]Smoke rises from the farmhouse chimney, trees and bushes sway in the breeze, and fish glide through the river beneath gentle ripples.\n[*]The field is now three plots: one large plot to the north and two smaller plots to the south, with a path between them. The seed chest stands where the paths meet, closer to your crops. The three plots have 66 tiles in total.\n[*]Tilled soil now matches the field and blends in at the edges, like furrows dug into the plot. Watered soil turns darker.\n[*]Carrots, turnips and pumpkins have new art, and root crops sit half buried in the soil. The other crops keep their current look for now and will be updated over time.\n[\/list]\n\n[img]{STEAM_CLAN_IMAGE}\/45974104\/e9487b0c6f21e30e17692167d2152a0c68553cb8.png[\/img]\n\n[h2]The Farmer's New Look[\/h2]\n\n[list]\n[*]The farmer has been redrawn, with new standing and walking animations in all four directions.\n[*]Hoeing, watering, digging and harvesting are all new. The farmer now looks down at the soil while working, and holds up a freshly pulled carrot for a closer look.\n[*]Watering and harvesting are a little slower so you can see them clearly.\n[\/list]\n\n[img]https:\/\/clan.fastly.steamstatic.com\/images\/45974104\/dc36d1255b6ba129d49f631e2338413ecea45d9f.gif[\/img]\n\n[h2]Old Saves Are Converted Automatically[\/h2]\n\n[list]\n[*]When you load an old save, your tilled soil, watered tiles and crops move into the new plots in order.\n[*]The old field had 18 more tiles than the new one. Crops that no longer fit are not lost: ripe crops become their harvest and growing crops return as seeds. They are placed on the path below the seed chest, so just walk over to pick them up.\n[*]After loading, the farmer stands in front of the farmhouse.\n[\/list]\n\nRiverbend residents and other areas keep their current art for now, and we will update them step by step. If you get stuck on the new farm, walk through a fence or the river, or find crops missing from an old save, please report it in the Steam discussions or player QQ group 1130310468. Telling us where it happened and your game version will help us investigate.","commentcount":0,"tags":["mod_reviewed","ModAct_487176015_1793840221_0"],"language":0,"hidden":0,"forum_topic_id":"565924411208752346","event_gid":"710039599284486957","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565924411208752346","rtime32_last_modified":1793868281,"news_post_gid":"0","rtime_mod_reviewed":1793840221,"featured_app_tagid":0,"referenced_appids":[],"build_id":26446298,"build_branch":"","unlisted":0,"rtime_created":1793839996,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"562544805318584200","gidfeature2":"565924411208752346"},{"gid":"710038961706239789","clan_steamid":"103582791475495512","event_name":"Starlight Farm v0.3.2 Controller Support and Plaza Lights","event_type":13,"appid":4317160,"server_address":null,"server_password":null,"rtime32_start_time":1793336460,"rtime32_end_time":1793341801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"97f506e2efe2f821eeffc707aebafe7b013a51ee.png\",null,null,null,\"4dad589b455fe95d23d2baeaa36feee6272b1872.png\",null,\"43c6bcb1b6c1858bec9dfa2823ca036d38f79f1f.png\",null,\"a76c2f83c954dce03d54fa6ffec24d62470b0081.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"710038961706239790","clanid":"45974104","posterid":"0","headline":"Starlight Farm v0.3.2 Controller Support and Plaza Lights","posttime":1793336494,"updatetime":1793336494,"body":"This update completes controller support and lights up the Riverbend plaza at night.\n\n[h2]Controller Support[\/h2]\n\n[list]\n[*]LB \/ RB cycle bag slots (Q \/ E on the keyboard), and both can be rebound in the controls settings.\n[*]The journal, conversations, shop, chest and pause menu now select their first option when opened: move with the D-pad or left stick, press A to confirm and B to go back or close.\n[*]In the chest, select a slot with the controller: A moves the whole stack and Y moves one item. The item description appears for the selected slot.\n[*]Button prompts follow the device you used last, showing A, X and so on with a controller and F, Space and so on with a keyboard.\n[*]Stick names in the controls settings now use language-neutral symbols, fixing Chinese text that appeared in English, Russian and Korean.\n[\/list]\n\n[h2]Plaza Lights and the Evacuation Bell[\/h2]\n\n[list]\n[*]Riverbend plaza lamps gradually light up at dusk, cast a warm glow through the night and go out at dawn.\n[*]The evacuation bell on the plaza is now a brass bell.\n[\/list]\n\nThank you to the player who asked about controller support in the Steam discussions. If a button does not respond or a menu cannot be selected on your controller, please report it in the Steam discussions or player QQ group 1130310468. Your controller model, the location and your game version will help us investigate.","commentcount":0,"tags":["mod_reviewed","ModAct_1911576989_1793337975_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630633085","event_gid":"710038961706239789","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630633085","rtime32_last_modified":1793337975,"news_post_gid":"0","rtime_mod_reviewed":1793337975,"featured_app_tagid":0,"referenced_appids":[],"build_id":26315020,"build_branch":"","unlisted":0,"rtime_created":1793335314,"votes_up":0,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"562544805318584200","gidfeature2":"565923773630633085"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["710039599284486958","710038961706239790"],"last_update_event":{"rtime":1793840040,"event_gid":"710039599284486957","announcement_gid":"710039599284486958","clan_account_id":45974104}}};
						</script>
					


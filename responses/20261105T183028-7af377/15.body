ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"685267895163289994","clanid":"46016749","posterid":"0","headline":"We have a Giveaway for you!","posttime":1792020519,"updatetime":1792020519,"body":"[h1]We have a Giveaway for you! [\/h1][p][\/p][h3] Would you like a Game Key from the new game \u201cThe Crimson Hunt\u201d?[\/h3][p] We have 3 keys for giveaway right now.  [\/p][p][\/p][h3]How to participate?  The only thing you MUST do is to answer ONE QUESTION in this newsletter:  [\/h3][p]What is the most interesting thing about The Crimson Hunt for you?  And that\u2019s it!   [\/p][p][\/p][p]*The winners will be announced on November 1st, and we will post them in Farelas (dev)\u2019s newsletter on Steam. [\/p][list][*][p]We will communicate with the winners by DM from one of the following Steam accounts:[\/p][\/*][\/list][p] .- Cyntia - aerinartemisa ([url=\"https:\/\/steamcommunity.com\/profiles\/76561198872372191\/\"]https:\/\/steamcommunity.com\/profiles\/76561198872372191\/[\/url]) [\/p][p].- Jeanine - Rapshela ([url=\"https:\/\/steamcommunity.com\/profiles\/76561198078733456\"]https:\/\/steamcommunity.com\/profiles\/76561198078733456[\/url])  [\/p][p][\/p][p]Good luck! Espada & Ballesta TCH Narrative Team  [\/p][p]Linktree with all our social media & portfolio: [url=\"https:\/\/linktr.ee\/espadayballesta\"]linktr.ee\/espadayballesta[\/url][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46016749\/dcaa037b377a05f0e48ff8e7299600318e5594a5.png\"][\/img][\/p]","commentcount":68,"tags":["mod_reviewed","ModAct_487176015_1792022280_0"],"language":0,"hidden":0,"forum_topic_id":"573803804384930245","event_gid":"685267895163289993","voteupcount":85,"votedowncount":5,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573803804384930245","rtime32_last_modified":1793827842,"news_post_gid":"0","rtime_mod_reviewed":1792022280,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792019077,"votes_up":85,"votes_down":5,"comment_type":"ForumTopic","gidfeature":"657107714318559415","gidfeature2":"573803804384930245"},{"gid":"674010802265522187","clan_steamid":"103582791475538157","event_name":"Complete Save System Overhaul & Major Bug Fixes","event_type":12,"appid":4485020,"server_address":null,"server_password":null,"rtime32_start_time":1793756880,"rtime32_end_time":1793761201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"674010802265522188","clanid":"46016749","posterid":"0","headline":"Complete Save System Overhaul & Major Bug Fixes","posttime":1793756895,"updatetime":1793756967,"body":"[h1]Patch Notes \u2013 Complete Save System Overhaul & Major Bug Fixes[\/h1][p]\nThis update introduces a [b]complete overhaul of the game's save system[\/b], along with several important bug fixes, performance improvements, and a new language!\n\n[\/p][h2]Complete Save System Overhaul[\/h2][p]\n- [b]Completely rebuilt the game's save system from the ground up. [\/b]This new system is designed to finally address long-standing issues involving duplicated items, missing inventory items, and objects disappearing from storage chests.\n- Reworked several core systems to improve save reliability, prevent inventory-related bugs, and improve overall game performance.\n- Fixed issues where certain objects would fail to appear correctly after loading a saved game.\n\n[\/p][h3]Important Notice \u2013 Previous Save Files[\/h3][p]\n[b]I strongly recommend starting a new game after installing this update.[\/b]\n\nUnfortunately, rebuilding the save system required significant changes to several core parts of the game's code. As a result, [b]save files created before this update may no longer work correctly and could cause serious progression issues.[\/b]\n\nIf you prefer not to start over, you can try continuing your existing save, but I recommend following these precautions:\n\n- Continue progressing forward through the game without revisiting previously completed areas.\n- Avoid returning to earlier levels or attempting to collect items you've already picked up.\n- Try to follow the main story path without backtracking, as revisiting previous areas may cause unexpected issues.\n\nThese precautions may help you continue your existing playthrough, but **compatibility with older save files cannot be guaranteed.**\n\n[\/p][h2]Gameplay & General Improvements[\/h2][p]\n- [b]Finally fixed the throne interaction bug! [\/b]Characters will no longer slide sideways when sitting on the throne. This silly little issue had been around for far too long, and I'm happy to finally have it fixed!\n- Fixed additional bugs and softlocks that could prevent players from progressing naturally through the game.\n- Improved enemy and companion AI behavior.\n- Made lighting and visual adjustments across several areas to improve the overall atmosphere.\n- Additional bug fixes, optimizations, and gameplay refinements.\n\n[b]New Language \u2013 Turkish![\/b]\n\n- [b]Turkish language support has been added![\/b] Thanks to the incredible support and contribution of a member of this community, Turkish-speaking players can now enjoy the game in their own language.\n\nThis was made possible thanks to the efforts of [url=\"https:\/\/steamcommunity.com\/profiles\/76561198258999186\"]Samet H\u00fcseyin ERDO\u011eAN[\/url] and his friend Kerem \u00dcN, who voluntarily translated the game's texts. Let's applaud their heroic efforts!\n\n\nNow, let's listen to Samet, who wants to reach out to Turkish society:\n\n\n[\/p][h3]Dear Turkish Gaming Community![\/h3][p]\n[i]Hello everybody! Today I want to share with you a very exciting development. Recently, I discovered a game called The Crimson Hunt on Steam. I thought this great game should have Turkish language support, and I immediately took action on this matter.\n\nI reached out to the game's developer, dear Farelas, and submitted my proposal to translate the game into Turkish. He responded positively to my proposal and expressed gratitude for this step.\n\nI do not claim that this translation is entirely professional or error-free. I translated it with the utmost care, but I know that minor errors may occur. This is exactly where I need your help! I kindly request that you share with me any translation errors you encounter while playing the game or any suggestions you may have. Thanks to the feedback we receive from you, we will be able to further improve and update the Turkish language support.\n\nOn this occasion, I would like to make an appeal to the entire Turkish Gaming Community: Come, let's take concrete steps to bring Turkish language support to other games we love together! I have contacted the producers of more than 150 games so far, but unfortunately most of them have been reckless (I have received 4 positive feedback, but they told me to wait because the development phase of the games is still ongoing.) Perhaps we can make a stronger impact by combining these efforts of ours\n\nI hope you enjoy the Turkish translation of The Crimson Hunt and that you will help us make it better with your feedback.\n\nI will publish the Turkish text on my own Steam page. Do not add this, brother.\n\nSevgili T\u00fcrk Oyun Toplulu\u011fu![\/i]\n\n---\n\nThank you all for your continued patience, support, and bug reports. Rebuilding such an important system has been a major undertaking, but I truly hope this update will finally put an end to many of the frustrating inventory and save-related issues you've experienced.\n\nAs always, I'll continue working to improve **The Crimson Hunt** and make the experience better with every update.\n\n[b]Thank you for being part of this journey![\/b][\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1751692459_1793757209_0"],"language":0,"hidden":0,"forum_topic_id":"570428010838110885","event_gid":"674010802265522187","voteupcount":22,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570428010838110885","rtime32_last_modified":1793841347,"news_post_gid":"0","rtime_mod_reviewed":1793757209,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793756895,"votes_up":22,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"657107714318559415","gidfeature2":"570428010838110885"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["674010164693567600","685267895163289994"],"last_update_event":{"rtime":1793756880,"event_gid":"674010802265522187","announcement_gid":"674010802265522188","clan_account_id":46016749}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<h2 class="bb_tag" ><strong>Synopsis</strong></h2><p class="bb_paragraph" >In a world where old legends have been forgotten, the hunter Victoria works in the shadows, eliminating the last remnants of the vampire bloodlines.</p><p class="bb_paragraph" >One night, she receives a new mission: infiltrate a secluded Victorian mansion deep in the woods and rescue a young woman named Eleanor, kidnapped by an ancient vampire who has awakened once more. Upon arrival, Victoria discovers the mansion is far more than a simple refuge — it is a sanctuary of darkness, infested with vampires, ghouls, and bloodthirsty creatures.</p><p class="bb_paragraph" >Eleanor, weakened but determined, manages to escape her cell and crosses paths with Victoria, forming a fragile and uneasy alliance. Together, they must survive, push through decaying corridors, solve ancient mechanisms, and confront the horrors lurking in every corner.</p><p class="bb_paragraph" >Explore oppressive environments, solve environmental puzzles, and carefully manage your resources: ammunition is scarce, light is vital, and every encounter matters. Combine a variety of weapons and tools to adapt to unpredictable enemies, or team up in local split-screen co-op to face the horror together.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Survive. Cooperate. Uncover the truth.</strong></p><h2 class="bb_tag" ><strong>Key Features</strong></h2><h2 class="bb_tag" ><strong>Modernized Classic Survival Horror</strong></h2><p class="bb_paragraph" >Explore dark, oppressive environments where danger may hide around every corner. Constant tension and vulnerability are at the heart of the experience.</p><h2 class="bb_tag" ><strong>Third-Person Combat</strong></h2><p class="bb_paragraph" >Face grotesque creatures using a variety of weapons and tools. Every enemy encounter demands strategy, positioning, and steady nerves.</p><h2 class="bb_tag" ><strong>Character-Driven Narrative</strong></h2><p class="bb_paragraph" >A story centered on the evolving relationship between its protagonists, where choices, the past, and emotional tension grow alongside the danger.</p><h2 class="bb_tag" ><strong>Local Split-Screen Co-op</strong></h2><p class="bb_paragraph" >Experience the full journey with another player. Coordinate strategies, share resources, and face the horror as a team.</p><h2 class="bb_tag" ><strong>Environment-Driven Puzzles</strong></h2><p class="bb_paragraph" >Solve environmental and mechanical puzzles to progress. Observation, logic, and exploration are essential.</p><h2 class="bb_tag" ><strong>Resource Management</strong></h2><p class="bb_paragraph" >Ammunition is limited, healing is scarce, and every item counts. Smart inventory management can mean the difference between life and death.</p>						</div>
					</div>
					<div class="game_page_autocollapse">
		<div id="game_area_content_descriptors" class="game_area_description">

,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"719044892364374647","clanid":"46178041","posterid":"0","headline":"War Footing is now Live!","posttime":1792066044,"updatetime":1792066044,"body":"[p]War Footing has now released on Steam! We're excited for everyone to have a chance to play.[\/p][p][\/p][p]Here's a list of updates since the latest demo version: \n\nV0.9.7[\/p][list][*][p]Updated events; stopped some from firing when it doesn't make sense[\/p][\/*][*][p]Added new events[\/p][\/*][*][p]Fixed how unit specializations work to offer better specializations for air units and fix bugs in ground units[\/p][\/*][*][p]Updated tutorial and manual[\/p][\/*][*][p]Fixed a bug where dug-in bonuses were not applying to armor[\/p][\/*][*][p]Added a new, harder version of the Cold War Gone Hot scenario[\/p][\/*][\/list][list][*][p]V0.9.8[\/p][list][*][p]Fixed a bug where helicopters' anti-armor fire wasn't calculated on the unit tally screen[\/p][\/*][*][p]Decreased tank effectiveness vs. infantry[\/p][\/*][*][p]Increased tank maintenance costs[\/p][\/*][*][p]Added more interesting AI behavior with committing reserves to more concentrated attacks[\/p][\/*][*][p]Fixed a bug that disguised the true number of needed vehicles[\/p][\/*][*][p]Fixed a bug that prevented air-to-ground missions from working correctly in some cases[\/p][\/*][\/list][\/*][*][p]V1.0.0[\/p][list][*][p]Fixed a bug related to UI scaling[\/p][\/*][*][p]Changed Balance on Air Menace scenario[\/p][\/*][*][p]Added extra detail on the unit tally screen to show armor penetration and soft attack comparison[\/p][\/*][\/list][\/*][\/list][p][\/p][p]If you're enjoying the game, please leave a review as it really helps us out! Very soon, we'll start getting ready for the post-launch V1.1 free content update. [\/p]","commentcount":7,"tags":["mod_reviewed","ModAct_773020726_1792068542_0"],"language":0,"hidden":0,"forum_topic_id":"573803804384978102","event_gid":"719044892364374646","voteupcount":41,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573803804384978102","rtime32_last_modified":1793615009,"news_post_gid":"0","rtime_mod_reviewed":1792068542,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792065963,"votes_up":41,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568164159307520100","gidfeature2":"573803804384978102"},{"gid":"681882585105697615","clan_steamid":"103582791475699449","event_name":"War Footing Release Date + Roadmap","event_type":16,"appid":4727860,"server_address":null,"server_password":null,"rtime32_start_time":1785026820,"rtime32_end_time":1785031201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Coming on October 15!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"3110e3e2989792b670411961dd78e73e30ca77c0.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"681882585105697616","clanid":"46178041","posterid":"0","headline":"War Footing Release Date + Roadmap","posttime":1785026829,"updatetime":1785026829,"body":"[h1]Roadmap, Upcoming Updates, & Release Date[\/h1][p]\n \nThe demo is now live, and we appreciate all of the feedback that we've gotten so far. Looking at the statistics so far - how many people have wishlisted the game, how much people have played the demo - it's truly humbling to see people excited about and enjoying something we've created. Most of the feedback has been really positive, but one theme that has emerged is that players find the economy\/income system to be lacking compared to the rest of the game.[\/p][p]\n \nWhich leads to the next announcement - [b]The Economy Update[\/b]. This will ship with the full release. This update will add a significant amount of depth to the economy\/income part of the game. The player's overall income will increase as it now has to be split between:\n \n[\/p][list][*][p][b]Procurement & Capital Funds[\/b] - which functions like current use of money\n[\/p][\/*][*][p][b]Industrial Investment[\/b] - turn-by-turn investment in increasing industrial capacity\n[\/p][\/*][*][p][b]Homefront[\/b] - Investment in this category will improve stability and result in additional recruits\n[\/p][\/*][*][p][b]Diplomacy[\/b] - Investment in diplomacy will determine how many envoys you have. You can no longer pay to increase relations faster with a country, but you can also stack more than one envoy on a country to improve relations faster.\n[\/p][\/*][\/list][p] \n[b]Two other major changes:[\/b]\n \n[\/p][list][*][p] The \"[b]Lobby[\/b]\" button is gone. The game is being rebalanced to run without it. Starting income has been adjusted to roughly match what aggressive lobbying would have done before, no more clicking.\n[\/p][\/*][*][p] Arms deals can now be paid for over time. Longer terms carry higher interest rates, but can allow you to place larger orders even if you can't pay for them now.\n[\/p][\/*][\/list][p] \n[\/p][hr][\/hr][h2] Roadmap:[\/h2][h2][img src=\"{STEAM_CLAN_IMAGE}\/46178041\/45330408fc58aee588bdac57820eefe32093066d.png\"][\/img]\n[\/h2][h2]Release Date:[\/h2][p] \nWar Footing will be fully released on [b]October 15[\/b]! This is pushed back slightly compared to our original September target to give us extra time to balance the economy update.\n \nBut that's not the end. After release, we have two more items coming in [b]Q4 2026[\/b]:\n \n[\/p][list][*][p][b]V1.1 Update[\/b]: This update will be free to all players. It will include at least one new feature (still to be announced) and at least one new scenario. It will also contain any needed polish, bug fixes, and balance changes.\n[\/p][\/*][*][p][b]DLC[\/b]: The DLC will feature 3 new nations, and at least 3 new scenarios. We're not ready to announce details yet, but we plan to shortly after release.\n[\/p][\/*][\/list][p] \nAfter this, we'll take stock of where the game is. We'll be listening to player feedback, as always, and looking at where the game can go next.\n \n[\/p][hr][\/hr][p] \nWe're hard at work getting the game ready for release. Feel free to leave comments here, or join our official subreddit at r\/warfooting.[\/p]","commentcount":7,"tags":["mod_reviewed","ModAct_1519738978_1785027224_0"],"language":0,"hidden":0,"forum_topic_id":"589559079513434216","event_gid":"681882585105697615","voteupcount":42,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"589559079513434216","rtime32_last_modified":1792664225,"news_post_gid":"0","rtime_mod_reviewed":1785027226,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1785024105,"votes_up":42,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568164159307520100","gidfeature2":"589559079513434216"},{"gid":"681891464032029495","clan_steamid":"103582791475699449","event_name":"1.0.2 Beta Now Available","event_type":12,"appid":4727860,"server_address":null,"server_password":null,"rtime32_start_time":1793673840,"rtime32_end_time":1793678401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Reduces viability of infantry only builds\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"681891464032029496","clanid":"46178041","posterid":"0","headline":"1.0.2 Beta Now Available","posttime":1793673845,"updatetime":1793673845,"body":"[p]After some development and testing, I'm now ready to push v1.0.2 out for beta! This is a big update and I'd like to let the community test it for a bit before moving it to the default branch. You'll have to manually switch to the beta branch to test it. [\/p][p][\/p][p]At a high level, it makes helicopters behave in a more balanced way, and significantly decreases the effectiveness of infantry operating without armored vehicle support. After this update, I'll focus on the 1.1 update which will introduce a new feature and have some additional content. [\/p][p][\/p][p]Here are the full patch notes:[\/p][p][\/p][list][*][p]V1.0.2[\/p][list][*][p]Fixed bug: Helicopters were not engaging each other properly[\/p][\/*][*][p]Fixed bug: Anti-air attacks against helicopters were being undercounted[\/p][\/*][*][p]Doctrine update:[\/p][list][*][p]Mass assault now gives -10% damage multiplier, +50 recruits per turn, and +10% boot camp throughput, +10% production capacity[\/p][\/*][*][p]Hi-Tech Integration: fixed a bug that prevented damage increase from applying to attack helicopters[\/p][\/*][*][p]Prepared Defenses: -10% casualties from anti-personnel fire, and +5 armor for all vehicles[\/p][\/*][*][p]Elite Training: Reduced the training speed penalty[\/p][\/*][*][p]Armored Spearhead: +15% soft attack for all armored vehicles, +10% hard attack for tanks, and -10% hard and soft attack for infantry[\/p][\/*][*][p]Deep Operations renamed Sustained Operations. +50% per-turn readiness recovery.[\/p][\/*][\/list][\/*][*][p]Change: Increased effectiveness of MANPADS against helicopters and scaled it more appropriately to equipment capability[\/p][\/*][*][p]Change: Made high-end air defense systems (like Patriot) less effective against helicopters[\/p][\/*][*][p]Infantry rebalance: Garrison units were far too powerful and APCs were underpowered. Ideally garrison units will still retain a role for situations where the player has high manpower, but will be less effective as a main force.[\/p][list][*][p]Increased lethality of soft attack damage[\/p][\/*][*][p]Increased screening effect of tanks & IFVs[\/p][\/*][*][p]Gave tanks a bonus to soft attack damage when no enemy tanks are present[\/p][\/*][*][p]Reduced number of crew casualties for destroyed IFVs[\/p][\/*][*][p]Reduced artillery allocation for garrison units[\/p][\/*][*][p]Reduced readiness cap for garrison units[\/p][\/*][\/list][\/*][*][p]Increased the penalty for losing an adjacent sector[\/p][\/*][*][p]Decreased IFV cost[\/p][\/*][*][p]Fixed a bug that overwrote old campaigns when starting a new one[\/p][\/*][*][p]New Equipment:[\/p][list][*][p]Germany: Panzerfaust 3[\/p][\/*][*][p]France: 105mm & 155mm towed artillery + CAESAR mobile artillery[\/p][\/*][*][p]Brazil: 120mm heavy mortar[\/p][\/*][\/list][\/*][*][p]Change: Special Forces School now required to raise SOF units, not deploy them[\/p][\/*][*][p]Fixed Bug: Tooltips sometimes displaying under other UI items[\/p][\/*][*][p]Change: Standardized naming for armor & mechanized units[\/p][\/*][*][p]Change: Can right click on budget sliders to lock them in place[\/p][\/*][*][p]Fixed Bug: Fixed an edge case where the enemy sector being full of helicopters + SAMs soft-locks progress[\/p][\/*][*][p]Change: Increased the readiness penalty for having too few tanks + IFVs in a formation that requires them[\/p][\/*][\/list][\/*][\/list]","commentcount":6,"tags":["patchnotes","mod_reviewed","ModAct_1896160435_1793673922_0"],"language":0,"hidden":0,"forum_topic_id":"570427687923143319","event_gid":"681891464032029495","voteupcount":25,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570427687923143319","rtime32_last_modified":1793849689,"news_post_gid":"0","rtime_mod_reviewed":1793673922,"featured_app_tagid":0,"referenced_appids":[],"build_id":26395747,"build_branch":"1.0.2_beta","unlisted":0,"rtime_created":1793673756,"votes_up":25,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568164159307520100","gidfeature2":"570427687923143319"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["719044892364374647","681882585105697616"],"last_update_event":{"rtime":1793673840,"event_gid":"681891464032029495","announcement_gid":"681891464032029496","clan_account_id":46178041}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras/1d5b1cfa23a183d000a0ef0cfe01f984.avif?t=1792065570" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras_big/1d5b1cfa23a183d000a0ef0cfe01f984.webp?t=1792065570 width=1560 height=260 /></span></p><p class="bb_paragraph" >War Footing is a turn-based strategy game that puts you at the highest level of military command to mobilize a nation for defense rather than lead troops on the field. 8 scenarios offer distinct starting conditions, resource constraints, and enemy configurations.</p><h2 class="bb_tag" ><strong>THE NATION'S EXISTENCE IS UP TO YOU</strong></h2><p class="bb_paragraph" >You are the Minister of Defense. You control the budget, the procurement contracts, the political relationships, and the force structure. Whether the army that meets the enemy is ready is entirely down to the decisions you make before the first shot is fired.</p><p class="bb_paragraph" >Each turn represents a week. You'll spend them sourcing equipment from foreign suppliers or your own domestic industry, training and assigning units, and managing political stability to keep the budget flowing. When the invasion begins, the army you built is the army you fight with.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras/47cbe74ce33c110b869ae6d7c260fb6e.avif?t=1792065570" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras_big/47cbe74ce33c110b869ae6d7c260fb6e.webp?t=1792065570 width=1560 height=260 /></span></p><h2 class="bb_tag" ><strong> FROM DOCTRINE TO EQUIPMENT TO DEPLOYMENT</strong></h2><p class="bb_paragraph" >Raise and outfit units from company to brigade level. Over 180 equipment types — small arms, armor, artillery, aircraft, and air defense systems — each with distinct trade-offs in cost, capability, and availability.</p><h2 class="bb_tag" ><strong>MANAGE DOMESTIC &amp; FOREIGN POLITICS</strong></h2><p class="bb_paragraph" >Military spending doesn't happen in a vacuum. Diplomatic obligations and political stability compete for the same resources. Ignoring them has consequences.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras/6c68514fa1c4bbc077e738fb5d9e2abf.avif?t=1792065570" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4727860/extras_big/6c68514fa1c4bbc077e738fb5d9e2abf.webp?t=1792065570 width=1560 height=260 /></span></p><h2 class="bb_tag" ><strong>LEAD FROM THE TOP</strong></h2><p class="bb_paragraph" >Battles resolve at the operational level - sector by sector, week by week. Outcomes depend on what you built: unit readiness, doctrine fit, equipment quality, and where you chose to deploy. A complex combat simulation rewards having combined arms and knowing your enemy.</p>						</div>
					</div>

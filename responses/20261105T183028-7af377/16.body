0\/ac6de7d68c5e2d036ea5a0efbeac886898243a1c\/ss_ac6de7d68c5e2d036ea5a0efbeac886898243a1c.1920x1080.jpg?t=1793757156"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/d89b0b3a7e29fca2b9720efb1f63399403f0695c\/ss_d89b0b3a7e29fca2b9720efb1f63399403f0695c.600x338.jpg?t=1793757156","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/d89b0b3a7e29fca2b9720efb1f63399403f0695c\/ss_d89b0b3a7e29fca2b9720efb1f63399403f0695c.1920x1080.jpg?t=1793757156"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/b1e16dba396b7f99eff3597593f39b7b47bc65b3\/ss_b1e16dba396b7f99eff3597593f39b7b47bc65b3.600x338.jpg?t=1793757156","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/b1e16dba396b7f99eff3597593f39b7b47bc65b3\/ss_b1e16dba396b7f99eff3597593f39b7b47bc65b3.1920x1080.jpg?t=1793757156"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/40262d41fc7771e457be950c12c6cf0f3e8eb920\/ss_40262d41fc7771e457be950c12c6cf0f3e8eb920.600x338.jpg?t=1793757156","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/40262d41fc7771e457be950c12c6cf0f3e8eb920\/ss_40262d41fc7771e457be950c12c6cf0f3e8eb920.1920x1080.jpg?t=1793757156"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/2f74a0d6f8c831b0e390c0146f4b0e77909b2264\/ss_2f74a0d6f8c831b0e390c0146f4b0e77909b2264.600x338.jpg?t=1793757156","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/2f74a0d6f8c831b0e390c0146f4b0e77909b2264\/ss_2f74a0d6f8c831b0e390c0146f4b0e77909b2264.1920x1080.jpg?t=1793757156"},{"id":14,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4485020\/c410ba418331031c071510d6377afab9c973b53d\/ss_c410
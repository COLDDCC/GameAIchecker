																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"699905862545703408","clan_steamid":"103582791475747512","event_name":"EA SPORTS FC\u2122 27 | Gameplay Developer Notes - October","event_type":28,"appid":4080220,"server_address":null,"server_password":null,"rtime32_start_time":1793204460,"rtime32_end_time":1793208060,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"255adf013a01bf00f29338c70a80aa55536bde33.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"d39c041460941e53629dbdc3adb1af17f559db55.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"699905862545703409","clanid":"46226104","posterid":"0","headline":"EA SPORTS FC\u2122 27 | Gameplay Developer Notes - October","posttime":1793204485,"updatetime":1793204485,"body":"[p][\/p][p align=\"start\"][img src=\"https:\/\/drop-assets.ea.com\/images\/38XJb63IW6PU8F7xCBodtF\/317dbfaeff7bec805a87e4efdbd4d551\/fc27-october-gameplay-dev-notes-feat-img.jpg?im=AspectCrop=%2816,9%29,xPosition=0.5,yPosition=0.5\" style=\"box-sizing: border-box; display: block; max-width: 100%; max-height: 100%; object-fit: contain; height: 451.125px; width: 802px;\"][\/img][\/p][p align=\"start\"]Since the worldwide launch of EA SPORTS FC\u2122 27, we've been keeping a close watch on your match data to see how you are playing the new game, as well as following discussions on [url=\"https:\/\/discord.gg\/easportsfc\"]Discord[\/url], our [url=\"https:\/\/www.ea.com\/games\/ea-sports-fc\/fc-27\/features\/fc-27-feedback\"]Feedback Portal[\/url], the [url=\"https:\/\/forums.ea.com\/category\/fc-27-en\"]EA Forums[\/url], and various social media channels. We want to thank everyone who's taken to the pitch so far, and shared what they have been experiencing there.[\/p][p align=\"start\"]As we've reviewed a month's worth of in-game data and community insights, we've been able to identify some key trends that show how gameplay has evolved so far. This, combined with extensive testing and feedback from our Design Council, has helped to inform the approach we'll take to updating gameplay in FC 27.[\/p][p align=\"start\"]In these Developer Notes, we will walk you through these findings and share what you can expect from our first set of gameplay balance updates, arriving in an upcoming November Title Update.[b]\n[\/b][\/p][h2]How Gameplay Has Evolved in FC 27[\/h2][p align=\"start\"]As we shared with you in our [url=\"https:\/\/www.ea.com\/games\/ea-sports-fc\/fc-27\/news\/fc-27-closed-beta-feedback-update\"]Closed Beta[\/url] and [url=\"https:\/\/www.ea.com\/games\/ea-sports-fc\/fc-27\/news\/fc-27-gameplay-developer-launch-update\"]Gameplay Launch Update[\/url], this year we wanted to preserve the FC 27 launch gameplay experience to give players time to adapt to new mechanics. Because of that, we've avoided making any early gameplay updates, which marks a new approach for us compared to previous years.[\/p][p align=\"start\"]Now that one month has passed since launch, our data shows several notable changes in how you've been playing in FC 27:[\/p][p align=\"start\"][b]More Accurate Shooting[\/b][\/p][list][*][p]Players are becoming more effective in front of goal, taking fewer shots overall but scoring more of the opportunities they create.[\/p][\/*][\/list][p align=\"start\"][b]More Efficient Passing[\/b][\/p][list][*][p]Players are completing a higher percentage of their passes, despite making slightly fewer passes overall and manually-controlled defenders intercepting slightly more often.[\/p][\/*][*][p]This shows players are adapting to the new balance of passing and interceptions by playing more patiently and picking the right moments to pass the ball.[\/p][\/*][\/list][p align=\"start\"][b]More Successful Defending[\/b][\/p][list][*][p]We're seeing an increase in successful tackles as players become more familiar with defensive mechanics that put more emphasis on manual defending in FC 27.[\/p][\/*][\/list][p align=\"start\"][b]More Tactical Diversity[\/b][\/p][list][*][p]We're seeing players try a wider number of different tactical set ups compared to FC 26 and more variety in player roles by positions. Our data shows us that win rates by formation are evenly distributed with minimal variance.[\/p][\/*][*][p]Since launch, we've seen the most popular formations change, as players have experimented with what works for their particular styles, and have also developed counters to popular tactics.[\/p][\/*][*][p]There are formations that are more popular, especially in the higher divisions of play, and we are closely monitoring this space as we see new formations start to become more widely used in response.[\/p][\/*][\/list][p align=\"start\"]Together, these trends help us see the shape of gameplay in FC 27, and most importantly highlight the distinct ways players are engaging with the game this year. Players are more efficient, more patient, and more willing to experiment, which are all positive signs.[\/p][p align=\"start\"]After this first month with all of you in the game, these patterns of play are stable enough that we can clearly understand how the game is being played and where we can make targeted refinements to tuning without unintentionally affecting other areas of gameplay.[\/p][h2]\nWhat's Coming Next For FC 27 Gameplay[\/h2][p align=\"start\"]Our next Title Update in mid-November will introduce our first set of gameplay balance changes for FC 27. But before we dive into the details, we want to share some important context on how our team approaches gameplay balance.[\/p][p align=\"start\"]FC gameplay has a lot of moving parts and balance changes are rarely a simple ON & OFF switch. The adjustments in this update are subtle and targeted, designed to reduce how often more \"frustrating\" moments happen in-game. However, it is important to note that in a fast paced 11v11 game where player movement, ball physics, and collisions all interact, some unexpected outcomes will still happen occasionally, and reducing these outcomes remains a key focus for our Gameplay Team.[\/p][p align=\"start\"]Additionally, we also look at how players play differently depending on their Rivals Division or the mode they choose. Something that happens regularly in Division 7 might happen much less frequently in Division 3. This means one single change might not work perfectly for everyone which can result in feedback that goes in opposite directions.[\/p][p align=\"start\"]For example, we received feedback from some players who felt that through passes feel more rewarding in FC 27, while others prefer the passing mechanics from previous FC games. We also see ongoing discussions where some players prefer having more manual control over defending, while others prefer more active assistance from their AI-controlled teammates.[\/p][p align=\"start\"]Our team makes sure to look at different preferences alongside our data to try to find the best solution. Each adjustment also undergoes extensive playtesting and reviews with our Design Council to ensure we're making targeted improvements in the right areas.[\/p][p align=\"start\"]With that in mind, here is a breakdown of what we're focusing on for Title Update v1.2.0.[\/p][p align=\"start\"][b]Fullback Positioning[\/b][\/p][p align=\"start\"]We've observed situations where Fullbacks would drop too deep while defending, causing issues with defensive structure and unintentionally keeping attackers onside.[\/p][p align=\"start\"]With this update, Fullbacks will hold their defensive line more consistently, moving to track runs when there's a genuine attacking threat. As mentioned earlier, this behaviour may still occur occasionally, but overall consistency has been noticeably improved.[\/p][p align=\"start\"][b]Offside Awareness[\/b][\/p][p align=\"start\"]Alongside the improvements to Fullback positioning, we've refined attacking awareness to help attackers better recognise the defensive line and make more effective runs to stay onside.[\/p][p align=\"start\"][b]Attacking AI Improvements[\/b][\/p][p align=\"start\"]We've seen some situations where AI-controlled attackers don't always make decisive runs into available space, particularly around the penalty area.[\/p][p align=\"start\"]We've made further improvements to attacking AI, helping players make more purposeful supporting runs and better use the space around the box.[\/p][p align=\"start\"][b]Kick-Off Goal Reduction[\/b][\/p][p align=\"start\"]We've identified situations where the defensive line would drop too deep following kick-off, making it difficult to defend against attacks progressing directly towards goal.[\/p][p align=\"start\"]With this update, the defensive line will hold a higher position after kick-off. This should make it more difficult for opponents to progress directly into the box without facing defensive pressure.[\/p][p align=\"start\"][b]Loose Ball Switching Improvements[\/b][\/p][p align=\"start\"]We've also identified several situations where auto player switching doesn't select the player closest to the ball as expected.[\/p][p align=\"start\"]We've made a series of targeted fixes to improve player selection in specific situations, including after a teammate completes a slide tackle, following a headed pass, and after a shot misses the target. These changes aim to make switching feel more consistent and predictable in these moments.\n[\/p][h2]Ongoing Investigations[\/h2][p align=\"start\"]While Title Update v1.2.0 is an important first step, refining gameplay balance is an ongoing process, and one we'll continue working on with you throughout the year. Now that we've analyzed several weeks of live gameplay data, we are in a better position to evaluate where future adjustments might make sense. Our focus still remains on long-term stability and will only deploy updates in line with our commitment to review and test on an ongoing basis.[\/p][p align=\"start\"]Here are some of the key areas we're actively working on:[\/p][list][*][p]Situations where high defensive lines can put too much pressure on the opposition[\/p][\/*][*][p]Looking at how collisions between players of different sizes and physical attributes are handled[\/p][\/*][*][p]Assessing the accuracy of specific shot types alongside goalkeeper positioning.[\/p][\/*][\/list][p align=\"start\"]These areas require careful investigation and testing. Changes to one gameplay system can have an impact on others, so we will be deliberate before deciding the level of adjustment needed.\n[\/p][h2]We Want To Hear From You[\/h2][p align=\"start\"]Thank you for all the feedback and daily discussions throughout the first month of EA SPORTS FC\u2122 27. This feedback plays a huge part in how we prioritise gameplay tuning across the year and we are constantly working on ways to improve this dialogue.[\/p][p align=\"start\"]We'll be hosting a Live Discord Q&A on [b]October 30th at 4:30PM GMT \/ 9:30AM PT[\/b] with our gameplay development team to answer your questions directly. In the meantime, jump into the conversation and submit your questions and feedback in our official Discord server: [\/p][p][url=\"http:\/\/discord.gg\/easportsfc\"]http:\/\/discord.gg\/easportsfc[\/url][\/p][p align=\"start\"][\/p]","commentcount":14,"tags":["mod_reviewed","ModAct_1894963720_1793210495_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630463210","event_gid":"699905862545703408","voteupcount":80,"votedowncount":20,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630463210","rtime32_last_modified":1793326453,"news_post_gid":"0","rtime_mod_reviewed":1793210496,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793204335,"votes_up":80,"votes_down":20,"comment_type":"ForumTopic","gidfeature":"588432892837917691","gidfeature2":"565923773630463210"},{"gid":"701031128264350045","clan_steamid":"103582791475747512","event_name":"EA SPORTS FC\u2122 27 | Title Update v1.1.0","event_type":13,"appid":4080220,"server_address":null,"server_password":null,"rtime32_start_time":1793100900,"rtime32_end_time":1793106001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"fcfc90f45c9a5197b870427d1629973171f2bc00.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"f59f21b4109d652f3418b08ba501a4d41c8d005e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"701031128264350046","clanid":"46226104","posterid":"0","headline":"EA SPORTS FC\u2122 27 | Title Update v1.1.0","posttime":1793100935,"updatetime":1793101500,"body":"[p][\/p][p align=\"start\"][img src=\"https:\/\/drop-assets.ea.com\/images\/2alE34aQsIm81dXlHa5Nbc\/dcfed901d23a399ae232e1c32909ef3a\/fc27-patch-notes-v1.1.png?im=AspectCrop=%2816,9%29,xPosition=0.5,yPosition=0.5\" style=\"box-sizing: border-box; display: block; max-width: 100%; max-height: 100%; object-fit: contain; height: 451.125px; width: 802px;\"][\/img][\/p][p align=\"start\"]EA SPORTS FC 27 version 1.1.0 is now live and includes the updates below. There are no gameplay balance and tuning changes in this update.\n[\/p][h2]Gameplay[\/h2][p align=\"start\"]Addressed the following issues:\u00a0[\/p][list][*][p]In some cases, players could become stuck during the game opening tutorial.[\/p][\/*][*][p]\\[PC Only] If using a mouse and keyboard and playing as a Goal Keeper, the mouse could become unresponsive if moved too far outside of the penalty box.\n[\/p][\/*][\/list][h2]Ultimate Team[\/h2][p align=\"start\"]Made the following changes:[\/p][list][*][p]Streamlined SBCs filters will save previously applied filters when completing multiple Streamlined SBCs in the same session.[\/p][\/*][*][p]Reduced the duration of the pack opening sequence.[\/p][\/*][\/list][p align=\"start\"]Addressed the following issues:\u00a0[\/p][list][*][p]SBC Storage Player Items that were submitted into Simplified SBCs could still temporarily appear for when completing other SBCs.[\/p][\/*][*][p]In certain cases when previewing Pathway Evolutions, the incorrect stats could appear highlighted in green.[\/p][\/*][*][p]National flags could appear incorrectly for Holographic Player Items while in gameplay.\u00a0[\/p][\/*][*][p]The FUT Badge icon could be displayed incorrectly on the scoreboard.[\/p][\/*][*][p]The Time of Day setting would not save properly when changed from the Ultimate Team Menu.[\/p][\/*][*][p]Opponent\u2019s Player Items could appear incorrectly during the match intro when using certain formations.\u00a0[\/p][\/*][*][p]Goal net colours could not be previewed.[\/p][\/*][*][p]Equipped goal net colours were not appearing in gameplay.[\/p][\/*][*][p]Under specific circumstances, when completing an SBC players could receive an error when accessing the Club tab from the Squad Screen.[\/p][\/*][*][p]When converting a Loan Player into a Concept Player, a freeze could have occurred in certain situations.[\/p][\/*][*][p]The Gallery UI could be shown as having S rank sets complete when no S ranks have yet been completed.[\/p][\/*][*][p]In some cases, players may have seen their opponent's equipped ball, net color, and pitch line color during Ultimate Team matches instead of their own selected items.\u00a0[\/p][\/*][*][p]The Rank 1-200 Icon and Description could show incorrectly in the Squad Battles Preview screen.\u00a0[\/p][\/*][*][p]The tradeable UI indicator was missing from the display of packs within the Premium Season Pass.[\/p][\/*][*][p]\\[PC ONLY] In some areas of Ultimate Team, mouse click would not work on certain menu options.[\/p][\/*][*][p]Notifications for unclaimed objective rewards from The Grounds were showing in Ultimate Team.[\/p][\/*][*][p]When earning multiple tokens, the notification pop-up could show an incorrect value.[\/p][\/*][*][p]This was a visual only issue.[\/p][\/*][*][p]When viewing a locked objective group, the counter would show as 0\/\u200c0 instead of displaying the amount of objectives in that group.[\/p][\/*][*][p]Regrading a set multiple times in The Gallery could cause the grading animation to overlap.\u00a0[\/p][\/*][*][p]In certain situations when claiming Gallery rewards, if a notification for a new set is pressed while on the Show Rewards screen, players are taken to the set but are unable to back out or navigate the menus requiring a title restart.[\/p][\/*][*][p]Grades could show as lit up for incomplete sets when viewing Gallery set rewards.\u00a0[\/p][\/*][*][p]The Gallery level was not showing as intended when grading sets in certain situations.\u00a0[\/p][\/*][*][p]When navigating the Gallery in Ultimate Team, players may have experienced an issue where backing out of a selected subset, closing a Reward Preview, or exiting the Tag Glossary automatically resets the menu focus to the very first item in the list instead of keeping the previously highlighted subset selected.[\/p][\/*][*][p]When completing Gallery objectives, no notification message would be displayed.\u00a0[\/p][\/*][*][p]A menu sound effect could have triggered during matches whenever a player equipped with a Cosmetic Evolution that featured active visual effects (VFX) gained possession of the ball.[\/p][\/*][*][p]When loading into Ultimate Team, when navigating tabs on a message, this would reset to the first tab after entering Ultimate Team.\u00a0[\/p][\/*][*][p]Addressed a delay when navigating certain live messages in Ultimate Team.\u00a0[\/p][\/*][*][p]When entering Ultimate Team through the FC Hub, the News section could have been shown as blank.[\/p][\/*][*][p]In 2v2 matches, after performing a slide tackle in the goal area, players could have become stuck in the net and unable to move.[\/p][\/*][*][p]When applying an Evolution to a Goalkeeper, the upgraded stats in the preview would not be highlighted in green.[\/p][\/*][*][p]In some cases, sorting Objectives by priority displayed the Objectives in the incorrect order.\u00a0[\/p][\/*][*][p]In specific scenarios, the Transfer Market search button may have stopped working.\u00a0[\/p][\/*][*][p]In rare cases, players may have appeared incorrectly in certain overlays.[\/p][\/*][*][p]\\[PS5 ONLY] In some cases, overlays could be displayed incorrectly during penalties.\u00a0[\/p][\/*][*][p]In some cases, new tactics could be saved incorrectly and some players could be moved into the wrong positions.[\/p][\/*][*][p]Pitch line colours set in Kick Off matches would appear in Squad Battles matches.\u00a0[\/p][\/*][*][p]After viewing Help information while in Rivals, the menu navigation could disappear until you back out of the menu.[\/p][\/*][*][p]\\[PC Only] In certain situations, players are unable to navigate into a selected Gallery category when clicking on a category tile with the mouse and then pressing the Enter key on their keyboard.[\/p][\/*][*][p]The Player Overview and Multi-Swap options disappeared from the squad options after returning to the Squad screen from the Evolutions menu via the Action Wheel.\u00a0[\/p][\/*][*][p]The Rewards Breakdown screen would be displayed after a Live Event match.\u00a0\n[\/p][\/*][\/list][h2]The Grounds[\/h2][p align=\"start\"]Addressed the following issues:\u00a0[\/p][list][*][p]Addressed instances of matches partially resetting after a player joins an ongoing match after initially failing to Hot Join.[\/p][\/*][*][p]Expired Live Events could be seen in the View Live Events and Rush Stadium Menus.\u00a0[\/p][\/*][*][p]\\[PC ONLY] Key bindings could not be modified when playing on Keyboard Only.\u00a0[\/p][\/*][*][p]In some instances, players could queue for Kickabouts and Street Football outside of the intended area.\u00a0[\/p][\/*][*][p]When reaching the maximum Archetype Level, the Archetype Level would display incorrectly.\u00a0[\/p][\/*][*][p]When at the maximum Archetype Level, the Post-Match Screen would display a visual error that gave players a Match Rating of 0.[\/p][\/*][*][p]Clubs sideline referees could have a grey skin tone.[\/p][\/*][*][p]In specific circumstances, teams could have 2 goalkeepers in Clubs 11v11 Live Events.\u00a0[\/p][\/*][*][p]Players could not enter the Grounds Store from the Clubhouse.[\/p][\/*][*][p]After viewing Alex Hunter\u2019s cinematic when first entering The Grounds, no notifications were showing to highlight new objectives.[\/p][\/*][*][p]VoIP channels were being created for 1v1 modes.[\/p][\/*][*][p]Players in a party could have become stuck in an invalid matchmaking state and lost Menu functionality if the party leader left the game while queued at a Rush pitch.[\/p][\/*][*][p]In some cases, the Match Rating displayed as blank on the post match screen.[\/p][\/*][*][p]In certain situations, commentary from different world matches could overlap in The Grounds.[\/p][\/*][*][p]In certain situations, if players lose connection to the game servers while waiting in a matchmaking queue, they may remain stuck on the queue screen indefinitely without receiving a notification.[\/p][\/*][*][p]In certain situations, players may experience an infinite loading screen when attempting to join a Clubs lobby if they decline the prompt to enable cross-play.[\/p][\/*][*][p]After selecting a PlayStyle players would be brought to the Attributes tab instead of staying in the PlayStyle tab.[\/p][\/*][*][p]In certain situations, players could have become stuck and lost menu functionality if they pressed the advance button before a claimed reward was fully displayed on the screen.[\/p][\/*][*][p]Player names could remain visible on screen when transitioning into gameplay in some modes.[\/p][\/*][*][p]When checking objective progress directly through the FC Hub for the Hit 50 Street targets Objective, the progress would not show as updating.[\/p][\/*][*][p]The music player would open when rotating an Avatar in the customisation screen.\u00a0[\/p][\/*][*][p]In 1v1 matches, the Goal Keeper could hold the ball for longer than expected even if a pass had been requested.[\/p][\/*][*][p]In 1v1 matches, if the Goal Keeper was fouled, they would take the free kick in place of the player controlled character.[\/p][\/*][*][p]In certain situations, own goals could be scored when performing high powered passes in 3v3 matches.[\/p][\/*][*][p]After playing an 11v11 Live Event, the lobby could remain active if all players did not leave the previously completed match.[\/p][\/*][*][p]\\[PC ONLY] An error would be encountered when pressing Edit Emotes from the Emote Wheel.[\/p][\/*][*][p]In rare cases, audio from the Grounds world could have carried over into Grounds activities.[\/p][\/*][*][p]In Street Football, players could score free kicks without aiming.[\/p][\/*][*][p]In Bucket Ball, on rare occasions, players could get stuck in the pitch walls.\u00a0[\/p][\/*][*][p]In Bucket Ball, the ball could go through some walls during gameplay.[\/p][\/*][*][p]In Bocce Ball, newly spawned targets would not register points for balls that were already on the ground.[\/p][\/*][*][p]In some cases, players could become stuck in the FC Hub after purchasing an Amp from the Clubs Store.[\/p][\/*][*][p]The FC Hub could be accessed from the Archetypes Tab when going through the Player Profile screen.[\/p][\/*][*][p]Players were not automatically returned to the Grounds world after completing an in-world Rush match.[\/p][\/*][*][p]After winning in 3 rounds in a Classic Tournament Live Event, the round 2 match would incorrectly show the tournament win.[\/p][\/*][*][p]The notification icon did not appear on the Edit Appearance screen after unlocking certain outfits.[\/p][\/*][*][p]In some cases, the Clubhouse background did not display as intended after navigating the menus.[\/p][\/*][*][p]In some cases, items in the Grounds Store could not be previewed on the Player Avatar.\u00a0[\/p][\/*][*][p]When attempting to use an Emote in a queue area, players could be unintentionally brought to the Emotes section of the Appearance Menu.[\/p][\/*][*][p]\\[PC ONLY] Players could be disconnected for inactivity when using the mouse to navigate the Grounds Menu.[\/p][\/*][*][p]In certain situations, the Objectives tab in The Grounds menu could become unresponsive and could not be opened.[\/p][\/*][*][p]In some Live Events, if a specific Archetype was required and this was not already active, the event requirement would not be updated after making it active until another pitch was visited or re-entering The Grounds.[\/p][\/*][*][p]Accepting a party invite during a match countdown canceled the match without notifying the opponent.[\/p][\/*][*][p]If a party host cancelled a queue at the exact moment party members were accepting a Play Here with Party invitation, players could still have been teleported to the destination game site. Upon arrival, these players were unable to join the activity and would see an All Slots Full message.\n[\/p][\/*][\/list][h2]Career Mode[\/h2][p align=\"start\"]Made the following changes:[\/p][list][*][p]Two new objective types have been added to Player Career Rivalries.[\/p][\/*][*][p]Consistency Rivalries: Avoid being the first to fail an Objective.[\/p][\/*][*][p]Match Limit Rivalries: Complete Objectives within a specific time limit.[\/p][\/*][*][p]Visual updates have been made to the Team Management UI for cleaner navigation and better readability.[\/p][\/*][*][p]In Manager Career, a setting was introduced to allow for user control over having Press Conferences available or not in that save file. Additionally, two new settings were introduced, allowing control over the frequency of Press Conference interactions, as well as Unexpected Events.\u00a0[\/p][\/*][*][p]These settings, along with the existing Unexpected Events setting, are all now editable during a save file, and not only when setting up a save file.\u00a0[\/p][\/*][\/list][p align=\"start\"]Addressed the following issues:\u00a0[\/p][list][*][p]In some rare cases, in Manager Career, managers may have found themselves unable to renew contracts for existing players if the option to disable transfer market activity was selected during career creation.[\/p][\/*][*][p]In some cases, the Custom CPU AI Behavior slider settings would reset to the default value of 50 after closing and restarting the game, even though the setting was still displayed as Custom.\u00a0[\/p][\/*][*][p]In Manager Career, players may have found themselves unable to personally negotiate further after delegating a contract renewal for a squad player.[\/p][\/*][*][p]In Manager Career, when using Icon players, if more than 8 were available, no navigation option would be displayed to see the additional icons.\u00a0[\/p][\/*][*][p]In Manager Live, boots, ties and scarves were not shown as available to equip in the Avatar customisation when creating your new Avatar.[\/p][\/*][*][p]In Manager Career, promoting a youth player would take you to the squad hub instead of remaining on the current squad.[\/p][\/*][*][p]In Manager Career, players may experience an issue where they can immediately send another Enquiry to buy message for a player with a release clause, even after just receiving a not willing to sell rejection response from the club.[\/p][\/*][*][p]In Manager Career, older players could demand crucial roles in contract negotiations.\u00a0[\/p][\/*][*][p]In Manager Career, after delegating a contract renewal, the weekly desired wage could have been shown as 0.0k.[\/p][\/*][*][p]In Manager Career, when loaning a player and making a counter offer with a loan to buy clause, it was possible to get the AI club to agree to a low transfer fee for the player.\u00a0[\/p][\/*][*][p]In Player Career, refunding attributes could cause more than the intended attributes to be refunded.[\/p][\/*][*][p]In Manager Career, when adding performance bonuses during a contract negotiation, wage demands from the player could be too high.[\/p][\/*][*][p]In Manager Career, it was not possible to sort by scouting status in the shortlist.\u00a0[\/p][\/*][*][p]In Manager Career, after delegating a contract offer for a swap player, you would be directed to the buy tab instead of the sell tab.\u00a0[\/p][\/*][*][p]In Manager Career, if a club makes an offer for a player with a release clause, the task would not show correctly in the Central Hub.\u00a0[\/p][\/*][*][p]In Manager Career, it was not possible to pay the release clause for a player when attempting to buy them if they were from a rival club.[\/p][\/*][*][p]In Manager Career, after receiving a re-negotiation request from another club, that player\u2019s transfer status would display the wrong text.[\/p][\/*][*][p]In Manager Career, swap deals did not display an option to negotiate a contract with the player from the Selling tab in Active Negotiations.[\/p][\/*][*][p]In Manager Career, the icon indicating that a player is open to new contract talks was missing from the Financial tab.[\/p][\/*][*][p]In Manager Career, release clause offers from AI clubs gave managers the option to decline the offer on behalf of the player.[\/p][\/*][*][p]In Manager Career, managers were unable to offer new contracts to players in their own club who have received release clause offers from AI clubs.[\/p][\/*][*][p]Fixture times could be displayed in different timezones across different screens.\u00a0[\/p][\/*][*][p]In Manager Career, if a transfer deal expired, two different tasks could appear in the Task List.[\/p][\/*][*][p]In Manager Career, scout reports could become inaccessible after firing a scout.\u00a0[\/p][\/*][*][p]In Manager Career, players could be placed in the wrong positions in the formation after creating and saving a new tactic from the Team Management screen.[\/p][\/*][*][p]\\[PS4 & XBO ONLY] In Manager Career, in some cases, entering the Scout Report screen could cause temporary performance issues.[\/p][\/*][*][p]National Anthems were not playing during the opening cinematic of Men\u2019s International Tournament matches.[\/p][\/*][*][p]In Manager Career, when a transfer deal falls through, a detailed reason for it not falling though was not showing in the buy tab.[\/p][\/*][*][p]EA Music would not resume after some pre-match intros had finished.[\/p][\/*][*][p]In Manager Career, if a player had declined an initial contract renewal offer the options to finalize the deal or decline the renewal were not showing on subsequent offers.\u00a0[\/p][\/*][*][p]In Manager Career, the player\u2019s interest was not showing in the club contract section while viewing the shortlist.[\/p][\/*][*][p]In Manager Career, if the Club\u2019s budget is negative, a player could not be sold unless it would bring the Club\u2019s balance back into a positive value.[\/p][\/*][*][p]In Manager Career, player form could decrease after recent high match rating.\u00a0[\/p][\/*][*][p]In Manager Career, player value results from scouts were based on judgement instead of the intended experience stat.[\/p][\/*][*][p]In Manager Career, incorrect currency symbols could show in some of the menus.\u00a0[\/p][\/*][*][p]In Player Career, rivalries could be started when there were not enough matches remaining to complete the rivalry objectives.\u00a0[\/p][\/*][*][p]In Manager Career, after a scouting mission had been completed, PlayStyles were not shown for Youth Academy players.\u00a0\n[\/p][\/*][\/list][h2]General, Audio, and Visual[\/h2][p align=\"start\"]Made the following changes:\u00a0[\/p][list][*][p]Added a Claim All button in the objective screens.[\/p][\/*][*][p]Updated some kits, text, cinematics, cameras, audio, commentary, placeholder images, artwork, hair, overlays, trophies, TIFOs, starheads, particles, stadiums, lighting, ad boards, scoreboard, boots, world elements, UI elements, button callouts, logos, tops, socks and pants.[\/p][\/*][\/list][p align=\"start\"]Addressed the following issues:\u00a0[\/p][list][*][p]Addressed various stability issues that could have occurred.[\/p][\/*][*][p]In some cases, referee kit colours could be too similar to those of the teams on the pitch.\u00a0[\/p][\/*][*][p]Player Avatars under the age of 21 could not be created.[\/p][\/*][*][p]\\[PC Only] Some graphics quality settings required a restart to take effect.[\/p][\/*][*][p]Player Avatar customization did not save when accessed from the Main Menu.\u00a0[\/p][\/*][*][p]\\[PC Only] Some controllers were being detected correctly.\u00a0[\/p][\/*][*][p]\\[PC Only] When playing in Windowed mode, manually resizing the game window by dragging its edges did not update the Screen Resolution or Estimated VRAM values in the Graphics Settings menu.[\/p][\/*][*][p]When making a sub during a Kick Off match, the player name would not update on the team management screen.[\/p][\/*][*][p]In certain situations the Player Creator could experience an issue where changes made using the \"Randomize\" option on a character's head were not saved.[\/p][\/*][*][p]The icon for claimable rewards was not showing in the Season Track for unlocked rewards.\u00a0[\/p][\/*][*][p]Addressed an issue that could cause parts of some boots to have a glowing effect.\u00a0[\/p][\/*][*][p]Only up to 5 Player Roles could be displayed in the Team Management screen.\u00a0[\/p][\/*][*][p]\\[PC ONLY] Visual issues could occur when entering matches on ultrawide displays.\u00a0[\/p][\/*][*][p]Some audio elements could be lost after pausing in the game opening tutorial.\u00a0[\/p][\/*][*][p]The EA SPORTS\u2122 Music Widget could automatically close while it was in use.\u00a0[\/p][\/*][*][p]In certain situations, when a second profile is trying to link their profile in Kick Off, they could get stuck on the linking screen requiring a title restart.[\/p][\/*][*][p]The main menu carousel did not directly respond to Left Stick inputs after enabling the Right Stick Remap option in Accessibility Settings.[\/p][\/*][*][p]The Ball Trail Colour was not showing in the Accessibility Settings.[\/p][\/*][*][p]Saved head presets were missing some facial details after saving and attempting to use one in new player creation.[\/p][\/*][*][p]Flags were not showing as intended in the leaderboards for Co-Op Seasons.\u00a0[\/p][\/*][*][p]When attempting to overwrite a created player preset, the existing presets may not have appeared.[\/p][\/*][*][p]\\[PC Only] When using borderless mode and frame rate limiting, if the active monitor was changed, the frame rate limit was not applied as intended.[\/p][\/*][*][p]\\[PC Only] When using borderless mode, it was not possible to change the resolution or aspect ratio.[\/p][\/*][*][p]\\[PC Only] When changing the refresh rate, no revert timer would show to reset any unaccepted changes.\u00a0\n[\/p][\/*][\/list][h3]Share your Feedback[\/h3][p align=\"start\"]Want to provide us direct feedback about EA SPORTS FC 27? [\/p][p][url=\"https:\/\/go.ea.com\/fc27_pfp\"]https:\/\/go.ea.com\/fc27_pfp[\/url][\/p][p align=\"start\"] and let us know what you think, it only takes a few minutes.[\/p][p align=\"start\"]Throughout the course of the EA SPORTS FC 27 season, we'll provide you with more information and updates if and when they become available. Be sure to follow [u][url=\"https:\/\/x.com\/EASFCDirect\"]@\u200cEASFCDIRECT[\/url][\/u] on X or WhatsApp, check out the [u][url=\"https:\/\/t.co\/c95AED2oI4\"]EA SPORTS FC Tracker,[\/url][\/u] and join the [u][url=\"http:\/\/discord.gg\/easportsfc\"]EA SPORTS FC Discord[\/url][\/u] for the latest news and updates.[\/p][p align=\"start\"]-The EA SPORTS FC Team[\/p]","commentcount":40,"tags":["mod_reviewed","ModAct_1415716708_1793103412_0"],"language":0,"hidden":0,"forum_topic_id":"563671928222522497","event_gid":"701031128264350045","voteupcount":230,"votedowncount":50,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"563671928222522497","rtime32_last_modified":1793329622,"news_post_gid":"0","rtime_mod_reviewed":1793103412,"featured_app_tagid":0,"referenced_appids":[],"build_id":26128477,"build_branch":"","unlisted":0,"rtime_created":1793017772,"votes_up":230,"votes_down":50,"comment_type":"ForumTopic","gidfeature":"588432892837917691","gidfeature2":"563671928222522497"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["699905862545703409","701031128264350046"],"last_update_event":{"rtime":1793100900,"event_gid":"701031128264350045","announcement_gid":"701031128264350046","clan_account_id":46226104}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>EA SPORTS FC™ 27 Editions</h2>				<p><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4080220/extras/a792cc1ecbd14fc1904b8546ad555454.avif?t=1790973254" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4080220/extras_big/a792cc1ecbd14fc1904b8546ad555454.avif?t=1790973254 width=1560 height=1986 /></span><br></p>
			</div>
						<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>EA SPORTS FC™ 27 Ultimate Edition</h2>				<p><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4080220/extras/56d655401ab9cc3fe4cbd42b79ac5e38.avif?t=1790973254" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4080220/extras_big/56d655401ab9cc3fe4cbd42b79ac5e38.avif?t=1790973254 width=1560 height=880 /></span><br><br>EA SPORTS FC™ 27 Ultimate Edition includes:<br><br><ul class="bb_ul"><li>6,000 FC Points over 3 months††<br></li><li>Additional FUT™ Player Evo slot</li></ul><br>Career content:<br><ul class="bb_ul"><li>3 ICONs/Heroes<br></li><li>5-Star Senior Scout in Manager Career<br></li><li>5-Star Coach available for hire in Manager Career<br></li><li>5-Star Youth Scout available for hire in Manager Career<br></li><li>5 Manager Live Challenge Creation Slots</li></ul><br>The Grounds content:<br><ul class="bb_ul"><li>The Grounds Signature Sweatsuit<br></li><li>Tier 3 Amp inspired by Mbappe<br></li><li>2 Double AXP for 10 Matches Consumables</li></ul><br>†† You must complete the steps to obtain the initial FC Points distribution by August 1, 2027 to receive all 6,000 FC Points. If you redeem after September 26, 2027, you will not receive any FC Points.</p>
			</div>
						<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>Join the Club Membership in EA SPORTS FC™ 27 for rewards ‡.</h2>				<p>Club Member benefits include new rewards across Football Ultimate Team™, Career, The Grounds and Clubs, with reward drops and Vanity items available exclusively to Club Members throughout the season. To qualify, play EA SPORTS FC™ 26 and EA SPORTS FC™ 27 before 1 November, 2026. Current Club Members from EA SPORTS FC™ 26 can maintain their status by playing EA SPORTS FC™ 27 before 1 November, 2026.<br />
</p>
			</div>
			</div>				<div id="contentForThisGame_ctn">
				</div>

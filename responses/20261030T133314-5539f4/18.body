null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"680764295532773686\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"688646229288030890","clanid":"45176549","posterid":"0","headline":"PLAYTEST - WITH THE NEW SANDBOX MODE. AND CONTEST!","posttime":1792676781,"updatetime":1792676781,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45176549\/492e2b9acb6430df2a64c61575dd51ca197385a5.jpg\"][\/img][\/p][p]We\u2019ve got something special for you![\/p][p]A brand-new playtest has just started - and yes, [b]everyone can join the open playtest of our completely new Sandbox mode right now![\/b] \ud83d\udee0\ufe0f[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3167920\/LowBudget_Repairs\/\"][\/dynamiclink][\/p][p]In Sandbox, [b]you decide how you want to renovate[\/b].[\/p][list][*][p]Choose an apartment[\/p][\/*][*][p]Choose its condition \u2014 [b]Ruin[\/b] or [b]Unfinished[\/b][\/p][\/*][*][p]Decide how much money you want to start with - including unlimited money[\/p][\/*][\/list][p][b]And then\u2026 do whatever you want with the apartment![\/b][\/p][p]You have access to [b]all tools and materials[\/b], and we\u2019ve also added a [b]new section in the hardware store with decorations and home accessories[\/b], so you can furnish and decorate your apartment however you like.[\/p][p]And if you run out of money? You\u2019ll find a [b]notice board in the yard with side jobs[\/b], where you can earn more cash for furniture, decorations, and building materials.[\/p][p][b]Main missions are completely disabled during the playtest.[\/b][\/p][p]We\u2019ve also added the long-awaited option to [b]rebind your controls in the settings[\/b]. If you didn\u2019t like one of the default keys - you can now simply assign a different one.[\/p][p][\/p][h3][b]The playtest will run until the end of the week - it will be closed on Monday October 26th[\/b][\/h3][p][\/p][h2][b]We need your feedback![\/b][\/h2][p]This playtest is here so you can get an early look at [b]what we\u2019re working on[\/b], but also so we can find out whether everything works the way it should.[\/p][p]If you run into a bug, something feels off, or you simply have some feedback - [b]please fill out the survey available in the main menu[\/b].[\/p][p]Keep in mind that this is a [b]test version[\/b]. Not everything may work perfectly yet, so we appreciate your understanding - and most importantly, your reports. [\/p][p][\/p][h2][b]What\u2019s next?[\/b][\/h2][p]Sandbox will be added [b]for free to the full version of Low-Budget Repairs[\/b] in the future, with more apartments available to renovate.[\/p][p]We\u2019re not giving you an exact date just yet - we want to make sure everything works properly first.[\/p][p][b]But one thing we can say: it\u2019s coming soon![\/b][\/p][p][\/p][h2]\ud83c\udfc6 [b]SANDBOX CONTEST![\/b][\/h2][p]And since you can finally renovate an apartment however you want\u2026 [b]we want to see what you can come up with![\/b][\/p][p]The creators of the [b]3 most interesting renovated and decorated apartments[\/b] will each receive a [b]free Low-Budget Repairs game key![\/b] \ud83c\udf81[\/p][p]To enter, post your apartment on our dedicated Discord channel:[\/p][p][\/p][p][url=\"https:\/\/discord.com\/channels\/1282966148924702740\/1562808522377404437\"]https:\/\/discord.com\/channels\/1282966148924702740\/1562808522377404437[\/url][\/p][p][\/p][p]\ud83d\udcf8 Please post [b]several screenshots in a single message[\/b], showing different rooms and angles so we can see the whole apartment.[\/p][p]Go wild, make it beautiful, make it cursed, make it truly yours.[\/p][p][b]Show us what a real handyman can do! [\/b][\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1847323374_1792676995_0"],"language":0,"hidden":0,"forum_topic_id":"564797239535577773","event_gid":"688646229288030889","voteupcount":76,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797239535577773","rtime32_last_modified":1793218621,"news_post_gid":"0","rtime_mod_reviewed":1792676996,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792673993,"votes_up":76,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"4753074677209319426","gidfeature2":"564797239535577773"},{"gid":"680764295532773686","clan_steamid":"103582791474697957","event_name":"Update 7.1 \u2013 PHYSICS, FURNITURE & MORE SAVE FIXES","event_type":13,"appid":3167920,"server_address":null,"server_password":null,"rtime32_start_time":1791983940,"rtime32_end_time":1791988201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"d0766ce2a9c4ce65d910de65c8443a2548779bc3.png\",null,null,null,null,null,null,null,null,null,null,null,\"a3a508a1c0283464512db0a24c1692f2c3b9ba77.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"573ae7fd1c629ab58997d1ae641e3b518bea2ec1.jpg\",null,null,null,null,null,null,null,null,null,null,null,\"4debcaff7571016072665204b33006222700ed80.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"706658725338808588\",\"clone_from_sale_enabled\":false,\"library_spotlight\":true}","announcement_body":{"gid":"680764295532773687","clanid":"45176549","posterid":"0","headline":"Update 7.1 \u2013 PHYSICS, FURNITURE & MORE SAVE FIXES","posttime":1791983905,"updatetime":1793023303,"body":"[p]Update 7.1 continues the changes introduced in Update 7. This time, our biggest focus was on [b]furniture physics and moving parts[\/b], including drawers, cabinet doors, windows, and household appliances.[\/p][p]We reworked a large part of how these objects behave so they should feel more natural, remain more stable, and be much less likely to suddenly jump, fall over, or fly across the room after the slightest contact.[\/p][p]We\u2019re also continuing to improve the [b]save system[\/b], especially when it comes to furniture, open drawers, windows, and side quests.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45176549\/1450c0ac718ae2478b45ea4463b81d339ae53aad.jpg\"][\/img][\/p][h3][b]Furniture Physics & Moving Parts[\/b][\/h3][p]One of the biggest changes is a rework of how [b]cabinet doors and drawers[\/b] behave. Moving parts should now react much more naturally to their surroundings.[\/p][list][*][p]Reworked how [b]cabinet doors and drawers[\/b] open and close[\/p][\/*][*][p]Made their behavior more consistent when something is blocking them[\/p][\/*][*][p]Improved the [b]weight, force, and center of mass[\/b] of many pieces of furniture and their moving parts[\/p][\/*][*][p]Opening several drawers at once should no longer make furniture tip over so easily[\/p][\/*][*][p]Reduced situations where closing a door with an object on it could make furniture [b]jump, flip, or launch across the room[\/b][\/p][\/*][*][p]Improved drawer movement distance and direction[\/p][\/*][*][p]Improved opening angles for many cabinet doors[\/p][\/*][*][p]Improved collisions between doors, drawers, and their furniture[\/p][\/*][*][p]Improved the behavior of loose drawers and cabinet doors[\/p][\/*][*][p]Improved the physics and opening behavior of several [b]fridges, washing machines, ovens, and toilets[\/b][\/p][\/*][*][p]Improved the piano lid[\/p][\/*][*][p]Improved the phone booth door[\/p][\/*][*][p]Improved the display cabinet used for collectibles[\/p][\/*][*][p]Improved collisions for short curtains[\/p][\/*][*][p]Improved several doors and windows in the player\u2019s house and other locations[\/p][\/*][*][p]The bathroom door in the player\u2019s house should no longer fall out[\/p][\/*][*][p]Fixed a mirror in one of the apartments that could fall over immediately[\/p][\/*][\/list][p][\/p][h3][b]Windows[\/b][\/h3][list][*][p]Improved window physics, collisions, and opening behavior[\/p][\/*][*][p]Single- and double-panel windows should now assemble correctly[\/p][\/*][*][p]Improved the behavior of installable windows[\/p][\/*][*][p]Fixed cases where an installable window could already be broken or misplaced when it appeared[\/p][\/*][*][p]Improved saving of window panel positions[\/p][\/*][*][p]Fixed cases where one window panel could save in an incorrect position[\/p][\/*][*][p]Improved window collisions in several locations[\/p][\/*][*][p]Leaving an object between window panels before saving should no longer break the window\u2019s position after loading[\/p][\/*][\/list][p][\/p][h3][b]Furniture Assembly & Disassembly[\/b][\/h3][list][*][p]Improved assembling furniture with moving drawers and cabinet doors[\/p][\/*][*][p]Improved assembling furniture taken out of boxes[\/p][\/*][*][p]Fixed cases where imprecisely targeting the correct part of the placement ghost could make assembly difficult[\/p][\/*][*][p]Improved disassembling objects with previously destroyed parts[\/p][\/*][*][p]Improved collisions of [b]furniture placement previews[\/b][\/p][\/*][*][p]Improved the behavior of installable objects before they are fully installed[\/p][\/*][*][p]The placement preview for the [b]Apollo[\/b] cabinet should no longer rotate and fall underground[\/p][\/*][*][p]Saving at an unusual moment during furniture assembly or disassembly should no longer break further interaction with the object[\/p][\/*][\/list][p][\/p][h3][b]Individual Furniture Fixes[\/b][\/h3][list][*][p]Fixed the [b]Apollo[\/b] cabinet \u2013 its doors should now open in the correct direction[\/p][\/*][*][p]Fixed the [b]Hercules[\/b] wardrobe \u2013 its doors and drawers should move correctly[\/p][\/*][*][p]Fixed the glass [b]Dialect[\/b] cabinet that could no longer be opened after closing it[\/p][\/*][*][p]Disassembling the [b]Dialect[\/b] wardrobe should no longer leave a single bar behind[\/p][\/*][*][p]Fixed the [b]Vistula[\/b] sink cabinet[\/p][\/*][*][p]Fixed drawers in the [b]Mark[\/b] desk in [b]Burning Problem[\/b][\/p][\/*][*][p]Improved opening, closing, and audio for the [b]Shef[\/b] oven[\/p][\/*][*][p]Fixed drawers in sink cabinets[\/p][\/*][*][p]Improved several bedside tables and kitchen cabinets[\/p][\/*][*][p]Improved the behavior of a repairable cabinet in one of the side quests[\/p][\/*][*][p]Fixed a hanging cabinet that could fall over after loading a save[\/p][\/*][*][p]Fixed the [b]Comfex[\/b] chair in [b]Sentenced to Work[\/b], which could sometimes be impossible to pick up at first[\/p][\/*][*][p]Moved an object that could block an oven in the prison[\/p][\/*][\/list][p][\/p][h3][b]Save System[\/b][\/h3][list][*][p]Improved saving the position of [b]cabinet doors and drawers[\/b][\/p][\/*][*][p]Open furniture should now remain open after loading[\/p][\/*][*][p]This includes several [b]Vistula[\/b] and [b]Mermaid[\/b] furniture pieces, as well as the [b]Fryfox[\/b] oven[\/p][\/*][*][p]Items left inside open drawers should no longer fall out after loading[\/p][\/*][*][p]Improved saving of installable windows[\/p][\/*][*][p]Improved saving the player\u2019s current location[\/p][\/*][*][p]Fixed a case where loading during a side quest could cause problems when loading locations[\/p][\/*][*][p]Improved saving of the [b]Vistula[\/b] cabinet[\/p][\/*][*][p]The prison gate should now save in the correct position[\/p][\/*][*][p]Fixed more problems caused by repeatedly saving and loading during [b]Mounting[\/b][\/p][\/*][*][p]Fixed a case where saving while a drawer was stuck could later prevent furniture from being assembled or disassembled[\/p][\/*][\/list][list][*][p]The installed window should no longer appear on the floor or at an incorrect angle after loading[\/p][\/*][*][p]The window should no longer block installing the curtain rod later in the mission[\/p][\/*][*][p]Fixed situations where saving and loading could suddenly cause furniture around the rooms to [b]explode across the room[\/b][\/p][\/*][*][p]Improved saving the position of installed windows[\/p][\/*][\/list][p][\/p][h3][b]Missions & Progression[\/b][\/h3][list][*][p]In [b]A Small Favor[\/b], saving should no longer become completely blocked if the player drives to the client before Zbyszek finishes talking[\/p][\/*][*][p]In the [b]Mr. and Mrs. Mediocre[\/b] side quest, the window should no longer start already broken[\/p][\/*][*][p]In [b]Moisture in the bathroom[\/b], tiles should no longer block the fridge from opening[\/p][\/*][*][p]In [b]Uninvited guest[\/b], the fridge can now be opened fully[\/p][\/*][*][p]In [b]Bathroom Accident[\/b], fixed a cabinet that could spawn inside a wall or fall under the map after being disassembled[\/p][\/*][*][p]In [b]The Fight for Gold[\/b], loading a save should no longer place the player inside an empty house[\/p][\/*][*][p]In [b]God bless you[\/b], an open cabinet should no longer fall over after loading[\/p][\/*][*][p]In [b]Burning Problem[\/b], we fixed the [b]Mark[\/b] desk drawers and the [b]Dialect[\/b] wardrobe[\/p][\/*][*][p]In [b]Sentenced to Work[\/b], we fixed the [b]Comfex[\/b] chair[\/p][\/*][*][p]Fixed another case where the [b]pawn shop could remain locked[\/b][\/p][\/*][\/list][p][\/p][h3][b]Collisions & Location Fixes[\/b][\/h3][list][*][p]Improved collisions across multiple side quests[\/p][\/*][*][p]Improved physics and collisions in the prison[\/p][\/*][*][p]Improved collisions in several kitchens and apartments[\/p][\/*][*][p]Fixed objects that could block interactions in incorrect places[\/p][\/*][*][p]Improved installable windows in several side quests[\/p][\/*][*][p]Fixed several objects spawning in incorrect positions at the beginning of quests[\/p][\/*][\/list][p][\/p][h3][b]Audio & Visuals[\/b][\/h3][list][*][p]Restored missing door sounds[\/p][\/*][*][p]Added a missing sound for one of the desk shelves[\/p][\/*][*][p]Fixed an audio issue when closing an oven[\/p][\/*][*][p]Fixed the outline on the doormat in the basement[\/p][\/*][*][p]Added protection against some objects completely losing their interaction outline[\/p][\/*][*][p]Improved the outline of drilled holes[\/p][\/*][*][p]Added a few minor lighting improvements in one of the side quests[\/p][\/*][\/list][p][\/p][p]Thanks for all your reports [\/p][p][\/p][p][b]We\u2019re continuing to work on more fixes and improvements. [\/b][\/p]","commentcount":15,"tags":["mod_reviewed","ModAct_1894963720_1791986964_0","ModAct_1751692459_1793024248_4"],"language":0,"hidden":0,"forum_topic_id":"567048404944909478","event_gid":"680764295532773686","voteupcount":148,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567048404944909478","rtime32_last_modified":1793330827,"news_post_gid":"0","rtime_mod_reviewed":1793024248,"featured_app_tagid":0,"referenced_appids":[],"build_id":25909049,"build_branch":"development","unlisted":0,"rtime_created":1791982030,"votes_up":148,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"4753074677209319426","gidfeature2":"567048404944909478"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["688646229288030890","680764295532773687"],"last_update_event":{"rtime":1791983940,"event_gid":"680764295532773686","announcement_gid":"680764295532773687","clan_account_id":45176549}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				



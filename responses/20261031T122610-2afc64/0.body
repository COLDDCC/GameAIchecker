				<div class="commentthread_comment_actions" >
														<a class="forum_comment_action forum_comment_action_trigger" data-tooltip-type="selector" data-tooltip-content="#forum_comment_actions_menu_568174730608310925">
					<span><i class="ico16 arrow_down"></i></span>

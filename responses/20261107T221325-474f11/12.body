\",\"h2\",null,{\"id\":\"about-h\",\"className\":\"text-[20px] font-semibold text-fg\",\"children\":\"About Sudoku Unlimited\"}],\"$undefined\"]}],[[\"$\",\"div\",null,{\"className\":\"prose-site max-w-3xl text-[15px]\",\"children\":[\"$\",\"p\",null,{\"children\":\"Sudoku Unlimited is a sudoku game set in a cozy garden. Besides classic grids it has variants with irregular regions, sum cages, arrows and thermometers, and a garden journey that runs from small 4×4 boards up to full 9×9 puzzles. You can pencil in candidates, undo moves and ask for hints that explain the deduction, and guided lessons and exercises teach solving techniques. There is a daily puzzle, a generator for fresh classic boards at several difficulty levels and a separate collection of 140 puzzles; solving unlocks scenery, board palettes, music, decorations and visitors. Two players can share one board in online co-op using a room code, or play a points contest, and a Desktop Companion Mode puts the current puzzle in a small window you can pin on top of other apps. The developer's Steam AI disclosure says Claude Code was used to create the game's code and its assets. A paid game on Steam for Windows, released 21 Oct 2026, with its interface in 32 languages.\"}]}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-1.5\",\"children\":[[\"$\",\"span\",\"sudoku\",{\"className\":\"rounded-md bg-surface-2 px-2 py-0.5 text-[12px] text-fg-muted\",\"children\":\"sudoku\"}],[\"$\",\"span\",\"logic\",{\"className\":\"rounded-md bg-surface-2 px-2 py-0.5 text-[12px] text-fg-muted\",\"children\":\"logic\"}],\"$L25\",\"$L26\",\"$L27\"]}],\"$undefined\"]]}],\"$L28\",\"$L29\",false,\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$undefined\",\"$L2e\",false,\"$L2f\",\"$L30\"]}],\"$L31\"]}]\n"])</script><script>self.__next_f.push([1,"1b:[\"$\",\"section\",null,{\"className\":\"mt-16\",\"aria-labelledby\":\"h-similar\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-3 border-b border-line pb-2\",\"children\":[[\
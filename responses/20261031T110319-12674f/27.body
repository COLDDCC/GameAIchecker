							var StoreDefaults = {"PartnerEventStore":[{"gid":"683016729753820870","clan_steamid":"103582791475779350","event_name":"\ud83c\udf89 200.000 COPIES SOLD! \u2764\ufe0f","event_type":28,"appid":5020310,"server_address":null,"server_password":null,"rtime32_start_time":1793119320,"rtime32_end_time":1793122380,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"6021f14f9a31536b34f164eb8a856e54b94e4328.png\",\"6021f14f9a31536b34f164eb8a856e54b94e4328.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ef9dad726e54b9dca8fe4fb505c63fd038349264.png\",\"ef9dad726e54b9dca8fe4fb505c63fd038349264.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016729753820871","clanid":"46257942","posterid":"0","headline":"\ud83c\udf89 200.000 COPIES SOLD! \u2764\ufe0f","posttime":1793119355,"updatetime":1793119355,"body":"[h1]Thank you![\/h1]\n\nWe just hit [b]200,000 copies sold[\/b] of [b]Dub Together[\/b], and honestly, we still can't believe it.\n\nSeeing so many people playing, laughing, and creating hilarious moments with their friends means the world to us.\n\nWhat started as a small project has grown into something we never could have imagined.\n\n[b]Thank you so much for all the support, feedback, and love you've shown the game. \u2764\ufe0f[\/b]\n\nAnd don't worry, we're not done yet! More updates and new content are on the way.\n\n[b]Here's to 200K and beyond! [\/b]\n\nMuch love,\n- Leon & Luca","commentcount":7,"tags":["mod_reviewed","ModAct_1691520782_1793120139_0"],"language":0,"hidden":0,"forum_topic_id":"574930920107180806","event_gid":"683016729753820870","voteupcount":82,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930920107180806","rtime32_last_modified":1793401245,"news_post_gid":"0","rtime_mod_reviewed":1793120140,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793118754,"votes_up":82,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"582807198746530460","gidfeature2":"574930920107180806"},{"gid":"683016729753819192","clan_steamid":"103582791475779350","event_name":"NEW GAME MODE & INGAME PROFILES ARE HERE!","event_type":14,"appid":5020310,"server_address":null,"server_password":null,"rtime32_start_time":1792960320,"rtime32_end_time":1792965601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Write topics for each other, show off your stats and badges, and style your profile\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The new Scenario mode, player profiles with stats and badges, the animated Sakura Profile Pack, plus Make Changes.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"aba1ce9cd2bcbeff5f4c2d6e4c43540a2a3b64a0.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016729753819193","clanid":"46257942","posterid":"0","headline":"NEW GAME MODE & INGAME PROFILES ARE HERE!","posttime":1792960340,"updatetime":1792960340,"body":"[h2]\ud83c\udfac New mode: Scenario[\/h2]\nEveryone writes a topic first, or rolls the dice for an idea. Then:\n[list]\n[*][b]One topic each:[\/b] you get someone else's topic and dub your clip around it. Before every clip a title card shows the topic, and afterwards you see who came up with it.\n[*][b]One topic for all:[\/b] a spinning reel picks one topic for the whole round.\n[\/list]\nThe topic stays on screen while you record. Scenario is multiplayer only, and everyone needs the latest version.\n[h2]\ud83d\udc64 Profiles[\/h2]\nClick any player in the lobby to open their profile. Your own profile is in the top right of the main menu.\n[list]\n[*]Stats: rounds played, wins, podiums, votes received and takes recorded\n[*]Badges in bronze, silver and gold for rounds, wins, votes, takes and character mode\n[*]Free profile colors\n[*]Add players as Steam friends right from their profile\n[\/list]\nThe topic stays on screen while you record. Scenario is multiplayer only, and everyone needs the latest version.\n[h2]\ud83c\udf38 Sakura Profile Pack (DLC)[\/h2]\n18 animated cosmetics inspired by Japanese art: 8 nameplates, 4 profile motifs and 6 avatar frames. Purely cosmetic, and everyone in the lobby sees them, even without the pack. Profiles, stats and badges stay free for everyone.\n[h2]\u2728 More changes[\/h2]\n[list]\n[*][b]Make changes:[\/b] after submitting, you can go back and redo lines while others are still recording\n[*]Fullscreen now switches instantly, and new players start in fullscreen\n[*]New recording layout: two clear button rows, all voice effects in one menu that shows the active effect\n[*]Joining via lobby code and lobby list is more reliable, and lobbies recover by themselves after short Steam hiccups\n[*]Clearer help when Windows or an antivirus blocks the game's video tools\n[\/list]","commentcount":11,"tags":["mod_reviewed","ModAct_487176015_1792961658_0"],"language":0,"hidden":0,"forum_topic_id":"574930637987930738","event_gid":"683016729753819192","voteupcount":75,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930637987930738","rtime32_last_modified":1793410403,"news_post_gid":"0","rtime_mod_reviewed":1792961658,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792959514,"votes_up":75,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"582807198746530460","gidfeature2":"574930637987930738"},{"gid":"683016729753819796","clan_steamid":"103582791475779350","event_name":"Quality Of Life Update for the Pack Creator","event_type":12,"appid":5020310,"server_address":null,"server_password":null,"rtime32_start_time":1793057700,"rtime32_end_time":1793062801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"f7fdf25922c8523f231fda9411a828d74a87b29f.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016729753819797","clanid":"46257942","posterid":"0","headline":"Quality Of Life Update for the Pack Creator","posttime":1793057746,"updatetime":1793057746,"body":"[h2]Pack Creator: one track per character[\/h2]\n\nYou told us the single timeline gets messy, especially when several characters talk at once. So we rebuilt it:\n[list]\n[*][b]Own track for every character:[\/b] Lines spoken at the same time now sit below each other instead of on top of each other.\n[*][b]Drag to reassign:[\/b] Drag a line into another track and it switches to that character.\n[*][b]Draw in a track:[\/b] A new line you draw in a track gets that character right away.\n[*][b]Rename in one go:[\/b] Double-click a character name to rename all of their lines. Type an existing name to merge two characters.\n[*][b]+ Character:[\/b] Adds a new track. Empty tracks can be removed with the x.\n[*][b]No character:[\/b] Lines without a character, for example after automatic line detection, wait in a red track until you drag them where they belong.\n[*][b]Lots of characters?[\/b] The timeline grows with them and scrolls when needed.\n[*]The character field now applies the name when you press Enter or click away, so lines no longer jump around while you type.\n[\/list]\n","commentcount":3,"tags":["patchnotes","mod_reviewed","ModAct_783923276_1793059100_0"],"language":0,"hidden":0,"forum_topic_id":"574930637988021516","event_gid":"683016729753819796","voteupcount":31,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930637988021516","rtime32_last_modified":1793369576,"news_post_gid":"0","rtime_mod_reviewed":1793059101,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793057447,"votes_up":31,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"582807198746530460","gidfeature2":"574930637988021516"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["683016729753820871","683016729753819193"],"last_update_event":{"rtime":1793057700,"event_gid":"683016729753819796","announcement_gid":"683016729753819797","clan_account_id":46257942}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" >In <strong>Dub Together</strong> you redub video clips together. Up to eight players speak their lines into their own microphone and turn a scene everyone knows into something completely new.</p><p class="bb_paragraph" >Once all the recordings are done the curtain goes up and you watch together what came out of it.</p><h2 class="bb_tag" >Parallel Mode: Everyone dubs the same clip</h2><p class="bb_paragraph" >Everyone gets the same clip and makes their own version of it. At the end you pick the best one.</p><p class="bb_paragraph" ><strong>1. Record</strong></p><p class="bb_paragraph" >The clip plays without the original voices. You see your text and speak it to fit the scene, line by line, without hearing what the others are making of it.</p><p class="bb_paragraph" ><strong>2. Watch</strong></p><p class="bb_paragraph" >The curtain goes up and you watch every version in turn over the original picture.</p><p class="bb_paragraph" ><strong>3. Vote</strong></p><p class="bb_paragraph" >Everyone picks a favourite. The best version goes on the podium. Afterwards every version can be saved as a video.</p><h2 class="bb_tag" >Character Mode: Everyone voices one role</h2><p class="bb_paragraph" >Instead of eight separate versions you end up with a single one that everybody worked on. Two players or more.</p><p class="bb_paragraph" ><strong>1. Assign the roles</strong></p><p class="bb_paragraph" >Every character in the clip gets one performer. Roles nobody takes keep their original voice.</p><p class="bb_paragraph" ><strong>2. Record together</strong></p><p class="bb_paragraph" >You go through the lines together. Whoever is up speaks, the others watch. That way the dialogue grows out of the conversation instead of running side by side.</p><p class="bb_paragraph" ><strong>3. Watch</strong></p><p class="bb_paragraph" >You watch your shared version in one piece and save it as a video. There is no vote here, there is only one result.</p><p class="bb_paragraph" >This goes for both modes: a recording you are not happy with, you simply do again, as long as the round timer is running.</p><h2 class="bb_tag" >Give your voice a new sound</h2><p class="bb_paragraph" >You can pick a voice effect for every single line. Turn into a squeaky voice with Chipmunk, into a villain with Monster, or make things even more absurd with Echo, Robot and Phone.</p><p class="bb_paragraph" >The effects are applied straight to your recording. On playback everyone hears exactly the version you performed.</p><p class="bb_paragraph" >A built-in noise filter removes background noise between the sentences and makes sure that simple microphones still come out clean.</p><h2 class="bb_tag" >Turn your own clips into rounds</h2><p class="bb_paragraph" >The Pack Creator turns your own videos into playable rounds.</p><p class="bb_paragraph" >Just drop a clip in and trim it down to the part you want. The spoken parts are detected automatically and the matching text is written for them. Speech, music and background sound are separated from each other, so the atmosphere of the scene stays in while you replace the voices.</p><p class="bb_paragraph" >Finally you assign a character to each line, export the pack and can play it right away.</p><h2 class="bb_tag" >Share your packs on the Steam Workshop</h2><p class="bb_paragraph" >Upload your finished packs to the Workshop with one click, or subscribe to other people's. Whatever you subscribe to shows up in your list right away, no restart needed.</p><p class="bb_paragraph" >If a player is missing the pack for the round, their game pulls it in by itself when the round starts. Nothing has to be sent back and forth.</p><h2 class="bb_tag" >For streamers and their community</h2><p class="bb_paragraph" >Connect your Twitch channel and let your chat decide along with you.</p><p class="bb_paragraph" >Viewers vote for their favourite performance with !vote or simply the number, and get to influence who wins the round. Streamer mode also hides the lobby code on screen so nobody drops into your session uninvited.</p><h2 class="bb_tag" >At a glance</h2><ul class="bb_ul"><li><p class="bb_paragraph" >Online multiplayer for up to eight players</p></li><li><p class="bb_paragraph" >Two modes: Parallel with a vote, Character with fixed roles</p></li><li><p class="bb_paragraph" >Join through the Steam friends list or with a lobby code</p></li><li><p class="bb_paragraph" >Your own voice recordings with six different voice effects</p></li><li><p class="bb_paragraph" >Automatic speech and text detection for your own clips</p></li><li><p class="bb_paragraph" >Steam Workshop for sharing and subscribing to packs</p></li><li><p class="bb_paragraph" >Twitch integration with viewer votes</p></li><li><p class="bb_paragraph" >Export the finished dub as a video</p></li><li><p class="bb_paragraph" >Light and dark theme</p></li></ul><h2 class="bb_tag" >Packs made by players</h2><p class="bb_paragraph" >Dub Together ships with a Pack Creator, and players share their packs through the</p><p class="bb_paragraph" >Steam Workshop. Those packs come from the players themselves and live on Steam's</p><p class="bb_paragraph" >servers, not on ours.</p><p class="bb_paragraph" >You may only upload material you hold the rights to. For films, shows or music by</p><p class="bb_paragraph" >others you need permission from the rights holders. If you spot a pack that does</p><p class="bb_paragraph" >not belong there, report it on its Steam page or write to <a href="mailto:support@dub-together.com">support@dub-together.com</a>.</p><p class="bb_paragraph" >We will look into it.</p><p class="bb_paragraph" >One pack ships with the game: an excerpt from Sprite Fright by Blender</p><p class="bb_paragraph" >Studio, used under CC BY 4.0.</p>						</div>
					</div>
					<div class="game_page_autocollapse">
		<div id="game_area_content_descriptors" class="game_area_description">
			<h2>AI Generated Content Disclosure</h2>
			<p>The developers describe how their game uses AI Generated Content like this:</p>
			<p><i>
					Some of the artwork in this game was made with AI image generators and edited by hand afterwards. This covers the two player characters, the logo, the menu icons and the curtain texture. The English interface texts were written with the help of a language model and reviewed afterwards. The German texts are written by hand.<br />
<br />
The bundled Pack Creator uses a speech recognition model to find the spoken parts of a video you supply yourself and turn them into the lines you read out. An AI noise filter for your microphone recordings and AI-based separation of speech and background audio work the same way. All of this runs locally on your own machine and never sends data to an external service. These models only process material you provide yourself, they do not invent content of their own, and the result stays inside your own lobby.				</i>
			</p>
					</div>
	</div>
	
				
				
					<div class="game_page_autocollapse sys_req" style="max-height: 300px;">
		<h2>System Requirements</h2>
				<div class="sysreq_contents">
							<div class="game_area_sys_req sysreq_content active" data-os="win">
											<div class="game_area_sys_req_leftCol">
							<ul>

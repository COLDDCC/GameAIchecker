com\/store_item_assets\/steam\/apps\/5053820\/05f346d353c2c713fe9ce335d5bbdb2dfd499836\/page_bg_raw.jpg?t=1789831835","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"l","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"0","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"igrs":{"rating_generated":"1","rating":"3","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""}}}}}
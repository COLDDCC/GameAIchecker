																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"686393795070133427","clan_steamid":"103582791474975192","event_name":"Sunday Patch 1","event_type":13,"appid":1486940,"server_address":null,"server_password":null,"rtime32_start_time":1792405740,"rtime32_end_time":1792409401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"well it was supposed to be Sunday but now is Monday :D\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"eeda4115a400c7063e5771762b39292a768682d1.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"74fb09164581f8008d224b0c410413419d0b39c4.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"686393795070133428","clanid":"45453784","posterid":"0","headline":"Sunday Patch 1","posttime":1792405786,"updatetime":1792439177,"body":"[p]Hey![\/p][p]With the help of many players on Discord\/Steam Forum, who consistently reported any kind of easy-to-fix issue, I've worked hard since Friday to bring this update out by Sunday (almoooost made it)[\/p][p]It should fix most of the issues the game had and make the game less confusing as a by-product ;D[\/p][p]This morning, I also started making screenshots and writing an in-game guide\/tutorial, it's not in this patch yet but I will work on it tonight after IRL work and should come out tomorrow (Tuesday).[\/p][p]Your v37.21 save might work on v37.22 after migration, but I only tested it on a few saves, so for the best experience I'd just create a new one. [\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/2a5965ffeaf257c6d4abe64db7d3c7ca916d3186.png\"][\/img][\/p][list][*][p][b]Storage[\/b]: Now you can choose what kind of item the liquid tanks store: clean water, dirty water, methane, LOX and oil. This fixes the issue where dirty water basically always made ur tanks full which broke the production.\n[img src=\"{STEAM_CLAN_IMAGE}\/45453784\/c1894023c341c4b25445a51fd5cb0bfa59bf42d6.png\"][\/img][\/p][\/*][\/list][list][*][p][b]New Payload Tags[\/b]: Destination and Deadline now both have an icon instead of text. When hovering with your mouse over any of those tags, the game will now hint you what you can do with that information. This also fixes the UI overlapping issue on that panel :)\n[img src=\"{STEAM_CLAN_IMAGE}\/45453784\/1bbdf48874c5052851a2403db1201bb9c7678bdd.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/955153269afa0b26d59268e8d8b523600648ad62.png\"][\/img][\/p][\/*][\/list][list][*][p]Added new settings: HQ water, atmosphere fog, trees, rocks, satellites, rocket sound distance. This simple change now lets the game run much faster even on slower GPUs![\/p][\/*][*][p]Added quarries to the Moon as well (but didn't change the icons yet as they all need new ones smh smh)[\/p][\/*][*][p][b]Return to Main Menu[\/b]: It was always in the project but I had it disabled because this \"simple\" feature is very hard to maintain and most of the EarthX1 bugs\/errors came from exactly that. Players on Discord sent me a few of their saves and I was able to fix a lot of issues with it, but I still consider it a BETA feature. For best experience I would just restart the game if you want to load another save. But that's for you to decide ;D I will keep fixing the issues with it as they appear!\n[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/4f3348e131ee3f50caa1d5461ce64bfde83e5f9f.png\"][\/img][\/p][list][*][p][b]Performance at x5 and x10 time speed[\/b]: Thanks to built-in error reporting system and a few players on Discord, I was able to fix a couple memory leaks in the late game which caused big freezes. [\/p][\/*][*][p][b]Easier Career Start[\/b]: EarthX 2 now starts with welcome notification again. Build Mode\/Loans\/Insurance\/ISS buttons are all hidden until you need them later in the game. Also added a few tooltips and blinking buttons here and there. Factories and Prime Launch Pads now have trackers to show new players that factories are clickable.[\/p][\/*][*][p][b]Buildings can now be moved[\/b]: unintended consequence of this simple feature is that you can now move the pre-built buildings anywhere on Earth and play the game eg. from Australia :)[\/p][\/*][*][p]Nuclear Reactor will now need 10 Uranium to build, but then requires no weekly Uranium to produce electricity.[\/p][\/*][*][p]Quick Access (open with \\[TAB]) now brings planet switch buttons back.[\/p][\/*][*][p]Pressing \\[1] \\[2] \\[3] \\[4] now controls the time speed.[\/p][\/*][*][p]Disabled meteor rains on the Moon which probably destroyed your bases more than once ;c[\/p][\/*][*][p]Webcast commentators now have sad-ish lines when the flight starts behaving wrong.[\/p][\/*][*][p]Sandstorms no more tip so many landed ships on Mars.[\/p][\/*][*][p]Temporary: no fuel needed when launching from the Moon + no orbital refueling needed when launching from Mars\/Moon.\n[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/030d197986d19a72fb66f46c8d5ab5d3c9b3e44a.png\"][\/img][\/p][list][*][p][b]Production now \"vents\" excess items again[\/b]: so for example, greenhouses keep growing food even when the oxygen tanks are full[\/p][\/*][*][p]Automations can now launch more than one mission at a time[\/p][\/*][*][p]Pressing \\[P] no longer spawns a sandstorm xD[\/p][\/*][*][p]Other fixes that are so small I didn't even bother putting them here like: saves stuck as .tmp files, the exFAT loading errors on MacOS, ships stuck \"Connecting\", bugs with parking orbits, bugs with droneships and more[\/p][\/*][*][p]Disabled: ISS Destroyer, Cruiser (they are my not-yet-ready content for next updates)[\/p][\/*][\/list][p][\/p][p]Tonight I will continue with the in-game guide\/tutorial and then imma take a few days of break to make up the intense stress I've gotten during the weekend and then... I'm going to start working on the first Content Update which would be my attempt at completely reworking how the colonies on Mars work. I always appreciate your ideas (really reading them all every evening)! [\/p][p]I will of course continue to fix\/improve small things almost weekly, small changes aren't hard at all :)[\/p][p]Also big thanks to players on Discord who reported most of these issues to me so I could set my priorities straight! Making the game with you guys will be a pure journey for me as well :)[\/p][p]Huntley, notseebi, MrGreen, Mr Noob8000, ironass2, Psycho Trooper, Flazen, Sanmartin85, onemarsyboi, create_modder, Milanofzo, LufthansaLover, Murk, Quack, Jakub_gitrus, Dark, Lostmindfroob, Dziubecky, Spooky Liam, Su-57 Felon, Pierre D'olnique, kinda114, Lusanben, B, Cmonster820, Ino, Jonhalo, Akoszuzo, Thanos_Panda, Thepro241, Raf protogen, Olly[\/p][p][\/p][p]See you,[\/p][p]Denis[\/p]","commentcount":8,"tags":["mod_reviewed","ModAct_768955665_1792406259_0","ModAct_768955665_1792414367_4","ModAct_487176015_1792449223_4"],"language":0,"hidden":0,"forum_topic_id":"706660344651760620","event_gid":"686393795070133427","voteupcount":69,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660344651760620","rtime32_last_modified":1793395224,"news_post_gid":"0","rtime_mod_reviewed":1792449224,"featured_app_tagid":0,"referenced_appids":[],"build_id":26044568,"build_branch":"","unlisted":0,"rtime_created":1792402561,"votes_up":69,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"588439235122622948","gidfeature2":"706660344651760620"},{"gid":"686393795070132926","clan_steamid":"103582791474975192","event_name":"EarthX 2 Launches Today","event_type":29,"appid":1486940,"server_address":null,"server_password":null,"rtime32_start_time":1792065060,"rtime32_end_time":1792069201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"18:00 CEST \/ 9:00 PDT \/ 12:00 EDT\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"18:00 CEST \/ 9:00 PDT \/ 12:00 EDT\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"bd930cc295fc95197c16f34243ce769372039e05.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7d34a53f5c4ad1c15ab5840063645bcd9e86baa9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"686393795070132927","clanid":"45453784","posterid":"0","headline":"EarthX 2 Launches Today","posttime":1792065115,"updatetime":1792065451,"body":"[p]Hey,[\/p][p]EarthX 2 launches today in Early Access! We literally don't have anything else to say anymore, except to wish you LOTS of fun tonight![\/p][p]A pre-launch stream will start ~15 minutes before game launch, so come join if you're interested what changes there are compared to Open Alpha and EarthX 1 :)[\/p][previewyoutube=\"RcQ-xHrYGVk;full\"][\/previewyoutube][p][\/p][p]If you still didn't, wishlist the game here on Steam; Gabe's email server will then remind you about the release :)[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/1486940\/EarthX_2\"][\/dynamiclink][\/p][p]Denis[\/p]","commentcount":6,"tags":["workshop","ModAct_773020726_1792068305_2_29","mod_reviewed","ModAct_773020726_1792068309_0"],"language":0,"hidden":0,"forum_topic_id":"706660083369572084","event_gid":"686393795070132926","voteupcount":43,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369572084","rtime32_last_modified":1793236600,"news_post_gid":"0","rtime_mod_reviewed":1792068309,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792064901,"votes_up":43,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"588439235122622948","gidfeature2":"706660083369572084"},{"gid":"670631830781689857","clan_steamid":"103582791474975192","event_name":"Tutorial + stuck at \"Landing...\" fix","event_type":12,"appid":1486940,"server_address":null,"server_password":null,"rtime32_start_time":1792535220,"rtime32_end_time":1792539001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"eeda4115a400c7063e5771762b39292a768682d1.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"670631830781689858","clanid":"45453784","posterid":"0","headline":"Tutorial + stuck at \"Landing...\" fix","posttime":1792535253,"updatetime":1792535253,"body":"[p]Hey,[\/p][p]I just quickly wanted to release this follow-up update to the Sunday Patch 1 from yesterday![\/p][p][\/p][p]It adds a simple tutorial window you can open at all times with easy to follow steps that include in-game screenshots with highlighted elements. [\/p][p]It took me some time to prepare the actual images and write the steps, not even mentioning knowing what guides I'd like to add :X Feedback from the last few days was def helpful here.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/3f9b3981578b8b84183c9a18baec7493fd1a8a1c.png\"][\/img][\/p][p]Also, while I was working on this, it was reported to me that there's a bad bug that makes ships stuck on Landing Zones and Launch Pads in a very weird edge case, it's now also fixed :) [\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45453784\/cc6aa82b8f8663d5193ae56d017410717323dd9d.png\"][\/img][\/p][p][\/p][p]I think the patch fixes most of the issues for players that didn't play EarthX1! Our game should be now a lot easier to understand, not only because of the tutorial, but also because of the UI changes at the start of the Career mode.[\/p][p][\/p][p]Roadmap for the next few weeks:[\/p][olist][*][p]Next weekend release another small \"Sunday Patch 2\" that will add first actual features :D[\/p][\/*][*][p]Work on a bigger content update and try to bring it out by December; The update will be called \"Colony Update\"[\/p][\/*][\/olist][p][\/p][p]Lucas and me are really excited to provide great fun for you guys, we couldn't ask for a better community and reading your reviews & messages is pure joy for us.[\/p][p]Denis[\/p]","commentcount":2,"tags":["patchnotes","mod_reviewed","ModAct_1890460210_1792536230_0"],"language":0,"hidden":0,"forum_topic_id":"563671339629544943","event_gid":"670631830781689857","voteupcount":31,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"563671339629544943","rtime32_last_modified":1793401141,"news_post_gid":"0","rtime_mod_reviewed":1792536230,"featured_app_tagid":0,"referenced_appids":[],"build_id":26091535,"build_branch":"","unlisted":0,"rtime_created":1792535031,"votes_up":31,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"588439235122622948","gidfeature2":"563671339629544943"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["686393795070133428","686393795070132927"],"last_update_event":{"rtime":1792535220,"event_gid":"670631830781689857","announcement_gid":"670631830781689858","clan_account_id":45453784}}};

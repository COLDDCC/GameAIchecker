calized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"669506565056759655","clanid":"46280661","posterid":"0","headline":"Update | Build Sharing Added v1.1179.3.46","posttime":1793350388,"updatetime":1793350388,"body":"[p]Thank you for playing!\nThis update adds Build Sharing to the full version of the game.\nDiscovering combinations of equipment and skills is part of the fun, and we\u2019ve made it easier to share your builds and ideas with other players.[\/p][h2]Share and View Builds[\/h2][p][img src=\"https:\/\/clan.akamai.steamstatic.com\/images\/46280661\/ad6cd18c6834a5066e0332188edde3305912438b.png\"][\/img][\/p][list][*][p]At the Training Statue, you can copy your current character\u2019s build as text or a share code.[\/p][\/*][*][p]Import a share code to view equipment, attributes, and skills in the game.[\/p][\/*][*][p]Choose whether to include your Steam player name in the code or remain anonymous.[\/p][\/*][\/list][p]We\u2019ve created a Build Sharing forum in the Community Hub. Share your favorite builds along with their share codes!\n[url=\"https:\/\/steamcommunity.com\/app\/5062910\/discussions\/1\/\"]Visit the Build Sharing forum[\/url][\/p][p][\/p][h2]1-on-1 Mock Battles[\/h2][p][img src=\"https:\/\/clan.akamai.steamstatic.com\/images\/46280661\/37a49583582f633214d67b9f4e3387bae6dcf162.gif\"][\/img][\/p][list][*][p]Try a 1-on-1 mock battle against an imported build using manual or automatic controls.[\/p][\/*][\/list][p]Please note: Mock battles are an experimental feature. Some behavior may not work as intended, and no balance adjustments have been made specifically for these battles.\n\nUse this feature to show off your favorite builds and find inspiration for new combinations.\nThank you for your continued support of Life Is a Dungeon: Lean into It.![\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1751692459_1793350525_0"],"language":0,"hidden":0,"forum_topic_id":"572679173080052921","event_gid":"669506565056759654","voteupcount":9,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679173080052921","rtime32_last_modified":1793381867,"news_post_gid":"0","rtime_mod_reviewed":1793350525,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793339116,"votes_up":9,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568171134404543907","gidfeature2":"572679173080052921"},{"gid":"669505930872756768","clan_steamid":"103582791475802069","event_name":"Life Is a Dungeon: Lean into It. Out Now \u2014 20% Off at Launch!","event_type":10,"appid":5062910,"server_address":null,"server_password":null,"rtime32_start_time":1793059740,"rtime32_end_time":1793064601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Thanks to your support, the game is officially out today! Celebrate the launch with 20% off.\",\"Dank eurer Unterst\u00fctzung ist das Spiel heute offiziell erschienen! Zum Start gibt es 20 % Rabatt.\",\"Gr\u00e2ce \u00e0 votre soutien, le jeu sort officiellement aujourd\u2019hui ! Profitez de 20 % de r\u00e9duction pour son lancement.\",\"Grazie al vostro sostegno, il gioco \u00e8 ufficialmente disponibile da oggi! Festeggiate con lo sconto di lancio del 20%.\",\"\uc5ec\ub7ec\ubd84\uc758 \uc751\uc6d0\uc5d0 \ud798\uc785\uc5b4 \uc624\ub298 \uc815\uc2dd \ucd9c\uc2dc\ud588\uc2b5\ub2c8\ub2e4! \ucd9c\uc2dc \uae30\ub150 20% \ud560\uc778\ub3c4 \uc9c4\ud589 \uc911\uc785\ub2c8\ub2e4.\",\"\u00a1Gracias a vuestro apoyo, el juego sale oficialmente hoy! Celebradlo con un 20 % de descuento de lanzamiento.\",\"\u611f\u8c22\u5927\u5bb6\u7684\u652f\u6301\uff0c\u672c\u4f5c\u4e8e\u4eca\u65e5\u6b63\u5f0f\u53d1\u552e\uff01\u9996\u53d1\u516b\u6298\u4f18\u60e0\u540c\u6b65\u5f00\u542f\u3002\",\"\u611f\u8b1d\u5927\u5bb6\u7684\u652f\u6301\uff0c\u672c\u4f5c\u65bc\u4eca\u65e5\u6b63\u5f0f\u767c\u552e\uff01\u9996\u767c\u516b\u6298\u512a\u60e0\u540c\u6b65\u958b\u8dd1\u3002\",null,null,\"\u7686\u3055\u307e\u306e\u5fdc\u63f4\u306e\u304a\u304b\u3052\u3067\u3001\u672c\u65e5\u6b63\u5f0f\u767a\u58f2\u3092\u8fce\u3048\u307e\u3057\u305f\uff01\u767a\u58f2\u8a18\u5ff520\uff05OFF\u30bb\u30fc\u30eb\u3082\u958b\u50ac\u4e2d\u3067\u3059\u3002\",null,null,null,null,null,null,null,null,null,null,null,\"Gra\u00e7as ao apoio de voc\u00eas, o jogo foi lan\u00e7ado oficialmente hoje! Aproveitem o desconto de lan\u00e7amento de 20%.\",null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"5adbb2386a1adc8ea96bc3b498455dc5eb55fbd4.png\",\"2599654ef138827811ba797d635936141dd3eab8.png\",\"20e195f3585a676d8422d206c477899f4948d986.png\",\"4b34677adace5c027bccda7cf343aee3c051d2a7.png\",\"8ce9506e1289e76549fa8e806fb4b1b805051cba.png\",\"23d3f3c933421670d6177d0a79302b09a342dc60.png\",\"04b1e81963a9b52d4342d9bc77b2a58d5b714dbd.png\",\"9930aa38c7be6c50bfc985ffd03edef6524476d3.png\",null,null,\"5c038da4f28a76bb3b1f1d603a18974838a7ece5.png\",null,null,null,null,null,null,null,null,null,null,null,\"8e9f82a9864b18676b6db8d71a63dbc4791acfbe.png\",null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"669505930872756769","clanid":"46280661","posterid":"0","headline":"Life Is a Dungeon: Lean into It. Out Now \u2014 20% Off at Launch!","posttime":1793059752,"updatetime":1793059752,"body":"[h1]Life Is a Dungeon: Lean into It. is officially out on Steam today![\/h1]\n\n[img src=\"{STEAM_CLAN_IMAGE}\/46280661\/dcd1b44becfb905f892f12419190a798ee4a154a.gif\"][\/img]\n\nThank you so much for reviewing the demo, adding the game to your wishlists, and sharing your thoughts and feedback!\nYour feedback has helped us improve the game through many updates and reach this launch.\n\nTo celebrate, the game is [b]20% off during our launch sale[\/b]. We hope you\u2019ll give it a try!\n\n[url=https:\/\/store.steampowered.com\/app\/5062910\/]Visit the Steam store page[\/url]\n\nWe\u2019ll keep improving the game with your feedback.\nThank you for your continued support of Life Is a Dungeon: Lean into It.!","commentcount":1,"tags":["mod_reviewed","ModAct_783923276_1793060875_0"],"language":0,"hidden":0,"forum_topic_id":"562545740486033449","event_gid":"669505930872756768","voteupcount":14,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562545740486033449","rtime32_last_modified":1793260962,"news_post_gid":"0","rtime_mod_reviewed":1793060875,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793057714,"votes_up":14,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"568171134404543907","gidfeature2":"562545740486033449"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["669506565056759655","669505930872756769"],"last_update_event":{"rtime":1793350380,"event_gid":"669506565056759654","announcement_gid":"669506565056759655","clan_account_id":46280661}}};

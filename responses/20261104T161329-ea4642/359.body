m_assets\/steam\/apps\/5051190\/0ff9587536bde0d3cb503b3a88a74b3c1c77415d\/ss_0ff9587536bde0d3cb503b3a88a74b3c1c77415d.600x338.jpg?t=1793643286","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/0ff9587536bde0d3cb503b3a88a74b3c1c77415d\/ss_0ff9587536bde0d3cb503b3a88a74b3c1c77415d.1920x1080.jpg?t=1793643286"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/71810482c83ac33023affa0805cda371bf1fdfa8\/ss_71810482c83ac33023affa0805cda371bf1fdfa8.600x338.jpg?t=1793643286","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/71810482c83ac33023affa0805cda371bf1fdfa8\/ss_71810482c83ac33023affa0805cda371bf1fdfa8.1920x1080.jpg?t=1793643286"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/d331cb98d0aa0ba046d90eae23cf62248e9f53c9\/ss_d331cb98d0aa0ba046d90eae23cf62248e9f53c9.600x338.jpg?t=1793643286","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/d331cb98d0aa0ba046d90eae23cf62248e9f53c9\/ss_d331cb98d0aa0ba046d90eae23cf62248e9f53c9.1920x1080.jpg?t=1793643286"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/72df8cc929730753d789d9b9d743bf628508c4b1\/ss_72df8cc929730753d789d9b9d743bf628508c4b1.600x338.jpg?t=1793643286","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/72df8cc929730753d789d9b9d743bf628508c4b1\/ss_72df8cc929730753d789d9b9d743bf628508c4b1.1920x1080.jpg?t=1793643286"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/bd0e263bdca39470069560a1008968ad45eb4f22\/ss_bd0e263bdca39470069560a1008968ad45eb4f22.600x338.jpg?t=1793643286","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5051190\/bd0e263bdca39470069560a1008968ad45eb4f22\
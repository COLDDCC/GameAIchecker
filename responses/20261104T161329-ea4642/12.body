pps\/5416440\/8feb3d7c5cfaabc56d8786b8fc73881d786f2242\/ss_8feb3d7c5cfaabc56d8786b8fc73881d786f2242.600x338.jpg?t=1793770327","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5416440\/8feb3d7c5cfaabc56d8786b8fc73881d786f2242\/ss_8feb3d7c5cfaabc56d8786b8fc73881d786f2242.1920x1080.jpg?t=1793770327"}],"movies":[{"id":257453578,"name":"The Last Debugger","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257453578\/797f5e41eb6001ea418185bf69eae0dfa690ca88\/movie_600x337.jpg?t=1791940190","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5416440\/919295363\/b7439f7f7592af0968879fea36621b728a9cebd7\/1791524557\/dash_av1.mpd?t=1791940190","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5416440\/919295363\/b7439f7f7592af0968879fea36621b728a9cebd7\/1791524557\/dash_h264.mpd?t=1791940190","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5416440\/919295363\/b7439f7f7592af0968879fea36621b728a9cebd7\/1791524557\/hls_264_master.m3u8?t=1791940190","highlight":true}],"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"sht58119@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5416440?t=1793770327","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5416440?t=1793770327","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Violência fantasiosa"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Fantasy-Gewalt"}}}}}
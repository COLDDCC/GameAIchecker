eamstatic.com\/store_item_assets\/steam\/apps\/5135400\/1fd42f0fa215c2c16a2b8a2c735464597e715b58\/ss_1fd42f0fa215c2c16a2b8a2c735464597e715b58.600x338.jpg?t=1793638834","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5135400\/1fd42f0fa215c2c16a2b8a2c735464597e715b58\/ss_1fd42f0fa215c2c16a2b8a2c735464597e715b58.1920x1080.jpg?t=1793638834"}],"movies":[{"id":257469313,"name":"nextfest_trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257469313\/ee3f07e6cff06850059cd3419c5dc40437baf46a\/movie_600x337.jpg?t=1792428416","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5135400\/319903547\/79dd2c3d60adafb251ab81067122b6b233f2c3a2\/1792427944\/dash_av1.mpd?t=1792428416","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5135400\/319903547\/79dd2c3d60adafb251ab81067122b6b233f2c3a2\/1792427944\/dash_h264.mpd?t=1792428416","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5135400\/319903547\/79dd2c3d60adafb251ab81067122b6b233f2c3a2\/1792427944\/hls_264_master.m3u8?t=1792428416","highlight":true}],"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"","email":"kaanyrts@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5135400?t=1793638834","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5135400?t=1793638834","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Violência fantasiosa"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Fantasy-Gewalt"},"igrs":{"rating_generated":"1","rating":"13","required_age":"13","banned":"0","use_age_gate":"0","descriptors":"Kekerasan"}}}}}
\/ss_a1688264f5ff7663300a7a590a4df9c858cf923e.600x338.jpg?t=1793723176","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/a1688264f5ff7663300a7a590a4df9c858cf923e\/ss_a1688264f5ff7663300a7a590a4df9c858cf923e.1920x1080.jpg?t=1793723176"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/c4b91584ff15e338309162709fbdabec7c10ec59\/ss_c4b91584ff15e338309162709fbdabec7c10ec59.600x338.jpg?t=1793723176","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/c4b91584ff15e338309162709fbdabec7c10ec59\/ss_c4b91584ff15e338309162709fbdabec7c10ec59.1920x1080.jpg?t=1793723176"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/be978a483192aa47ba7752e345fa05afb053ef2e\/ss_be978a483192aa47ba7752e345fa05afb053ef2e.600x338.jpg?t=1793723176","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/be978a483192aa47ba7752e345fa05afb053ef2e\/ss_be978a483192aa47ba7752e345fa05afb053ef2e.1920x1080.jpg?t=1793723176"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/fc7175b535f7a1ffbcab76ab9e8fc3f0f4757343\/ss_fc7175b535f7a1ffbcab76ab9e8fc3f0f4757343.600x338.jpg?t=1793723176","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/fc7175b535f7a1ffbcab76ab9e8fc3f0f4757343\/ss_fc7175b535f7a1ffbcab76ab9e8fc3f0f4757343.1920x1080.jpg?t=1793723176"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/d674bbb3fe6c94de3258b669b43ef3df29f0c508\/ss_d674bbb3fe6c94de3258b669b43ef3df29f0c508.600x338.jpg?t=1793723176","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3393720\/d674bbb3fe6c94de3258b669b43ef3df29f0c508\/ss_d674bbb3fe6c94de3258b669b43ef3df29f0c508.1920x1080.jpg?t=1793723176"
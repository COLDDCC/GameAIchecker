r.m3u8?t=1787405862","highlight":true}],"achievements":{"total":4,"highlighted":[{"icon":"970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg","localized_name":"Investigation Complete","archived":0,"hidden":0,"name":"Investigation Complete","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5123700\/970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg"},{"icon":"970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg","localized_name":"Nowhere Is Safe","archived":0,"hidden":0,"name":"Nowhere Is Safe","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5123700\/970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg"},{"icon":"970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg","localized_name":"Every Warning Sign","archived":0,"hidden":0,"name":"Every Warning Sign","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5123700\/970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg"},{"icon":"970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg","localized_name":"Evidence Left Behind","archived":0,"hidden":0,"name":"Evidence Left Behind","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5123700\/970ac30820a4a5fa9ad9a032a11626a8f210adf6.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/x.com\/totoriworks","email":"totoriworks@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5123700?t=1793703613","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5123700\/82855ae5e0da521c3c30a50f7b3741cc4467cb4a\/page_bg_raw.jpg?t=1793703613","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Violência\nMedo"},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Horror"},"igrs":{"rating_generated":"1","rating"
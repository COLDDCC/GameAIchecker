6ce0c6524e4bbcd9532559c.600x338.jpg?t=1793676353","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/798a4ea4a8faa69596ce0c6524e4bbcd9532559c\/ss_798a4ea4a8faa69596ce0c6524e4bbcd9532559c.1920x1080.jpg?t=1793676353"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/84f37b6de0527e99c1e77fd8d2fd27759004422c\/ss_84f37b6de0527e99c1e77fd8d2fd27759004422c.600x338.jpg?t=1793676353","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/84f37b6de0527e99c1e77fd8d2fd27759004422c\/ss_84f37b6de0527e99c1e77fd8d2fd27759004422c.1920x1080.jpg?t=1793676353"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/ba788394378ecbc94cbc827de12b8f821dc2236f\/ss_ba788394378ecbc94cbc827de12b8f821dc2236f.600x338.jpg?t=1793676353","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/ba788394378ecbc94cbc827de12b8f821dc2236f\/ss_ba788394378ecbc94cbc827de12b8f821dc2236f.1920x1080.jpg?t=1793676353"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/4e581bf34f1cad68ada871c66513e629b2aec4c6\/ss_4e581bf34f1cad68ada871c66513e629b2aec4c6.600x338.jpg?t=1793676353","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/4e581bf34f1cad68ada871c66513e629b2aec4c6\/ss_4e581bf34f1cad68ada871c66513e629b2aec4c6.1920x1080.jpg?t=1793676353"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/02095ad066c63f587b42efa0491e96f7bf5fa5df\/ss_02095ad066c63f587b42efa0491e96f7bf5fa5df.600x338.jpg?t=1793676353","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5223600\/02095ad066c63f587b42efa0491e96f7bf5fa5df\/ss_02095ad066c63f587b42efa0491e96f7bf5fa5df.1920x1080.jpg?t=1793676353"},{"id":12,"path_thu
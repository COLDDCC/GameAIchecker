true}],"achievements":{"total":16,"highlighted":[{"icon":"82a257095c559d59024d6e2890d1d9945c183a12.jpg","localized_name":"First Catch","archived":0,"hidden":0,"name":"First Catch","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/82a257095c559d59024d6e2890d1d9945c183a12.jpg"},{"icon":"83beba87866d82836d231221d30f4eedf6037852.jpg","localized_name":"Keep It","archived":0,"hidden":0,"name":"Keep It","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/83beba87866d82836d231221d30f4eedf6037852.jpg"},{"icon":"519ccdb25abeba17ca52c64192f1c63aa50e3860.jpg","localized_name":"Round Clear","archived":0,"hidden":0,"name":"Round Clear","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/519ccdb25abeba17ca52c64192f1c63aa50e3860.jpg"},{"icon":"d3be33fe72fe7af0cd04c46eadfc30d785c23906.jpg","localized_name":"Figurine","archived":0,"hidden":0,"name":"Figurine","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/d3be33fe72fe7af0cd04c46eadfc30d785c23906.jpg"},{"icon":"f5b52107e3e0fccd585a5a1518de2ad84fc87c87.jpg","localized_name":"Mini Boss","archived":0,"hidden":0,"name":"Mini Boss","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/f5b52107e3e0fccd585a5a1518de2ad84fc87c87.jpg"},{"icon":"72470c188e1a7c792ed9530910ea6f11f024f123.jpg","localized_name":"Breakthrough","archived":0,"hidden":0,"name":"Breakthrough","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/72470c188e1a7c792ed9530910ea6f11f024f123.jpg"},{"icon":"3bc0b1aafc8104e6ba9dccb97280e1fca668cf13.jpg","localized_name":"Recipe","archived":0,"hidden":0,"name":"Recipe","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5282410\/3bc0b1aafc8104e6ba9dccb97280e1fca668cf13.jpg"},{"icon":"83e203f52ce412a21219913e046a6c6e496bb9c4.jpg","localized_name":"Run Clear","archived":0,"hid
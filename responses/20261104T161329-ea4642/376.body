unity_assets\/images\/apps\/5149100\/df6403afb111cb81606b9ad27734d9a9dd278af6.jpg"},{"icon":"4d7fdc3ff5ab3d6b4474570fd2c6953263674a8e.jpg","localized_name":"A Wider Future","archived":0,"hidden":0,"name":"A Wider Future","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/4d7fdc3ff5ab3d6b4474570fd2c6953263674a8e.jpg"},{"icon":"f1f6cee441ba1dcaf58d1a8f3d2e66aa83349144.jpg","localized_name":"Hold the Line","archived":0,"hidden":0,"name":"Hold the Line","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/f1f6cee441ba1dcaf58d1a8f3d2e66aa83349144.jpg"},{"icon":"969ccdb1fe3ccae379bca839d6d1c3ee8cd10f76.jpg","localized_name":"Echoes of What Was","archived":0,"hidden":0,"name":"Echoes of What Was","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/969ccdb1fe3ccae379bca839d6d1c3ee8cd10f76.jpg"},{"icon":"b346803603b9831fd9796f89eab5e3624c9b1ce0.jpg","localized_name":"Memory Mender","archived":0,"hidden":0,"name":"Memory Mender","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/b346803603b9831fd9796f89eab5e3624c9b1ce0.jpg"},{"icon":"34e31329f82e9864bb50446fee542fa217f95277.jpg","localized_name":"Perfect Resonance","archived":0,"hidden":0,"name":"Perfect Resonance","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/34e31329f82e9864bb50446fee542fa217f95277.jpg"},{"icon":"1615ae9348d5e209e9a5ffb17f70d8c1d211eb97.jpg","localized_name":"We Are Remembered","archived":0,"hidden":0,"name":"We Are Remembered","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/1615ae9348d5e209e9a5ffb17f70d8c1d211eb97.jpg"},{"icon":"f17760f8e5da6a414db3a4340364ed4611ae2a80.jpg","localized_name":"Beacon of Hope","archived":0,"hidden":0,"name":"Beacon of Hope","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5149100\/f17760f8e5da6a414db3a4340364e
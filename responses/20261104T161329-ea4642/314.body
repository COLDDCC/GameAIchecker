29de0f06c0d2e507be29d\/ss_f3ed78b1fb30b3c0c3129de0f06c0d2e507be29d.1920x1080.jpg?t=1793656923"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/a2a0f002d6aa5f6d8d2519b926df26259fc964c9\/ss_a2a0f002d6aa5f6d8d2519b926df26259fc964c9.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/a2a0f002d6aa5f6d8d2519b926df26259fc964c9\/ss_a2a0f002d6aa5f6d8d2519b926df26259fc964c9.1920x1080.jpg?t=1793656923"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/1b01586131bba0aa13d1da224386e55b38a2ce58\/ss_1b01586131bba0aa13d1da224386e55b38a2ce58.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/1b01586131bba0aa13d1da224386e55b38a2ce58\/ss_1b01586131bba0aa13d1da224386e55b38a2ce58.1920x1080.jpg?t=1793656923"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/1f39b47a66d500b79cdcce3fa624164f08c1e991\/ss_1f39b47a66d500b79cdcce3fa624164f08c1e991.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/1f39b47a66d500b79cdcce3fa624164f08c1e991\/ss_1f39b47a66d500b79cdcce3fa624164f08c1e991.1920x1080.jpg?t=1793656923"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/47114c1328a463d02969ada9ceadf04d50a8eb88\/ss_47114c1328a463d02969ada9ceadf04d50a8eb88.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/47114c1328a463d02969ada9ceadf04d50a8eb88\/ss_47114c1328a463d02969ada9ceadf04d50a8eb88.1920x1080.jpg?t=1793656923"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/0f1a83c0b88af723dfbdf2aca46e2008e2a59e68\/ss_0f1a83c0b88af723dfbdf2aca46e2008e2a59e68.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/0f1a83c0b88af723dfbdf2aca46e2008e2a59e68\/ss_0f1a83c0b88af723dfbdf2aca46e2008e2a59e68.1920x1080.jpg?t=1793656923"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/bcfbc1de056a37c87313fd21e20d505ab51699fc\/ss_bcfbc1de056a37c87313fd21e20d505ab51699fc.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/bcfbc1de056a37c87313fd21e20d505ab51699fc\/ss_bcfbc1de056a37c87313fd21e20d505ab51699fc.1920x1080.jpg?t=1793656923"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/5795b386dbd7f6f3346442c22fdbb1aa25fa5760\/ss_5795b386dbd7f6f3346442c22fdbb1aa25fa5760.600x338.jpg?t=1793656923","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/5795b386dbd7f6f3346442c22fdbb1aa25fa5760\/ss_5795b386dbd7f6f3346442c22fdbb1aa25fa5760.1920x1080.jpg?t=1793656923"}],"movies":[{"id":257444140,"name":"Main Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257444140\/1ad18ae48fa234e034bb944bedfdceefbe6f8479\/movie_600x337.jpg?t=1790977109","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5046250\/1604014092\/98f948c8e739f9a0d5a84c4dddf6c42a65e8968e\/1790976113\/dash_av1.mpd?t=1790977109","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5046250\/1604014092\/98f948c8e739f9a0d5a84c4dddf6c42a65e8968e\/1790976113\/dash_h264.mpd?t=1790977109","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5046250\/1604014092\/98f948c8e739f9a0d5a84c4dddf6c42a65e8968e\/1790976113\/hls_264_master.m3u8?t=1790977109","highlight":true}],"release_date":{"coming_soon":false,"date":"2 Nov, 2026"},"support_info":{"url":"","email":"support@portopalmastudios.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5046250?t=1793656923","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5046250\/770548907d1f3fb9a02df45521d4b13c60dec2a6\/page_bg_raw.jpg?t=1793656923","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Linguagem imprópria"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Schimpfwörte"}}}}}
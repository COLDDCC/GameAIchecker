1920x1080.jpg?t=1793721725"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4996850\/3719e7f24922f9d12a0bbc86d1aa7e36654b3f79\/ss_3719e7f24922f9d12a0bbc86d1aa7e36654b3f79.600x338.jpg?t=1793721725","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4996850\/3719e7f24922f9d12a0bbc86d1aa7e36654b3f79\/ss_3719e7f24922f9d12a0bbc86d1aa7e36654b3f79.1920x1080.jpg?t=1793721725"}],"movies":[{"id":257433461,"name":"OfficialTrailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257433461\/22742199a4391bc25343e260c2855d7f4cb16157\/movie_600x337.jpg?t=1792557959","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/988600572\/96be4cf56f85af273ed3fb03768d857af3aa9a31\/1790238454\/dash_av1.mpd?t=1792557959","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/988600572\/96be4cf56f85af273ed3fb03768d857af3aa9a31\/1790238454\/dash_h264.mpd?t=1792557959","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/988600572\/96be4cf56f85af273ed3fb03768d857af3aa9a31\/1790238454\/hls_264_master.m3u8?t=1792557959","highlight":true},{"id":257401312,"name":"Gameplay","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257401312\/d9a4e09ea077d719ab01e54ce7f2f7ae42c5ac60\/movie_600x337.jpg?t=1786980374","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/1554142691\/2fb6a5c843e09cbb9a27997c5e2042961b0966f3\/1786979732\/dash_av1.mpd?t=1786980374","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/1554142691\/2fb6a5c843e09cbb9a27997c5e2042961b0966f3\/1786979732\/dash_h264.mpd?t=1786980374","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4996850\/1554142691\/2fb6a5c843e09cbb9a27997c5e2042961b0966f3\/1786979732\/hls_264_master.m3u8?t=1786980374","highlight":true}],"achievements":{"total":17,"highlighted":
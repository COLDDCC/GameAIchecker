rtable","archived":0,"hidden":0,"name":"Getting Comfortable","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/09d5153726b62d0d7d231820dc6da22b7d7656d4.jpg"},{"icon":"ddeb35ef0f755a7d3765ae47a98e0beff7fe12f5.jpg","localized_name":"Regular at the Table","archived":0,"hidden":0,"name":"Regular at the Table","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/ddeb35ef0f755a7d3765ae47a98e0beff7fe12f5.jpg"},{"icon":"6f6e34156725176bfc072352aaea427eb59a9104.jpg","localized_name":"A Hundred Hands","archived":0,"hidden":0,"name":"A Hundred Hands","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/6f6e34156725176bfc072352aaea427eb59a9104.jpg"},{"icon":"778fc89e574598a4e1a6f94b989fb7c2bb5d9407.jpg","localized_name":"Old Hand","archived":0,"hidden":0,"name":"Old Hand","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/778fc89e574598a4e1a6f94b989fb7c2bb5d9407.jpg"},{"icon":"3c1ef96efb0a626fc4ba781d9340f1a4280f7f00.jpg","localized_name":"The Whole Evening","archived":0,"hidden":0,"name":"The Whole Evening","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/3c1ef96efb0a626fc4ba781d9340f1a4280f7f00.jpg"},{"icon":"b964aac13a755519ab76fa896978930333fe3f17.jpg","localized_name":"Table Regular","archived":0,"hidden":0,"name":"Table Regular","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/b964aac13a755519ab76fa896978930333fe3f17.jpg"},{"icon":"8fd0d77c19a2e5688985aefb4f7c0cff4abeacad.jpg","localized_name":"Familiar Felt","archived":0,"hidden":0,"name":"Familiar Felt","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5465890\/8fd0d77c19a2e5688985aefb4f7c0cff4abeacad.jpg"},{"icon":"30b3001c7af1a7a4c96ee31d4259f07ff71a569d.jpg","localized_name":"Less Is More","archived":0,"hidden":0,"name":"Less Is More","path":"https:\/\/sha
ommunity_assets\/images\/apps\/5382130\/7d312955c93936a3d7d004df5d8537c44eaaaf6b.jpg"},{"icon":"5475e177f97ecd74706d8c87d804c914b4e8d276.jpg","localized_name":"Bullseye","archived":0,"hidden":0,"name":"Bullseye","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5382130\/5475e177f97ecd74706d8c87d804c914b4e8d276.jpg"},{"icon":"184a904d52dbd60852d8ddc83dc80e33ef84f80c.jpg","localized_name":"Kaboom","archived":0,"hidden":0,"name":"Kaboom","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5382130\/184a904d52dbd60852d8ddc83dc80e33ef84f80c.jpg"},{"icon":"de8365f41868c6947b37cbd11e4e6597996c74aa.jpg","localized_name":"Close Call","archived":0,"hidden":0,"name":"Close Call","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5382130\/de8365f41868c6947b37cbd11e4e6597996c74aa.jpg"},{"icon":"5fffa23b4b64727928163175dc199dfbf991d754.jpg","localized_name":"Objection!","archived":0,"hidden":0,"name":"Objection!","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5382130\/5fffa23b4b64727928163175dc199dfbf991d754.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/codeguess.de","email":""},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5382130?t=1793743856","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5382130\/087256ab65597ffb4754360e49b23e5dbcfa185d\/page_bg_raw.jpg?t=1793743856","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":""}}}}}
c.com\/store_item_assets\/steam\/apps\/4956910\/b62c84ece79e75df2ca24f70029222d320e1480b\/ss_b62c84ece79e75df2ca24f70029222d320e1480b.1920x1080.jpg?t=1793722669"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/93b31e860b823f615d4e1b3d99cf103f53dbcdee\/ss_93b31e860b823f615d4e1b3d99cf103f53dbcdee.600x338.jpg?t=1793722669","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/93b31e860b823f615d4e1b3d99cf103f53dbcdee\/ss_93b31e860b823f615d4e1b3d99cf103f53dbcdee.1920x1080.jpg?t=1793722669"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/73560388347dcfefe4506784246dfbf055ead1c7\/ss_73560388347dcfefe4506784246dfbf055ead1c7.600x338.jpg?t=1793722669","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/73560388347dcfefe4506784246dfbf055ead1c7\/ss_73560388347dcfefe4506784246dfbf055ead1c7.1920x1080.jpg?t=1793722669"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/1decae4ec2b11d23b873d174ce018970014a04b3\/ss_1decae4ec2b11d23b873d174ce018970014a04b3.600x338.jpg?t=1793722669","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/1decae4ec2b11d23b873d174ce018970014a04b3\/ss_1decae4ec2b11d23b873d174ce018970014a04b3.1920x1080.jpg?t=1793722669"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/44ca5ac23fc8bdda2cc3a55a02fcfd01801f9e7c\/ss_44ca5ac23fc8bdda2cc3a55a02fcfd01801f9e7c.600x338.jpg?t=1793722669","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/44ca5ac23fc8bdda2cc3a55a02fcfd01801f9e7c\/ss_44ca5ac23fc8bdda2cc3a55a02fcfd01801f9e7c.1920x1080.jpg?t=1793722669"}],"movies":[{"id":257375791,"name":"Official Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257375791\/e4870682b1553e417eeeea8f13a103f052215926\/movie_600x337.jpg?t=1784515133","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4956910\/1432382953\/18ab0089aeae0df69a4fe9ec3deb43b43486a67d\/1783933356\/dash_av1.mpd?t=1784515133","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4956910\/1432382953\/18ab0089aeae0df69a4fe9ec3deb43b43486a67d\/1783933356\/dash_h264.mpd?t=1784515133","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4956910\/1432382953\/18ab0089aeae0df69a4fe9ec3deb43b43486a67d\/1783933356\/hls_264_master.m3u8?t=1784515133","highlight":true}],"release_date":{"coming_soon":false,"date":"3 Nov, 2026"},"support_info":{"url":"","email":"support@gdan.com.tw"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4956910?t=1793722669","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4956910\/cf48b2eafdaa47db0d4fcb86e8db6048f4c67287\/page_bg_raw.jpg?t=1793722669","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Violência fantasiosa"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Fantasy-Gewalt"},"igrs":{"rating_generated":"1","rating":"13","required_age":"13","banned":"0","use_age_gate":"0","descriptors":"Kekerasan"}}}}}
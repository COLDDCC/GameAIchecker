re_trailers\/5067830\/1544698932\/6a17fc1ae6ff711b79391cb95e1c86f2d9fa8530\/1786404501\/dash_av1.mpd?t=1787482543","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5067830\/1544698932\/6a17fc1ae6ff711b79391cb95e1c86f2d9fa8530\/1786404501\/dash_h264.mpd?t=1787482543","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5067830\/1544698932\/6a17fc1ae6ff711b79391cb95e1c86f2d9fa8530\/1786404501\/hls_264_master.m3u8?t=1787482543","highlight":true}],"achievements":{"total":34,"highlighted":[{"icon":"cf9510e3e7c87a7fb912d801061b352ed7bc5dfc.jpg","localized_name":"50% Hit Rate","archived":0,"hidden":0,"name":"50% Hit Rate","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/cf9510e3e7c87a7fb912d801061b352ed7bc5dfc.jpg"},{"icon":"34bfb9aedc18ad4ca373c246498a8fe4f4565998.jpg","localized_name":"8 on the Richter Scale","archived":0,"hidden":0,"name":"8 on the Richter Scale","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/34bfb9aedc18ad4ca373c246498a8fe4f4565998.jpg"},{"icon":"09ac6f585458757a5bb1ea3588da987bf7006339.jpg","localized_name":"Anomaly Hunter","archived":0,"hidden":1,"name":"Anomaly Hunter","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/09ac6f585458757a5bb1ea3588da987bf7006339.jpg"},{"icon":"f0ac8bd7d7992635e29be100db373f40d87b97df.jpg","localized_name":"Armored","archived":0,"hidden":0,"name":"Armored","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/f0ac8bd7d7992635e29be100db373f40d87b97df.jpg"},{"icon":"8e01ab58bc7c6507184737b12fb61ecdbe384483.jpg","localized_name":"Bomb Has Been Planted","archived":0,"hidden":0,"name":"Bomb Has Been Planted","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/8e01ab58bc7c6507184737b12fb61ecdbe384483.jpg"},{"icon":"d4cf7313de1220c807bda2657488ce7724dfe195.jpg","localized_name":"Bomberman","archived":0,"hidden":1,"name":"Bomberman","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/d4cf7313de1220c807bda2657488ce7724dfe195.jpg"},{"icon":"4cbbd85dc9ab3d46255d0740c5dcc0c02b76b77d.jpg","localized_name":"Collector","archived":0,"hidden":0,"name":"Collector","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/4cbbd85dc9ab3d46255d0740c5dcc0c02b76b77d.jpg"},{"icon":"aee694ffa1ddf709d9e72a173880d1ac031299ee.jpg","localized_name":"Complex Shapes","archived":0,"hidden":0,"name":"Complex Shapes","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/aee694ffa1ddf709d9e72a173880d1ac031299ee.jpg"},{"icon":"e52d26441a134bed7daeec2bf7ca0095d5b563ed.jpg","localized_name":"Crystal Factory","archived":0,"hidden":0,"name":"Crystal Factory","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/e52d26441a134bed7daeec2bf7ca0095d5b563ed.jpg"},{"icon":"3d5014137d9816e94c8e002d21d7bc18fe1000f6.jpg","localized_name":"Cut Gem","archived":0,"hidden":0,"name":"Cut Gem","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5067830\/3d5014137d9816e94c8e002d21d7bc18fe1000f6.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"https:\/\/minefieldrupture.com","email":"contact@minefieldrupture.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5067830?t=1793697045","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5067830\/3f5934edb1949b35409a9bc935cbadff768fc3f8\/page_bg_raw.jpg?t=1793697045","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"l","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"0","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"igrs":{"rating_generated
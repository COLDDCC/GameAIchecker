.jpg","localized_name":"The Final Depth","archived":0,"hidden":1,"name":"The Final Depth","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5300840\/5b809b5ae22f1fedd16ab5a76e57c99dfde12ba8.jpg"},{"icon":"4e004e8cc4d1a00b74984df64c8c83bf10ca6ca3.jpg","localized_name":"Lights out","archived":0,"hidden":0,"name":"Lights out","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5300840\/4e004e8cc4d1a00b74984df64c8c83bf10ca6ca3.jpg"},{"icon":"dfab77ed6b41a78b040ca22a7930f9453b50a9a4.jpg","localized_name":"Seeing things","archived":0,"hidden":0,"name":"Seeing things","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5300840\/dfab77ed6b41a78b040ca22a7930f9453b50a9a4.jpg"},{"icon":"27fc6884e09b0e8fc99c6c051d68bb718e9f6800.jpg","localized_name":"Apothecary","archived":0,"hidden":0,"name":"Apothecary","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5300840\/27fc6884e09b0e8fc99c6c051d68bb718e9f6800.jpg"},{"icon":"3aa624a4e686bba528df4bd3cbc3454fc404b600.jpg","localized_name":"Exterminator","archived":0,"hidden":0,"name":"Exterminator","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5300840\/3aa624a4e686bba528df4bd3cbc3454fc404b600.jpg"}]},"release_date":{"coming_soon":false,"date":"3 Nov, 2026"},"support_info":{"url":"https:\/\/x.com\/quickbigly","email":"quickbigly@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5300840?t=1793724457","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5300840\/524b6734fd3a04dea4a4ca5f6e268e014ce1286d\/page_bg_raw.jpg?t=1793724457","content_descriptors":{"ids":[5],"notes":"You can drink alcohol and smoke leaves, resulting in buffs and visual effects for your character\/experience.\r\n\r\nYou also kill goblins and skeletons and stuff."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","require
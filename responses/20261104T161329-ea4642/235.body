ed1dce63634f63b.jpg"},{"icon":"b30a1315e210059ce15d157e490bcbb5e792352a.jpg","localized_name":"Secrets of the Workshop","archived":0,"hidden":0,"name":"Secrets of the Workshop","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/b30a1315e210059ce15d157e490bcbb5e792352a.jpg"},{"icon":"eda5ea2f620ebc82f083965034acdae7536f9e40.jpg","localized_name":"Every Oddity in This Place","archived":0,"hidden":0,"name":"Every Oddity in This Place","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/eda5ea2f620ebc82f083965034acdae7536f9e40.jpg"},{"icon":"f2f8dbe177d188d8d65f76c76a878bab4ccad8d7.jpg","localized_name":"Down to the Last Stitch","archived":0,"hidden":0,"name":"Down to the Last Stitch","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/f2f8dbe177d188d8d65f76c76a878bab4ccad8d7.jpg"},{"icon":"8a9935715aeda8165538e240f94ef53d614a5dbd.jpg","localized_name":"A Familiar Starting Point","archived":0,"hidden":0,"name":"A Familiar Starting Point","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/8a9935715aeda8165538e240f94ef53d614a5dbd.jpg"},{"icon":"7083d939a20bf490d676ea7b6d7578e0072e4074.jpg","localized_name":"Make Me Whole","archived":0,"hidden":0,"name":"Make Me Whole","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/7083d939a20bf490d676ea7b6d7578e0072e4074.jpg"},{"icon":"b58c369fa59a6336aeaa073a17ef939645d0ca31.jpg","localized_name":"The Perfect Observer","archived":0,"hidden":0,"name":"The Perfect Observer","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5366230\/b58c369fa59a6336aeaa073a17ef939645d0ca31.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/game.yhdatabase.com:1443\/","email":""},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5366230?t=1793695464"
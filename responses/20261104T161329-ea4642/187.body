c4d5a0fc738ea8643be4d25f9a7500.1920x1080.jpg?t=1793711515"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5077310\/74917ff5f2b199100deabfbcfa81a902e633e792\/ss_74917ff5f2b199100deabfbcfa81a902e633e792.600x338.jpg?t=1793711515","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5077310\/74917ff5f2b199100deabfbcfa81a902e633e792\/ss_74917ff5f2b199100deabfbcfa81a902e633e792.1920x1080.jpg?t=1793711515"}],"movies":[{"id":257416087,"name":"Darrell 3D","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257416087\/9ec87b8dbce07255f34b5f2375922bfe5ed68b80\/movie_600x337.jpg?t=1793073637","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/480077169\/a6c5ba188381df3eccfdb0ebcf35e3f807701e22\/1793073075\/dash_av1.mpd?t=1793073637","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/480077169\/a6c5ba188381df3eccfdb0ebcf35e3f807701e22\/1793073075\/dash_h264.mpd?t=1793073637","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/480077169\/a6c5ba188381df3eccfdb0ebcf35e3f807701e22\/1793073075\/hls_264_master.m3u8?t=1793073637","highlight":true},{"id":257473455,"name":"Halloween Special","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257473455\/b9cfca022d6b0bdbd6969b05c574714c6c50441a\/movie_600x337.jpg?t=1793074866","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/380166151\/d4a5c6b1d4e0c646238f985ba6a4c32512bab846\/1792632037\/dash_av1.mpd?t=1793074866","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/380166151\/d4a5c6b1d4e0c646238f985ba6a4c32512bab846\/1792632037\/dash_h264.mpd?t=1793074866","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5077310\/380166151\/d4a5c6b1d4e0c646238f985ba6a4c32512bab846\/1792632037\/hls_264_master.m3u8?t=1793074866","highlight":true}],"achieve
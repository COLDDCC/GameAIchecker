36f3ac38637527cf0.jpg","localized_name":"A Place to Return","archived":0,"hidden":0,"name":"A Place to Return","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5500000\/70fcebcbbea8b033a8b703836f3ac38637527cf0.jpg"},{"icon":"dad1a713fe01d094f35e63b35c894508e4869079.jpg","localized_name":"More Than One Way Out","archived":0,"hidden":0,"name":"More Than One Way Out","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5500000\/dad1a713fe01d094f35e63b35c894508e4869079.jpg"}]},"release_date":{"coming_soon":false,"date":"3 Nov, 2026"},"support_info":{"url":"","email":"gbrs2761@outlook.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5500000?t=1793761784","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5500000?t=1793761784","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Linguagem imprópria\nAtos criminosos"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Schimpfwörte"}}}}}
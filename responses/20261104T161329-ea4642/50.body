es":[{"id":257453230,"name":"Official Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257453230\/f552882bf138c5c20adb2479558ea2ad654d9c47\/movie_600x337.jpg?t=1791909173","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/2905910\/2067630488\/352a1334f76105c71f13451bf030047a556cdd29\/1791494137\/dash_av1.mpd?t=1791909173","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/2905910\/2067630488\/352a1334f76105c71f13451bf030047a556cdd29\/1791494137\/dash_h264.mpd?t=1791909173","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/2905910\/2067630488\/352a1334f76105c71f13451bf030047a556cdd29\/1791494137\/hls_264_master.m3u8?t=1791909173","highlight":true}],"achievements":{"total":100,"highlighted":[{"icon":"6f7f8bbb7dd2f434316245ad102d43052e178c15.jpg","localized_name":"First Shovel","archived":0,"hidden":0,"name":"First Shovel","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/2905910\/6f7f8bbb7dd2f434316245ad102d43052e178c15.jpg"},{"icon":"1c755d07c4155ce72552f5d8eb215089b7f301f3.jpg","localized_name":"Excavator","archived":0,"hidden":0,"name":"Excavator","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/2905910\/1c755d07c4155ce72552f5d8eb215089b7f301f3.jpg"},{"icon":"7b79a98722ea39ec6a1661ec0a00fd12f81adac4.jpg","localized_name":"Mole","archived":0,"hidden":0,"name":"Mole","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/2905910\/7b79a98722ea39ec6a1661ec0a00fd12f81adac4.jpg"},{"icon":"ece97c98e0b079a93b5ab7eb4d995f65f84707d2.jpg","localized_name":"Concrete Mixer","archived":0,"hidden":0,"name":"Concrete Mixer","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/2905910\/ece97c98e0b079a93b5ab7eb4d995f65f84707d2.jpg"},{"icon":"f0378193a9c8bd16f2e59d1b02c8b2028d5524cd.jpg","localized_name":"It Flows","archived":0,"hidden":0,"name":"It Flows","path":"https:
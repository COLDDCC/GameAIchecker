ense":"0","is_free_license":false,"price_in_cents_with_discount":733}]}],"platforms":{"windows":true,"mac":false,"linux":false},"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":68,"description":"Custom Volume Controls"},{"id":69,"description":"Stereo Sound"},{"id":62,"description":"Family Sharing"}],"genres":[{"id":"1","description":"Action"},{"id":"25","description":"Adventure"},{"id":"23","description":"Indie"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/48b2702ede3f4890505b5060275cb433ea5e7837\/ss_48b2702ede3f4890505b5060275cb433ea5e7837.600x338.jpg?t=1793682074","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/48b2702ede3f4890505b5060275cb433ea5e7837\/ss_48b2702ede3f4890505b5060275cb433ea5e7837.1920x1080.jpg?t=1793682074"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/c3aa1d9a203574406d1fd926cd30f91eb65ac62f\/ss_c3aa1d9a203574406d1fd926cd30f91eb65ac62f.600x338.jpg?t=1793682074","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/c3aa1d9a203574406d1fd926cd30f91eb65ac62f\/ss_c3aa1d9a203574406d1fd926cd30f91eb65ac62f.1920x1080.jpg?t=1793682074"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/8d91438645a4b5903ff8718efe660919bca0ac83\/ss_8d91438645a4b5903ff8718efe660919bca0ac83.600x338.jpg?t=1793682074","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/8d91438645a4b5903ff8718efe660919bca0ac83\/ss_8d91438645a4b5903ff8718efe660919bca0ac83.1920x1080.jpg?t=1793682074"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4611110\/3e12419b74ad72af257cd9f737688829d4761ed7\/ss_3e12419b74ad72af257cd9f737688829d4761ed7.600x338.jpg?t=1793682074","p
"name":"The Real Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257469845\/8a387d82fa56bb923154a596979f82f63e5f1e3a\/movie_600x337.jpg?t=1792449546","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5073660\/1426626869\/dd4f1283e5590b17d7c59f13d221a7f74e0511dd\/1792449124\/dash_av1.mpd?t=1792449546","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5073660\/1426626869\/dd4f1283e5590b17d7c59f13d221a7f74e0511dd\/1792449124\/dash_h264.mpd?t=1792449546","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5073660\/1426626869\/dd4f1283e5590b17d7c59f13d221a7f74e0511dd\/1792449124\/hls_264_master.m3u8?t=1792449546","highlight":true}],"achievements":{"total":18,"highlighted":[{"icon":"0d8a28b895c38c338c7f19387f813b81feffe6fb.jpg","localized_name":"Organs of the Blood God","archived":0,"hidden":0,"name":"Organs of the Blood God","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/0d8a28b895c38c338c7f19387f813b81feffe6fb.jpg"},{"icon":"da1f8ae27d4a97aac758cf08f32d810d6222f4a0.jpg","localized_name":"Wake the blood god","archived":0,"hidden":0,"name":"Wake the blood god","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/da1f8ae27d4a97aac758cf08f32d810d6222f4a0.jpg"},{"icon":"79d64814216dad9a96c98575daedb58cf23ef616.jpg","localized_name":"First Blood","archived":0,"hidden":0,"name":"First Blood","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/79d64814216dad9a96c98575daedb58cf23ef616.jpg"},{"icon":"07b8c7506bca39fad6cccc1021111ab0fcbb544d.jpg","localized_name":"Unpaid Internship","archived":0,"hidden":0,"name":"Unpaid Internship","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/07b8c7506bca39fad6cccc1021111ab0fcbb544d.jpg"},{"icon":"b0711f9f529b662f435cc74da006f5c5d92aab18.jpg","localized_name":"Middle Management","archived":0,"hidden":0,"name":"Middle Management","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/b0711f9f529b662f435cc74da006f5c5d92aab18.jpg"},{"icon":"c48e0887fa89d1a3ac9553fa113aa85f04838d47.jpg","localized_name":"Growth Industry","archived":0,"hidden":0,"name":"Growth Industry","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/c48e0887fa89d1a3ac9553fa113aa85f04838d47.jpg"},{"icon":"2e4e50231996b9a4ef107cc9176acdc92f7394b7.jpg","localized_name":"Six Pack","archived":0,"hidden":0,"name":"Six Pack","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/2e4e50231996b9a4ef107cc9176acdc92f7394b7.jpg"},{"icon":"09d61b13aaa3f19bb9265a005fd3a54f4a9210e6.jpg","localized_name":"Locally Sourced","archived":0,"hidden":0,"name":"Locally Sourced","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/09d61b13aaa3f19bb9265a005fd3a54f4a9210e6.jpg"},{"icon":"748554f7ab881e9c6824c2b9d41fd89bf15a7d08.jpg","localized_name":"Product Launch","archived":0,"hidden":0,"name":"Product Launch","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/748554f7ab881e9c6824c2b9d41fd89bf15a7d08.jpg"},{"icon":"ef99098cad36d60e9dae813c48d0437e6760c0e9.jpg","localized_name":"Quality Control","archived":0,"hidden":0,"name":"Quality Control","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5073660\/ef99098cad36d60e9dae813c48d0437e6760c0e9.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/noanim.com\/","email":"support@noanim.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5073660?t=1793721032","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5073660\/4fd5d4d38350141cf83846efb63865530dbb21c3\/page_bg_raw.jpg?t=1793721032","content_descriptors":{"ids":[2,5],"notes":"VampOS is a vampire management game featuring recurring mature themes. Gameplay contains text- and UI-based references to killing and abducting humans, human trafficking, hypnotizing people into thralls, harvesting and consuming blood, recovering and processing dead bodies, and conducting organized crime.  \r\nThe game also contains prominent stylized body-horror imagery featuring blood, skulls, flesh-like structures, and occult themes. Violence is generally represented through menus, resource counters, and written operation descriptions rather than animated combat."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Violência\nAtos criminosos"},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Drastische Gewalt"}}}}}
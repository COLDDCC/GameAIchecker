60\/b163d720cce184d002e10e56c11d95b0997fd2a2\/ss_b163d720cce184d002e10e56c11d95b0997fd2a2.1920x1080.jpg?t=1793736396"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/844eaf4e3328e90d5f8af40e719b8acdf3d2b903\/ss_844eaf4e3328e90d5f8af40e719b8acdf3d2b903.600x338.jpg?t=1793736396","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/844eaf4e3328e90d5f8af40e719b8acdf3d2b903\/ss_844eaf4e3328e90d5f8af40e719b8acdf3d2b903.1920x1080.jpg?t=1793736396"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/79d42a8a370d278934fe272cf4e4500f90889572\/ss_79d42a8a370d278934fe272cf4e4500f90889572.600x338.jpg?t=1793736396","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/79d42a8a370d278934fe272cf4e4500f90889572\/ss_79d42a8a370d278934fe272cf4e4500f90889572.1920x1080.jpg?t=1793736396"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/5f9061c9037fa915b643ce33c143aa99d7fbd19e\/ss_5f9061c9037fa915b643ce33c143aa99d7fbd19e.600x338.jpg?t=1793736396","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/5f9061c9037fa915b643ce33c143aa99d7fbd19e\/ss_5f9061c9037fa915b643ce33c143aa99d7fbd19e.1920x1080.jpg?t=1793736396"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/a37949eea8828dc9919bb4ace39b5bd3fd6f6ac0\/ss_a37949eea8828dc9919bb4ace39b5bd3fd6f6ac0.600x338.jpg?t=1793736396","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/a37949eea8828dc9919bb4ace39b5bd3fd6f6ac0\/ss_a37949eea8828dc9919bb4ace39b5bd3fd6f6ac0.1920x1080.jpg?t=1793736396"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5415860\/7376bc97314c1e4b80a1c153f34eae42019e6b1a\/ss_7376bc9
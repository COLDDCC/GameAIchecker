333ac951.600x338.jpg?t=1793732282","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5176710\/3c25ba448df8403b3f4b967378345c33333ac951\/ss_3c25ba448df8403b3f4b967378345c33333ac951.1920x1080.jpg?t=1793732282"}],"movies":[{"id":257490226,"name":"Be a Pirate! Launch Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257490226\/0515f0bd9f76024a0035a47edab5ea5c5ebf3e74\/movie_600x337.jpg?t=1793732221","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/605265591\/9a939681c842859e8aca960bc60f2899e21d3627\/1793723278\/dash_av1.mpd?t=1793732221","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/605265591\/9a939681c842859e8aca960bc60f2899e21d3627\/1793723278\/dash_h264.mpd?t=1793732221","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/605265591\/9a939681c842859e8aca960bc60f2899e21d3627\/1793723278\/hls_264_master.m3u8?t=1793732221","highlight":true},{"id":257426091,"name":"Be a Pirate! ","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257426091\/3899ba1d0b0b6916b8637a84a9bc919b86d4fec2\/movie_600x337.jpg?t=1793732222","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/313634253\/2f814859f214ad1ecc62b1c22fbb64d630c42d08\/1789512471\/dash_av1.mpd?t=1793732222","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/313634253\/2f814859f214ad1ecc62b1c22fbb64d630c42d08\/1789512471\/dash_h264.mpd?t=1793732222","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5176710\/313634253\/2f814859f214ad1ecc62b1c22fbb64d630c42d08\/1789512471\/hls_264_master.m3u8?t=1793732222","highlight":true}],"achievements":{"total":74,"highlighted":[{"icon":"83deefb10878229ee4cb24e28070f3a2faf32a9e.jpg","localized_name":"Find the Quartermaster","archived":0,"hidden":0,"name":"Find the Quartermaster","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/83deefb10878229ee4cb24e28070f3a2faf32a9e.jpg"},{"icon":"bac5f1880046f36386c8896afeb794c9bf94e1f0.jpg","localized_name":"Saltmother's Eye","archived":0,"hidden":0,"name":"Saltmother's Eye","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/bac5f1880046f36386c8896afeb794c9bf94e1f0.jpg"},{"icon":"057a5e53897dfb433c88c729dc3e968f21a3858a.jpg","localized_name":"Won't Stay Dead","archived":0,"hidden":0,"name":"Won't Stay Dead","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/057a5e53897dfb433c88c729dc3e968f21a3858a.jpg"},{"icon":"244912215c4db1e1c8d4cc82d5c2d14e99d88881.jpg","localized_name":"Sea Monster Trouble","archived":0,"hidden":0,"name":"Sea Monster Trouble","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/244912215c4db1e1c8d4cc82d5c2d14e99d88881.jpg"},{"icon":"35625743df7be5ba1b93ddc30a107f21d76e4b83.jpg","localized_name":"More Arms Than Any Man","archived":0,"hidden":0,"name":"More Arms Than Any Man","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/35625743df7be5ba1b93ddc30a107f21d76e4b83.jpg"},{"icon":"672b190f61cea6c345e72597be50552e3fdeca4c.jpg","localized_name":"Foolish. Brave.","archived":0,"hidden":0,"name":"Foolish. Brave.","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/672b190f61cea6c345e72597be50552e3fdeca4c.jpg"},{"icon":"fcf44ec083b23ff82e2537f21167ec0bbab68aa3.jpg","localized_name":"Last of Darkmoor","archived":0,"hidden":0,"name":"Last of Darkmoor","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/fcf44ec083b23ff82e2537f21167ec0bbab68aa3.jpg"},{"icon":"199ced7b85343c4df6c4cda0374328331efa676c.jpg","localized_name":"The Voice in the Tale","archived":0,"hidden":1,"name":"The Voice in the Tale","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/199ced7b85343c4df6c4cda0374328331efa676c.jpg"},{"icon":"746c68722143a9b1f466f8f0be44a19f2f8799d9.jpg","localized_name":"No Kings. No Chains.","archived":0,"hidden":1,"name":"No Kings. No Chains.","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/746c68722143a9b1f466f8f0be44a19f2f8799d9.jpg"},{"icon":"4ca7da00f357029b028cb33bc3c589a7655e9ba8.jpg","localized_name":"Earned Your Stripes","archived":0,"hidden":0,"name":"Earned Your Stripes","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5176710\/4ca7da00f357029b028cb33bc3c589a7655e9ba8.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"NobleRogues@darkmoor.org"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5176710?t=1793732282","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5176710\/eaf50e4420a07cb4c352c47b340a8894b6574620\/page_bg_raw.jpg?t=1793732282","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Violência fantasiosa"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Fantasy-Gewalt"}}}}}
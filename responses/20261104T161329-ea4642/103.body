8296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/e168217ed480519b431559c7a3310e01ccbce15f\/ss_e168217ed480519b431559c7a3310e01ccbce15f.1920x1080.jpg?t=1793728296"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/cad7327a68b40235ea3b580f67d7f5dc51a102ac\/ss_cad7327a68b40235ea3b580f67d7f5dc51a102ac.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/cad7327a68b40235ea3b580f67d7f5dc51a102ac\/ss_cad7327a68b40235ea3b580f67d7f5dc51a102ac.1920x1080.jpg?t=1793728296"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/4bfbd52c7ec2ccf602490f32aa347dd564a7e022\/ss_4bfbd52c7ec2ccf602490f32aa347dd564a7e022.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/4bfbd52c7ec2ccf602490f32aa347dd564a7e022\/ss_4bfbd52c7ec2ccf602490f32aa347dd564a7e022.1920x1080.jpg?t=1793728296"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/017fdecbc8e709889bb7795f7bde917ee9503424\/ss_017fdecbc8e709889bb7795f7bde917ee9503424.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/017fdecbc8e709889bb7795f7bde917ee9503424\/ss_017fdecbc8e709889bb7795f7bde917ee9503424.1920x1080.jpg?t=1793728296"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/c7fa86c6859a52d5783131d374717586b4c3e9dc\/ss_c7fa86c6859a52d5783131d374717586b4c3e9dc.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/c7fa86c6859a52d5783131d374717586b4c3e9dc\/ss_c7fa86c6859a52d5783131d374717586b4c3e9dc.1920x1080.jpg?t=1793728296"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/f1f47130c2c1ccd730d54fd7f3daef5e02fb48a1\/ss_f1f47130c2c1ccd730d54fd7f3daef5e02fb48a1.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/f1f47130c2c1ccd730d54fd7f3daef5e02fb48a1\/ss_f1f47130c2c1ccd730d54fd7f3daef5e02fb48a1.1920x1080.jpg?t=1793728296"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/b1513420ee808040e9d8196d841c216627f5d0fe\/ss_b1513420ee808040e9d8196d841c216627f5d0fe.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/b1513420ee808040e9d8196d841c216627f5d0fe\/ss_b1513420ee808040e9d8196d841c216627f5d0fe.1920x1080.jpg?t=1793728296"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/293f180970f246026cdceea4df6fd07566aa5403\/ss_293f180970f246026cdceea4df6fd07566aa5403.600x338.jpg?t=1793728296","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4641930\/293f180970f246026cdceea4df6fd07566aa5403\/ss_293f180970f246026cdceea4df6fd07566aa5403.1920x1080.jpg?t=1793728296"}],"movies":[{"id":257343713,"name":"DeadWeight A Lullaby Announcement Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257343713\/b35a7d0a0ce6a41734d2d1477ebaf6d2028d7894\/movie_600x337.jpg?t=1779879191","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4641930\/1509841560\/b362b173883382f75d35d8a8726e32b3fd22ca93\/1779879008\/dash_av1.mpd?t=1779879191","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4641930\/1509841560\/b362b173883382f75d35d8a8726e32b3fd22ca93\/1779879008\/dash_h264.mpd?t=1779879191","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4641930\/1509841560\/b362b173883382f75d35d8a8726e32b3fd22ca93\/1779879008\/hls_264_master.m3u8?t=1779879191","h
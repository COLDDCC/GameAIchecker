\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/03c61f9727bca0b34991b29d3e2b4978dbb6a87e.jpg"},{"icon":"e606ccba16ef3052e1f7ce287dd13d561c8919c6.jpg","localized_name":"Hundred Million Man","archived":0,"hidden":0,"name":"Hundred Million Man","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/e606ccba16ef3052e1f7ce287dd13d561c8919c6.jpg"},{"icon":"56a8112f5a663d753a3a7f006291a4b9b1507666.jpg","localized_name":"Billionaire","archived":0,"hidden":0,"name":"Billionaire","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/56a8112f5a663d753a3a7f006291a4b9b1507666.jpg"},{"icon":"f0377f16e89373a273d1e45bee0db47633ac38cf.jpg","localized_name":"Trillionaire","archived":0,"hidden":0,"name":"Trillionaire","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/f0377f16e89373a273d1e45bee0db47633ac38cf.jpg"},{"icon":"428007a83d053fa43f25f338ab39dd09943891db.jpg","localized_name":"Fresh Start","archived":0,"hidden":0,"name":"Fresh Start","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/428007a83d053fa43f25f338ab39dd09943891db.jpg"},{"icon":"ec2a7300e2347cf6467ce642fc9fbdd7965ceaa2.jpg","localized_name":"Cycle Master","archived":0,"hidden":0,"name":"Cycle Master","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/ec2a7300e2347cf6467ce642fc9fbdd7965ceaa2.jpg"},{"icon":"36335b5f48c911fc36c1b953098f9a36de42a34f.jpg","localized_name":"Eternal Trader","archived":0,"hidden":0,"name":"Eternal Trader","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/36335b5f48c911fc36c1b953098f9a36de42a34f.jpg"},{"icon":"099ee616b66c3939e67816f09e037b4858d3dea6.jpg","localized_name":" IPO Master","archived":0,"hidden":0,"name":" IPO Master","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/099ee616b66c3939e67816f09e037b4858d3dea6.jpg"},{"icon":"21ea52c061b6028b01f1ea8b23b3a28f9427395f.jpg","localized_name":"Warming Up","archived":0,"hidden":0,"name":"Warming Up","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/21ea52c061b6028b01f1ea8b23b3a28f9427395f.jpg"},{"icon":"b6c1bb1897893b157534661db22ab6e3ea41daea.jpg","localized_name":" Hyperactive","archived":0,"hidden":0,"name":" Hyperactive","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4738620\/b6c1bb1897893b157534661db22ab6e3ea41daea.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"wallstreettycoonclickers@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4738620?t=1793696532","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4738620\/10db3f35696679b638ccec92961a7c5d25870010\/page_bg_raw.jpg?t=1793696532","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":""},"igrs":{"rating_generated":"1","rating":"18","required_age":"18","banned":"0","use_age_gate":"0","descriptors":"Simulasi dan\/atau kegiatan judi"}}}}}
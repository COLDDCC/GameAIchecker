?t=1793705232","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/0aaf8cc0ee371602b60f06574afc6e6ae2296e76\/ss_0aaf8cc0ee371602b60f06574afc6e6ae2296e76.1920x1080.jpg?t=1793705232"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/fc249902d4227023bc053a7348bb79f38eaf2253\/ss_fc249902d4227023bc053a7348bb79f38eaf2253.600x338.jpg?t=1793705232","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/fc249902d4227023bc053a7348bb79f38eaf2253\/ss_fc249902d4227023bc053a7348bb79f38eaf2253.1920x1080.jpg?t=1793705232"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/faaaeaf83bc953a76da36bbe697cbf4e7a5e7532\/ss_faaaeaf83bc953a76da36bbe697cbf4e7a5e7532.600x338.jpg?t=1793705232","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/faaaeaf83bc953a76da36bbe697cbf4e7a5e7532\/ss_faaaeaf83bc953a76da36bbe697cbf4e7a5e7532.1920x1080.jpg?t=1793705232"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/7c26ea79c7f8a4e41c8da6e9444731f87baa6cac\/ss_7c26ea79c7f8a4e41c8da6e9444731f87baa6cac.600x338.jpg?t=1793705232","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/7c26ea79c7f8a4e41c8da6e9444731f87baa6cac\/ss_7c26ea79c7f8a4e41c8da6e9444731f87baa6cac.1920x1080.jpg?t=1793705232"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/1b4825726584268e15ccc2bd11043905021d9001\/ss_1b4825726584268e15ccc2bd11043905021d9001.600x338.jpg?t=1793705232","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4616300\/1b4825726584268e15ccc2bd11043905021d9001\/ss_1b4825726584268e15ccc2bd11043905021d9001.1920x1080.jpg?t=1793705232"},{"id":14,"path_thumbnail":"https:\/\/shared.akamai.
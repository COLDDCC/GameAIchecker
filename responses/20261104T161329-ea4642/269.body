munity_assets\/images\/apps\/4879410\/68bcc8ce63ae27f196580df003e09a2ab895cdf7.jpg"},{"icon":"f554d62ed943ae259e9f19190fcff895e95a8db3.jpg","localized_name":"Head of Discharge","archived":0,"hidden":0,"name":"Head of Discharge","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/f554d62ed943ae259e9f19190fcff895e95a8db3.jpg"},{"icon":"e2ee54296471579f0d81e2dc74d72cf23ffb33b6.jpg","localized_name":"Hospital Legend","archived":0,"hidden":0,"name":"Hospital Legend","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/e2ee54296471579f0d81e2dc74d72cf23ffb33b6.jpg"},{"icon":"68bcc8ce63ae27f196580df003e09a2ab895cdf7.jpg","localized_name":"Visiting Hours Over","archived":0,"hidden":0,"name":"Visiting Hours Over","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/68bcc8ce63ae27f196580df003e09a2ab895cdf7.jpg"},{"icon":"f554d62ed943ae259e9f19190fcff895e95a8db3.jpg","localized_name":"Security Called","archived":0,"hidden":0,"name":"Security Called","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/f554d62ed943ae259e9f19190fcff895e95a8db3.jpg"},{"icon":"e2ee54296471579f0d81e2dc74d72cf23ffb33b6.jpg","localized_name":"No Visitors Allowed","archived":0,"hidden":0,"name":"No Visitors Allowed","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/e2ee54296471579f0d81e2dc74d72cf23ffb33b6.jpg"},{"icon":"f554d62ed943ae259e9f19190fcff895e95a8db3.jpg","localized_name":"Outbreak Contained","archived":0,"hidden":0,"name":"Outbreak Contained","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/f554d62ed943ae259e9f19190fcff895e95a8db3.jpg"},{"icon":"e2ee54296471579f0d81e2dc74d72cf23ffb33b6.jpg","localized_name":"Epidemiologist","archived":0,"hidden":0,"name":"Epidemiologist","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4879410\/e2ee54
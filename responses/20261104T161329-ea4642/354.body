\/community_assets\/images\/apps\/4656440\/ff3e2cb96c0c265e66d4190ce7839b519520079c.jpg"},{"icon":"a1ddc4d5b3cb1840b74ab29d90efec194bca2493.jpg","localized_name":"Expanding the Repertoire","archived":0,"hidden":0,"name":"Expanding the Repertoire","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/a1ddc4d5b3cb1840b74ab29d90efec194bca2493.jpg"},{"icon":"b1e007790f1f7beda3072a684888f9e88ce2eb37.jpg","localized_name":"4′33″","archived":0,"hidden":0,"name":"4′33″","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/b1e007790f1f7beda3072a684888f9e88ce2eb37.jpg"},{"icon":"5a5486bbeb88c8a916c3c547b192bf3af73f9ca2.jpg","localized_name":"Muscle Memory","archived":0,"hidden":0,"name":"Muscle Memory","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/5a5486bbeb88c8a916c3c547b192bf3af73f9ca2.jpg"},{"icon":"caf24d2fb415d48d765fd180d44f6df64f7cb44f.jpg","localized_name":"Rudimentary, my dear Watson!","archived":0,"hidden":0,"name":"Rudimentary, my dear Watson!","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/caf24d2fb415d48d765fd180d44f6df64f7cb44f.jpg"},{"icon":"09fd99593770127b600ddaca832833c6727362df.jpg","localized_name":"Internal Clock","archived":0,"hidden":0,"name":"Internal Clock","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/09fd99593770127b600ddaca832833c6727362df.jpg"},{"icon":"44bd2daf9c735504cadfe1bad0eb9a878f601454.jpg","localized_name":"The Vanguard Drumline","archived":0,"hidden":0,"name":"The Vanguard Drumline","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4656440\/44bd2daf9c735504cadfe1bad0eb9a878f601454.jpg"},{"icon":"1e1bba1042f582de3401f60708da2adc2647bb30.jpg","localized_name":"Stick Bag Packed","archived":0,"hidden":0,"name":"Stick Bag Packed","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/46
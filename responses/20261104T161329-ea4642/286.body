5072\/hls_264_master.m3u8?t=1792082435","highlight":true}],"achievements":{"total":30,"highlighted":[{"icon":"7fc6e828c9d2209d3b366ff6eece02ecab495ad0.jpg","localized_name":"Every Hand at Work","archived":0,"hidden":0,"name":"Every Hand at Work","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/7fc6e828c9d2209d3b366ff6eece02ecab495ad0.jpg"},{"icon":"5ed8a4b78e4ad30e3c85c07ba2fd7e014ae033e6.jpg","localized_name":"Open for Business","archived":0,"hidden":0,"name":"Open for Business","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/5ed8a4b78e4ad30e3c85c07ba2fd7e014ae033e6.jpg"},{"icon":"e388cef7991e837d5fc1a0848c1b4c9980ee4da5.jpg","localized_name":"Growing Fellowship","archived":0,"hidden":0,"name":"Growing Fellowship","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/e388cef7991e837d5fc1a0848c1b4c9980ee4da5.jpg"},{"icon":"24a92a5f651c2752633121f351760e03c7e289a2.jpg","localized_name":"Mountain Sect","archived":0,"hidden":0,"name":"Mountain Sect","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/24a92a5f651c2752633121f351760e03c7e289a2.jpg"},{"icon":"93c860fd55015889c3dad10ca491011bdcc39512.jpg","localized_name":"Renowned Sect","archived":0,"hidden":0,"name":"Renowned Sect","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/93c860fd55015889c3dad10ca491011bdcc39512.jpg"},{"icon":"a1a14faedbb045d3fcee8a9076fa8dc5dd80d78e.jpg","localized_name":"Immortal Sect","archived":0,"hidden":0,"name":"Immortal Sect","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/a1a14faedbb045d3fcee8a9076fa8dc5dd80d78e.jpg"},{"icon":"27c0b22d24848a46ed160ffc64e93a62ecd852d3.jpg","localized_name":"Firm Foundations","archived":0,"hidden":0,"name":"Firm Foundations","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5422950\/27c0b22d
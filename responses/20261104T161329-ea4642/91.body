6\/ss_651845f79d60ed54a1d3db9821c7f9a715019656.1920x1080.jpg?t=1793728816"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5101960\/90096d5ae72170777da2adac2ec8add86be35d6d\/ss_90096d5ae72170777da2adac2ec8add86be35d6d.600x338.jpg?t=1793728816","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5101960\/90096d5ae72170777da2adac2ec8add86be35d6d\/ss_90096d5ae72170777da2adac2ec8add86be35d6d.1920x1080.jpg?t=1793728816"}],"movies":[{"id":257415933,"name":"Dungeons & Dynasties","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257415933\/21632a8a3826a472aa2ea297ab2d54e4afe05606\/movie_600x337.jpg?t=1791495491","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5101960\/2123524894\/c71fa433a5434be5af426b6f874d9cb462bd7a3e\/1791495127\/dash_av1.mpd?t=1791495491","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5101960\/2123524894\/c71fa433a5434be5af426b6f874d9cb462bd7a3e\/1791495127\/dash_h264.mpd?t=1791495491","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5101960\/2123524894\/c71fa433a5434be5af426b6f874d9cb462bd7a3e\/1791495127\/hls_264_master.m3u8?t=1791495491","highlight":true}],"achievements":{"total":100,"highlighted":[{"icon":"a3dfdfbce235e608226785ff640cb9e2472b0129.jpg","localized_name":"The Wall Holds","archived":0,"hidden":0,"name":"The Wall Holds","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/a3dfdfbce235e608226785ff640cb9e2472b0129.jpg"},{"icon":"f567e28137a78add13b8854c0a2172cd6d7b73b5.jpg","localized_name":"Nobody Falls Today","archived":0,"hidden":0,"name":"Nobody Falls Today","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/f567e28137a78add13b8854c0a2172cd6d7b73b5.jpg"},{"icon":"c5a9916d4feeac0916470255318f93c84a9c312d.jpg","localized_name":"Pillar of the Hall","archived":0,"hidden":0,"name":"Pillar of the Hall","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/c5a9916d4feeac0916470255318f93c84a9c312d.jpg"},{"icon":"ad17ca9aea77e68bff5a0341aea77aa642592592.jpg","localized_name":"Three Heroics","archived":0,"hidden":0,"name":"Three Heroics","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/ad17ca9aea77e68bff5a0341aea77aa642592592.jpg"},{"icon":"45be256cdfdf33c1ac0ad5144e91330667f29c20.jpg","localized_name":"Another One Bites the Dust","archived":0,"hidden":0,"name":"Another One Bites the Dust","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/45be256cdfdf33c1ac0ad5144e91330667f29c20.jpg"},{"icon":"b268963a751b3913110be7c9f6038ef314e081dd.jpg","localized_name":"Slaughterhouse","archived":0,"hidden":0,"name":"Slaughterhouse","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/b268963a751b3913110be7c9f6038ef314e081dd.jpg"},{"icon":"fb05cf32a8fde56b8fa6e16856c5ebec836126ca.jpg","localized_name":"That's a Safe Road","archived":0,"hidden":0,"name":"That's a Safe Road","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/fb05cf32a8fde56b8fa6e16856c5ebec836126ca.jpg"},{"icon":"9298d433be04999d2457a4beb757124a6867f3ba.jpg","localized_name":"Galord the Warden","archived":0,"hidden":0,"name":"Galord the Warden","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/9298d433be04999d2457a4beb757124a6867f3ba.jpg"},{"icon":"cb17259a6c644e7766581f37a73e719ae5476171.jpg","localized_name":"Breach of Lease","archived":0,"hidden":0,"name":"Breach of Lease","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/cb17259a6c644e7766581f37a73e719ae5476171.jpg"},{"icon":"9f08d81ef6cb10c0de884f1e476bef6fc9a64a25.jpg","localized_name":"F","archived":0,"hidden":0,"name":"F","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5101960\/9f08d81ef6cb10c0de884f1e476bef6fc9a64a25.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"contact@surefire.games"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5101960?t=1793728816","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5101960\/9861ec6435692da8cfc7981f3c7e02b13ec79f65\/page_bg_raw.jpg?t=1793728816","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"l","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"0","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""}}}}}
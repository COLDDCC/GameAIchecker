c.com\/store_item_assets\/steam\/apps\/5232130\/0e8e6b7bcf84a77419d3fcbc6e15f61b72f005f4\/ss_0e8e6b7bcf84a77419d3fcbc6e15f61b72f005f4.1920x1080.jpg?t=1793674906"}],"movies":[{"id":257460803,"name":"KanaCrossTogether","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257460803\/9cc1eff05c3077b7c21af7f1543256349f4699cc\/movie_600x337.jpg?t=1792580651","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5232130\/1430690129\/0c47f0e1e95c19ce1e3461fe34d2d36abc41b5f0\/1792067457\/dash_av1.mpd?t=1792580651","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5232130\/1430690129\/0c47f0e1e95c19ce1e3461fe34d2d36abc41b5f0\/1792067457\/dash_h264.mpd?t=1792580651","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5232130\/1430690129\/0c47f0e1e95c19ce1e3461fe34d2d36abc41b5f0\/1792067457\/hls_264_master.m3u8?t=1792580651","highlight":true}],"release_date":{"coming_soon":false,"date":"2 Nov, 2026"},"support_info":{"url":"","email":"chottosoft@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5232130?t=1793674906","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5232130\/7920dd354dc358c15c02907ebfb2d39b481461aa\/page_bg_raw.jpg?t=1793674906","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"l","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"0","required_age":"0","banned":"0","use_age_gate":"0","descriptors":""}}}}}
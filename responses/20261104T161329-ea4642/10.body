_license":false,"price_in_cents_with_discount":350}]}],"platforms":{"windows":true,"mac":false,"linux":false},"categories":[{"id":2,"description":"Single-player"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}],"genres":[{"id":"23","description":"Indie"},{"id":"3","description":"RPG"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/f0eb765718fa6502f9a56cffba4b58d4303d253e\/ss_f0eb765718fa6502f9a56cffba4b58d4303d253e.600x338.jpg?t=1793759837","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/f0eb765718fa6502f9a56cffba4b58d4303d253e\/ss_f0eb765718fa6502f9a56cffba4b58d4303d253e.1920x1080.jpg?t=1793759837"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/6a804a11ef1769c7555e54615ac672c5c47e1115\/ss_6a804a11ef1769c7555e54615ac672c5c47e1115.600x338.jpg?t=1793759837","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/6a804a11ef1769c7555e54615ac672c5c47e1115\/ss_6a804a11ef1769c7555e54615ac672c5c47e1115.1920x1080.jpg?t=1793759837"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/727d5f47220ba625890a528bbf09035f2b36e934\/ss_727d5f47220ba625890a528bbf09035f2b36e934.600x338.jpg?t=1793759837","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/727d5f47220ba625890a528bbf09035f2b36e934\/ss_727d5f47220ba625890a528bbf09035f2b36e934.1920x1080.jpg?t=1793759837"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/d0a849d406050ab67bec3d5842ce0543c4844f00\/ss_d0a849d406050ab67bec3d5842ce0543c4844f00.600x338.jpg?t=1793759837","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4619940\/d0a849d406050ab67bec3d5842ce0543c4844f00\/ss_d0a849d406050ab6
d":[{"icon":"0cc4e28c27b8d3795a3d5fc66588b7484252e151.jpg","localized_name":"And So It Begins","archived":0,"hidden":0,"name":"And So It Begins","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/0cc4e28c27b8d3795a3d5fc66588b7484252e151.jpg"},{"icon":"b25c8637626c8d510936da9afa02c7c4cd3ff62a.jpg","localized_name":"Gainfully Employed","archived":0,"hidden":0,"name":"Gainfully Employed","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/b25c8637626c8d510936da9afa02c7c4cd3ff62a.jpg"},{"icon":"f8e6a5bd53297aa7f4e375b4947608f9a6cac3e1.jpg","localized_name":"First Trophy","archived":0,"hidden":0,"name":"First Trophy","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/f8e6a5bd53297aa7f4e375b4947608f9a6cac3e1.jpg"},{"icon":"71e330d62a57259b79b3be01a20ad2539510713a.jpg","localized_name":"Field Notes","archived":0,"hidden":0,"name":"Field Notes","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/71e330d62a57259b79b3be01a20ad2539510713a.jpg"},{"icon":"0ce265523875e52ea6cf0086242396b2bdf752fd.jpg","localized_name":"Naturalist of the Strange","archived":0,"hidden":0,"name":"Naturalist of the Strange","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/0ce265523875e52ea6cf0086242396b2bdf752fd.jpg"},{"icon":"07501f50a86d3deff665d15021b188d20647ba8e.jpg","localized_name":"Let It Go","archived":0,"hidden":0,"name":"Let It Go","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/07501f50a86d3deff665d15021b188d20647ba8e.jpg"},{"icon":"02a885c4a1b7642de6c8527a42b35cafc64dfa67.jpg","localized_name":"Direct Deposit","archived":0,"hidden":0,"name":"Direct Deposit","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/02a885c4a1b7642de6c8527a42b35cafc64dfa67.jpg"},{"icon":"ce75f5f64079d6d5199fb077fdf781419c0c823d.jpg","localized_name":" Not Entirely Alone","archived":0,"hidden":0,"name":" Not Entirely Alone","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/ce75f5f64079d6d5199fb077fdf781419c0c823d.jpg"},{"icon":"cb5a9726713c8588031477ca86faf4fc9eb1870d.jpg","localized_name":"Old Enough To Know Better","archived":0,"hidden":0,"name":"Old Enough To Know Better","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/cb5a9726713c8588031477ca86faf4fc9eb1870d.jpg"},{"icon":"d553b62871627d8fb1385df8fc2e566b5a46eaad.jpg","localized_name":"Keys To Something","archived":0,"hidden":0,"name":"Keys To Something","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5328780\/d553b62871627d8fb1385df8fc2e566b5a46eaad.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"kratzy.games@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5328780?t=1793707416","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5328780\/359fb67b6269116b040e21c11f5873ed33a7aa07\/page_bg_raw.jpg?t=1793707416","content_descriptors":{"ids":[5],"notes":"Tiny Lives is a text-based life simulation with optional mature themes. Players can commit crimes including theft, robbery, fraud, and extortion; work for a crime family; take a career as a contract killer; and fight supernatural creatures. Violence is described in text only, with no graphic imagery or gore. The game includes alcohol and drug use, addiction, gambling with in-game currency (no real money), death and grief, divorce, and prison. There is no sexual content or nudity."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Drogas ilícitas\nAtos criminosos\nViolência"},"steam_germany":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Drogen\nGewalt"}}}}}
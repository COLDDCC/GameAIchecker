on":"08acd6d809b40eff6e531ee3157ad03bca553f15.jpg","localized_name":"Never Go Full Regard","archived":0,"hidden":0,"name":"Never Go Full Regard","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5056410\/08acd6d809b40eff6e531ee3157ad03bca553f15.jpg"},{"icon":"4cc4d36be3b245ae586cbe564b4f83bdd1233b33.jpg","localized_name":"Fully Regarded","archived":0,"hidden":0,"name":"Fully Regarded","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5056410\/4cc4d36be3b245ae586cbe564b4f83bdd1233b33.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"","email":"thepassgamesupport@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5056410?t=1793742324","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5056410?t=1793742324","content_descriptors":{"ids":[5],"notes":"\"The Pass\" is a satirical clicker game built around a single repeated joke: the game and its characters refer to the player in a disparaging (but still loving) way, including a recurring real-world slur. This occurs in dialogue as well as the UI text. This is the core comedic premise, not occasional or isolated language.\n\nThe main gameplay loop is a chance-based \"roll\" with weighted random tiers, similar to a gacha-style system. Rolling is free and unlimited. Points earned from rolls can be spent on in-game collectible tickets, and nothing is purchased with real money.\n\nThe game contains no violence, no illegal drug content, and no nudity or general sexual content."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Linguagem imprópria"},"steam_germany":{"rating_generated":"1","rating":"6","required_age":"6","banned":"0","use_age_gate":"0","descriptors":"Derbe Sprache"}}}}}
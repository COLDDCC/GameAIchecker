30a1149c9a7c98561a4d4579a1f4371b07e.1920x1080.jpg?t=1793704305"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/3dee46eda9e93b6cc43d5bf4480479696794d421\/ss_3dee46eda9e93b6cc43d5bf4480479696794d421.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/3dee46eda9e93b6cc43d5bf4480479696794d421\/ss_3dee46eda9e93b6cc43d5bf4480479696794d421.1920x1080.jpg?t=1793704305"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/e59dc94e9d5ff6b83da8a841db5a04aca32fe12a\/ss_e59dc94e9d5ff6b83da8a841db5a04aca32fe12a.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/e59dc94e9d5ff6b83da8a841db5a04aca32fe12a\/ss_e59dc94e9d5ff6b83da8a841db5a04aca32fe12a.1920x1080.jpg?t=1793704305"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/06cb80cbdb79413f9541dcd8cb74623c2b421ac8\/ss_06cb80cbdb79413f9541dcd8cb74623c2b421ac8.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/06cb80cbdb79413f9541dcd8cb74623c2b421ac8\/ss_06cb80cbdb79413f9541dcd8cb74623c2b421ac8.1920x1080.jpg?t=1793704305"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/d5c626dc4b18a95949495980dbc95f363bbb7890\/ss_d5c626dc4b18a95949495980dbc95f363bbb7890.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/d5c626dc4b18a95949495980dbc95f363bbb7890\/ss_d5c626dc4b18a95949495980dbc95f363bbb7890.1920x1080.jpg?t=1793704305"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/8fd3d09f9890f3e49480460a6d140207bf45bde6\/ss_8fd3d09f9890f3e49480460a6d140207bf45bde6.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/8fd3d09f9890f3e49480460a6d140207bf45bde6\/ss_8fd3d09f9890f3e49480460a6d140207bf45bde6.1920x1080.jpg?t=1793704305"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/bcddc7e61a56aaa2f8e51a7047ca73a321634ddb\/ss_bcddc7e61a56aaa2f8e51a7047ca73a321634ddb.600x338.jpg?t=1793704305","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5432220\/bcddc7e61a56aaa2f8e51a7047ca73a321634ddb\/ss_bcddc7e61a56aaa2f8e51a7047ca73a321634ddb.1920x1080.jpg?t=1793704305"}],"movies":[{"id":257458144,"name":"EN","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257458144\/ec9fc722399ac915e5c7134181d044a33f8a6307\/movie_600x337.jpg?t=1792106018","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5432220\/1283242304\/2d98233256c57b2818da7547f4a0bb04dc69ff20\/1791819223\/dash_av1.mpd?t=1792106018","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5432220\/1283242304\/2d98233256c57b2818da7547f4a0bb04dc69ff20\/1791819223\/dash_h264.mpd?t=1792106018","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5432220\/1283242304\/2d98233256c57b2818da7547f4a0bb04dc69ff20\/1791819223\/hls_264_master.m3u8?t=1792106018","highlight":true}],"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/daniling.org\/","email":"gamedaniling@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5432220?t=1793704305","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5432220?t=1793704305","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Drogas ilícitas\nAtos criminosos\nViolência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Drogen\nGewalt"}}}}}
mai.steamstatic.com\/store_trailers\/4821570\/1411651317\/67e536db2d89fc3d4d84587a5ef730b82ba6bcd3\/1782195561\/dash_h264.mpd?t=1782980520","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4821570\/1411651317\/67e536db2d89fc3d4d84587a5ef730b82ba6bcd3\/1782195561\/hls_264_master.m3u8?t=1782980520","highlight":true}],"release_date":{"coming_soon":false,"date":"2 Nov, 2026"},"support_info":{"url":"","email":"xuanxiaozhijie2025@163.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4821570?t=1793666227","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4821570?t=1793666227","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"10","required_age":"10","banned":"0","use_age_gate":"0","descriptors":"Violência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Gewalt"},"igrs":{"rating_generated":"1","rating":"13","required_age":"13","banned":"0","use_age_gate":"0","descriptors":"Kekerasan"}}}}}
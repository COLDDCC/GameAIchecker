\/ss_ae5b0a1dc8496633b14a5e8d0d787ecbf870d9eb.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/ae5b0a1dc8496633b14a5e8d0d787ecbf870d9eb\/ss_ae5b0a1dc8496633b14a5e8d0d787ecbf870d9eb.1920x1080.jpg?t=1793644347"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/bf6b04cd9bb9458580fe35b9bdeea008308d2b33\/ss_bf6b04cd9bb9458580fe35b9bdeea008308d2b33.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/bf6b04cd9bb9458580fe35b9bdeea008308d2b33\/ss_bf6b04cd9bb9458580fe35b9bdeea008308d2b33.1920x1080.jpg?t=1793644347"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/e944e7048afd9b78eedc04bb1269d5447bec14f9\/ss_e944e7048afd9b78eedc04bb1269d5447bec14f9.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/e944e7048afd9b78eedc04bb1269d5447bec14f9\/ss_e944e7048afd9b78eedc04bb1269d5447bec14f9.1920x1080.jpg?t=1793644347"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/35d0b091055c93b68ede24ff018b1c9319c4d227\/ss_35d0b091055c93b68ede24ff018b1c9319c4d227.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/35d0b091055c93b68ede24ff018b1c9319c4d227\/ss_35d0b091055c93b68ede24ff018b1c9319c4d227.1920x1080.jpg?t=1793644347"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/d9b8800d86b2f696b8b1d4b9bb148fcf212cc010\/ss_d9b8800d86b2f696b8b1d4b9bb148fcf212cc010.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/d9b8800d86b2f696b8b1d4b9bb148fcf212cc010\/ss_d9b8800d86b2f696b8b1d4b9bb148fcf212cc010.1920x1080.jpg?t=1793644347"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/65cadc4172354b48d6bd30e615abf0cf3cdb6740\/ss_65cadc4172354b48d6bd30e615abf0cf3cdb6740.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/65cadc4172354b48d6bd30e615abf0cf3cdb6740\/ss_65cadc4172354b48d6bd30e615abf0cf3cdb6740.1920x1080.jpg?t=1793644347"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/e01f1c5958558f62924d230d6764809026859588\/ss_e01f1c5958558f62924d230d6764809026859588.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/e01f1c5958558f62924d230d6764809026859588\/ss_e01f1c5958558f62924d230d6764809026859588.1920x1080.jpg?t=1793644347"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/f7150e30f0852dff7bda5dadb272c3b4c7ea3791\/ss_f7150e30f0852dff7bda5dadb272c3b4c7ea3791.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/f7150e30f0852dff7bda5dadb272c3b4c7ea3791\/ss_f7150e30f0852dff7bda5dadb272c3b4c7ea3791.1920x1080.jpg?t=1793644347"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/4e686ae72ab1f14249fb9f2c4219fe5b5ab14590\/ss_4e686ae72ab1f14249fb9f2c4219fe5b5ab14590.600x338.jpg?t=1793644347","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/2377020\/4e686ae72ab1f14249fb9f2c4219fe5b5ab14590\/ss_4e686ae72ab1f14249fb9f2c4219fe5b5ab14590.1920x1080.jpg?t=1793644347"}],"movies":[{"id":257488989,"name":"Trailer 1.0.","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257488989\/2b29bcd6ce4fa227401c32f89ba8a9bad4883557\/movie_600x337.jpg?t=1793643688","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_
apps\/5430760\/6f2d1acdc432d388976b3a9aa5e04c0da33e6a15\/ss_6f2d1acdc432d388976b3a9aa5e04c0da33e6a15.600x338.jpg?t=1793739902","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/6f2d1acdc432d388976b3a9aa5e04c0da33e6a15\/ss_6f2d1acdc432d388976b3a9aa5e04c0da33e6a15.1920x1080.jpg?t=1793739902"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/a18d6e35ed0d75887ff1414f6e300f906579dc45\/ss_a18d6e35ed0d75887ff1414f6e300f906579dc45.600x338.jpg?t=1793739902","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/a18d6e35ed0d75887ff1414f6e300f906579dc45\/ss_a18d6e35ed0d75887ff1414f6e300f906579dc45.1920x1080.jpg?t=1793739902"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/e74b76af2e3ba9265e56bb51ab4c3273fce63aa3\/ss_e74b76af2e3ba9265e56bb51ab4c3273fce63aa3.600x338.jpg?t=1793739902","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/e74b76af2e3ba9265e56bb51ab4c3273fce63aa3\/ss_e74b76af2e3ba9265e56bb51ab4c3273fce63aa3.1920x1080.jpg?t=1793739902"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/b78bb3a5cadaac8e62b6c94be1ec10cadb39ee6d\/ss_b78bb3a5cadaac8e62b6c94be1ec10cadb39ee6d.600x338.jpg?t=1793739902","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/b78bb3a5cadaac8e62b6c94be1ec10cadb39ee6d\/ss_b78bb3a5cadaac8e62b6c94be1ec10cadb39ee6d.1920x1080.jpg?t=1793739902"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/eda9393654fff086dc13ab1c0b4b25e9da41f9d5\/ss_eda9393654fff086dc13ab1c0b4b25e9da41f9d5.600x338.jpg?t=1793739902","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5430760\/eda9393654fff086dc13ab1c0b4b25e9da41f9d5\/ss_eda939365
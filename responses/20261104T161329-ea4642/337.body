1d949d34dba1\/ss_5353d0af10569efb557045ff2bf01d949d34dba1.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/5353d0af10569efb557045ff2bf01d949d34dba1\/ss_5353d0af10569efb557045ff2bf01d949d34dba1.1920x1080.jpg?t=1793646711"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/91e3dec64b9f5ccf786442ae4863383b659922dd\/ss_91e3dec64b9f5ccf786442ae4863383b659922dd.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/91e3dec64b9f5ccf786442ae4863383b659922dd\/ss_91e3dec64b9f5ccf786442ae4863383b659922dd.1920x1080.jpg?t=1793646711"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/7ba98b3d2822c1e24779d1367b35b803c5da0c03\/ss_7ba98b3d2822c1e24779d1367b35b803c5da0c03.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/7ba98b3d2822c1e24779d1367b35b803c5da0c03\/ss_7ba98b3d2822c1e24779d1367b35b803c5da0c03.1920x1080.jpg?t=1793646711"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/8dcbf597ff78434b50bea6fa047ffcdfe9aa40d5\/ss_8dcbf597ff78434b50bea6fa047ffcdfe9aa40d5.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/8dcbf597ff78434b50bea6fa047ffcdfe9aa40d5\/ss_8dcbf597ff78434b50bea6fa047ffcdfe9aa40d5.1920x1080.jpg?t=1793646711"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/e0adf3f46e193e6be2f8feec2f4f1027bfa9d739\/ss_e0adf3f46e193e6be2f8feec2f4f1027bfa9d739.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/e0adf3f46e193e6be2f8feec2f4f1027bfa9d739\/ss_e0adf3f46e193e6be2f8feec2f4f1027bfa9d739.1920x1080.jpg?t=1793646711"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/cc9a108d924ce53768a8cfae3ec95f02a51f5bb3\/ss_cc9a108d924ce53768a8cfae3ec95f02a51f5bb3.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/cc9a108d924ce53768a8cfae3ec95f02a51f5bb3\/ss_cc9a108d924ce53768a8cfae3ec95f02a51f5bb3.1920x1080.jpg?t=1793646711"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/b246fa0097cd53baf77ca37e51ece056ce58c857\/ss_b246fa0097cd53baf77ca37e51ece056ce58c857.600x338.jpg?t=1793646711","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/b246fa0097cd53baf77ca37e51ece056ce58c857\/ss_b246fa0097cd53baf77ca37e51ece056ce58c857.1920x1080.jpg?t=1793646711"}],"movies":[{"id":257381072,"name":"You Must Die Demo Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257381072\/7e6f2c745b70091e5d8f248d6a7b1c08674c6cef\/movie_600x337.jpg?t=1784559338","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4832350\/1079305173\/9ebaf6c8737d2bb5c8656b137700b38fb80ff5b3\/1784559107\/dash_av1.mpd?t=1784559338","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4832350\/1079305173\/9ebaf6c8737d2bb5c8656b137700b38fb80ff5b3\/1784559107\/dash_h264.mpd?t=1784559338","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4832350\/1079305173\/9ebaf6c8737d2bb5c8656b137700b38fb80ff5b3\/1784559107\/hls_264_master.m3u8?t=1784559338","highlight":true}],"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"","email":"staybrickedgames@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4832350?t=1793646711","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4832350\/0e780966726cb8ecbb7b1b69
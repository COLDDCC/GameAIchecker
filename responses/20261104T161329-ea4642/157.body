=1793717995","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/8b67b6b2864304c8a0137b8d0ab01b1da43e2a01\/ss_8b67b6b2864304c8a0137b8d0ab01b1da43e2a01.1920x1080.jpg?t=1793717995"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/75d387315e2925c2bc433013f2676c5daa7e359b\/ss_75d387315e2925c2bc433013f2676c5daa7e359b.600x338.jpg?t=1793717995","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/75d387315e2925c2bc433013f2676c5daa7e359b\/ss_75d387315e2925c2bc433013f2676c5daa7e359b.1920x1080.jpg?t=1793717995"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/2fed3ba8e5b0ecf0e051e94442f232987fef219e\/ss_2fed3ba8e5b0ecf0e051e94442f232987fef219e.600x338.jpg?t=1793717995","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/2fed3ba8e5b0ecf0e051e94442f232987fef219e\/ss_2fed3ba8e5b0ecf0e051e94442f232987fef219e.1920x1080.jpg?t=1793717995"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/145a0a87de7c2a0ffb7b7743b171722bc11d20ab\/ss_145a0a87de7c2a0ffb7b7743b171722bc11d20ab.600x338.jpg?t=1793717995","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/145a0a87de7c2a0ffb7b7743b171722bc11d20ab\/ss_145a0a87de7c2a0ffb7b7743b171722bc11d20ab.1920x1080.jpg?t=1793717995"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/a3e8765374b67b073aff227204f855a947f5c0db\/ss_a3e8765374b67b073aff227204f855a947f5c0db.600x338.jpg?t=1793717995","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5266240\/a3e8765374b67b073aff227204f855a947f5c0db\/ss_a3e8765374b67b073aff227204f855a947f5c0db.1920x1080.jpg?t=1793717995"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.ste
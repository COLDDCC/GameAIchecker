113d0.600x338.jpg?t=1793683900","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4908640\/48ca3346027fda675cd57b633b9ba729e2d113d0\/ss_48ca3346027fda675cd57b633b9ba729e2d113d0.1920x1080.jpg?t=1793683900"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4908640\/c5c541608f130944a8f10ed66d393cc509a236d7\/ss_c5c541608f130944a8f10ed66d393cc509a236d7.600x338.jpg?t=1793683900","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4908640\/c5c541608f130944a8f10ed66d393cc509a236d7\/ss_c5c541608f130944a8f10ed66d393cc509a236d7.1920x1080.jpg?t=1793683900"}],"movies":[{"id":257381797,"name":"THW's Calcudoku: First Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257381797\/3b6f6b9e0bbc31ae1bbab864ebc527c32e43de86\/movie_600x337.jpg?t=1785803084","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/387197420\/793c5b45e61198ce189ed5772e1e8ed6d36c5129\/1785181495\/dash_av1.mpd?t=1785803084","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/387197420\/793c5b45e61198ce189ed5772e1e8ed6d36c5129\/1785181495\/dash_h264.mpd?t=1785803084","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/387197420\/793c5b45e61198ce189ed5772e1e8ed6d36c5129\/1785181495\/hls_264_master.m3u8?t=1785803084","highlight":true},{"id":257381799,"name":"THW's Calcudoku: Puzzle Designer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257381799\/00cf08d8f81ff0eb4f7643b5cdd0d79233957428\/movie_600x337.jpg?t=1785803085","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/2056574047\/600cf48b25576ccc5f5378e81a5f4a76881deff0\/1784647488\/dash_av1.mpd?t=1785803085","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/2056574047\/600cf48b25576ccc5f5378e81a5f4a76881deff0\/1784647488\/dash_h264.mpd?t=1785803085","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/2056574047\/600cf48b25576ccc5f5378e81a5f4a76881deff0\/1784647488\/hls_264_master.m3u8?t=1785803085","highlight":true},{"id":257381798,"name":"THW's Calcudoku: Gameplay","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257381798\/b1db809873065665e020c4aa3bce782946ca2660\/movie_600x337.jpg?t=1785803086","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/1982097161\/8e84857492b23870fde5bff6e1e7a5ddb25ad777\/1784651928\/dash_av1.mpd?t=1785803086","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/1982097161\/8e84857492b23870fde5bff6e1e7a5ddb25ad777\/1784651928\/dash_h264.mpd?t=1785803086","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4908640\/1982097161\/8e84857492b23870fde5bff6e1e7a5ddb25ad777\/1784651928\/hls_264_master.m3u8?t=1785803086","highlight":true}],"achievements":{"total":20,"highlighted":[{"icon":"9b557d0263edfaace2c091ca9bacdf2ec9e9d770.jpg","localized_name":"Tiny Triumph","archived":0,"hidden":1,"name":"Tiny Triumph","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/9b557d0263edfaace2c091ca9bacdf2ec9e9d770.jpg"},{"icon":"471f034b5f219c6bce1c3072f3a13029ebfe4d7b.jpg","localized_name":"First Steps","archived":0,"hidden":1,"name":"First Steps","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/471f034b5f219c6bce1c3072f3a13029ebfe4d7b.jpg"},{"icon":"556c21290f7ff22dc2f63fdf47825dd29794c019.jpg","localized_name":"Quick Study","archived":0,"hidden":1,"name":"Quick Study","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/556c21290f7ff22dc2f63fdf47825dd29794c019.jpg"},{"icon":"a61ab30e51eefee68eec61c1d6f0007acae9ff73.jpg","localized_name":"Going Strong","archived":0,"hidden":1,"name":"Going Strong","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/a61ab30e51eefee68eec61c1d6f0007acae9ff73.jpg"},{"icon":"32ebc420cd73d44cf4f162929b2ff4f198559ddf.jpg","localized_name":"Half Century","archived":0,"hidden":1,"name":"Half Century","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/32ebc420cd73d44cf4f162929b2ff4f198559ddf.jpg"},{"icon":"f1b79ed6e7a6a8ec890fb16ba31b85d0df20c2bd.jpg","localized_name":"Centurion","archived":0,"hidden":1,"name":"Centurion","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/f1b79ed6e7a6a8ec890fb16ba31b85d0df20c2bd.jpg"},{"icon":"c53df5707cd2345afcdcfecc1071647439d12ff8.jpg","localized_name":"Lightspeed","archived":0,"hidden":1,"name":"Lightspeed","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/c53df5707cd2345afcdcfecc1071647439d12ff8.jpg"},{"icon":"a51adf3017ad71a6000d94099f251667c8bc1858.jpg","localized_name":"Tough Customer","archived":0,"hidden":1,"name":"Tough Customer","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/a51adf3017ad71a6000d94099f251667c8bc1858.jpg"},{"icon":"9eb1252244d12cdcee413146683b46f7d5d72c7a.jpg","localized_name":"Apprentice","archived":0,"hidden":1,"name":"Apprentice","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/9eb1252244d12cdcee413146683b46f7d5d72c7a.jpg"},{"icon":"bf5b215e17925fa77e45ad5e91527017ba1456a0.jpg","localized_name":"Adept","archived":0,"hidden":1,"name":"Adept","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4908640\/bf5b215e17925fa77e45ad5e91527017ba1456a0.jpg"}]},"release_date":{"coming_soon":false,"date":"2 Nov, 2026"},"support_info":{"url":"https:\/\/freekon.productions","email":"help@freekon.productions"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4908640?t=1793683900","background_raw":"https:\/\/shared.akamai.steamstatic.co
 or any Metal GPU<br><\/li><li><strong>Storage:<\/strong> 300 MB available space<br><\/li><li><strong>Sound Card:<\/strong> Built-in<\/li><\/ul>"},"linux_requirements":{"minimum":"<strong>Minimum:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Ubuntu 22.04 \/ Debian 12 \/ SteamOS 3 (or any modern 64-bit distro, glibc 2.35+)<br><\/li><li><strong>Processor:<\/strong> 1.5 GHz dual-core, 64-bit (x86-64)<br><\/li><li><strong>Memory:<\/strong> 2 GB RAM<br><\/li><li><strong>Graphics:<\/strong> OpenGL 3.0-capable GPU, incl. integrated<br><\/li><li><strong>Storage:<\/strong> 250 MB available space<\/li><\/ul>","recommended":"<strong>Recommended:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Ubuntu 24.04 \/ SteamOS 3 or later<br><\/li><li><strong>Processor:<\/strong> 2 GHz quad-core, 64-bit<br><\/li><li><strong>Memory:<\/strong> 4 GB RAM<br><\/li><li><strong>Graphics:<\/strong> Vulkan-capable GPU<br><\/li><li><strong>Storage:<\/strong> 300 MB available space<\/li><\/ul>"},"developers":["FreekON Productions"],"publishers":["FreekON Productions"],"demos":[{"appid":5006610,"description":""}],"price_overview":{"currency":"EUR","initial":315,"final":315,"discount_percent":0,"initial_formatted":"","final_formatted":"3,15€"},"packages":[1704175],"package_groups":[{"name":"default","title":"Buy THW's Calcudoku","description":"","selection_text":"Select a purchase option","save_text":"","display_type":0,"is_recurring_subscription":"false","subs":[{"packageid":1704175,"percent_savings_text":" ","percent_savings":0,"option_text":"THW's Calcudoku - 3,15€","option_description":"","can_get_free_license":"0","is_free_license":false,"price_in_cents_with_discount":315}]}],"platforms":{"windows":true,"mac":true,"linux":true},"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":47,"description":"LAN PvP"},{"id":37,"description":"Shared\/Split Screen PvP"},{"id"
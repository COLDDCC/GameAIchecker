16810\/d311c21c407e69fcec7489f15d92b3cf5fab9c7a\/ss_d311c21c407e69fcec7489f15d92b3cf5fab9c7a.1920x1080.jpg?t=1793699283"}],"movies":[{"id":257425818,"name":"Bald Busters Official","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257425818\/c06c81bee2f7635acd7073d04018b9d49c4250fe\/movie_600x337.jpg?t=1789933371","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4116810\/791856172\/f5dfce5bb0e02563583a314c3d0a4e3bb659972c\/1789933079\/dash_av1.mpd?t=1789933371","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4116810\/791856172\/f5dfce5bb0e02563583a314c3d0a4e3bb659972c\/1789933079\/dash_h264.mpd?t=1789933371","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4116810\/791856172\/f5dfce5bb0e02563583a314c3d0a4e3bb659972c\/1789933079\/hls_264_master.m3u8?t=1789933371","highlight":true}],"achievements":{"total":18,"highlighted":[{"icon":"598f142e57a14f1db16adb6858338987383483ac.jpg","localized_name":"Everyone to Turkey!","archived":0,"hidden":0,"name":"Everyone to Turkey!","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/598f142e57a14f1db16adb6858338987383483ac.jpg"},{"icon":"601dec9821a189040de01c8ce89cf7e3f6b35e03.jpg","localized_name":"Your First Footballer","archived":0,"hidden":0,"name":"Your First Footballer","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/601dec9821a189040de01c8ce89cf7e3f6b35e03.jpg"},{"icon":"4f38d9c682a733d73c09b33f3eb0b793e38dfe68.jpg","localized_name":"The Planet Is Cooling Down","archived":0,"hidden":1,"name":"The Planet Is Cooling Down","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/4f38d9c682a733d73c09b33f3eb0b793e38dfe68.jpg"},{"icon":"57b48ede92d98626ddf612612e6e6ccff036e2e0.jpg","localized_name":"A Bit of Smuggling","archived":0,"hidden":0,"name":"A Bit of Smuggling","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/57b48ede92d98626ddf612612e6e6ccff036e2e0.jpg"},{"icon":"b799d11183b3208f781c6db7b3a8c60aa76bfda5.jpg","localized_name":"A Partner at the Airport","archived":0,"hidden":0,"name":"A Partner at the Airport","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/b799d11183b3208f781c6db7b3a8c60aa76bfda5.jpg"},{"icon":"ac7a4d8227c18d3ef84eeb0f65ae4cef7d2bdc61.jpg","localized_name":"All of Grandma's Remedies","archived":0,"hidden":0,"name":"All of Grandma's Remedies","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/ac7a4d8227c18d3ef84eeb0f65ae4cef7d2bdc61.jpg"},{"icon":"2f74c138118fdacaff2a30509597d01dc1ad35f2.jpg","localized_name":"A Bald Head With Personality","archived":0,"hidden":1,"name":"A Bald Head With Personality","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/2f74c138118fdacaff2a30509597d01dc1ad35f2.jpg"},{"icon":"4f7959bb5bc4c61d27161a1b5c8e72cf76dff919.jpg","localized_name":"They Come to Me Automatically","archived":0,"hidden":0,"name":"They Come to Me Automatically","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/4f7959bb5bc4c61d27161a1b5c8e72cf76dff919.jpg"},{"icon":"092c26aec968dcb9aeffeb1826b6b4f561c13a4c.jpg","localized_name":"Family Business","archived":0,"hidden":0,"name":"Family Business","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/092c26aec968dcb9aeffeb1826b6b4f561c13a4c.jpg"},{"icon":"0221e193f54d7baed3b33b85e5cac5ca3fb164ab.jpg","localized_name":"R&D Success","archived":0,"hidden":0,"name":"R&D Success","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/4116810\/0221e193f54d7baed3b33b85e5cac5ca3fb164ab.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/www.pixelparadise.dev\/en\/contact","email":""},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4116810?t=1793699283","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4116810\/5d57a97ecdcb21c99f84cd64f078c09cfc8b9d1d\/page_bg_raw.jpg?t=1793699283","content_descriptors":{"ids":[5],"notes":"Bald Busters is an arcade-style action game with a strong emphasis on absurd comedy, movie trope satire, and cartoon violence.\r\n\r\nThe game features comical combat using unconventional projectiles (such as wigs and hair accessories), with no blood, gore, or realistic depictions of violence. The final boss encounters parody 80s and 90s action movie conventions, including comedic dialogue with moderately strong language and profanity commonly found in the action genre (such as \"son of a bitch\" or equivalent expressions), used strictly for humorous and contextual purposes. Sensitive topics such as sexual violence, substance abuse, discrimination, or self-harm are not featured."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Linguagem imprópria\nViolência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Gewalt\nDerbe Sprache"},"igrs":{"rating_generated":"1","rating":"15","required_age":"15","banned":"0","use_age_gate":"0","descriptors":"Penggunaan bahasa\nKekerasan"}}}}}
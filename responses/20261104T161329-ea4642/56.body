chived":0,"hidden":0,"name":"Master of the Deck","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/0e6eba4f021e99ffcf7a9ad925d079fd22143b17.jpg"},{"icon":"0ff0eb5b3f1e820fca56872d7dbd3ed85b581723.jpg","localized_name":"Ten Wins","archived":0,"hidden":0,"name":"Ten Wins","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/0ff0eb5b3f1e820fca56872d7dbd3ed85b581723.jpg"},{"icon":"3c92242b1e5751ce55544e7674a9f2680fdc8e1a.jpg","localized_name":"Fifty Wins","archived":0,"hidden":0,"name":"Fifty Wins","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/3c92242b1e5751ce55544e7674a9f2680fdc8e1a.jpg"},{"icon":"140823f39f627a0c23e616a7c8924740793282aa.jpg","localized_name":"Centurion","archived":0,"hidden":0,"name":"Centurion","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/140823f39f627a0c23e616a7c8924740793282aa.jpg"},{"icon":"b0975e118492b427ebdd02e8e4543b3235ce5fb3.jpg","localized_name":"Seven Crowns","archived":0,"hidden":0,"name":"Seven Crowns","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/b0975e118492b427ebdd02e8e4543b3235ce5fb3.jpg"},{"icon":"918f37c2b1415baa55e57dd43fea74f4b6b78e4b.jpg","localized_name":"Perfect Day","archived":0,"hidden":0,"name":"Perfect Day","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/918f37c2b1415baa55e57dd43fea74f4b6b78e4b.jpg"},{"icon":"f4fe6af9bc77e3363673353a2923c6177d4c7ad6.jpg","localized_name":"A Month Unbroken","archived":0,"hidden":0,"name":"A Month Unbroken","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5291360\/f4fe6af9bc77e3363673353a2923c6177d4c7ad6.jpg"}]},"release_date":{"coming_soon":false,"date":"3 Nov, 2026"},"support_info":{"url":"","email":"solocards@proton.me"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/52
:359}]}],"platforms":{"windows":true,"mac":false,"linux":false},"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":25,"description":"Steam Leaderboards"},{"id":62,"description":"Family Sharing"}],"genres":[{"id":"1","description":"Action"},{"id":"23","description":"Indie"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/f7479c2b6da171067782d1cec7aa318cf429f720\/ss_f7479c2b6da171067782d1cec7aa318cf429f720.600x338.jpg?t=1793700052","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/f7479c2b6da171067782d1cec7aa318cf429f720\/ss_f7479c2b6da171067782d1cec7aa318cf429f720.1920x1080.jpg?t=1793700052"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/50c3fa6af13f0e36497489d6e7ada652e4e24edb\/ss_50c3fa6af13f0e36497489d6e7ada652e4e24edb.600x338.jpg?t=1793700052","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/50c3fa6af13f0e36497489d6e7ada652e4e24edb\/ss_50c3fa6af13f0e36497489d6e7ada652e4e24edb.1920x1080.jpg?t=1793700052"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/283bffa674e28e0e831181881e71b407af5b2d80\/ss_283bffa674e28e0e831181881e71b407af5b2d80.600x338.jpg?t=1793700052","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/283bffa674e28e0e831181881e71b407af5b2d80\/ss_283bffa674e28e0e831181881e71b407af5b2d80.1920x1080.jpg?t=1793700052"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/f0974fb5c4f2d39861de6d5268a945d7cf9526f0\/ss_f0974fb5c4f2d39861de6d5268a945d7cf9526f0.600x338.jpg?t=1793700052","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5423420\/f0974fb5c4f2d39861de6d5268a945d7cf9526f0\/ss_f0974fb
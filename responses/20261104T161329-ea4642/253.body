5271470\/c44afdb0130dd23b92fe56db3be461449432bdf9\/ss_c44afdb0130dd23b92fe56db3be461449432bdf9.1920x1080.jpg?t=1793689655"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/f9cb6a4e1392a4806e8f318be71ca2dc8bffe1c0\/ss_f9cb6a4e1392a4806e8f318be71ca2dc8bffe1c0.600x338.jpg?t=1793689655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/f9cb6a4e1392a4806e8f318be71ca2dc8bffe1c0\/ss_f9cb6a4e1392a4806e8f318be71ca2dc8bffe1c0.1920x1080.jpg?t=1793689655"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/731c09c09f301c9c320b09fcb680fbe73a9a50cc\/ss_731c09c09f301c9c320b09fcb680fbe73a9a50cc.600x338.jpg?t=1793689655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/731c09c09f301c9c320b09fcb680fbe73a9a50cc\/ss_731c09c09f301c9c320b09fcb680fbe73a9a50cc.1920x1080.jpg?t=1793689655"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/6e27188a7de316274ff6ef653e9080806777f4dd\/ss_6e27188a7de316274ff6ef653e9080806777f4dd.600x338.jpg?t=1793689655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/6e27188a7de316274ff6ef653e9080806777f4dd\/ss_6e27188a7de316274ff6ef653e9080806777f4dd.1920x1080.jpg?t=1793689655"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/636e88bdd3addb8a3404069702dd4d98489ffd4c\/ss_636e88bdd3addb8a3404069702dd4d98489ffd4c.600x338.jpg?t=1793689655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/636e88bdd3addb8a3404069702dd4d98489ffd4c\/ss_636e88bdd3addb8a3404069702dd4d98489ffd4c.1920x1080.jpg?t=1793689655"}],"movies":[{"id":257424764,"name":"Gameplay Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257424764\/c2f6281202889602c457509a079547fcb902d14f\/movie_600x337.jpg?t=1792099009","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5271470\/1239947376\/a5fbdb319319d4dc9b5eb3f98c8a021582aa1a79\/1792089657\/dash_av1.mpd?t=1792099009","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5271470\/1239947376\/a5fbdb319319d4dc9b5eb3f98c8a021582aa1a79\/1792089657\/dash_h264.mpd?t=1792099009","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5271470\/1239947376\/a5fbdb319319d4dc9b5eb3f98c8a021582aa1a79\/1792089657\/hls_264_master.m3u8?t=1792099009","highlight":true}],"achievements":{"total":73,"highlighted":[{"icon":"88f66449674f18a35f203283caa0154dcd8fcfc2.jpg","localized_name":"A grave cut to your length","archived":0,"hidden":0,"name":"A grave cut to your length","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/88f66449674f18a35f203283caa0154dcd8fcfc2.jpg"},{"icon":"f59592f18ddc701b7ed4f0c98dfcba79ffe6bb9c.jpg","localized_name":"Loud and warm","archived":0,"hidden":0,"name":"Loud and warm","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/f59592f18ddc701b7ed4f0c98dfcba79ffe6bb9c.jpg"},{"icon":"7d68983a00506ab04776b6795b127db1f283d2d6.jpg","localized_name":"I kept all of it for you","archived":0,"hidden":0,"name":"I kept all of it for you","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/7d68983a00506ab04776b6795b127db1f283d2d6.jpg"},{"icon":"6040221e48b1b0cfcdb30485efa46a2ec748b2eb.jpg","localized_name":"Where the dancing used to be","archived":0,"hidden":0,"name":"Where the dancing used to be","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/6040221e48b1b0cfcdb30485efa46a2ec748b2eb.jpg"},{"icon":"b1f1ffacb63cfc560028894a52a1f1352652aee1.jpg","localized_name":"Paid, after all that","archived":0,"hidden":0,"name":"Paid, after all that","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/b1f1ffacb63cfc560028894a52a1f1352652aee1.jpg"},{"icon":"78ec67e919b1607ce9e4bef359f90782f5b7c544.jpg","localized_name":"Until the hour is paid","archived":0,"hidden":0,"name":"Until the hour is paid","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/78ec67e919b1607ce9e4bef359f90782f5b7c544.jpg"},{"icon":"7dd6bafa8dfe40f90d3aceb460baecc66f2c5dc7.jpg","localized_name":"Long enough to stop counting","archived":0,"hidden":0,"name":"Long enough to stop counting","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/7dd6bafa8dfe40f90d3aceb460baecc66f2c5dc7.jpg"},{"icon":"d1981a2a4135a00183492135acd1e88815a99094.jpg","localized_name":"Kept watch a hundred years","archived":0,"hidden":0,"name":"Kept watch a hundred years","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/d1981a2a4135a00183492135acd1e88815a99094.jpg"},{"icon":"88f66449674f18a35f203283caa0154dcd8fcfc2.jpg","localized_name":"Say hello first","archived":0,"hidden":1,"name":"Say hello first","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/88f66449674f18a35f203283caa0154dcd8fcfc2.jpg"},{"icon":"749a316730091cbb051d37f1b2ec7cc8b8e62d60.jpg","localized_name":"Whose night I ate","archived":0,"hidden":1,"name":"Whose night I ate","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5271470\/749a316730091cbb051d37f1b2ec7cc8b8e62d60.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"crownoftime.com\/support","email":"support@crownoftime.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5271470?t=1793689655","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5271470\/5e9db564f0050e1b9aad52ee77e7328fa78af09b\/page_bg_raw.jpg?t=1793689655","content_descriptors":{"ids"
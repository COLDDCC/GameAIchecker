793638857"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5059340\/899017bbf1401769726ff1cc431c543a75349acb\/ss_899017bbf1401769726ff1cc431c543a75349acb.600x338.jpg?t=1793638857","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5059340\/899017bbf1401769726ff1cc431c543a75349acb\/ss_899017bbf1401769726ff1cc431c543a75349acb.1920x1080.jpg?t=1793638857"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5059340\/10e77ad1546726299a4252700735d665920548b3\/ss_10e77ad1546726299a4252700735d665920548b3.600x338.jpg?t=1793638857","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5059340\/10e77ad1546726299a4252700735d665920548b3\/ss_10e77ad1546726299a4252700735d665920548b3.1920x1080.jpg?t=1793638857"}],"movies":[{"id":257408449,"name":"Hush Piñata","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257408449\/c7907b0a67d3eaf73f716bed2530e7c7a4f031e5\/movie_600x337.jpg?t=1793638843","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5059340\/80769287\/08c7c6efe6c7f1e49d3e795754d5dd8896bafdc9\/1791818623\/dash_av1.mpd?t=1793638843","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5059340\/80769287\/08c7c6efe6c7f1e49d3e795754d5dd8896bafdc9\/1791818623\/dash_h264.mpd?t=1793638843","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5059340\/80769287\/08c7c6efe6c7f1e49d3e795754d5dd8896bafdc9\/1791818623\/hls_264_master.m3u8?t=1793638843","highlight":true}],"achievements":{"total":61,"highlighted":[{"icon":"171c1458543014a7a9619fb7295f90eb8184a0a3.jpg","localized_name":"Party Crasher","archived":0,"hidden":0,"name":"Party Crasher","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/171c1458543014a7a9619fb7295f90eb8184a0a3.jpg"},{"icon":"b85c9aa99f57ed8b2f476919bb4f240a288a2d95.jpg","localized_name":"I'm Making It Home Tonight","archived":0,"hidden":0,"name":"I'm Making It Home Tonight","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/b85c9aa99f57ed8b2f476919bb4f240a288a2d95.jpg"},{"icon":"1cc7fc0efbf8dfcd2b65aadfcf3d2860e2f8ec11.jpg","localized_name":"Party's Over","archived":0,"hidden":0,"name":"Party's Over","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/1cc7fc0efbf8dfcd2b65aadfcf3d2860e2f8ec11.jpg"},{"icon":"c8b215e956a932e402708493708c17030a28d2eb.jpg","localized_name":"Just Here for the Freebies","archived":0,"hidden":0,"name":"Just Here for the Freebies","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/c8b215e956a932e402708493708c17030a28d2eb.jpg"},{"icon":"2e25705fbd179be6c45632eebaa36ab8a86c7ec0.jpg","localized_name":"Leave It to Me","archived":0,"hidden":0,"name":"Leave It to Me","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/2e25705fbd179be6c45632eebaa36ab8a86c7ec0.jpg"},{"icon":"148cbde9daa3cfdac989586256a83001032b641b.jpg","localized_name":"Party Jack-of-All-Trades","archived":0,"hidden":0,"name":"Party Jack-of-All-Trades","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/148cbde9daa3cfdac989586256a83001032b641b.jpg"},{"icon":"a7b0da68515f24e25f6721384ea3999148e8441d.jpg","localized_name":"Employee of the Month","archived":0,"hidden":0,"name":"Employee of the Month","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/a7b0da68515f24e25f6721384ea3999148e8441d.jpg"},{"icon":"8a64967556b85eb8f8c1752324e30aeba4d85178.jpg","localized_name":"Light Fingers, Iron Nerves","archived":0,"hidden":0,"name":"Light Fingers, Iron Nerves","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/8a64967556b85eb8f8c1752324e30aeba4d85178.jpg"},{"icon":"6a0e0f3084a842fc893e1fdb231cbf5676d3a357.jpg","localized_name":"Not a Scratch","archived":0,"hidden":0,"name":"Not a Scratch","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/6a0e0f3084a842fc893e1fdb231cbf5676d3a357.jpg"},{"icon":"35846ac21ec2bd4cf51d38cbed4db071e2fd36c5.jpg","localized_name":"Velvet Footsteps","archived":0,"hidden":0,"name":"Velvet Footsteps","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5059340\/35846ac21ec2bd4cf51d38cbed4db071e2fd36c5.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"https:\/\/www.fatfingerstudio.com\/","email":""},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5059340?t=1793638857","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5059340\/bc90362ff692764f25f5a2efe12d9310e9aaa4ff\/page_bg_raw.jpg?t=1793638857","content_descriptors":{"ids":[5],"notes":"The game contains mild horror themes inspired by Día de los Muertos and cartoon-style fantasy violence. Players may chase, strike, trap, or defeat stylized characters. There is no sexual content, nudity, realistic gore, drug use, or self-harm."},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Medo"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Ängstigende Inhalte"}}}}}
1e075e4b5cd489385b9a3436828922.600x338.jpg?t=1793725175","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5443430\/40b6903a111e075e4b5cd489385b9a3436828922\/ss_40b6903a111e075e4b5cd489385b9a3436828922.1920x1080.jpg?t=1793725175"}],"movies":[{"id":257486906,"name":"Below the Bell CG Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257486906\/1138d0eff0792ab450da3d0a95291b98a1b287d5\/movie_600x337.jpg?t=1793462038","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/162999326\/0c19a8d5761391db6cf885e78eeed24c045c5c02\/1793461943\/dash_av1.mpd?t=1793462038","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/162999326\/0c19a8d5761391db6cf885e78eeed24c045c5c02\/1793461943\/dash_h264.mpd?t=1793462038","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/162999326\/0c19a8d5761391db6cf885e78eeed24c045c5c02\/1793461943\/hls_264_master.m3u8?t=1793462038","highlight":true},{"id":257461389,"name":"Below the Bell","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257461389\/54dd60ef66550f643bd2434cf0b4585126dd41fe\/movie_600x337.jpg?t=1793031791","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/759870586\/c13b61f0f783479094674cb939ec03e321dedf45\/1792005157\/dash_av1.mpd?t=1793031791","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/759870586\/c13b61f0f783479094674cb939ec03e321dedf45\/1792005157\/dash_h264.mpd?t=1793031791","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5443430\/759870586\/c13b61f0f783479094674cb939ec03e321dedf45\/1792005157\/hls_264_master.m3u8?t=1793031791","highlight":true}],"achievements":{"total":29,"highlighted":[{"icon":"144833ae382cb79a5c18d3e728cb765f5fe6c3f3.jpg","localized_name":"Below the Quarry","archived":0,"hidden":0,"name":"Below the Quarry","path":"https:\/\/shared.akamai.steam
":"32390b1e2fd52d113a351eac804a78d5fe9332f6.jpg","localized_name":"The Eighth Rope","archived":0,"hidden":0,"name":"The Eighth Rope","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5443430\/32390b1e2fd52d113a351eac804a78d5fe9332f6.jpg"},{"icon":"77b50243c94a5a5a3a6611ca469d42581f7078cc.jpg","localized_name":"No Voice Answers","archived":0,"hidden":0,"name":"No Voice Answers","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5443430\/77b50243c94a5a5a3a6611ca469d42581f7078cc.jpg"}]},"release_date":{"coming_soon":false,"date":"3 Nov, 2026"},"support_info":{"url":"","email":"support@petersen-projects.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5443430?t=1793725175","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5443430\/399c2ad491c8ba4af181cf5bf2c4aac028522ae6\/page_bg_raw.jpg?t=1793725175","content_descriptors":{"ids":[2,5],"notes":"Constant real-time combat with medieval weapons against the risen dead, skeletons and a few animals. Blows show arcs of blood and red flashes, and old blood and bodies lie on the dungeon floors. The story deals with death, grief and self-sacrifice: people from the town go down to die, among them a sixteen-year-old boy, whose death is told, not shown. Pixel art; violence is shown plainly and never lingered on."},"ratings":{"dejus":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Violência"},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Gewalt"}}}}}
wers","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/03e080db3966fe45152969db98baa04a984734c0.jpg"},{"icon":"5e46b988b3b0e03ad5b88abe166621bc513adb8b.jpg","localized_name":"A Varied Bed","archived":0,"hidden":0,"name":"A Varied Bed","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/5e46b988b3b0e03ad5b88abe166621bc513adb8b.jpg"},{"icon":"c2ab993142fb0479dfbab4c8392a859f1ba315e0.jpg","localized_name":"First Pressing","archived":0,"hidden":0,"name":"First Pressing","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/c2ab993142fb0479dfbab4c8392a859f1ba315e0.jpg"},{"icon":"0a18c4d2f8d50f66450d25b0f084b74f6b8ee57e.jpg","localized_name":"A Small Collection","archived":0,"hidden":0,"name":"A Small Collection","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/0a18c4d2f8d50f66450d25b0f084b74f6b8ee57e.jpg"},{"icon":"af3ae3e00f30fb94e26d0525ae2ecb3ec8a3b50a.jpg","localized_name":"First Painting","archived":0,"hidden":0,"name":"First Painting","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/af3ae3e00f30fb94e26d0525ae2ecb3ec8a3b50a.jpg"},{"icon":"26f16525788745b9526f7f7cf4d3226283a0948c.jpg","localized_name":"A Small Gallery","archived":0,"hidden":0,"name":"A Small Gallery","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/26f16525788745b9526f7f7cf4d3226283a0948c.jpg"},{"icon":"723fb79ad5490851d8330191a866cb07b6633eb4.jpg","localized_name":"Another Dream","archived":0,"hidden":0,"name":"Another Dream","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5055800\/723fb79ad5490851d8330191a866cb07b6633eb4.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"https:\/\/verdreamia.com","email":"hello@verdreamia.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storep
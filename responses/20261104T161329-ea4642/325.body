bnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5410560\/e90191d7425f877f3afa2132248ffb8d2a4cb79f\/ss_e90191d7425f877f3afa2132248ffb8d2a4cb79f.600x338.jpg?t=1793650938","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5410560\/e90191d7425f877f3afa2132248ffb8d2a4cb79f\/ss_e90191d7425f877f3afa2132248ffb8d2a4cb79f.1920x1080.jpg?t=1793650938"}],"movies":[{"id":257455246,"name":"Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257455246\/b78a455974f420353d0d88fac4ff4d116eb65b5c\/movie_600x337.jpg?t=1792594572","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5410560\/339383694\/c391a691dc337df1858f10ebc51e1295e41659da\/1791603579\/dash_av1.mpd?t=1792594572","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5410560\/339383694\/c391a691dc337df1858f10ebc51e1295e41659da\/1791603579\/dash_h264.mpd?t=1792594572","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5410560\/339383694\/c391a691dc337df1858f10ebc51e1295e41659da\/1791603579\/hls_264_master.m3u8?t=1792594572","highlight":true}],"release_date":{"coming_soon":false,"date":"Nov 2, 2026"},"support_info":{"url":"https:\/\/sites.google.com\/view\/koyurugi-koubou\/","email":"koyurugi.koubou@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5410560?t=1793650938","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5410560?t=1793650938","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Violência\nTemas sensíveis"},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Selbstmord"}}}}}
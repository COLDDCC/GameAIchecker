5370670\/cacea046098c86f3a88c2a6aa9783b997698212d.jpg"},{"icon":"4aa0dabdee626d49aef3e66e114d167b1616fc1e.jpg","localized_name":"War of Attrition","archived":0,"hidden":0,"name":"War of Attrition","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/4aa0dabdee626d49aef3e66e114d167b1616fc1e.jpg"},{"icon":"b204af72f10025d3e229a79aa56c74cff1af907c.jpg","localized_name":"Demolition Crew","archived":0,"hidden":0,"name":"Demolition Crew","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/b204af72f10025d3e229a79aa56c74cff1af907c.jpg"},{"icon":"6486cc3ca24fd2e6a0fedf6044c261dc4bfbf855.jpg","localized_name":"Master Mason","archived":0,"hidden":0,"name":"Master Mason","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/6486cc3ca24fd2e6a0fedf6044c261dc4bfbf855.jpg"},{"icon":"1c6e74296b48bda2794097b5c6ee424d5df86b87.jpg","localized_name":"Bolted Together","archived":0,"hidden":0,"name":"Bolted Together","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/1c6e74296b48bda2794097b5c6ee424d5df86b87.jpg"},{"icon":"abe61d3a293826292780cc75d7a142fc479925c9.jpg","localized_name":"By Royal Decree","archived":0,"hidden":0,"name":"By Royal Decree","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/abe61d3a293826292780cc75d7a142fc479925c9.jpg"},{"icon":"21065c3d17caa7b0794f8065ccb64d475701a9a4.jpg","localized_name":"By a Thread","archived":0,"hidden":0,"name":"By a Thread","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5370670\/21065c3d17caa7b0794f8065ccb64d475701a9a4.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"https:\/\/www.castlestacker.com","email":"support@castlestacker.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5370670?t=1793732223","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5370670\/9911e1d87d0f90bdf54a9e1a62e2f5ccf15a665a\/page_bg_raw.jpg?t=1793732223","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Violência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Gewalt"}}}}}
id":27,"description":"Cross-Platform Multiplayer"},{"id":62,"description":"Family Sharing"}],"genres":[{"id":"4","description":"Casual"},{"id":"23","description":"Indie"},{"id":"9","description":"Racing"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/390b59010d65d6f678a7a426cd46d37e09336d5b\/ss_390b59010d65d6f678a7a426cd46d37e09336d5b.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/390b59010d65d6f678a7a426cd46d37e09336d5b\/ss_390b59010d65d6f678a7a426cd46d37e09336d5b.1920x1080.jpg?t=1793723822"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/5b6a98099fbbf55f9c0b557f20870e8210598253\/ss_5b6a98099fbbf55f9c0b557f20870e8210598253.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/5b6a98099fbbf55f9c0b557f20870e8210598253\/ss_5b6a98099fbbf55f9c0b557f20870e8210598253.1920x1080.jpg?t=1793723822"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/f4bd572154f121cf5e48a3587353dd1a91212455\/ss_f4bd572154f121cf5e48a3587353dd1a91212455.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/f4bd572154f121cf5e48a3587353dd1a91212455\/ss_f4bd572154f121cf5e48a3587353dd1a91212455.1920x1080.jpg?t=1793723822"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/d21cb6c166fd69b1846b325c36b8df469300faa3\/ss_d21cb6c166fd69b1846b325c36b8df469300faa3.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/d21cb6c166fd69b1846b325c36b8df469300faa3\/ss_d21cb6c166fd69b1846b325c36b8df469300faa3.1920x1080.jpg?t=1793723822"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstat
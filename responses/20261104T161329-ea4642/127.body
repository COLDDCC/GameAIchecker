e49e3cd33e7dd676\/ss_2cfb19ed5ac536ade95cdcd4e49e3cd33e7dd676.1920x1080.jpg?t=1793723822"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/34ce8c743e38f28e90102f5e49636630c0c8a8d2\/ss_34ce8c743e38f28e90102f5e49636630c0c8a8d2.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/34ce8c743e38f28e90102f5e49636630c0c8a8d2\/ss_34ce8c743e38f28e90102f5e49636630c0c8a8d2.1920x1080.jpg?t=1793723822"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/bad0070ebf8e5b44f77688cebc91bb3fbce6d12c\/ss_bad0070ebf8e5b44f77688cebc91bb3fbce6d12c.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/bad0070ebf8e5b44f77688cebc91bb3fbce6d12c\/ss_bad0070ebf8e5b44f77688cebc91bb3fbce6d12c.1920x1080.jpg?t=1793723822"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/5311a84e800b2fe341858fa60cb708ccf5ef34de\/ss_5311a84e800b2fe341858fa60cb708ccf5ef34de.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/5311a84e800b2fe341858fa60cb708ccf5ef34de\/ss_5311a84e800b2fe341858fa60cb708ccf5ef34de.1920x1080.jpg?t=1793723822"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/6c79e05eb157404ce037acd374a7e0855a4047cb\/ss_6c79e05eb157404ce037acd374a7e0855a4047cb.600x338.jpg?t=1793723822","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5456900\/6c79e05eb157404ce037acd374a7e0855a4047cb\/ss_6c79e05eb157404ce037acd374a7e0855a4047cb.1920x1080.jpg?t=1793723822"}],"movies":[{"id":257464038,"name":"Gameplay Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257464038\/390b59010d65d6f678a7a426cd46d37e0933
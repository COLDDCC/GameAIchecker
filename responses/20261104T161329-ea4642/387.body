":"Casual"},{"id":"23","description":"Indie"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/e7e29b8c26d12aa3c7b870408f393c9bea15290f\/ss_e7e29b8c26d12aa3c7b870408f393c9bea15290f.600x338.jpg?t=1793723212","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/e7e29b8c26d12aa3c7b870408f393c9bea15290f\/ss_e7e29b8c26d12aa3c7b870408f393c9bea15290f.1920x1080.jpg?t=1793723212"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/9b9012abcc2d76e6e88e488eea62d7d694da6ed4\/ss_9b9012abcc2d76e6e88e488eea62d7d694da6ed4.600x338.jpg?t=1793723212","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/9b9012abcc2d76e6e88e488eea62d7d694da6ed4\/ss_9b9012abcc2d76e6e88e488eea62d7d694da6ed4.1920x1080.jpg?t=1793723212"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/a04460cfb9801882d1360a35211e3ed2b0ba0c85\/ss_a04460cfb9801882d1360a35211e3ed2b0ba0c85.600x338.jpg?t=1793723212","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/a04460cfb9801882d1360a35211e3ed2b0ba0c85\/ss_a04460cfb9801882d1360a35211e3ed2b0ba0c85.1920x1080.jpg?t=1793723212"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/9ca2d0bd7ec4f573fa35ac0e0c493930eed6fac1\/ss_9ca2d0bd7ec4f573fa35ac0e0c493930eed6fac1.600x338.jpg?t=1793723212","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/9ca2d0bd7ec4f573fa35ac0e0c493930eed6fac1\/ss_9ca2d0bd7ec4f573fa35ac0e0c493930eed6fac1.1920x1080.jpg?t=1793723212"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5313470\/a0d09f365df4d71ec78df64cccb21dfc8754b453\/ss_a0d09f365df4d71ec78df64cccb21dfc8754b453.600x338.jpg?t=1793723212
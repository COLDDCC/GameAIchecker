bcc7074bb8849a8f2983ddfb5a8f58d37bd5f.600x338.jpg?t=1793728924","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/ec1bcc7074bb8849a8f2983ddfb5a8f58d37bd5f\/ss_ec1bcc7074bb8849a8f2983ddfb5a8f58d37bd5f.1920x1080.jpg?t=1793728924"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/3fce3c5521423ba1cbfdba7dd5cfbc188bb6993f\/ss_3fce3c5521423ba1cbfdba7dd5cfbc188bb6993f.600x338.jpg?t=1793728924","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/3fce3c5521423ba1cbfdba7dd5cfbc188bb6993f\/ss_3fce3c5521423ba1cbfdba7dd5cfbc188bb6993f.1920x1080.jpg?t=1793728924"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/7ca2a7e6267938b07a9d6424d8a343a45241f04e\/ss_7ca2a7e6267938b07a9d6424d8a343a45241f04e.600x338.jpg?t=1793728924","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/7ca2a7e6267938b07a9d6424d8a343a45241f04e\/ss_7ca2a7e6267938b07a9d6424d8a343a45241f04e.1920x1080.jpg?t=1793728924"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/368d262a3924671e42ccd3cc1e922c673bb007c3\/ss_368d262a3924671e42ccd3cc1e922c673bb007c3.600x338.jpg?t=1793728924","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/368d262a3924671e42ccd3cc1e922c673bb007c3\/ss_368d262a3924671e42ccd3cc1e922c673bb007c3.1920x1080.jpg?t=1793728924"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/501b9de704a964c3d5fd2ec52ea05a56d5b7a043\/ss_501b9de704a964c3d5fd2ec52ea05a56d5b7a043.600x338.jpg?t=1793728924","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4312860\/501b9de704a964c3d5fd2ec52ea05a56d5b7a043\/ss_501b9de704a964c3d5fd2ec52ea05a56d5b7a043.1920x1080.jpg?t=1793728924"},{"id":
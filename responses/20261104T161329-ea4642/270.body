shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/ee3857310c2f390061c925b6db7f3f0c3383b3e8\/ss_ee3857310c2f390061c925b6db7f3f0c3383b3e8.1920x1080.jpg?t=1793679348"},{"id":13,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/1f844092ad84770486afe0a9d39b842cd1e6e72a\/ss_1f844092ad84770486afe0a9d39b842cd1e6e72a.600x338.jpg?t=1793679348","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/1f844092ad84770486afe0a9d39b842cd1e6e72a\/ss_1f844092ad84770486afe0a9d39b842cd1e6e72a.1920x1080.jpg?t=1793679348"},{"id":14,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/b830363c5b43f3001055ddde627dc2bb9fa1c38f\/ss_b830363c5b43f3001055ddde627dc2bb9fa1c38f.600x338.jpg?t=1793679348","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/b830363c5b43f3001055ddde627dc2bb9fa1c38f\/ss_b830363c5b43f3001055ddde627dc2bb9fa1c38f.1920x1080.jpg?t=1793679348"},{"id":15,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/9cc21b3b5882a37d16c6402e73b48509727a1433\/ss_9cc21b3b5882a37d16c6402e73b48509727a1433.600x338.jpg?t=1793679348","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/9cc21b3b5882a37d16c6402e73b48509727a1433\/ss_9cc21b3b5882a37d16c6402e73b48509727a1433.1920x1080.jpg?t=1793679348"},{"id":16,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/f0993aeb6d75c6d80ad6ed7768108e98f03cff35\/ss_f0993aeb6d75c6d80ad6ed7768108e98f03cff35.600x338.jpg?t=1793679348","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4865940\/f0993aeb6d75c6d80ad6ed7768108e98f03cff35\/ss_f0993aeb6d75c6d80ad6ed7768108e98f03cff35.1920x1080.jpg?t=1793679348"},{"id":17,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/st
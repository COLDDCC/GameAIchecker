/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"Silence the Bells","archived":0,"hidden":0,"name":"Silence the Bells","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"Hold the Line","archived":0,"hidden":0,"name":"Hold the Line","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"More Than a Hamlet","archived":0,"hidden":0,"name":"More Than a Hamlet","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"City of Legends","archived":0,"hidden":0,"name":"City of Legends","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"Full Party","archived":0,"hidden":0,"name":"Full Party","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"},{"icon":"537ed2383d2586d875bd20b694347ba1a0aee878.jpg","localized_name":"Down the Dustroad","archived":0,"hidden":0,"name":"Down the Dustroad","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5425850\/537ed2383d2586d875bd20b694347ba1a0aee878.jpg"}]},"release_date":{"coming_soon":false,"date":"Nov 3, 2026"},"support_info":{"url":"aurorakaunitz@gmail.com","email":"aurorakaunitz@gmail.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5425850?t=1793740747","b
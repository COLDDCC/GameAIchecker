ons","archived":0,"hidden":0,"name":"Laying the Foundations","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5419760\/faf8827c79ed5b11bff9a0843b59e55d047b53aa.jpg"}]},"release_date":{"coming_soon":false,"date":"2 Nov, 2026"},"support_info":{"url":"","email":"aecimf23@naver.com"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5419760?t=1793683184","background_raw":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5419760?t=1793683184","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"14","required_age":"14","banned":"0","use_age_gate":"0","descriptors":"Linguagem imprópria\nViolência\nAtos criminosos"},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":"Drastische Gewalt\nAlkohol \/ Tabak\nDerbe Sprache"}}}}}
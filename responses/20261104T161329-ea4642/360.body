eamstatic.com\/community_assets\/images\/apps\/5005570\/3f3158267d391eeddb6800fed648604c76d31d3a.jpg"},{"icon":"db4c77c7bcd64ebbbc0071840f888a353c124a9a.jpg","localized_name":"Ghost in the Wire","archived":0,"hidden":0,"name":"Ghost in the Wire","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/db4c77c7bcd64ebbbc0071840f888a353c124a9a.jpg"},{"icon":"7330fe98e8d21aab4f5d298292c3026f66ce160f.jpg","localized_name":"Origin","archived":0,"hidden":0,"name":"Origin","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/7330fe98e8d21aab4f5d298292c3026f66ce160f.jpg"},{"icon":"24ed3beaa9a53254b0d2ca00e29b7726a5fbfc3b.jpg","localized_name":"Hostile Takeover","archived":0,"hidden":0,"name":"Hostile Takeover","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/24ed3beaa9a53254b0d2ca00e29b7726a5fbfc3b.jpg"},{"icon":"824330fe91be1e50c78139d57f093dbff7dd52ee.jpg","localized_name":"Silence the Choir","archived":0,"hidden":0,"name":"Silence the Choir","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/824330fe91be1e50c78139d57f093dbff7dd52ee.jpg"},{"icon":"3e83efb58ceccaab1374be72b9baf47be91e7676.jpg","localized_name":"Off the Books","archived":0,"hidden":1,"name":"Off the Books","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/3e83efb58ceccaab1374be72b9baf47be91e7676.jpg"},{"icon":"78a0e2e2ca79cf39b82eb24658cba87ece2a8471.jpg","localized_name":"Bury Requiem","archived":0,"hidden":1,"name":"Bury Requiem","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/78a0e2e2ca79cf39b82eb24658cba87ece2a8471.jpg"},{"icon":"8e1d14315834f59ca2638de390d7b64023f8acc1.jpg","localized_name":"Sever the Choir","archived":0,"hidden":1,"name":"Sever the Choir","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5005570\/8e1d14315834f59ca2638de390d7b6
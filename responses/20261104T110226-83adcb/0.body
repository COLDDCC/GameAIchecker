image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"681890829846976262","clanid":"45905817","posterid":"0","headline":"Major v7.05 Update! Undead Ruins Endgame Difficulty, New Hero Lightning, and the","posttime":1792918180,"updatetime":1792922329,"body":"[h1]Fighters, welcome to the Arena\u2019s first post-launch challenge![\/h1][h1]New Endgame Difficulty[\/h1][h3]1. Undead Ruins: Endgame Difficulty[\/h3][p]To unlock this challenge, you must clear Undead Ruins on Difficulty 3 and have a Memory Capacity of at least 40. This will be your ultimate battle in the Undead Ruins![\/p][p]All main bosses have increased durability and new ultimate abilities. Battle time limits have also been extended\u2014get ready for some all-out team fights![\/p][h3]2. New Final Boss: Roy, the Wailing Knight[\/h3][p]The Wailing Knight has long wandered the Undead Ruins. Now, he awaits your challenge.[\/p][p]This boss features three phases and numerous arena-wide abilities that can reduce your maximum HP or deal true damage.[\/p][p]An additional hidden boss also awaits those brave enough to take on the highest difficulty![\/p][h3]3. New Boss Drops[\/h3][list][*][p][b]New card: Wall of Sighs.[\/b] Allows you to banish items from the current run via the selection screen.[\/p][\/*][*][p][b]New exclusive equipment: Wailing Echo.[\/b] Dropped by the Wailing Knight, this powerful piece of equipment can give you an edge in PvP battles.[\/p][\/*][\/list][h3]4. New Hero: Lightning[\/h3][p]Lightning is an agility-based hero whose attacks leave electric orbs on the battlefield. Activate his ability to dash rapidly between the orbs, dealing massive damage![\/p][h1]Limited-Time Event: The ikun Cup Begins! Participate to Earn an Exclusive Skin![\/h1][h3]Event Period[\/h3][p]October 25\u2013November 25[\/p][h3]Rules[\/h3][olist][*][p]Clear any map in the new version and register a leaderboard entry to qualify. There are no restrictions on cards or maps\u2014give it everything you\u2019ve got![\/p][\/*][*][p]Separate brackets are available for solo players and teams of 2, 3, or 4.[\/p][\/*][*][p]Runs using mods or Custom Mode will not count toward event results or leaderboards.[\/p][\/*][*][p]Final standings will be determined by the leaderboard rankings at the end of the event.[\/p][\/*][\/olist][h3]Rewards[\/h3][p]All participants will receive the event-exclusive [b]AK Chicken skin[\/b]![\/p][p]After updating to the new version, clear any map, then select the [b]ikun Cup[\/b] entry on the main menu to register.[\/p][p]Players who place on the leaderboards will also receive mystery in-game cosmetic rewards and be inducted into the [b]Hall of Fame[\/b]! Ranking reward skins will be revealed over time.[\/p][h1]Improvements and Adjustments[\/h1][olist][*][p]Updated the results screen and the solo retry feature. You can now keep retrying a failed wave![\/p][\/*][*][p]Added the ability to revive downed teammates in Deathmatch Mode. \u201cI need healing!\u201d[\/p][\/*][*][p]Adjusted the difficulty curve and increased the number of enemies in early waves. More enemies, more loot![\/p][\/*][*][p]Adjusted boss attack pacing and increased ability cooldowns for most bosses.[\/p][\/*][*][p]Increased the materials earned from dismantling cards. Complete your builds faster than ever![\/p][\/*][*][p]Adjusted hero card costs:[\/p][table equalcells=\"1\" colwidth=\",,\"][tr][th][p]Hero Card[\/p][\/th][th][p]Previous Cost[\/p][\/th][th][p]New Cost[\/p][\/th][\/tr][tr][td][p]Cyber Swordmaster[\/p][\/td][td][p]10[\/p][\/td][td][p]8[\/p][\/td][\/tr][tr][td][p]Elven Mage[\/p][\/td][td][p]10[\/p][\/td][td][p]8[\/p][\/td][\/tr][tr][td][p]Bomb Boy[\/p][\/td][td][p]10[\/p][\/td][td][p]8[\/p][\/td][\/tr][tr][td][p]Basketball Superstar[\/p][\/td][td][p]10[\/p][\/td][td][p]5[\/p][\/td][\/tr][tr][td][p]Bard[\/p][\/td][td][p]5[\/p][\/td][td][p]3[\/p][\/td][\/tr][tr][td][p]Arms Master[\/p][\/td][td][p]10[\/p][\/td][td][p]8[\/p][\/td][\/tr][tr][td][p]Flame Mage[\/p][\/td][td][p]10[\/p][\/td][td][p]8[\/p][\/td][\/tr][\/table][\/*][*][p]Improved enemy pathfinding and addressed unexpected crashes.[\/p][\/*][*][p]Improved leaderboard submissions. If you cannot access leaderboard challenges, please try using a gaming network accelerator or report the issue in our discord group.[\/p][\/*][*][p]Increased the Black Dragon battle time limit from [b]240 to 300 seconds[\/b].[\/p][\/*][*][p]Increased the range and damage of the [b]Split Attack[\/b] passive skill.[\/p][\/*][*][p]Fixed an issue where opposing players\u2019 stats were lower than intended in leaderboard battles.[\/p][\/*][*][p][b]Equipment Adjustments:[\/b][\/p][list][*][p][b]Holy Sword of Light:[\/b] Increased stats.[\/p][\/*][*][p][b]Wanderer\u2019s Cloak:[\/b] Cooldown reduced from [b]30 to 25 seconds[\/b].[\/p][\/*][*][p][b]Ancient Battlefield Compass:[\/b] Refresh count increased from [b]1 to 2[\/b].[\/p][\/*][*][p][b]Demon Blade:[\/b] Maximum number of equipment pieces it can devour reduced from [b]3 to 2[\/b].[\/p][\/*][\/list][\/*][\/olist]","commentcount":0,"tags":["mod_reviewed","ModAct_773020726_1792918941_0","ModAct_773020726_1792922466_4"],"language":0,"hidden":0,"forum_topic_id":"562545740485872540","event_gid":"681890829846976261","voteupcount":11,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562545740485872540","rtime32_last_modified":1793614021,"news_post_gid":"0","rtime_mod_reviewed":1792922466,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792916615,"votes_up":11,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"841753396007489276","gidfeature2":"562545740485872540"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["681891464032029038","681891464032027195"],"last_update_event":{"rtime":1792918140,"event_gid":"681890829846976261","announcement_gid":"681890829846976262","clan_account_id":45905817}}};
						</script>
					


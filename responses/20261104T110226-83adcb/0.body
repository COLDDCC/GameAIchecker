rs.[\/p][\/*][*][p]Completing a higher difficulty in co-op mode now automatically unlocks lower difficulties.[\/p][\/*][\/list]","commentcount":0,"tags":["mod_reviewed","ModAct_784176946_1793602497_0","ModAct_773020726_1793604526_4"],"language":0,"hidden":0,"forum_topic_id":"572679490124299375","event_gid":"681891464032029037","voteupcount":7,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793602200,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679490124299375","rtime32_last_modified":1793685597,"news_post_gid":"0","rtime_mod_reviewed":1793604526,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793602119,"votes_up":7,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"841753396007489276","gidfeature2":"572679490124299375"},{"gid":"681891464032027194","clan_steamid":"103582791475427225","event_name":"V7.07 Update: New Heroes Featuring Incantationless Spells and Move Attacks Debut","event_type":28,"appid":4246640,"server_address":null,"server_password":null,"rtime32_start_time":1793244300,"rtime32_end_time":1793247900,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c279ab28358466d90d73e7ec9f3f46cfb8bece43.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"681891464032027195","clanid":"45905817","posterid":"0","headline":"V7.07 Update: New Heroes Featuring Incantationless Spells and Move Attacks Debut","posttime":1793244343,"updatetime":1793244343,"body":"[p]Move-casting and move-attacking\u2014highly requested by fighters\u2014are now debuting as two new heroes in the game![\/p][p align=\"start\"]\u3010New Heroes\u3011[\/p][p align=\"start\"]Fantasy Mage[\/p][p align=\"start\"]Passive Skill \\[Incantationless Spells]: Regular cast spells require no casting animation and can be cast while moving and during basic attacks.[\/p][p align=\"start\"]Lingya[\/p][p align=\"start\"]Passive Skill \\[Sword God Style]: Automatically slashes while moving; the third hit landed while moving is enhanced.[\/p][p align=\"start\"]\u3010Feature Updates\u3011[\/p][p align=\"start\"]Added the Gangster Godfather hero card \\[Spare Magazine].[\/p][p align=\"start\"]Fixed an issue where the brightness effect on the Undead map failed.[\/p][p align=\"start\"]Optimized the display effect of the IKUN Cup limited AK4 Chicken skin.[\/p][p align=\"start\"]Optimized rune models and pickup effects.[\/p][p align=\"start\"]Defeating the hidden boss on Difficulty 4 now grants Gold Coins and Skull Coins.[\/p][p align=\"start\"]Hidden boss battle preparation time: 5s -> 15s.[\/p][p align=\"start\"]Optimized some UI display effects.[\/p][p align=\"start\"]Hero \\[Cyber Ninja]: Passive attack now gains a multi-attack bonus; Strength growth 12 -> 13; initial attack range 2.2 -> 2.5.[\/p][p align=\"start\"]Fixed an issue where the boss could get stuck near walls.[\/p][p align=\"start\"]Equipment \\[Demon Blade]: Randomly devours a shop item -> Devours the last shop item purchased.[\/p][p align=\"start\"]\u3010Balance Updates\u3011[\/p][p align=\"start\"]Light Piggy Bank: Interest cap 2000 -> 3000[\/p][p align=\"start\"]Dark Piggy Bank: Elite monster rewards 20% -> 30%; enhancement rewards 1% -> 2%[\/p][p align=\"start\"]Hero Tombstone: Gold 1250 -> 1500; stats 15 -> 18[\/p][p align=\"start\"]Ashen Pact: Gold 850 -> 1000; stats 10 -> 12[\/p][p align=\"start\"]Superior Relic: 10% -> 15%[\/p][p align=\"start\"]Passive skill: Split Attack damage increased[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1426387032_1793245305_0"],"language":0,"hidden":0,"forum_topic_id":"572679173079941800","event_gid":"681891464032027194","voteupcount":6,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679173079941800","rtime32_last_modified":1793604250,"news_post_gid":"0","rtime_mod_reviewed":1793245306,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793240363,"votes_up":6,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"841753396007489276","gidfeature2":"572679173079941800"},{"gid":"681890829846976261","clan_steamid":"103582791475427225","event_name":"Major v7.05 Update! Undead Ruins Endgame Difficulty, New Hero Lightning, and the","event_type":14,"appid":4246640,"server_address":null,"server_password":null,"rtime32_start_time":1792918140,"rtime32_end_time":1792922401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,
6807196526?ls=1",name:"Metal Stream Apple",disable:false},{id:8,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/4317690/Crimson_Moon/",name:"Metal Steam",disable:false,property:"metal"},{id:2,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/ire-94cf31",name:"Ire Epic",disable:false,property:"ireprologue"},{id:21,status:"published",platform:"stream_ytmusic",state:"available",url:"https://music.youtube.com/playlist?list=OLAK5uy_kvQX-uM3s0NC7PilFG046PiOZaEvVFJ7g",name:"Metal Stream YTMusic",disable:false},{id:22,status:"published",platform:"stream_amazonmusic",state:"available",url:"http://music.amazon.com/albums/B0HHCFZG1Z",name:"Metal Stream Amazon Music",disable:false},{id:17,status:"published",platform:"ps5",state:"available",url:"https://store.playstation.com/en-us/product/UP2776-PPSA27163_00-0947685141970265",name:"metal-deluxe-sony",disable:false},{id:6,status:"published",platform:"ps5",state:"available",url:"https://store.playstation.com/concept/10013260",name:"Metal PS5",disable:false,property:"metal"},{id:25,status:"published",platform:"stream_tidal",state:"available",url:"http://www.tidal.com/album/557221191",name:"Metal Stream Tidal",disable:false},{id:26,status:"published",platform:"stream_pandora",state:"available",url:"https://www.pandora.com/artist/christopher-wilson-and-probably-monsters/crimson-moon-original-video-game-soundtrack/ALmVnr2ndp9cq5q",name:"Metal Stream Pandora",disable:false},{id:18,status:"published",platform:"xboxseries",state:"available",url:"https://www.xbox.com/games/store/crimson-moon/9P6RKSP3MMCM",name:"Metal Deluxe Xbox",disable:false},{id:7,status:"published",platform:"xboxseries",state:"available",url:"https://www.xbox.com/games/store/crimson-moon/9nmdsxmvqtn4",name:"Metal XBox",disable:false,property:"metal"},{id:27,status:"published",platform:"stream_deezer",state:"available",url:"https://www.deezer.com/album/1067524461",name:"Metal Stream Deezer",disable:false},{id:3,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/4046570/Storm_Lancers",name:"Stormlancers Steam",disable:false,property:"stormlancers"},{id:4,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/storm-lancers-5369a2",name:"Stormlancers EGS",disable:false,property:"stormlancers"},{id:9,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/crimson-moon-b329bd",name:"Metal EGS",disable:false,property:"metal"},{id:5,status:"published",platform:"nintendo",state:"available",url:"https://www.nintendo.com/store/products/storm-lancers-nintendo-switch-2-edition-switch-2/",name:"Stormlancers Nintendo",disable:false,property:"stormlancers"},{id:19,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/crimson-moon-crimson-moon-deluxe-edition-697bef",name:"metal deluxe epic",disable:false},{id:14,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/4859730/Crimson_Moon_Soundtrack/",name:"Metal OST Steam",disable:false},{id:15,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/crimson-moon-crimsonmoonsoundtrack-4fefb9",name:"Metal OST Epic",disable:false},{id:10,status:"published",platform:"steam",state:"preorder",url:"https://store.steampowered.com/app/4200110/Nekome_Nazi_Hunter/",name:"Nekome Steam",disable:false,property:"nekome"},{id:11,status:"published",platform:"ps5",state:"preorder",url:"https://store.playstation.com/concept/10017846",name:"Nekome PS5",disable:false,property:"nekome"},{id:12,status:"published",platform:"xboxseries",state:"preorder",url:"https://www.xbox.com/games/store/nekome-nazi-hunter/9mv2jjsl35zv",name:"Nekome Xbox",disable:false,property:"nekome"},{id:13,status:"published",platform:"epic",state:"preorder",url:"https://store.epicgames.com/p/nekome-712f11",name:"Nekome Epic",disable:false,property:"nekome"}]},strings:{en:{pm:{meta_description:"ProbablyMonsters’ mission is to unite, guide, and empower talented teams to redefine what it means to deliver exceptional games within a healthy, rewarding culture.",archway_nav:{storm:{buyheading:"Play Demo Now on Steam",text:"Storm Lancers is a couch co-op rogue-like with fluid combat and nonstop action. Team up and conquer waves of enemies with speed and style."},ire:{heading:"What if Hide and Seek was Life and Death?",text:"Inspired by 80s horror, Ire: A Prologue is a first-person, narrative horror game set in a loop with a terrifying monster."}},video_section_header:"We don't just want to make better games. We want to make gaming better.",careers_section_title:"Monsters Wanted",careers_section_subtitle:"We're looking for bold thinkers, dreamers, and creators with a collaborative spirit.",games_section_title:"New Worlds",leader_section_title:"Meet Our Leaders",people:{"harold-ryan":{name:"Harold Ryan",title:"CEO & Founder",short_summary:"With over 25 years of games industry success, Harold has generated over $5B of revenue through iconic franchises such as Halo, Destiny, Age of Empires, and MechWarrior."},"dave-lesperance":{name:"Dave Lesperance",title:"General Manager",short_summary:"A passionate creative director with a technical art and environment design background, Dave spent the last 16+ years working with studios such as Activision, Blizzard, Microsoft, Valve, Riot, and Tencent."},"chris-opdahl":{name:"Chris Opdahl",title:"General Manager",short_summary:"With over 20 years of experience, Chris is adept at directing and managing large organizations while creating high-functioning and empowered teams that build quality games."},"carlos-sanchez":{name:"Carlos Sanchez",title:"General Manager",short_summary:"With 20+ years of experience, Carlos has held prominent positions at Riot Games, Turn 10, Bungie, Xbox and EA. He's led large, AAA teams to success by doubling player base and driving operational maturity."},"shannon-armstrong":{name:"Shannon Armstrong",title:"Chief Human Resources Officer",short_summary:"Shannon is an HR and recruiting leader with over 20 years of experience in technology startups, retail organizations, and finance."},"steve-burnaroos":{name:"Steve Burnaroos",title:"VP Operations",short_summary:"A proven leader with over a decade of experience overseeing the daily operations of heralded businesses like Bungie, Steve brings passion, organization, and efficiency to every department of the company."},"jennifer-jolley":{name:"Jennifer Jolley",title:"General Counsel",short_summary:"With 25 years in technology and entertainment, Jennifer previously served as the chief intellectual property advisor for Big Fish Games and Product Madness."},"mark-subotnick":{name:"Mark Subotnick",title:"Chief Product Officer",short_summary:"Mark “Bot” Subotnick, Chief Product Officer at ProbablyMonsters, is a veteran games executive who joined the company in 2023 after leadership roles at Intel, Microsoft, and SEGA, and who started his career in 1993 as a QA tester at SEGA of America."},"jenna-hardy":{name:"Jenna Hardy ",title:"Chief Financial Officer ",short_summary:"With over 15 years of experience in finance for gaming and entertainment, Jenna held key leadership roles at Gearbox Entertainment and Warner Bros, overseeing major acquisitions, fundraising, and strategic financial planning. "},"marc-tardiff":{name:"Marc Tardiff ",title:"General Manager ",short_summary:"Marc has over 20 years of experience in studio management, publishing, and developing AAA video game titles including: Starfield, Fallout76, DOOM 2016, Borderlands, Halo PC, and Aliens. "},"jim-veevaert":{name:"Jim Veevaert",title:"Executive Product Manager",short_summary:"A 25-year veteran of the Games industry and an executive at IGT, Zynga, and Microsoft, where he oversaw popular franchises like Halo 3 and Gears of War. He played a crucial role in launching influential titles like Half-Life and Counter-Strike as a co-founder of Sierra Studios. Jim's career began at Interplay Productions, where he worked with renowned teams, including Blizzard Entertainment and BioWare."},"jeronimo-barrera":{name:"Jeronimo Barrera",title:"General Manager",short_summary:"Jeronimo Barrera has played a pivotal role in shaping some of gaming’s most iconic franchises. He began his career at SEGA in 1991 before becoming a key figure at Rockstar Games, where he spent over 20 years advancing from Designer to VP of Product Development. His contributions to Grand Theft Auto, Red Dead Redemption, and other groundbreaking titles helped redefine the industry. Now at ProbablyMonsters, he continues to drive innovation, fostering a studio culture built on creativity and empowerment."},"matt-case":{name:"Matt Case",title:"General Manager",short_summary:"Matt has over 20 years of experience in narrative development, studio leadership, and interactive storytelling, with credits on numerous AAA video game titles. As Story Creative Director at Bungie, he built and led the studio’s story team, shipping: Destiny, Destiny: The Dark Below, Destiny: House of Wolves, and Destiny: The Taken King."},"john-lander":{title:"Chief Publishing Officer",short_summary:"Jonathan Lander previously served as Senior Vice President of Global Product and Publishing Operations at Bethesda Softworks, supporting major releases from Bethesda Game Studios, ZeniMax Online Studios, id Software, and MachineGames. At ProbablyMonsters, he guides release planning, franchise development, and long-term publishing strategy as we look to expand our internal publishing capabilities.",name:"Jonathan Lander"},"david-reid":{title:"Chief Marketing Officer",short_summary:"David Reid has over two decades of global publishing and marketing leadership experience, including roles as CMO of Behaviour Interactive, CMO of CCP Games, SVP of Publishing at Trion Worlds, and Director of Xbox Platform Marketing. At ProbablyMonsters, he drives cohesive marketing execution across a growing slate of original titles, aligning brand strategy closely with long-term publishing strategy.",name:"David Reid"}},timeline_section_title:"Our Journey",timeline:{"2019":{heading:"2019",content:"We officially announced ProbablyMonsters and our first incubated game development teams."},"2020":{heading:"2020",content:"We grew to over 150 employees, expanded into our new HQ, and started building our third game development team, Battle Barge."},"2021":{heading:"2021",content:"We announced our publishing partnership with PlayStation for our first game developed by Firewalk and began our Series A fundraise."},"2022":{heading:"2022",content:"Our Series A fundraising closed at $250M, the largest raise in video gaming history. We closed the year with a 65% growth rate."},"2023":{heading:"2023",content:"After successful years of incubation with us, Firewalk joined Playstation. Later that year, we opened a new location in Fort Worth, Texas."},"2024":{heading:"2024",content:"Hidden Grove is publicly announced along with new leaders across the company."}},news_section_title:"In the News",location_section_title:"Contact & Locations",contacts:{"join-pm":{title:"Join ProbablyMonsters"},media:{title:"Media Inquiries"},general:{title:"General Inquiries"}},sunset_north:{name:"Sunset North"},bellevue:{address_line_1:"Bellevue, WA"},eastgate:{name:"Bellevue"},fort_worth:{name:"Fort Worth",address_line_1:"Fort Worth, TX"},location_section_link:"View Open Positions",video_section_description:"At ProbablyMonsters, we have a unique way of inspiring creativity. We're an independent game company building a healthier culture by bringing together a diverse roster of development teams in a collaborative environment. When creators are free to dream, they build brilliant worlds, engaging games, and the best player experiences. We believe gaming deserves a better future. Come help us shape it.",news_link:"Read Article",about_meta_description:"ProbablyMonsters is an independent video game company focused on delivering high-quality titles across a variety of genres.",news_meta_description:"Read the latest news on ProbablyMonsters and its games.",footer_legal_boilerplate_all:"PROBABLYMONSTERS, the PROBABLYMONSTERS logo, Storm Lancers, the Storm Lancers logo, Ire: A Prologue, the Ire: A Prologue logo, Nekome: Nazi Hunter, and the Nekome: Nazi Hunter logo are trademarks of ProbablyMonsters Inc. Nintendo Switch is a trademark of Nintendo. ©2026 Valve Corporation.  Steam and the Steam logo are trademarks and/or registered trademarks of Valve Corporation in the U.S. and/or other countries.  Epic, Epic Games, Epic Games Store, the Epic Games Store logo, and Epic Online Services are trademarks and/or registered trademarks of Epic Games. “PlayStation Family Mark” and “PS5 logo” are registered trademarks or trademarks of Sony Interactive Entertainment Inc.  All other trademarks are the property of their respective owners.",footer_legal_boilerplate_temp:"PROBABLYMONSTERS, the PROBABLYMONSTERS logo, Storm Lancers, the Storm Lancers logo, Ire: A Prologue, and the Ire: A Prologue logo are trademarks of ProbablyMonsters Inc. Nintendo Switch is a trademark of Nintendo. ©2026 Valve Corporation.  Steam and the Steam logo are trademarks and/or registered trademarks of Valve Corporation in the U.S. and/or other countries.  Epic, Epic Games, Epic Games Store, the Epic Games Store logo, and Epic Online Services are trademarks and/or registered trademarks of Epic Games.  All other trademarks are the property of their respective owners.",about_title:"About Us",about_meta_title:"About Us"},gb:{career_table_open_role:{plural:"Open Roles",singular:"Open Role"},btn_load_more:"Load More",btn_hide_more:"Hide More",footer_copyright:"ProbablyMonsters Inc. All rights reserved.",footer_legal_boilerplate:"PROBABLYMONSTERS and the PROBABLYMONSTERS logo are trademarks of ProbablyMonsters Inc.",career_table_filter:"Filter",faq:{"1":{question:"Where do I apply for a job?",response:"Here on our Careers page is a list of all open positions across ProbablyMonsters and our game development teams. Click the “view job” button next to the position you're interested in, and the “apply” button at the bottom of the detailed job description."},"2":{question:"How can I add a cover letter to my application?",response:"There is a cover letter button at the bottom of the application page under “additional files”."},"3":{question:"How can I submit my portfolio / demo reel?",response:"There is a portfolio button at the bottom of the application page under “additional files”. Demo reels should be 1 to 3 minutes in length. Unless you are an animator, demo reels are not necessary. We place emphasis on artwork process breakdowns for our artist positions. Refer to the job posting for specific submission requirements."},"4":{question:"Will ProbablyMonsters provide feedback on my application?",response:"Due to the quantity of submissions received, we are not able to offer individual feedback."},"5":{question:"Do you offer internships?",response:"Yes, we encourage students to apply! All internships will be posted to our career page by March of each year."},"6":{question:"Can I submit a game or story idea?",response:"No. Each of our game's ideas and stories are developed internally and it is our company-wide policy not to view any external submissions."},"8":{question:"What if I'd like to apply for a position that isn't currently open?",response:"On our open positions list on the Careers page, under the “Other” category, there is a “General Application” position. Please apply there and let us know what position(s) you are interested in!"},"9":{question:"What does the ProbablyMonsters benefits package look like?",response:"We offer a competitive benefits package, including annual stock option grants; health coverage (medical, dental, vision) with the majority of the employee premium covered by the Company and high subsidized coverage for dependents; Flexible Spending Account eligibility; Health Savings Account contributions by the Company, Company sponsored life, accidental death, and disability insurance coverage; annual 401K and match by the Company; Employee Assistance Program; paid family/medical leave and extensive paid time off plus holiday closures."}},newsletter_error:"Something went wrong. Please try again later.",btn_return_home:"Return to ProbablyMonsters Home\n",career_table_filters:"Filters",job_alerts_button:"Sign up for Job Alerts",btn_read_more:"Read More",faq_title:"Frequently Asked Questions",site_name:"ProbablyMonsters",errors_generic:"Uh Oh, looks like something broke.",errors_404:"Page Not Found",btn_back_to_careers:"Back to Careers",btn_apply:"Apply",terms_of_use:"Terms of Use",privacy_policy:"Privacy Policy",carousel_arrow_label_prev:"Previous",carousel_arrow_label_next:"Next",btn_view_job:"View Job",btn_learn_more:"Learn More",btn_close:"Close",press_additional:"Additional Press",career_table_clear:"Clear All",faq_button:"Read our F.A.Q.",jobs_view_open_singular:"{count} Open Role",jobs_view_open:"{count} Open Roles",filter_results:"Filter Your Results",jobs_view_open_positions:"View Open Positions",btn_reset:"Reset",btn_signup:"Sign Up",btn_submit:"Submit",form_field_name:"Name",form_field_email:"Email",form_field_region:"Region",form_field_agree_to_TOS:"By checking this box, I acknowledge that I am at least 18 years of age, that I agree to the ProbablyMonsters {terms}, and that I have read and acknowledge the {privacy}. I consent to receive news, game reveals, and updates from ProbablyMonsters about its games via newsletter.",form_field_required:"*Required",form_field_first:"First",form_field_last:"Last",form_field_optional:"(optional)",btn_more_news:"More News",btn_sort_table:"Sort",social_media_follow_us:"Follow Us",btn_steam_wishlist:"Steam",media_filter_screenshot:"Screenshots",media_filter_video:"Videos",media_filter_wallpaper:"Wallpapers",btn_press_kit:"Press Kit",social_media_conversation:"Join the Conversation",form_field_newsletter_signup_chk:"Send me the Newsletter",newsletter_join_header:"Join Our Newsletter",newsletter_join_desc:"Be the first to hear the latest on all our upcoming games. Sign up for our newsletter and get exclusive updates, behind-the-scenes content, and more.",newsletter_thankyou_title:"Thank You",newsletter_thankyou_body:"Please check your email inbox to confirm your sign-up.",btn_wishlist_epic:"Epic",wishlist_on:"Wishlist On",btn_accept:"Accept",btn_decline:"Decline",btn_privacy_choose:"Let Me Choose",cookie_notification_summary:"We collect anonymous performance data (page load times, resource timings, errors) and usage data (clicks, taps, form submissions) to help us improve this site.  No personal information is tracked.",cookie_notification_title:"Your Privacy Choices",privacy_options_link:"Do Not Sell or Share my Personal Information",privacy_optin_chk:"Opt-In",btn_accept_all:"Accept All",btn_reject_all:"Reject All",btn_confirm:"Confirm",privacy_options_advertising_title:"Advertising",privacy_options_advertising_body:"These cookies are used to make advertising messages more relevant to you. They perform functions like preventing the same ad from continuously reappearing, ensuring that ads are properly displayed for advertisers, and in some cases selecting advertisements that are based on your interests.",privacy_options_analytics_title:"Analytics",privacy_options_analytics_body:"Subject to your consent, we use these cookies, like Google Analytics, to help us understand how users access and use our services. The data collected typically includes information such as your IP address, your internet service provider, your web browser, the time spent on web pages, the links clicked and the advertisements viewed on those pages. We use this information to improve the Services and your experience, to see which areas and features of our services are popular, and for which visitors, and to count visits.",privacy_options_legalbasis_title:"Legal Basis",privacy_options_legalbasis_body:"Data subject has received adequate disclosure describing the processing for one or more specific purposes, and can subsequently opt-out.",customer_support:"Customer Support",account:"Account",btn_buy_now:"Buy Now",play_demo_now:"Play Demo Now",available_now:"Available Now",form_field_TOS_privacy_link_pm:"ProbablyMonsters \u003Ca href=\"/{lang}/privacy\" target=\"_blank\">Privacy Statement\u003C/a>",form_field_TOS_privacy_link_storm:"Storm Lancers \u003Ca href=\"/{lang}/stormlancers/privacy\" target=\"_blank\">Privacy Statement\u003C/a>",discord_button:"Join Our Discord",buy_title_steam:"Buy on Steam Store",buy_title_egs:"Buy on Epic Games Store",buy_title_psn:"Buy for PlayStation",buy_title_xbox:"Buy for Xbox",buy_title_nintendo:"Buy on Nintendo eShop",coming_soon:"Coming Soon",age_gate_header:"Please verify your age to continue.",age_gate_fail_msg:"We're sorry, but you may not access this content.",section_title_media:"Media",section_title_news:"News",wishlist_now:"Wishlist Now",btn_play_trailer:"Watch Trailer",section_title_features:"Game Features",platform_steam:"Steam Store",platform_egs:"Epic Games Store",platform_ps5:"Playstation 5",platform_xboxseries:"Xbox Series X|S",platform_nintendoeshop:"Nintendo eShop",section_title_pm_news:"In The News",tag_filter_all:"All Posts",section_title_games:"Our Games",on_sale_now_percentage:"On Sale Now - {percentage}% Off",btn_continue_to_page:"Continue to {page}",more_pm_careers:"More ProbablyMonsters Careers",related_news:"Related News",related_posts:"Related Posts",job_meta_title:"Job Opening: {job}",job_meta_description:"Job Opening: {title} ({location}) ",age_gate_day:"Day",age_gate_month:"Month",age_gate_year:"Year",privacy_statement:"Privacy Statement",tag_patch_notes:"Patch Notes",available:"Available",edition_includes:"This Edition Includes:",section_title_editions:"Editions",media_filter_trailer:"Trailers",btn_play_now:"Play Now",log_out:"Log Out",cancel:"Cancel",back:"Back",have_a_redemption:"Have a redemption code?",btn_redeem_now:"Redeem Now",log_in:"Log In",stream_now_on:"Listen Now On",platform_spotify:"Spotify",platform_ytmusic:"YouTube Music",platform_apple_music:"Apple Music",platform_amazon_music:"Amazon Music",platform_tidal:"Tidal",platform_pandora:"Pandora",platform_deezer:"Deezer",section_title_game_updates:"Game Updates",play_demo_on_steam:"Play Demo Now on Steam"},nav:{about:"About",careers:"Careers",contact:"Contact",terms:"Terms of Use",privacy:"Privacy Policy",news:"News",games:"Games",customer_support:"Customer Support"},cr:{meta_title:"ProbablyMonsters Careers",meta_description:"ProbablyMonsters is all about creating amazing games and fostering rewarding careers. People are at the heart of our vision, so our benefits are carefully tailored to support our award-winning culture.",heading_title:"We're Hiring",heading_description:"Our teams are growing, and we’re on the lookout for talented Monsters. Check out our current job openings.",career_table_clear:"Clear All",category:"Category",team:"Team",location:"Location",faq_button:"Read our F.A.Q.",job_alerts_button:"Sign up for Job Alerts",equal_opportunity_disclaimer:"ProbablyMonsters Inc. is an equal opportunity employer. All qualified applicants and employees will receive consideration for employment without regard to race, color, religion, sex, national origin, veteran status, disability, sexual orientation, gender identity, or any other protected status.",benefits_tile:"Benefits",benefits_description:"We’re all about creating amazing games and fostering rewarding careers. People are at the heart of our vision, so our benefits are carefully tailored to support our award-winning culture. Here are just some of the unique benefits we offer.",benefits:{rewarding:{title:"Rewarding Foundation",summary:"Enjoy a competitive salary, bonus potential for qualifying roles, and a 401(k) with a generous company matching program, plus a robust health benefits package for individuals and families."},future:{title:"An Eye Toward the Future",summary:"Continue to learn and evolve in an ever-changing industry with dedicated training programs and mentoring by award-winning leaders. Participate in a variety of community outreach and service programs to help foster a more sustainable and inclusive industry for the next generation of developers."},playtesting:{title:"Playtesting",summary:"You'll have the exciting opportunity to playtest games in development, providing invaluable feedback to our development teams. Dive into unreleased content, explore new worlds, and help refine gameplay mechanics, ensuring our games deliver the best experience possible to players worldwide."},life:{title:"More Time to Enjoy Your Life",summary:"Enjoy a fulfilling work-life balance with our comprehensive benefits package, including a generous PTO plan, and paid family and medical leave."},hybrid:{title:"Hybrid & Remote",summary:"Remote and/or hybrid work arrangements are available for qualifying roles."},stock:{title:"Annual Stock Option Grants",summary:"Share in the company’s future with stock option grants planned annually for qualifying roles."}},career_table_open_role_singular:"Open Role",career_table_open_role_plural:"Open Roles"},job:{art:{title:"Art & Animation",description:"Join world-class artists and help breathe life into ambitious new IP."},audio:{title:"Audio",description:"Add depth and emotion to every moment through the art of sound."},admin:{title:"Corporate Administration",description:"Join a central services team that helps support all Monsters."},engineer:{title:"Engineering",description:"Help architect & build our tech, UI, player systems, and more."},game:{title:"Game Design",description:"Create levels, systems, and moments that thrill players around the world."},infotech:{title:"Information Technology",description:"Support our internal teams with technology infrastructure and IT needs."},legal:{title:"Legal",description:"Provide legal counsel to our game teams and advise on best practices and compliance."},marketing:{title:"Marketing",description:"Faithfully represent our games and our vision."},operations:{title:"Operations Management",description:"Help meet the needs of our growing game development teams."},hr:{title:"People Team / HR",description:"Shepherd our award-winning culture and support our Monsters."},production:{title:"Production",description:"Help our teams flourish with predictable excellence."},qa:{title:"Quality Assurance",description:"Test our games, identify bugs and risks, and represent the player's voice."}},error:{error_message:"Uh Oh, looks like something broke.",not_found:"Not Found",return_btn:"Return to ProbablyMonsters Home"},storm:{splash_title:"STORM LANCERS",tagline_title:"Fight Together. Rise Together!",tagline_body1:"You and your friend just crash-landed on an alien planet harboring a secret source of powerful magic. All of reality is on the verge of collapse, and two magical creatures have chosen you as their heroes. To save the planet, you’ll fight, die, and bond with the Stormhearts to rise again — stronger, fiercer, and unstoppable.",features_title:"Game Features",features_item1_title:"ROGUE-LITE ACTION",features_item1_body:"On Cryptica, no two runs are the same. In this side-scrolling rogue-like, you'll navigate shifting biomes where every leap, slash, and dash brings you one step closer to unraveling the mystery. With each playthrough, discover new items that make that run’s playstyle unique and gain permanent upgrades that make you stronger.",features_item2_title:"CHAOTIC COUCH CO-OP",features_item2_body:"Help a friend then nab a rare drop right out from under them. This is all-out, rogue-like action ready for two. Whether you’re having trouble with a later biome or just looking to add some chaos, a friend can join instantly in couch co-op or online with Nintendo GameShare or Steam Remote Play Together. And if your partner drops, keep playing seamlessly in solo mode to stay in the action.",features_item3_title:"BOSSES & ENEMIES",features_item3_body:"From a machine race that consumes planets to alien flora and fauna that want to kill everything, fight through bosses and enemies who will force you to think faster, fight harder, and adapt quickly. This is an ever-changing battlefield where killer instincts and survival skills are everything. ",media_title:"Media",media_btn_presskit:"Press Kit",news_title:"In The News",newsletter_title:"Join Our Newsletter",newsletter_body:"Cryptica is calling! Join the Storm Lancers newsletter for exclusive updates, behind-the-scenes content, and early access to games. ",features_item4_title:"WEAPONS & ABILITIES ",features_item4_body:"Arm yourself with a variety of weapons built for every kind of playstyle and run. From flaming Swords and razor-sharp Katars to Rifles, crushing Hammers, and Grenade Launchers, each weapon is designed for destruction. Choose wisely — or die quickly.",tagline_body2:"Storm Lancers is a fast-paced rogue-lite, where every run means dodging death, overcoming enemies, and mastering powerful skills. The battle is on, so team up in chaotic co-op for survival. ",meta_title:"Storm Lancers",meta_desc:"Storm Lancers is a couch co-op Rogue-Like with fluid combat and nonstop action. Team up and conquer waves of enemies with speed and style.",footer_legal_boilerplate:"PROBABLYMONSTERS, the PROBABLYMONSTERS logo, Storm Lancers, and the Storm Lancers logo are trademarks of ProbablyMonsters Inc.  Nintendo Switch is a trademark of Nintendo. ©2026 Valve Corporation. Steam and the Steam logo are trademarks and/or registered trademarks of Valve Corporation in the U.S. and/or other countries.  Epic, Epic Games, Epic Games Store, the Epic Games Store logo, and Epic Online Services are trademarks and/or registered trademarks of Epic Games. All other trademarks are the property of their respective owners.",articles_title:"The Latest"},ire:{splash_title:"Ire: A Prologue",splash_subtitle:"October 28, 2025",trailer_title:"WHAT IF HIDE AND SEEK WAS LIFE AND DEATH?",trailer_body:"It’s 1986, and you're stranded on a ship in the Bermuda Triangle. Everyone is missing — but you’re not alone. You’re trapped in a terrifying loop with a monster, and you’ll have to stay one step ahead to survive. Ready or not, here it comes.",features_title:"Game Features",feature_1_body:"A missing father. A haunted ship. And thirteen doors to the truth.  Emily is a young teenage girl. Her father has vanished — and the only clues to his disappearance lie aboard a ship lost deep in the Bermuda Triangle. To find Emily’s father, and just maybe bring him back, you’ll have to unlock 13 mysterious doors hiding in the ship’s dark, narrow corridors — all with a monster stalking your every move. How far will you go to uncover the truth?",feature_2_body:"A love letter to 80’s and 90’s horror, Ire: A Prologue immerses you in a haunting story from a young girl’s perspective, inviting you to experience a dark world through the lens of her innocence and imagination— one loop at a time.",feature_3_body:"A relentless monster is stalking you, and the only way to survive is to stay hidden. As you sneak around the ship, use your skills and size to outsmart it. Slip into clever hiding spots, squeeze into vents, and make noise to distract it. The smarter you get, the smarter it gets. So, listen closely, move carefully, and collect the clues before it finds you.",media_title:"Media",news_title:"News",newsletter_title:"Join Our Newsletter",newsletter_body:"Be the first to know what’s happening in the Ire universe. Sign up for our newsletter and get exclusive updates, behind-the-scenes content, and early access to games.",meta_title:"Ire: A Prologue",meta_desc:"Inspired by 80s horror, Ire: A Prologue is a first-person, narrative horror game set in a loop with a terrifying monster.",feature_4_body:"This is just the beginning. Ire: A Prologue sets up the deep story behind the many mysteries that await in the Ire franchise. With each game, you’ll uncover hidden lore, new monsters, and more horrors that pull you deeper into this unsettling world. Can you survive long enough to uncover the truth?",feature_1_title:"UNRAVEL THE TRUTH, ONE LOOP AT A TIME",feature_2_title:"NOSTALGIA HORROR",feature_3_title:"YOU HIDE, IT SEEKS",feature_4_title:"THE START OF A NEW HORROR FRANCHISE",footer_legal_boilerplate:"PROBABLYMONSTERS, the PROBABLYMONSTERS logo, IRE: A Prologue and the IRE: A Prologue logo are trademarks of ProbablyMonsters Inc.  ©2026 Valve Corporation.  Steam and the Steam logo are trademarks and/or registered trademarks of Valve Corporation in the U.S. and/or other countries.  Epic, Epic Games, Epic Games Store, the Epic Games Store logo, and Epic Online Services are trademarks and/or registered trademarks of Epic Games. All other trademarks are the property of their respective owners.g",spooky_type_1:"You Hide, It Seeks",spooky_type_2:"Life and Death"},nekome:{splash_title:"Nekome: Nazi Hunter",splash_cta:"Revenge Begins December 2026",trailer_text:"\u003Cspan>Nekome: Nazi Hunter\u003C/span> is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers. The game follows Vano’s transformation from hunted to hunter as he embarks on a violent personal odyssey of revenge across a war-torn world.\u003Cbr>\u003Cbr>\u003Cspan>Nekome: Nazi Hunter\u003C/span> approaches the Second World War from the personal perspective of Vano as he exacts revenge for the sadistic murders. You’ll scout enemy routes, plan your assault, and strike with precision in a mix of stealth and brutal up-close combat.\u003Cbr>\u003Cbr>The game is inspired by grindhouse cinema and features visceral combat with grounded finishing moves, coming together in a symphony of violence where every encounter carries lasting consequences.",discord_title:"Be among the first to learn more",discord_text:"Join our Discord for exclusive updates, behind-the-scenes content, and future conversations with the Devs.",meta_title:"Nekome: Nazi Hunter",meta_desc:"Nekome: Nazi Hunter is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers.",media_title:"Media",game_features_1_title:"REVENGE IS PERSONAL",game_features_1_body:"Each mission begins in the enemy’s backyard, where you’ll stalk Nazis, assassinate guards, and set traps to frighten your foes. Enemy awareness is shared and persistent—kill carelessly and patrols respond, wait too long and reinforcements arrive. Stealth isn’t about avoiding the fight. It’s about stacking the odds before the true combat begins.",game_features_2_title:"STRATEGIC COMBAT",game_features_2_body:"Every encounter is your chance to craft a savage masterpiece. Melee is raw, brutal, and bloody, built for life-or-death, close quarters fighting with each punch, stab, and parry making an impact. Use improvised weapons to gain the advantage over enemies who adapt to your fighting style, slow down combat to chain targeted strikes into cinematic assaults, and bring the violence to a finale with visceral finishing blows.",game_features_3_title:"NOTORIETY AND FEAR\n",game_features_3_body:"Notoriety and fear systems add another layer to combat, allowing you to make an example of your enemies and watch their morale collapse. Fear becomes a formidable weapon earned through surgical, savage tactics. Kill with precision or create chaos, and enemies may panic, hesitate, or flee. The notoriety system tracks your brutality and unpredictability, influencing the enemies’ next actions. Some Nazis may rush in blindly, while others refuse to enter the room.",game_features_4_title:"THE WORLD IS YOUR WEAPON",game_features_4_body:"Fight with fists, blades, guns, and whatever the environment provides. Nazi-occupied spaces are filled with pipes, tools, and hazards waiting to be used as improvised weapons. Choose your path, set your traps, and weaponize the world against your enemies."},legal:{boilerplate_PM_basic:"PROBABLYMONSTERS and the PROBABLYMONSTERS logo{games}are trademarks of ProbablyMonsters Inc.",boilerplate_PM_games_stormlancers:"STORM LANCERS and the STORM LANCERS logo,",boilerplate_PM_games_ireprologue:"IRE: A PROLOGUE and the IRE: A PROLOGUE logo,",boilerplate_PM_games_nekome:"NEKOME, NEKOME NAZI HUNTER and the NEKOME NAZI HUNTER logo",boilerplate_PM_games_metal:"and CRIMSON MOON and the CRIMSON MOON logo",boilerplate_nintendo_switch:"Nintendo Switch is a trademark of Nintendo.",boilerplate_valve_steam:"©{date} Valve Corporation. Steam and the Steam logo are trademarks and/or registered trademarks of Valve Corporation in the U.S. and/or other countries.",boilerplate_epic_egs:"©{date} Epic Games, Inc. All rights reserved. Epic, Epic Games, Epic Games Store and their respective logos are trademarks or registered trademarks of Epic Games, Inc. in the U.S. Patent and Trademark Office and elsewhere.",boilerplate_sony_ps5:"“PlayStation Family Mark” and “PS5 logo” are registered trademarks or trademarks of Sony Interactive Entertainment Inc.",boilerplate_all_other:"All other trademarks are the property of their respective owners.",boilerplate_pm_copyright_date:"©{date} ProbablyMonsters Inc. All Rights Reserved.",boilerplate_epic_games:"©{date} Epic Games, Inc. All rights reserved. Epic, Epic Games and their respective logos are trademarks or registered trademarks of Epic Games, Inc. in the U.S. Patent and Trademark Office and elsewhere.",boilerplate_sony_family:"“PlayStation Family Mark” is a registered trademark of Sony Interactive Entertainment Inc."},metal:{features_1_title:"IMMERSE YOURSELF IN BRUTAL ELEGANCE",features_1_body:"Save Gildenarch by venturing through every district and ward, each more hauntingly beautiful and hellish than the last. This is a world that remembers, reshapes, and pushes back, without demanding punishing repetition.",features_2_title:"BLOODSOAKED COMBAT",features_2_body:"Fight demons, undead, vampires, and Hellgrowth abominations with adept seraphim vengeance and visceral executions unique to each enemy type. This is a game for those who thrive on improvisational and expressive combat.",features_3_title:"CRUSADE ALONE OR SLAY TOGETHER",features_3_body:"Your ally is your amplifier. Share lives, resurrect the fallen, and unlock synergies through optional co-op mode. Dynamic difficulty scaling and enemy composition ensures every mission feels fresh and personal.",features_4_title:"HIGH RISK, HIGH REWARD MISSIONS",features_4_body:"Every run is a ritual of transformation and resistance, with each triumph earning you new missions, modifiers, and skill achievements.",meta_desc:"Crimson Moon is a gothic action-adventure RPG where players unleash transformative combat through savage, replayable runs and scalable challenges fought alone or together in co-op.",title:"Crimson Moon",splash_cta:"September 1, 2026",teaser_body:"The city of Gildenarch has fallen. Once a holy jewel, it is overrun by demons, undead, vampires, and Hellgrowth abominations. Humanity's last hope is the Order of the Crimson Moon, and its most feared weapon is you.\n\nEmbody a Nephilim, a human-angel hybrid forged to defend the world from Hell. Master supernatural powers, weapons, melée combat, and angelic transformations to fight through brutal missions and survive boss encounters with the Dead Gods.\n\nWhether you crusade alone or slay together in co-op, the prophecy is yours to fulfill.",discord_header:"Join Our Community To Learn More",discord_body:"You can follow us on:",game_features:"Game Features",features_5_title:"UNLEASH THE POWER OF ANGELIC TRANSFORMATION",features_5_body:"Wreak holy havoc with evolving Nephilim powers that bestow temporary abilities and divinely devastating attacks.",features_6_title:"FIND REPRIEVE IN REVERENT SPLENDOR",features_6_body:"In between runs, return to the headquarters of the Church, your home base for permanent upgrades and NPC interactions. When ready, survey the city and plan your next mission via the War Table.",intro_header:"Rise, Violent ones, and hail the Crimson Moon",sku:{standard:{title:"Standard Edition",description:"You are Nephilim: a human-angel hybrid forged to defend humanity with supernatural powers. Fight solo or with a friend to annihilate demons and challenge brutal bosses in relentless melée combat. Rise, violent one. The prophecy is yours to fulfill.",price:"19.99",features:{"1":"Base Game"}},deluxe:{title:"Deluxe Edition",description:"Deluxe Edition includes entitlement to one post-launch downloadable expansion, currently in development. Expansion content, features, and release timing have not been finalized and are subject to change. We can’t wait to provide you more details in the near future!",price:"29.99",features:{"1":"Ceremonial Armor Set","2":"Axe of the Gods","3":"Post-Launch Content Expansion"}},ost:{title:"Crimson Moon: Original Game Soundtrack",description:"You are a Nephilim, feared weapon of the Order of the Crimson Moon and the last hope for humanity. Tasked with reclaiming the fallen city of Gildenarch, you must annihilate demons to the haunting rhythms of an epic soundtrack. Featuring more than an hour of symphonic fury, written by Christopher Wilson and featuring songs by Misha Mansoor, Jared Dines, Ricky Armellino, and Health.",price:"9.99",short_title:"Soundtrack"}},intro_game_overview:"Face the Savage Dead Gods solo or with a friend in this Gothic action-packed RPG",letter_from_devs:"A Letter from Team Metal"},games:{metal_title:"Crimson Moon",metal_desc:"Crimson Moon is a gothic action-adventure RPG where players unleash transformative combat through savage, replayable runs and scalable challenges fought alone or together in co-op.",nekome_title:"Nekome: Nazi Hunter",nekome_desc:"Nekome: Nazi Hunter is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers.",ireprologue_title:"Ire: A Prologue",ireprologue_desc:"It's 1986, and you're stranded in the Bermuda Triangle — but not alone. Trapped in a terrifying loop with a monster, you'll have to stay one step ahead to survive and uncover the truth. Ready or not, here it comes.",stormlancers_title:"Storm Lancers",stormlancers_desc:"Storm Lancers is a fast-paced rogue-like, where every run means dodging death, overcoming enemies, and mastering powerful skills. The battle is on, so team up in chaotic co-op to double your chances of survival."},account:{account_nickname:"{Nickname} Account",link_account:"Link Account",something_went_wrong:"Something Went Wrong",unlink_account:"Unlink Account",unlink_question:"Are you sure you want to unlink your {platform} account?",accounts:"Accounts",unlink:"Unlink",link:"Link",msg_code_redeem_success:"Code redeemed!",msg_code_redeem_failure:"Redemption failed.",msg_something_wrong:"Something went wrong — please try again.",redeem_a_code:"Redeem a Code",enter_redemption_code:"Enter a redemption code to add its content to your account.",you_received:"You received:",new_content:"New Content",code:"Code",redemption_code:"Redemption code",redeeming_in_process:"Redeeming...",redeem:"Redeem",have_a_code_question:"Have a code? Redeem it to add its content to your account.",redemptions:"Redemptions",nothing_redeemed:"Nothing redeemed yet.",sign_in_with_platform:"Sign in using a platform below",no_pm_account_exists:"No ProbablyMonsters account exists linked to those platform credentials. If you have played another ProbablyMonsters game, you may already have a ProbablyMonsters account linked to a different platform.",sign_in_using_another:"Sign in using another platform below to link.",create_new_pm:"Create a new ProbablyMonsters Account.",access_code_from_console:"Access code retrieved from game console:",input_code_here:"Input code here",link_account_to_existing_pm_account:"Link your {platform} account to an existing ProbablyMonsters account by signing in with the platform you have linked in the past.",sign_in_to_platform_to_link:"Sign in to a platform linked to your ProbablyMonsters Account.",accounts_linked:"Accounts Linked",link_successful_and_return:"Your accounts were linked successfully. Return to your game to continue.",couldnt_link_account:"We couldn't link your account",msg_code_expired:"The code may have expired or already been used. Head back to the game and request a new code to try again.",try_again:"Try again",link_success_msg:"Your {platform} account has been successfully linked.",link_failure_msg:"Failure: The {platform} account could not be linked.",link_failure_msg_already_linked:"Failure: {platform} account could not be linked because a ProbablyMonsters account is already linked to it.",unlink_success_msg:"The {platform} account was successfully unlinked.\n",unlink_failure_msg:"Failure: The {platform} account could not be unlinked.",account_was_unlinked:"Your Account was successfully unlinked.\n",account_not_unlinked:"Account was not unlinked.",friends:"Friends",no_friends:"No friends found.",online:"Online",offline:"Offline",entitlements:"Entitlements",no_entitlements_for:"No Entitlements for {stack}.",activities:"Activities",achievements:"Achievements",no_achievements:"No achievements for {stack}",progress_counter:"Progress {n}%",in_progress:"In Progress",leaderboards:"Leaderboards",no_leaderboards:"No Leaderboards for {stack}",score_counter:"Score {n}",rank_counter:"Rank {n}",scores:"Scores",no_scores:"No Scores for {stack}",no_news:"No News articles for {stack}",sign_in_expired:"Sign In Expired",generic_linking_failed:"Linking Failed",achievement_complete:"Complete",blocked:"Blocked",unblock:"Unblock",unblocking:"Unblocking…",unblock_failed:"We couldn't unblock this player. Please try again.",away:"Away",busy:"Busy",appear_offline:"Appear Offline",redeem_code_for_items:"For in-game items only. To redeem game codes, please visit the appropriate store platform.",or:"OR"},article:{metal:{patch1_0_0_1:{title:"Crimson Moon Patch 1.0.0.1",body:"\u003Cp>Good news, PC Nephilim! ⌨️🖱️\u003C/p>\n\n\u003Cp>Patch 1.0.0.1 has passed testing and we've decided to put our Alpha implementation of keybinding support into your hands now, rather than make you wait for the full, polished version.\u003C/p>\n\n\u003Cp>The update is available now (version 162350), giving PC players basic keyboard &amp; mouse remapping and mouse sensitivity controls while we continue to refine and expand the feature.\u003C/p>\n\n\u003CCmsImage content=\"image\" alt=\"Wide shot of the keep\" />\n\n\u003Cp>Keybinding support was already planned for PC, but we chose to hold the initial implementation at launch while we resolved some remaining issues. Your feedback reinforced that getting these options into your hands should be a priority, so the team has been working to get them ready as quickly as possible.\u003C/p>\n\n\u003Cp>\u003Cstrong>IMPORTANT NOTE:\u003C/strong> this is our first Alpha implementation of keybinding support, not the final, polished experience we intend to deliver. You can find this new feature under the Settings Menu &gt; Keyboard &gt; select the custom keyboard profile (click the left arrow).\u003C/p>\n\n![Custom keyboard profile selection](/metal/post_content/patch_notes_1001_2.webp)\n\n\u003Cp>Right now, you can rebind all available actions, revert bindings to their defaults and adjust mouse sensitivity, but there are some things \u003Cstrong>not included\u003C/strong> in this version that we're working to add in a future update — these include:\u003C/p>\n\n\u003Cul>\n\u003Cli>\u003Cstrong>Multiple bindings\u003C/strong> - assign more than one key to the same action\u003C/li>\n\u003Cli>\u003Cstrong>Double-tap inputs\u003C/strong> - assign actions to quickly pressing a key twice\u003C/li>\n\u003Cli>\u003Cstrong>Hold inputs\u003C/strong> - assign actions to holding a key down\u003C/li>\n\u003C/ul>\n\n\u003Cp>We made the decision to get this Alpha functionality into your hands sooner rather than make you wait for the full implementation. \u003Cstrong>This is only our first step, and we want your feedback to help us refine what comes next and what's important to you.\u003C/strong>\u003C/p>\n\n\u003Cp>Please let us know what works, what doesn't, and any issues you encounter. \u003Cstrong>We'd also love to hear what additional keybinding options or functionality you'd like to see in the next implementation.\u003C/strong>\u003C/p>\n\n\u003Cp>We'll continue refining and expanding keybinding support in future updates.\u003C/p>\n\n\u003Ch2>What's Next?\u003C/h2>\n\n\u003Cp>Our attention is also firmly on the other pressing issues players have raised since launch, including camera improvements, progression loss, UI scaling settings and improvements, game crashes & additional controller layout options.\u003C/p>\n\n\u003Cp>The team is actively working through these now, and we'll have more to share on the next patch soon.\u003C/p>\n\n\u003Cp>\u003Cstrong>We won't keep you waiting long ⚔️\u003C/strong>\u003C/p>",meta_desc:"Patch 1.0.0.1 is available NOW! ⌨️🖱️ The update introduces keyboard & mouse remapping and mouse sensitivity controls on PC."},patch1_0_1:{title:"Crimson Moon Hotfix 1.0.1 Patch Notes",body:"\u003Cp>\u003Cstrong>Hotfix 1.0.1 is now live across all platforms.\u003C/strong>\u003C/p>\n\n\u003Cp>Since launch, we've been listening closely to your feedback and bug reports, and the team has been taking action on the issues having the biggest impact on players.\u003C/p>\n\n\u003Cp>\u003Cstrong>Hotfix 1.0.1 is the first of several updates we're working on\u003C/strong> and includes fixes and improvements for \u003Cstrong>camera and lock-on behaviour, save and progression issues, crashes, Steam Deck/PC save syncing, co-op, PC keybindings, HUD scaling, and more.\u003C/strong>\u003C/p>\n\n\u003Cp>We know that \u003Cstrong>save and progression loss has been one of the most serious issues affecting some players\u003C/strong>, and addressing it continues to be a top priority for the team. With this update, \u003Cstrong>we've added rolling backup saves to provide additional protection if a save becomes corrupted or fails to load\u003C/strong>, alongside fixes for several instances where player progression could be unintentionally reset. We've also fixed an issue affecting save syncing between Steam Deck and PC, while we continue to investigate further reports of save and progression loss.\u003C/p>\n\n\u003Cp>Thank you to everyone who has reported an issue or shared feedback. \u003Cstrong>Your reports, videos, and additional details are directly helping the team investigate, prioritise, and take action on the issues affecting players most.\u003C/strong>\u003C/p>\n\n\u003Ch2>⚔️ Key Fixes in Hotfix 1.0.1\u003C/h2>\n\n\u003Cp>For a quick overview, here are some of the biggest issues addressed in this update:\u003C/p>\n\n\u003Cul>\n\u003Cli>\u003Cstrong>Camera &amp; Lock-On Improvements\u003C/strong> - Improved lock-on camera behaviour for large stationary bosses, with additional improvements to camera behaviour around large and elite enemies.\u003C/li>\n\u003Cli>\u003Cstrong>Crash &amp; Stability Fixes\u003C/strong> - Fixed several crashes across PC and console, including a crash during the Egregore boss fight.\u003C/li>\n\u003Cli>\u003Cstrong>Steam Deck to PC Save Sync\u003C/strong> - Fixed an issue affecting save syncing when playing on Steam Deck and PC using the same Steam account.\u003C/li>\n\u003Cli>\u003Cstrong>Co-op Fixes\u003C/strong> - Addressed issues with co-op invites, hosting after reconnecting, additional disconnect handling, and players not being revived correctly at activated Nexus Gates. \u003Cstrong>Co-op run progress will now also persist for clients, allowing them to continue the run solo.\u003C/strong>\u003C/li>\n\u003Cli>\u003Cstrong>HUD Scaling and Fixes\u003C/strong> - Added HUD scaling options and improved UI scaling at 4K resolutions.\u003C/li>\n\u003Cli>\u003Cstrong>PC Keybinding Improvements\u003C/strong> - Fixed several issues affecting custom keybindings, prompts, and HUD icons.\u003C/li>\n\u003C/ul>\n\n\u003Cp>\u003Cstrong>You can find the full list of fixes and improvements below.\u003C/strong>\u003C/p>\n\n\u003Ch3>Crashes &amp; Stability\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed a number of crashes across Steam, Epic Games Store, PS5, Xbox Series X|S, and Steam Deck, including a crash that could occur during the Egregore boss fight.\u003C/li>\n\u003Cli>Fixed various Co-op desync issues\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Camera\u003C/h3>\n\n\u003Cul>\n\u003Cli>Improved the lock-on camera when fighting large stationary bosses, including Tyrigon and the Dry Rot King's God form.\u003C/li>\n\u003Cli>Made additional improvements to lock-on camera behaviour around large and elite enemies, reducing some instances of unwanted camera movement and laying the groundwork for further improvements.\u003C/li>\n\u003Cli>Additional camera improvements are planned for Hotfix 1.0.2, including improved support for large enemies, interiors, and environment occlusion and collision handling.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Multiplayer &amp; Co-op\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the Host option sometimes remaining unavailable after reconnecting to online services.\u003C/li>\n\u003Cli>Fixed players getting stuck on the Title Screen after accepting a co-op invite through their platform.\u003C/li>\n\u003Cli>Fixed downed players sometimes not being revived at an activated Nexus Gate when playing co-op.\u003C/li>\n\u003Cli>Co-op run progress will now also persist for clients, allowing them to continue the run solo.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Steam Deck\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed an issue that could cause players to lose all menu controls on Steam Deck.\u003C/li>\n\u003Cli>Fixed save syncing between Steam Deck and PC when using the same Steam account.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Key Bindings\u003C/h3>\n\n\u003Cul>\n\u003Cli>In-game interaction prompts now correctly update to show your custom keybindings.\u003C/li>\n\u003Cli>HUD button icons now correctly update after rebinding a key.\u003C/li>\n\u003Cli>Left Shift and Right Shift now display the correct individual icons in the keybinding menu.\u003C/li>\n\u003Cli>Added a missing Cancel option to the keyboard remapping screens.\u003C/li>\n\u003Cli>Fixed UI issues that could occur when ESC was assigned to a custom action.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>UI &amp; HUD\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed status effects not displaying correctly on the HUD.\u003C/li>\n\u003Cli>Fixed placeholder icons appearing instead of the correct status effect icons during combat.\u003C/li>\n\u003Cli>Fixed status effect indicators flickering on boss health bars.\u003C/li>\n\u003Cli>Fixed quest notifications repeatedly spamming the HUD when launching the game.\u003C/li>\n\u003Cli>XP is now displayed correctly on the True Death results screen, rather than appearing as a decimal.\u003C/li>\n\u003Cli>The Mission Failed screen now displays the correct number of difficulty skulls.\u003C/li>\n\u003Cli>Fixed a duplicate health bar appearing when locking onto Tyrigon at the beginning of the fight.\u003C/li>\n\u003Cli>Added HUD scaling options to the Settings menu.\u003C/li>\n\u003Cli>Improved UI scaling at 4K resolutions.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Enemies &amp; Combat\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the Knight Terror's arm not detaching correctly during a finisher.\u003C/li>\n\u003Cli>Fixed Felwyl's death sequence sometimes being skipped when defeating him during his lightning attack.\u003C/li>\n\u003Cli>Fixed the Undead Soldier's heavy attack sound playing repeatedly when its attack passed through a player's defence.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>World &amp; Items\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed some Relic collection points not appearing correctly.\u003C/li>\n\u003Cli>Fixed dropped Relics sometimes becoming impossible to pick up.\u003C/li>\n\u003Cli>Fixed areas in Archspire Cathedral where players could climb over doors and fall out of the level.\u003C/li>\n\u003Cli>Reduced the item pickup range so nearby items no longer trigger interactions from further away than intended.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Store &amp; Entitlements\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the Deluxe Edition Upgrade not appearing in search results on Xbox, PS5, and Epic Games Store.\u003C/li>\n\u003Cli>Fixed the Crimson Moon Soundtrack appearing empty on Steam.\u003C/li>\n\u003Cli>Fixed players becoming invisible after losing access to equipped Deluxe Edition items.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Audio &amp; VO\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the Undead Soldier's heavy attack sound effect playing multiple times in quick succession.\u003C/li>\n\u003Cli>Fixed dialogue for the Solomon Statue and Old Habits triggering at the wrong times.\u003C/li>\n\u003C/ul>",meta_desc:"Fixes & improvements for camera and lock-on behavior, save & progression issues, crashes, Steam Deck/PC save sync, co-op, PC keybindings, HUD scaling, & more."},patch1_0_2:{title:"Crimson Moon - Hotfix 1.0.2 Patch Notes",body:"\u003Cp>Hey Nephilim,\u003C/p>\n\n\u003Cp>\u003Cstrong>Hotfix 1.0.2 is now live on all platforms!\u003C/strong>\u003C/p>\n\n\u003Cp>Team Metal has been hard at work addressing as many of the issues reported by players as possible. This is our biggest update yet, with hundreds of fixes and improvements across \u003Cstrong>saves and progression, co-op, combat, Boons and Weapon Arts, crashes, performance, camera and much more.\u003C/strong>\u003C/p>\n\n\u003Cp>Thank you to everyone who has continued to report issues and share feedback with us. Your reports continue to help the team identify, reproduce and prioritise issues, and many of the fixes included below directly address issues raised by the community.\u003C/p>\n\n\u003Ch2>Key Fixes in Patch 1.0.2\u003C/h2>\n\n\u003Cp>There's a lot in this update. Here are just some of the highlights:\u003C/p>\n\n\u003Cul>\n\u003Cli>\u003Cstrong>Major co-op fixes\u003C/strong>, including issues with Quickplay, joining games, progression, dealing damage and parrying, alongside several issues that could leave players stuck or unable to continue.\u003C/li>\n\u003Cli>\u003Cstrong>More save and progression fixes\u003C/strong>, including issues where progress and unlock information could incorrectly carry between different save files, alongside improvements to make overwriting saves safer.\u003C/li>\n\u003Cli>\u003Cstrong>Lore Scrolls can now be collected in co-op\u003C/strong>, fixing an issue that could prevent the second player from collecting them and progressing related quests.\u003C/li>\n\u003Cli>\u003Cstrong>Clear the Area objectives should now be more reliable\u003C/strong>, with fixes for enemies that could fail to spawn or make their way towards you, preventing you from completing the objective.\u003C/li>\n\u003Cli>Fixed numerous locations where players could \u003Cstrong>become stuck in the environment or fall through the world\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Lots of fixes for Boons and Weapon Arts\u003C/strong>, including Angelic Bulwark, Brewmaster, Aftershock Technique, Avenging Pestilence, Shield of Many, Pyromancer, Impaling Throw and more.\u003C/li>\n\u003Cli>\u003Cstrong>Improved the downed and revive experience in co-op\u003C/strong>, fixing several issues that could occur while players were downed or being revived.\u003C/li>\n\u003Cli>\u003Cstrong>More crash and performance fixes across PC and consoles\u003C/strong>, including improvements across multiple levels and boss encounters.\u003C/li>\n\u003Cli>\u003Cstrong>Steam Deck improvements\u003C/strong>, including fixes for controls, UI readability, combat desync and performance.\u003C/li>\n\u003Cli>\u003Cstrong>More camera and lock-on fixes\u003C/strong>, including issues during rolling attacks and encounters with Egregore and Demon Brute.\u003C/li>\n\u003Cli>\u003Cstrong>Clearer Status Effect information\u003C/strong> for Tempo, Poisoned, Freeze, Marked and Sundered.\u003C/li>\n\u003Cli>\u003Cstrong>Improved loot and Gold pickups\u003C/strong>, including a fix for dropped items bunching together and a new setting that allows you to auto-pickup Gold!\u003C/li>\n\u003Cli>Plus \u003Cstrong>many more fixes across quests, UI, localisation, audio, cinematics, enemies, bosses and the world itself.\u003C/strong>\u003C/li>\n\u003C/ul>\n\n\u003Ch2>An Update on Saves &amp; Progression\u003C/h2>\n\n\u003Cp>We know \u003Cstrong>save and progression loss has been one of the biggest concerns for players\u003C/strong>, and it continues to be one of our highest priorities.\u003C/p>\n\n\u003Cp>Hotfix 1.0.2 includes \u003Cstrong>a number of important save fixes designed to make saves more stable and secure\u003C/strong>, addressing several of the issues we've identified through player reports and our ongoing investigation.\u003C/p>\n\n\u003Cp>While we expect these changes to make a meaningful improvement to save stability, our work here isn't finished. \u003Cstrong>A few of the remaining save issues are more complex, and for Patch 1.1 we're planning a more substantial rework of how saves are handled.\u003C/strong> This is a larger piece of work that requires additional development and testing, but will allow us to fix the underlying issues and better protect your saves going forward.\u003C/p>\n\n\u003Cp>\u003Cstrong>Many of the remaining save issues we're investigating occur when moving between devices\u003C/strong>, so in the meantime, we recommend playing Crimson Moon on a single device where possible. Until we can confirm these issues are fully resolved, we recommend avoiding switching devices when playing the same save.\u003C/p>\n\n\u003Cp>For players on PC, you may also want to \u003Cstrong>create a local backup of your save as an additional precaution\u003C/strong> while we continue this work.\u003C/p>\n\n\u003Cp>We know this isn't an ideal recommendation, but we want to be transparent about the current situation while also making clear that \u003Cstrong>1.0.2 contains meaningful improvements to save stability\u003C/strong>. Please continue reporting any save or progression issues you experience after updating - your reports are incredibly valuable as we continue this work.\u003C/p>\n\n\u003Ch2>What's Next\u003C/h2>\n\n\u003Cp>Hotfix 1.0.2 is another substantial step forward for Crimson Moon, but \u003Cstrong>our work doesn't stop here\u003C/strong>.\u003C/p>\n\n\u003Cp>Our next major update, \u003Cstrong>Patch 1.1, is planned for October\u003C/strong>. Alongside the wider work on saves outlined above, 1.1 will focus on further quality-of-life improvements, including \u003Cstrong>gear and Blacksmith improvements, clearer gear and Boon information, better visibility of run progression, rewards and unlocks, further control remapping improvements, and additional co-op improvements.\u003C/strong>\u003C/p>\n\n\u003Cp>And while our focus since launch has understandably been on \u003Cstrong>fixing and improving the core experience\u003C/strong>, we're also looking further ahead.\u003C/p>\n\n\u003Cp>\u003Cstrong>There's more coming to Crimson Moon.\u003C/strong>\u003C/p>\n\n\u003Cp>As we move into October, we'll begin sharing more about \u003Cstrong>new content coming to the game and what's next for Gildenarch\u003C/strong>. We're not quite ready to reveal everything just yet, but you won't have to wait too much longer to find out more.\u003C/p>\n\n\u003Cp>For now, there are a lot more fixes to dig into below.\u003C/p>\n\n\u003Ch2>Full Patch Notes\u003C/h2>\n\n\u003Ch3>Crashes &amp; Stability\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed an issue where dying a True Death could fail to transition the player to the Mission Results screen.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could crash when drinking a Health Flask during the Cardinal Mathias boss fight.\u003C/li>\n\u003Cli>Fixed multiple crashes affecting PC.\u003C/li>\n\u003Cli>Fixed multiple crashes affecting Xbox Series X|S.\u003C/li>\n\u003Cli>Fixed a crash affecting PS5.\u003C/li>\n\u003Cli>Fixed an Xbox Series X|S hang that could occur during rendering.\u003C/li>\n\u003Cli>Fixed an animation-related crash on PC.\u003C/li>\n\u003Cli>Fixed a crash that could occur while processing UI text.\u003C/li>\n\u003Cli>Fixed an issue where a player could fail to revive correctly if a cinematic began while they were downed.\u003C/li>\n\u003Cli>Fixed an issue where a player could fall through the world after a death cinematic while waiting to respawn.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Save Data &amp; Progression\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed an issue where Boons and Loadout Egg status from an active run could incorrectly carry over into a new save file.\u003C/li>\n\u003Cli>Fixed consumable unlock status carrying over between different save files.\u003C/li>\n\u003Cli>Fixed the Save Overwrite confirmation screen not identifying which save would be overwritten.\u003C/li>\n\u003Cli>Changed the default selection on the Save Overwrite confirmation screen from \"Yes\" to the safer \"No.\"\u003C/li>\n\u003Cli>Fixed an issue with save-file timestamps displaying an incorrect time.\u003C/li>\n\u003Cli>Fixed an issue where progression information could display incorrectly when starting a new save.\u003C/li>\n\u003Cli>Fixed an issue where the game could continue running behind a system save prompt.\u003C/li>\n\u003Cli>Fixed an issue where Xbox players could repeatedly receive a \u003Cstrong>\"Save upload failed\"\u003C/strong> warning between levels or while in the Hub.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Multiplayer &amp; Co-op\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed an issue where \u003Cstrong>Quickplay was not working correctly\u003C/strong>.\u003C/li>\n\u003Cli>Fixed an issue where players received a \"Game Not Open to Join\" error when attempting to join online sessions.\u003C/li>\n\u003Cli>Fixed an issue where crossplay friend requests between Xbox and other platforms were not being received.\u003C/li>\n\u003Cli>Fixed an issue where Epic Games Store players could fail to see in-game multiplayer invitations.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could incorrectly inherit the host's mission progress.\u003C/li>\n\u003Cli>Fixed an issue where previously obtained level-up rewards could re-display for a co-op client after the host ended the session.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could return to their own Hub or run with the base Crimson Oath gear instead of their previously equipped gear.\u003C/li>\n\u003Cli>Fixed an issue where players could join a co-op session while the host was already mid-run.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could sometimes be unable to see the host's attack animations.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could deal reduced damage to enemies until dying and being revived.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could lose the ability to parry with a two-handed weapon after repeatedly swapping weapons.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client might not properly enter Angel Mode when activating it while taking damage.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could enter an incorrect standing state while downed.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client lost control of their character when the host entered the Felwyl boss arena.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client was blocked from rejoining the final boss fight by red mist at the arena entrance.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could host another session while already connected to an existing session.\u003C/li>\n\u003Cli>Fixed an issue where players could become stuck in the Hub after joining and leaving a multiplayer session without first selecting a Loadout.\u003C/li>\n\u003Cli>Fixed an issue where a dead player's collision could remain behind in co-op and block movement.\u003C/li>\n\u003Cli>Fixed an issue where the host could not control the spectator camera when the co-op client had an enemy locked on.\u003C/li>\n\u003Cli>Fixed spectator view having no audio when both players were downed and the client reached Final Death.\u003C/li>\n\u003Cli>Fixed an issue where the low-health screen effect could appear for the host when the co-op client was the player at low health.\u003C/li>\n\u003Cli>Fixed an issue where enemy death visual effects did not appear for co-op clients.\u003C/li>\n\u003Cli>Fixed an issue where the Avenging Pestilence aura appeared incorrectly oversized to co-op clients.\u003C/li>\n\u003Cli>Fixed an issue where picking up one emergent Quest item could count twice towards Quest progress in multiplayer.\u003C/li>\n\u003Cli>Fixed an issue preventing co-op clients from collecting Lore Scrolls and progressing related Lore Scroll Quests.\u003C/li>\n\u003Cli>Fixed an issue where players could become stuck between an elevator and wall in Archspire Cathedral during co-op.\u003C/li>\n\u003Cli>Fixed an issue where a co-op player could briefly face the wrong direction during General Valahk's introduction.\u003C/li>\n\u003Cli>Fixed an issue where a co-op client could appear to float during an Ancient Chamber introduction cinematic.\u003C/li>\n\u003Cli>Fixed an issue where the multiplayer Friends menu Block button did not function.\u003C/li>\n\u003Cli>Fixed an issue where using a controller on PC did not bring up the virtual keyboard when entering a multiplayer invite code.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>UI &amp; HUD\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed an issue where one of the Life icons on the player's HUD appeared yellow instead of the correct colour.\u003C/li>\n\u003Cli>Fixed multiple Life icons incorrectly displaying the final-life state.\u003C/li>\n\u003Cli>Fixed inconsistent terminology in the inventory between \"Stash\" and \"Reserved Items.\"\u003C/li>\n\u003Cli>Fixed an issue where Ascendant Aura did not appear in the active Boon list while active.\u003C/li>\n\u003Cli>Fixed the Armory upgrade screen displaying an \"Epic\" label when an item was already at maximum upgrade.\u003C/li>\n\u003Cli>Fixed items in the Blacksmith menu being inconsistently greyed out.\u003C/li>\n\u003Cli>Fixed Boss Weapon Side Quests appearing in both the Active and Completed Quest tabs.\u003C/li>\n\u003Cli>Improved the readability of Boon description text.\u003C/li>\n\u003Cli>Fixed a stale health bar remaining visible for an extended period.\u003C/li>\n\u003Cli>Fixed the Stamina value in the Equipment menu displaying as a decimal.\u003C/li>\n\u003Cli>Fixed the purchase button requiring an unusually long mouse hold to activate.\u003C/li>\n\u003Cli>Fixed the \"Max Upgrade\" banner appearing on items that had not reached their maximum upgrade level.\u003C/li>\n\u003Cli>Fixed a Revive prompt appearing on the downed player's own screen.\u003C/li>\n\u003Cli>Fixed throwable ammunition displaying the wrong equipped item on the HUD.\u003C/li>\n\u003Cli>Fixed the final boss Mission Results screen incorrectly displaying \"Mission 1.\"\u003C/li>\n\u003Cli>Fixed Side Quest icons appearing as Main Quest icons on the Hub compass.\u003C/li>\n\u003Cli>Fixed the \"Equipped\" banner appearing on every item in the Upgrade screen instead of only the equipped item.\u003C/li>\n\u003Cli>Fixed the District Complete screen displaying an incorrect value for players at the level cap.\u003C/li>\n\u003Cli>Fixed the Epoch Cuirass's Aftershock Boon not appearing in its item information or Boon list.\u003C/li>\n\u003Cli>Fixed the Poison status meter on the HUD not depleting over time.\u003C/li>\n\u003Cli>Fixed throwable ammunition pickups not displaying the amount of ammunition being added.\u003C/li>\n\u003Cli>Fixed already-owned Merchant items incorrectly displaying a \"New\" ribbon.\u003C/li>\n\u003Cli>Fixed completing a Boss Weapon Quest not displaying the acquired weapon notification.\u003C/li>\n\u003Cli>Fixed the Stamina bar appearing incorrectly when loading into a level with depleted Stamina.\u003C/li>\n\u003Cli>Fixed Quest goal text being cut off in Windowed Mode.\u003C/li>\n\u003Cli>Fixed the Blacksmith Upgrade Armory scrollbar disappearing after visiting the Upgrade Equipment submenu.\u003C/li>\n\u003Cli>Fixed overlapping text on the Mission Summary screen.\u003C/li>\n\u003Cli>Fixed Settings button icons being cut off at certain resolutions when using a controller.\u003C/li>\n\u003Cli>Fixed the Skip Dialogue button scaling incorrectly.\u003C/li>\n\u003Cli>Fixed Librarian Mereda's Boons not displaying an \"Insufficient Souls\" tooltip when the player could not afford them.\u003C/li>\n\u003Cli>Fixed rapidly closing a Lore Scroll causing it to remain open.\u003C/li>\n\u003Cli>Fixed Boons purchased from Librarian Mereda not displaying their cost.\u003C/li>\n\u003Cli>Fixed Boon description pop-ups failing to appear for subsequent purchases.\u003C/li>\n\u003Cli>Improved Boon descriptions for \u003Cstrong>Tempo, Poisoned, Freeze, Marked and Sundered\u003C/strong>.\u003C/li>\n\u003Cli>Improved shop sorting so locked items are ordered from lowest to highest unlock level.\u003C/li>\n\u003Cli>Improved the overall visual polish of the Blacksmith UI and Boon purchase UI.\u003C/li>\n\u003Cli>Fixed NPC shop menus appearing before NPC dialogue had finished.\u003C/li>\n\u003Cli>Fixed the Blacksmith comparison view not displaying by default.\u003C/li>\n\u003Cli>Fixed status-effect explanations appearing while looting instead of only when inspecting items in menus.\u003C/li>\n\u003Cli>Fixed the Angelic Bulwark information displayed in the Boons menu.\u003C/li>\n\u003Cli>Fixed missing Weapon Art keywords from Fiery Broadsword.\u003C/li>\n\u003Cli>Fixed an issue preventing players from switching tabs in the Purified Items menu.\u003C/li>\n\u003Cli>Fixed difficulty skulls becoming misaligned on the Reward screen when using a non-default UI scale.\u003C/li>\n\u003Cli>Fixed extra spacing in the Throwing Knife and Aegis descriptions.\u003C/li>\n\u003Cli>Fixed an inconsistency in the visual style of the level-up number displayed on the End of Run screen.\u003C/li>\n\u003Cli>Added XP rewards to Quest Log entries alongside other rewards such as Gold.\u003C/li>\n\u003Cli>Improved the distinction between \u003Cstrong>fixed and non-fixed Boons on equipment\u003C/strong>.\u003C/li>\n\u003Cli>Fixed the Nexus Gate opening lacking sufficient visual clarity.\u003C/li>\n\u003Cli>Fixed the starting sword lacking its proper name.\u003C/li>\n\u003Cli>Fixed an issue where Boon Gate plates could fail to appear.\u003C/li>\n\u003Cli>Fixed a typo in the Aegis Ascendance upgrade notification.\u003C/li>\n\u003Cli>Fixed button and key icons being cut off in some shop menus.\u003C/li>\n\u003Cli>Fixed multiple additional UI presentation and layout issues.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Camera\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the camera not smoothly following the player during rolling attacks.\u003C/li>\n\u003Cli>Fixed the camera clipping through the wall at the top of the Archspire Cathedral Archive elevator.\u003C/li>\n\u003Cli>Fixed locking onto Egregore's weak points not properly focusing the camera on those targets.\u003C/li>\n\u003Cli>Fixed the lock-on camera moving erratically or clipping below the ground during the Demon Brute boss fight in the Prologue.\u003C/li>\n\u003Cli>Fixed the camera clipping through the floor when a boss jumped over the player.\u003C/li>\n\u003Cli>Fixed the camera facing the wrong direction when moving past Egregore's cores or weak points while locked on.\u003C/li>\n\u003Cli>Fixed a camera hitch that could occur during gameplay.\u003C/li>\n\u003Cli>Fixed enemies, NPCs and other players remaining visible when the camera moved very close to them.\u003C/li>\n\u003Cli>Improved the transition back to mouse sensitivity when exiting lock-on.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Key Bindings &amp; Controls\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed Prologue tutorial tooltips not reflecting the player's custom key bindings.\u003C/li>\n\u003Cli>Fixed an issue where the key remap screen could not be exited when using a controller.\u003C/li>\n\u003Cli>Fixed Mouse Buttons 4 and 5 not being represented correctly in the keybindings menu.\u003C/li>\n\u003Cli>Fixed an issue with the keyboard and mouse rebind confirmation screen.\u003C/li>\n\u003Cli>Improved the precision available when adjusting mouse sensitivity.\u003C/li>\n\u003Cli>Added a mouse sensitivity slider to the Settings menu.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Enemies &amp; Combat\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed additional enemies failing to spawn when the player was close to completing a Clear the Area objective.\u003C/li>\n\u003Cli>Fixed enemies failing to navigate towards the player when a Clear the Area objective was nearly complete.\u003C/li>\n\u003Cli>Fixed a Skeleton Warrior in Forsaken Streets being positioned in an out-of-the-way location that frequently prevented completion of kill objectives.\u003C/li>\n\u003Cli>Fixed an issue where a Clear All Enemies objective could complete without the final enemy being defeated.\u003C/li>\n\u003Cli>Fixed a Captain enemy becoming stuck in an animation loop.\u003C/li>\n\u003Cli>Fixed General Valahk's sword buff VFX briefly covering the entire weapon.\u003C/li>\n\u003Cli>Fixed attacking certain enemies with an unparryable status causing the player's own attacks to be parried.\u003C/li>\n\u003Cli>Fixed Cardinal Mathias's staff remaining completely static during the fight.\u003C/li>\n\u003Cli>Fixed the Knight Terror missing a visual invulnerability indicator during its AOE Hellgrowth rupture attack.\u003C/li>\n\u003Cli>Fixed Egregore occasionally becoming invisible.\u003C/li>\n\u003Cli>Fixed the Knight Terror's forward AOE triggering after the enemy had been staggered.\u003C/li>\n\u003Cli>Fixed a specific issue where parrying the Demon Brute's fist slam could fail to deal poise damage or trigger a parry reaction.\u003C/li>\n\u003Cli>Fixed General Valahk's fire projectiles displaying without the correct textures.\u003C/li>\n\u003Cli>Fixed General Valahk's projectiles unexpectedly redirecting towards the player mid-flight.\u003C/li>\n\u003Cli>Fixed Felwyl Ascended not applying Poison to players.\u003C/li>\n\u003Cli>Fixed status effects sometimes failing to apply correctly to Felwyl.\u003C/li>\n\u003Cli>Fixed an issue where Mahkteah could stop dealing damage, and Burning could heal the player instead of damaging them.\u003C/li>\n\u003Cli>Fixed Spear Cultists not rewarding Souls when killed.\u003C/li>\n\u003Cli>Fixed inconsistent enemy attack behaviour when enemies were positioned on stairs or ramps.\u003C/li>\n\u003Cli>Fixed two armour pieces unintentionally granting immunity to Fire damage.\u003C/li>\n\u003Cli>Fixed the Undead Brute's AOE pommel stomp failing to damage players standing within its affected area.\u003C/li>\n\u003Cli>Fixed a Demon Brute in Archspire Cathedral becoming stuck on geometry while moving towards the player.\u003C/li>\n\u003Cli>Fixed an enemy spawning outside the playable area in Ramshorn Keep.\u003C/li>\n\u003Cli>Bosses now display a red invulnerability effect during phase transitions to make it clearer when they cannot be damaged.\u003C/li>\n\u003Cli>Added controller vibration feedback for Cardinal Mathias's powered-up AOE attack.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Boons &amp; Weapon Arts\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed Angelic Bulwark's shield not functioning.\u003C/li>\n\u003Cli>Fixed Brewmaster frequently not being applied after opening Nexus Gates.\u003C/li>\n\u003Cli>Fixed an issue affecting Brewmaster's stacking behaviour.\u003C/li>\n\u003Cli>Fixed Aftershock Technique disappearing after swapping equipment under certain conditions.\u003C/li>\n\u003Cli>Fixed Avenging Pestilence being cancellable mid-cast to Poison enemies without consuming Mana.\u003C/li>\n\u003Cli>Fixed Avenging Pestilence causing the player's attacks to deal damage twice.\u003C/li>\n\u003Cli>Fixed Avenging Pestilence's aura visual effect disappearing abruptly when the effect ended.\u003C/li>\n\u003Cli>Fixed Shield of Many failing to knock enemies back following a successful parry.\u003C/li>\n\u003Cli>Fixed Pyromancer combined with Aftershock Technique causing all damage types to incorrectly apply Burn.\u003C/li>\n\u003Cli>Fixed Impaling Throw causing subsequent normal attacks to incorrectly inherit Weapon Art damage bonuses.\u003C/li>\n\u003Cli>Fixed Impaling Throw spawning unintended white orbs on impact.\u003C/li>\n\u003Cli>Fixed Impaling Throw missing targets at close range.\u003C/li>\n\u003Cli>Fixed Ground Slam Weapon Arts hitting enemies twice without Aftershock Technique equipped.\u003C/li>\n\u003Cli>Fixed terrain-based Weapon Arts clipping into stairs when used facing uphill.\u003C/li>\n\u003Cli>Fixed Empower replaying its activation audio and visual effects when equipping an item while already active.\u003C/li>\n\u003Cli>Fixed Boon sigils sometimes being invisible while their lighting and visual effects remained visible.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>World &amp; Items\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed multiple locations across Elk Grove Academy, Ramshorn Keep, Archspire Cathedral, Forsaken Streets and other areas where players could become permanently stuck in Hellgrowth or world geometry.\u003C/li>\n\u003Cli>Fixed multiple areas where players could fall through the world.\u003C/li>\n\u003Cli>Fixed an issue where executions performed near geometry could rarely leave the player stuck in terrain.\u003C/li>\n\u003Cli>Fixed missing collision on Hellgrowth near both Nexus Gates in Elk Grove Academy.\u003C/li>\n\u003Cli>Fixed rocks in Elk Grove Academy having no collision.\u003C/li>\n\u003Cli>Fixed an out-of-bounds exploit involving a climbable cliffside in Elk Grove Academy.\u003C/li>\n\u003Cli>Fixed invisible collision barriers blocking player movement.\u003C/li>\n\u003Cli>Fixed a gap in Archspire Cathedral that allowed players to fall out of bounds.\u003C/li>\n\u003Cli>Fixed several locations in Archspire Cathedral where players could become stuck between environmental objects.\u003C/li>\n\u003Cli>Fixed several locations in Ramshorn Keep where players could become trapped behind Hellgrowth or other geometry.\u003C/li>\n\u003Cli>Fixed several locations in Forsaken Streets where collision could trap or obstruct players.\u003C/li>\n\u003Cli>Fixed an issue where a player could become stuck on candle stands after performing a Heavy Attack.\u003C/li>\n\u003Cli>Fixed an issue where a player could become stuck behind a spike barrier in Wall Tower.\u003C/li>\n\u003Cli>Fixed an issue where players could climb environmental objects and fall into inaccessible gaps.\u003C/li>\n\u003Cli>Fixed a loot drop spawning inside a bookcase in Archspire Cathedral.\u003C/li>\n\u003Cli>Fixed a loot drop landing inside a Hellgrowth Flower and becoming unrecoverable.\u003C/li>\n\u003Cli>Fixed a location in Forsaken Streets where dropped loot could not be retrieved.\u003C/li>\n\u003Cli>Fixed a golden chest glow appearing where no chest existed.\u003C/li>\n\u003Cli>Fixed ground geometry clipping through a building wall in Forsaken Streets.\u003C/li>\n\u003Cli>Fixed missing ground textures in the Ancient Chamber before the Mahkteah encounter.\u003C/li>\n\u003Cli>Fixed an issue where \u003Cstrong>loot drops could pile up or bunch together after killing an enemy\u003C/strong>.\u003C/li>\n\u003Cli>Fixed Gold coins not being collected immediately when walking over them.\u003C/li>\n\u003Cli>Added an option to \u003Cstrong>disable Auto-Gold Pickup\u003C/strong>.\u003C/li>\n\u003Cli>Fixed Elite enemies occasionally dropping no items when defeated.\u003C/li>\n\u003Cli>Fixed the Immolation Bomb being unavailable in the world and from Merchants.\u003C/li>\n\u003Cli>Fixed the Immolation Elixir description incorrectly stating that it continuously applied Burn.\u003C/li>\n\u003Cli>Fixed visual popping on the Ram Cuirass cape during the player's run animation.\u003C/li>\n\u003Cli>Fixed Monks in the Main Menu and Hub occasionally appearing without their legs.\u003C/li>\n\u003Cli>Fixed a character's legs disappearing during a Brute execution.\u003C/li>\n\u003Cli>Solomon Statue voice lines can now be replayed after the initial interaction.\u003C/li>\n\u003Cli>Fixed equipment racks clipping into the environment in the Hub.\u003C/li>\n\u003Cli>Fixed several additional missing or incorrect collision areas.\u003C/li>\n\u003Cli>Fixed several additional environment seams, gaps and visual issues.\u003C/li>\n\u003Cli>Fixed several instances of objects appearing incorrectly or clipping into the environment.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Progression, Equipment &amp; Unlocks\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed upgrading a shield not correctly increasing its stats, and added small stat bonuses to shields.\u003C/li>\n\u003Cli>Fixed upgrading a holstered weapon swapping its Weapon Arts with those of the currently equipped weapon.\u003C/li>\n\u003Cli>Fixed upgrading the currently held weapon swapping it with the off-hand weapon.\u003C/li>\n\u003Cli>Fixed an issue where equipment could lose its Boons when upgraded.\u003C/li>\n\u003Cli>Fixed Relic Quest issues preventing them from functioning correctly.\u003C/li>\n\u003Cli>Fixed Relics dropping below the world when the player died while carrying them.\u003C/li>\n\u003Cli>Fixed players being able to purchase the same equipment from the Blacksmith again after upgrading it.\u003C/li>\n\u003Cli>Fixed multiple Blacksmith and Merchant unlock rewards having no effect.\u003C/li>\n\u003Cli>Fixed Gallant's Quest Board missing Bounty Quests.\u003C/li>\n\u003Cli>Fixed Boss Weapon Quests disappearing from Completed Quests after restarting the game.\u003C/li>\n\u003Cli>Fixed Gildenarch's Glory appearing in a new save before it should be accessible.\u003C/li>\n\u003Cli>Fixed the Abraxas Stone acquisition cutscene repeating after subsequent boss clears.\u003C/li>\n\u003Cli>Fixed the Trinket Slot 2 unlock not functioning correctly.\u003C/li>\n\u003Cli>Fixed players not spawning with their additional Potions when starting a new level.\u003C/li>\n\u003Cli>Fixed the Prologue Polearm remaining in the inventory after completing the first-time tutorial.\u003C/li>\n\u003Cli>Fixed Hardening Elixirs appearing in the Warden's arena before being unlocked.\u003C/li>\n\u003Cli>Fixed the Mission Gate opening before the player selected their Loadout.\u003C/li>\n\u003Cli>Fixed the host occasionally spawning inside the Portal Room floor after selecting a Loadout.\u003C/li>\n\u003Cli>Fixed Librarian Mereda's Boon platforms appearing incorrectly.\u003C/li>\n\u003Cli>Fixed the AXIOM sword missing its Weapon Trail VFX.\u003C/li>\n\u003Cli>Fixed Status Flask pickups all displaying the Flaming Rebuke model.\u003C/li>\n\u003Cli>Fixed flickering Fire VFX in the Hub.\u003C/li>\n\u003Cli>Fixed visual skinning errors on the Crimson Oath Armour set.\u003C/li>\n\u003Cli>Fixed an issue where the Gallant interface could close unexpectedly.\u003C/li>\n\u003Cli>Fixed an issue affecting Gajov's equipment upgrade selection.\u003C/li>\n\u003Cli>Fixed issues with equipment positioning on the Sword of Rot and Crescent Halberd.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Audio\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed the Warden's short Poison Slam attack sometimes lacking audio.\u003C/li>\n\u003Cli>Fixed controller rumble occurring while navigating equipment in the Blacksmith and Merchant menus.\u003C/li>\n\u003Cli>Fixed controller vibration continuing during loading after selecting \"End Session.\"\u003C/li>\n\u003Cli>Reduced excessively intense controller rumble on Xbox.\u003C/li>\n\u003Cli>Fixed a looping sound effect during the Felwyl encounter in Moore Manor.\u003C/li>\n\u003Cli>Fixed Empower's activation sound replaying incorrectly when equipping an item while Empower was active.\u003C/li>\n\u003Cli>Fixed Portal ambience responding to the incorrect volume setting.\u003C/li>\n\u003Cli>Fixed Felwyl the Withered's dialogue responding to the incorrect volume setting.\u003C/li>\n\u003Cli>Fixed General Valahk dialogue overlapping his second-phase cinematic.\u003C/li>\n\u003Cli>Increased boss music volume.\u003C/li>\n\u003Cli>Reduced weapon impact sound volume.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Performance\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed shaders frequently recompiling on game launch and extending load times.\u003C/li>\n\u003Cli>Fixed framerate drops during the Dry Rot King's phase cinematics and second-phase animations.\u003C/li>\n\u003Cli>Fixed framerate drops and hitching during traversal and combat in Forsaken Streets.\u003C/li>\n\u003Cli>Fixed framerate drops during the Warden introduction and boss fight.\u003C/li>\n\u003Cli>Fixed framerate drops during the Tyrigon and Egregore boss fights.\u003C/li>\n\u003Cli>Fixed framerate drops and hitching throughout Ramshorn Keep and Elk Grove Academy.\u003C/li>\n\u003Cli>Fixed framerate drops during General Valahk's second-phase cutscene.\u003C/li>\n\u003Cli>Fixed framerate dropping to approximately 20 FPS in a specific area of Archspire Cathedral on Xbox Series S.\u003C/li>\n\u003Cli>Fixed significant framerate drops and hitching when attacking the Fire Mage during the Prologue tutorial.\u003C/li>\n\u003Cli>Fixed framerate drops during the Prologue Spire Blast cinematic and later areas of the Prologue.\u003C/li>\n\u003Cli>Fixed a noticeable hitch when opening the Equipment menu.\u003C/li>\n\u003Cli>Fixed an FPS drop when moving the camera close to a loot drop while swapping items.\u003C/li>\n\u003Cli>Fixed a performance drop when looking towards the Spire.\u003C/li>\n\u003Cli>Fixed a collision-related performance spike on PS5.\u003C/li>\n\u003Cli>Improved the default Steam Deck performance configuration.\u003C/li>\n\u003Cli>Performed multiple optimisation passes across HUD widgets, UI layouts, audio references and level rendering to reduce overhead and improve frame consistency.\u003C/li>\n\u003Cli>Armour loot is now loaded asynchronously when equipped from a drop, reducing hitches.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Store &amp; Entitlements\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed Deluxe Edition gear remaining visually equipped after entitlements were removed during Loadout selection.\u003C/li>\n\u003Cli>Fixed removing Deluxe Edition entitlements while Axe of the Gods was equipped causing an incorrect Weapon Art to load.\u003C/li>\n\u003Cli>Fixed the minimum and recommended PC specifications being inconsistent between Steam and Epic Games Store.\u003C/li>\n\u003Cli>Fixed inaccurate disk-space requirements being displayed before installation.\u003C/li>\n\u003Cli>Fixed the \"Great Soul Reclaimer\" achievement being awarded earlier than intended on Steam and Epic Games Store.\u003C/li>\n\u003Cli>Fixed the Crimson Moon soundtrack listing on Steam missing artwork.\u003C/li>\n\u003Cli>Fixed premium armour-set unlocks tied to marketing entitlements not displaying correctly.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Steam Deck\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed Steam Deck clients frequently desyncing during combat.\u003C/li>\n\u003Cli>Fixed the host seeing a Steam Deck client's character animations display at a low framerate.\u003C/li>\n\u003Cli>Fixed gameplay streamed from Steam Deck to PC appearing noticeably dim.\u003C/li>\n\u003Cli>Fixed the on-screen keyboard failing to appear on the co-op Join Code screen in Desktop Mode.\u003C/li>\n\u003Cli>Fixed a brief white rectangle appearing when changing display resolution.\u003C/li>\n\u003Cli>Fixed multiple Steam Deck settings not functioning as intended.\u003C/li>\n\u003Cli>Fixed switching between docked and undocked mode causing inputs to jitter or repeatedly fail.\u003C/li>\n\u003Cli>Fixed the on-screen keyboard not appearing when opening the Redeem Menu from the Main Menu.\u003C/li>\n\u003Cli>Fixed the \"Great Soul Reclaimer\" achievement not being awarded on Steam Deck.\u003C/li>\n\u003Cli>Improved Steam Deck performance when using the default graphics configuration.\u003C/li>\n\u003Cli>Fixed multiple \u003Cstrong>Steam Deck UI readability issues\u003C/strong>, including missing or incorrectly sized button glyphs and difficult-to-read text.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Tutorials &amp; First-Time Experience\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed tutorial videos failing to appear in tutorial pop-ups.\u003C/li>\n\u003Cli>Fixed Prologue tutorial prompts not displaying customised key bindings.\u003C/li>\n\u003Cli>Improved tutorial messaging around inventory bag slots.\u003C/li>\n\u003Cli>Added additional messaging around the Felwyl encounter.\u003C/li>\n\u003Cli>Fixed an issue with a Felwyl tutorial image.\u003C/li>\n\u003Cli>Fixed the loading video displaying incorrectly during part of its animation.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>VO, Narrative &amp; Localisation\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed Lotte's voice line not playing when turning in \"Old Habits.\"\u003C/li>\n\u003Cli>Fixed post-death boss dialogue being cut short by the Results screen.\u003C/li>\n\u003Cli>Fixed Felwyl's defeated dialogue being cut off.\u003C/li>\n\u003Cli>Fixed Gallant's introductory Quest dialogue being cut short.\u003C/li>\n\u003Cli>Fixed the Locket Merchant Side Quest dialogue ending prematurely.\u003C/li>\n\u003Cli>Fixed dialogue overlapping after ascending the Clocktower Elevator in Forsaken Streets.\u003C/li>\n\u003Cli>Fixed multiple subtitle typos.\u003C/li>\n\u003Cli>Fixed the \"Remnants of Akyreon\" Quest name being misspelled in the Quest Log.\u003C/li>\n\u003Cli>Fixed duplicate text in the \"Aegoroth, I Am Ready\" Lore Scroll.\u003C/li>\n\u003Cli>Fixed German word-wrapping issues in \"The Prophecy.\"\u003C/li>\n\u003Cli>Fixed mistranslated words in the Spanish localisation.\u003C/li>\n\u003Cli>Fixed Lotte delivering post-mission dialogue about Quests the player had not completed.\u003C/li>\n\u003Cli>Fixed a Gajov Quest ending before its dialogue had finished.\u003C/li>\n\u003Cli>Fixed multiple errors in the \"Garrison Rumor\" Lore Scroll.\u003C/li>\n\u003Cli>Fixed punctuation errors in the \"First Communion\" Lore Scroll.\u003C/li>\n\u003Cli>Fixed Chinese localisation not appearing for the Angel Mode input action.\u003C/li>\n\u003Cli>Fixed multiple additional Lore Scroll, subtitle and localisation errors.\u003C/li>\n\u003C/ul>\n\n\u003Ch3>Additional Fixes &amp; Polish\u003C/h3>\n\n\u003Cul>\n\u003Cli>Fixed several missing or incorrect visual effects across characters, equipment, Boons and environments.\u003C/li>\n\u003Cli>Fixed multiple visual issues affecting environmental props and objects.\u003C/li>\n\u003Cli>Fixed several cases of environmental assets appearing incorrectly at different graphics settings.\u003C/li>\n\u003Cli>Fixed several UI assets and text elements displaying incorrectly at different resolutions or UI scales.\u003C/li>\n\u003Cli>Fixed several additional issues affecting Quest, reward and progression presentation.\u003C/li>\n\u003Cli>Fixed multiple credits omissions and spelling errors.\u003C/li>\n\u003C/ul>",meta_desc:"Hotfix 1.0.2 is now live on all platforms"},one_month_letter:{title:"One Month in Gildenarch",body:"\u003Cp>Nephilim,\u003C/p>\n\n\u003Cp>It's been one month since we launched Crimson Moon, and I wanted to take a moment to speak directly to all of you about where we've been, where we are today, and where we're going next.\u003C/p>\n\n\u003Cp>First, I want to acknowledge something we've been open about since launch: \u003Cstrong>September 1 didn't go the way we wanted it to.\u003C/strong>\u003C/p>\n\n\u003Cp>Too many of you encountered bugs, crashes, progression issues and other problems that got in the way of the experience we wanted you to have. We know that was frustrating, and I want to personally thank everyone who's been sticking with us while we worked to make things right.\u003C/p>\n\n\u003Cp>\u003Cstrong>At the same time, it's meant a lot to us to see so many of you enjoying your time in Gildenarch.\u003C/strong> We've watched you explore the city, take on its bosses, jump into co-op with friends, uncover its secrets and share your experiences with us. Amidst the issues we've been working through, seeing people having fun with Crimson Moon has been a real source of motivation for the entire team.\u003C/p>\n\n\u003Cp>And I'm proud of how \u003Cstrong>Team Metal has responded to the challenges we've faced since launch\u003C/strong>. The team has been working hard to investigate issues, respond to your reports and get fixes into your hands as quickly as possible.\u003C/p>\n\n\u003Cp>In our first month, we've released \u003Cstrong>1.0.0.1, Hotfix 1.0.1 and Hotfix 1.0.2\u003C/strong>, addressing hundreds of issues across saves and progression, crashes and stability, co-op, combat, camera, run-blocking issues and much more.\u003C/p>\n\n\u003Cp>The bug reports, feedback, and detailed explanations you've sent us have been invaluable. You've told us what isn't working, what could be better and, just as importantly, what you love about Crimson Moon.\u003C/p>\n\n\u003Cp>And we're not finished.\u003C/p>\n\n\u003Cp>\u003Cstrong>Patch 1.1 is next\u003C/strong>, with more fixes and quality-of-life improvements informed by the feedback you've shared with us. There is still work to do, and we'll continue listening and improving the game.\u003C/p>\n\n\u003Cp>But as we move into October, you're also going to start hearing us talk about something we haven't been able to focus on nearly as much during our first month:\u003C/p>\n\n\u003Cp>\u003Cstrong>What's next for Crimson Moon.\u003C/strong>\u003C/p>\n\n\u003Cp>September was about fixing and stabilising the core experience. Now, alongside continuing that work, we're starting to look further ahead.\u003C/p>\n\n\u003Cp>Beyond Patch 1.1, there's more coming to Gildenarch, including new content, and over the coming weeks we'll begin peeling back the curtain on what we've been working on. For now, here's a little work-in-progress tease of what's to come...\u003C/p>\n\n![Work-in-progress teaser image 1](/metal/post_content/one_month_letter_1.webp)\n\n![Work-in-progress teaser image 2](/metal/post_content/one_month_letter_2.webp)\n\n![Work-in-progress teaser image 3](/metal/post_content/one_month_letter_3.webp)\n\n\u003Cp>If you've stuck with us through this first month, thank you. I'm incredibly proud of this team, grateful for the community that has formed around Crimson Moon, and excited to finally start showing you more of what we have planned.\u003C/p>\n\n\u003Cp>We'll see you in Gildenarch.\u003C/p>\n\n\u003Cp>\u003Cstrong>Dave Lesperance\u003C/strong>\u003C/p>\n\n\u003Cp>\u003Cstrong>General Manager, Team Metal\u003C/strong>\u003C/p>"}}}}},tags:{en:[{tag:"Ire: A Prologue",status:"published",background_color:"#73F48D",text_color:"#000000",localized_text:"games.ireprologue_title"},{tag:"Nekome: Nazi Hunter",status:"published",background_color:"#941015",text_color:"#F1ECCA",localized_text:"games.nekome_title"},{tag:"Patch Notes",status:"published",localized_text:"gb.tag_patch_notes"},{tag:"ProbablyMonsters",status:"published",background_color:"#F9AA26",text_color:"#000000",localized_text:"gb.site_name"},{tag:"Storm Lancers",status:"published",background_color:"#FF1477",text_color:"#FFFFFF",localized_text:"games.stormlancers_title"},{tag:"Crimson Moon",status:"published",background_color:"#330017",text_color:"#EEC586",localized_text:"games.metal_title"}]},takeovers:{en:[{id:13,status:"published",name:"nekome-demo",route:"/(app)/[locale]/(games)/nekome",custom_layout:"nekome-demo",persistence:"perpetual",continue_to_page_label:"nekome.splash_title"}]},toasts:{en:[]}},uses:{params:["locale"]}}}({},{},{},{})),{type:"data",data:{gamedata:{en:{id:1,splash_title:"Nekome: Nazi Hunter",status:"published",splash_cta:"Revenge Begins December 2026",trailer_text:"\u003Cspan>Nekome: Nazi Hunter\u003C/span> is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers. The game follows Vano’s transformation from hunted to hunter as he embarks on a violent personal odyssey of revenge across a war-torn world.\u003Cbr>\u003Cbr>\u003Cspan>Nekome: Nazi Hunter\u003C/span> approaches the Second World War from the personal perspective of Vano as he exacts revenge for the sadistic murders. You’ll scout enemy routes, plan your assault, and strike with precision in a mix of stealth and brutal up-close combat.\u003Cbr>\u003Cbr>The game is inspired by grindhouse cinema and features visceral combat with grounded finishing moves, coming together in a symphony of violence where every encounter carries lasting consequences.",discord_title:"Be among the first to learn more",discord_text:"Join our Discord for exclusive updates, behind-the-scenes content, and future conversations with the Devs.",discord_link:"https://discord.gg/playnekome",media_title:"Media",meta:{id:"nekome",status:"published",title:"Nekome: Nazi Hunter",description:"Nekome: Nazi Hunter is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers."},news_tag:{tag:"Nekome: Nazi Hunter",status:"published",background_color:"#941015",text_color:"#F1ECCA",localized_text:"games.nekome_title"},media_images:[{id:84,status:"published",title:"nekome screenshot 5",media:"d05bf8b4-c9f4-4d72-8458-124a4075bbad",property:"nekome",media_type:"screenshot"},{id:65,status:"published",title:"REVENGE IS PERSONAL",media:"034bd35b-4c8a-4f87-9653-365ac471224d",property:"nekome",media_type:"screenshot",description:"Each mission begins in the enemy’s backyard, where you’ll stalk Nazis, assassinate guards, and set traps to frighten your foes. Enemy awareness is shared and persistent—kill carelessly and patrols respond, wait too long and reinforcements arrive. Stealth isn’t about avoiding the fight. It’s about stacking the odds before the true combat begins."},{id:67,status:"published",title:"THE WORLD IS YOUR WEAPON",media:"b4ef9115-b52d-4e6c-8858-e25439b92c2e",property:"nekome",media_type:"screenshot",description:"Fight with fists, blades, guns, and whatever the environment provides. Nazi-occupied spaces are filled with pipes, tools, and hazards waiting to be used as improvised weapons. Choose your path, set your traps, and weaponize the world against your enemies."},{id:68,status:"published",title:"STRATEGIC COMBAT",media:"cc2a4a96-0f42-4fa2-83a6-9f8035ce79a5",property:"nekome",media_type:"screenshot",description:"Every encounter is your chance to craft a savage masterpiece. Melee is raw, brutal, and bloody, built for life-or-death, close quarters fighting with each punch, stab, and parry making an impact. Use improvised weapons to gain the advantage over enemies who adapt to your fighting style, slow down combat to chain targeted strikes into cinematic assaults, and bring the violence to a finale with visceral finishing blows."},{id:69,status:"published",title:"NOTORIETY AND FEAR\n",media:"20c3ea07-763b-4a48-97b4-2b42660ad42b",property:"nekome",media_type:"screenshot",description:"Notoriety and fear systems add another layer to combat, allowing you to make an example of your enemies and watch their morale collapse. Fear becomes a formidable weapon earned through surgical, savage tactics. Kill with precision or create chaos, and enemies may panic, hesitate, or flee. The notoriety system tracks your brutality and unpredictability, influencing the enemies’ next actions. Some Nazis may rush in blindly, while others refuse to enter the room."}],media_videos:[{id:"nekome-sgf-trailer",status:"published",youtube_id:"ckaUAIQZyU8",media_type:"video",isAgeRestricted:true},{id:"nekome-story-trailer",status:"published",youtube_id:"-5_w45pHOEQ",media_type:"video",isAgeRestricted:true},{id:"nekome-trailer1",status:"published",youtube_id:"cfi7rGaz3gg",media_type:"video",isAgeRestricted:true}],ratings:[{id:"nekome_esrb",rating:"ESRB Mature 17+",rating_badge:"546040dd-b213-48e1-952e-5f1fc8606542"},{id:"nekome_pegi",rating:"PEGI 18",rating_badge:"53de0cdc-da75-437a-a360-ecc67c81569e"}],legal_links:[{id:"pm-account",status:"published",name:"gb.account",slug:"https://account.probablymonsters.com",footer_only:true,children:[]},{id:"pm-privacy",status:"published",name:"gb.privacy_policy",slug:"/privacy",footer_only:true,inactive:false,children:[]},{id:"pm-terms",status:"published",name:"gb.terms_of_use",slug:"/terms",footer_only:true,inactive:false,children:[]}],socials:[{id:"nekome-discord",status:"published",alt_text:"Discord",link:"https://discord.gg/playnekome"},{id:"nekome-facebook",status:"published",alt_text:"Facebook",link:"https://www.facebook.com/PlayNekome"},{id:"nekome-instagram",status:"published",alt_text:"Instagram",link:"https://www.instagram.com/playnekome/"},{id:"nekome-reddit",status:"published",alt_text:"Reddit",link:"https://www.reddit.com/r/playnekome/"},{id:"nekome-tiktok",status:"published",alt_text:"Tiktok",link:"https://www.tiktok.com/@playnekome"},{id:"nekome-x",status:"published",alt_text:"X",link:"https://x.com/PlayNekome"},{id:"pm-youtube",status:"published",alt_text:"Youtube",link:"https://www.youtube.com/c/probablymonsters",image:{id:"318c03b7-b511-4f7a-a362-3229986c3336",filename_disk:"318c03b7-b511-4f7a-a362-3229986c3336.svg",title:"You Tube 2 94e8bbcb6c"}}],cs_link:[{id:"nekome-customer-support",status:"published",name:"gb.customer_support",slug:"https://nekome.zendesk.com",footer_only:false,children:[]}],trailer_video:[{id:"nekome-story-trailer",status:"published",youtube_id:"-5_w45pHOEQ",media_type:"video",isAgeRestricted:true}],features_media:[{id:65,status:"published",title:"REVENGE IS PERSONAL",media:"034bd35
onth-in-gildenarch",body_md:"article.metal.one_month_letter.body",tags:[{id:"17",articles_id:"8",tags_tag:"Crimson Moon"}]},{id:5,status:"published",title:"article.metal.patch1_0_0_1.title",date:"2026-09-04T12:00:00",slug:"crimson-moon-patch-notes-sept-3-2026",meta_desc:"article.metal.patch1_0_0_1.meta_desc",body_md:"article.metal.patch1_0_0_1.body",image:{id:"d3812ff0-c704-4c71-a2cb-d7bee32790b2",filename_disk:"d3812ff0-c704-4c71-a2cb-d7bee32790b2.webp",title:"Patch Notes 1001 1",width:1920,height:1080,tags:["sizes"]},tags:[{id:"11",articles_id:"5",tags_tag:"Patch Notes"},{id:"12",articles_id:"5",tags_tag:"Crimson Moon"}]}]},games:{en:[{id:1,status:"published",public_name:"Crimson Moon",internal_name:"metal",url:"/crimsonmoon",description:"Crimson Moon is a gothic action-adventure RPG where players unleash transformative combat through savage, replayable runs and scalable challenges fought alone or together in co-op.",tile_image:{id:"e9638259-f889-47a8-9e5b-6c72685e293c",filename_disk:"e9638259-f889-47a8-9e5b-6c72685e293c.webp",title:"Games Cm",width:1200,height:900,tags:["sizes"]},game_platforms:[{id:8,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/4317690/Crimson_Moon/",name:"Metal Steam",disable:false,property:"metal"},{id:6,status:"published",platform:"ps5",state:"available",url:"https://store.playstation.com/concept/10013260",name:"Metal PS5",disable:false,property:"metal"},{id:7,status:"published",platform:"xboxseries",state:"available",url:"https://www.xbox.com/games/store/crimson-moon/9nmdsxmvqtn4",name:"Metal XBox",disable:false,property:"metal"},{id:9,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/crimson-moon-b329bd",name:"Metal EGS",disable:false,property:"metal"}]},{id:2,status:"published",public_name:"Nekome: Nazi Hunter",internal_name:"nekome",url:"/nekome",description:"Nekome: Nazi Hunter is a single-player, third-person action combat game where you step into the role of Vano Nastasu, a young Romani man consumed by grief after the brutal murder of his family by Nazi soldiers.",tile_image:{id:"d4cb5873-e15b-4e8a-a72c-e5ac55bd604e",filename_disk:"d4cb5873-e15b-4e8a-a72c-e5ac55bd604e.webp",title:"Games Nekome",width:1200,height:900,tags:["sizes"]},game_platforms:[{id:10,status:"published",platform:"steam",state:"preorder",url:"https://store.steampowered.com/app/4200110/Nekome_Nazi_Hunter/",name:"Nekome Steam",disable:false,property:"nekome"},{id:11,status:"published",platform:"ps5",state:"preorder",url:"https://store.playstation.com/concept/10017846",name:"Nekome PS5",disable:false,property:"nekome"},{id:12,status:"published",platform:"xboxseries",state:"preorder",url:"https://www.xbox.com/games/store/nekome-nazi-hunter/9mv2jjsl35zv",name:"Nekome Xbox",disable:false,property:"nekome"},{id:13,status:"published",platform:"epic",state:"preorder",url:"https://store.epicgames.com/p/nekome-712f11",name:"Nekome Epic",disable:false,property:"nekome"}]},{id:3,status:"published",public_name:"Ire: A Prologue",internal_name:"ire",url:"/ire",description:"It's 1986, and you're stranded in the Bermuda Triangle — but not alone. Trapped in a terrifying loop with a monster, you'll have to stay one step ahead to survive and uncover the truth. Ready or not, here it comes.",tile_image:{id:"7c20bf7b-2d3c-4bd3-8d09-ae13ad2db06c",filename_disk:"7c20bf7b-2d3c-4bd3-8d09-ae13ad2db06c.webp",title:"Games Ireprologue",width:1200,height:900,tags:["sizes"]},game_platforms:[{id:1,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/3547420/Ire_A_Prologue/",name:"Ire Steam",disable:false,property:"ireprologue"},{id:2,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/ire-94cf31",name:"Ire Epic",disable:false,property:"ireprologue"}]},{id:4,status:"published",public_name:"Storm Lancers",internal_name:"stormlancers",url:"/stormlancers",description:"Storm Lancers is a fast-paced rogue-like, where every run means dodging death, overcoming enemies, and mastering powerful skills. The battle is on, so team up in chaotic co-op to double your chances of survival.",tile_image:{id:"a226a316-6a94-44a2-b77d-40e02c380801",filename_disk:"a226a316-6a94-44a2-b77d-40e02c380801.webp",title:"Games Stormlancers",width:1200,height:900,tags:["sizes"]},game_platforms:[{id:3,status:"published",platform:"steam",state:"available",url:"https://store.steampowered.com/app/4046570/Storm_Lancers",name:"Stormlancers Steam",disable:false,property:"stormlancers"},{id:4,status:"published",platform:"epic",state:"available",url:"https://store.epicgames.com/p/storm-lancers-5369a2",name:"Stormlancers EGS",disable:false,property:"stormlancers"},{id:5,status:"published",platform:"nintendo",state:"available",url:"https://www.nintendo.com/store/products/storm-lancers-nintendo-switch-2-edition-switch-2/",name:"Stormlancers Nintendo",disable:false,property:"stormlancers"}]}]},globals:{en:{title:"Global",status:"published",btn_read_more:"Read More",carousel_arrow_label_prev:"Previous",carousel_arrow_label_next:"Next",footer_legal_boilerplate:"PROBABLYMONSTERS and the PROBABLYMONSTERS logo are trademarks of ProbablyMonsters Inc.",btn_view_job:"View Job",btn_learn_more:"Learn More",footer_copyright:"ProbablyMonsters Inc. All rights reserved.",btn_close:"Close",btn_back_to_careers:"Back to Careers",errors_generic:"Uh Oh, looks like something broke.",errors_404:"Page Not Found",btn_return_home:"Return to ProbablyMonsters Home\n",btn_apply:"Apply",press_additional:"Additional Press",jobs_view_open:"{count} Open Roles",job_alerts_button:"Sign up for Job Alerts",site_name:"ProbablyMonsters",jobs_view_open_singular:"{count} Open Role",career_table_clear:"Clear All",career_table_filter:"Filter",faq_button:"Read our F.A.Q.",faq_title:"Frequently Asked Questions",career_table_open_role_singular:"Open Role",career_table_open_role_plural:"Open Roles",career_table_filters:"Filters",filter_results:"Filter Your Results",jobs_view_open_positions:"View Open Positions",btn_load_more:"Load More",btn_hide_more:"Hide More",form_field_name:"Name",form_field_email:"Email",form_field_region:"Region",form_field_agree_to_TOS:"By checking this box, I acknowledge that I am at least 18 years of age, that I agree to the ProbablyMonsters {terms}, and that I have read and acknowledge the {privacy}. I consent to receive news, game reveals, and updates from ProbablyMonsters about its games via newsletter.",btn_submit:"Submit",btn_reset:"Reset",btn_sign_up:"Sign Up",form_field_required:"*Required",form_field_optional:"(optional)",btn_more_news:"More News",btn_sort_table:"Sort",social_media_follow_us:"Follow Us",btn_steam_wishlist:"Steam",media_filters:[{screenshot:"Screenshots",video:"Videos",wallpaper:"Wallpapers"}],btn_press_kit:"Press Kit",form_field_at_least_13:"gb.form_field_at_least_13",social_media_conversation:"Join the Conversation",form_field_newsletter_signup_chk:"Send me the Newsletter",newsletter_join_header:"Join Our Newsletter",newsletter_join_desc:"Be the first to hear the latest on all our upcoming games. Sign up for our newsletter and get exclusive updates, behind-the-scenes content, and more.",newsletter_thankyou_title:"Thank You",newsletter_thankyou_body:"Please check your email inbox to confirm your sign-up.",btn_epic_wishlist:"Epic",wishlist_on:"Wishlist Now",form_field_first:"First",form_field_last:"Last",newsletter_error:"Something went wrong. Please try again later.",btn_accept:"Accept",btn_decline:"Decline",btn_privacy_choose:"Let Me Choose",cookie_notification_title:"Your Privacy Choices",cookie_notification_summary:"We collect anonymous performance data (page load times, resource timings, errors) and usage data (clicks, taps, form submissions) to help us improve this site.  No personal information is tracked.",privacy_options_link:"Do Not Sell or Share my Personal Information",btn_confirm:"Confirm",btn_accept_all:"Accept All",btn_reject_all:"Reject All",privacy_options_advertising_title:"Advertising",privacy_options_advertising_body:"These cookies are used to make advertising messages more relevant to you. They perform functions like preventing the same ad from continuously reappearing, ensuring that ads are properly displayed for advertisers, and in some cases selecting advertisements that are based on your interests.",privacy_options_analytics_title:"Analytics",privacy_options_analytics_body:"Subject to your consent, we use these cookies, like Google Analytics, to help us understand how users access and use our services. The data collected typically includes information such as your IP address, your internet service provider, your web browser, the time spent on web pages, the links clicked and the advertisements viewed on those pages. We use this information to improve the Services and your experience, to see which areas and features of our services are popular, and for which visitors, and to count visits.",privacy_options_legal_basis_title:"Legal Basis",privacy_options_legal_basis_body:"Data subject has received adequate disclosure describing the processing for one or more specific purposes, and can subsequently opt-out.",privacy_opt_in_chk:"Opt-In",customer_support:"Customer Support",account_link:"Account",btn_buy_now:"Buy Now",play_demo_now:"Play Demo Now",available_now:"Available Now",form_field_TOS_privacy_link_pm:"ProbablyMonsters \u003Ca href=\"/{lang}/privacy\" target=\"_blank\">Privacy Statement\u003C/a>",form_field_TOS_privacy_link_storm:"Storm Lancers \u003Ca href=\"/{lang}/stormlancers/privacy\" target=\"_blank\">Privacy Statement\u003C/a>",btn_discord_join:"Join Our Discord",buy_title_steam:"Buy on Steam Store",buy_title_egs:"Buy on Epic Games Store",buy_title_nintendo:"Buy on Nintendo eShop",coming_soon:"Coming Soon",age_gate_header:"Please verify your age to continue.",age_gate_fail_msg:"We're sorry, but you may not access this content.",section_title_media:"Media",section_title_news:"News",btn_play_trailer:"Watch Trailer",section_title_features:"Game Features",platform_steam:"Steam Store",platform_egs:"Epic Games Store",platform_ps5:"Playstation 5",platform_xboxseries:"Xbox Series X|S",platform_nintendoeshop:"Nintendo eShop",section_title_pm_news:"In The News",tag_filter_all:"All Posts",section_title_games:"Our Games",on_sale_now_percentage:"On Sale Now - {percentage}% Off",btn_continue_to_page:"Continue to {page}",terms_of_use:"Terms of Use",privacy_policy:"Privacy Policy",more_pm_careers:"More ProbablyMonsters Careers",related_news:"Related News",related_posts:"Related Posts",job_meta_title:"Job Opening: {job}",job_meta_description:"Job Opening: {title} ({location}) ",age_gate_day:"Day",age_gate_month:"Month",age_gate_year:"Year",privacy_statement:"Privacy Statement",tag_patch_notes:"Patch Notes",studio_header_logo:{id:"3d5b11cf-c2e0-4bf7-a51f-263c8780a61f",filename_disk:"3d5b11cf-c2e0-4bf7-a51f-263c8780a61f.svg",title:"Yeti 0b4752765c"},job_faq:[{question:"How can I add a cover letter to my application?",status:"published",response:"There is a cover letter button at the bottom of the application page under “additional files”."},{question:"How can I submit my portfolio / demo reel?",status:"published",response:"There is a portfolio button at the bottom of the application page under “additional files”. Demo reels should be 1 to 3 minutes in length. Unless you are an animator, demo reels are not necessary. We place emphasis on artwork process breakdowns for our artist positions. Refer to the job posting for specific submission requirements."},{question:"Will ProbablyMonsters provide feedback on my application?",status:"published",response:"Due to the quantity of submissions received, we are not able to offer individual feedback."},{question:"Do you offer internships?",status:"published",response:"Yes, we encourage students to apply! All internships will be posted to our career page by March of each year."},{question:"Can I submit a game or story idea?",status:"published",response:"No. Each of our game's ideas and stories are developed internally and it is our company-wide policy not to view any external submissions."},{question:"What if I'd like to apply for a position that isn't currently open?",status:"published",response:"On our open positions list on the Careers page, under the “Other” category, there is a “General Application” position. Please apply there and let us know what position(s) you are interested in!"},{question:"What does the ProbablyMonsters benefits package look like?",status:"published",response:"We offer a competitive benefits package, including annual stock option grants; health coverage (medical, dental, vision) with the majority of the employee premium covered by the Company and high subsidized coverage for dependents; Flexible Spending Account eligibility; Health Savings Account contributions by the Company, Company sponsored life, accidental death, and disability insurance coverage; annual 401K and match by the Company; Employee Assistance Program; paid family/medical leave and extensive paid time off plus holiday closures."},{question:"Where do I apply for a job?",status:"published",response:"Here on our Careers page is a list of all open positions across ProbablyMonsters and our game development teams. Click the “view job” button next to the position you're interested in, and the “apply” button at the bottom of the detailed job description."}]}},legal:{en:{id:1,status:"published",boilerplate_pm_basic:"PROBABLYMONSTERS and the PROBABLYMONSTERS logo{games}are trademarks of ProbablyMonsters Inc.",boilerplate_pm_games_stormlancers:"STORM LANCERS and the STORM LANCERS logo,",boilerplate_pm_games_ireprologue:"IRE: A PROLOGUE and the IRE: A PROLOGUE logo,",boilerplate_pm_games_nekome:"NEKOME, NEKOME NAZI HUNTER and the NEKOME NAZI HUNTER logo",boilerplate_pm_games_metal:"and CRIMSON MOON and the CRIMSON MOON logo",boilerplate_platforms_nintendo_switch:"Nintendo Switch is a trademark of Nintendo.",boilerp
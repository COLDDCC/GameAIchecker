f3849.1920x1080.jpg?t=1790846854"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5019920\/710548d703fff4d96ab7387225c271e52ec72bef\/ss_710548d703fff4d96ab7387225c271e52ec72bef.600x338.jpg?t=1790846854","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5019920\/710548d703fff4d96ab7387225c271e52ec72bef\/ss_710548d703fff4d96ab7387225c271e52ec72bef.1920x1080.jpg?t=1790846854"}],"movies":[{"id":257406706,"name":"Tasty Chef EA Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257406706\/2ed8a6f93c2c4e09e36d5b6c1928c9211fd98d93\/movie_600x337.jpg?t=1790202169","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5019920\/943314039\/e658e1701442e8149e5b34a025ee8d447fa8ae36\/1790199904\/dash_av1.mpd?t=1790202169","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5019920\/943314039\/e658e1701442e8149e5b34a025ee8d447fa8ae36\/1790199904\/dash_h264.mpd?t=1790202169","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/5019920\/943314039\/e658e1701442e8149e5b34a025ee8d447fa8ae36\/1790199904\/hls_264_master.m3u8?t=1790202169","highlight":true}],"recommendations":{"total":542},"achievements":{"total":59,"highlighted":[{"icon":"df35f021c9d703293a6ca68aa524f09d7eb3e7ac.jpg","localized_name":"First Week","archived":0,"hidden":0,"name":"First Week","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/df35f021c9d703293a6ca68aa524f09d7eb3e7ac.jpg"},{"icon":"30f9395e1155ac25cf541e2ee9cec2ab13a2083d.jpg","localized_name":"Neighborhood Favorite","archived":0,"hidden":0,"name":"Neighborhood Favorite","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/30f9395e1155ac25cf541e2ee9cec2ab13a2083d.jpg"},{"icon":"8dde5adfb53baefa29d83550021a4e90cf8d6391.jpg","localized_name":"Through Every Season","archived":0,"hidden":0,"name":"Through Every Season","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/8dde5adfb53baefa29d83550021a4e90cf8d6391.jpg"},{"icon":"b21618735180cbba1328f1d1e7445713409b6604.jpg","localized_name":"Evergreen","archived":0,"hidden":0,"name":"Evergreen","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/b21618735180cbba1328f1d1e7445713409b6604.jpg"},{"icon":"3bc67c1482d69f1dc855dc45c1c71a24fedab3e8.jpg","localized_name":"First Hundred","archived":0,"hidden":0,"name":"First Hundred","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/3bc67c1482d69f1dc855dc45c1c71a24fedab3e8.jpg"},{"icon":"7f1a58de28726cf30e7f6d857aabc9ee738044b3.jpg","localized_name":"Word Gets Around","archived":0,"hidden":0,"name":"Word Gets Around","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/7f1a58de28726cf30e7f6d857aabc9ee738044b3.jpg"},{"icon":"d80a1bb8bec17345799d53af1c78d030385f9d3f.jpg","localized_name":"A Constant Crowd","archived":0,"hidden":0,"name":"A Constant Crowd","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/d80a1bb8bec17345799d53af1c78d030385f9d3f.jpg"},{"icon":"9b1cdd7044a9a0f8e53fb3afeda985dd506411b9.jpg","localized_name":"Household Name","archived":0,"hidden":0,"name":"Household Name","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/9b1cdd7044a9a0f8e53fb3afeda985dd506411b9.jpg"},{"icon":"d78d0dee1cbbfb5d96b2d51e018d2120d09ffc6d.jpg","localized_name":"Getting Started with Ingredients","archived":0,"hidden":0,"name":"Getting Started with Ingredients","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/d78d0dee1cbbfb5d96b2d51e018d2120d09ffc6d.jpg"},{"icon":"862251f0da5867ce5c87f0fa07a4a31d3a54b3ed.jpg","localized_name":"Measured to Perfection","archived":0,"hidden":0,"name":"Measured to Perfection","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5019920\/862251f0da5867ce5c87f0fa07a4a31d3a54b3ed.jpg"}]},"release_date":{"coming_soon":false,"date":"Sep 23, 2026"},"support_info":{"url":"","email":"contact@xpercent.games"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/5019920?t=1790846854","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5019920\/24358a4985f6edf82cd7ac1641e84f6aa971a4bc\/page_bg_raw.jpg?t=1790846854","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"10","required_age":"10","banned":"0","use_age_gate":"0","descriptors":"Violência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Gewalt"}}}}}
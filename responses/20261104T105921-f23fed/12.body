intendo Switch Pro Controller.[\/p][\/*][\/list][p][b]Fixes & Improvements[\/b][\/p][list][*][p][b]Ability\/Combat:[\/b] Improved attack detection to prevent missed hits during valid contacts.[\/p][\/*][*][p][b]UI:[\/b] Fixed an issue where the Upgrade icon animation would get stuck.[\/p][\/*][*][p][b]Graphics:[\/b] Enhanced light baking across scenes.[\/p][\/*][*][p][b]Gameplay:[\/b] Fine-tuned interaction hitboxes for smoother player interaction.[\/p][\/*][\/list]","commentcount":5,"tags":["mod_reviewed","ModAct_1691520782_1792516485_0","ModAct_1294976491_1792574367_4"],"language":0,"hidden":0,"forum_topic_id":"573804280379774815","event_gid":"669505296465399150","voteupcount":33,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804280379774815","rtime32_last_modified":1793698094,"news_post_gid":"0","rtime_mod_reviewed":1792574367,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792514910,"votes_up":33,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585057417507794927","gidfeature2":"573804280379774815"},{"gid":"714538122294068565","clan_steamid":"103582791475723089","event_name":"We're Steam Deck Ready!","event_type":28,"appid":4870430,"server_address":null,"server_password":null,"rtime32_start_time":1789426260,"rtime32_end_time":1789429320,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Launching on September 16th, Steam Deck ready and Simplified Chinese.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Steam Deck ready for September 16th! Enjoy 60 FPS, full gamepad support, and Simplified Chinese at launch.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"d87525dd8b40554028414df0b59f973ffdfd6684.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"2703b212a1be723963b1fa3de97d3ebed66db682.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"714538122294068566","clanid":"46201681","posterid":"0","headline":"We're Steam Deck Ready!","posttime":1789426293,"updatetime":1789426293,"body":"[p]Hey everyone![\/p][p]In case you haven\u2019t noticed, the game launches on September 16th! With release just around the corner, here\u2019s a quick update on what we\u2019ve been working on.[\/p][p]Most of our testing has been done on Steam Deck, and we\u2019ve put plenty of work into optimizing the game to hold a smooth 60 FPS. There\u2019s also full gamepad support, so you can settle in and get comfortable![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46201681\/dde7efb41490b3facb94320a9f8c4895e1717fb8.jpg\"][\/img][\/p][p]The official Steam Deck compatibility badge may take a little longer to appear[b].[\/b] However, you can buy with confidence knowing we\u2019ve extensively tested the game and built it to play smoothly on the hardware.[\/p][p]We also have a couple of content updates to share. Unfortunately, the storyline has been postponed and won\u2019t be included at launch. Sauropods have also been replaced by non-dinosaurian creatures, but we plan to introduce a dedicated sauropod room in a future update, giving these giants the space they deserve to truly shine.[\/p][p]We\u2019re still hard at work squashing bugs and polishing things up before launch. Meanwhile, the cat in the picture has done everything in his power to stop us from doing any of the above. Despite his best efforts, we\u2019re getting there.[\/p][p]We\u2019ve also managed to squeeze in Simplified Chinese support for launch, with more languages to come![\/p][p]Thanks for being here and cheering us on. We can\u2019t wait for you to play on September 16th![\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_1888979151_1789428668_0"],"language":0,"hidden":0,"forum_topic_id":"525387344813132750","event_gid":"714538122294068565","voteupcount":37,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"525387344813132750","rtime32_last_modified":1790954571,"news_post_gid":"0","rtime_mod_reviewed":1789428668,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1789425305,"votes_up":37,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"585057417507794927","gidfeature2":"525387344813132750"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["669505296465399151","714538122294068566"],"last_update_event":{"rtime":1792514880,"event_gid":"669505296465399150","announcement_gid":"669505296465399151","clan_account_id":46201681}}};

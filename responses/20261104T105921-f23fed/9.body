																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"667252863011914652","clan_steamid":"103582791475794368","event_name":"The Bakery Is Now Open!","event_type":14,"appid":5019920,"server_address":null,"server_password":null,"rtime32_start_time":1791457800,"rtime32_end_time":1791462601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"From your first batch of bread to shelves full of pastries, run a bakery with your animal friends.\",null,null,null,null,null,\"\u4ece\u7b2c\u4e00\u76d8\u9762\u5305\u5230\u6ee1\u67dc\u751c\u70b9\uff0c\u548c\u52a8\u7269\u4f19\u4f34\u4e00\u8d77\u7ecf\u8425\u4f60\u7684\u9762\u5305\u623f\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The Bakery comes to Tasty Chef! Bake breads and pastries, stock your displays, serve customers, and organize your staff and deliveries in a whole new shop.\",null,null,null,null,null,\"\u5168\u65b0\u9762\u5305\u623f\u52a0\u5165\u300a\u52a8\u7269\u53a8\u623f\u300b\uff01\u4eb2\u624b\u70d8\u7119\u9762\u5305\u4e0e\u751c\u70b9\uff0c\u5b89\u6392\u9648\u5217\u3001\u8865\u8d27\u548c\u6536\u94f6\uff0c\u518d\u628a\u65b0\u9c9c\u51fa\u7089\u7684\u7f8e\u5473\u9001\u5230\u987e\u5ba2\u624b\u4e2d\u3002\u65b0\u7684\u5e97\u94fa\u3001\u65b0\u7684\u914d\u65b9\uff0c\u8fd8\u6709\u65b0\u7684\u7ecf\u8425\u6311\u6218\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"226bee472c3a3c74cc75f2e89a4b4c792d2eb280.png\",null,null,null,null,null,\"bf24732cb745925916dda064ddfb90f79ec5c755.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"667252863011914653","clanid":"46272960","posterid":"0","headline":"The Bakery Is Now Open!","posttime":1791457859,"updatetime":1791457893,"body":"[p][b]Boss, it\u2019s time to open the bakery![\/b][\/p][p]This update brings a brand-new bakery to Tasty Chef. Prepare your dough, shape each batch, get it into the oven, and fill your displays before opening the doors to your first customers.[\/p][p][\/p][p][b]Start with Your First Batch[\/b][\/p][p]Bread rolls, baguettes, croissants, sandwich loaves, egg tarts, cream puffs, and cakes\u2014there\u2019s plenty to fill your shelves. As you progress, learn new recipes and add equipment to expand your selection.[\/p][p]Different treats call for different steps. Organize your workstations and ovens, keep track of each batch, and get your finished goods ready for the shop floor.[\/p][p][\/p][p][b]They Pick the Treats. You Run the Shop.[\/b][\/p][p]Customers browse the bakery\u2019s displays, pick out what they want, and head to the checkout.[\/p][p]What\u2019s running low? What should go into the oven next? Do you refill a display first or help the customers waiting to pay? You\u2019ll have plenty to keep an eye on, from the kitchen to the counter.[\/p][p][\/p][p][b]Share the Work with Your Staff[\/b][\/p][p]Assign staff to tasks such as checkout and restocking, then arrange your equipment and displays to cut down on unnecessary trips. As business picks up, find a layout and division of work that suit your shop.[\/p][p][\/p][p][b]Take Your Bakery on the Road[\/b][\/p][p]Expand into delivery orders: accept an order, gather the items, pack them up, and organize your delivery staff and vehicles. Keep things moving for customers in the shop and those waiting for their orders to arrive.[\/p][p][\/p][p][b]New Achievements to Work Toward[\/b][\/p][p]The update also adds bakery achievements covering baking, sales, checkout, and deliveries. Take on new challenges as your little shop grows, one working day at a time.[\/p][p][\/p][p]Aprons on, doors open. See you at the bakery![\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_773020726_1791458846_0"],"language":0,"hidden":0,"forum_topic_id":"582810370004118540","event_gid":"667252863011914652","voteupcount":135,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582810370004118540","rtime32_last_modified":1793669583,"news_post_gid":"0","rtime_mod_reviewed":1791458846,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791457692,"votes_up":135,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"582809103434339988","gidfeature2":"582810370004118540"},{"gid":"707783993093784698","clan_steamid":"103582791475794368","event_name":"Tasty Chef Is Out Now on Steam!","event_type":10,"appid":5019920,"server_address":null,"server_password":null,"rtime32_start_time":1790204580,"rtime32_end_time":1790209801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"From your first bubble tea to your first sushi plate, build your dream shop with your animal friends!\",null,null,null,\"\uccab \ubc00\ud06c\ud2f0 \ud55c \uc794\ubd80\ud130 \uccab \ucd08\ubc25 \ud55c \uc811\uc2dc\uae4c\uc9c0, \ub3d9\ubb3c \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \ub098\ub9cc\uc758 \uac00\uac8c\ub97c \uc6b4\uc601\ud574 \ubcf4\uc138\uc694!\",null,\"\u4ece\u7b2c\u4e00\u676f\u5976\u8336\u5230\u7b2c\u4e00\u76d8\u5bff\u53f8\uff0c\u548c\u52a8\u7269\u4f19\u4f34\u4e00\u8d77\u7ecf\u8425\u5c5e\u4e8e\u4f60\u7684\u5c0f\u5e97\uff01\",\"\u5f9e\u7b2c\u4e00\u676f\u5976\u8336\u5230\u7b2c\u4e00\u76e4\u58fd\u53f8\uff0c\u548c\u52d5\u7269\u5925\u4f34\u4e00\u8d77\u7d93\u71df\u5c6c\u65bc\u4f60\u7684\u5c0f\u5e97\uff01\",null,null,\"\u6700\u521d\u306e\u4e00\u676f\u306e\u30df\u30eb\u30af\u30c6\u30a3\u30fc\u304b\u3089\u3001\u6700\u521d\u306e\u4e00\u76bf\u306e\u304a\u5bff\u53f8\u307e\u3067\u3002\u52d5\u7269\u306e\u4ef2\u9593\u305f\u3061\u3068\u3001\u81ea\u5206\u3060\u3051\u306e\u304a\u5e97\u3092\u80b2\u3066\u3088\u3046\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Tasty Chef is out now! Start with bubble tea, unlock sushi, cook, decorate, and hire animal staff. Play solo or with friends. Thanks for your support\u2014let\u2019s open for business!\",null,null,null,\"Tasty Chef\uac00 \uc815\uc2dd \ucd9c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4! \uc544\ub291\ud55c \ubc00\ud06c\ud2f0 \uac00\uac8c\uc5d0\uc11c \uc2dc\uc791\ud574 \ucd08\ubc25\uc9d1\uc744 \ud574\uae08\ud558\uace0, \uc694\ub9ac\uc640 \uc778\ud14c\ub9ac\uc5b4, \ub3d9\ubb3c \uc9c1\uc6d0 \ucc44\uc6a9\uae4c\uc9c0 \uc990\uaca8 \ubcf4\uc138\uc694. \ud63c\uc790 \ub610\ub294 \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uc6b4\uc601\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud568\uaed8\ud574 \uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4. \uc774\uc81c \uac00\uac8c \ubb38\uc744 \uc5f4\uc5b4 \ubcfc\uae4c\uc694?\",null,\"\u300a\u52a8\u7269\u53a8\u623f Tasty Chef\u300b\u6b63\u5f0f\u53d1\u552e\uff01\u4ece\u6e29\u99a8\u7684\u5976\u8336\u5e97\u8d77\u6b65\uff0c\u9010\u6b65\u89e3\u9501\u5bff\u53f8\u5e97\uff0c\u4eb2\u624b\u5236\u4f5c\u7f8e\u98df\u3001\u81ea\u7531\u5e03\u7f6e\u9910\u5385\u3001\u62db\u52df\u52a8\u7269\u5458\u5de5\uff0c\u72ec\u81ea\u7ecf\u8425\u6216\u4e0e\u597d\u53cb\u5206\u5de5\u5408\u4f5c\u3002\u611f\u8c22\u4e00\u8def\u966a\u4f34\uff0c\u73b0\u5728\uff0c\u4e00\u8d77\u5f00\u95e8\u8425\u4e1a\u5427\uff01\",\"\u300a\u52d5\u7269\u5eda\u623f Tasty Chef\u300b\u6b63\u5f0f\u767c\u552e\uff01\u5f9e\u6eab\u99a8\u7684\u5976\u8336\u5e97\u8d77\u6b65\uff0c\u9010\u6b65\u89e3\u9396\u58fd\u53f8\u5e97\uff0c\u89aa\u624b\u88fd\u4f5c\u7f8e\u98df\u3001\u81ea\u7531\u4f48\u7f6e\u9910\u5ef3\u3001\u62db\u52df\u52d5\u7269\u54e1\u5de5\uff0c\u7368\u81ea\u7d93\u71df\u6216\u8207\u597d\u53cb\u5206\u5de5\u5408\u4f5c\u3002\u611f\u8b1d\u4e00\u8def\u966a\u4f34\uff0c\u73fe\u5728\uff0c\u4e00\u8d77\u958b\u9580\u71df\u696d\u5427\uff01\",null,null,\"\u300eTasty Chef\u300f\u304c\u6b63\u5f0f\u30ea\u30ea\u30fc\u30b9\uff01\u5c0f\u3055\u306a\u30df\u30eb\u30af\u30c6\u30a3\u30fc\u30b7\u30e7\u30c3\u30d7\u304b\u3089\u59cb\u3081\u3066\u3001\u304a\u5bff\u53f8\u5c4b\u3055\u3093\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3002\u6599\u7406\u3084\u81ea\u7531\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u3001\u52d5\u7269\u30b9\u30bf\u30c3\u30d5\u306e\u63a1\u7528\u3092\u697d\u3057\u307f\u306a\u304c\u3089\u3001\u4e00\u4eba\u3067\u3082\u30d5\u30ec\u30f3\u30c9\u3068\u4e00\u7dd2\u3067\u3082\u304a\u5e97\u3092\u7d4c\u55b6\u3067\u304d\u307e\u3059\u3002\u5fdc\u63f4\u3057\u3066\u304f\u3060\u3055\u3063\u305f\u7686\u3055\u307e\u3001\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\u3055\u3042\u3001\u958b\u5e97\u3057\u307e\u3057\u3087\u3046\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"8adc06019819e45076f440d1bf18561711c55377.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"4e03f9c7ff25fb30e382c3802bd9f528e0852d2d.png\",null,null,null,null,null,\"88fac4abc63320dd556c4c7d3b3468d977382a68.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"707783993093784699","clanid":"46272960","posterid":"0","headline":"Tasty Chef Is Out Now on Steam!","posttime":1790204627,"updatetime":1790204627,"body":"[h2][b]Hello, shop owners![\/b][\/h2][p][\/p][p][b]Tasty Chef has officially launched on Steam![\/b][\/p][p]Thank you to everyone who tried the demo, shared feedback, added the game to their wishlist, or patiently waited for launch. Your support and suggestions have helped our little kitchen grow, bringing us all the way to this special day.[\/p][p][\/p][p][b]Launch offer: -33% for 14 days![\/b][\/p][p][b]Get our lowest price for the first year![\/b] We won\u2019t offer a bigger discount than this launch offer during the first year after release.[\/p][p][\/p][p][b]There\u2019s more to look forward to[\/b][\/p][p]Launch marks a new beginning. We\u2019ll continue fixing issues and improving the experience based on your feedback. The bakery is in development and [b]is expected to arrive in an update in October 2026. It is not available yet.[\/b] We\u2019ll share more details in future announcements.[\/p][p][\/p][p]If you encounter any issues or have ideas and suggestions, please leave a message in the Steam Community or join our [url=\"https:\/\/discord.gg\/TqhptnqgqE\"]Discord community[\/url]. When reporting an issue, including screenshots, the steps that led to it, and your game version will help us investigate more quickly.[\/p][p][\/p][p]Thank you again for your support. We can\u2019t wait to see your shops and hear the stories you create along the way.[\/p][p][\/p][p][b]Tasty Chef is open for business. See you in the kitchen![\/b][\/p][p][\/p][p]The Xpercent Games Development Team[\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1890460210_1790205030_0"],"language":0,"hidden":0,"forum_topic_id":"582809103434339989","event_gid":"707783993093784698","voteupcount":77,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582809103434339989","rtime32_last_modified":1791543480,"news_post_gid":"0","rtime_mod_reviewed":1790205030,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790203152,"votes_up":77,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"582809103434339988","gidfeature2":"582809103434339989"},{"gid":"687520329382232092","clan_steamid":"103582791475794368","event_name":"1.1.14 Patch Note","event_type":12,"appid":5019920,"server_address":null,"server_password":null,"rtime32_start_time":1792558562,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"687520329382232093","clanid":"46272960","posterid":"0","headline":"1.1.14 Patch Note","posttime":1792558562,"updatetime":1792558562,"body":"- Fixed occasional save failure bug\n- Fixed blueprint disappearing after deletion and re-subscription\n- Fixed multiple delivery orders showing highlights simultaneously\n- Optimized employee interface occasionally disappearing\n- Employee skill display now adapted to shop type","commentcount":2,"tags":["patchnotes","mod_reviewed","ModAct_1598046824_1792560001_0"],"language":0,"hidden":0,"forum_topic_id":"568174939259034191","event_gid":"687520329382232092","voteupcount":6,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568174939259034191","rtime32_last_modified":1793540212,"news_post_gid":"0","rtime_mod_reviewed":1792560002,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792558562,"votes_up":6,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"582809103434339988","gidfeature2":"568174939259034191"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["667252863011914653","707783993093784699"],"last_update_event":{"rtime":1792558562,"event_gid":"687520329382232092","announcement_gid":"687520329382232093","clan_account_id":46272960}}};
						</script>
					


2725774","content_descriptors":{"ids":[5],"notes":"This game depicts the design and testing of nuclear weapons. While there is no graphic violence against humans, the themes of nuclear proliferation and mass destruction are treated with a serious tone appropriate for a mature audience."},"ratings":{"dejus":{"rating_generated":"1","rating":"10","required_age":"10","banned":"0","use_age_gate":"0","descriptors":"Violência"},"steam_germany":{"rating_generated":"1","rating":"12","required_age":"12","banned":"0","use_age_gate":"0","descriptors":"Gewalt"}}}}}
							var StoreDefaults = {"PartnerEventStore":[{"gid":"713416661425719995","clan_steamid":"103582791475457672","event_name":"Test Branch Update \u2014 Version 1.0.18.0","event_type":13,"appid":4267800,"server_address":null,"server_password":null,"rtime32_start_time":1793667720,"rtime32_end_time":1793673001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Comfortable Quality-of-Life Changes\",null,null,null,null,null,\"\\u4e24\\u9879\\u8212\\u670d\\u7684\\u51cf\\u8d1f\\u6539\\u52a8\",\"\\u4e24\\u9879\\u8212\\u670d\\u7684\\u51cf\\u8d1f\\u6539\\u52a8\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"14cbb2bf6540812ffd4d015fb0e0b5615fe9a447.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"0df1732d95779cbdcb9539a50fd0cdda46d718fe.png\",null,null,null,null,null,\"ae56cd9bff4216f35ac62b91b1fd497239a22a1c.png\",\"ae56cd9bff4216f35ac62b91b1fd497239a22a1c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"713416661425719344\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"713416661425719996","clanid":"45936264","posterid":"0","headline":"Test Branch Update \u2014 Version 1.0.18.0","posttime":1793667759,"updatetime":1793667759,"body":"To prevent nasty bugs from slipping into future versions, we've opened a \"Test\" branch as an early-update branch for each version.\nThis branch is used for testing each version, so the risks are unpredictable \u2014 we don't recommend regular players switch to it.\nBrave players can right-click the game \u2192 \"Properties\" \u2192 \"Game Versions & Betas\" \u2192 select the \"test\" branch to try out new versions early.\n(Be absolutely sure to back up your saves, and beware of data loss and other nasty bugs caused by the test branch.)\n\n[h3][color=lightblue]Test Branch[\/color] Update \u2014 Version 1.0.18.0[\/h3]\n\n[color=yellow]Improvements[\/color]\n1. Added an auto quick-click recruitment assist feature.\n2. Optimized stuttering caused by sorting certain items \/ storage.\n3. Removed the random range when generating refined inner elixirs \u2014 it now always produces the maximum value, saving our OCD players.\n4. Improved the display of enemy health text.\n5. Added a cleanup mechanism for residual visual effects.\n\n[color=yellow]Fixes[\/color]\n1. Fixed an issue where the interface window didn't close when clicking the Demolish button.\n\nWe're currently putting full effort into developing the campaign dungeon gameplay.\n\nIf you enjoy this game, [color=yellow]we sincerely beg you to leave a positive Steam review[\/color]! It helps the game go further! Thank you so much!\n\n[h3][color=yellow]Solutions for Crashes or Being Unable to Enter the Game[\/color][\/h3]\n[list]\n[*] Crashes (mainly Win11 users): Right-click the game in your Steam library \u2192 \"Properties\" \u2192 select \"Game Versions & Betas\" \u2192 select \"win11stable\"\n[*] Can't enter (Win7 users only): Right-click the game in your Steam library \u2192 \"Properties\" \u2192 select \"Game Versions & Betas\" \u2192 select \"win7compat\"\n[*] Can't enter (NWjs error shown): Clean up your C drive to free up enough cache space. (The engine needs some virtual cache space.)\n[*] Stuck on the blue \"Enter Game\" button in Steam: Right-click the game in your Steam library, open the game installation directory, and \"Run as administrator\"\n[*] 50-series GPUs: Please disable AI frame generation in your GPU settings, set the GPU to high-performance mode, or try updating your graphics driver.\n[*] \"Failed to start the game's process\" error: This is caused by Win11's Smart App Control blocking it.\n     Disable it in Windows Security Center \u2192 App & Browser Control \u2192 Smart App Control settings.\n[\/list][color=lightblue]If problems persist, you can contact me via email or the QQ group for one-on-one support.[\/color]\n\n[h3][color=yellow]Xiao Mang Has a New Game to Warm Up Early![\/color][\/h3]\n[list]\n[*] To ride this wave of momentum and make sure we can keep going, we've put up the Steam store page for *Eternal Xiuzhen* ahead of time!\n[*] This game is a small \"incremental + hunting + cultivation\" title, leaning more toward incremental; idle elements may be added in the late game after clearing.\n[*] Don't worry \u2014 while I'm handling the design for this game, I'm not the one writing the code or doing the art.\n[*] Right now this game doesn't take up any of my workload, and I'll still be focusing on *Bandit Simulator TD*. At this stage, our programmer is doing the early groundwork.\n[*] We sincerely beg everyone to [color=yellow]Follow + Wishlist[\/color] to show your support! A playtest demo will be released later too!\n[\/list]\nhttps:\/\/store.steampowered.com\/app\/5339710\/_\/\n","commentcount":5,"tags":["mod_reviewed","ModAct_1896160435_1793669322_0"],"language":0,"hidden":0,"forum_topic_id":"569301797587658629","event_gid":"713416661425719995","voteupcount":10,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301797587658629","rtime32_last_modified":1793757440,"news_post_gid":"0","rtime_mod_reviewed":1793669323,"featured_app_tagid":0,"referenced_appids":[],"build_id":26370474,"build_branch":"","unlisted":0,"rtime_created":1793667758,"votes_up":9,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"685242695859515340","gidfeature2":"569301797587658629"},{"gid":"713416661425719471","clan_steamid":"103582791475457672","event_name":"Default Branch Update \u2014 Version 1.0.17.0","event_type":13,"appid":4267800,"server_address":null,"server_password":null,"rtime32_start_time":1793585880,"rtime32_end_time":1793590201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Backup Equipment Set Switch\",null,null,null,null,null,\"\u5168\u529b\u5728\u5236\u4f5c\u6218\u5f79\u526f\u672c\u7684\u73a9\u6cd5\u4e2d\",\"\u5168\u529b\u5728\u5236\u4f5c\u6218\u5f79\u526f\u672c\u7684\u73a9\u6cd5\u4e2d\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"14cbb2bf6540812ffd4d015fb0e0b5615fe9a447.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"0df1732d95779cbdcb9539a50fd0cdda46d718fe.png\",null,null,null,null,null,\"ae56cd9bff4216f35ac62b91b1fd497239a22a1c.png\",\"ae56cd9bff4216f35ac62b91b1fd497239a22a1c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"713416661425719285\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"713416661425719472","clanid":"45936264","posterid":"0","headline":"Default Branch Update \u2014 Version 1.0.17.0","posttime":1793585917,"updatetime":1793585917,"body":"[h3][color=lightblue]Default Branch[\/color] Update \u2014 Version 1.0.17.0[\/h3]\n\n[color=yellow]Improvements[\/color]\n1. Added a second equipment set switching feature. [color=yellow](Must be unlocked via technology.)[\/color]\n2. Changed the second affix of the UR treasure \"Lihuo Fanshi Seal\" to skill damage.\n\n[color=yellow]Fixes[\/color]\n1. Fixed an issue where Work level EXP bonuses from a duty didn't refresh after the character was removed from that post.\n2. Fixed incorrect text content.\n\nWe're currently putting full effort into developing the campaign dungeon gameplay.\n\n[h3][color=yellow]Solutions for Crashes or Being Unable to Enter the Game[\/color][\/h3]\n[list]\n[*] Crashes (mainly Win11 users): Right-click the game in your Steam library \u2192 \"Properties\" \u2192 select \"Game Versions & Betas\" \u2192 select \"win11stable\"\n[*] Can't enter (Win7 users only): Right-click the game in your Steam library \u2192 \"Properties\" \u2192 select \"Game Versions & Betas\" \u2192 select \"win7compat\"\n[*] Can't enter (NWjs error shown): Clean up your C drive to free up enough cache space. (The engine needs some virtual cache space.)\n[*] Stuck on the blue \"Enter Game\" button in Steam: Right-click the game in your Steam library, open the game installation directory, and \"Run as administrator\"\n[*] 50-series GPUs: Please disable AI frame generation in your GPU settings, set the GPU to high-performance mode, or try updating your graphics driver.\n[*] \"Failed to start the game's process\" error: This is caused by Win11's Smart App Control blocking it.\n     Disable it in Windows Security Center \u2192 App & Browser Control \u2192 Smart App Control settings.\n[\/list][color=lightblue]If problems persist, you can contact me via email or the QQ group for one-on-one support.[\/color]\n\n[h3][color=yellow]Xiao Mang Has a New Game to Warm Up Early![\/color][\/h3]\n[list]\n[*] To ride this wave of momentum and make sure we can keep going, we've put up the Steam store page for *Eternal Xiuzhen* ahead of time!\n[*] This game is a small \"incremental + hunting + cultivation\" title, leaning more toward incremental; idle elements may be added in the late game after clearing.\n[*] Don't worry \u2014 while I'm handling the design for this game, I'm not the one writing the code or doing the art.\n[*] Right now this game doesn't take up any of my workload, and I'll still be focusing on *Bandit Simulator TD*. At this stage, our programmer is doing the early groundwork.\n[*] We sincerely beg everyone to [color=yellow]Follow + Wishlist[\/color] to show your support! A playtest demo will be released later too!\n[\/list]\nhttps:\/\/store.steampowered.com\/app\/5339710\/_\/\n","commentcount":6,"tags":["mod_reviewed","ModAct_1896160435_1793586473_0"],"language":0,"hidden":0,"forum_topic_id":"569301797587570032","event_gid":"713416661425719471","voteupcount":18,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301797587570032","rtime32_last_modified":1793751668,"news_post_gid":"0","rtime_mod_reviewed":1793586473,"featured_app_tagid":0,"referenced_appids":[],"build_id":26338654,"build_branch":"","unlisted":0,"rtime_created":1793583112,"votes_up":18,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"685242695859515340","gidfeature2":"569301797587570032"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["713416661425719996","713416661425719472"],"last_update_event":{"rtime":1793667720,"event_gid":"713416661425719995","announcement_gid":"713416661425719996","clan_account_id":45936264}}};

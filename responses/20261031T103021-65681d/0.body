                <script>
			const hentryFooter = document.getElementsByClassName('hentry-footer')[0];
			let preloadedPost = null;
			const originalUrl = window.location.href;
            document.addEventListener('preloadSponsoredPost', (e) => {
				preloadedPost = e.detail;
			});
			
			function getRelativePath(url) {
			  try {
				const urlObj = new URL(url);
				return urlObj.pathname + urlObj.search + urlObj.hash;
			  } catch (e) {
				return url; // Fallback to original if URL parsing fails
			  }
			}
			
			function appendArticle(data) {
				if(!data){
				   return;
				   }
				const article = document.createElement('article');
				article.className = "post default-alt boosted";
				article.style.marginLeft = "auto";
				article.style.marginRight = "auto";
				article.style.marginTop = "50px";
				article.innerHTML = `
					<div class="post-inner">
					  <div class="thumbnail-wrapper"><figure><img width="850" src="${data.image || ''}"/></figure></div>
					  <div class="entry-header">
						<div class="entry-meta before-title">
							${data.categories && Array.isArray(data.categories) && data.categories.length > 0
							  ? `<span class="category-list"><i dir="ltr">in</i>&nbsp;${
								  data.categories.map((category, index) =>
									`<a href="/category/${category.slug || ''}/" class="cat-link-${category.term_id || ''}">${category.name || ''}${
									  index < data.categories.length - 1 ? ', ' : ''
									}</a>`
								  ).join('')
								}</span>`
							  : ''}
						</div>
						<h1 class="entry-title">${data.title || ''}</h1>
						<div class="entry-meta after-title">

							<ul class="after-title-meta"><li><i dir="ltr">by</i>&nbsp;${data.author || ''}</li><li class="entry-meta-date">${data.date || ''}</li></ul>
						</div>
					  </div>
					  <div class="entry-wrapper"><div class="single-content-wrapper"><div class="entry-content">${data.content || ''}</div></div></div>
					</div>
				  `;
				  hentryFooter.after(article); // Append after footer
				
				const adSlotId = 'div-gpt-ad-1752171790614-8'; // Unique ID for the ad slot
				const contentDiv = article.querySelector('.entry-content');
				const paragraphs = contentDiv ? contentDiv.querySelectorAll('p') : [];
				const thirdParagraph = paragraphs[2];
				const adDiv = document.createElement('div');
				adDiv.id = adSlotId;
				adDiv.style.width = '300px';
				adDiv.style.minHeight = '250px';
				adDiv.style.margin = '20px auto';
				adDiv.style.textAlign = 'center';
				thirdParagraph.after(adDiv);
				
				googletag.cmd.push(function() {
					let sizeMapping = googletag.sizeMapping().addSize([0, 0], [300, 250]).build();
				  let slot = googletag.defineSlot('/23308104037/flex_4', [300, 250], adSlotId)
					.defineSizeMapping(sizeMapping)
					.addService(googletag.pubads());
				  googletag.display(adSlotId); // Display the ad
				});
				
				if (typeof dataLayer !== 'undefined') {
				  const relativePath = getRelativePath(data.link);
				  const fullTitle = data.title + ' - GamesBeat';

				  dataLayer.push({
					event: 'virtual_page_view',   
					page_path: relativePath,
					page_title: fullTitle,
					injected: true,
				  });

				}
				
				// Set up observer for the injected article
				const postObserver = new IntersectionObserver((entries) => {
					const entry = entries[0];
					if (entry.intersectionRatio > 0) {
						history.replaceState(null, '', data.link);
					} 
					if(entry.intersectionRatio === 0) {
						history.replaceState(null, '', originalUrl);
					}
				});
				postObserver.observe(article);
			}
			
			// Set up IntersectionObserver once
			const observer = new IntersectionObserver((entries) => {
			  if (entries[0].isIntersecting) {
				appendArticle(preloadedPost);
				observer.disconnect(); // Stop observing after appending
			  }
			}, {
			  threshold: 1, // Trigger when any part of footer is visible
			  rootMargin: '0px' // Adjust if you want to trigger early
			});

			// Start observing
			observer.observe(hentryFooter);
        </script>

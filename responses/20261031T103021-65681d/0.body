 {background: none !important;
}
/* Change navigation menu font size */
.primary-menu a {
  font-size: 17px; /* Change this to your desired size */
  line-height: 1.4;
}

.sub-menu a {
  font-size: 20px; /* Change this to your desired size */
  line-height: 1.4;
}

body.category-134 .archive-header {
  background-color: #ee47fa;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

body.category-72 .archive-header {
  background-color: #fcae3c;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

body.category-73 .archive-header {
  background-color: #00dfe6;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

body.category-75 .archive-header {
  background-color: #fa3a7c;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

body.category-17724 .archive-header {
  background-color: #CBE813;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

body.category-40686 .archive-header {
  background-color: #14e4c8;  /* Replace with your desired color */
  color: #fff;  /* Optional: change text color inside */
}

.primary-nav-sidebar .sub-menu a {
  font-size: inherit; /* Change this to your preferred size */
}

.primary-menu .tfm-pill-menu a:hover {
  background-color: #ffffff !important;
  color: #000000 !important;
  text-decoration: none !important;
  box-shadow: none !important;
}

.subscriber-badge {
  background: #f1f3f4;
  color: #333;
  font-size: 0.8em;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 3px;
  margin-left: 6px;
}

.subscriber-notice {
  border: 1px solid #f1f3f4;
  background: #fff;
  padding: 15px;
  border-radius: 4px;
  margin-bottom: 20px;
  font-size: 0.95em;
}

.page-id-249401 .sb_youtube[id^="sb_youtube_"] .sby-header-type-text,
.page-id-1234.et-db #et-boc .sb_youtube[id^="sb_youtube_"] .sby-header-type-text {
  font-size: 20px;
}

@media (max-width: 400px) {
  .gb-max-box {
    font-size: 13.5px !important;
  }
}			
			
/* Disable sticky navbar behavior */
.remove-sticky header.site-header.sticky-nav,
.remove-sticky header.site-header.sticky-nav.fixed {
    position: static !important;
    z-index: auto !important;
}

header.site-header.sticky-nav,
header.site-header.sticky-nav.fixed {
    margin-top: 0 !important;
}

/* Prevent body adjustments */
body.has-sticky-nav,
body.has-sticky-nav.body-fix {
    margin-top: 0 !important;
}

/* Prevent wrapper padding changes */
body.custom-background .site-wrapper {
    padding-top: 0 !important;
}

/* Override inline styles added by JavaScript */
.remove-sticky header.site-header.sticky-nav[style*="position: fixed"],
.remove-sticky header.site-header.sticky-nav[style*="margin-top"] {
    position: static !important;
    margin-top: 0 !important;
}
header.site-header.sticky-nav[style*="position: fixed"],
header.site-header.sticky-nav[style*="margin-top"] {
    margin-top: 0 !important;
}
body.has-sticky-nav[style*="margin-top"] {
    margin-top: 0 !important;
}

/* Ensure branding remains visible */
.remove-sticky header.site-header.default.sticky-nav.fixed .header-branding,
.remove-sticky header.site-header.default-advert.sticky-nav.fixed .header-branding,
.remove-sticky header.site-header.default-logo-left.sticky-nav.fixed .header-branding {
    display: block !important; /* Or match your theme’s default display, e.g., flex or inline-block */
}

/* Ensure toggle background width isn’t reset */
.remove-sticky header.site-header:not(.logo-left-menu) .primary-menu-container .toggle.has-sticky-toggle-background {
    width: auto !important; /* Or match your theme’s default width */
}

.high-impact {
	top: 0;
  left: 0;
  z-index: 3000;
  width: 100%;
  height: 25vw;
  -webkit-animation: pulse 2s 1;
  -o-animation: pulse 2s 1;
  -ms-animation: pulse 2s 1;
  -moz-animation: pulse 2s 1;
  animation: pulse 2s 1;
}

@-webkit-keyframes pulse {
  0% { background-color: white; opacity: 0.1 }
  50% { background-color: white; opacity: 0.3 }
  100% { background-color: white; opacity: 0.1 }
}

@keyframes pulse {
  0% { background-color: white; opacity: 0.1 }
  50% { background-color: white; opacity: 0.3 }
  100% { background-color: white; opacity: 0.1 }
}

.high-impact iframe {
  width: 100%;
  height: 25vw;
}

.aside-sticky-container {
	position: static !important;
}

.medrec-exco {
	display: flex !important;
	justify-content: center !important;
	margin-bottom: 20px !important;
}

@media(max-width: 767px) {
	.backtotop {
		display: none !important;
	}
	.tfm-before-footer-advert div {
		margin-top: 0px !important;
		margin-bottom: 0px !important;
	}
	.tfm-before-footer-advert div iframe {
		margin: 0 auto !important;
	}
	.tfm-before-footer-advert {
		  padding-bottom: 0px !important;
		  display: block !important;
      position: fixed !important;
      bottom: -1px !important;
      left: 0 !important;
      width: 100% !important;
      z-index: 1000 !important;
      background-color: #fff !important;
      text-align: center !important;
	}
	body {
		padding-bottom: 50px !important;
	}
}

@media (max-width: 767px) {
	#gb-live-player iframe {
		width: 100% !important;
		max-width: 100% !important;
		height: 225px !important;
	}
	#div-gpt-ad-1752171790614-2,
	#div-gpt-ad-1752171790614-4 {
		width: 300px;
		margin: 0 auto;
	}
}

article.post.boosted .wp-block-video,
article.post.boosted .wp-block-video video {
  max-width: 100% !important;
  width: 100% !important;
  height: auto !important;
}

#div-gpt-ad-1752171790614-7 iframe {
	margin: 0 auto;
}

/* === POST LABELS STYLING === */
.post-labels {
    margin-bottom: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

/* Individual label pills */
.post-labels .post-label {
    display: inline-block;
    padding: 6px 14px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    border-radius: 9999px;     /* pill shape */
    background-color: #f0f0f0;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
}
.home .post-labels .post-label {
    background-color: #e5e7eb;     
}
/* Make it look good on mobile */
@media (max-width: 768px) {
    .post-labels {
        margin-bottom: 10px;
        gap: 6px;
    }
    .post-labels .post-label {
        padding: 5px 12px;
        font-size: 14px;
    }
}

.wp-block-query .wp-block-post {
	display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    overflow: hidden;
    background: #fff;
}

.page-id-326391 .wrap {
	background-color: #f7f7f7;
}
</style>
</head>


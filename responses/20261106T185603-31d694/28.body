":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/37daf2e0888120a1be5e2d9dedcf2a1655068f2f\/ss_37daf2e0888120a1be5e2d9dedcf2a1655068f2f.600x338.jpg?t=1792124765","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/37daf2e0888120a1be5e2d9dedcf2a1655068f2f\/ss_37daf2e0888120a1be5e2d9dedcf2a1655068f2f.1920x1080.jpg?t=1792124765"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/320a87b3ccc87fda710ac468f7d01ce66a6024c5\/ss_320a87b3ccc87fda710ac468f7d01ce66a6024c5.600x338.jpg?t=1792124765","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/320a87b3ccc87fda710ac468f7d01ce66a6024c5\/ss_320a87b3ccc87fda710ac468f7d01ce66a6024c5.1920x1080.jpg?t=1792124765"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/fb638a5b588f1562b546d90c17308fb83fd1d561\/ss_fb638a5b588f1562b546d90c17308fb83fd1d561.600x338.jpg?t=1792124765","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/fb638a5b588f1562b546d90c17308fb83fd1d561\/ss_fb638a5b588f1562b546d90c17308fb83fd1d561.1920x1080.jpg?t=1792124765"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/0e90cf32a3b5c5a55541622dcb6f20edbb479890\/ss_0e90cf32a3b5c5a55541622dcb6f20edbb479890.600x338.jpg?t=1792124765","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/0e90cf32a3b5c5a55541622dcb6f20edbb479890\/ss_0e90cf32a3b5c5a55541622dcb6f20edbb479890.1920x1080.jpg?t=1792124765"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5130480\/b214e6574179c40a34bd8a5095f0d8e0a1751704\/ss_b214e6574179c40a34bd8a5095f0d8e0a1751704.600x338.jpg?t=1792124765","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/app
							var StoreDefaults = {"PartnerEventStore":[{"gid":"679640301799735961","clan_steamid":"103582791475571899","event_name":"WAF27 - Update 4","event_type":13,"appid":4328570,"server_address":null,"server_password":null,"rtime32_start_time":1793803860,"rtime32_end_time":1793808001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"d8b1b03f75483e2236adf01883535a3c6348202e.png\",\"d8b1b03f75483e2236adf01883535a3c6348202e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7cd46ade8d5348486910dd110e9ddeb270a4084c.png\",\"7cd46ade8d5348486910dd110e9ddeb270a4084c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679640301799735962","clanid":"46050491","posterid":"0","headline":"WAF27 - Update 4","posttime":1793803869,"updatetime":1793803869,"body":"[p][b]Release[\/b][\/p][p]4 November 2026, 16:00 CET[\/p][p]Update 4 is available! Here are the details.[\/p][p]Saved games can be continued.[\/p][p][b]Improvements[\/b][\/p][list][*][p]Creative mode options can be set directly at game start (exception: Actions, which you can easily do later), including Save and Reset buttons[\/p][\/*][*][p]Option to earn achievements also in Creative mode[\/p][\/*][*][p]Improved manager career: Offers from better clubs now require progressively higher manager levels; the search for jobs begins in your own\/most recent country and then expands to neighboring countries, with the search radius widening only later[\/p][\/*][*][p]Club creation: The club grounds can now be redesigned from scratch during the game\u2019s startup if desired (with a budget based on the selected difficulty level)[\/p][\/*][*][p]Club Grounds: Improved controls in the 2D view (left-click to drag); the view can also be moved on the minimap; new option to deselect the current building or object by clicking it again[\/p][\/*][*][p]New stats screen: Team captains and their assistants[\/p][\/*][*][p]Adding events from other event DBs by importing them in the editor is now possible (duplicates must be deleted later)[\/p][\/*][*][p]Option to copy editor events to create more variation[\/p][\/*][*][p]Editor: Improved player generation with preset nationality and age[\/p][\/*][*][p]Editor: Option to specify an Actual level to one decimal place when generating players; the skills are generated accordingly (the position is taken into account)[\/p][\/*][*][p]Editor: New tab for badges and shirts to allow switching between clubs more easily[\/p][\/*][*][p]Editor: New club and country overviews for spotting DB problems more easily[\/p][\/*][*][p]Editor: Improved names editor directly with country and region[\/p][\/*][*][p]Editor: City text displayed in the city editor[\/p][\/*][*][p]Additional languages: Spanish and Portuguese[\/p][\/*][*][p]Steam Workshop: User language files are now specifically supported[\/p][\/*][\/list][p][b]Fixes[\/b][\/p][list][*][p]1-budget-problem was not solved in Update 3, now it should work[\/p][\/*][*][p]Player status is updated correctly after transfers (e.g. Happiness)[\/p][\/*][*][p]Fix: Injured players do not count as bench players[\/p][\/*][*][p]Fix: Table calculation during the matchday[\/p][\/*][*][p]Fix: Correct match reports in case of more than one friendly[\/p][\/*][*][p]Fix: Player negotiations are now possible even beyond the season[\/p][\/*][*][p]Fix: Dual negotiations for youth players are now prevented[\/p][\/*][*][p]Fix: Incorrect display of budget impact\/increase when making purchases for the second team[\/p][\/*][*][p]Fix: Automatic effort changes improved[\/p][\/*][*][p]Fix: Player nationalities on the ongoing negotiations screen are now displayed correctly[\/p][\/*][*][p]Fix: Assistant manager continues to do substitutions after tactical changes of the user[\/p][\/*][*][p]Fix: You can now negotiate with players listed for loan directly from the squad screen by selecting them[\/p][\/*][*][p]Fix: Wrong squad display when moving to a new club during the week as a manager[\/p][\/*][*][p]Fix: Start of the season promise to focus on defending initially now has a positive effect (+3 instead of -3 for the board).[\/p][\/*][*][p]Fix: Events for unhealthy eating are back to their previous frequency[\/p][\/*][*][p]Fix: Austria achievement due to split season[\/p][\/*][*][p]Tuning: Assistant coach plays with less intensity when the team is tired[\/p][\/*][*][p]Tuning: Slowed development of youth players in the lower leagues so they don\u2019t become too good in the long run[\/p][\/*][*][p]Tuning: Deadline Day now takes neighboring country rules into account (so that players, for example, don\u2019t transfer from other continents to lower leagues)[\/p][\/*][\/list]","commentcount":7,"tags":["mod_reviewed","ModAct_1894963720_1793807098_0"],"language":0,"hidden":0,"forum_topic_id":"571553910742904946","event_gid":"679640301799735961","voteupcount":89,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553910742904946","rtime32_last_modified":1793956493,"news_post_gid":"0","rtime_mod_reviewed":1793807098,"featured_app_tagid":0,"referenced_appids":[],"build_id":26380393,"build_branch":"nightly","unlisted":0,"rtime_created":1793803510,"votes_up":89,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"565911724530641736","gidfeature2":"571553910742904946"},{"gid":"670630562731396395","clan_steamid":"103582791475571899","event_name":"WAF27 - Update 3","event_type":14,"appid":4328570,"server_address":null,"server_password":null,"rtime32_start_time":1791985620,"rtime32_end_time":1791990001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"d8b1b03f75483e2236adf01883535a3c6348202e.png\",\"d8b1b03f75483e2236adf01883535a3c6348202e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"7cd46ade8d5348486910dd110e9ddeb270a4084c.png\",\"7cd46ade8d5348486910dd110e9ddeb270a4084c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"670630562731396396","clanid":"46050491","posterid":"0","headline":"WAF27 - Update 3","posttime":1791985627,"updatetime":1791985627,"body":"[p][b]Release[\/b][\/p][p]14 October 2026, 16:00 CET[\/p][p]Update 3 is available![\/p][p]Here are the details.[\/p][p][b]Improvements[\/b][\/p][list][*][p]New language selection screen[\/p][\/*][*][p]Additional official language: Italian[\/p][\/*][*][p]Additional Austrian language version with typical Austrian football terms[\/p][\/*][*][p]30 languages will be directly supported if the game finds fan language files, e.g. Spanish, Portuguese or Turkish (it is also possible to select your own variations of the official languages)[\/p][\/*][*][p]During negotiations, players might now also increase the fixed transfer fees before waiving them entirely (players typically deduct 5\u20137 per cent from your offer during the valuation process if they you do not accept the fees)[\/p][\/*][*][p]Added \u201cSquad\u201d button during player and club negotiations[\/p][\/*][*][p]If you click on an advertising partner in the perimeter advertising, the bonuses and deductions are now also displayed next to the sponsor logo[\/p][\/*][*][p]Long-term player type goals are now also saved when character changes are planned[\/p][\/*][*][p]The board screen now shows the required popularity for a contract extension[\/p][\/*][*][p]Update for matchdays and domestic cup in Scotland[\/p][\/*][*][p]When playing in Creative Mode with one or two budgets, you'll receive 20% or 10% (respectively) of the set amount directly when you give money to your own club (this also works for the AI clubs)[\/p][\/*][*][p]Tactics: An additional 13 default settings for wing play can be selected via a combo box[\/p][\/*][*][p]Creative mode: New option for setting the probability of your own events from the editor (0.5\u201320)[\/p][\/*][*][p]Added tooltip and color coding for expiring contracts in the team screen[\/p][\/*][*][p]After each matchday, incredibly exciting games and surprising results will now be marked with special icons[\/p][\/*][*][p]Club creation: A short motto, mascot and president can now be set at game start[\/p][\/*][*][p]Editor events: Greater freedom when setting effects, usually at least doubled; allows for more interesting events[\/p][\/*][*][p]Editor: Improved translation screen for own events[\/p][\/*][*][p]All editor events also available in French and Italian[\/p][\/*][\/list][p][b]Fixes[\/b][\/p][list][*][p]Correct display of the \u201cGoals last matchday\u201d in the newspaper[\/p][\/*][*][p]Character changes are now also possible for the reserve team and for youth players (previously, these were regularly reset)[\/p][\/*][*][p]Improved language selection for the manager at game start[\/p][\/*][*][p]Best players at the youth camps are now displayed correctly[\/p][\/*][*][p]Table screen allows switching between the leagues again[\/p][\/*][*][p]Check for remaining German text in international versions[\/p][\/*][*][p]Tuning: Extension of sponsorship contracts in conjunction with promotion bonuses[\/p][\/*][*][p]Fix: Training plans are corrrectly saved also at the beginning of the week[\/p][\/*][*][p]Fix: International finals stadiums can now be edited correctly in the editor[\/p][\/*][*][p]Tuning: 50% fewer injuries during training at the \u201cEasy\u201d difficulty level and 10% fewer at \u201cNormal\u201d[\/p][\/*][*][p]Fix: Improved text and more descriptive training icons for corners[\/p][\/*][*][p]Fix: KI goalkeeper now leaves the pitch correctly after a sent-off[\/p][\/*][*][p]Fix: Skill tree of youth players from other clubs no longer available[\/p][\/*][*][p]Fix: Away goal rule for play-offs does no longer apply (only for new save games)[\/p][\/*][*][p]Fix: Match report, yellow card warning does no longer trigger too late[\/p][\/*][*][p]Fix: Home team rule domestic cup[\/p][\/*][*][p]Fix: Offering players is no longer possible, if the player already negotiates with another club[\/p][\/*][*][p]Fix: Goalkepper is unhappy with his playing time but was injured[\/p][\/*][*][p]Fixed: \u201cNo Budget\u201d mode; account balance is now updated daily for expenses[\/p][\/*][*][p]Scouting now also works on the \u201cOngoing negotiations\u201d screen (talent is no longer displayed if not known)[\/p][\/*][*][p]Fix: Match report: Wrong comment on no substitutions at half-time[\/p][\/*][*][p]Fix: Wrong display of next season\u2019s transfer budget on the home screen during the 2nd leg (e.g. after using an option to buy a player)[\/p][\/*][*][p]Fix: Loan deals from foreign countries to lower league clubs are now more difficult[\/p][\/*][*][p]Fix: In the standard formations, players are now positioned optimally, meaning that automatic downgrading no longer occurs[\/p][\/*][*][p]Fix: Text problem with Cam carpets[\/p][\/*][*][p]Fix: Correct abbreviation for the minutes on \u201cPlayers-Season\u201d[\/p][\/*][*][p]Fix: Correct display of cam carpets in the stadium[\/p][\/*][*][p]Fix: Negative skills when recreating a player\u2019s skill tree[\/p][\/*][*][p]Tuning: Player offers on Deadline Day[\/p][\/*][*][p]The \u201cOngoing negotiations\u201d screen can now be closed using the ESC key[\/p][\/*][*][p]Fix: Youth players make their decisions by 30 June[\/p][\/*][*][p]Fix: Youth player pre-selection for contract negotiations[\/p][\/*][*][p]Fix: Crash when there is no \u2018Goal of the matchday\u2019[\/p][\/*][*][p]Fix: Better screen update after switching between 1 and 2 budgets[\/p][\/*][*][p]Fix: Fan allocation in the stadium blocks is now correct again[\/p][\/*][\/list]","commentcount":23,"tags":["mod_reviewed","ModAct_1894963720_1791987409_0"],"language":0,"hidden":0,"forum_topic_id":"572677904481171979","event_gid":"670630562731396395","voteupcount":176,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572677904481171979","rtime32_last_modified":1793862256,"news_post_gid":"0","rtime_mod_reviewed":1791987409,"featured_app_tagid":0,"referenced_appids":[],"build_id":25934351,"build_branch":"","unlisted":0,"rtime_created":1791888468,"votes_up":176,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"565911724530641736","gidfeature2":"572677904481171979"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["679640301799735962","670630562731396396"],"last_update_event":{"rtime":1793803860,"event_gid":"679640301799735961","announcement_gid":"679640301799735962","clan_account_id":46050491}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><strong>WE ARE FOOTBALL 2027</strong> puts you in the hot seat of the beautiful game - fast, deep, and absolutely uncompromising.</p><p class="bb_paragraph" >Build a club, reshape a dynasty, or watch your favourite team rise (or fall) in spectator mode. Every decision counts, every week matters, and every save file becomes its own football universe.</p><p class="bb_paragraph" >With <strong>200+ playable countries</strong>, expanded leagues, and a huge range of international competitions, the world of football has never felt this big. And because everything is fully configurable, you decide how complex, how fast, and how wild your career becomes - right down to the number of simulated league tiers in each nation.</p><p class="bb_paragraph" >The all‑new <strong>Creative Mode</strong> gives you full control over your football universe. Rewrite rules, rebuild systems, push boundaries, and unleash direct actions — like jumping to any club in the world with a single click — to shape the game on your terms.</p><p class="bb_paragraph" ><strong>Tactical depth</strong> has taken a leap forward: clearer effects, visible attribute requirements in match scenes, and <strong>multi‑stage negotiations</strong> where rival clubs can swoop in at any moment. Every transfer feels alive, every decision has weight.</p><p class="bb_paragraph" ><strong>Regional cups</strong> add a fresh layer of progression. Start in your local district, fight your way into regional glory, and earn your ticket to the national stage. Perfect for career climbers and club creators who love a long road to the top.</p><p class="bb_paragraph" >The series’ trademark strengths shine brighter than ever: smooth controls, fast week-to-week flow, and full support for community expansions. And as always, <strong>every single match in the entire world is simulated identically and can be watched in 3D</strong>, no shortcuts, no exceptions.</p><p class="bb_paragraph" >A <strong>powerful external editor</strong> is included, letting you build league systems, cups, clubs, stadiums, players, managers, staff, referees, sponsors, fan chants, derbies, and more. In‑game editors let you adjust details on the fly, from player names to club data.</p><p class="bb_paragraph" >Step into the dugout, shape your legacy, and write the next great football story with <strong>WE ARE FOOTBALL 2027</strong>.</p><h2 class="bb_tag" ><strong>Features</strong></h2><p class="bb_paragraph" ><strong>User interface and technical improvements:</strong></p><p class="bb_paragraph" >·         Clear, streamlined menu navigation</p><p class="bb_paragraph" >·         Wing menus with freely configurable statistics</p><p class="bb_paragraph" >·         Full 21:9 monitor support</p><p class="bb_paragraph" >·         In‑game editor for club, staff and player data during ongoing saves</p><p class="bb_paragraph" >·         Significantly accelerated weekly schedule</p><p class="bb_paragraph" >·         Over 12,000 generic AI‑generated player portraits plus ageing youth players for added realism</p><p class="bb_paragraph" >·         Hotseat multiplayer for up to 4 players</p><p class="bb_paragraph" ><strong>Game content:</strong></p><p class="bb_paragraph" >·         Three game modes: Free Club Selection, Club Creation and Career Mode (now with optional regional start)</p><p class="bb_paragraph" >·         Spectator mode, in which you can follow the results of a club and/or national team</p><p class="bb_paragraph" >·         Individual skill development trees to shape your own and your players’ careers</p><p class="bb_paragraph" >·         Influence player personalities to develop leaders, team players and more</p><p class="bb_paragraph" >·         Extensive manager responsibilities (finances, sponsors, HR, organisation, fan relations, membership)</p><p class="bb_paragraph" >·         Friendlies against your reserve team can be set up</p><p class="bb_paragraph" >·         Creation of your own tournaments and international tours</p><p class="bb_paragraph" >·         Deep tactical options including playing styles, formations and detailed instructions</p><p class="bb_paragraph" >·         Modern training schedules and long‑term development plans with training groups</p><p class="bb_paragraph" >·         Team chemistry with player relationships and hierarchy levels</p><p class="bb_paragraph" >·         Improved squad analysis including age structure and skill overviews</p><p class="bb_paragraph" >·         Clear display of each player’s expected playing time</p><p class="bb_paragraph" >·         Expanded club profile “Season – Players” with around 40 statistical categories for all clubs</p><p class="bb_paragraph" >·         Expanded player profile including personal titles and awards</p><p class="bb_paragraph" >·         All goals from all ongoing matches in the game world can be viewed retrospectively</p><p class="bb_paragraph" >·         Extensive youth academy features: trial days, recruitment campaigns, youth boarding schools and expandable international youth centres for early talent discovery</p><p class="bb_paragraph" >·         Multi‑stage negotiations with detailed contract parameters over days or weeks, including reflection time and competing offers</p><p class="bb_paragraph" >·         Buy-back of exit clauses</p><p class="bb_paragraph" >·         Stadium editor with seating/standing areas, VIP boxes, video ring, additional ad boards, stand texts and logos, stadium‑wide seating patterns, optional running track, selectable pitch patterns and more</p><p class="bb_paragraph" >·         3D club grounds with numerous buildings and design options</p><p class="bb_paragraph" >·         Optional simulation of your personal life as a manager, including family and children who may become footballers or department heads in your club</p><p class="bb_paragraph" >·         Dozens of new convenience features, e.g. for bench management and transfer lists, plus direct actions for players from other clubs via their profile</p><p class="bb_paragraph" > </p><p class="bb_paragraph" ><strong>National teams:</strong></p><p class="bb_paragraph" >·         Separate European Championship and World Cup modes for men and women</p><p class="bb_paragraph" >·         Option to manage a national team right from the start or accept offers for national teams during your career</p><p class="bb_paragraph" ><strong>Match engine:</strong></p><p class="bb_paragraph" >·         3D match display with 9 cameras, slow motion, replays, live score changes, display of currently relevant skills and optional info boxes within scenes</p><p class="bb_paragraph" >·         More varied match action</p><p class="bb_paragraph" >·         New fan banners and sponsors for the perimeter advertising</p><p class="bb_paragraph" >·         Clear visualisation of your tactical instructions on the pitch</p><p class="bb_paragraph" >·         New line‑up analysis showing current strengths and weaknesses</p><p class="bb_paragraph" >·         Choice between short or long 3D scenes or an alternative quick calculation</p><p class="bb_paragraph" >·         In‑match commands to guide your players in key decision moments</p><p class="bb_paragraph" > </p><p class="bb_paragraph" ><strong>Editor and database:</strong></p><p class="bb_paragraph" >·         Two databases for men’s football: Standard (Europe‑focused) and World (200+ countries)</p><p class="bb_paragraph" >·         Point deductions for the first season can be configured</p><p class="bb_paragraph" >·         The colour of the shirt number can be customised</p><p class="bb_paragraph" >·         Youth players can now optionally be assigned a specific year of birth</p><p class="bb_paragraph" >·         Two European competitions for women’s football</p><p class="bb_paragraph" >·         Fully editable league systems with promotion/relegation rules, playoffs, and national and local cups across multiple tiers</p><p class="bb_paragraph" >·         Additional international club competitions (now available in the world database for all continents except Antarctica)</p><p class="bb_paragraph" >·         Editor for separate U21/U23 leagues (e.g. England)</p><p class="bb_paragraph" >·         Extensive editors for logos and kits with support for custom graphics</p><p class="bb_paragraph" >·         Automatic conversion of existing WAF databases</p>						</div>
					</div>
					<div class="game_page_autocollapse">
		<div id="game_area_content_descriptors" class="game_area_description">
			<h2>AI Generated Content Disclosure</h2>
			<p>The developers describe how their game uses AI Generated Content like this:</p>
			<p><i>
					In WE ARE FOOTBALL 2027 we use about 12,500 AI-generated realistic-looking photos for generic male and female players. These pictures are e.g. displayed on the line-up screen or on the player profile screens. Only photographs of persons photographed specifically for this purpose were used.				</i>
			</p>
					</div>
	</div>
	
				
				

,"path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/e9aa4942c1e0822785f6dad48e2bdab7a4adc4b6.jpg"},{"icon":"035a1596eb7dc4862cbc5a77ebbe44843ee2ac7c.jpg","localized_name":"Pocket Luck","archived":0,"hidden":0,"name":"Pocket Luck","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/035a1596eb7dc4862cbc5a77ebbe44843ee2ac7c.jpg"},{"icon":"20eff0971ae366aa06275021e30e445ce958551a.jpg","localized_name":"Signed in Ink","archived":0,"hidden":0,"name":"Signed in Ink","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/20eff0971ae366aa06275021e30e445ce958551a.jpg"},{"icon":"cc3110f53e8011ca3fbff3a5bb856646e99ebc3d.jpg","localized_name":"Mispriced","archived":0,"hidden":0,"name":"Mispriced","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/cc3110f53e8011ca3fbff3a5bb856646e99ebc3d.jpg"},{"icon":"ee3f79896a5de76fccf553175eba6dd51597af3b.jpg","localized_name":"Against the Board","archived":0,"hidden":0,"name":"Against the Board","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/ee3f79896a5de76fccf553175eba6dd51597af3b.jpg"},{"icon":"0fae6c12e4fbc80258aab1147d04e29576e96735.jpg","localized_name":"Three Green Stamps","archived":0,"hidden":0,"name":"Three Green Stamps","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/0fae6c12e4fbc80258aab1147d04e29576e96735.jpg"},{"icon":"6b20ab0f5fda01f8c81c6b5ee7f75b2d3e7a06be.jpg","localized_name":"Covered Both Ways","archived":0,"hidden":0,"name":"Covered Both Ways","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/5000320\/6b20ab0f5fda01f8c81c6b5ee7f75b2d3e7a06be.jpg"},{"icon":"e89a69461596e2de1e0f146912f1eae3f2a13888.jpg","localized_name":"House Broken","archived":0,"hidden":0,"name":"House Broken","path":"https:\/\/shared.akamai.steamstatic.com\/community_assets\/images\/apps\/50
		Responsive_ReparentItemsInResponsiveMode( '.responsive_apppage_reviewblock', $J('#responsive_apppage_reviewblock_ctn') );

		//hack to workaround chrome bug
		$J('#responsive_apppage_reviewblock_ctn' ).css('width', '100%' );

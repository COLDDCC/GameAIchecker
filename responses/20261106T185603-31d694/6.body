269154d2ab3.png\"][\/img][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46244448\/f73301c4484b8162c1156b7e3202a8911ca70e90.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/46244448\/8f9c89b3fe21f987ea2c6ff0f3e5299ea806d7b4.png\"][\/img][\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1866137740_1793186687_0"],"language":0,"hidden":0,"forum_topic_id":"569301473354115177","event_gid":"710038961706238311","voteupcount":9,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793185560,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301473354115177","rtime32_last_modified":1793696726,"news_post_gid":"0","rtime_mod_reviewed":1793186687,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793185332,"votes_up":9,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"589561964325396078","gidfeature2":"569301473354115177"},{"gid":"694274460775089884","clan_steamid":"103582791475765856","event_name":"JIAHAO \u2013 National Day Update: Jiaxin & Dialect Voice Packs Are Here!","event_type":14,"appid":5001630,"server_address":null,"server_password":null,"rtime32_start_time":1791470220,"rtime32_end_time":1791475201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"b5acc1934eaabb3e0941e7562c79b1cc56af487a.png\",null,null,null,null,null,\"b5acc1934eaabb3e0941e7562c79b1cc56af487a.png\",\"b5acc1934eaabb3e0941e7562c79b1cc56af487a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6e0b3249e29d114a40a4ac3de8efe6bb19d0f511.png\",null,null,null,null,null,\"6e0b3249e29d114a40a4ac3de8efe6bb19d0f511.png\",\"6e0b3249e29d114a40a4ac3de8efe6bb19d0f511.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694274460775089885","clanid":"46244448","posterid":"0","headline":"JIAHAO \u2013 National Day Update: Jiaxin & Dialect Voice Packs Are Here!","posttime":1791470227,"updatetime":1791470227,"body":"[h2]What's New[\/h2][list][*][p][b]Jiaxin is finally here![\/b] You can now play as Jiaxin, and her character art will appear in both Baihao Pavilion and Jiahao's Copying Service when she's selected.[\/p][\/*][*][p][b]New Regional Dialect Voice Packs![\/b][\/p][list][*][p][b]Jiahao[\/b][\/p][list][*][p]Tianjin Dialect[\/p][\/*][*][p]Hokkien (Southern Min)[\/p][\/*][*][p]Beijing Dialect[\/p][\/*][*][p]Nanjing Dialect[\/p][\/*][*][p]Shaanxi Dialect[\/p][\/*][*][p]Sichuanese[\/p][\/*][\/list][\/*][*][p][b]Jiaxin[\/b][\/p][list][*][p]Shanghainese[\/p][\/*][*][p]Sichuanese[\/p][\/*][\/list][\/*][\/list][\/*][*][p]Various smaller additions and improvements.[\/p][\/*][\/list][h2]Bug Fixes & Stability[\/h2][list][*][p]Various bug fixes and stability improvements.[\/p][\/*][\/list][hr][\/hr][p]First of all, we're really sorry that Jiaxin's update ended up being delayed by almost a week![\/p][p]We ran into some pretty serious issues during the National Day holiday, and we've been working hard to get everything fixed. Thankfully, we're finally able to roll out the update today![\/p][p]Meanwhile, we're also hard at work on exciting new content, including [b]multiplayer stock trading, HOHO board and card games[\/b], and more![\/p][p]As always, we'd love to hear your feedback and ideas! If you have any suggestions, or if you run into trouble while creating mods, feel free to join our [b]JIAHAO Steam Community QQ Group (1124480277)[\/b].[\/p][p]Let's keep making JIAHAO better together![\/p][p]Thanks so much for your patience and support! \u2764\ufe0f[\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1847323374_1791474460_0"],"language":0,"hidden":0,"forum_topic_id":"582810370004133972","event_gid":"694274460775089884","voteupcount":33,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"582810370004133972","rtime32_last_modified":1793610722,"news_post_gid":"0","rtime_mod_reviewed":1791474460,"featured_app_tagid":0,"referenced_appids":[],"build_id":25805295,"build_branch":"","unlisted":0,"rtime_created":1791469807,"votes_up":33,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"589561964325396078","gidfeature2":"582810370004133972"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["710038961706238312","694274460775089885"],"last_update_event":{"rtime":1791470220,"event_gid":"694274460775089884","announcement_gid":"694274460775089885","clan_account_id":46244448}}};

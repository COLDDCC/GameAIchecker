alse,"useWixMediaCanvas":false},"hasAudio":true,"isTransparent":false},"comp-m1a58vvl":{"fillLayers":{"containerId":"comp-m1a58vvl","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":false,"video":{"isVideoEnabled":true,"preload":"auto","controls":"none","loop":true,"muted":false,"posterImageInfo":{"width":3840,"height":2160,"uri":"9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657f000.jpg","containerId":"comp-m1a58vvl","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","filterEffectSvgString":"","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"containerWidth":160,"containerHeight":90,"type":"Image","title":"PV_Final_ENG.mp4"},"videoInfo":{"fittingType":"fill","alignType":"center","hasBgScrollEffect":"","bgEffectName":"","videoId":"9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657","videoWidth":3840,"videoHeight":2160,"qualities":[{"width":640,"height":360,"quality":"360p","url":"video\/9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657\/360p\/mp4\/file.mp4","size":230400},{"width":854,"height":480,"quality":"480p","url":"video\/9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657\/480p\/mp4\/file.mp4","size":409920},{"width":1280,"height":720,"quality":"720p","url":"video\/9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657\/720p\/mp4\/file.mp4","size":921600},{"width":1920,"height":1080,"quality":"1080p","url":"video\/9355b9_e02ad0b2cbbe4da6a70ccaa1cab58657\/1080p\/mp4\/file.mp4","size":2073600}],"isVideoDataExists":"1","videoFormat":"mp4","playbackRate":1,"autoPlay":false,"containerId":"comp-m1a58vvl","animatePoster":"none","hasAlpha":false},"alt":"Jellyfish"},"shouldPadMedia":false,"hasCanvasAnimation":false,"useWixMediaCanvas":false},"hasAudio":true,"isTransparent":false},"comp-lhdabqfs2":{"html":"<p class=\"font_8 wixui-rich-text__text\">You are a condemned Synthetic marked for destruction.<br>Combine weapons, chips, and augments to forge your own path through endless resets.<br>Slay mechanical creatures — and rip the truth out of this cyber-mythic city.<br><br>MASTER THE RHYTHM OF COMBAT<br>Combat in ReBlade is built around timing and control.<br>Balance offense and defense, read enemy behavior, and strike at the right moment to seize the advantage.<br><br><br>SHAPE YOUR BUILD, BREAK PAST LIMITS<br>Each run lets you refine how you fight.<br>Combine weapons, chips, and augments to shape your build, adapt to new challenges, and push further with every cycle.<br><br><br>ENCOUNTER BEASTS, SURVIVE THE TRIALS<br>Ancient creatures, twisted and reinforced by machinery, stand in your way.<br>Study their patterns, break their defenses, and carve a bloody path to victory.<br><br><br>DEFY YOUR FATE<br>Bound to an endless cycle of destruction, you are forced to repeat, learn, and resist.<br>Meet allies, trade the resources you uncover, and piece together the hidden truth of this world.<\/p>"},"comp-li1c5oii2":{"html":"<p class=\"font_8 wixui-rich-text__text\">You are a condemned Synthetic, marked for destruction and trapped in endless resets. In a cyberpunk world inspired by Chinese mythology, harness weapons, chips, and augments to cut through mechanical creatures. Each run brings you closer to breaking the cycle and unravelling the truth.<\/p>"},"comp-li1c5mi5":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">ReBlade: The Death Spiral<\/span><\/h2>"},"comp-li1fi9re":{"defaultSrc":"wix:image:\/\/v1\/9355b9_a1e8b80ce26b494d8601912f921baa21~mv2.jpg\/%E8%9D%BC%E8%9A%81%E4%B9%8B%E5%9F%8E.jpg#originWidth=1907&originHeight=1907","imageInfo":{"containerId":"comp-li1fi9re","alignType":"center","parallaxSpeed":1.5,"sourceSets":[],"imageData":{"uri":"9355b9_a1e8b80ce26b494d8601912f921baa21~mv2.jpg","width":1907,"height":1907,"alt":"","focalPoint":null,"name":"蝼蚁之城.jpg","crop":null},"encoding":"AVIF","allowFullGIFTransformation":false},"aspectRatio":1,"shouldUseResponsiveImages":false}}],"ssrStyleUpdates":[],"ssrStructureUpdates":[]},"pages":{"compIdToTypeMap":{"masterPage":"MasterPage","BACKGROUND_GROUP":"B
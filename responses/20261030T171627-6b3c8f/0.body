r-content" role="list" class="comp-lhdabqfw4-container"><!--$--><div id="comp-lhdabqfz__item1" role="listitem" class="HFEOE3 NaeT1r comp-lhdabqfz-container comp-lhdabqfz comp-lhdabqfz__item1 wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div></div><!--/$--><!--$--><div id="comp-lhdabqfz__item-j9ples3e" role="listitem" class="HFEOE3 NaeT1r comp-lhdabqfz-container comp-lhdabqfz comp-lhdabqfz__item-j9ples3e wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div></div><!--/$--><!--$--><div id="comp-lhdabqfz__item-j9plerjk" role="listitem" class="HFEOE3 NaeT1r comp-lhdabqfz-container comp-lhdabqfz comp-lhdabqfz__item-j9plerjk wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div></div><!--/$--><!--$--><div id="comp-lhdabqfz__item-l8r33gok" role="listitem" class="HFEOE3 NaeT1r comp-lhdabqfz-container comp-lhdabqfz comp-lhdabqfz__item-l8r33gok wixui-repeater__item" dir="ltr"><div aria-hidden="true" class="jdJeEr NYfD3h inner-box wixui-repeater__item"></div></div><!--/$--></div></div><!--/$--></div><!--/$--></div><!--/$--></div></section><!--/$--><!--$--><section id="comp-li1c24mw" tabindex="-1" data-block-level-container="Section" class="ke5pl1 comp-li1c24mw-container comp-li1c24mw wixui-section undefined fwXYgt" data-testid="section-container"><div id="bgLayers_comp-li1c24mw" data-hook="bgLayers" data-motion-part="BG_LAYER comp-li1c24mw" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-li1c24mw" data-motion-part="BG_MEDIA comp-li1c24mw" class="ROWgFb"></div></div><!--$--><div id="comp-li1fi9re" data-testid="imageX" class="i4P7Vt comp-li1fi9re wixui-image"><div class="YX2qkL" data-motion-part="BG_LAYER comp-li1fi9re"><div data-motion-part="BG_MEDIA comp-li1fi9re"><wow-image id="img-comp-li1fi9re" data-is-responsive="true" data-image-info="{&quot;containerId&quot;:&quot;comp-li1fi9re&quot;,&quot;alignType&quot;:&quot;center&quot;,&quot;parallaxSpeed&quot;:1.5,&quot;sourceSets&quot;:[],&quot;imageData&quot;:{&quot;uri&quot;:&quot;9355b9_a1e8b80ce26b494d8601912f921baa21~mv2.jpg&quot;,&quot;width&quot;:1907,&quot;height&quot;:1907,&quot;alt&quot;:&quot;&quot;,&quot;focalPoint&quot;:null,&quot;name&quot;:&quot;蝼蚁之城.jpg&quot;,&quot;crop&quot;:null},&quot;encoding&quot;:&quot;AVIF&quot;,&quot;allowFullGIFTransformation&quot;:false}" data-has-ssr-src="true" data-motion-part="BG_IMG comp-li1fi9re" class="qR3Oj6"><picture><img fetchpriority="high" src="https://static.wixstatic.com/media/9355b9_a1e8b80ce26b494d8601912f921baa21~mv2.jpg/v1/fill/w_147,h_147,al_c,q_80,usm_0.66_1.00_0.01,blur_2,enc_avif,quality_auto/%E8%9D%BC%E8%9A%81%E4%B9%8B%E5%9F%8E.jpg" alt="" style="object-fit:cover;object-position:50% 50%"/></picture></wow-image></div></div></div><!--/$--><!--$--><div class="comp-li1c5pne lIkFMb" id="comp-li1c5pne" aria-disabled="false"><a data-testid="linkElement" href="https://store.steampowered.com/app/3489340" target="_blank" rel="noopener" class="PoVCDy wixui-button ZhVEJq" aria-disabled="false" aria-label="STEAM PAGE"><span class="Gf1CuA wixui-button__label">STEAM PAGE</span></a></div><!--/$--><!--$--><div id="comp-li1c5oii2" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-li1c5oii2 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text">You are a condemned Synthetic, marked for destruction and trapped in endless resets. In a cyberpunk world inspired by Chinese mythology, harness weapons, chips, and augments to cut through mechanical creatures. Each run brings you closer to breaking the cycle and unravelling the truth.</p></div><!--/$--><!--$--><div id="comp-li1c5mi5" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-li1c5mi5 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text"><span class="wixui-rich-text__text">ReBlade: The Death Spiral</span></h2></div><!--/
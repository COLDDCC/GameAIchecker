<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Banana Airways – Chaotic Co-op Airline Game for up to 6 · Free Demo on Steam</title>
  <link rel="canonical" href="https://bananaairways.com/" />
  <meta name="description" content="Banana Airways: the sky's worst airline. Chaotic co-op for up to 6 players. Wishlist it on Steam." />
  <meta property="og:title" content="Banana Airways" />
  <meta property="og:description" content="The sky's worst airline. Chaotic co-op for up to 6 players. Wishlist it on Steam." />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Banana Airways" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://bananaairways.com/assets/og-image.jpg" />
  <meta property="og:image" content="https://bananaairways.com/assets/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://bananaairways.com/" />
  <meta name="theme-color" content="#16222f" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍌</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="preload" as="image" href="assets/home-bg-poster.jpg" />
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    /* Colores y tipografías de la guía de marca: Teko para títulos y botones, Montserrat para texto. */
    :root{ --navy:#324d66; --navy-deep:#263c50; --ink:#16222f; --yellow:#F8C537; --gold:#F8C537; --discord:#5865F2; }
    html,body{height:100%}
    html{ overflow-x:clip; }
    body{
      font-family:"Montserrat",system-ui,-apple-system,sans-serif;
      color:#fff;
      background:#16222f url("assets/home-bg-poster.jpg") center / cover no-repeat;
      min-height:100svh;
    }
    /* El trailer de fondo, nítido: el gameplay se tiene que ver (1280x720, sin audio, loop de 36 s). */
    .bg{
      position:fixed; inset:0; width:100%; height:100%;
      object-fit:cover; z-index:-2; pointer-events:none;
      transition:filter .6s ease;
    }
    /* Velo: liviano arriba, más oscuro abajo para que los botones y el pie se lean. */
    body::before{
      content:""; position:fixed; inset:0; z-index:-1; pointer-events:none;
      background:linear-gradient(rgba(14,22,32,.10), rgba(10,16,24,.12) 45%, rgba(10,16,24,.55) 78%, rgba(8,12,18,.82));
    }
    @media (prefers-reduced-motion: reduce){ .bg{ display:none; } }

    /* Una sola pantalla: logo arriba, los tres botones abajo, y el pie (desarrollador + copyright). */
    .stage{
      position:relative; z-index:1;
      min-height:100svh;
      display:flex; flex-direction:column; align-items:center;
      padding:clamp(28px,6vh,72px) 16px 0;
      text-align:center;
      transition:opacity .5s ease, transform .5s ease;
      overflow:clip;   /* los créditos que tira el bebé se pierden por abajo sin agregar scroll */
    }
    .top{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; position:relative; }
    /* sombra suave detrás del logo para que se lea sobre el video */
    .top::before{
      content:""; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
      width:min(860px,100vw); height:min(480px,70vh); z-index:-1;
      background:radial-gradient(ellipse at 50% 50%, rgba(10,16,24,.55), rgba(10,16,24,.22) 45%, rgba(10,16,24,0) 70%);
      pointer-events:none;
    }
    .logo{
      width:min(520px,80vw); height:auto;
      filter:drop-shadow(0 10px 26px rgba(0,0,0,.45));
    }
    .tag{
      font-family:"Teko",system-ui,sans-serif;
      font-weight:600; font-size:clamp(24px,3.2vw,34px); line-height:1.05; letter-spacing:.06em; text-transform:uppercase;
      color:var(--gold); text-shadow:0 2px 14px rgba(0,0,0,.85), 0 1px 3px rgba(0,0,0,.8); max-width:22em; text-wrap:balance;
    }
    /* el lema en dos líneas del mismo ancho: la segunda, más chica (0.845 de la primera) y en blanco */
    .tag span{ display:block; }
    .tag .tag-2{ font-size:.845em; color:#fff; margin-top:.12em; }

    /* Los tres botones: vidrio oscuro translúcido con borde fino, para que se vea el juego detrás.
       Al pasar el mouse se llenan con el color de cada uno (Steam, amarillo de la marca, Discord). */
    .badges{ display:flex; flex-wrap:wrap; justify-content:center; gap:clamp(10px,1.4vw,16px); margin:clamp(24px,5vh,48px) 0 clamp(26px,5vh,46px); }
    .badge{
      --hover:#1b2838; --hover-fg:#fff;
      display:flex; align-items:center; gap:12px;
      width:218px; height:60px; padding:0 18px 0 14px;
      font:inherit; text-align:left; text-decoration:none; cursor:pointer;
      color:#fff; background:rgba(12,19,28,.34);
      border:1.5px solid rgba(255,255,255,.26); border-radius:14px;
      backdrop-filter:blur(10px) saturate(1.25); -webkit-backdrop-filter:blur(10px) saturate(1.25);
      box-shadow:0 8px 24px rgba(0,0,0,.18);
      transition:transform .16s ease, background .18s ease, border-color .18s ease, color .18s ease;
    }
    .badge:hover{ transform:translateY(-2px); background:var(--hover); border-color:var(--hover); color:var(--hover-fg); }
    .badge:active{ transform:translateY(0); }
    .badge:focus-visible{ outline:2px solid #fff; outline-offset:3px; }
    .badge svg{ flex:none; width:32px; height:32px; }
    .badge span{ display:flex; flex-direction:column; gap:2px; }
    .badge small{ font-size:9.5px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; opacity:.7; line-height:1; }
    .badge b{ font-family:"Teko",system-ui,sans-serif; font-weight:500; font-size:30px; line-height:.8; letter-spacing:.03em; padding-top:4px; }
    .badge--steam{ --hover:#1b2838; }
    .badge--trailer{ --hover:var(--yellow); --hover-fg:var(--ink); border-color:rgba(248,197,55,.7); }
    .badge--trailer .play circle{ fill:var(--yellow); transition:fill .18s ease; }
    .badge--trailer .play path{ fill:var(--ink); transition:fill .18s ease; }
    .badge--trailer:hover .play circle{ fill:var(--ink); }
    .badge--trailer:hover .play path{ fill:var(--yellow); }
    .badge--discord{ --hover:var(--discord); }

    /* Pie: Eggscape y el desarrollador (3DAR), y el copyright, todo centrado. */
    .foot{ display:flex; flex-direction:column; align-items:center; gap:14px; padding:0 0 calc(18px + env(safe-area-inset-bottom)); }
    .credits{ display:flex; align-items:center; gap:22px; }
    .credits .sep{ width:1px; height:28px; background:rgba(255,255,255,.25); }
    .egg img{ height:34px; width:auto; display:block; filter:drop-shadow(0 2px 8px rgba(0,0,0,.4)); transition:transform .15s ease; }
    .egg:hover img{ transform:scale(1.04); }
    .dev{ display:flex; align-items:center; gap:10px; text-decoration:none; color:rgba(255,255,255,.72); opacity:.9; transition:opacity .15s ease; }
    .dev:hover{ opacity:1; }
    .dev small{ font-size:10px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; }
    .dev img{ height:24px; width:auto; display:block; }
    .copy{ font-size:11.5px; font-weight:500; letter-spacing:.02em; color:rgba(255,255,255,.55); }

    @media(max-width:760px){
      .badges{ flex-direction:column; align-items:center; gap:10px; }
      .badge{ width:min(260px,100%); }
    }
    @media(max-width:380px){ .credits{ gap:14px; } .egg img{ height:28px; } }
    @media(max-height:640px) and (min-width:761px){ .logo{ width:min(400px,70vw); } }

    /* ===== Play trailer (el mismo player que 3d.ar/banana-airways): se va todo, cuenta 3-2-1 con
       título y tic, y arranca el trailer con controles propios que se esconden con el mouse quieto. ===== */
    body.is-trailer{ overflow:hidden; }
    body.is-trailer .stage{ opacity:0; transform:scale(.97); pointer-events:none; }
    body.is-trailer .baby, body.is-trailer .zap, body.is-trailer .flash{ opacity:0; visibility:hidden; transition:opacity .4s ease, visibility 0s .4s; }
    .theater{
      position:fixed; inset:0; z-index:10; background:#000; overflow:hidden; user-select:none;
      opacity:0; visibility:hidden; transition:opacity .5s ease, visibility 0s .5s;
    }
    body.is-trailer .theater{ opacity:1; visibility:visible; transition:opacity .5s ease; }
    .theater.idle{ cursor:none; }
    .trailer{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; background:#000; }
    @media (max-aspect-ratio:4/3){ .trailer{ object-fit:contain; } }

    .cd{ position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28px;
      background:radial-gradient(circle at 50% 45%, rgba(22,34,47,.55), rgba(10,16,22,.92) 70%), url("press/video/trailer-poster.jpg") center / cover;
      transition:opacity .45s ease; }
    .cd.out{ opacity:0; pointer-events:none; }
    .cd-title{ font-family:"Teko",system-ui,sans-serif; text-transform:uppercase; letter-spacing:.14em; font-size:clamp(26px,4.2vw,46px); line-height:1; color:#fff; text-align:center; }
    .cd-title b{ font-weight:500; color:var(--gold); }
    body.is-trailer .cd-title{ animation:rise .6s ease both; }
    @keyframes rise{ from{ opacity:0; transform:translateY(12px); } to{ opacity:1; transform:none; } }
    .cd-ring{ position:relative; width:min(300px,52vmin); aspect-ratio:1; display:grid; place-items:center; }
    .cd-ring svg{ position:absolute; inset:0; width:100%; height:100%; transform:rotate(-90deg); }
    .cd-ring circle{ fill:none; stroke-width:5; }
    .cd-ring .track{ stroke:rgba(255,255,255,.12); }
    .cd-ring .arc{ stroke:var(--gold); stroke-linecap:round; stroke-dasharray:100; stroke-dashoffset:100; }
    .cd-ring.tick .arc{ animation:sweep .9s linear forwards; }
    @keyframes sweep{ from{ stroke-dashoffset:100; } to{ stroke-dashoffset:0; } }
    .cd-num{ font-family:"Teko",system-ui,sans-serif; font-weight:600; font-size:min(230px,40vmin); line-height:1; color:var(--gold); padding-top:.12em;
      text-shadow:0 8px 40px rgba(248,197,55,.35); }
    .cd-num.pop{ animation:pop .9s cubic-bezier(.2,.8,.2,1) both; }
    @keyframes pop{ 0%{ transform:scale(1.7); opacity:0; } 25%{ transform:scale(1); opacity:1; } 80%{ opacity:1; } 100%{ transform:scale(.88); opacity:0; } }

    /* controles */
    .ui{ position:absolute; inset:0; z-index:4; pointer-events:none; transition:opacity .4s ease; }
    .theater.idle .ui{ opacity:0; }
    .ui > *{ pointer-events:auto; }
    .close{
      position:absolute; top:calc(16px + env(safe-area-inset-top)); right:16px;
      width:46px; height:46px; border-radius:50%; cursor:pointer;
      display:grid; place-items:center; color:#fff;
      background:rgba(22,34,47,.6); border:1.5px solid rgba(255,255,255,.35);
      backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
      transition:background .15s ease, color .15s ease, border-color .15s ease;
    }
    .close:hover{ background:var(--gold); border-color:var(--gold); color:#2a2100; }
    .close svg{ width:20px; height:20px; }
    .ctl{ position:absolute; left:0; right:0; bottom:0; display:flex; align-items:center; gap:14px;
      padding:40px 20px calc(18px + env(safe-area-inset-bottom)); background:linear-gradient(transparent, rgba(0,0,0,.65)); }
    .ctl button{ background:none; border:0; padding:4px; color:#fff; display:grid; place-items:center; cursor:pointer; }
    .ctl button svg{ width:24px; height:24px; }
    .ctl .t{ font-size:12.5px; font-weight:700; font-variant-numeric:tabular-nums; color:rgba(255,255,255,.85); white-space:nowrap; }
    .seek{ flex:1; height:22px; display:flex; align-items:center; cursor:pointer; }
    .seek div{ position:relative; width:100%; height:4px; border-radius:2px; background:rgba(255,255,255,.25); transition:height .15s; }
    .seek:hover div{ height:6px; }
    .seek b{ position:absolute; left:0; top:0; bottom:0; width:0; background:var(--gold); border-radius:2px; }
    /* el interruptor de sonido, con ecualizador animado */
    .ctl .snd{ display:inline-flex; align-items:center; gap:9px; border:1.5px solid rgba(248,197,55,.6); border-radius:999px; background:rgba(22,34,47,.7);
      color:#fff; padding:7px 14px 5px 12px; font-family:"Teko",system-ui,sans-serif; font-size:17px; letter-spacing:.08em; text-transform:uppercase; line-height:1;
      backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); transition:background .15s, border-color .15s, transform .15s; }
    .ctl .snd:hover{ transform:translateY(-2px); background:rgba(22,34,47,.9); }
    .snd .eq{ display:flex; align-items:flex-end; gap:3px; height:14px; margin-top:-4px; }
    .snd .eq i{ width:4px; background:var(--gold); border-radius:2px; height:3px; transition:height .2s; }
    .snd.on .eq i{ animation:eq .9s ease-in-out infinite; }
    .snd.on .eq i:nth-child(2){ animation-delay:-.3s; } .snd.on .eq i:nth-child(3){ animation-delay:-.6s; } .snd.on .eq i:nth-child(4){ animation-delay:-.15s; }
    @keyframes eq{ 0%,100%{ height:3px; } 50%{ height:14px; } }
    .snd b{ font-weight:500; display:inline-block; width:4.3em; text-align:left; white-space:nowrap; }
    .snd:not(.on){ border-color:rgba(255,255,255,.3); color:rgba(255,255,255,.7); }
    .snd:not(.on) .eq i{ background:rgba(255,255,255,.45); }
    @media (max-width:700px){
      .ctl{ padding:30px 12px calc(20px + env(safe-area-inset-bottom)); gap:10px; }
      .ctl .snd b{ display:none; }
    }
    @media (prefers-reduced-motion: reduce){ .cd-num.pop{ animation:none; } }
    /* WISHLIST NOW! en la barra del player: el único botón lleno, en amarillo, para que se note */
    .ctl .wish{ display:inline-flex; align-items:center; gap:8px; flex:none; text-decoration:none; white-space:nowrap;
      font-family:"Teko",system-ui,sans-serif; font-weight:600; font-size:19px; letter-spacing:.07em; text-transform:uppercase; line-height:1;
      color:var(--ink); background:var(--yellow); border-radius:999px; padding:8px 16px 5px 12px;
      box-shadow:0 6px 18px rgba(0,0,0,.35); transition:transform .15s ease, background .15s ease; }
    .ctl .wish:hover{ transform:translateY(-2px); background:#ffd75a; }
    .ctl .wish svg{ width:18px; height:18px; margin-top:-3px; }
    @media (max-width:700px){ .ctl .wish{ font-size:17px; padding:7px 12px 4px 10px; } }
    /* El bebé del juego gateando por abajo, de izquierda a derecha. La animación del gateo
       viene en el WebP (48 cuadros, 3 s), recortado justo en el apoyo para que pise el borde; el avance lo pone el CSS. La duración la ajusta
       el script de abajo según el ancho, para que avance siempre a la misma velocidad. */
    .baby{
      position:fixed; left:0; bottom:0; z-index:0;
      height:clamp(62px,10vh,104px); width:auto; cursor:pointer;
      -webkit-user-select:none; user-select:none; -webkit-tap-highlight-color:transparent;
      filter:drop-shadow(0 0 6px rgba(0,0,0,.3));
      transition:filter 1.6s ease;
      animation:crawl var(--crawl,40s) linear 1 forwards;
    }
    @keyframes crawl{ from{ transform:translateX(-100%); } to{ transform:translateX(100vw); } }
    /* El rayo (click en el bebé): queda quieto, parpadea electrocutado y después carbonizado. */
    .baby.zapped{ animation-play-state:paused; }
    .baby.shock{ transition:none; animation:crawl var(--crawl,40s) linear 1 forwards paused, shock .5s steps(1) 1; }
    @keyframes shock{
      0%,40%,80%{ filter:brightness(3) saturate(0) drop-shadow(0 0 14px #bcd6ff); }
      20%,60%{ filter:invert(1) brightness(1.6) drop-shadow(0 0 18px #9fc2ff); }
      100%{ filter:brightness(.2) saturate(.1) contrast(1.5) drop-shadow(0 0 6px rgba(0,0,0,.3)); }
    }
    .baby.charred{ filter:brightness(.2) saturate(.1) contrast(1.5) drop-shadow(0 0 6px rgba(0,0,0,.3)); }
    .zap{ position:fixed; inset:0; width:100%; height:100%; pointer-events:none; z-index:3; }
    .flash{ position:fixed; inset:0; pointer-events:none; z-index:2; opacity:0; will-change:opacity;
      background:radial-gradient(circle at var(--fx,50%) var(--fy,100%), rgba(235,243,255,.95), rgba(170,200,255,.5) 35%, rgba(110,140,255,0) 75%); }
    /* La sacudida mueve el contenido y el video (fijo), nunca la página entera: así no asoman barras de scroll. */
    body.quake .top, body.quake .badges, body.quake .foot, body.quake .bg{ animation:quake .45s cubic-bezier(.36,.07,.19,.97) 1; }
    @keyframes quake{ 10%,90%{ transform:translate(-2px,1px); } 20%,80%{ transform:translate(4px,-2px); } 30%,50%,70%{ transform:translate(-7px,3px); } 40%,60%{ transform:translate(7px,-3px); } }
    @media (prefers-reduced-motion: reduce){ .baby,.zap,.flash{ display:none; } }
  </style>
  <!-- SEO: datos estructurados del juego, iguales en todas las páginas públicas -->

  <img class="baby" src="assets/baby-crawling.webp" width="266" height="220" alt="" aria-hidden="true" draggable="false" />
  <div class="flash" aria-hidden="true"></div>
  <canvas class="zap" aria-hidden="true"></canvas>
  <script>
    // Velocidad del gateo: medio cuerpo por segundo, sea cual sea el ancho de la pantalla.
    (function(){
      var b=document.querySelector('.baby');
      function set(){ var w=b.getBoundingClientRect().width||110; b.style.setProperty('--crawl',((innerWidth+w)/(w*0.42)).toFixed(1)+'s'); }
      set(); addEventListener('resize',set);
    })();

    // Click en el bebé: le cae un rayo. El rayo es procedural (desplazamiento de punto medio con
    // ramas), dibujado en un canvas en tres pasadas (halo, cuerpo, núcleo) y con dos o tres
    // destellos, como uno de verdad. Después: chispas, humo y el bebé carbonizado unos segundos.
    (function(){
      var baby=document.querySelector('.baby'), cv=document.querySelector('.zap'), flash=document.querySelector('.flash');
      var ctx=cv.getContext('2d'), dpr=1, W=0, H=0;
      var CRAWL='assets/baby-crawling.webp', STUN='assets/baby-stunned.webp', FAST='assets/baby-crawling-fast.webp';
      new Image().src=STUN; new Image().src=FAST;            // que estén en caché antes del primer rayo
      var thunder=new Audio('assets/lightning.mp3'); thunder.preload='auto'; thunder.volume=.75;
      var startle=[1,2,3].map(function(i){ var a=new Audio('assets/baby-startle-'+i+'.mp3'); a.preload='auto'; a.volume=.8; a.preservesPitch=false; return a; });
      function size(){ dpr=1; W=innerWidth; H=innerHeight; cv.width=W*dpr; cv.height=H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0); }
      size(); addEventListener('resize',size);

      // Un rayo: lista de segmentos [x1,y1,x2,y2,ancho] con la rama principal y sus ramitas.
      function bolt(x0,y0,x1,y1){
        var segs=[];
        function split(ax,ay,bx,by,off,w,depth,main){
          if(depth===0){ segs.push([ax,ay,bx,by,w]); return; }
          var mx=(ax+bx)/2, my=(ay+by)/2, dx=bx-ax, dy=by-ay, len=Math.hypot(dx,dy)||1;
          var o=(Math.random()*2-1)*off; mx+=-dy/len*o; my+=dx/len*o;
          split(ax,ay,mx,my,off/2,w,depth-1,main); split(mx,my,bx,by,off/2,w,depth-1,main);
          // ramitas: salen hacia abajo y afuera, cada vez más finas
          if(main && depth>2 && Math.random()<.32){
            var ang=Math.atan2(dy,dx)+(Math.random()<.5?-1:1)*(.35+Math.random()*.55), bl=len*(.5+Math.random()*.7);
            split(mx,my,mx+Math.cos(ang)*bl,my+Math.sin(ang)*bl,off/2.4,w*.45,depth-1,false);
          }
        }
        split(x0,y0,x1,y1,Math.hypot(x1-x0,y1-y0)*.22,1,8,true);
        return segs;
      }
      // El rayo se pinta UNA vez, al hacer clic, en un canvas del tamaño del rayo (no de la pantalla),
      // con los trazos agrupados por grosor: tres pasadas con brillo y el núcleo blanco son ~10 trazos
      // en total. En cada cuadro sólo se estampa esa imagen con la opacidad del destello.
      function prerender(segs){
        var x0=1e9,y0=1e9,x1=-1e9,y1=-1e9,i,s;
        for(i=0;i<segs.length;i++){ s=segs[i]; x0=Math.min(x0,s[0],s[2]); y0=Math.min(y0,s[1],s[3]); x1=Math.max(x1,s[0],s[2]); y1=Math.max(y1,s[1],s[3]); }
        var pad=70, c=document.createElement('canvas'); c.width=Math.ceil(x1-x0+pad*2); c.height=Math.ceil(y1-y0+pad*2);
        var g=c.getContext('2d'), groups={};
        for(i=0;i<segs.length;i++){ s=segs[i]; (groups[s[4]]=groups[s[4]]||[]).push(s); }
        g.translate(pad-x0,pad-y0); g.globalCompositeOperation='lighter'; g.lineCap='round'; g.lineJoin='round';
        var passes=[[22,'rgba(110,150,255,.10)',34],[9,'rgba(160,195,255,.35)',16],[3.2,'rgba(255,255,255,1)',6]];
        for(var p=0;p<passes.length;p++){
          g.shadowColor='rgba(150,185,255,1)'; g.shadowBlur=passes[p][2]; g.strokeStyle=passes[p][1];
          for(var w in groups){ var list=groups[w]; g.lineWidth=passes[p][0]*w; g.beginPath();
            for(i=0;i<list.length;i++){ g.moveTo(list[i][0],list[i][1]); g.lineTo(list[i][2],list[i][3]); } g.stroke(); }
        }
        return {c:c,x:x0-pad,y:y0-pad};
      }
      function draw(img,a){ ctx.save(); ctx.globalCompositeOperation='lighter'; ctx.globalAlpha=a; ctx.drawImage(img.c,img.x,img.y); ctx.restore(); }
      var parts=[], busy=false, raf=0, t0=0, strikes=[], impact=[0,0], fleeing=false, lastPuff=0;
      function spawn(x,y){
        for(var i=0;i<46;i++){ var a=-Math.PI*Math.random(), v=180+Math.random()*520;   // chispas hacia arriba y a los costados
          parts.push({k:'spark',x:x,y:y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,life:.35+Math.random()*.45,age:0}); }
        for(var j=0;j<16;j++) parts.push({k:'smoke',x:x+(Math.random()-.5)*40,y:y+Math.random()*20,vx:(Math.random()-.5)*24,vy:-30-Math.random()*40,
          r:10+Math.random()*14,life:2.4+Math.random()*1.6,age:-Math.random()*1.2});
      }
      function frame(now){
        var t=(now-t0)/1000, dt=Math.min(.05,(now-(frame.last||now))/1000); frame.last=now;
        ctx.clearRect(0,0,W,H);
        // los destellos del rayo: aparece, se apaga, vuelve con otra forma, y se desvanece
        var a=0, sIdx=-1;
        if(t<.07){a=1;sIdx=0;} else if(t<.11){a=0;} else if(t<.19){a=.9;sIdx=0;} else if(t<.24){a=.25;sIdx=1;} else if(t<.32){a=1;sIdx=1;} else if(t<.62){a=1-(t-.32)/.3;sIdx=1;}
        if(sIdx>=0&&a>0) draw(strikes[sIdx],a);
        flash.style.opacity=(sIdx>=0?Math.max(0,a*.8):0).toFixed(3);
        // brillo en el punto de impacto
        if(t<.9){ var g=ctx.createRadialGradient(impact[0],impact[1],0,impact[0],impact[1],120); var ga=Math.max(0,.75*(1-t/.9));
          g.addColorStop(0,'rgba(255,255,255,'+ga+')'); g.addColorStop(.3,'rgba(170,205,255,'+ga*.6+')'); g.addColorStop(1,'rgba(120,160,255,0)');
          ctx.globalCompositeOperation='lighter'; ctx.fillStyle=g; ctx.beginPath(); ctx.arc(impact[0],impact[1],120,0,7); ctx.fill(); ctx.globalCompositeOperation='source-over'; }
        // chispas y humo
        for(var i=parts.length-1;i>=0;i--){ var p=parts[i]; p.age+=dt; if(p.age>p.life){parts.splice(i,1);continue;} if(p.age<0) continue;
          var k=p.age/p.life;
          if(p.k==='spark'){ p.vy+=900*dt; p.x+=p.vx*dt; p.y+=p.vy*dt; if(p.y>H-2){p.y=H-2;p.vy*=-.35;p.vx*=.6;}
            ctx.strokeStyle='rgba(255,'+(230-120*k|0)+','+(160-140*k|0)+','+(1-k)+')'; ctx.lineWidth=2; ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p.x-p.vx*.018,p.y-p.vy*.018); ctx.stroke(); }
          else { p.x+=p.vx*dt; p.y+=p.vy*dt; p.r+=18*dt; var al=.38*Math.sin(Math.PI*Math.min(1,k));
            ctx.fillStyle='rgba(55,52,50,'+al+')'; ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,7); ctx.fill(); }
        }
        // mientras huye carbonizado va dejando humo
        if(fleeing && now-lastPuff>90){ lastPuff=now; var br=baby.getBoundingClientRect();
          parts.push({k:'smoke',x:br.left+br.width*.35,y:br.top+br.height*.3,vx:-20-Math.random()*20,vy:-25-Math.random()*30,r:8+Math.random()*8,life:1.6+Math.random(),age:0}); }
        if(t<.62||parts.length||fleeing) raf=requestAnimationFrame(frame); else { ctx.clearRect(0,0,W,H); raf=0; }
      }
      function strike(){
        busy=true; clicks=0; clearTimeout(calmTimer);
        var r=baby.getBoundingClientRect();
        impact=[r.left+r.width*.55, r.top+r.height*.3];
        var sx=impact[0]+(Math.random()-.5)*Math.min(360,W*.4);
        strikes=[prerender(bolt(sx,-30,impact[0],impact[1])), prerender(bolt(sx+(Math.random()-.5)*60,-30,impact[0],impact[1]))];
        flash.style.setProperty('--fx',(impact[0]/W*100)+'%'); flash.style.setProperty('--fy',(impact[1]/H*100)+'%');
        try{ thunder.currentTime=0; var pr=thunder.play(); if(pr&&pr.catch) pr.catch(function(){}); }catch(e){}
        baby.classList.add('zapped','shock'); baby.src=STUN;
        document.body.classList.remove('quake'); void document.body.offsetWidth; document.body.classList.add('quake');
        spawn(impact[0],impact[1]);
        t0=performance.now(); frame.last=t0; if(!raf) raf=requestAnimationFrame(frame);
        setTimeout(function(){ baby.classList.remove('shock'); baby.classList.add('charred'); flee(); }, 500);
        setTimeout(function(){ document.body.classList.remove('quake'); }, 500);
      }
      // Sale disparado carbonizado hacia la derecha: gateo al triple (el WebP rápido) y avance al
      // triple. Al salir de la pantalla no vuelve: el bebé pasa una sola vez por visita.
      function flee(){
        var r=baby.getBoundingClientRect(), x=r.left, w=r.width||110;
        baby.style.animation='none'; baby.style.transform='translateX('+x+'px)'; baby.src=FAST;
        var speed=w*.42*3, dist=Math.max(0,innerWidth-x), dur=Math.max(250,dist/speed*1000);
        fleeing=true; lastPuff=0; if(!raf){ t0=performance.now()-1000; frame.last=performance.now(); raf=requestAnimationFrame(frame); }
        var run=baby.animate([{transform:'translateX('+x+'px)'},{transform:'translateX('+innerWidth+'px)'}],{duration:dur,easing:'linear',fill:'forwards'});
        run.onfinish=function(){
          fleeing=false; baby.hidden=true;                         // se fue y no vuelve (queda busy: ya no se le puede hacer clic)
        };
      }
      // No le cae de una: los dos primeros clics lo asustan (saltito, queja del juego) y lo apuran al
      // doble y al triple; el tercero, rayo. Si lo dejás tranquilo 2,5 s, se calma y el contador vuelve a 0.
      var clicks=0, calmTimer=0, lastStartle=-1;
      function crawlAnim(){ var list=baby.getAnimations(); for(var i=0;i<list.length;i++) if(list[i].animationName==='crawl') return list[i]; return null; }
      function hurry(n){
        var k; do{ k=Math.floor(Math.random()*startle.length); }while(k===lastStartle && startle.length>1); lastStartle=k;
        var snd=startle[k]; try{ snd.currentTime=0; snd.playbackRate=.95+Math.random()*.15; var pr=snd.play(); if(pr&&pr.catch) pr.catch(function(){}); }catch(e){}
        baby.animate([{translate:'0 0'},{translate:'0 -18px',offset:.35},{translate:'0 0'}],{duration:340,easing:'ease-out'});
        var ca=crawlAnim(); if(ca) ca.updatePlaybackRate(n===1?2:3);
        if(baby.src.indexOf('fast')<0) baby.src=FAST;
        clearTimeout(calmTimer);
        calmTimer=setTimeout(function(){ var c=crawlAnim(); if(c) c.updatePlaybackRate(1); baby.src=CRAWL; clicks=0; }, 2500);
      }
      baby.addEventListener('animationend',function(e){ if(e.animationName==='crawl') baby.hidden=true; });
      baby.addEventListener('click',function(){
        if(busy) return;
        clicks++;
        if(clicks>=3) strike(); else hurry(clicks);
      });
    })();
  </script>
  <script>
    // El bebé tira los créditos: cuando su nariz toca cada uno (el logo de Eggscape, la rayita,
    // "Developed by" y el logo de 3dar) lo empuja. Cada uno sale con su propia física: un saltito
    // corto, gravedad y un par de rebotes contra el borde de abajo con aplastado; al último rebote
    // "se rompe el piso" y se cae por abajo de la pantalla. El contacto se mide en cada cuadro contra la posición real del bebé (la nariz está al
    // 95% del ancho del sprite), así queda sincronizado aunque lo apuren o salga disparado del rayo.
    (function(){
      var baby=document.querySelector('.baby');
      if(!baby || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // personalidad de cada uno: hop = salto (px/s), push = cuánto lo empuja, bounce = rebote,
      // spin = giro (°/s), sink = cuánto se hunde bajo el borde al apoyarse (fracción de su alto),
      // hops = cuántas veces rebota antes de caerse
      var kinds=[
        { sel:'.egg',          hop:260, push:.9,  bounce:.38, spin:-70,  sink:.35, hops:3 },   // pesado: salta poco, cae y se desploma
        { sel:'.credits .sep', hop:340, push:1.2, bounce:.55, spin:520,  sink:.5,  hops:4 },   // un palito: gira como hélice
        { sel:'.dev small',    hop:380, push:1.5, bounce:.45, spin:-160, sink:.2,  hops:4 },   // liviano: sale más lejos y bambolea
        { sel:'.dev img',      hop:300, push:1.1, bounce:.62, spin:200,  sink:.3,  hops:5 }    // el de 3dar: el más rebotón
      ];
      var items=[], live=[], G=2600, last=0, bx=null, bv=0;
      kinds.forEach(function(k){ var el=document.querySelector(k.sel); if(el) items.push({el:el,k:k}); });

      function launch(it){
        var r=it.el.getBoundingClientRect(), k=it.k, j=.85+Math.random()*.3;
        it.floor=innerHeight-r.bottom+r.height*k.sink;          // dónde está "el piso" para este elemento
        it.x=0; it.y=0; it.a=0; it.sq=1;                         // sq: aplastado (1 = normal)
        it.vx=Math.max(120,bv)*k.push*j+40; it.vy=-k.hop*j; it.va=k.spin*j;
        it.hops=0; it.falling=false;
        it.el.style.pointerEvents='none'; it.el.style.willChange='transform';
        it.sq=.72;                                              // el golpe lo aplasta en el acto
        live.push(it);
      }
      function step(it,dt,now){
        it.vy+=G*dt; it.x+=it.vx*dt; it.y+=it.vy*dt; it.a+=it.va*dt;
        it.sq+=(1-it.sq)*Math.min(1,dt*14);                     // el aplastado vuelve solo, como goma
        if(!it.falling && it.y>=it.floor && it.vy>0){           // toca el piso: rebota, frena y se aplasta
          it.y=it.floor; it.hops++;
          it.sq=Math.max(.6,1-Math.min(.4,it.vy/1400));
          if(it.hops>=it.k.hops){ it.falling=true; it.vy*=.3; }  // el último: se rompe el piso y se cae
          else {
            // cada rebote un poco más bajo, pero nunca tan chico que no se vea (mínimo ~7 a 16 px de alto)
            it.vy=-Math.max(it.vy*it.k.bounce, 340-it.hops*50);
            it.vx*=.75; it.va=it.va*.5+it.vx*.3;                 // al rebotar rueda un poco hacia adelante
          }
        }
        // ya se cayó por abajo (o se fue por la derecha): listo
        var r=it.el.getBoundingClientRect();
        if(r.top>innerHeight || r.left>innerWidth){ it.el.style.visibility='hidden'; return false; }
        it.el.style.transform='translate('+it.x.toFixed(1)+'px,'+it.y.toFixed(1)+'px) rotate('+it.a.toFixed(1)+'deg) scale('+(2-it.sq).toFixed(3)+','+it.sq.toFixed(3)+')';
        return true;
      }
      (function loop(now){
        var dt=last?Math.min(.04,(now-last)/1000):0; last=now;
        if(!baby.hidden && items.length){
          var b=baby.getBoundingClientRect(), nose=b.left+b.width*.95;
          if(bx!==null && dt) bv=Math.min(400,bv*.8+((b.left-bx)/dt)*.2);   // velocidad del bebé (suavizada y con tope) para el empujón
          bx=b.left;
          for(var i=0;i<items.length;i++){
            var r=items[i].el.getBoundingClientRect();
            if(r.width && nose>=r.left+2){ launch(items[i]); items.splice(i,1); i--; }
          }
        }
        live=live.filter(function(it){ return step(it,dt,now); });
        if(live.length || (items.length && !baby.hidden)) requestAnimationFrame(loop);
      })(performance.now());
    })();
  </script>
  <script>
    // Play trailer: el mismo player que 3d.ar/banana-airways. Se va la home, cuenta 3-2-1 con un tic
    // por número y arranca el trailer con sonido. Controles propios (play, barra, sonido, wishlist,
    // pantalla completa) que se esconden con el mouse quieto. La X, Esc o el final vuelven a la home.
    (function(){
      var $=function(s){ return document.querySelector(s); };
      var btn=$('#play-trailer'), theater=$('#theater'), v=$('#trailer'), cd=$('#cd'), num=$('#cdNum'), ring=$('#cdRing'), bg=$('.bg');
      var timers=[], actx=null, open=false, idle=0;

      // El trailer (V30) en alta, desde la CDN de 3dar: 1080p a 8 Mbps si la conexión da, 720p si no,
      // y si el 1080p se traba mientras se ve pasa al 720p en el mismo segundo.
      var HI='https://videos.3dar.com/banana/trailer/v2/trailer-1080.mp4', LO='https://videos.3dar.com/banana/trailer/v2/trailer-720.mp4';
      var conn=navigator.connection||{};
      v.src=(conn.saveData || /(^|-)(2g|3g)$/.test(conn.effectiveType||'') || (conn.downlink && conn.downlink<5)) ? LO : HI;
      var stalls=0, stallT=0, seeking=false;
      function downgrade(){
        if(v.src===LO) return;
        var t=v.currentTime, playing=!v.paused, muted=v.muted;
        v.src=LO; v.muted=muted;
        v.addEventListener('loadedmetadata', function(){ v.currentTime=t; if(playing) v.play().catch(function(){}); }, { once:true });
      }
      v.addEventListener('seeking', function(){ seeking=true; });
      v.addEventListener('seeked', function(){ seeking=false; });
      v.addEventListener('waiting', function(){
        if(v.src!==HI || v.currentTime<1 || seeking) return;
        clearTimeout(stallT);
        stallT=setTimeout(function(){ if(v.readyState<3 && !v.paused) downgrade(); }, 2000);
        if(++stalls>=3) downgrade();
      });
      v.addEventListener('playing', function(){ clearTimeout(stallT); });
      function fmt(s){ s=s||0; return Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0'); }

      // el "tic" de un proyector: un chasquido de ruido filtrado en agudos con un poco de cuerpo debajo
      function tick(last){
        if(!actx || v.muted) return;
        try{
          var t=actx.currentTime, sr=actx.sampleRate, len=Math.floor(sr*.03), buf=actx.createBuffer(1,len,sr), d=buf.getChannelData(0);
          for(var k=0;k<len;k++) d[k]=(Math.random()*2-1)*Math.exp(-k/(sr*.004));
          var src=actx.createBufferSource(); src.buffer=buf;
          var hp=actx.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=1800;
          var bp=actx.createBiquadFilter(); bp.type='peaking'; bp.frequency.value=last?4200:3200; bp.Q.value=3; bp.gain.value=9;
          var g=actx.createGain(); g.gain.value=last?.9:.7;
          var body=actx.createOscillator(), bgn=actx.createGain();
          body.type='sine'; body.frequency.setValueAtTime(last?1400:1100,t);
          bgn.gain.setValueAtTime(.0001,t); bgn.gain.exponentialRampToValueAtTime(.12,t+.002); bgn.gain.exponentialRampToValueAtTime(.0001,t+.025);
          src.connect(hp); hp.connect(bp); bp.connect(g); g.connect(actx.destination);
          body.connect(bgn); bgn.connect(actx.destination);
          src.start(t); body.start(t); body.stop(t+.03);
        }catch(e){}
      }

      // ---------- abrir / cerrar ----------
      function start(){
        if(open) return; open=true;
        try{ actx=actx||new (window.AudioContext||window.webkitAudioContext)(); actx.resume(); }catch(e){ actx=null; }
        // Safari sólo deja reproducir con sonido dentro del clic: lo "destrabamos" acá y lo pausamos al toque.
        v.preload='auto'; v.muted=false; v.currentTime=0;
        var p=v.play(); if(p&&p.catch) p.catch(function(){}); v.pause();
        paintSound(); paintPlay(); paintTime();
        document.body.classList.add('is-trailer'); theater.classList.remove('idle');
        cd.classList.remove('out'); num.textContent='';
        var n=3;
        (function step(){
          if(n===0){ cd.classList.add('out'); play(); return; }
          num.textContent=n;
          num.classList.remove('pop'); ring.classList.remove('tick'); void num.offsetWidth;
          num.classList.add('pop'); ring.classList.add('tick');
          tick(n===1); n--;
          timers.push(setTimeout(step,900));
        })();
        bg.pause();
        $('#closeTrailer').focus({preventScroll:true});
      }
      function play(){
        v.currentTime=0;
        var p=v.play();
        // si el navegador no deja sonido, que arranque mudo antes que no arrancar (el botón queda en "Sound off")
        if(p&&p.catch) p.catch(function(){ v.muted=true; v.play().catch(function(){}); });
      }
      function stop(){
        if(!open) return; open=false;
        timers.forEach(clearTimeout); timers=[]; clearTimeout(idle);
        v.pause();
        if(document.fullscreenElement) document.exitFullscreen().catch(function(){});
        document.body.classList.remove('is-trailer'); theater.classList.remove('idle');
        var p=bg.play(); if(p&&p.catch) p.catch(function(){});
        btn.focus({preventScroll:true});
      }
      btn.addEventListener('click',start);
      $('#closeTrailer').addEventListener('click',stop);
      v.addEventListener('ended',stop);
      addEventListener('keydown',function(e){
        if(!open) return;
        if(e.key==='Escape' && !document.fullscreenElement) stop();
        if(e.key===' ' && cd.classList.contains('out')){ e.preventDefault(); toggle(); }
      });

      // ---------- controles ----------
      function paintPlay(){ $('#ppIcon').setAttribute('d', v.paused ? 'M8 5v14l11-7z' : 'M6 5h4v14H6zM14 5h4v14h-4z'); }
      function paintTime(){
        $('#seekFill').style.width=(v.currentTime/(v.duration||1))*100+'%';
        $('#time').textContent=fmt(v.currentTime)+' / '+fmt(v.duration||83);
      }
      function paintSound(){
        var s=$('#snd'); s.classList.toggle('on',!v.muted); s.querySelector('b').textContent=v.muted?'Sound off':'Sound on';
      }
      function toggle(){ if(v.paused){ var p=v.play(); if(p&&p.catch) p.catch(function(){}); } else v.pause(); }
      v.addEventListener('play',paintPlay); v.addEventListener('pause',paintPlay);
      v.addEventListener('timeupdate',paintTime); v.addEventListener('volumechange',paintSound);
      $('#pp').addEventListener('click',function(e){ e.stopPropagation(); toggle(); });
      v.addEventListener('click',toggle);
      $('#seek').addEventListener('click',function(e){
        var r=e.currentTarget.getBoundingClientRect();
        v.currentTime=((e.clientX-r.left)/r.width)*(v.duration||0);
      });
      $('#snd').addEventListener('click',function(e){ e.stopPropagation(); v.muted=!v.muted; });
      // ir a Steam pausa el trailer (se abre en otra pestaña): al volver sigue desde ahí
      $('#wish').addEventListener('click',function(){ v.pause(); });
      $('#fs').addEventListener('click',function(e){
        e.stopPropagation();
        if(document.fullscreenElement) return document.exitFullscreen();
        if(theater.requestFullscreen) theater.requestFullscreen();
        else if(theater.webkitRequestFullscreen) theater.webkitRequestFullscreen();
        else if(v.webkitEnterFullscreen) v.webkitEnterFullscreen();   // iPhone: sólo el video puede ir a pantalla completa
      });

      // los controles se van si el mouse queda quieto 2 s mientras reproduce (salvo que esté encima de ellos)
      var mx=-1, my=-1;
      function hideNow(){ clearTimeout(idle); if(open && !v.paused && !document.querySelector('.ctl:hover, .close:hover')) theater.classList.add('idle'); }
      function wake(e){
        if(e && e.type==='mousemove'){ if(e.clientX===mx && e.clientY===my) return; mx=e.clientX; my=e.clientY; }
        theater.classList.remove('idle'); clearTimeout(idle); idle=setTimeout(hideNow,2000);
      }
      ['mousemove','touchstart','keydown','click'].forEach(function(ev){ theater.addEventListener(ev,wake,{passive:true}); });
      v.addEventListener('pause',wake);
      v.addEventListener('playing',function(){ setTimeout(hideNow,350); });
    })();
  </script>
</body>
</html>

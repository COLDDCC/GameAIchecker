e_item_assets\/steam\/apps\/3301840\/919bb069837465282359c5326165f9d3d86b72e1\/ss_919bb069837465282359c5326165f9d3d86b72e1.600x338.jpg?t=1793864914","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3301840\/919bb069837465282359c5326165f9d3d86b72e1\/ss_919bb069837465282359c5326165f9d3d86b72e1.1920x1080.jpg?t=1793864914"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3301840\/6931bf63ed0f2eede4731667c0b4ef42f27058c4\/ss_6931bf63ed0f2eede4731667c0b4ef42f27058c4.600x338.jpg?t=1793864914","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3301840\/6931bf63ed0f2eede4731667c0b4ef42f27058c4\/ss_6931bf63ed0f2eede4731667c0b4ef42f27058c4.1920x1080.jpg?t=1793864914"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3301840\/8a637249fbd80a85fe1d197973786c0f33c81f0b\/ss_8a637249fbd80a85fe1d197973786c0f33c81f0b.600x338.jpg?t=1793864914","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3301840\/8a637249fbd80a85fe1d197973786c0f33c81f0b\/ss_8a637249fbd80a85fe1d197973786c0f33c81f0b.1920x1080.jpg?t=1793864914"}],"movies":[{"id":257471839,"name":"实机演示","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257471839\/0cc8ec2422969b2615f232c6c7c2b9d5e4617548\/movie_600x337.jpg?t=1793776245","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/3301840\/1011251567\/34f94507e83248c934be7a8d228b84a3eea3410d\/1793775839\/dash_av1.mpd?t=1793776245","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/3301840\/1011251567\/34f94507e83248c934be7a8d228b84a3eea3410d\/1793775839\/dash_h264.mpd?t=1793776245","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/3301840\/1011251567\/34f94507e83248c934be7a8d228b84a3eea3410d\/1793775839\/hls_264_master.m3u8?t=1793776245","highlight":true},{"id":257452028,"name":"时装","thu
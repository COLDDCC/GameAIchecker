linux":true},"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":20,"description":"MMO"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":22,"description":"Steam Achievements"},{"id":64,"description":"Adjustable Text Size"},{"id":68,"description":"Custom Volume Controls"},{"id":76,"description":"Mouse Only Option"},{"id":80,"description":"#category_playable_at_your_own_pace"},{"id":74,"description":"Playable without Timed Input"},{"id":79,"description":"Save Anytime"},{"id":69,"description":"Stereo Sound"},{"id":23,"description":"Steam Cloud"},{"id":15,"description":"Stats"},{"id":62,"description":"Family Sharing"}],"genres":[{"id":"4","description":"Casual"},{"id":"23","description":"Indie"},{"id":"29","description":"Massively Multiplayer"},{"id":"9","description":"Racing"},{"id":"3","description":"RPG"},{"id":"28","description":"Simulation"},{"id":"2","description":"Strategy"},{"id":"37","description":"Free To Play"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5033210\/678fdb50f8f86f8486d4418a5000213feacfe3dd\/ss_678fdb50f8f86f8486d4418a5000213feacfe3dd.600x338.jpg?t=1790914655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5033210\/678fdb50f8f86f8486d4418a5000213feacfe3dd\/ss_678fdb50f8f86f8486d4418a5000213feacfe3dd.1920x1080.jpg?t=1790914655"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5033210\/c59f798a2c4c991fc4da4dad8736f1db326377c9\/ss_c59f798a2c4c991fc4da4dad8736f1db326377c9.600x338.jpg?t=1790914655","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5033210\/c59f798a2c4c991fc4da4dad8736f1db326377c9\/ss_c59f798a2c4c991fc4da4dad8736f1db326377c9.1920x1080.jpg?t=1790914655"}
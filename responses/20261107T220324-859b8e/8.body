							var StoreDefaults = {"PartnerEventStore":[{"gid":"674008262454020757","clan_steamid":"103582791475832283","event_name":"The hero broke everything. Your cleanup begins October 16.","event_type":16,"appid":5269420,"server_address":null,"server_password":null,"rtime32_start_time":1791571500,"rtime32_end_time":1791576001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Discover Run-Down Village: learn your neighbors\u2019 styles and put their world back together.\",null,null,null,null,\"Aprende el estilo de cada vecino y devuelve sus objetos a su lugar.\",\"\u8bb0\u4f4f\u90bb\u5c45\u4eec\u7684\u98ce\u683c\uff0c\u8ba9\u6563\u843d\u7684\u7269\u54c1\u56de\u5230\u539f\u4f4d\u3002\",\"\u8a18\u4f4f\u9130\u5c45\u5011\u7684\u98a8\u683c\uff0c\u8b93\u6563\u843d\u7684\u7269\u54c1\u56de\u5230\u539f\u4f4d\u3002\",null,null,\"\u6751\u4eba\u306e\u597d\u307f\u3092\u899a\u3048\u3066\u3001\u6563\u3089\u304b\u3063\u305f\u7269\u3092\u5143\u306e\u5834\u6240\u3078\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"4,584 misplaced objects. One very untidy hero. Run-Down Village is planned to launch October 16. Wishlist on Steam for a release notification.\",null,null,null,null,\"4.584 objetos fuera de lugar y un H\u00e9roe muy desordenado. Lanzamiento previsto el 16 de octubre. A\u00f1\u00e1delo a deseados para recibir el aviso de Steam.\",\"4,584\u4ef6\u653e\u9519\u4f4d\u7f6e\u7684\u7269\u54c1\uff0c\u4e00\u4f4d\u4ece\u4e0d\u6536\u62fe\u7684\u52c7\u8005\u3002Run-Down Village\u9884\u8ba110\u670816\u65e5\u53d1\u552e\u3002\u52a0\u5165Steam\u613f\u671b\u5355\uff0c\u63a5\u6536\u53d1\u552e\u901a\u77e5\u3002\",\"4,584\u4ef6\u653e\u932f\u4f4d\u7f6e\u7684\u7269\u54c1\uff0c\u4e00\u4f4d\u5f9e\u4e0d\u6536\u62fe\u7684\u52c7\u8005\u3002Run-Down Village\u9810\u8a0810\u670816\u65e5\u767c\u552e\u3002\u52a0\u5165Steam\u9858\u671b\u6e05\u55ae\uff0c\u63a5\u6536\u767c\u552e\u901a\u77e5\u3002\",null,null,\"4,584\u500b\u306e\u6563\u3089\u304b\u3063\u305f\u7269\u3068\u3001\u7247\u3065\u3051\u306a\u3044\u52c7\u8005\u3002Run-Down Village\u306f10\u670816\u65e5\u767a\u58f2\u4e88\u5b9a\u3002Steam\u306e\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u306b\u8ffd\u52a0\u3057\u3066\u767a\u58f2\u901a\u77e5\u3092\u53d7\u3051\u53d6\u308d\u3046\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"40a58d1aa2fd59469bc6d7021d2500bdefe3c91d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"674008262454020758","clanid":"46310875","posterid":"0","headline":"The hero broke everything. Your cleanup begins October 16.","posttime":1791571512,"updatetime":1791571759,"body":"[h2]The world is saved. The village is a mess.[\/h2]\nThe hero keeps smashing pots, cupboards and chicken coops to find coins. You were summoned to another world to deal with what happens next.\n\nRun-Down Village is planned to launch on Steam on [b]October 16, 2026[\/b].\n\n[h2]Learn the village, then put it back together[\/h2]\nEvery object carries its owner\u2019s colors and markings. Learn each family\u2019s style, return their belongings and build an organizing chain to gain experience.\n\n[list]\n[*]Find and return 4,584 misplaced objects across eight family homes and 52 buildings.\n[*]Unlock five organizing abilities, including telekinesis and a double jump.\n[*]Meet your neighbors and build affinity as their village changes around you.\n[*]Prepare for the hero\u2019s return\u2014or enjoy the quieter night shift.\n[\/list]\n\nThe game supports Chinese, English, Spanish and Japanese text.\n\n[h2]Make room for your next cozy adventure[\/h2]\n[url=https:\/\/store.steampowered.com\/app\/5269420\/?utm_source=steam_news&utm_medium=organic&utm_campaign=village_prelaunch_202610&utm_content=en_date]Wishlist Run-Down Village on Steam[\/url] to receive a notification when it releases.\n\nWhat would you organize first: the bakery, the forge or the chicken coop?","commentcount":0,"tags":["mod_reviewed","ModAct_1751656904_1791573462_0"],"language":0,"hidden":0,"forum_topic_id":"581684714275885417","event_gid":"674008262454020757","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"581684714275885417","rtime32_last_modified":1792435512,"news_post_gid":"0","rtime_mod_reviewed":1791573463,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791571262,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"581684714275885416","gidfeature2":"581684714275885417"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["674008262454020758"],"last_update_event":[]}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<h2 class="bb_tag" >YOU ARE NOT THE CHOSEN ONE</h2><p class="bb_paragraph" >A hero called <strong>Kaito</strong> saves <strong>Rocaverde</strong> from the Demon King about once a week.</p><p class="bb_paragraph" >On his way through, he smashes every pot, cupboard, and chicken coop in the village looking for spare change… then simply leaves.</p><p class="bb_paragraph" >The goddess <strong>Airi</strong> summoned you to another world for exactly this reason, granting you the class <strong>〈Neighbour〉</strong> and the unique skill <strong>〈Organizer〉</strong>.</p><h2 class="bb_tag" >🧹 TIDYING UP, AS AN RPG</h2><p class="bb_paragraph" >Every object carries the colour and mark of its owner.</p><p class="bb_paragraph" >Hana’s jars are blue, decorated with a wheat ear. Kenji’s belongings are iron-grey and covered in rivets. Yuki’s things are green, painted with delicate leaves.</p><p class="bb_paragraph" >Nothing tells you where an object belongs.</p><p class="bb_paragraph" >You learn each family’s style—and from then on, you’ll know at a glance where everything goes.</p><p class="bb_paragraph" >Put an object back in its rightful place to gain <strong>EXP</strong>. Return things one after another and your <strong>chain</strong> grows, note by note.</p><p class="bb_paragraph" >Throw an object across the room directly into its slot and earn even more.</p><h2 class="bb_tag" >Master the art of order</h2><p class="bb_paragraph" >Eight levels unlock five unique skills:</p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Owner’s Sight</strong> — Objects you carry glow in their owner’s colour, and their front door lights up.</p></li><li><p class="bb_paragraph" ><strong>Telekinesis</strong> — Pull an object into your hands from up to twelve metres away. Chickens included.</p></li><li><p class="bb_paragraph" ><strong>Wind Step</strong> — Double jump.</p></li><li><p class="bb_paragraph" ><strong>Hearth Blessing</strong> — Seal a house for one minute, allowing the Hero to walk straight past it.</p></li><li><p class="bb_paragraph" ><strong>Absolute Order</strong> — Everything in your arms flies back home at once.</p></li></ul><p class="bb_paragraph" >Your carrying capacity grows from <strong>four objects in your hands</strong> to <strong>Jiro’s cart</strong>, capable of holding <strong>52</strong></p><h2 class="bb_tag" >🌿 A VILLAGE THAT LIVES WITHOUT YOU</h2><p class="bb_paragraph" ><strong>Rocaverde</strong> is a fully handcrafted isekai village, roughly one hundred metres across.</p><p class="bb_paragraph" >Eight family homes, each with three rooms, surround the central square. Beyond them lies a walled town containing <strong>52 buildings</strong>, including:</p><ul class="bb_ul"><li><p class="bb_paragraph" >A school</p></li><li><p class="bb_paragraph" >A tavern</p></li><li><p class="bb_paragraph" >A forge</p></li><li><p class="bb_paragraph" >A washhouse</p></li><li><p class="bb_paragraph" >A mill</p></li><li><p class="bb_paragraph" >A wizard’s tower</p></li><li><p class="bb_paragraph" >A shrine with its torii</p></li><li><p class="bb_paragraph" >The Adventurers’ Guild</p></li><li><p class="bb_paragraph" >A market</p></li><li><p class="bb_paragraph" >Fields and farmland</p></li><li><p class="bb_paragraph" >A river with bridges</p></li><li><p class="bb_paragraph" >A castle high on the mountain</p></li></ul><p class="bb_paragraph" >Twelve villagers follow their daily routines while children run through the streets. Dogs, cats, goats, and flocks of birds bring the village to life.</p><p class="bb_paragraph" >A full day lasts <strong>15 minutes</strong> and moves through <strong>seven distinct phases</strong>.</p><p class="bb_paragraph" >When the lamps glow and the fireflies appear, the Hero goes to bed.</p><p class="bb_paragraph" >That’s when the quiet shift begins.</p><h2 class="bb_tag" >📦 4,584 THINGS OUT OF PLACE</h2><p class="bb_paragraph" >The old town alone contains <strong>1,360 misplaced objects</strong>.</p><p class="bb_paragraph" >The remaining <strong>3,224</strong> are scattered throughout the <strong>52 buildings</strong> of five districts, each unlocked one at a time.</p><p class="bb_paragraph" >Every building is its own <strong>Guild contract</strong>, for a total of <strong>156 stars</strong> to earn.</p><p class="bb_paragraph" >At the heart of Rocaverde stands the <strong>Seal of Rocaverde</strong>: four arcs of light beneath a torii gate.</p><p class="bb_paragraph" >It only disappears when the district behind it is completely spotless.</p><h2 class="bb_tag" >🤝 NEIGHBOURS, NOT QUEST GIVERS</h2><p class="bb_paragraph" >Meet the people who make Rocaverde feel like home:</p><ul class="bb_ul"><li><p class="bb_paragraph" ><strong>Hana</strong> — The baker</p></li><li><p class="bb_paragraph" ><strong>Kenji</strong> — The blacksmith</p></li><li><p class="bb_paragraph" ><strong>Yuki</strong> — The herbalist</p></li><li><p class="bb_paragraph" ><strong>Sakura</strong> — The innkeeper</p></li><li><p class="bb_paragraph" ><strong>Taro</strong> — The fisherman</p></li><li><p class="bb_paragraph" ><strong>Aoi</strong> — The scribe</p></li><li><p class="bb_paragraph" ><strong>Haru</strong> — The farmer</p></li><li><p class="bb_paragraph" ><strong>Mio</strong> — The tailor</p></li></ul><p class="bb_paragraph" >Each neighbour has <strong>five hearts of affinity</strong>, with a permanent gift waiting at three hearts and another at five.</p><p class="bb_paragraph" >Discover an encyclopedia containing <strong>240 entries</strong>, collect <strong>24 golden family heirlooms</strong> worth more than a hundred cups, and fill a display case with twelve special pieces.</p><p class="bb_paragraph" >And if you’re quick enough…</p><p class="bb_paragraph" >You can even pick up the chickens.</p><h2 class="bb_tag" >⚔️ AND THE HERO KEEPS COMING BACK</h2><p class="bb_paragraph" >The Hero always targets the tidiest house.</p><p class="bb_paragraph" >That’s where the money is.</p><p class="bb_paragraph" >You’ll receive <strong>15 seconds of warning</strong> before he arrives.</p><p class="bb_paragraph" >Buy a lock. Leave an offering for the shrine maiden. Adopt a dog for the yard.</p><p class="bb_paragraph" >Or stand in the doorway and deliver a sermon.</p><p class="bb_paragraph" >Whatever you choose, it all leads to the same thing:</p><h2 class="bb_tag" ><strong>The Duel of Order.</strong></h2><h2 class="bb_tag" >🎌 TOLD LIKE AN ANIME</h2><p class="bb_paragraph" >Experience <strong>12 chapters</strong>, plus an extra chapter, each introduced with a Japanese anime-style title card.</p><p class="bb_paragraph" >The story is narrated aloud while the village visibly changes around you:</p><ul class="bb_ul"><li><p class="bb_paragraph" >Lanterns appear at the gates.</p></li><li><p class="bb_paragraph" >A broom leans against the Hero’s statue.</p></li><li><p class="bb_paragraph" >A cherry tree begins to bloom.</p></li><li><p class="bb_paragraph" >A banquet table is prepared.</p></li></ul><p class="bb_paragraph" >The full game is available in:</p><p class="bb_paragraph" ><strong>English · Spanish · Japanese</strong></p><h2 class="bb_tag" >✨ IN SHORT</h2><ul class="bb_ul"><li><p class="bb_paragraph" >First-person tidying RPG set in a handcrafted isekai village</p></li><li><p class="bb_paragraph" ><strong>4,584 misplaced objects</strong> to discover and return</p></li><li><p class="bb_paragraph" ><strong>8 family homes</strong>, <strong>52 buildings</strong>, and <strong>5 districts</strong></p></li><li><p class="bb_paragraph" >Eight levels and five unique skills</p></li><li><p class="bb_paragraph" >Guild ranks from <strong>F to S</strong></p></li><li><p class="bb_paragraph" >Fifteen-minute day/night cycle—the Hero sleeps at night</p></li><li><p class="bb_paragraph" >Villager affinity system and permanent rewards</p></li><li><p class="bb_paragraph" >An encyclopedia with <strong>240 entries</strong></p></li><li><p class="bb_paragraph" ><strong>24 golden family heirlooms</strong></p></li><li><p class="bb_paragraph" >Chickens you can pick up if you’re fast enough</p></li><li><p class="bb_paragraph" >Twelve chapters, plus an extra chapter</p></li><li><p class="bb_paragraph" >Anime-style Japanese title cards and narration</p></li><li><p class="bb_paragraph" >Full text in <strong>English, Spanish, and Japanese</strong></p></li></ul>						</div>
					</div>

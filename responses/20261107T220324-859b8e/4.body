,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016095346460722","clanid":"46530997","posterid":"0","headline":"SHOGITOON is available now on Steam!","posttime":1792504600,"updatetime":1792504600,"body":"SHOGITOON is now available on Steam!\nThank you to everyone who wishlisted the game and waited for launch.\n\n[b]Please note: In-game text is available in Japanese only.[\/b]\n\n[h2]Checkmate the king. Or paint your way to victory.[\/h2]\nSHOGITOON combines shogi, Japanese chess, with a colorful battle for territory. Each move paints the moved piece's destination and the empty squares it attacks in your color.\n\nCheckmate your opponent's king to win immediately. If all 81 squares have been painted at least once before checkmate, the player with more squares in their color wins. Protect your king, expand your territory, and find a new purpose for familiar shogi moves.\n\n[h2]Play solo or challenge another player[\/h2]\nFace 20 CPU characters with distinct playing styles, share a PC for local matches, or play online through Steam.\n\n[h2]Available for Windows PC[\/h2]\nPrice: US$2.99 \/ JPY 400. There is no launch discount on the individual game.\n\n[url=https:\/\/store.steampowered.com\/app\/5294600\/]Visit the SHOGITOON store page[\/url]\n\n[h2]Three-game bundle at 30% off[\/h2]\nA Steam bundle containing SHOGITOON, SplaChess, and MOVETOON offers 30% off the three games together. See the store page for bundle details. SHOGITOON supports Japanese only; SplaChess and MOVETOON support eight languages, including English.\n\nShare your thoughts or report an issue on the [url=https:\/\/steamcommunity.com\/app\/5294600\/discussions\/]Steam discussion board[\/url].\nSee you on the board!\n\nmayoaji\n","commentcount":0,"tags":["mod_reviewed","ModAct_1691520782_1792505930_0"],"language":0,"hidden":0,"forum_topic_id":"573804280379758053","event_gid":"683016095346460721","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804280379758053","rtime32_last_modified":1792505931,"news_post_gid":"0","rtime_mod_reviewed":1792505931,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792454659,"votes_up":0,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"592943924842202077","gidfeature2":"573804280379758053"},{"gid":"680763661892979968","clan_steamid":"103582791476052405","event_name":"SHOGITOON is scheduled to launch on October 20!","event_type":16,"appid":5294600,"server_address":null,"server_password":null,"rtime32_start_time":1791868980,"rtime32_end_time":1791873001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Checkmate or territory? SHOGITOON comes to Steam on October 20 at 14:00 UTC. In-game text is available in Japanese only.\",null,null,null,null,null,null,null,null,null,\"\u8a70\u3081\u308b\u304b\u3001\u5857\u308a\u52dd\u3064\u304b\u3002\u5c06\u68cb\u3068\u9663\u53d6\u308a\u3092\u7d44\u307f\u5408\u308f\u305b\u305f\u5bfe\u6226\u3092\u300110\u670820\u65e523\u6642\u304b\u3089\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"e515834ad979deb3e0ef8cbc5d1173ab106c449b.png\",null,null,null,null,null,null,null,null,null,\"e515834ad979deb3e0ef8cbc5d1173ab106c449b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6ce37363112668bc539740364f3fd54836ad2f7a.png\",null,null,null,null,null,null,null,null,null,\"6ce37363112668bc539740364f3fd54836ad2f7a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"680763661892979969","clanid":"46530997","posterid":"0","headline":"SHOGITOON is scheduled to launch on October 20!","posttime":1791869023,"updatetime":1791869023,"body":"SHOGITOON is scheduled to launch on Steam on Tuesday, October 20, 2026 at 14:00 UTC \/ 07:00 PDT \/ 23:00 JST.\n\n[h2]Checkmate the king. Or paint your way to victory.[\/h2]\nSHOGITOON combines shogi, Japanese chess, with a colorful battle for territory. Each move paints the moved piece's destination and the empty squares it attacks in your color.\n\nCheckmate your opponent's king to win immediately. If all 81 squares have been painted at least once before checkmate, the player with more squares in their color wins. Familiar shogi moves take on new meaning as you fight for control of the board.\n\nFace 20 CPU characters with distinct playing styles, play locally on the same device, or challenge another player online through Steam.\n\n[b]Please note: In-game text is available in Japanese only.[\/b]\n\nLaunch is one week away. Add SHOGITOON to your wishlist to be notified when it becomes available.\n\n[url=https:\/\/store.steampowered.com\/app\/5294600\/]SHOGITOON on Steam[\/url]\n\nSee you on the board!\n","commentcount":0,"tags":["mod_reviewed","ModAct_1751692459_1791869334_0"],"language":0,"hidden":0,"forum_topic_id":"592943924842202078","event_gid":"680763661892979968","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"592943924842202078","rtime32_last_modified":1791869334,"news_post_gid":"0","rtime_mod_reviewed":1791869334,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791868338,"votes_up":0,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"592943924842202077","gidfeature2":"592943924842202078"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["683016095346460722","680763661892979969"],"last_update_event":[]}};

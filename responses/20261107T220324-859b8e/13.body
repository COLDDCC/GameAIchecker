mmentcount":1,"tags":["patchnotes","mod_reviewed","ModAct_1415716708_1791277113_0"],"language":0,"hidden":0,"forum_topic_id":"590691400522349915","event_gid":"697651526084069455","voteupcount":4,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"590691400522349915","rtime32_last_modified":1791287160,"news_post_gid":"0","rtime_mod_reviewed":1791277114,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791275971,"votes_up":4,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"590691400522349914","gidfeature2":"590691400522349915"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":[],"last_update_event":{"rtime":1791275940,"event_gid":"697651526084069455","announcement_gid":"697651526084069456","clan_account_id":46306005}}};

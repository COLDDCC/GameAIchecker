                                                            <media:credit><![CDATA[Pearl Abyss]]></media:credit>
                                                                                                                                                                                                                                    <media:description><![CDATA[Crimson Desert DLC - Ship]]></media:description>                                                            <media:text><![CDATA[Crimson Desert DLC - Ship]]></media:text>

                                                            <media:credit><![CDATA[Playground Games]]></media:credit>
                                                                                                                                                                                                                                    <media:description><![CDATA[Forza Horizon 6 Hokubo Treasure Hunt chest ]]></media:description>                                                            <media:text><![CDATA[Forza Horizon 6 Hokubo Treasure Hunt chest ]]></media:text>

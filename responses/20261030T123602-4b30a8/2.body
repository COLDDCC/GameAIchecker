                                                                                                                                                                                                                                    <media:description><![CDATA[Heist Escape Roguelike: Payday Experience trailer still - Payday clown mask guy holding big bags of cash]]></media:description>                                                            <media:text><![CDATA[Heist Escape Roguelike: Payday Experience trailer still - Payday clown mask guy holding big bags of cash]]></media:text>
                                <media:title type="plain"><![CDATA[Heist Escape Roguelike: Payday Experience trailer still - Payday clown mask guy holding big bags of cash]]></media:title>
                                                    </media:content>

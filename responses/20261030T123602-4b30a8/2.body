                                                            <media:credit><![CDATA[S-Game Studios]]></media:credit>
                                                                                                                                                                                                                                    <media:description><![CDATA[Phantom Blade Zero tips - Soul]]></media:description>                                                            <media:text><![CDATA[Phantom Blade Zero tips - Soul]]></media:text>

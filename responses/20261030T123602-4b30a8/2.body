                                                            <media:credit><![CDATA[S-Game Studio]]></media:credit>
                                                                                                                                                                                                                                    <media:description><![CDATA[Phantom Blade Zero Hua]]></media:description>                                                            <media:text><![CDATA[Phantom Blade Zero Hua]]></media:text>

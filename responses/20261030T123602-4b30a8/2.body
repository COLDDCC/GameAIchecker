                                                                                                                                                                                                                                    <media:description><![CDATA[A screenshot of the World of Warcraft: Forever beta. Two Skyborne elves stand in a grove.]]></media:description>                                                            <media:text><![CDATA[A screenshot of the World of Warcraft: Forever beta. Two Skyborne elves stand in a grove.]]></media:text>
                                <media:title type="plain"><![CDATA[A screenshot of the World of Warcraft: Forever beta. Two Skyborne elves stand in a grove.]]></media:title>

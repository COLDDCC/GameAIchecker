"noMatch\":\"No games match “{query}”.\",\"articleCount\":\"{count, plural, one {# article} other {# articles}}\",\"fullIndex\":\"Full index - all {count} games\",\"showMore\":\"Show {count} more\",\"showing\":\"Showing {shown} of {total}\"},\"moreOnGame\":{\"label\":\"More on {game}\",\"labelGeneric\":\"More on this game\",\"linkLabel\":\"Game hub\"},\"index\":{\"metaTitle\":\"Games\",\"metaDescription\":\"Every indie game we have covered - trailers, news and reviews, with direct Steam links.\",\"ogTitle\":\"Indie Games Directory | IndieBunny\",\"heading\":\"Games\",\"intro\":\"Every indie game we have covered so far - {count} and counting. Search it, browse it, wishlist it.\"},\"hub\":{\"fallbackName\":\"Game\",\"metaTitle\":\"{game} - News, Trailers, Release Date \u0026 Requirements\",\"metaTitleCompact\":\"{game} - Release Date \u0026 News\",\"metaDescriptionWithSummary\":\"{summary} {game} hub: news, trailers, screenshots, release date and system requirements.\",\"metaDescription\":\"{game} hub on IndieBunny: news, trailers, screenshots, release date, system requirements and reviews.\",\"allGames\":\"All games\",\"keyArt\":\"{game} key art\",\"by\":\"by\",\"articleCount\":\"{count, plural, one {# article} other {# articles}}\",\"coveredSince\":\"covered since {date}\",\"ourScore\":\"our score {score}/10\",\"watchTrailer\":\"Watch trailer\",\"readOurReview\":\"Read our review\",\"sectionsAria\":\"Sections\",\"sections\":{\"news\":\"News\",\"guides\":\"Guides\",\"trailer\":\"Trailer\",\"screenshots\":\"Screenshots\",\"systemRequirements\":\"System requirements\",\"faq\":\"FAQ\",\"similar\":\"Similar games\",\"timeline\":\"Timeline\",\"reviews\":\"Reviews\"},\"headings\":{\"news\":\"{game} news\",\"guides\":\"{game} guides\",\"trailer\":\"{game} trailer\",\"screenshots\":\"{game} screenshots\",\"systemRequirements\":\"{game} system requirements\",\"faq\":\"{game} FAQ\",\"similar\":\"Games similar to {game}\",\"timeline\":\"{game} coverage timeline\",\"reviews\":\"{game} reviews\"},\"trailerThumbAlt\":\"{game} trailer\",\"timelineType\":{\"review\":\"Review\",\"trailer\":\"Trailer\",\"demo\":\"Demo\",\"release\":\"Release\",\"news\":\"News\"},\"faq\":{\"releaseQuestion\":\"When does {game} release?\",\"releaseUpcoming\":\"{game} is scheduled to release {date} on Steam.\",\"releasePast\":\"{game} released on {date} on Steam.\",\"platformsQuestion\":\"What platforms is {game} on?\",\"platformsAnswer\":\"{game} is available on {platforms} via Steam.\",\"costQuestion\":\"How much does {game} cost?\",\"costFree\":\"{game} is free to play on Steam.\",\"costPrice\":\"{game} costs {price} on Steam (prices can vary by region and during sales).\",\"developerQuestion\":\"Who develops {game}?\",\"developerAnswer\":\"{game} is developed by {developers}.\",\"developerAnswerWithPublishers\":\"{game} is developed by {developers} and published by {publishers}.\",\"genreQuestion\":\"What kind of game is {game}?\",\"genreAnswer\":\"{game} is a {genres} game.\",\"genreAnswerWithTags\":\"{game} is a {genres} game, tagged by players as {tags}.\",\"requirementsQuestion\":\"What are the minimum system requirements for {game}?\",\"requirementsAnswer\":\"{game} minimum requirements: {requirements}\"}},\"press\":{\"metaTitle\":\"{game} - Press Kit\",\"metaDescription\":\"Press assets, factsheet and contact details for {game}. Free for editorial use.\",\"metaDescriptionWithStudio\":\"Press assets, factsheet and contact details for {game} by {studio}. Free for editorial use.\",\"badge\":\"Press Kit\",\"download\":\"Download press kit (.zip)\",\"officialPressKit\":\"Official press kit\",\"about\":\"About\",\"factsheet\":\"Factsheet\",\"links\":\"Links\",\"images\":\"Images\",\"documents\":\"Documents\",\"factsheetPdf\":\"Factsheet (PDF)\",\"release\":\"Release\",\"status\":\"Status\",\"website\":\"Website\",\"assetAlt\":\"{game} {kind}\",\"footer\":\"Assets are provided by the developer for editorial use. Questions? \u003cmail\u003ehello@indiebunny.com\u003c/mail\u003e\",\"statusLabels\":{\"in_development\":\"In development\",\"alpha\":\"Alpha\",\"beta\":\"Beta\",\"early_access\":\"Early Access\",\"released\":\"Released\",\"cancelled\":\"Cancelled\"}}},\"genres\":{\"indie\":\"Indie\",\"action\":\"Action\",\"adventure\":\"Adventure\",\"casual\":\"Casual\",\"strategy\":\"Strategy\",\"simulation\":\"Simulation\",\"rpg\":\"RPG\",\"early_access\":\"Early Access\",\"free_to_play\":\"Free To Play\",\"massively_multiplayer\":\"Massively Multiplayer\",\"racing\":\"Racing\",\"sports\":\"Sports\",\"horror\":\"Horror\",\"puzzle\":\"Puzzle\",\"platformer\":\"Platformer\",\"roguelike\":\"Roguelike\"},\"guides\":{\"meta\":{\"guide\":\"Guide\",\"difficulty\":\"Difficulty\",\"timeNeeded\":\"Time needed\",\"gameVersion\":\"Game version\",\"lastVerified\":\"Last verified\",\"timeValue\":\"~{minutes} min in-game\"},\"type\":{\"beginner_tutorial\":\"Beginner Tutorial\",\"mechanic_explanation\":\"Mechanic Explained\",\"step_by_step_solution\":\"Step-by-Step Solution\",\"puzzle_quest_solution\":\"Puzzle \u0026 Quest Solution\",\"boss_guide\":\"Boss Guide\",\"item_tool_guide\":\"Item Guide\",\"tips_tricks\":\"Tips \u0026 Tricks\",\"troubleshooting\":\"Troubleshooting\",\"coop_guide\":\"Co-op Guide\"},\"difficulty\":{\"beginner\":\"Beginner-friendly\",\"intermediate\":\"Intermediate\",\"advanced\":\"Advanced\"},\"difficultyShort\":{\"beginner\":\"Beginner\",\"intermediate\":\"Intermediate\",\"advanced\":\"Advanced\"}},\"header\":{\"logoLabel\":\"IndieBunny home\",\"logIn\":\"Log in\",\"register\":\"Register\",\"myAccount\":\"My account\",\"notifications\":\"Notifications\",\"bookmarks\":\"Bookmarks\",\"collections\":\"Collections\",\"myCalendar\":\"My calendar\",\"studioDashboard\":\"Studio dashboard\",\"signOut\":\"Sign out\"},\"home\":{\"metaTitle\":\"IndieBunny - Indie Game News, Reviews \u0026 Trailers\",\"metaDescription\":\"Indie game news, reviews, and trailers - spotlighting real games from small teams, solo developers, and tiny budgets.\",\"twitterDescription\":\"Your source for real indie games. Small teams, single developers, tiny projects, cute budgets.\",\"trendingTrailers\":\"Trending Trailers\",\"moreTrailers\":\"More trailers\",\"hero\":{\"ariaLabel\":\"Featured stories\",\"badge\":\"Featured Story\",\"slideLabel\":\"{index} of {total}\",\"by\":\"By {name}\",\"previous\":\"Previous story\",\"next\":\"Next story\",\"goToSlide\":\"Go to slide {index}\"},\"latestNews\":{\"title\":\"Latest News\",\"linkLabel\":\"View all news\"},\"guides\":{\"title\":\"Guides\",\"linkLabel\":\"View all guides\"},\"stars\":{\"title\":\"IndieBunny Stars\",\"linkLabel\":\"View all stars\"},\"videos\":{\"title\":\"Videos\",\"linkLabel\":\"More videos\"},\"topLists\":{\"title\":\"Top 10s\",\"linkLabel\":\"View all Top 10s\",\"badge\":\"Top 10\",\"seeFull\":\"See the full Top 10\"},\"moreStories\":\"More Stories\"},\"language\":{\"label\":\"Language\",\"switchTo\":\"Switch language\",\"current\":\"Current language: {language}\"},\"listing\":{\"latest\":{\"metaTitle\":\"Latest Articles\",\"metaDescription\":\"Browse the latest articles\",\"heading\":\"Latest News\"},\"trailers\":{\"metaTitle\":\"Videos\",\"metaDescription\":\"Watch the latest indie game trailers and gameplay videos\",\"breadcrumb\":\"Videos\",\"heading\":\"Videos\",\"empty\":\"No videos found.\",\"trendingThisWeek\":\"Trending This Week\",\"moreVideos\":\"More Videos\"},\"reviews\":{\"metaTitle\":\"IndieBunny Stars\",\"metaDescription\":\"IndieBunny Stars - the indie games we hand-picked as standouts, newest first. Small teams, solo developers, tiny projects worth your time.\",\"ogTitle\":\"IndieBunny Stars | IndieBunny\",\"breadcrumb\":\"IndieBunny Stars\",\"heading\":\"IndieBunny Stars\",\"latestStar\":\"Latest star\",\"empty\":\"No IndieBunny Stars yet - stay tuned!\",\"moreStars\":\"More Stars\"},\"guides\":{\"metaTitle\":\"Indie Game Guides - Walkthroughs, Tips \u0026 How-Tos\",\"metaDescription\":\"Indie game guides: walkthroughs, beginner primers, build and boss help, and the settings worth changing before you start.\",\"ogTitle\":\"Indie Game Guides | IndieBunny\",\"collectionName\":\"Indie Game Guides\",\"breadcrumb\":\"Guides\",\"heading\":\"Guides\",\"introCount\":\"{count, plural, one {# guide so far.} other {# guides so far.}}\",\"empty\":\"No guides published yet - the first ones are on the way.\"}},\"mostWishlisted\":{\"metaTitle\":\"Most Anticipated Indie Games\",\"metaDescription\":\"The indie games highest up Steam's Popular Upcoming list, updated daily with how each one has moved.\",\"ogTitle\":\"Most Anticipated Indie Games | IndieBunny\",\"breadcrumb\":\"Most Anticipated\",\"heading\":\"Most Anticipated Indie Games\",\"lastUpdated\":\"Last updated\",\"updatingShortly\":\"Updating shortly.\",\"seeTopTen\":\"See the Top 10\"},\"nav\":{\"home\":\"Home\",\"news\":\"News\",\"stars\":\"Stars\",\"starsFull\":\"IndieBunny Stars\",\"guides\":\"Guides\",\"videos\":\"Videos\",\"top10s\":\"Top 10s\",\"upcoming\":\"Upcoming\",\"calendar\":\"Calendar\",\"games\":\"Games\",\"promote\":\"Promote\",\"promoteFull\":\"Promote your game\",\"mainNavigation\":\"Main navigation\",\"mobileNavigation\":\"Mobile navigation\",\"openMenu\":\"Open menu\",\"closeMenu\":\"Close menu\",\"play\":\"Play\"},\"newsletter\":{\"confirmed\":{\"metaTitle\":\"Newsletter Subscription\",\"metaDescription\":\"Newsletter subscription confirmation\",\"backHome\":\"Back to Homepage\",\"successTitle\":\"Subscription Confirmed!\",\"successText\":\"Thank you for confirming your subscription. You will now receive the latest gaming news, reviews, and updates from indiebunny directly in your inbox.\",\"alreadyTitle\":\"Already Confirmed\",\"alreadyText\":\"Your email address has already been confirmed. You are all set to receive our newsletter.\",\"invalidTitle\":\"Invalid Confirmation Link\",\"invalidText\":\"This confirmation link is invalid or has expired. Please try subscribing again.\",\"errorTitle\":\"Something Went Wrong\",\"errorText\":\"We were unable to confirm your subscription. Please try again later or contact us if the problem persists.\"}},\"notFound\":{\"title\":\"Page Not Found\",\"heading\":\"404\",\"body\":\"The page you're looking for doesn't exist or has been moved.\",\"backHome\":\"Back to Homepage\",\"latest\":\"Latest Articles\"},\"pages\":{\"about\":{\"metaTitle\":\"About\",\"metaDescription\":\"Learn about IndieBunny, our editorial mission, and the team behind the indie gaming news site.\",\"ogTitle\":\"About IndieBunny\",\"breadcrumb\":\"About\",\"heading\":\"About IndieBunny\",\"tagline\":\"Your source for real indie games.\",\"whoWeAre\":\"Who We Are\",\"whoWeAreBody\":\"IndieBunny is an indie gaming news publication operated by Aikasy GmbH, based in Germany. We focus exclusively on independent games - the kind made by small teams, solo developers, and tiny studios on modest budgets.\",\"ourMission\":\"Our Mission\",\"ourMissionBody\":\"We believe the most creative, heartfelt, and innovative games come from independent developers. Our mission is to discover, highlight, and support those projects so they reach the audience they deserve.\",\"editorialPolicy\":\"Editorial Policy\",\"editorialPolicyBody\":\"Every article on IndieBunny is written or reviewed by our editorial team. We strive for accuracy, fairness, and transparency. We clearly disclose sponsored content and affiliate relationships. Our editorial decisions are independent from advertising.\",\"correctionsPolicy\":\"Corrections Policy\",\"correctionsPolicyBody\":\"If we publish incorrect information, we correct it promptly and transparently. Corrections are noted within the article. If you spot an error, please contact us so we can address it.\",\"whatWeCover\":\"What We Cover\",\"coverNews\":\"Indie game announcements and release news\",\"coverTrailers\":\"Trailers and gameplay reveals\",\"coverInterviews\":\"Interviews with indie developers\",\"coverReviews\":\"Reviews and previews of indie titles\",\"coverEvents\":\"Industry events and showcases\",\"contact\":\"Contact\",\"contactBody\":\"Have a tip, correction, or press release? Reach us at \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e.\",\"legalBody\":\"For legal information, see our \u003cimprint\u003eImprint\u003c/imprint\u003e.\"},\"contact\":{\"metaTitle\":\"Contact\",\"metaDescription\":\"Get in touch with the IndieBunny team. Send us tips, press releases, corrections, or partnership inquiries.\",\"ogTitle\":\"Contact | IndieBunny\",\"breadcrumb\":\"Contact\",\"heading\":\"Contact Us\",\"tagline\":\"We'd love to hear from you.\",\"general\":\"General Inquiries\",\"generalBody\":\"For general questions, feedback, or suggestions, reach us at \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e.\",\"press\":\"Press Releases \u0026 Game Submissions\",\"pressBody\":\"Are you an indie developer or publisher? We welcome press releases, game announcements, trailers, and demo launches. Send your news to \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e and we'll review it for coverage.\",\"corrections\":\"Corrections\",\"correctionsBody\":\"If you spot an error in one of our articles, please let us know at \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e. We take accuracy seriously and will address corrections promptly.\",\"partnerships\":\"Partnerships \u0026 Advertising\",\"partnershipsBody\":\"For advertising, sponsorship, or partnership opportunities, contact us at \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e.\",\"legal\":\"Legal Information\",\"legalBody\":\"IndieBunny is operated by Aikasy GmbH, based in Germany. For legal details, see our \u003cimprint\u003eImprint\u003c/imprint\u003e. For data privacy information, see our \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e.\"},\"editorialTeam\":{\"metaTitle\":\"Editorial Team\",\"metaDescription\":\"Meet the IndieBunny Editorial Team. Learn about our writers, editorial process, and the organization behind the indie gaming news site.\",\"ogTitle\":\"Editorial Team | IndieBunny\",\"breadcrumb\":\"Editorial Team\",\"heading\":\"Editorial Team\",\"aboutHeading\":\"About IndieBunny\",\"aboutBody\":\"IndieBunny is an independent news website dedicated to covering indie games, game development updates, trailers, and announcements from independent studios. We focus on the kind of games made by small teams, solo developers, and tiny studios on modest budgets - the projects that bring the most creativity and innovation to gaming.\",\"teamHeading\":\"Our Editorial Team\",\"teamBody\":\"Our articles are written and curated by the IndieBunny Editorial Team, a group of gaming enthusiasts focused on covering indie games, new releases, and developer updates. The team researches, writes, and reviews every piece of content published on the site to ensure accuracy and quality.\",\"publisherHeading\":\"Publisher\",\"publisherBody\":\"IndieBunny is operated and published by \u003cb\u003eAikasy GmbH\u003c/b\u003e, a company based in Germany.\",\"publisherItem\":\"\u003cb\u003ePublisher:\u003c/b\u003e Aikasy GmbH\",\"locationItem\":\"\u003cb\u003eLocation:\u003c/b\u003e Germany\",\"legalItem\":\"\u003cb\u003eLegal Information:\u003c/b\u003e \u003cimprint\u003eImprint\u003c/imprint\u003e\",\"standardsHeading\":\"Editorial Standards\",\"standardsIntro\":\"We are committed to providing accurate, fair, and transparent coverage of the indie gaming world. Our editorial standards include:\",\"standardAccuracy\":\"\u003cb\u003eAccuracy:\u003c/b\u003e We verify information before publishing and rely on official sources, press releases, and direct developer communications.\",\"standardCorrections\":\"\u003cb\u003eCorrections:\u003c/b\u003e If we publish incorrect information, we correct it promptly and transparently. Corrections are noted within the article.\",\"standardIndependence\":\"\u003cb\u003eIndependence:\u003c/b\u003e Our editorial decisions are independent from advertising and sponsorships. We clearly disclose sponsored content and affiliate relationships.\",\"standardSources\":\"\u003cb\u003eSources:\u003c/b\u003e We attribute information to its original source and link to official announcements, developer pages, and store listings whenever possible.\",\"contactHeading\":\"Contact\",\"contactBody\":\"Have a question, tip, or press release? Reach us at \u003cmail\u003einfo@aikasy.com\u003c/mail\u003e or visit our \u003ccontact\u003econtact page\u003c/contact\u003e.\"},\"collections\":{\"notFoundTitle\":\"Collection not found\",\"metaTitle\":\"{title} - {owner}'s IndieBunny collection\",\"metaDescription\":\"{blurb} {entries}, shared by {owner} on IndieBunny.\",\"entryCount\":\"{count, plural, one {# entry} other {# entries}}\",\"badge\":\"IndieBunny collection\",\"attribution\":\"\u003cowner\u003e{name}\u003c/owner\u003e shared this IndieBunny collection · {entries} · updated \u003ctime\u003e{date}\u003c/time\u003e\",\"untitled\":\"Untitled\",\"empty\":\"This collection is empty.\",\"footer\":\"Collections are reader-made lists on \u003csite\u003eIndieBunny\u003c/site\u003e.\"}},\"profiles\":{\"metaTitle\":\"{name} on IndieBunny\",\"metaTitleFallback\":\"Profile\",\"memberSince\":\"Here since {date}\",\"tasteOverlap\":\"about {percent}% taste overlap with you\",\"statCompleted\":\"Completed\",\"statPlaying\":\"Playing\",\"statBacklog\":\"Backlog\",\"statRated\":\"Rated\",\"favourites\":\"Favourites\",\"publicCollections\":\"Public collections\",\"collectionGames\":\"{count} games\",\"achievements\":\"Achievements\",\"activity\":\"Activity\",\"actions\":{\"blockConfirm\":\"Block this person? You will not see each other's profiles, and any follow between you is removed.\",\"failed\":\"That did not work. Try again.\",\"editProfile\":\"Edit your profile\",\"following\":\"Following\",\"follow\":\"Follow\",\"block\":\"Block\"}},\"promote\":{\"metaTitle\":\"Promote your indie game\",\"metaDescription\":\"Indie Launch Packages: we produce ready-to-post launch content for your game - article, trailer video and Shorts clip - and distribute it across IndieBunny, our YouTube channel and Steam curator page.\",\"ogTitle\":\"Promote your indie game on IndieBunny\",\"ogDescription\":\"We produce ready-to-post launch content for your game and distribute it across our network.\",\"heroTitle\":\"Promote your indie game\",\"heroBody\":\"We produce ready-to-post launch content for your game - article, trailer video and Shorts clip - and distribute it across indiebunny.com, our YouTube channel and our Steam curator page.\",\"seePackages\":\"See packages\",\"articleTitle\":\"A real article\",\"articleBody\":\"A dedicated article about your game on indiebunny.com - with screenshots, your trailer, a Steam widget and a permanent entry in our Games directory.\",\"trailerTitle\":\"Your trailer, produced\",\"trailerBody\":\"We publish your trailer on our YouTube channel with a custom cinematic thumbnail - the same treatment every major release on our channel gets.\",\"shortsTitle\":\"A Shorts video you keep\",\"shortsBody\":\"A vertical Shorts video featuring your game - published on our channel and delivered as a file you can repost on your own TikTok, Shorts and Reels.\",\"pitchTitle\":\"The honest pitch\",\"pitchBody\":\"We're a growing indie games site - not IGN, and we won't pretend to be. What you're buying is \u003cb\u003eprofessionally produced, ready-to-post content\u003c/b\u003e made by a team that publishes indie game coverage every single day, plus distribution across everything we run. The videos are yours to repost wherever you like. All paid coverage carries a clear sponsored-content disclosure - we don't sell review scores or opinions, and we don't guarantee sales or view numbers.\",\"packagesHeading\":\"Packages\",\"mostPopular\":\"Most popular\",\"oneTime\":\"one-time\",\"choose\":\"Choose {label}\",\"packages\":{\"launch\":{\"label\":\"Launch\",\"tagline\":\"Get your game covered on IndieBunny\",\"features\":[\"Dedicated article about your game on indiebunny.com\",\"Listed on our Steam curator page\",\"Permanent entry in our Games directory\",\"Sponsored-content disclosure included (we play fair)\"]},\"boost\":{\"label\":\"Boost\",\"tagline\":\"Article + your trailer on our YouTube channel\",\"features\":[\"Everything in Launch\",\"Your trailer published on our YouTube channel\",\"Custom cinematic thumbnail for the video\",\"Trailer embedded in the article\"]},\"spotlight\":{\"label\":\"Spotlight\",\"tagline\":\"The full package incl. a ready-to-post Shorts video\",\"features\":[\"Everything in Boost\",\"Custom vertical Shorts video featuring your game\",\"Published on our channel AND delivered as a file\",\"Repost it on your own TikTok / Shorts / Reels\"]}},\"faqHeading\":\"Frequently asked questions\",\"faqDeliveryQ\":\"How long does delivery take?\",\"faqDeliveryA\":\"Typically within \u003cb\u003e5 business days\u003c/b\u003e after payment. If your game has a specific launch date or embargo, mention it in the order notes and we'll time the coverage accordingly.\",\"faqGuaranteeQ\":\"Do you guarantee sales, wishlists or views?\",\"faqGuaranteeA\":\"No - and be wary of anyone who does. You're buying professionally produced content plus distribution across our network. The produced videos are yours to repost on your own channels, which for most studios is where the biggest value lies.\",\"faqSponsoredQ\":\"Is the coverage marked as sponsored?\",\"faqSponsoredA\":\"Yes. Paid coverage always carries a clear disclosure line. That protects you and us - undisclosed paid promotion violates advertising law in most countries.\",\"faqNeedQ\":\"What do you need from me?\",\"faqNeedA\":\"Just your Steam page - we pull screenshots, the trailer and store details from there. If you have a newer trailer on YouTube or a press kit, add the link in the order form.\",\"faqRefundQ\":\"What if you can't deliver?\",\"faqRefundA\":\"If we can't produce the deliverables for your game (e.g. missing Steam assets), we refund the order in full. See our \u003cterms\u003eTerms of Use\u003c/terms\u003e.\",\"form\":{\"heading\":\"Order your package\",\"intro\":\"Payment is handled securely by Paddle (our merchant of record - you'll get a proper invoice incl. VAT). After checkout you'll get a confirmation email - deliverables typically follow within 5 business days.\",\"gameName\":\"Game name *\",\"gameNamePlaceholder\":\"My Awesome Indie Game\",\"steam\":\"Steam App ID or store page URL *\",\"steamPlaceholder\":\"e.g. 1145360 or https://store.steampowered.com/app/1145360\",\"email\":\"Contact email *\",\"emailPlaceholder\":\"you@studio.com\",\"trailerUrl\":\"Trailer YouTube URL \u003copt\u003e(optional)\u003c/opt\u003e\",\"trailerUrlPlaceholder\":\"https://www.youtube.com/watch?v=…\",\"notes\":\"Anything we should know? \u003copt\u003e(optional)\u003c/opt\u003e\",\"notesPlaceholder\":\"Release date, embargo, press kit link, preferred publish window…\",\"terms\":\"I agree to the \u003cterms\u003eTerms of Use\u003c/terms\u003e and understand that published coverage will carry a sponsored-content disclosure. No specific sales or view numbers are guaranteed.\",\"redirecting\":\"Redirecting to checkout…\",\"continue\":\"Continue to payment - {price}\"},\"checkout\":{\"metaTitle\":\"Checkout\",\"missingTransaction\":\"Missing transaction reference.\",\"notConfigured\":\"Checkout is not configured yet. Please contact us at hello@indiebunny.com.\",\"providerFailed\":\"Failed to load the payment provider. Please reload the page.\",\"unavailable\":\"Checkout unavailable\",\"backToPackages\":\"Back to packages\",\"opening\":\"Opening secure checkout…\",\"openingBody\":\"Payment is handled by Paddle, our merchant of record. If the checkout window does not open, please allow pop-ups and reload this page.\"},\"thanks\":{\"metaTitle\":\"Order received\",\"heading\":\"Payment received - thank you!\",\"body\":\"Your order is confirmed and our team has been notified. You'll receive a confirmation email shortly, and a second email with links to all deliverables - typically within 5 business days.\",\"note\":\"Questions or extra materials (trailer, key art, embargo date)? Just reply to the confirmation email.\",\"reference\":\"Payment reference: \u003cmono\u003e{txn}\u003c/mono\u003e\",\"backHome\":\"Back to IndieBunny\"},\"canceled\":{\"metaTitle\":\"Checkout canceled\",\"heading\":\"Checkout canceled\",\"body\":\"No worries - \u003cb\u003eyou have not been charged\u003c/b\u003e. Your order was not completed and nothing will be published.\",\"backToPackages\":\"Back to packages\"}},\"reactions\":{\"great_art_style\":\"Great art style\",\"interesting_gameplay\":\"Interesting gameplay\",\"strong_story\":\"Strong story concept\",\"looking_forward_coop\":\"Looking forward to co-op\",\"soundtrack_stands_out\":\"Soundtrack stands out\",\"innovative_idea\":\"Innovative idea\",\"waiting_for_demo\":\"Waiting for a demo\",\"want_to_try_demo\":\"I want to try the demo\",\"still_unsure\":\"Still unsure\",\"helpful\":\"Helpful\",\"influenced_purchase\":\"Influenced my purchase decision\",\"agree_with_rating\":\"I agree with the rating\",\"want_another_perspective\":\"I would like another perspective\",\"cozy\":\"Cozy\",\"short_playtime\":\"Short playtime\",\"good_with_friends\":\"Good with friends\",\"relaxing\":\"Relaxing\",\"challenging\":\"Challenging\",\"story_focused\":\"Story-focused\",\"controller_recommended\":\"Controller recommended\",\"beginner_friendly\":\"Beginner friendly\",\"high_replay_value\":\"High replay value\",\"hidden_gem\":\"Hidden gem\"},\"review\":{\"verdict\":{\"amazing\":\"Amazing\",\"great\":\"Great\",\"good\":\"Good\",\"decent\":\"Decent\",\"mixed\":\"Mixed\"},\"verdictHeading\":\"IndieBunny Verdict\",\"verdictFallback\":\"We rated {game} {score} out of 10.\",\"thisGame\":\"this game\"},\"search\":{\"placeholder\":\"Search indiebunny...\",\"shortcut\":\"Ctrl K\",\"open\":\"Open search\",\"close\":\"Close search\",\"title\":\"Search\",\"games\":\"Games\",\"articles\":\"Articles\",\"noResults\":\"No results for \\\"{query}\\\"\",\"minChars\":\"Type at least 2 characters\",\"searching\":\"Searching…\",\"articleCount\":\"{count, plural, one {# article} other {# articles}}\",\"modalPlaceholder\":\"Search for articles ...\",\"noResultsFound\":\"No results found.\",\"coverage\":\"Coverage\"},\"sidebar\":{\"trendingNow\":\"Trending Now\",\"popularHere\":\"Popular here\",\"jumpToTopic\":\"Jump to a topic\",\"freshlyCovered\":\"Freshly covered\",\"allGames\":\"All games\",\"releaseCalendar\":{\"title\":\"Release Calendar\",\"linkLabel\":\"View full calendar\",\"free\":\"Free\"},\"guides\":{\"title\":\"Guides\",\"linkLabel\":\"See more\"},\"topWishlisted\":\"Top Wishlisted\",\"newsletter\":{\"heading\":\"Stay in the loop\",\"description\":\"The best indie game news in your inbox. No spam, unsubscribe anytime.\",\"success\":\"Thank you! Check your inbox to confirm your subscription.\",\"placeholder\":\"you@indiebunny.com\",\"submit\":\"Subscribe\",\"error\":\"Failed - please try again.\",\"duplicate\":\"Already subscribed - check your inbox.\"}},\"stats\":{\"metaTitle\":\"Steam Indie Game Statistics\",\"metaDescription\":\"Live statistics on the indie games tracked by IndieBunny: releases per month, the most common genres and Steam tags, price distribution and platform support.\",\"ogTitle\":\"Steam Indie Game Statistics | IndieBunny\",\"breadcrumb\":\"Statistics\",\"heading\":\"Steam Indie Game Statistics\",\"intro\":\"Live statistics from the {count} indie games tracked by IndieBunny, updated daily. Every number on this page is counted straight from our Steam sync.\",\"license\":\"Free to reuse under \u003clicense\u003e{name}\u003c/license\u003e - please credit IndieBunny with a link back.\",\"empty\":\"Statistics are being recalculated - check back shortly.\",\"jumpAria\":\"Jump to a section\",\"sections\":{\"overview\":\"Overview\",\"releases\":\"Releases per month\",\"genres\":\"Genres\",\"tags\":\"Steam tags\",\"prices\":\"Prices\",\"platforms\":\"Platforms\",\"community\":\"Community\"},\"overview\":{\"heading\":\"At a glance\",\"gamesTracked\":\"Games tracked\",\"upcoming\":\"Upcoming\",\"released\":\"Released\",\"freeToPlay\":\"Free to play\",\"summary\":\"{freePercent}% of the {count} indie games we track are free to play, and {upcomingPercent}% have not launched yet.\"},\"releases\":{\"title\":\"Releases per month\",\"note\":\"The busiest month in this window is {month} with {count} tracked indie releases.\",\"noteEmpty\":\"Release dates for this window are not published yet.\",\"footnote\":\"Counts only games with a confirmed release date on Steam.\"},\"genres\":{\"title\":\"Top genres\",\"note\":\"{genre} is the most common genre among tracked indie games, on {count} of {total} titles ({percent}%).\"},\"tags\":{\"title\":\"Most common Steam tags\",\"note\":\"Based on the {tagged} tracked games that currently carry Steam tags, {tag} is the most frequent ({count} games).\"},\"prices\":{\"title\":\"Price distribution\",\"note\":\"{percent}% of the {count} tracked indie games with a price listed in {currency} cost under {currency}10.\",\"footnote\":\"Store prices as listed on Steam in {currency}; games with no published price - or priced in another storefront currency - are excluded.\",\"free\":\"Free\",\"under5\":\"Under {currency}5\",\"from5to10\":\"{currency}5 - {currency}10\",\"from10to20\":\"{currency}10 - {currency}20\",\"from20to30\":\"{currency}20 - {currency}30\",\"from30\":\"{currency}30+\"},\"platforms\":{\"title\":\"Platform support\",\"note\":\"{percent}% of tracked indie games support Linux.\",\"footnote\":\"Share of all {count} tracked games shipping a native build per platform.\"},\"community\":{\"title\":\"What the community is doing\",\"note\":\"Aggregated across every IndieBunny reader. Nothing here identifies anyone, and any figure backed by fewer than {minimum} people is withheld entirely.\",\"ratingsGiven\":\"Ratings given\",\"gamesRated\":\"Games rated\",\"gamesFollowed\":\"Games followed\",\"topRated\":\"Highest rated by readers\",\"mostFollowed\":\"Most followed\",\"bookmarkedGenres\":\"Genres readers bookmark\",\"mostUsedTags\":\"Most used community tags\",\"mostCompleted\":\"Most completed\",\"footnote\":\"Reader opinion, not Steam data - community tags are separate from the Steam tags above. Updated hourly.\"}},\"tags\":{\"metaTitle\":\"{name} Indie Games - News \u0026 Trailers\",\"metaDescription\":\"Indie game news, trailers and reviews tagged {name} on IndieBunny.\",\"metaDescriptionWithCount\":\"{count} indie game articles tagged {name} - news, trailers and reviews on IndieBunny.\",\"metaDescriptionWithGames\":\"{count} indie game articles tagged {name}, including {games} - news, trailers and reviews on IndieBunny.\",\"ogTitle\":\"{name} - Indie Game News\",\"collectionDescription\":\"Articles tagged {name} on IndieBunny\",\"articleCount\":\"{count} articles\",\"empty\":\"No articles found with this tag.\"},\"topLists\":{\"index\":{\"metaTitle\":\"Top 10s\",\"metaDescription\":\"Ranked Top 10 lists of the best indie games - hand-picked by the IndieBunny editorial team.\",\"ogTitle\":\"Top 10 Indie Game Lists | IndieBunny\",\"breadcrumb\":\"Top 10s\",\"heading\":\"Top 10s\",\"intro\":\"Ranked lists of the best indie games - hand-picked and ordered by our editorial team.\",\"anticipatedFallbackLabel\":\"Most Anticipated Indie Games\",\"seeAll\":\"See all 50 →\",\"lastUpdated\":\"Last updated \u003ctime\u003e{date}\u003c/time\u003e.\",\"communityEmpty\":\"Not enough ratings yet - rate the games you have played and this fills in.\",\"ratingCount\":\"{count, plural, one {# rating} other {# ratings}}\",\"editorialHeading\":\"Editorial Top 10s\",\"empty\":\"No Top 10 lists published yet - stay tuned!\",\"topBadge\":\"Top {count}\"},\"detail\":{\"notTranslated\":\"This list is not available in {language} yet - showing the English version.\",\"metaDescriptionFallback\":\"{title} - ranked by IndieBunny.\",\"topBadge\":\"Top {count}\",\"viewOnSteam\":\"View on Steam\",\"trailer\":\"Trailer\",\"readOurCoverage\":\"Read our coverage\"},\"ranking\":{\"popularcomingsoon\":{\"label\":\"Most Anticipated Indie Games\",\"methodology\":\"Position in Steam's Popular Upcoming list, which Steam orders by wishlist activity. We record the order once a day and show how it moves. Steam does not publish wishlist numbers, so no exact figure is shown.\"},\"popularnew\":{\"label\":\"Trending New Indie Games\",\"methodology\":\"Position in Steam's Popular New Releases list. We record the order once a day and show how it moves.\"},\"community\":{\"label\":\"Community Favorites\",\"methodology\":\"Ranked from IndieBunny reader ratings. A game needs at least {minVotes} ratings to appear, and scores are weighted so a game with a handful of ratings cannot outrank one rated by many people.\"}}},\"upcoming\":{\"metaTitle\":\"Upcoming Indie Game Releases - Release Calendar\",\"metaDescription\":\"All upcoming indie game releases in one calendar: release dates, prices and the most wishlisted titles on Steam.\",\"ogTitle\":\"Upcoming Indie Game Releases - Release Calendar | IndieBunny\",\"breadcrumb\":\"Upcoming Releases\",\"heading\":\"Release Calendar\",\"intro\":\"Upcoming indie game releases, synced from Steam's most anticipated list. Dates can shift - we refresh this calendar several times a day.\",\"fullCalendarLink\":\"Full release calendar →\",\"empty\":\"No upcoming releases right now - check back soon.\",\"comingLater\":\"Coming later\"},\"widgets\":{\"snippet\":{\"copyAria\":\"Copy snippet\",\"copy\":\"Copy\",\"copied\":\"Copied\"},\"badge\":{\"label\":\"Your IndieBunny coverage URL (article or game page)\",\"errorHost\":\"Please paste an {host} URL (your article or game page).\",\"errorInvalid\":\"That doesn't look like a valid URL.\"}}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L11\"}]\n"])</script><script nonce="OGY4YTU1NGYtYjEzZC00NzhlLTk4MDQtNThlNWUzNjBkYzlh">self.__next_f.push([1,"11:[\"$\",\"$L12\",null,{\"clie
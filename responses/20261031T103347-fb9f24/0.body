n link to complete your subscription.\",\"placeholder\":\"Your email address..\",\"submitting\":\"Subscribing...\",\"submit\":\"Subscribe\",\"error\":\"Failed to subscribe. Please try again.\",\"duplicate\":\"This email is already subscribed. Please check your inbox for the confirmation email.\",\"disclaimer\":\"By subscribing to our newsletter, you confirm that you have read and understood our \u003cprivacy\u003eprivacy policy\u003c/privacy\u003e. After subscribing, we will send you an email as part of the double opt-in process. This email will contain a confirmation link that you must click to complete your subscription. Without this confirmation, your subscription will not be activated.\"}},\"forYou\":{\"metaTitle\":\"Recommended indie games\",\"ogTitle\":\"Recommended indie games | IndieBunny\",\"description\":\"Indie game recommendations based on what you rate, follow and save - with the reason behind every suggestion.\",\"heading\":\"Recommended for you\",\"loading\":\"Finding games for you…\",\"empty\":\"Nothing to suggest yet. Rate or follow a few games and come back.\",\"turnOff\":\"You can turn personalisation off in \u003clink\u003eyour settings\u003c/link\u003e.\",\"newGround\":\"New ground\",\"match\":\"{percent}% match\"},\"games\":{\"free\":\"Free\",\"nav\":{\"aria\":\"{game} quick links\",\"hub\":\"Game hub\",\"news\":\"News\",\"releaseDate\":\"Release date\",\"trailer\":\"Trailer\",\"screenshots\":\"Screenshots\",\"systemRequirements\":\"System requirements\"},\"factBox\":{\"aria\":\"{game} facts\",\"heading\":\"{game} - Facts\",\"tba\":\"TBA\",\"upcoming\":\"{date} (upcoming)\",\"freeToPlay\":\"Free to Play\",\"windows\":\"PC (Windows)\",\"releaseDate\":\"Release date\",\"developer\":\"Developer\",\"developers\":\"Developers\",\"publisher\":\"Publisher\",\"publishers\":\"Publishers\",\"platforms\":\"Platforms\",\"genres\":\"Genres\",\"steamTags\":\"Steam tags\",\"price\":\"Price\",\"viewOnSteam\":\"View on Steam\",\"officialWebsite\":\"Official website\",\"gameHub\":\"Game hub →\"},\"reactions\":{\"heading\":\"What do you think?\",\"aria\":\"Reactions\",\"communityTags\":\"Community tags\",\"tagsNote\":\"Reader opinion, not Steam's tags. Shown publicly once {count} people agree.\"},\"trailer\":{\"playAria\":\"Play the {game} trailer, loaded from Steam\",\"notice\":\"Play trailer - the video is loaded directly from Steam (Valve), which will receive your IP address.\"},\"screenshots\":{\"openAria\":\"Open screenshot {index} of {total}\",\"alt\":\"{game} screenshot {index}\",\"close\":\"Close\",\"previous\":\"Previous screenshot\",\"next\":\"Next screenshot\"},\"requirements\":{\"minimum\":\"Minimum\",\"recommended\":\"Recommended\"},\"studioUpdates\":{\"heading\":\"From the studio\",\"announcedBy\":\"announced by {name}\"},\"poll\":{\"editorialAsks\":\"IndieBunny asks\",\"studioAsks\":\"The studio asks\",\"yourPick\":\"your pick\",\"votes\":\"{count, plural, one {# vote} other {# votes}}\",\"totalVotes\":\"{count, plural, one {# vote.} other {# votes.}}\",\"error\":\"Your vote could not be recorded.\",\"closed\":\"This poll has closed.\",\"thanks\":\"Thanks - your vote is in.\",\"pickOne\":\"Pick one.\",\"percentageNote\":\"Percentages appear once {count} people have voted.\"},\"status\":{\"set\":\"Set status\",\"changeAria\":\"Your status for {game}: {label}. Change it.\",\"setAria\":\"Set your status for {game}\",\"error\":\"Could not save - please try again.\",\"interested\":\"Interested\",\"wishlisted\":\"Wishlisted\",\"waitingForRelease\":\"Waiting for release\",\"waitingForDemo\":\"Waiting for a demo\",\"playing\":\"Playing\",\"completed\":\"Completed\",\"dropped\":\"Dropped\"},\"actions\":{\"upvoteAria\":\"Upvote {game}\",\"removeUpvoteAria\":\"Remove your upvote for {game}\",\"upvoteTitle\":\"Upvote this game\",\"removeUpvoteTitle\":\"Remove upvote\",\"bookmarkAria\":\"Bookmark {game}\",\"removeBookmarkAria\":\"Remove {game} from bookmarks\",\"bookmarkTitle\":\"Save for later\",\"removeBookmarkTitle\":\
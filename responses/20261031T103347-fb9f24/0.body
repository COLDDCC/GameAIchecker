e\":\"Announced indie games without a confirmed day - Steam still lists them as a window (“Q4 2026”) or as “coming soon”.\",\"covered\":\"Covered\",\"day\":\"{weekday}, {date}\"},\"my\":{\"metaTitle\":\"My calendar\",\"heading\":\"My calendar\",\"fullCalendarLink\":\"Full release calendar →\",\"emptyHeading\":\"Your calendar is empty\",\"emptyBody\":\"Follow games, bookmark them, set a status or follow a studio, and their release dates collect here.\",\"browseCalendar\":\"Browse the full calendar\",\"windowAll\":\"All\",\"windowWeek\":\"This week\",\"windowWeekend\":\"This weekend\",\"windowDated\":\"Dated\",\"windowUndated\":\"No date yet\",\"platform\":\"Platform\",\"any\":\"Any\",\"genre\":\"Genre\",\"freeOnly\":\"Free only\",\"freeUnreleased\":\"Free \u0026 unreleased\",\"subscribeHeading\":\"Subscribe in your calendar app\",\"subscribeNote\":\"A private feed that updates itself. Anyone with the link can see your calendar, so keep it to yourself - you can replace it at any time.\",\"copied\":\"Copied\",\"copy\":\"Copy\",\"newLink\":\"New link\",\"preparing\":\"Preparing…\",\"getLink\":\"Get my calendar link\",\"shown\":\"{shown} of {total} games shown\",\"noMatches\":\"Nothing matches those filters.\",\"reasonFollowed\":\"Following\",\"reasonBookmarked\":\"Saved\",\"reasonStatus\":\"On your list\",\"reasonStudio\":\"Followed studio\"}},\"cards\":{\"by\":\"By\",\"reviewScore\":\"Review score {score} out of 10\",\"views\":\"{count} views\",\"latest\":{\"title\":\"Latest\",\"linkLabel\":\"See all\",\"more\":\"See more articles\"},\"videoSlider\":{\"title\":\"Featured Videos\",\"ariaLabel\":\"Featured videos\"}},\"categories\":{\"label\":\"Category\",\"articleCount\":\"{count, plural, one {# article} other {# articles}}\",\"empty\":\"No articles found in this category.\",\"more\":\"More {name}\",\"metaTitle\":\"{name} Indie Games - News \u0026 Trailers\",\"metaDescription\":\"Indie {name} games - news, trailers and reviews on IndieBunny.\",\"metaDescriptionWithCount\":\"{count} indie {name} articles{games} - news, trailers and reviews on IndieBunny.\",\"including\":\", including {games}\",\"collectionName\":\"{name} - Indie Game News\",\"collectionDescription\":\"Indie {name} games on IndieBunny\",\"ogTitle\":\"{name} - Indie Game News\"},\"collections\":{\"metaTitle\":\"My collections\",\"heading\":\"My collections\",\"visibilityPrivate\":\"Private\",\"visibilityPrivateHint\":\"Only you can see it.\",\"visibilityUnlisted\":\"Unlisted\",\"visibilityUnlistedHint\":\"Anyone with the link can see it.\",\"visibilityPublic\":\"Public\",\"visibilityPublicHint\":\"Anyone can find and see it.\",\"createFailed\":\"Could not create that collection.\",\"networkError\":\"Network error - please try again.\",\"visibilityFailed\":\"Could not change visibility - please try again.\",\"deleteFailed\":\"Could not delete that collection - please try again.\",\"chooseTitle\":\"Choose a collection\",\"chooseHint\":\"Names come from a fixed set, so collections never need moderating.\",\"allUsed\":\"You already have one of every collection.\",\"cancel\":\"Cancel\",\"newCollection\":\"New collection\",\"emptyTitle\":\"No collections yet\",\"emptyBody\":\"Collections are lists you build from games, articles and studios - keep them private or share them with a link.\",\"entryCount\":\"{count, plural, one {# entry} other {# entries}}\",\"copyLinkLabel\":\"Copy the link to {title}\",\"copied\":\"Copied\",\"copyLink\":\"Copy link\",\"deleteLabel\":\"Delete {title}\",\"delete\":\"Delete\",\"visibilityLegend\":\"Visibility for {title}\"},\"comments\":{\"heading\":\"Comments ({count})\",\"submitted\":\"Your comment has been submitted and is awaiting moderation.\",\"cancel\":\"Cancel\",\"reply\":\"Reply\",\"namePlaceholder\":\"Your name\",\"replyPlaceholder\":\"Your reply...\",\"submitting\":\"Submitting...\",\"submitReply\":\"Submit Reply\",\"leaveComment\":\"Leave a Comment\",\"nameRequiredPlaceholder\":\"Your name *\",\"emailPlaceholder\":\"Your email (optional)\",\"commentPlaceholder\":\"Write your comment...\",\"submitComment\":\"Submit Comment\",\"loading\":\"Loading comments...\",\"empty\":\"No comments yet. Be the first to comment!\"},\"common\":{\"siteName\":\"IndieBunny\",\"home\":\"Home\",\"loading\":\"Loading…\",\"readMore\":\"Read more\",\"viewAll\":\"View all\",\"loadMore\":\"Load more\",\"back\":\"Back\",\"close\":\"Close\",\"cancel\":\"Cancel\",\"save\":\"Save\",\"delete\":\"Delete\",\"edit\":\"Edit\",\"submit\":\"Submit\",\"tba\":\"TBA\",\"yes\":\"Yes\",\"no\":\"No\",\"error\":\"Something went wrong. Please try again.\",\"minRead\":\"{minutes} min read\",\"articles\":\"{count, plural, one {# article} other {# articles}}\",\"updated\":\"Updated\",\"advertisement\":\"Advertisement\",\"loadingLabel\":\"Loading\",\"rssFeed\":\"RSS feed\",\"scrollBackwards\":\"Scroll backwards\",\"scrollForwards\":\"Scroll forwards\",\"backToTop\":\"Back to top\",\"jumpToFooter\":\"Jump to the footer\",\"jumpToFooterLong\":\"Jump to the footer with imprint, privacy and legal links\",\"bookmark\":{\"add\":\"Bookmark {name}\",\"remove\":\"Remove {name} from bookmarks\",\"saveForLater\":\"Save for later\",\"removeBookmark\":\"Remove bookmark\",\"saved\":\"Saved\",\"save\":\"Save\"},\"report\":{\"trigger\":\"Report\",\"heading\":\"Report {name}\",\"done\":\"Thanks - our team will review this. For formal copyright notices see our \u003cdmca\u003eDMCA page\u003c/dmca\u003e.\",\"reason\":\"Reason\",\"reasons\":{\"infringing_content\":\"Copyright / trademark infringement\",\"impersonation\":\"Impersonation\",\"inappropriate\":\"Inappropriate content\",\"spam\":\"Spam\",\"other\":\"Something else\"},\"details\":\"Details\",\"detailsPlaceholder\":\"What is wrong with this page?\",\"email\":\"Your email\",\"emailOptional\":\"(optional)\",\"sendError\":\"Could not send the report.\",\"networkError\":\"Network error. Please try again.\",\"sending\":\"Sending…\",\"submit\":\"Send report\"},\"genrePending\":\"Genre pending\"},\"consent\":{\"title\":\"Cookies \u0026 advertising\",\"intro\":\"We show advertising through \u003cb\u003eGoogle AdSense\u003c/b\u003e and embed content from Google (Subscribe with Google, YouTube). These services set cookies and receive your IP address, and may use them to measure and personalise ads.\",\"declineExplainer\":\"If you decline, none of them are loaded - no ads, no third-party cookies. Our own statistics (Plausible) run without cookies either way. Details in our \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e. You can change this any time via “Cookies” in the footer.\",\"accept\":\"Accept\",\"decline\":\"Decline\",\"settingsLink\":\"Cookies\",\"youtube\":{\"notice\":\"This video is hosted on YouTube. To play it, please accept cookies for external content.\",\"accept\":\"Accept\"}},\"dashboard\":{\"common\":{\"breadcrumbDashboard\":\"Dashboard\",\"breadcrumbGames\":\"Games\",\"breadcrumbStudio\":\"Studio\",\"networkError\":\"Network error - please try again.\",\"sessionExpired\":\"Your session expired - please sign in again.\",\"loadStudioError\":\"We couldn't load your studio right now. Please reload the page in a moment.\",\"studioEmail\":\"hello@indiebunny.com\"},\"nav\":{\"heading\":\"Studio dashboard\",\"overview\":\"Overview\",\"studio\":\"Studio profile\",\"games\":\"Games\",\"updates\":\"Updates\",\"polls\":\"Polls\",\"analytics\":\"Analytics\",\"team\":\"Team\",\"claim\":\"Claim status\",\"backToAccount\":\"Back to my account\"},\"shell\":{\"breadcrumb\":\"Breadcrumb\"},\"accountNotice\":{\"subtitle\":\"For developer and studio accounts\",\"heading\":\"This area is for studio accounts\",\"body\":\"The studio dashboard is where developers claim their studio page, manage their games and submit them for coverage. Your account is registered as a regular reader, so there is nothing to manage here yet.\",\"contact\":\"If you make games and want a studio page on IndieBunny, write to \u003cmail\u003ehello@indiebunny.com\u003c/mail\u003e and we'll switch your account over.\",\"backToAccount\":\"Back to my account\"},\"overview\":{\"metaTitle\":\"Studio dashboard\",\"title\":\"Studio dashboard\",\"onboardingSubtitle\":\"Two ways to get started - claim the page we already have, or build a new one.\",\"recommended\":\"Recommended\",\"claimHeading\":\"Claim your existing studio\",\"claimBody\":\"Most studios already have a page here - we build them from our Steam coverage. Claim yours to take over the profile, keep its history and start managing your games.\",\"claimCta\":\"Find my studio\",\"notListedYet\":\"Not listed yet\",\"createHeading\":\"Create a new studio profile\",\"createBody\":\"Brand new, or nothing of yours on Steam yet? Set up a fresh studio profile from scratch - you can add your games right after.\",\"createCta\":\"Create a studio\",\"subtitle\":\"Everything about your studio page and your games lives here.\",\"editProfile\":\"Edit profile\",\"suspendedTitle\":\"This studio is suspended.\",\"suspendedBody\":\"Editing and uploads are disabled while it is under review. Write to \u003cmail\u003ehello@indiebunny.com\u003c/mail\u003e if you think this is a mistake.\",\"studioSection\":\"Studio\",\"verified\":\"Verified\",\"unverified\":\"Unverified\",\"viewPublicPage\":\"View public studio page\",\"verifyStudio\":\"Verify studio\",\"gamesSection\":\"Games\",\"noGames\":\"No games yet. Add your first one and submit it for review when it's ready.\",\"addGame\":\"Add a game\",\"manageGames\":\"Manage {count, plural, one {# game} other {# games}}\",\"newGame\":\"New game\",\"storageSection\":\"Storage\",\"storageHint\":\"Screenshots, key art and press kit files count towards this. Delete unused assets on a game's Assets tab to free space up.\",\"quickLinksSection\":\"Quick links\",\"quickLinkStudio\":\"Studio profile\",\"quickLinkGames\":\"Games\",\"quickLinkClaim\":\"Claim status\"},\"analytics\":{\"metaTitle\":\"Studio analytics\",\"title\":\"Studio analytics\",\"subtitle\":\"What readers do with your studio and its games - aggregated, never individual.\",\"loading\":\"Loading analytics…\",\"forbidden\":\"Your role does not include analytics.\",\"loadFailed\":\"Could not load analytics.\",\"period\":\"Period\",\"range7\":\"7 days\",\"range30\":\"30 days\",\"range90\":\"90 days\",\"range365\":\"12 months\",\"sparkline\":\"Trend over {days} days, peak {peak}\",\"nothingYet\":\"No page views recorded in this period yet. Counting started when this feature shipped, so earlier activity is not included.\",\"readerActivity\":\"Reader activity\",\"averageNeedsMore\":\"An average rating appears once at least {min} people have rated your games.\",\"derived\":{\"followers\":\"Followers\",\"new_followers\":\"New followers\",\"bookmarks\":\"Bookmarks\",\"collection_adds\":\"List additions\",\"ratings\":\"Ratings given\",\"rating_average\":\"Average rating\",\"release_reminders\":\"Release reminders\"},\"topGames\":\"Most viewed games\",\"topGamesEmpty\":\"No game reached the reporting threshold in this period.\",\"byPlatform\":\"Interest by platform\",\"byGenre\":\"Interest by genre\",\"notEnoughViews\":\"Not enough views yet to break this down.\",\"reactions\":\"Reactions readers picked\",\"reactionsEmpty\":\"No reactions have reached the reporting threshold.\",\"tags\":\"Community tags applied\",\"tagsEmpty\":\"No tags have reached the reporting threshold.\"},\"claim\":{\"metaTitle\":\"Claim or verify your studio\",\"noticeTitle\":\"Claim your studio\",\"titleVerify\":\"Verify your studio\",\"titleClaim\":\"Claim your studio\",\"subtitleVerify\":\"Prove the studio is yours to unlock updates, polls and the verified badge.\",\"subtitleClaim\":\"Take over the studio page we already built from our Steam coverage.\",\"loading\":\"Loading your claim status…\",\"loadError\":\"We couldn't load your claim status. Please reload the page.\",\"alreadyVerifiedHeading\":\"You already manage {name}, and it is verified\",\"alreadyVerifiedBody\":\"One studio per account, so there is nothing left to claim. Head back to the dashboard to manage your games.\",\"backToDashboard\":\"Back to dashboard\",\"notListed\":\"Not listed? \u003clink\u003eCreate a new studio profile\u003c/link\u003e.\",\"copy\":\"Copy\",\"copied\":\"Copied\",\"yourStudio\":\"your studio\",\"verificationInProgress\":\"Verification in progress\",\"claimInProgress\":\"Claim in progress\",\"confirmFailed\":\"We couldn't verify this claim.\",\"cancelFailed\":\"The claim could not be cancelled.\",\"verifiedReverify\":\"Verified - your studio badge is back.\",\"verifiedClaim\":\"Verified - your studio is yours to manage now.\",\"manualTitle\":\"Our team is reviewing your request.\",\"manualBody\":\"We check manual claims by hand and usually reply within a few days - watch your inbox. Nothing else to do for now.\",\"dnsIntro\":\"Add this TXT record to the DNS zone for \u003cb\u003e{domain}\u003c/b\u003e, then hit verify. It proves you control the domain itself.\",\"recordName\":\"Record name\",\"recordType\":\"Record type\",\"recordValue\":\"Record value\",\"dnsHint\":\"Some registrars want only \u003ccode\u003e{record}\u003c/code\u003e in the name field rather than the full host. DNS changes usually appear within a few minutes, but can take up to an hour.\",\"fileIntro\":\"Publish this file on \u003cb\u003e{domain}\u003c/b\u003e, then hit verify. It proves you control the studio's domain.\",\"fileName\":\"File name\",\"fileContent\":\"File content\",\"fileLocation\":\"Must be reachable at\",\"fileHint\":\"The file has to be served over HTTPS and contain the token above and nothing else.\",\"emailIntro\":\"We sent a 6-digit code to \u003cb\u003e{target}\u003c/b\u003e. Enter it below to finish the claim.\",\"emailFallbackTarget\":\"your address at {domain}\",\"verificationCode\":\"Verification code\",\"expiresOn\":\"This verification expires on {date}.\",\"checking\":\"Checking…\",\"verifyNow\":\"Verify now\",\"cancelVerification\":\"Cancel this verification\",\"cancelClaim\":\"Cancel this claim\",\"findYourStudio\":\"Find your studio\",\"findIntro\":\"Search for the studio name as it appears on Steam. Most studios are already here.\",\"studioName\":\"Studio name\",\"startTyping\":\"Start typing…\",\"searchFailed\":\"The search failed.\",\"searchFailedRetry\":\"The search failed - please retry.\",\"searching\":\"Searching…\",\"noMatches\":\"No studio matches that name.\",\"alreadyClaimed\":\"Already claimed\",\"claimAction\":\"Claim\",\"proveHeading\":\"Prove you represent {name}\",\"startVerification\":\"Start verification\",\"starting\":\"Starting…\",\"pickAnother\":\"Pick a different studio\",\"localPartError\":\"Enter the part before the @ - for example \\\"hello\\\".\",\"evidenceError\":\"Please describe how we can confirm this (at least {min} characters).\",\"startFailed\":\"The verification could not be started.\",\"startUnreadable\":\"The verification started but we couldn't read the response. Please reload.\",\"methodLabel\":\"Verification method\",\"methodFile\":\"Upload a file to your website (fastest)\",\"methodDns\":\"Add a DNS TXT record (strongest proof)\",\"methodEmail\":\"Email code to an address on your domain\",\"methodManual\":\"Ask a human to review it\",\"fileMethodInfo\":\"We'll give you a small text file to publish on the studio's website. Once it's live, one click finishes the claim.\",\"dnsMethodInfo\":\"We'll give you a TXT record to add to the studio domain's DNS. It proves control of the domain itself rather than just the website, so it also works when the site is hosted somewhere you can't upload files.\",\"emailMethodInfo\":\"We send a 6-digit code to an address on the studio's own domain. Enter just the part before the @ - we pick the domain from what we have on file.\",\"localPartLabel\":\"Address (part before the @)\",\"localPartPlaceholder\":\"hello\",\"evidenceLabel\":\"How can we confirm this is your studio?\",\"evidencePlaceholder\":\"Link to a post from the studio account, your role, a press contact - anything we can check.\",\"evidenceHint\":\"A human reads this, so specifics help.\",\"reverifyHeading\":\"{name} is not verified yet\",\"reverifyBody\":\"You manage this studio, but nobody has proved the domain belongs to it. Verifying adds the badge to your public page and unlocks studio updates and player polls - both of them post publicly under your studio name, which is why we ask first.\",\"reverifyMethodsHeading\":\"Verify {name}\",\"noWebsiteInfo\":\"We have no website on file for this studio, so the file, DNS and email proofs are not available yet. \u003clink\u003eAdd your studio website\u003c/link\u003e and they become one-click - or ask a human to review it below.\"},\"games\":{\"metaTitle\":\"My games\",\"title\":\"My games\",\"subtitle\":\"Drafts, submissions and everything already live.\",\"newGame\":\"New game\",\"needStudio\":\"You need a studio profile before you can add games. \u003clink\u003eClaim or create your studio\u003c/link\u003e to get started.\",\"emptyTitle\":\"No games yet\",\"emptyBody\":\"Add your first game, fill in the details and upload a few screenshots - then submit it for review.\",\"fromSteam\":\"From Steam\",\"edit\":\"Edit\",\"imageCount\":\"{count, plural, one {# image} other {# images}}\",\"updated\":\"Updated {date}\",\"noDate\":\"-\",\"rejectedFallback\":\"A moderator sent this back. Update the details and submit it again.\"},\"gameNew\":{\"metaTitle\":\"New game\",\"title\":\"New game\",\"subtitle\":\"Start with a title - you can fill in the rest right after.\",\"needStudioHeading\":\"Set up your studio first\",\"needStudioBody\":\"Games belong to a studio, so you need a studio profile before you can add one.\",\"claimCta\":\"Claim my studio\",\"createCta\":\"Create a new one\",\"suspended\":\"This studio is suspended, so new games can't be added right now.\",\"titleRequired\":\"A game title is required.\",\"createFailed\":\"The game could not be created.\",\"createdUnreadable\":\"The game was created but we couldn't open it. Check your games list.\",\"basics\":\"The basics\",\"gameTitle\":\"Game title\",\"gameTitlePlaceholder\":\"Carrot Quest\",\"gameTitleHint\":\"You can rename it later, but the page URL stays as it was created.\",\"tagline\":\"Tagline\",\"taglinePlaceholder\":\"A cozy roguelike about growing the perfect garden.\",\"taglineHint\":\"Optional - one line that sums the game up.\",\"creating\":\"Creating…\",\"createDraft\":\"Create draft\"},\"gameEditor\":{\"metaTitle\":\"Edit game\",\"noticeTitle\":\"Edit game\",\"view\":\"View\",\"readOnlyTitle\":\"This game is maintained from Steam data.\",\"readOnlyBody\":\"Its details are refreshed from Steam automatically, so they can't be edited here. \u003clink\u003eOpen its hub page\u003c/link\u003e. If this is your game, claiming your studio links it to your account.\",\"tablist\":\"Game editor sections\",\"tabDetails\":\"Details\",\"tabAssets\":\"Assets\",\"tabPublish\":\"Publish\",\"titleEmpty\":\"The title cannot be empty.\",\"saveFailed\":\"Your changes could not be saved.\",\"changesSaved\":\"Changes saved.\",\"aboutTheGame\":\"About the game\",\"titleLabel\":\"Title\",\"taglineLabel\":\"Tagline\",\"taglineHint\":\"One line that sums the game up.\",\"descriptionLabel\":\"Description\",\"descriptionHint\":\"At least {min} characters are needed before you can submit for review.\",\"genresSection\":\"Genres\",\"genresHint\":\"Pick everything that fits - at least one is required.\",\"platformsSection\":\"Platforms \u0026 release\",\"releaseStatusLabel\":\"Release status\",\"notSet\":\"Not set\",\"releaseDateLabel\":\"Release date\",\"releaseDateTextLabel\":\"Release date (text)\",\"releaseDateTextPlaceholder\":\"Q3 2026\",\"releaseDateTextHint\":\"Used when you only know a window, not a day.\",\"priceLabel\":\"Price\",\"pricePlaceholder\":\"€14.99\",\"freeToPlay\":\"This game is free to play\",\"linksSection\":\"Links\",\"pressKitLabel\":\"Press kit URL\",\"websiteLabel\":\"Studio website for this game\",\"linksHint\":\"Links have to start with http:// or https:// - anything else is dropped.\",\"saving\":\"Saving…\",\"saveChanges\":\"Save changes\",\"unsavedChanges\":\"You have unsaved changes.\",\"storageSection\":\"Storage\",\"uploadSection\":\"Upload a file\",\"chooseFile\":\"Choose a file to upload.\",\"fileTooBig\":\"“{name}” is {size}. Files can be at most {max} - please export a smaller version.\",\"uploadFailed\":\"The file could not be uploaded.\",\"altSaveFailed\":\"The description could not be saved.\",\"deleteFailed\":\"The file could not be deleted.\",\"reorderFailed\":\"The new order could not be saved.\",\"reorderNetworkError\":\"Network error - the new order was not saved.\",\"typeLabel\":\"Type\",\"fileLabel\":\"File\",\"perFileLimit\":\"Up to {max} per file.\",\"altLabel\":\"Description (alt text)\",\"altPlaceholder\":\"The player tending a moonlit garden\",\"altHint\":\"Describes the image for screen readers and search engines.\",\"uploading\":\"Uploading…\",\"upload\":\"Upload\",\"filesSection\":\"Files\",\"fileCount\":\"{count, plural, one {# file} other {# files}}\",\"noFiles\":\"Nothing uploaded yet. Screenshots and key art are what make a submission reviewable.\",\"documentFallback\":\"Document\",\"assetDescription\":\"Description\",\"save\":\"Save\",\"moveEarlier\":\"Move earlier\",\"moveLater\":\"Move later\",\"deleteAsset\":\"Delete {name}\",\"submitFailed\":\"This game could not be submitted.\",\"submitted\":\"Submitted for review.\",\"currentStatus\":\"Current status\",\"moderatorNote\":\"A moderator sent this back:\",\"pendingBody\":\"We're looking at it - submissions are usually live within 24 hours.\",\"publishedBody\":\"This game is live. Edits stay published as long as they keep meeting the requirements below.\",\"requirements\":\"Publish requirements\",\"requirementMet\":\"Requirement met\",\"requirementNotMet\":\"Not met yet\",\"notReady\":\"Not ready to publish\",\"submitSection\":\"Submit for review\",\"submitBody\":\"A human checks every submission. You'll get an email when it goes live or if we need anything else.\",\"unsavedOnDetails\":\"You have unsaved changes on the Details tab. We review what's stored, so save them first.\",\"submitting\":\"Submitting…\",\"alreadySubmitted\":\"Already submitted\",\"submitForReview\":\"Submit for review\"},\"gate\":{\"titleLabel\":\"Game title\",\"descriptionLabel\":\"Description of at least {min} characters\",\"descriptionDetail\":\"{length} / {min} characters\",\"genresLabel\":\"At least one genre\",\"genresDetail\":\"{count, plural, one {# genre selected} other {# genres selected}}\",\"platformsLabel\":\"At least one platform\",\"platformsDetail\":\"{count, plural, one {# platform selected} other {# platforms selected}}\",\"releaseStatusLabel\":\"Release status\",\"assetsLabel\":\"At least {min} images\",\"assetsDetail\":\"{count} / {min} images uploaded\"},\"polls\":{\"metaTitle\":\"Polls\",\"title\":\"Polls\",\"subtitle\":\"Ask your players a question with a fixed set of answers.\",\"loading\":\"Loading polls…\",\"minOptions\":\"Give at least {min} answers.\",\"createFailed\":\"Could not create that poll.\",\"created\":\"Poll is live.\",\"actionFailed\":\"That did not work.\",\"confirmClose\":\"Stop taking votes on \\\"{question}\\\"? Results stay visible.\",\"confirmDelete\":\"Delete \\\"{question}\\\"? The votes go with it.\",\"verifyFirst\":\"Verify your studio before running polls - a poll appears publicly under your studio name. \u003clink\u003eVerify your studio →\u003c/link\u003e\",\"composerHeading\":\"Ask your players something\",\"composerBody\":\"Readers pick one of your answers. There is no free-text option and no comment field.\",\"questionLabel\":\"Question\",\"questionPlaceholder\":\"Which platform should we prioritise next?\",\"questionHint\":\"Up to 200 characters.\",\"answersLegend\":\"Answers\",\"answerPlaceholder\":\"Answer {index}\",\"removeAnswer\":\"Remove answer {index}\",\"addAnswer\":\"Add an answer\",\"gameLabel\":\"About a game (optional)\",\"gameAll\":\"The studio in general\",\"runsForLabel\":\"Runs for\",\"days7\":\"7 days\",\"days14\":\"14 days\",\"days30\":\"30 days\",\"days90\":\"90 days\",\"visibilityLabel\":\"Who sees results\",\"visibilityAfterVote\":\"After they vote\",\"visibilityAlways\":\"Everyone, always\",\"visibilityAfterClose\":\"Only once it closes\",\"minVotesLabel\":\"Votes before percentages\",\"minVotesHint\":\"Below that many votes we show raw counts instead of percentages - a percentage of four people reads as a finding when it is not one.\",\"creating\":\"Creating…\",\"startPoll\":\"Start the poll\",\"yourPolls\":\"Your polls\",\"emptyTitle\":\"No polls yet\",\"emptyBody\":\"A poll appears on your studio page, and on the game page if you pick one.\",\"open\":\"Open\",\"closed\":\"Closed\",\"voteCount\":\"{count, plural, one {# vote} other {# votes}}\",\"close\":\"Close\",\"deletePoll\":\"Delete {question}\"},\"studioProfile\":{\"metaTitle\":\"Studio profile\",\"title\":\"Studio profile\",\"subtitle\":\"How your studio shows up across IndieBunny.\",\"noStudioHeading\":\"You don't have a studio yet\",\"noStudioBody\":\"Claim the page we already have for your studio, or create a new profile from scratch.\",\"claimCta\":\"Claim my studio\",\"createCta\":\"Create a new one\",\"viewPublicPage\":\"View public page\",\"verifiedStudio\":\"Verified studio\",\"notVerifiedTitle\":\"This studio isn't verified yet.\",\"notVerifiedBody\":\"Verifying proves the studio is yours. It adds the badge to your public page and unlocks studio updates and player polls.\",\"verifyLink\":\"Verify this studio →\",\"suspended\":\"This studio is suspended, so the profile is read-only for now. Write to \u003cmail\u003ehello@indiebunny.com\u003c/mail\u003e if you think this is a mistake.\"},\"studioNew\":{\"metaTitle\":\"Create a studio profile\",\"title\":\"Create a studio profile\",\"subtitle\":\"For studios that aren't in our catalog yet.\",\"info\":\"Most studios already have a page here, built from our Steam coverage. Creating a duplicate isn't possible - if the name is taken, we'll point you at the \u003cb\u003eclaim flow\u003c/b\u003e instead.\"},\"studioForm\":{\"nameRequired\":\"A studio name is required.\",\"saveFailed\":\"We couldn't save your studio profile.\",\"saved\":\"Studio profile saved.\",\"claimInstead\":\"Claim the existing studio instead\",\"logoTooBig\":\"Logos can be at most {max}.\",\"logoUploadFailed\":\"The logo could not be uploaded.\",\"logoRemoveFailed\":\"The logo could not be removed.\",\"basics\":\"Basics\",\"nameLabel\":\"Studio name\",\"namePlaceholder\":\"Bunny Games\",\"nameHint\":\"This becomes your public studio page. It can't be changed to a different studio later.\",\"bioLabel\":\"About the studio\",\"bioPlaceholder\":\"Who you are, what you make, and what you're working on.\",\"bioHint\":\"Shown on your public studio page.\",\"countryLabel\":\"Country\",\"countryPlaceholder\":\"Not specified\",\"teamSizeLabel\":\"Team size\",\"foundedLabel\":\"Founded\",\"websiteLabel\":\"Website\",\"websiteHint\":\"Also used to verify ownership when you claim a studio.\",\"logoSection\":\"Logo\",\"logoAlt\":\"{name} logo\",\"logoNameFallback\":\"Studio\",\"noLogo\":\"No logo\",\"logoWorking\":\"Working…\",\"replaceLogo\":\"Replace logo\",\"uploadLogo\":\"Upload logo\",\"removeLogo\":\"Remove\",\"logoHint\":\"PNG, WebP or SVG, up to {max}. A square logo on a transparent background works best.\",\"socialsSection\":\"Social links\",\"noSocials\":\"No social links yet - add the accounts where you post about your games.\",\"platformLabel\":\"Platform\",\"profileUrlLabel\":\"Profile URL\",\"removeSocial\":\"Remove this social link\",\"addSocial\":\"Add a link\",\"saving\":\"Saving…\",\"createStudio\":\"Create studio\",\"saveChanges\":\"Save changes\",\"alreadyListed\":\"Already listed? Claim your studio instead\"},\"team\":{\"metaTitle\":\"Studio team\",\"title\":\"Studio team\",\"subtitle\":\"Give each person exactly the access they need - nothing more.\",\"loading\":\"Loading the team…\",\"loadFailed\":\"Could not load the team.\",\"inviteFailed\":\"Could not send the invitation.\",\"invited\":\"Invitation sent. It expires in 14 days if it isn't accepted.\",\"roleChangeFailed\":\"Could not change that role.\",\"removeFailed\":\"Could not remove that member.\",\"confirmLeave\":\"Leave this studio? You will lose access immediately.\",\"confirmRemove\":\"Remove {name} from the team? They lose access immediately.\",\"thisMember\":\"this member\",\"heading\":\"Team\",\"emptyTitle\":\"Nobody here yet\",\"emptyBody\":\"Invite the people who work on your games.\",\"invitationPending\":\"Invitation pending\",\"you\":\"(you)\",\"waitingToAccept\":\"Invited - waiting for them to accept\",\"roleFor\":\"Role for {name}\",\"leave\":\"Leave\",\"remove\":\"Remove\",\"inviteHeading\":\"Invite someone\",\"inviteBody\":\"They get an email with a link. Nothing changes until they accept it.\",\"atCapacity\":\"This studio has reached the {max}-member limit. Remove someone before inviting anyone else.\",\"emailLabel\":\"Email address\",\"emailPlaceholder\":\"teammate@studio.com\",\"roleLabel\":\"Role\",\"sending\":\"Sending…\",\"sendInvitation\":\"Send invitation\",\"readOnly\":\"Your role ({role}) can see the team but not change it. Ask an Owner or Admin to invite someone.\"},\"teamAccept\":{\"metaTitle\":\"Accept your invitation\",\"title\":\"Accept your invitation\",\"subtitle\":\"Join a studio team on IndieBunny.\",\"missingToken\":\"That link is missing its invitation code.\",\"acceptFailed\":\"That invitation could not be accepted.\",\"checking\":\"Checking your invitation…\",\"joined\":\"You joined {name}\",\"studioFallback\":\"the studio\",\"yourRole\":\"Your role is {role}.\",\"goToDashboard\":\"Go to the dashboard\",\"viewStudioPage\":\"View the studio page\",\"signedInAs\":\"You are signed in as \u003cb\u003e{email}\u003c/b\u003e. An invitation only works for the address it was sent to - if it went somewhere else, sign in with that account and open the link again.\",\"accountFallback\":\"this account\",\"backToDashboard\":\"Back to the dashboard\"},\"updates\":{\"metaTitle\":\"Studio updates\",\"title\":\"Studio updates\",\"subtitle\":\"Announce a demo, a date change or a new platform - no blog post required.\",\"loading\":\"Loading updates…\",\"publishFailed\":\"Could not publish that update.\",\"published\":\"Update published. It now appears on the game and studio pages.\",\"confirmRemove\":\"Take down \\\"{title}\\\"?\",\"removeFailed\":\"Could not remove that update.\",\"verifyFirst\":\"Verify your studio before publishing updates - an announcement carries your studio name onto public pages, so we need to know the studio is yours first. \u003clink\u003eVerify your studio →\u003c/link\u003e\",\"composerHeading\":\"Publish an update\",\"composerBody\":\"Pick what happened. We write the headline from a template - there is no free text field, so nothing here needs review before it goes live.\",\"needGame\":\"Add a game first - every update is about one of your games.\",\"typeLabel\":\"What happened?\",\"gameLabel\":\"Which game?\",\"dateLabel\":\"Date\",\"dateLabelOptional\":\"Date (optional)\",\"urlLabel\":\"Link to the announcement\",\"urlLabelOptional\":\"Link to the announcement (optional)\",\"urlPlaceholder\":\"https://store.steampowered.com/news/...\",\"urlHint\":\"https:// only.\",\"platformsLegend\":\"Platforms\",\"platformsLegendOptional\":\"Platforms (optional)\",\"generatedHint\":\"The headline and summary are generated. You cannot edit them - that is what keeps this feed free of anything that needs moderating.\",\"publishing\":\"Publishing…\",\"publish\":\"Publish update\",\"publishedHeading\":\"Published updates\",\"emptyTitle\":\"Nothing published yet\",\"emptyBody\":\"Announcements appear on your studio page and on the game they are about.\",\"takeDown\":\"Take down {title}\",\"remove\":\"Remove\"},\"ui\":{\"storageUsed\":\"Storage used\",\"storageOf\":\"of {quota}\"},\"fields\":{\"minCounter\":\"{length} / {min} min\"},\"status\":{\"draft\":\"Draft\",\"pendingReview\":\"Pending review\",\"inReview\":\"In review\",\"approved\":\"Approved\",\"published\":\"Published\",\"rejected\":\"Rejected\"},\"genres\":{\"action\":\"Action\",\"adventure\":\"Adventure\",\"rpg\":\"RPG\",\"strategy\":\"Strategy\",\"simulation\":\"Simulation\",\"puzzle\":\"Puzzle\",\"platformer\":\"Platformer\",\"roguelike\":\"Roguelike\",\"shooter\":\"Shooter\",\"horror\":\"Horror\",\"racing\":\"Racing\",\"sports\":\"Sports\",\"visualNovel\":\"Visual Novel\",\"metroidvania\":\"Metroidvania\",\"survival\":\"Survival\",\"sandbox\":\"Sandbox\",\"cardGame\":\"Card Game\",\"rhythm\":\"Rhythm\",\"pointAndClick\":\"Point \u0026 Click\",\"casual\":\"Casual\"},\"releaseStatus\":{\"in_development\":\"In development\",\"alpha\":\"Alpha\",\"beta\":\"Beta\",\"early_access\":\"Early access\",\"released\":\"Released\",\"cancelled\":\"Cancelled\"},\"assetKind\":{\"screenshot\":\"Screenshot\",\"keyart\":\"Key art\",\"logo\":\"Logo\",\"factsheet\":\"Factsheet (document)\",\"other\":\"Other\"},\"linkField\":{\"steam\":\"Steam page\",\"itch\":\"itch.io page\",\"website\":\"Game website\",\"trailer_url\":\"Trailer (YouTube)\",\"gog\":\"GOG page\",\"epic\":\"Epic Games Store\"},\"country\":{\"DE\":\"Germany\",\"AT\":\"Austria\",\"CH\":\"Switzerland\",\"US\":\"United States\",\"CA\":\"Canada\",\"GB\":\"United Kingdom\",\"IE\":\"Ireland\",\"FR\":\"France\",\"ES\":\"Spain\",\"IT\":\"Italy\",\"NL\":\"Netherlands\",\"BE\":\"Belgium\",\"PL\":\"Poland\",\"CZ\":\"Czechia\",\"SE\":\"Sweden\",\"NO\":\"Norway\",\"FI\":\"Finland\",\"DK\":\"Denmark\",\"PT\":\"Portugal\",\"BR\":\"Brazil\",\"MX\":\"Mexico\",\"AR\":\"Argentina\",\"AU\":\"Australia\",\"NZ\":\"New Zealand\",\"JP\":\"Japan\",\"KR\":\"South Korea\",\"CN\":\"China\",\"IN\":\"India\",\"SG\":\"Singapore\",\"ZA\":\"South Africa\"},\"vitals\":{\"metaTitle\":\"Core Web Vitals\",\"title\":\"Core Web Vitals\",\"loadFailed\":\"The report could not be loaded.\",\"intro\":\"Measured on real visits. Each row is the 75th percentile, which is how Core Web Vitals is assessed - an average would hide the slow tail that decides whether a page passes. Buckets with fewer than {min} samples are withheld, because a percentile over a handful of readings is not a measurement.\",\"range\":\"{from} → {to} · {samples} samples\",\"releaseSuffix\":\" · release {release}\",\"noSamples\":\"No samples yet. Data starts arriving once readers visit pages with the reporter deployed - the beacon only fires when a page is closed or backgrounded.\",\"days\":\"{days} days\",\"releaseLabel\":\"Release:\",\"releaseAll\":\"all\",\"needsAttention\":\"{count, plural, one {# bucket needs} other {# buckets need}} attention\",\"culprit\":\" - usually {culprit}\",\"colMetric\":\"Metric\",\"colDevice\":\"Device\",\"colSamples\":\"Samples\",\"colStatus\":\"Status\",\"statusGood\":\"Good\",\"statusNeedsWork\":\"Needs work\",\"statusPoor\":\"Poor\",\"privacy\":\"Samples carry no session or page-view identifier, no IP, no user agent and no URL - the path is reduced to a template in the browser before anything is sent. That is why this page can exist without a consent gate.\"}},\"developers\":{\"filter\":{\"searchPlaceholder\":\"Search {count} studios…\",\"searchAria\":\"Search developers and publishers\",\"jumpAria\":\"Jump to a letter\",\"noMatch\":\"No studio matches “{query}”.\",\"matchCount\":\"{count, plural, one {# match} other {# matches}}\",\"verifiedStudio\":\"Verified studio\",\"publisher\":\"Publisher\",\"gameCount\":\"{count, plural, one {# game} other {# games}}\"},\"followStudio\":{\"followAria\":\"Follow {name} for updates\",\"unfollowAria\":\"Stop following {name}\",\"followTitle\":\"Get new games, trailers and releases\",\"unfollowTitle\":\"Stop studio updates\",\"follow\":\"Follow studio\",\"following\":\"Following\",\"error\":\"Something went wrong - please try again.\"},\"index\":{\"metaTitle\":\"Indie Game Developer Database - {count}+ Studios \u0026 Publishers\",\"metaDescription\":\"Browse every indie studio and publisher IndieBunny tracks - {count} developers behind the games on Steam, A to Z, each with their own games and coverage.\",\"ogTitle\":\"{title} | IndieBunny\",\"breadcrumb\":\"Developers\",\"collectionName\":\"Indie Developer Database\",\"collectionDescription\":\"Every indie studio and publisher tracked by IndieBunny - {count} developers.\",\"heading\":\"Indie Developer Database\",\"intro\":\"{count} indie studios and publishers behind the games we track on Steam - sorted A to Z, each with their own page of games and coverage.\",\"introVerified\":\"{count} indie studios and publishers behind the games we track on Steam, {verified} of them verified - sorted A to Z, each with their own page of games and coverage.\",\"empty\":\"The developer database is being rebuilt - check back shortly.\"},\"detail\":{\"metaTitle\":\"{name} Games - News \u0026 Trailers\",\"metaDescription\":\"All IndieBunny coverage of games by {name} - news, trailers and reviews.\",\"metaDescriptionWithGames\":\"All IndieBunny coverage of games by {name}, including {games} - news, trailers and reviews.\",\"ogTitle\":\"{name} - Games \u0026 Coverage\",\"collectionDescription\":\"Games by {name} covered on IndieBunny\",\"allDevelopers\":\"All developers\",\"logoAlt\":\"{name} logo\",\"keyArt\":\"{name} key art\",\"onSteam\":\"{name} on Steam\",\"publisherBadge\":\"Publisher\",\"developerBadge\":\"Developer\",\"verifiedStudio\":\"Verified studio\",\"gamesCovered\":\"{count, plural, one {# game covered} other {# games covered}}\",\"articleCount\":\"{count, plural, one {# article} other {# articles}}\",\"founded\":\"Founded {year}\",\"teamSize\":\"{count, plural, one {# person} other {# people}}\",\"website\":\"Website\",\"studioAnnouncements\":\"Studio announcements\",\"games\":\"Games\",\"submittedByStudio\":\"Submitted by the studio\",\"publishedByStudio\":\"Published by this studio\",\"coverage\":\"Coverage\",\"managedByTeam\":\"Thi
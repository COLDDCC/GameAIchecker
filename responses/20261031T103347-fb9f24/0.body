YtYjEzZC00NzhlLTk4MDQtNThlNWUzNjBkYzlh">self.__next_f.push([1,"f:[\"$\",\"$L10\",null,{\"formats\":{\"dateTime\":{\"short\":{\"month\":\"short\",\"day\":\"numeric\",\"year\":\"numeric\"},\"long\":{\"month\":\"long\",\"day\":\"numeric\",\"year\":\"numeric\"},\"monthDay\":{\"month\":\"short\",\"day\":\"numeric\"},\"monthYear\":{\"month\":\"long\",\"year\":\"numeric\"},\"weekday\":{\"weekday\":\"long\",\"month\":\"long\",\"day\":\"numeric\"},\"time\":{\"hour\":\"2-digit\",\"minute\":\"2-digit\"}},\"number\":{\"compact\":{\"notation\":\"compact\",\"maximumFractionDigits\":1}}},\"locale\":\"en\",\"messages\":{\"account\":{\"index\":{\"metaTitle\":\"My account\",\"title\":\"My account\",\"profile\":\"Profile\",\"email\":\"Email\",\"accountType\":\"Account type\",\"typeDeveloper\":\"Developer / Studio\",\"typeReader\":\"Regular user\",\"browseGames\":\"Browse games →\",\"notificationsTitle\":\"Notifications\",\"notificationsBody\":\"Choose which emails and in-app alerts you receive. Security and account messages always stay on.\",\"notificationsLink\":\"Notification settings →\",\"securityTitle\":\"Security\",\"securityBody\":\"Add a second step to your sign-in. Strongly recommended if you own or administer a studio.\",\"securityLink\":\"Two-factor authentication →\",\"personalizationTitle\":\"Personalisation and profile\",\"personalizationBody\":\"Control what we recommend you and whether other people can see a profile. Both are yours to switch off.\",\"personalizationLink\":\"Personalisation settings →\",\"studioTitle\":\"Studio\",\"studioBody\":\"Claim your studio profile and manage your games from the studio dashboard.\",\"studioCta\":\"Open studio dashboard\",\"followsTitle\":\"Followed games\",\"followsTitleCount\":\"Followed games ({count})\",\"followsEmpty\":\"You're not following any game yet. Follow a game from its hub page to get release and coverage alerts by email.\",\"followsSteamApp\":\"Steam app {id}\",\"followsPending\":\"Confirmation pending\",\"bookmarksTitle\":\"Bookmarks\",\"bookmarksTitleCount\":\"Bookmarks ({count})\",\"bookmarksEmpty\":\"No bookmarks yet. Save any game from its hub page and it shows up here.\",\"ratingsTitle\":\"My ratings\",\"ratingsTitleCount\":\"My ratings ({count})\",\"ratingsEmpty\":\"You haven't rated a game yet. Give any game one to five stars on its hub page.\",\"starsLabel\":\"{score} out of 5 stars\",\"doneForNow\":\"Done for now?\"},\"rowActions\":{\"retry\":\"Retry\",\"failedTitle\":\"Failed - click to try again\",\"unfollow\":\"Unfollow\",\"unfollowLabel\":\"Unfollow {game}\",\"remove\":\"Remove\",\"removeLabel\":\"Remove {game} from your bookmarks\"},\"avatar\":{\"tooLarge\":\"Profile pictures can be at most {size}.\",\"uploadFailed\":\"The picture could not be uploaded.\",\"removeFailed\":\"The picture could not be removed.\",\"networkError\":\"Network error - please try again.\",\"sessionExpired\":\"Your session expired - please sign in again.\",\"alt\":\"Your profile picture\",\"working\":\"Working…\",\"replace\":\"Replace picture\",\"upload\":\"Upload a picture\",\"remove\":\"Remove\",\"hint\":\"PNG, JPEG or WebP, up to {size}. Cropped to a square. Other people only see it once you switch your \u003clink\u003epublic profile\u003c/link\u003e on - until then it is just yours.\"},\"deleteSection\":{\"title\":\"Delete account\",\"intro\":\"We will email a confirmation link to your address. Nothing is removed until you use it, and it cannot be undone once you do.\",\"bulletIdentity\":\"Your display name, email address and profile details are removed.\",\"bulletLibrary\":\"Your bookmarks, follows and notification settings are deleted.\",\"bulletSubmissions\":\"Games and press assets you submitted are removed.\",\"bulletStudio\":\"A studio page you claimed stays online - it's part of our editorial coverage - but it is released so someone else at the studio can claim it, and everything you added is stripped from it.\",\"bulletRatings\":\"Your game ratings and upvotes are kept as anonymous numbers so scores stay accurate. They can no longer be traced back to you.\",\"bulletSignedOut\":\"You will be signed out everywhere and will not be able to sign in again.\",\"wrongPassword\":\"That password is not correct.\",\"startFailed\":\"We could not start the deletion. Please try again.\",\"networkError\":\"Network error - please try again.\",\"cancelFailed\":\"Could not cancel - please try again.\",\"pendingNote\":\"Check your inbox - we sent a confirmation link. It expires in 24 hours, and your account stays untouched until you use it.\",\"cancelling\":\"Cancelling…\",\"cancelRequest\":\"Cancel deletion request\",\"openButton\":\"Delete my account\",\"passwordLabel\":\"Confirm with your password\",\"sending\":\"Sending…\",\"emailLink\":\"Email me the confirmation link\",\"keepAccount\":\"Keep my account\"},\"deleteConfirm\":{\"metaTitle\":\"Confirm account deletion\",\"title\":\"Confirm account deletion\",\"subtitle\":\"One last check before we remove your account.\",\"missingToken\":\"This link is missing its confirmation token. Open the link from the email we sent you, or start again from your account settings.\",\"goToAccount\":\"Go to my account\",\"invalidToken\":\"This confirmation link is not valid or has expired.\",\"networkError\":\"Network error - please try again.\",\"doneHeading\":\"Your account has been deleted.\",\"doneBody\":\"Your personal details are gone and you have been signed out everywhere. Ratings you left remain as anonymous numbers so game scores stay accurate; they can no longer be traced back to you.\",\"backHome\":\"Back to IndieBunny\",\"intro\":\"This permanently deletes your IndieBunny account. It cannot be undone.\",\"bulletIdentity\":\"Your display name, email address and profile details are removed.\",\"bulletLibrary\":\"Your bookmarks, follows and notification settings are deleted.\",\"bulletSubmissions\":\"Games and press assets you submitted are removed.\",\"bulletStudio\":\"A studio page you claimed stays online as editorial coverage, but is released and stripped of everything you added.\",\"bulletRatings\":\"Your ratings and upvotes remain as anonymous numbers so scores stay accurate.\",\"bulletSignedOut\":\"You will be signed out everywhere and will not be able to sign in again.\",\"deleting\":\"Deleting…\",\"confirmButton\":\"Yes, delete my account\",\"keepAccount\":\"Keep my account\"},\"notifications\":{\"metaTitle\":\"Notification settings\",\"title\":\"Notification settings\",\"subtitle\":\"Choose what we send you, and how.\",\"back\":\"Back to my account\",\"loadFailed\":\"We could not load your settings right now. Please refresh the page.\",\"groupGames\":\"Games you follow\",\"groupStudios\":\"Studios you follow\",\"groupDigest\":\"Digests\",\"groupAccount\":\"Account \u0026 security\",\"saving\":\"Saving…\",\"saved\":\"Settings saved\",\"transactionalRejected\":\"Security and account messages cannot be turned off.\",\"saveFailed\":\"Could not save your settings - please try again.\",\"masterLabel\":\"Optional notifications\",\"masterHint\":\"Turn this off to stop every optional email and in-app alert at once. Security and account messages are unaffected.\",\"columnNotification\":\"Notification\",\"columnEmail\":\"Email\",\"columnInApp\":\"In-app\",\"channelLabel\":\"{channel} notifications for {label}\",\"alwaysOn\":\" (always on)\",\"notAvailable\":\"Not available\",\"accountNote\":\"These messages are required to operate your account - registration and login verification, password resets, deletion confirmation and security warnings - so they cannot be switched off.\"},\"security\":{\"metaTitle\":\"Security\",\"title\":\"Security\",\"subtitle\":\"How your account is protected.\",\"back\":\"Back to my account\",\"loading\":\"Loading…\",\"genericError\":\"That did not work.\",\"heading\":\"Two-factor authentication\",\"intro\":\"A six-digit code from an authenticator app, on top of your password. If someone learns your password, it is not enough on its own.\",\"recommended\":\"You own or administer a studio. We strongly recommend turning this on.\",\"disablePrompt\":\"Enter a code from your app (or a recovery code) to turn two-factor authentication off:\",\"disabled\":\"Two-factor authentication is off.\",\"newCodesPrompt\":\"Enter a current code from your app to get a new set:\",\"newCodesDone\":\"New recovery codes generated. The old ones no longer work.\",\"recoveryHeading\":\"Save your recovery codes\",\"recoveryIntro\":\"Each works once, and gets you in if you lose your phone. We store them hashed, so this is the only time they can be shown - copy them somewhere safe now.\",\"copied\":\"Copied\",\"copyAll\":\"Copy all\",\"enrolIntro\":\"Add this to your authenticator app, then type the code it shows to confirm it works.\",\"setupKey\":\"Setup key\",\"openApp\":\"Open in your authenticator app\",\"codeLabel\":\"Code from the app\",\"codePlaceholder\":\"123456\",\"checking\":\"Checking…\",\"confirmEnable\":\"Confirm and turn on\",\"cancel\":\"Cancel\",\"onSince\":\"On since {date} · {count, plural, one {# recovery code} other {# recovery codes}} left\",\"recently\":\"recently\",\"newRecoveryCodes\":\"New recovery codes\",\"turnOff\":\"Turn off\",\"starting\":\"Starting…\",\"turnOn\":\"Turn on two-factor authentication\",\"lowCodes\":\"You are nearly out of recovery codes. Generate a new set while you still have access.\"},\"personalization\":{\"metaTitle\":\"Personalisation and profile\",\"title\":\"Personalisation and profile\",\"subtitle\":\"What we suggest you, and what other people can see.\",\"back\":\"Back to my account\",\"loading\":\"Loading your settings…\",\"saveFailed\":\"That change could not be saved.\",\"heading\":\"Personalisation\",\"togglePersonalise\":\"Personalise my recommendations\",\"togglePersonaliseHint\":\"Uses games you rate, follow, bookmark, complete or add to a list. Turning this off leaves you with the general list everyone sees.\",\"toggleWeekly\":\"Email me a weekly summary\",\"toggleWeeklyHint\":\"One email a week with what we think you would like. Off by default.\",\"whatYouLike\":\"What we think you like\",\"seeRecommendations\":\"See your recommendations →\",\"notReady\":\"Rate, follow or save a few more games and your profile will start to take shape.\",\"publicProfile\":\"Public profile\",\"publicProfileIntro\":\"Off unless you turn it on. A profile shows a display name, your profile picture (or a generated one), your favourite genres and public collections - there is no bio and no links.\",\"toggleProfilePublic\":\"Make my profile public\",\"toggleProfilePublicHint\":\"Anyone with the link can see it. Your bookmarks and private lists are never shown.\",\"toggleAchievements\":\"Show my achievements on it\",\"displayName\":\"Display name\",\"displayNamePlaceholder\":\"How you appear to others\",\"displayNameHint\":\"Up to 32 characters. Links and markup are stripped.\",\"activityLegend\":\"What appears in your activity\",\"activityHint\":\"Structured events only - never anything you wrote. Tick nothing to show no activity at all.\",\"copied\":\"Copied\",\"copyLink\":\"Copy link\",\"achievements\":\"Achievements\",\"achievementsIntro\":\"They have no monetary value, cannot be traded, and give you nothing anywhere else on the site. They are just a record of what you have done here.\",\"earned\":\"earned\"}},\"article\":{\"updated\":\"Updated\",\"minRead\":\"{minutes} min read\",\"watchOnYouTube\":\"Watch on YouTube\",\"tags\":\"Tags:\",\"share\":\"Share:\",\"shareOnX\":\"Share on X\",\"shareOnLinkedIn\":\"Share on LinkedIn\",\"keyArt\":\"{game} key art\",\"notTranslated\":\"This article is not available in {language} yet - showing the English version.\",\"fallbackDescription\":\"Read the latest gaming news on {siteName}\",\"relatedArticles\":\"Related Articles\",\"relatedGuides\":\"Related Guides\",\"moreOnGame\":\"More on {game}\",\"sources\":\"Sources\",\"readingTime\":\"{minutes, plural, one {# minute read} other {# minute read}}\",\"playVideo\":
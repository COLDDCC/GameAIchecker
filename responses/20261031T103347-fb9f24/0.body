l\":\"Code\",\"codePlaceholder\":\"123456\",\"verifying\":\"Checking…\",\"verify\":\"Verify and sign in\",\"startOver\":\"Start over\"},\"registerForm\":{\"failed\":\"Registration failed. Please try again.\",\"doneTitle\":\"Check your inbox\",\"doneBody\":\"We sent a confirmation link to \u003cb\u003e{email}\u003c/b\u003e. Click it to activate your account, then log in.\",\"goToLogin\":\"Go to login\",\"legend\":\"I am registering as…\",\"readerLabel\":\"Regular user\",\"readerHint\":\"Follow games, save bookmarks, rate and vote\",\"developerLabel\":\"Developer or studio\",\"developerHint\":\"Claim your studio, submit games, press kits\",\"submitting\":\"Creating account…\",\"submit\":\"Create account\",\"haveAccount\":\"Already have an account? \u003clink\u003eLog in\u003c/link\u003e\"},\"forgotForm\":{\"sent\":\"If an account exists for \u003cb\u003e{email}\u003c/b\u003e, a reset link is on its way. Check your inbox.\",\"submitting\":\"Sending…\",\"submit\":\"Send reset link\"},\"resetForm\":{\"failed\":\"Reset failed.\",\"invalidLink\":\"This reset link is invalid or incomplete. Request a new one from the \u003clink\u003eforgot password\u003c/link\u003e page.\",\"submitting\":\"Saving…\",\"submit\":\"Set new password\"}},\"authors\":{\"notTranslated\":\"This profile is not available in {language} yet - showing the English version.\",\"metaDescription\":\"Articles by {name}\",\"articleCount\":\"{count} articles\",\"articlesBy\":\"Articles by {name}\",\"empty\":\"No articles found by this author.\"},\"bookmarks\":{\"metaTitle\":\"My bookmarks\",\"heading\":\"My bookmarks\",\"kindGames\":\"Games\",\"kindNews\":\"News\",\"kindReviews\":\"Reviews\",\"kindVideos\":\"Videos\",\"kindStudios\":\"Studios\",\"badgeGame\":\"Game\",\"badgeNews\":\"News\",\"badgeReview\":\"Review\",\"badgeVideo\":\"Video\",\"badgeStudio\":\"Studio\",\"removedItem\":\"Removed item\",\"untitled\":\"Untitled\",\"removeFailed\":\"Could not remove that bookmark - please try again.\",\"emptyTitle\":
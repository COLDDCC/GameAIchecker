  const STATUS = {
    official_disclosure: {cls: 'disclosed', label: 'AI disclosed', rank: 0},
    human_made: {cls: 'human', label: 'Human-made claim', rank: 1},
    no_evidence: {cls: 'noevidence', label: 'No evidence found', rank: 2},
    community: {cls: 'community', label: 'Player report, unverified', rank: 3},
    unreviewed: {cls: 'unreviewed', label: 'Not reviewed yet', rank: 4}
  };
  const FILTERS = {
    all: {title: 'All games', note: 'Reviewed games first.', test: () => true},
    disclosed: {title: 'Games with an official AI disclosure', note: 'From developer statements on Steam.', test: g => g.status === 'official_disclosure'},
    human: {title: 'Human-made claims & art nominations', note: 'Community nominations are source-pending and are not verified no-AI claims.', test: g => g.status === 'human_made' || !!g.humanMadeListing},
    fest: {title: 'Steam Next Fest, October 2026', note: 'Third-party-listed demos. Participation not independently verified.', test: g => !!g.event},
    community: {title: 'Player reports waiting for review', note: 'Unverified until a reviewer checks the sources.', test: g => g.status === 'community'},
    unreviewed: {title: 'Not reviewed yet', note: 'No AI status is assigned until evidence is checked.', test: g => g.status === 'unreviewed'}
  };
  const featured = [
    {name: 'Detroit: Become Human', appId: '1222140', developer: 'Quantic Dream', status: 'no_evidence', slug: '1222140-detroit-become-human'},
    {name: 'THE FINALS', appId: '2073850', developer: 'Embark Studios', status: 'official_disclosure', slug: '2073850-the-finals', hasStatic: true},
    {name: 'inZOI', appId: '2456740', developer: 'inZOI Studio', status: 'official_disclosure', slug: '2456740-inzoi'},
    {name: 'Dressmaker', appId: '4019220', developer: 'Cozy Lives', status: 'human_made', slug: '4019220-dressmaker'}
  ];
  const PAGE = 24;
  let games = JSON.parse(document.getElementById('game-index')?.textContent || '{"games":[]}').games;
  if (!games.length) games = featured.slice();
  let filter = 'all', query = '', shown = PAGE;

  const $ = id => document.getElementById(id);
  const grid = $('grid'), moreBtn = $('moreBtn'), q = $('q'), finder = $('finder'), suggest = $('suggest');

  const norm = s => String(s || '').toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');
  const statusOf = g => STATUS[g.status] || STATUS.unreviewed;
  const profileUrl = g => g.hasStatic ? '/games/' + g.slug + '/' : '/browse/?q=' + encodeURIComponent(g.appId || g.name);
  const coverCandidates = g => {
    if (!g.appId) return [];
    const id = encodeURIComponent(g.appId);
    const list = [];
    if (g.header) list.push(g.header);
    list.push('/images/steam/apps/' + id + '/header.jpg',
      'https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/' + id + '/header.jpg',
      'https://cdn.cloudflare.steamstatic.com/steam/apps/' + id + '/header.jpg');
    return [...new Set(list)];
  };

  function parseQuery(raw) {
    const url = raw.match(/store\.steampowered\.com\/app\/(\d+)/i);
    if (url) return {id: url[1]};
    if (/^\d{3,}$/.test(raw.trim())) return {id: raw.trim()};
    return {text: norm(raw.trim())};
  }
  function matches(g, parsed) {
    if (parsed.id) return String(g.appId) === parsed.id;
    if (!parsed.text) return true;
    return norm(g.name).includes(parsed.text) || norm(g.originalName).includes(parsed.text) || norm(g.developer).includes(parsed.text);
  }
  function score(g, parsed) {
    const n = norm(g.name);
    const s = parsed.text ? (n === parsed.text ? 0 : n.startsWith(parsed.text) ? 1 : 2) : 0;
    return s * 10 + statusOf(g).rank;
  }

  function card(g) {
    const st = statusOf(g);
    const a = document.createElement('a');
    a.className = 'game';
    a.href = profileUrl(g);
    const art = document.createElement('div');
    art.className = 'game-art';
    const fallback = () => {
      art.replaceChildren();
      const f = document.createElement('span');
      f.className = 'fallback';
      f.textContent = g.name;
      art.append(f);
    };
    const srcs = coverCandidates(g);
    if (srcs.length) {
      const img = document.createElement('img');
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.width = 460; img.height = 215;
      img.referrerPolicy = 'no-referrer';
      let i = 0;
      img.onerror = () => { i++; if (i < srcs.length) img.src = srcs[i]; else fallback(); };
      img.src = srcs[0];
      art.append(img);
    } else fallback();
    const body = document.createElement('div');
    body.className = 'game-body';
    const h = document.createElement('h3');
    h.textContent = g.originalName || g.name;
    body.append(h);
    if (g.developer) {
      const d = document.createElement('p');
      d.className = 'dev';
      d.textContent = g.developer;
      body.append(d);
    }
    const meta = document.createElement('div');
    meta.className = 'meta';
    const chip = document.createElement('span');
    chip.className = 'chip ' + st.cls;
    chip.textContent = st.label;
    meta.append(chip);
    if (g.humanMadeListing) {
      const scope = document.createElement('span'); scope.className = 'event';
      scope.textContent = g.humanMadeListing.labelEn; meta.append(scope);
    }
    if (g.event) {
      const ev = document.createElement('span');
      ev.className = 'event';
      ev.textContent = 'Next Fest demo';
      meta.append(ev);
    }
    body.append(meta);
    a.append(art, body);
    return a;
  }

  function currentList() {
    const parsed = parseQuery(query);
    return games
      .filter(FILTERS[filter].test)
      .filter(g => matches(g, parsed))
      .sort((a, b) => score(a, parsed) - score(b, parsed));
  }

  function render() {
    const list = currentList();
    const f = FILTERS[filter];
    const title = $('browserTitle');
    title.textContent = query ? 'Results' : f.title;
    if (query) {
      const pill = document.createElement('span');
      pill.className = 'query-pill';
      pill.append(document.createTextNode('“' + query + '”'));
      const x = document.createElement('button');
      x.type = 'button';
      x.setAttribute('aria-label', 'Clear search');
      x.textContent = '×';
      x.onclick = () => { setQuery(''); q.value = ''; syncFinder(); q.focus(); };
      pill.append(x);
      title.append(pill);
    }
    $('browserNote').textContent = query
      ? list.length + (list.length === 1 ? ' game' : ' games') + (filter === 'all' ? '' : ' in “' + f.title + '”')
      : f.note;

    const statusParam = {disclosed: 'official_disclosure', human: 'human_made', community: 'community', unreviewed: 'unreviewed'}[filter];
    const browseParams = new URLSearchParams();
    if (query) browseParams.set('q', query);
    if (statusParam) browseParams.set('status', statusParam);
    $('browseLink').href = filter === 'fest' ? '/events/steam-next-fest-october-2026/' + (query ? '?q=' + encodeURIComponent(query) : '')
      : '/browse/' + (browseParams.toString() ? '?' + browseParams : '');

    if (!list.length) {
      grid.replaceChildren();
      moreBtn.hidden = true;
      const parsed = parseQuery(query);
      const box = document.createElement('div');
      box.className = 'empty';
      box.innerHTML = '<h3></h3><p></p><div class="actions"></div>';
      box.querySelector('h3').textContent = query ? 'This game isn’t in our records yet' : 'No games in this list yet';
      box.querySelector('p').textContent = query
        ? 'You can open a profile page for it to see its Steam details, or check its store page for a disclosure.'
        : 'Try another filter, or search for a game above.';
      if (query) {
        const actions = box.querySelector('.actions');
        const prof = document.createElement('a');
        prof.className = 'btn primary';
        prof.href = '/game/?' + (parsed.id ? 'id=' + parsed.id : 'name=' + encodeURIComponent(query));
        prof.textContent = 'Open a profile page';
        const steam = document.createElement('a');
        steam.className = 'btn ghost';
        steam.target = '_blank'; steam.rel = 'noopener noreferrer';
        steam.href = parsed.id ? 'https://store.steampowered.com/app/' + parsed.id + '/' : 'https://store.steampowered.com/search/?term=' + encodeURIComponent(query);
        steam.textContent = 'Search on Steam';
        actions.append(prof, steam);
        if (filter !== 'all') {
          const all = document.createElement('button');
          all.type = 'button'; all.className = 'btn ghost'; all.style.cursor = 'pointer'; all.style.background = 'transparent'; all.style.font = 'inherit';
          all.textContent = 'Search all games';
          all.onclick = () => setFilter('all');
          actions.prepend(all);
        }
      }
      grid.replaceChildren();
      $('results').replaceChildren(box);
      return;
    }
    if (!grid.isConnected) $('results').replaceChildren(grid);
    grid.replaceChildren(...list.slice(0, shown).map(card));
    moreBtn.hidden = list.length <= shown;
    moreBtn.textContent = 'Show more games (' + (list.length - shown) + ' left)';
  }

  function updateCounts() {
    for (const [key, f] of Object.entries(FILTERS)) {
      const el = document.querySelector('[data-count="' + key + '"]');
      if (el) el.textContent = games.filter(f.test).length;
    }
    const disclosed = games.filter(FILTERS.disclosed.test).length;
    $('heroSub').innerHTML = '';
    $('heroSub').append(
      document.createTextNode('Tracking '),
      Object.assign(document.createElement('strong'), {textContent: games.length + ' Steam games'}),
      document.createTextNode(', ' + disclosed + ' with an official AI disclosure. Search one to see what its developer has said and the evidence behind it.')
    );
  }

  function setFilter(key, {scroll = false} = {}) {
    if (!FILTERS[key]) return;
    filter = key; shown = PAGE;
    document.querySelectorAll('.tab').forEach(t => t.setAttribute('aria-selected', String(t.dataset.filter === key)));
    render();
    if (scroll) $('next-fest').scrollIntoView({block: 'start'});
  }
  function setQuery(v) { query = v.trim(); shown = PAGE; render(); }

  document.getElementById('tabs').addEventListener('click', e => {
    const t = e.target.closest('.tab');
    if (t) setFilter(t.dataset.filter);
  });
  document.getElementById('tabs').addEventListener('keydown', e => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const tabs = [...document.querySelectorAll('.tab')];
    const i = tabs.indexOf(document.activeElement);
    if (i < 0) return;
    const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
    next.focus(); setFilter(next.dataset.filter);
  });
  moreBtn.addEventListener('click', () => { shown += PAGE; render(); });

  /* ---------- Search with suggestions ---------- */
  let active = -1, items = [];
  function syncFinder() { finder.classList.toggle('has-value', !!q.value); }
  function closeSuggest() { suggest.hidden = true; q.setAttribute('aria-expanded', 'false'); q.removeAttribute('aria-activedescendant'); active = -1; }
  function setActive(i) {
    const lis = suggest.querySelectorAll('li[data-i]');
    lis.forEach(li => li.setAttribute('aria-selected', 'false'));
    active = i;
    if (i >= 0 && lis[i]) { lis[i].setAttribute('aria-selected', 'true'); q.setAttribute('aria-activedescendant', lis[i].id); lis[i].scrollIntoView({block: 'nearest'}); }
    else q.removeAttribute('aria-activedescendant');
  }
  function openSuggest() {
    const raw = q.value.trim();
    if (!raw) { closeSuggest(); return; }
    const parsed = parseQuery(raw);
    const found = games.filter(g => matches(g, parsed)).sort((a, b) => score(a, parsed) - score(b, parsed));
    items = found.slice(0, 6);
    suggest.replaceChildren();
    if (!items.length) {
      const li = document.createElement('li');
      li.setAttribute('role', 'presentation');
      const s = document.createElement('span');
      s.className = 's-empty';
      s.textContent = 'No match in our records. Press Enter for options.';
      li.append(s);
      suggest.append(li);
    }
    items.forEach((g, i) => {
      const st = statusOf(g);
      const li = document.createElement('li');
      li.id = 'sg-' + i; li.dataset.i = i;
      li.setAttribute('role', 'option'); li.setAttribute('aria-selected', 'false');
      const th = document.createElement('span');
      th.className = 'thumb';
      const src = coverCandidates(g)[0];
      if (src) {
        th.style.backgroundImage = 'url("' + src.replace(/"/g, '%22') + '")';
        const probe = new Image();
        const alts = coverCandidates(g); let k = 0;
        probe.onerror = () => { k++; if (k < alts.length) { probe.src = alts[k]; th.style.backgroundImage = 'url("' + alts[k].replace(/"/g, '%22') + '")'; } else th.style.backgroundImage = 'none'; };
        probe.src = src;
      }
      const main = document.createElement('span');
      main.className = 's-main';
      const n = document.createElement('span'); n.className = 's-name'; n.textContent = g.name;
      const d = document.createElement('span'); d.className = 's-dev'; d.textContent = g.developer || (g.appId ? 'App ID ' + g.appId : '');
      main.append(n, d);
      const chip = document.createElement('span');
      chip.className = 'chip ' + st.cls; chip.textContent = st.label;
      li.append(th, main, chip);
      li.addEventListener('mousedown', e => e.preventDefault());
      li.addEventListener('click', () => { location.href = profileUrl(g); });
      suggest.append(li);
    });
    if (found.length > items.length) {
      const li = document.createElement('li');
      li.className = 's-all'; li.setAttribute('role', 'presentation');
      li.textContent = 'See all ' + found.length + ' results';
      li.addEventListener('mousedown', e => e.preventDefault());
      li.addEventListener('click', () => submitSearch(raw));
      suggest.append(li);
    }
    suggest.hidden = false;
    q.setAttribute('aria-expanded', 'true');
    active = -1;
  }
  function submitSearch(raw) {
    closeSuggest();
    q.value = raw; syncFinder();
    if (filter !== 'all') { filter = 'all'; document.querySelectorAll('.tab').forEach(t => t.setAttribute('aria-selected', String(t.dataset.filter === 'all'))); }
    setQuery(raw);
    $('next-fest').scrollIntoView({block: 'start'});
  }

  q.addEventListener('input', () => { syncFinder(); openSuggest(); });
  q.addEventListener('focus', () => { if (q.value.trim()) openSuggest(); });
  q.addEventListener('blur', () => setTimeout(closeSuggest, 120));
  q.addEventListener('keydown', e => {
    const n = items.length;
    if (e.key === 'ArrowDown' && n) { e.preventDefault(); if (suggest.hidden) openSuggest(); setActive((active + 1) % n); }
    else if (e.key === 'ArrowUp' && n) { e.preventDefault(); setActive(active <= 0 ? n - 1 : active - 1); }
    else if (e.key === 'Escape') { if (!suggest.hidden) closeSuggest(); else { q.value = ''; syncFinder(); } }
    else if (e.key === 'Enter' && active >= 0 && items[active]) { e.preventDefault(); location.href = profileUrl(items[active]); }
  });
  finder.addEventListener('submit', e => {
    e.preventDefault();
    const raw = q.value.trim();
    if (!raw) { q.focus(); return; }
    const parsed = parseQuery(raw);
    const found = games.filter(g => matches(g, parsed));
    if (found.length === 1 && parsed.id) { location.href = profileUrl(found[0]); return; }
    submitSearch(raw);
  });
  $('clearQ').addEventListener('click', () => { q.value = ''; syncFinder(); closeSuggest(); if (query) setQuery(''); q.focus(); });
  document.querySelectorAll('[data-try]').forEach(b => b.addEventListener('click', () => { q.value = b.dataset.try; syncFinder(); q.focus(); openSuggest(); }));
  document.addEventListener('keydown', e => {
    if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) { e.preventDefault(); window.scrollTo({top: 0}); q.focus(); }
  });

  const mq = window.matchMedia('(max-width:600px)');
  const goLabel = finder.querySelector('.finder-go span');
  const setPh = () => { q.placeholder = mq.matches ? 'Game name or App ID' : 'Game name, Steam App ID or store URL'; goLabel.textContent = mq.matches ? 'Check' : 'Check game'; };
  setPh(); mq.addEventListener ? mq.addEventListener('change', setPh) : mq.addListener(setPh);

  /* ---------- Navigation ---------- */
  const nav = $('nav'), navQ = $('navQ');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => {
      const show = !en.isIntersecting;
      nav.classList.toggle('show-search', show);
      navQ.tabIndex = show ? 0 : -1;
    }, {rootMargin: '-64px 0px 0px 0px'}).observe(finder);
  }
  $('navForm').addEventListener('submit', e => {
    e.preventDefault();
    const raw = navQ.value.trim();
    if (!raw) return;
    navQ.value = '';
    navQ.blur();
    submitSearch(raw);
  });
  const menuBtn = $('menuBtn');
  menuBtn.addEventListener('click', () => {
    const open = !nav.classList.contains('open');
    nav.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  $('navMenu').addEventListener('click', e => {
    if (e.target.closest('a')) { nav.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); menuBtn.setAttribute('aria-label', 'Open menu'); }
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && nav.classList.contains('open')) { nav.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); menuBtn.focus(); } });

  /* ---------- Human-made band ---------- */
  const humanGrid = $('humanGrid');
  // This editorial feature displays five unique games.
  // The full index remains available via the Browse button.
  function fillHuman() {}
  $('humanAll').addEventListener('click', () => {
    if (query) { query = ''; q.value = ''; syncFinder(); }
    setFilter('human', {scroll: true});
  });

  /* ---------- Data ---------- */
  function applyHash() { if (location.hash === '#next-fest') setFilter('fest'); }
  updateCounts();
  render();
  applyHash();
  window.addEventListener('hashchange', applyHash);
})();
</script>
</body>
</html>

        buttonLink.addEventListener('click', function (e) {
            if (lastPopup && !lastPopup.closed) {
                e.preventDefault();
                lastPopup.focus();
            } else {

                let href = this.href,
                    success = false;
                if (href.indexOf('?') !== -1) {

uto;margin-top:var(--card-element-margin-start)}.entry-excerpt{max-width:100%;color:var(--theme-text-color)}.entry-card .ct-media-container{box-shadow:var(--theme-image-shadow);border-radius:var(--theme-image-border-radius, var(--theme-border-radius, 0px))}.entry-card .boundless-image{width:calc(100% + var(--card-inner-spacing, 30px)*2);margin-inline:calc(var(--card-inner-spacing, 30px)*-1)}.entry-card .boundless-image:first-child{margin-top:calc(var(--card-inner-spacing, 30px)*-1)}.entry-card .boundless-image:first-child:not(:only-child){border-end-start-radius:0;border-end-end-radius:0}.entry-card .boundless-image:last-child{margin-bottom:calc(var(--card-inner-spacing, 30px)*-1)}.entry-card .boundless-image:last-child:not(:only-child){border-start-start-radius:0;border-start-end-radius:0}.entry-card .boundless-image:not(:first-child):not(:last-child){border-radius:0}.entry-card .boundless-image img{height:100%}@media(min-width: 690px){[data-layout=simple][data-cards=boxed] .entry-card .boundless-image{border-radius:var(--theme-image-border-radius, var(--theme-border-radius, 0px));border-start-end-radius:0;border-end-end-radius:0}}
.ct-pagination{display:flex;flex-wrap:wrap;justify-content:space-between;margin-top:var(--spacing, 60px)}.ct-pagination[data-divider]{padding-top:var(--spacing, 60px);border-top:var(--pagination-divider, none)}[data-pagination=simple],[data-pagination=next_prev]{display:grid;grid-template-columns:1fr auto 1fr;font-size:14px;font-weight:600;color:var(--theme-text-color);--theme-link-initial-color: var(--theme-text-color)}[data-pagination=simple] .page-numbers,[data-pagination=next_prev] .page-numbers{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;border-radius:var(--theme-border-radius, 4px);border:2px solid rgba(0,0,0,0)}[data-pagination=simple] .page-numbers.current,[data-pagination=next_prev] .page-numbers.current{color:var(--theme-text-active-color, #fff);background:var(--theme-link-hover-color)}[data-pagination=simple] .page-numbers:not(.dots):hover,[data-pagination=next_prev] .page-numbers:not(.dots):hover{border-color:var(--theme-link-hover-color)}[data-pagination=simple] .prev,[data-pagination=simple] .next,[data-pagination=next_prev] .prev,[data-pagination=next_prev] .next{font-size:12px;text-transform:uppercase;padding:0 17px;white-space:nowrap;border-color:var(--theme-border-color)}[data-pagination=simple] .prev,[data-pagination=next_prev] .prev{grid-column:1;justify-self:start}[data-pagination=simple] .next,[data-pagination=next_prev] .next{grid-column:3;justify-self:end}[data-pagination=simple]>div{grid-column:2;text-align:center;margin:-5px}[data-pagination=simple]>div .page-numbers{flex:0 0 41px;width:41px;margin:5px}[data-pagination=load_more],[data-pagination=infinite_scroll]{justify-content:center}[data-pagination=load_more] .page-numbers,[data-pagination=infinite_scroll] .page-numbers{display:none}[data-pagination=load_more] .ct-load-more-helper,[data-pagination=infinite_scroll] .ct-load-more-helper{display:flex;align-items:center;justify-content:center;position:relative;min-width:var(--theme-button-min-height, 45px);min-height:var(--theme-button-min-height, 45px)}[data-pagination=load_more] .ct-load-more-helper .ct-ajax-loader,[data-pagination=infinite_scroll] .ct-load-more-helper .ct-ajax-loader{opacity:0}[data-pagination=load_more] .ct-load-more-helper.ct-loading .ct-ajax-loader,[data-pagination=infinite_scroll] .ct-load-more-helper.ct-loading .ct-ajax-loader{opacity:1}[data-pagination=load_more] .ct-load-more-helper.ct-loading .ct-load-more,[data-pagination=infinite_scroll] .ct-load-more-helper.ct-loading .ct-load-more{opacity:0}[data-pagination=load_more] .ct-load-more,[data-pagination=infinite_scroll] .ct-load-more{z-index:2;opacity:1}[data-pagination=load_more] .ct-last-page-text,[data-pagination=infinite_scroll] .ct-last-page-text{display:none}[data-pagination=load_more].ct-last-page .ct-load-more,[data-pagination=load_more].ct-last-page .ct-ajax-loader,[data-pagination=infinite_scroll].ct-last-page .ct-load-more,[data-pagination=infinite_scroll].ct-last-page .ct-ajax-loader{display:none}[data-pagination=load_more].ct-last-page .ct-last-page-text,[data-pagination=infinite_scroll].ct-last-page .ct-last-page-text{display:flex;opacity:.7}</style><script type="application/ld+json" class="saswp-schema-markup-output">
{"@context":"https:\/\/schema.org\/","@graph":[{"@context":"https:\/\/schema.org\/","@type":"VideoObject","@id":"https:\/\/automaton-media.com\/en\/news\/official-august-newsletter-for-steams-chaotic-roguelike-elin-has-been-released-little-sister-roids-combine-into-a-giant-little-sister\/#videoobject","url":"https:\/\/automaton-media.com\/en\/news\/official-august-newsletter-for-steams-chaotic-roguelike-elin-has-been-released-little-sister-roids-combine-into-a-giant-little-sister\/","headline":"The official August newsletter for Steam\u2019s chaotic roguelike Elin has been released. Little Sister-roids c ...","datePublished":"2026-08-27T18:00:00+09:00","dateModified":"2026-09-25T18:10:07+09:00","description":"Elin State of the Game \u2013 August 202, the 6th edition of Elin's official newsletter.","transcript":"Solo indie developer noa published Elin State of the Game \u2013 August 2026 via Elin\u2019s Steam store page on August 22. Elin State of the Game is a community letter published monthly by the Elin State of the Game editorial team. Seeing as AUTOMATON helped make this newsletter, we hope you\u2019ll enjoy it as an article as well!    Read on below for the full Elin State of the Game \u2013 August 2026:        Greetings, fellow adventurers! This is the Elin State of the Game editorial team.    We'd like to share Elin-related news that have been sent in from all over Ylva this month as well.    This is the August issue of \u201cElin State of the Game,\u201d out on Nyan Nyan Day (the 22nd), as always. Read this with an ice-cold beer or lemonade in hand!        This Nyanth\u2019s Update    Check it all out!    Production on the new Home Story episode is currently underway.However, you can sense the struggle from the cries left scattered throughout the update logs. It will likely be a little while longer before we get to see what kind of developments await us.So for now, we're giving you a sneak peek at some of the standout new features expected to be implemented in the next stable release, based on what's currently available in the Nightly build.(For details on all updates,\u00a0see Ylvapedia)    Imoutomaton Strikes!    Adventurers who barely escaped the mechanical ruins with their lives have reported sightings of a giant \"little sister.\"They say that numerous sister-droids gathered and combined to form a single, colossal little sister.For all you older brothers and sisters out there who want to avoid ending up in danger, it would be wise to treat your little sisters kindly.        Burn to ashes, all of you!    New spellbooks have arrived from the Mages' Guild. They are called \"Fire Flare\" and \"Fire Comet\"! The editorial team wasted no time testing them.Fire Flare deals damage in a small area centered on the target, while Fire Comet deals damage over a wide area centered on the target.If you can master these new spells and their unprecedented attack ranges, you might just be able to come up with some brand-new tactics.        Plenty of room for two    Good news for couples getting cozy in a single bed and thinking, \"It's a little cramped for two.\"With this new bed, you won't have to worry about falling off the edge anymore!Whether you build it yourself or commission a famous craftsman, getting a bed where you can truly relax is sure to bring you and your partner even closer.        News from the Sky    One Block Mode has also been getting plenty of updates lately.It's a nice little breather during the development of the Home Story.Fellow adventurers might want to give it a try for a nice change of pace.            Notice    Official Illustration Introduction ~ Lumiest Gallery    First up among the illustrations by Elin illustrator NZ is this concept art for the cursed girl,Melilith. Her outfit, in which cuteness and terror coexist, is meticulously designed down to every single accessory.        Official Music Introduction ~ Palmia Records    Next up is a piece by Elin composer NINO.This time, we're featuring the hymn of Lulwy of Wind. It's a track that makes you feel like an unbound wind soaring through the sky while looking down upon majestic Ylva.    Hi, it\u2019s NINO!The hymn of Lulwy of Wind is a song of wind that celebrates freedom.    A beautiful and awe-inspiring sky goddesswho soars serenely through the heavensand rules over the sublime winds.    Had she not been a majestic deitywho loves freedom and bows to no one,the proud winds surely would never have followed her.    This hymnis a part of lore capturing the voices of the windswho embraced Lulwy's way of life and followed her,passed down and sung by the travelers of Ylva as the \"Song of the Wind.\"     https:\/\/youtu.be\/F_xX0mpFj-w?sigf8mr4aa3BmnlMzO         Community News    Next up, here's some news from the community keeping Elin so lively!    The 2nd Elin VRC Tour    First up is the 2nd Elin VRC Tour.This event gently guides adventurers who aren't familiar with VRChat, giving participants a rundown on basic controls, key guidelines, and more. After learning the basics, participants were shown around worlds inspired by Elin, such as Doga's Factory and the meadow where adventurers first wake up.Gatherings for fellow Elin fans like this are thriving within VRChat. Even if you've never tried VRChat before, a tour welcoming beginners makes it easy to jump right in.    A failed creation in Doga's factory    A shearing battle broke out between Snow Putits!    The Golden Knight dual-wielding sky-blue tulips    A group photo in the starting meadow map    At the after-party, participants even got to try turning the forced labor machine    There are many activities and works by adventurers that make the Elin community livelier, and this is only a part of them. If any creator names are incorrect, we would appreciate it if you could let us know.    JUST KUMIby RinneMoon    \u5bf9\u4e0a\u773c\u795e\u5c31\u8981\u5f00\u59cb\u6218\u6597\uff01\uff1fby Sentry    Kizuami (\u2640)by Tenko    \u5728\u5356\u840c\u7684\u6731\u4e9aby \u6a31\u6c5f\u55b5\u4e38    Mechanical soldiers and marshmallow monstersby Takiyama    Playground Daddyby ONJI    Rippp...by ONJI    Two Ladiesby iromai    Do enjoy a chilled dessert!by Niwasouji    Summer! Girl! Puppy! Message in a bottle!by Gae    We're still accepting fan work submissions from adventurers for \"Elin State of the Game\"!We're accepting submissions in various formats, including illustrations, photos, music, videos, and housing screenshots. We'd love to see your work grace the pages of \"Elin State of the Game\"!    Derivative Works Form        Architecture of the Month    Housing is life. In fact, it\u2019s deeper than life itself.Here's the map we're featuring this time. Can you tell what's placed on it?        \"Now that taxidermy duplication is possible, I lined up taxidermies of Ashland in my fully expanded base as a token of gratitude. It's not a horror base.\"by Mio    That's right: the correct answer is taxidermies, along with their duplicates, of Ashland, Shadow of Mysilia.Thanks to a recent update that made taxidermy duplication possible, displaying them in vast quantities has become much easier.Even with duplicates, gathering this many must have taken sheer obsession.Is what lies behind it love, or madness?Here lies an abyss of housing quite distinct from mere ingenuity or technique.        Adventurer Q&amp;A Box    Thanks to all the adventurers who\u2019ve sent in messages through the reader submission form!Now it\u2019s time for the Adventurer Q&amp;A Box!    The development team will personally answer the questions submitted through the form!As promised in the last \u201cElin State of the Game,\u201d we're bringing you an extra-packed issue this time!    I love playing Elin! The world is wonderful and full of lore. However, sometimes I get overwhelmed by the amount of work that goes into building my house and town. Are there any plans for a game start that allows the player to be a simple traveler, with no home? Please keep up the incredible work! I love Fiama. &lt;3 (From Rainyday)    Thank you for the warm message!Since home bases are a core feature in Elin, progressing without a home seems difficult system-wise. Instead, I feel implementing something like a portable base you can carry like a tent, or a base that follows you on the global map akin to Howl's Moving Castle, would be relatively easy. This would be a game mode similar to One Block Mode. If there's demand for it, I'd like to try making it when I find some free time.    Is it possible to add NTR elements? For example, something like a newlywed partner starting to hang out with a playboy, their affection steadily dropping over time, until they are completely stolen away. (From \u725b\u5934\u4eba\u56fd\u738b, original in Chinese)    Personally, I'm a fan of the \"I love you so much, and yet... but...!\" dynamic, but unfortunately this isn't that kind of game, so such elements will likely be kept to a minimum. That said, Raphael, the resident specialist for that sort of thing, will be appearing again (though he's still just a baby in this era).    Are there any plans for being able to raise the limit of fiances in the future? (From Nerohael)    Currently, the only ones who can increase the limit of fianc\u00e9s you can safely bring along as party members are races with the \"Flowers in Both Arms\" feat. There are no specific plans for updates related to this feature, but if you have any interesting ideas, they're always welcome!    I feel that Elin currently has quite a lot of content, but much of it still lacks depth. (...) Moving forward, are there any plans for improvements or expansions that will add \"depth\" to the game overall, including systems like NPCs' daily life, relationships, affection, and negotiation? (From eluii, original in Chinese)    We do want to add more depth to the game moving forward. Daily life and base management are also elements we want to heavily expand after the official release. Right now, we are progressing with development based on priority, focusing primarily on the scenario.    Are there plans to implement a feature in the future where you can change race or class through a wish? (...) Still, thinking about a snail tourist who, after surviving countless adventures, becomes a succubus through a wish... somehow feels really heartwarming. (From fat cokezero, original in Chinese)    A snail reincarnating as a succubus, or a succubus reincarnating as a snail... Both are heartwarming!As for changing race and class, we've actually been testing that for quite a while now, and it's at a stage where it could be implemented with just a few improvements. For classes, it might also be fun to let players freely switch them at a dedicated facility, much like a certain famous temple.    There is something odd about the food in Elin, I say. You can make cheese from things other than milk, dried bonito flakes from things other than bonito, wine from things other than grapes... In fact, making cheese or wine from their proper ingredients is actually the exception! Mixing fish and seaweed yields soy sauce (even if it were fish sauce, seaweed wouldn't normally be included), mixing chili pepper and Zettel (the German word for paper) yields black pepper, and despite having chili peppers, you can't make spices, chili oil, or sauce. Despite having tomatoes, you can't make ketchup; despite having fruit and sugar, you can't make jam; despite having milk, you can't make butter; despite having a takoyaki maker, you can't make takoyaki; despite having soy sauce, miso, natto, and beans (the ones you scatter for Setsubun), there are no soybeans; you can't use wasabi on sashimi; you can't use avocado, melon, or watermelon (sliced) in fruit dishes; despite having cherry trees, you can't grow cherries; and despite having Eggplant Fairies, you can't grow eggplants! Are these temporary specifications due to Early Access? Or is it Ylva's unique culinary culture? (From Zundamochi Suki, original in Japanese)    Just because things in this world are called \"cheese\" or \"wine\" doesn't necessarily mean they are the same foods as the cheese and wine in our world. The only things that Ylvan eggs and our eggs have in common might just be that they're round and something is born from them. And whether what the inhabitants of this world call \"catechin\" contains the same components as the catechin we know is an eternal mystery that you're surely happier not knowing. Understood...?    Are there any plans to add a feature in the future like changing NPC and pet dialogue (custom tone of speech), similar to what Elona had? (From Anmerutsu Yoko Yoko, original in Japanese)    We generally envision customization-type features being added through mods. However, for high-demand features like changing dialogue, there's a possibility we might add them officially. I'd like to consult with DK (who has been helping us expand mod functionality) about it sometime.    Will players be able to craft more types of weapons and armor in the future? and are there any plans on incrementing the crafting system in the near future? (From Kasei)    Weapon and armor crafting was actually introduced as a trial back during the alpha test, but we ended up removing it because we couldn't make it into a particularly interesting system at the time. The main issues were that being able to craft freely rendered existing randomized gear meaningless, and that reloading over and over allowed players to create perfect weapons.One idea we're currently mulling over is making parts, like a blade or hilt in the case of a sword, obtainable at random, giving each part a few fixed enchantments (similar to genes), and having players combine them to craft equipment.As you progress through the game, an issue will likely arise where the enchantment strength of previously acquired parts no longer meets current standards, so I'm scheming to see if we can also implement something like a reforging feature for artifacts and equipment (recalculating enchantment strength) at the same time.    What flavor is Jure Water? (From Boueisha, original in Japanese)    To drink that would be unthinkable!!!    \"Elin State of the Game\" is still accepting questions from all adventurers!Due to space limitations, we may not be able to feature every single one, but we will read through all the submitted questions and continue answering them in future issues.The entire editorial team is eagerly awaiting your questions!    General Submissions Form        Developer News    Hello everyone, this is noa.I thought I\u2019d have plenty of time on my hands this month, but I ended up hitting a standstill during the final push for the main story scenario. I\u2019m currently working hard so that I can release a stable build around the time this issue of \"Elin State of the Game\" is published.The scenario really is the toughest hurdle in Elin\u2019s development. Given the game\u2019s genre, there are probably plenty of voices saying, \"I wish you'd focus development on the gameplay instead,\" but since this is a world I've held dear ever since Elona, I want to pour everything I have into the scenario as well.I expect updates will continue to lean heavily toward quests and story for a while, but I hope you\u2019ll stick with me for a bit longer. Until then, please look forward to the next issue of \"Elin State of the Game\"!        Social network link\u30a8\u30ea\u30f3\u3060\u3088\u308a (Elin State of the Game)","name":"The official August newsletter for Steam\u2019s chaotic roguelike Elin has been released. Little Sister-roids c ...","uploadDate":"2026-08-27T18:00:00+09:00","thumbnailUrl":"https:\/\/i.ytimg.com\/vi\/F_xX0mpFj-w\/hqdefault.jpg","author":{"@type":"Person","name":"AUTOMATON WEST","description":"Delivering gaming news from Tokyo\/Osaka Japan.","url":"https:\/\/automaton-media.com\/en\/author\/automaton_en\/","sameAs":["AUTOMATON_ENG"],"image":{"@type":"ImageObject","url":"https:\/\/automaton-media.com\/en\/wp-content\/uploads\/2021\/10\/automaton-forum-moderator-100x100.jpeg","height":96,"width":96}},"contentUrl":"https:\/\/youtu.be\/F_xX0mpFj-w?si=gf8mr4aa3BmnlMzO","embedUrl":"https:\/\/youtu.be\/F_xX0mpFj-w?si=gf8mr4aa3BmnlMzO"},

{"@context":"https:\/\/schema.org\/","@graph":[{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#automaton-west","name":"AUTOMATON WEST","url":"https:\/\/automaton-media.com\/en\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#news-jp-global","name":"NEWS (JP\/GLOBAL)","url":"https:\/\/automaton-media.com\/en\/news\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#interviews","name":"INTERVIEWS","url":"https:\/\/automaton-media.com\/en\/interviews\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#indie-games","name":"INDIE GAMES","url":"https:\/\/automaton-media.com\/en\/indie-games\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#reviews-impressions","name":"REVIEWS & IMPRESSIONS","url":"https:\/\/automaton-media.com\/en\/reviews\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#tips","name":"Tips","url":"https:\/\/automaton-media.com\/en\/tips\/"},{"@context":"https:\/\/schema.org\/","@type":"SiteNavigationElement","@id":"https:\/\/automaton-media.com\/en\/#automaton-japan","name":"AUTOMATON JAPAN","url":"https:\/\/automaton-media.com\/"}]}]}

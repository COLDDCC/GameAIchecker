ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"712290761518876416","clanid":"46307939","posterid":"0","headline":"12 new decorations + Simplified Chinese!","posttime":1793340004,"updatetime":1793340414,"body":"A little more warmth and colour for your mountain forge!\n\n[list]\n[*]Simplified Chinese is now available. The game follows your Steam language, with English and Chinese flags available as a backup.\n[*]A small triangle beside the flags lets you hide or bring them back whenever you like.\n[*]Six Chinese-inspired decorations: a jade dragon, fireworks, red lantern, panda, guardian lion and golden fortune tree.\n[*]Six November decorations: a cosy bonfire, remembrance poppies, a veterans tribute, cornucopia, chestnut cart and harvest turkey.\n[\/list]\n\nAll 12 decorations are free and yours to keep. Find them in the Decorations menu and mix them with your favourite sets.\n\nYour existing progress and decoration placements carry over. No resets or balance changes.\n\nThank you for playing and supporting Taskbar Armory! Always open to feedback and improvements.\n","commentcount":1,"tags":["mod_reviewed","ModAct_1911576989_1793340229_0","ModAct_1911576989_1793340941_4"],"language":0,"hidden":0,"forum_topic_id":"571553273173197016","event_gid":"712290761518876415","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173197016","rtime32_last_modified":1794036338,"news_post_gid":"0","rtime_mod_reviewed":1793340942,"featured_app_tagid":0,"referenced_appids":[],"build_id":26316289,"build_branch":"","unlisted":0,"rtime_created":1793339173,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594068734660896520","gidfeature2":"571553273173197016"},{"gid":"717918358822980815","clan_steamid":"103582791475829347","event_name":"A little Halloween spirit for your mountain forge!","event_type":13,"appid":5226040,"server_address":null,"server_password":null,"rtime32_start_time":1791843720,"rtime32_end_time":1791847801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,nul
adcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"717918358822980816","clanid":"46307939","posterid":"0","headline":"A little Halloween spirit for your mountain forge!","posttime":1791843753,"updatetime":1791843753,"body":"[list][*][p]Six free Halloween decorations to mix with your existing sets.\n[\/p][\/*][\/list][list][*][p]Forge Chronicle: view your lifetime forging, production, expedition and collection records. Existing saved totals already count!\n[\/p][\/*][*][p]Searchable Inventory brings resources, relic materials and research supplies together, with filters and a quick reset.\n[\/p][\/*][*][p]Clearer research access, links from locked blueprints, and explanations of missing materials, survey time and project requirements.\n[\/p][\/*][*][p]Optional Hearthfire glow, embers and fire\/bellows ambience, with separate volume and reduced-motion support.\n[\/p][\/*][*][p]Improved small-window layouts, text readability, scrolling and overlapping decoration placement.\n[\/p][\/*][\/list][p]\nAlso includes the recent six autumn decorations, seasonal collection selector and Fullscreen Windowed setting.\n\nYour progress and decoration placements carry over. No resets or balance changes.[\/p]","commentcount":1,"tags":["mod_reviewed","ModAct_783923276_1791844715_0"],"language":0,"hidden":0,"forum_topic_id":"594069880290975518","event_gid":"717918358822980815","voteupcount":7,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"594069880290975518","rtime32_last_modified":1794036347,"news_post_gid":"0","rtime_mod_reviewed":1791844716,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791843735,"votes_up":7,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594068734660896520","gidfeature2":"594069880290975518"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["712290761518876416","717918358822980816"],"last_update_event":{"rtime":1793340000,"event_gid":"712290761518876415","announcement_gid":"712290761518876416","clan_account_id":46307939}}};

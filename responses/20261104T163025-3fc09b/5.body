				I wanted to share my solution (using recursion).
Did somebody solve it another way (using iteration)?

 
vault = self.contract.vault
dirs = [&amp;quot;east&amp;quot;,&amp;quot;south&amp;quot;,&amp;quot;west&amp;quot;,&amp;quot;north&amp;quot;]
maze = [-1 for i in range(vault.size * vault.size)]

def pos():
    return vault.position.row * vault.size + vault.position.col

def moveto(d):
    res = vault.move(dirs ).status
    if res == &amp;quot;path&amp;quot;:
        opp = (d + 2) % 4
        if maze[pos()] == -1:
            maze[pos()] = opp
        else:
            vault.move(dirs[opp...			&lt;/div&gt;

restarting Steam[\/b]![\/p][p][\/p][h3]\ud83d\udd27 Custom API Support[\/h3][p]Want to use your own API? No problem![\/p][p]Simply [b]join our [\/b][url=\"https:\/\/discord.gg\/FAqyNKKqS\"]discord[\/url] to get the file needed to unlock the custom API feature~[\/p][p][\/p][h3]\ud83c\udf31 Upcoming Updates[\/h3][p]Of course, [i]Magi Scapes[\/i] will continue to grow and improve! The image below shows our current plans for future updates. Please note that these plans may be adjusted and refined as development progresses~[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45214628\/6490dbea6c61feb7ca88e902dc8824e639117ea8.png\"][\/img][\/p][p]Lastly, a huge thank you to everyone who has supported and encouraged us along the way[\/p][p]Hope you all have a wonderful time playing! ( \u02d8 \u00b3\u02d8)\u2661[\/p][p]\u2014 With love, the [i]Magi Scapes[\/i] Dev Team \u2661[\/p]","commentcount":11,"tags":["mod_reviewed","ModAct_1426387032_1793240307_0","ModAct_1911576989_1793328503_4"],"language":0,"hidden":0,"forum_topic_id":"562546073917303374","event_gid":"693150463100453261","voteupcount":61,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562546073917303374","rtime32_last_modified":1793642476,"news_post_gid":"0","rtime_mod_reviewed":1793328503,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793186716,"votes_up":61,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"4695657222578345352","gidfeature2":"562546073917303374"},{"gid":"699903960312447948","clan_steamid":"103582791474736036","event_name":"Magi Scapes Launches October 29!","event_type":16,"appid":2990190,"server_address":null,"server_password":null,"rtime32_start_time":1791446880,"rtime32_end_time":1791451801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"66568c9b9dd7e03bd1b071d53707e8f8ab7c0542.png\",null,null,null,null,null,\"66568c9b9dd7e03bd1b071d53707e8f8ab7c0542.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"1683e7513f94093cf64a76b71af0d222370eff2c.png\",null,null,null,null,null,\"2f8125b58ead1afd85b6ca2cf2e39981e1bf2ef5.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"699903960312447949","clanid":"45214628","posterid":"0","headline":"Magi Scapes Launches October 29!","posttime":1791446910,"updatetime":1791446910,"body":"[p]Great news, Heroes![\/p][p]We can finally make it official\u2014[\/p][h3][b]Magi Scapes is launching in Steam Early Access on October 29![\/b] \ud83c\udf89[\/h3][p][\/p][p]From a simple idea to a sandbox world that's slowly coming to life, we've been working toward this day for a long time.[\/p][p][\/p][p]Along the way, we've received so much support, encouragement, and valuable feedback from all of you. Especially since the Demo launched, seeing you create all kinds of NPCs and share your unexpected interactions and stories has made us feel like this little world is truly taking on a life of its own.[\/p][p][\/p][p]Of course, we know there's still plenty of room for improvement. Early Access is just the beginning! We'll keep polishing the game, adding and improving content, and listening closely to your feedback as we make this world better, little by little.[\/p][p][\/p][p]So, what kind of adventure are you looking forward to? Building a cozy home of your own? Exploring the world with your companions? Or creating that one special NPC you've always imagined?[\/p][p]Whatever your plans are, we can't wait to see the stories you'll create in Magi Scapes.[\/p][p][\/p][p]To every adventurer who's been following and supporting us along the way, thank you so much.[\/p][p][b]See you on October 29! [\/b][\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1871393022_1791447642_0"],"language":0,"hidden":0,"forum_topic_id":"589565769440944430","event_gid":"699903960312447948","voteupcount":37,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"589565769440944430","rtime32_last_modified":1793403722,"news_post_gid":"0","rtime_mod_reviewed":1791447642,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791446901,"votes_up":37,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"4695657222578345352","gidfeature2":"589565769440944430"},{"gid":"693150463100456059","clan_steamid":"103582791474736036","event_name":"0.6.5.4Magi Scapes Update | NPC Improvements & Bug Fixes","event_type":12,"appid":2990190,"server_address":null,"server_password":null,"rtime32_start_time":1793689320,"rtime32_end_time":1793694601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"4d5c760d609f40f75087a3c3aae802d01f43c71c.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6768ff04ee73ea178216b8401f076e21f4af83fb.png\",null,null,null,null,null,\"6768ff04ee73ea178216b8401f076e21f4af83fb.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"693150463100456060","clanid":"45214628","posterid":"0","headline":"0.6.5.4Magi Scapes Update | NPC Improvements & Bug Fixes","posttime":1793689369,"updatetime":1793689369,"body":"[p]Dear Heroes! \ud83d\udc97[\/p][p]Another update is here! (\u0e51\u02c3\u1d17\u02c2)\ufeed \u2661[\/p][p]This patch focuses on [b]improving NPC performance and animal pathfinding[\/b], adjusting boss quests and Rift encounters, fixing various gameplay issues, and adding new ore crafting recipes![\/p][p]Here's what's changed:[\/p][h3]\u26a1 Performance & Quality-of-Life Improvements[\/h3][list][*][p]Optimized NPC performance to reduce lag, freezes, and unresponsive gameplay[\/p][\/*][*][p]Improved the display and usability of the input method[\/p][\/*][*][p]NPCs can now correctly recognize the character skins worn by nearby players[\/p][\/*][\/list][h3]\u2694\ufe0f Combat & Quest Adjustments[\/h3][list][*][p]Fixed an issue where monsters would not spawn in Desert Area[\/p][\/*][*][p]Readjusted the completion conditions for 8 main story boss quests[\/p][\/*][*][p]Adjusted the loot drop location when Rift Bosses are defeated[\/p][\/*][*][p]Rift Bosses now reset to the center of the room when entering a Rift, preventing them from getting stuck in walls[\/p][\/*][\/list][h3]\ud83d\udc11 Animal Behavior Improvements[\/h3][list][*][p]Improved pathfinding for tamed animals within their designated roaming areas[\/p][\/*][*][p]Removed the restriction that forced wild animals to return to their original spawn points[\/p][\/*][*][p]Fixed an issue where lambs would not grow properly after loading a save[\/p][\/*][\/list][h3]\ud83d\udd27 Gameplay Fixes[\/h3][list][*][p]Fixed an issue with price validation in the NPC recruitment interface[\/p][\/*][*][p]Fixed unwanted emotion tags appearing in the Princess's dialogue during the Conferment Ceremony[\/p][\/*][*][p]Fixed an issue where Arcane Candy's lifetime purchase limit prevented the shop from refreshing properly[\/p][\/*][\/list][h3]\u2728 New Content & Balance Adjustments[\/h3][list][*][p]Added crafting recipes for [b]Electric Ore, Infernal Ore, and Solar Ore[\/b][\/p][\/*][*][p]Reduced the crafting material requirements for the [b]Crimson Sakura Tree Decoration[\/b][\/p][\/*][\/list][hr][\/hr][p]Thank you so much for your continued feedback and support! \ud83d\udc97[\/p][p]We're actively reviewing your reports and working through the issues you've raised. We'll keep rolling out fixes and improvements to make Magi Scapes even better![\/p][p]We hope you're having a wonderful time exploring Oz! (\u0e51\u02c3\u1d17\u02c2)\ufeed \u2661[\/p]","commentcount":1,"tags":["patchnotes","mod_reviewed","ModAct_768955665_1793690564_0"],"language":0,"hidden":0,"forum_topic_id":"562546398187487223","event_gid":"693150463100456059","voteupcount":11,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562546398187487223","rtime32_last_modified":1793773677,"news_post_gid":"0","rtime_mod_reviewed":1793690564,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793689346,"votes_up":11,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"4695657222578345352","gidfeature2":"562546398187487223"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["693150463100453262","699903960312447949"],"last_update_event":{"rtime":1793689320,"event_gid":"693150463100456059","announcement_gid":"693150463100456060","clan_account_id":45214628}}};
						</script>
					


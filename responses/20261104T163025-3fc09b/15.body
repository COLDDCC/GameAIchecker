							var StoreDefaults = {"PartnerEventStore":[{"gid":"702157662356244557","clan_steamid":"103582791475279010","event_name":"Post-Launch Update: Player Feedback and What's Next for The Electorate","event_type":28,"appid":3859180,"server_address":null,"server_password":null,"rtime32_start_time":1793460360,"rtime32_end_time":1793463960,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"c9fa633ba8ac19d253b5a72c19b0806da64ff2ee.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"4deb79c7631326ffbbfe938c5a99621fda367409.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"702157662356244558","clanid":"45757602","posterid":"0","headline":"Post-Launch Update: Player Feedback and What's Next for The Electorate","posttime":1793460405,"updatetime":1793460405,"body":"[p]Hi all,[\/p][p]First, thank you for the support you've shown The Electorate since launch. After nearly two years of development, seeing players share their election maps and dive into their own campaigns has been incredibly rewarding.[\/p][p]I've also spent a considerable amount of time reading your feedback, bug reports, and reviews. While I'm happy with the foundation the game is built on, it's clear there are areas where the experience needs improvement.[\/p][p]I always intended for The Electorate to be a game that grows over time, with larger additions like Career Mode and international expansions planned for the future. But before moving on to those features, I want to focus on strengthening the core gameplay experience.[\/p][p]Here's where my priorities stand following launch and what you can expect in the near future.[\/p][h2]1. Improving the Event System[\/h2][p]This is the most consistent criticism I've seen, and it's my first priority for content updates.[\/p][p]Several issues I've seen:[\/p][list][*][p]Events occur too frequently and can become repetitive.[\/p][\/*][*][p]Negative outcomes are disproportionately common.[\/p][\/*][*][p]The relationship between character attributes, player decisions, and event outcomes isn't clear.[\/p][\/*][*][p]Random chance can have too much influence over outcomes.[\/p][\/*][\/list][p]I want events to feel meaningful, understandable, and responsive to the decisions you make throughout a campaign. I'll be revisiting event frequency, improving outcomes, overall content, and making character attributes and player choices more consequential.[\/p][h2]2. Making the Simulation More Transparent[\/h2][p]One of the game's greatest strengths is the amount of data operating beneath the surface. The simulation models the electorate across thousands of counties, with a multitude of factors influencing election outcomes.[\/p][p]However, I've realized that having a detailed simulation isn't enough if players can't clearly understand how their decisions influence it. There needs to be a stronger connection between the actions you take and the results you see.[\/p][p]For example, when you invest in campaign infrastructure or create a voter profile, you should be able to understand what those investments are accomplishing and where those voters are, and how you can mobilize them.[\/p][p]The good news is that this data exists and is possible to be accessed. I just need to do a better job at elevating it.[\/p][h2]3. Improving Electoral Balance and Scenario Accuracy[\/h2][p]I've also seen feedback about inconsistencies between election outcomes, including occasional landslides that seem unrealistic for the political environment being simulated.[\/p][p]Some variability is intentional. The Electorate is designed to produce a wide range of possible outcomes based on the circumstances of each campaign.[\/p][p]However, those outcomes should still make sense within the simulation.[\/p][p]I'll be reviewing the systems responsible for electoral viability, candidate performance, and scenario balancing to identify where adjustments are needed.[\/p][p]Similarly, I'll continue refining county-level political and demographic data. Modeling the American electorate across six decades of historical scenarios is a substantial undertaking, and while some inaccuracies are inevitable, improving that accuracy remains an ongoing priority.[\/p][h2]4. Pricing Update[\/h2][p]Following the launch discount, the game will remain priced at $19.99.[\/p][p]I've considered the feedback about the game's current content and believe this is an appropriate price as I continue expanding and improving the experience.[\/p][h2]Looking Ahead[\/h2][p]The immediate priority is improving the existing game.[\/p][p]The first post-launch patch has already addressed several reported issues, and I'll continue working through bug reports alongside the improvements outlined above.[\/p][p]Longer term, my plans for Career Mode, international expansions, and additional content haven't changed. I simply want to ensure the foundation is as strong as possible before building further upon it.[\/p][p]This is my first publicly released game, and the launch has been a tremendous learning experience. I'm grateful for the constructive feedback, including the criticism.[\/p][p]Some of you have already spent more than 20 hours playing, which has been incredible to see so soon after release.[\/p][p]Thank you again for supporting the game. I'm excited to keep improving it and continue to pursue my goal of making the ultimate election simulator.[\/p][p]Thanks,[\/p][p]Matt[\/p]","commentcount":17,"tags":["mod_reviewed","ModAct_770318842_1793461153_0"],"language":0,"hidden":0,"forum_topic_id":"564798191048874075","event_gid":"702157662356244557","voteupcount":66,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564798191048874075","rtime32_last_modified":1793766633,"news_post_gid":"0","rtime_mod_reviewed":1793461153,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793460195,"votes_up":66,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"595158486787098310","gidfeature2":"564798191048874075"},{"gid":"702157662356244231","clan_steamid":"103582791475279010","event_name":"The Electorate is Out NOW","event_type":28,"appid":3859180,"server_address":null,"server_password":null,"rtime32_start_time":1793318880,"rtime32_end_time":1793322480,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"9a1e0906e1690a900d8b503fc71ae8f1d4ee1c08.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"aa6470106a45cfc9faa7b8cfbf6309ce8a4ce900.png\",null,null,null,null,null,nul
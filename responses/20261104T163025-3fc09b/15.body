null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"702157662356244682","clanid":"45757602","posterid":"0","headline":"1.0.2 Hot Fixes","posttime":1793574782,"updatetime":1793574782,"body":"[list]\n[*]Fixed a save issue impacting longer campaigns.\n[*]Reduced event pileups.\n[*]Fixed cases where Continue buttons on events could lock the screen.\n[*]Fixed cases where a rejected event choice could prevent you from selecting another valid response.\n[*]Fixed staff recruitment offers getting stuck after a failed hire.\n[*]Adjusted Momentum so campaigns below zero receive the full benefit of recovery and no longer suffer amplified losses for having negative Momentum.\n[*]Increased AI campaign spending and advertising budgets by 25%.\n[*]Made primary candidate colors more distinct.\n[*]Increased the influence of partisan lean in House and Senate general elections.\n[*]Fixed saved campaigns reverting from Simulate to Watch after loading.\n[*]One-day turn campaigns are no longer available for campaigns that would require over 350 turns.\n[\/list]","commentcount":5,"tags":["patchnotes","mod_reviewed","ModAct_487176015_1793577048_0"],"language":0,"hidden":0,"forum_topic_id":"564798191049002444","event_gid":"702157662356244681","voteupcount":19,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564798191049002444","rtime32_last_modified":1793742250,"news_post_gid":"0","rtime_mod_reviewed":1793577049,"featured_app_tagid":0,"referenced_appids":[],"build_id":26367954,"build_branch":"","unlisted":0,"rtime_created":1793574751
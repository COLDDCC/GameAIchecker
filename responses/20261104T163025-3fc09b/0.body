l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"680763027479332671","clanid":"46292143","posterid":"0","headline":"<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130> \ud5a5\ud6c4 \uc5c5\ub370\uc774\ud2b8 \uacc4\ud68d","posttime":1791122177,"updatetime":1791122192,"body":"[p]\uc548\ub155\ud558\uc138\uc694, \ub098\uc778\uc11c\ud074\uc785\ub2c8\ub2e4.[\/p][p][\/p][p]\ucc3d\uc138\uae30\uc804 \uc678\uc804: <\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130>\uac00 \ucd9c\uc2dc\ub41c\uc9c0 \uc774\uc81c 2\uc8fc\uac00 \uc9c0\ub0ac\uc2b5\ub2c8\ub2e4.[\/p][p]\ub9ce\uc740 \ubd84\ub4e4\uaed8\uc11c \uc7ac\ubbf8\uc788\uac8c \ud50c\ub808\uc774 \ud574 \uc8fc\uc2dc\uace0, \ucee4\ubba4\ub2c8\ud2f0\uc640 \ub9ac\ubdf0\uc5d0 \uc751\uc6d0\uc758 \ub9d0\uc500 \ub0a8\uaca8\uc8fc\uc154\uc11c \uac10\uc0ac\ub4dc\ub9bd\ub2c8\ub2e4.[\/p][p]\uc5ec\ub7ec\ubd84\uaed8\uc11c \ub9d0\uc500\ud574\uc8fc\uc2e0 \uc88b\uc740 \uc810, \uc544\uc26c\uc6b4 \uc810\uacfc \uc18c\uc911\ud55c \uc758\uacac, \uc81c\uc548 \ub0b4\uc6a9\uc740 \ubaa8\ub450 \uaf3c\uaf3c\ud788 \uc0b4\ud3b4\ubcf4\uace0, \ub2e4\uc74c \uacc4\ud68d\uc744 \uc138\uc6cc\ub098\uac00\ub294 \ub370 \ubc11\uac70\ub984\uc73c\ub85c \uc0bc\uc544 \ub354\uc6b1 \ubc1c\uc804\ud574 \ub098\uac00\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uc5ec\ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\uc5b4\uc81c(26\/10\/3) \uc9c4\ud589\ud55c \uc5c5\ub370\uc774\ud2b8\ub97c \ud1b5\ud574 \uce58\uba85\uc801\uc778 \ubc84\uadf8\ub97c \uc218\uc815\ud558\uace0, \ube60\ub978 \uc2dc\uac04 \ub0b4\uc5d0 \uac1c\ubc1c\uc774 \uac00\ub2a5\ud588\ub358 \ud3b8\uc758 \uae30\ub2a5\uc744 \uba87 \uac00\uc9c0 \uc801\uc6a9\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\uc5c5\ub370\uc774\ud2b8\uc640 \ud568\uaed8, \uc720\uc800 \uc5ec\ub7ec\ubd84\ub4e4\uaed8\uc11c \uad81\uae08\ud574 \ud558\uc2e4 \uc55e\uc73c\ub85c\uc758 \uc911\uc7a5\uae30 \uacc4\ud68d\uc5d0 \ub300\ud574 \uac04\ub7b5\ud558\uac8c\ub098\ub9c8 \uba87\uac00\uc9c0 \ub9d0\uc500\ub4dc\ub9ac\ub824 \ud569\ub2c8\ub2e4.[\/p][p][\/p][p]\uba3c\uc800, \ub2e4\uad6d\uc5b4 \ubc84\uc804\uc758 \uc5c5\ub370\uc774\ud2b8\ub97c \uc900\ube44\ud560 \uacc4\ud68d\uc785\ub2c8\ub2e4.[\/p][p]\ud1a0\ub860 \uac8c\uc2dc\ud310\uc744 \ud1b5\ud574\uc11c \ub9d0\uc500\ub4dc\ub9b0 \ubc14 \uc788\uc2b5\ub2c8\ub2e4\ub9cc, \uc774\ubc88 <\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130> \ud504\ub85c\uc81d\ud2b8\ub294 \ud140\ube14\ubc85\uc744 \ud1b5\ud574 \ud380\ub529\uc5d0 \ucc38\uc5ec\ud574\uc8fc\uc2e0 \ud6c4\uc6d0\uc790\ub2d8\ub4e4\uacfc\uc758 \uc77c\uc815 \uc57d\uc18d\uc744 \ucd5c\ub300\ud55c \uc9c0\ud0a4\ub294 \uac83\uc744 \uc6b0\uc120\ud558\uc600\uae30\uc5d0, \ucd9c\uc2dc \uc2dc\uc810\uc5d0 \ub2e4\uad6d\uc5b4 \ub300\uc751\uae4c\uc9c0 \ubc18\uc601\ud558\uae30\uc5d0\ub294 \ubb3c\ub9ac\uc801 \uc2dc\uac04\uacfc \uc5ec\ub825\uc774 \ubd80\uc871\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1> \uc6d0\uc791\uc740 \ub300\ub9cc, \uc911\uad6d, \uc77c\ubcf8(\ucd9c\uc2dc\uc77c\uc21c)\uc5d0\ub3c4 \ucd9c\uc2dc\ub418\uc5c8\uace0, \uc2dc\uac04\uc774 \ub9ce\uc774 \ud758\ub800\uc9c0\ub9cc \uae30\uc5b5\ud574\uc8fc\uc2dc\uace0 \ub9ac\ub9c8\uc2a4\ud130\ub97c \uae30\ub2e4\ub824\uc8fc\uc2e0 \ud574\uc678 \ud32c\ubd84\ub4e4\ub3c4 \uc788\uc73c\uc2e0 \uac83\uc73c\ub85c \uc54c\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ucd9c\uc2dc \ubc84\uc804\uc5d0 \ub2e4\uad6d\uc5b4 \ub300\uc751\uc774 \ub418\uc9c0 \ubabb\ud574, \uae30\ub300\uc5d0 \ubd80\uc751\ud558\uc9c0 \ubabb\ud55c \uc810\uc740 \uc8c4\uc1a1\ud558\ub2e4\ub294 \ub9d0\uc500 \ub4dc\ub9bd\ub2c8\ub2e4.[\/p][p]\uc774\ubbf8 \ube44\uacf5\uc2dd \ub2e4\uad6d\uc5b4 \ub300\uc751 \ubc84\uc804\uc774 \ud1a0\ub860 \uac8c\uc2dc\ud310\uc5d0 \uac8c\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4\ub9cc, \uc800\ud76c\uac00 \uc9c4\ud589\ud560 \uacf5\uc2dd \ub2e4\uad6d\uc5b4 \ub300\uc751\uc740 \ubc88\uc5ed \ubc0f \uac80\uc218\uc640 \ud14c\uc2a4\ud2b8 \uc9c4\ud589\uc5d0 \uc2dc\uac04\uc774 \ud544\uc694\ud558\uae30 \ub54c\ubb38\uc5d0 \uc544\ubb34\ub798\ub3c4 \uc5b4\ub290\uc815\ub3c4 \uc2dc\uac04\uc774 \ud544\uc694\ud558\uaca0\uc2b5\ub2c8\ub2e4. \uc678\uad6d\uc5b4 \ubc84\uc804\uc73c\ub85c \ud50c\ub808\uc774\ub97c \ud574\ubcf4\uace0 \uc2f6\uc73c\uc2e0 \ud574\uc678 \ud32c\ubd84\ub4e4\uaed8 \ube44\uacf5\uc2dd\uc73c\ub85c\ub77c\ub3c4 \uba3c\uc800 \ud50c\ub808\uc774 \ud574\ubcfc \uc218 \uc788\ub294 \ud658\uacbd\uc744 \ub9cc\ub4e4\uc5b4 \uc8fc\uc2e0 \ubd84\ub4e4\uaed8 \uac10\uc0ac\ud558\ub2e4\ub294 \ub9d0\uc500\uc744 \ub4dc\ub9ac\uba70, \uc800\ud76c\uac00 \uc900\ube44\ud560 \uacf5\uc2dd \ub2e4\uad6d\uc5b4\ud310\ub3c4 \uae30\ub2e4\ub824 \uc8fc\uc2dc\uba74 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p]\ud604\uc7ac \uc9c0\uc6d0 \uc5b8\uc5b4\ub85c\ub294 \uc601\uc5b4, \uc77c\ubcf8\uc5b4, \uc911\uad6d\uc5b4(\uac04\uccb4\/\ubc88\uccb4)\ub97c \uacc4\ud68d\ud558\uace0 \uc788\uc73c\uba70, \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub978 \uc5b8\uc5b4\uc758 \ucd94\uac00\ub3c4 \uace0\ub824\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.[\/p][p][\/p][p]\ub9ce\uc740 \ubd84\ub4e4\uaed8\uc11c \uc544\uc27d\ub2e4\uace0 \ub9d0\uc500 \uc8fc\uc2dc\ub294 \ub3c4\uc804\uacfc\uc81c \ub610\ud55c \uc5c5\ub370\uc774\ud2b8\ub85c \ucd94\uac00\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.[\/p][p]\ucd9c\uc2dc \uc77c\uc815\uc774 \uc5ec\uc720\ub86d\uc9c0\ub294 \ubabb\ud55c \uc0c1\ud669\uc5d0\uc11c \ubcf8 \uac8c\uc784\uc758 \uc644\uc131\ub3c4\uc5d0 \uc9d1\uc911\ud558\ub2e4 \ubcf4\ub2c8 \ucd9c\uc2dc \uc2dc\uc810\uc5d0 \ub3c4\uc804\uacfc\uc81c\ub294 \uc9c0\uc6d0\ud560 \uc218 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4\ub9cc, \ub3c4\uc804\uacfc\uc81c\ub97c \uc6d0\ud558\uc2dc\ub294 \uc720\uc800\ubd84\ub4e4\ub3c4 \ub9ce\uc774 \uacc4\uc2dc\uae30\uc5d0 \ud5a5\ud6c4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud1b5\ud574 \ub3c4\uc804\uacfc\uc81c\ub97c \uc81c\uacf5\ud574 \ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\uc5ec\ub7ec\ubd84\ub4e4\uaed8\uc11c \uc9c0\uc801\ud574\uc8fc\uc2e0 \uc6d0\uc791\ubd80\ud130\uc758 \ubbf8\uad6c\ud604 \uae30\ub2a5, \uc544\uc774\ud15c \ub4f1\uc5d0 \ub300\ud574\uc11c\ub3c4 \uc7a5\uae30\uc801\uc73c\ub85c\ub294 \uc5c5\ub370\uc774\ud2b8\ub85c \uae30\ub2a5\uc744 \ucd94\uac00\ud558\ub294 \uac83\uc744 \uace0\ub824\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.[\/p][p]\ud328\uc2dc\ube0c \uc2a4\ud0ac(\uc6d0\uc791\uc758 \ud45c\ud604\uc73c\ub85c\ub294 '\ub2a5\ub825')\uc758 \uacbd\uc6b0, \uc0ac\uc2e4 \uc6d0\uc791\ubd80\ud130 \uae30\ub2a5\uc774 \uad6c\ud604\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub610 \uc6d0\uc791\uc5d0\uc11c \uae30\ud68d\uc758 \ud754\uc801\uc740 \uc788\uc73c\ub098 \uae30\ub2a5\uc774 \ubbf8\uad6c\ud604\ub41c \uc544\uc774\ud15c\ub3c4 \uc874\uc7ac\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\uc6d0\uc791\uc5d0\uc11c \ubbf8\uad6c\ud604\ub418\uc5c8\ub358 \uae30\ub2a5 \uc790\uccb4\uc758 \uac1c\ubc1c\uc740 \uadf8\ub807\uac8c \uc5b4\ub824\uc6b4 \uc77c\uc740 \uc544\ub2c8\uaca0\uc73c\ub098, \ub9ac\ub9c8\uc2a4\ud130\uc5d0\uc11c \ubbf8\uad6c\ud604 \uae30\ub2a5\uc744 \ucd94\uac00\ud558\ub294 \uac83\uc740 \uc6d0\uc791\uc758 \ubc38\ub7f0\uc2a4\uc5d0 \ub300\ud574\uc11c\ub3c4 \uc7ac\uac80\ud1a0\ub97c \ud574\uc57c \ud558\ub294 \uc77c\uc774\ub77c \uc0dd\uac01\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\uc774\ubc88 \ub9ac\ub9c8\uc2a4\ud130\uc758 1\ucc28\uc801\uc778 \ubaa9\ud45c\ub294 \ubaa8\ub4e0 \uae30\ub2a5\uacfc \uc218\uce58\ub97c \uc6d0\uc791\uc5d0 \ucd5c\ub300\ud55c \uac00\uae5d\uac8c \uc7ac\ud604\ud558\ub294 \uac83\uc5d0 \uc788\uc5c8\uae30\uc5d0, \uc6b0\uc120\uc740 \uc5ec\ub7ec\ubd84\uaed8\uc11c \uacbd\ud5d8\ud558\uc168\uace0 \uae30\uc5b5\ud558\uc2dc\ub294 \uc6d0\uc791\uc758 \ub290\ub08c\uc744 \uac00\ub2a5\ud55c \uadf8\ub300\ub85c \uc81c\uacf5\ud574\ub4dc\ub9ac\ub294 \uac83\uc774 \ub9de\ub2e4\uace0 \ud310\ub2e8\ud574, \ucd9c\uc2dc \ubc84\uc804\uc5d0\uc11c\ub294 \ubbf8\uad6c\ud604 \uae30\ub2a5\ub3c4 \uc6d0\uc791 \uadf8\ub300\ub85c \ub450\uae30\ub85c \uacb0\uc815\ud558\uc600\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\ub610\ud55c, \ub9ac\ub9c8\uc2a4\ud130 \uac1c\ubc1c \uacfc\uc815\uc5d0\uc11c \ub9ce\uc740 \ubd80\ubd84\uc744 \ucc38\uace0\ud588\ub358 \uc77c\ubcf8 FALCOM\uc0ac\uc5d0\uc11c \ucd9c\uc2dc\ud55c \uc77c\ubcf8\uc5b4\ud310 \uc11c\ud48d\uc758 \uad11\uc2dc\uace1\uc758 \uacbd\uc6b0\ub3c4, \uce90\ub9ad\ud130\uc758 '\ub2a5\ub825'\uc744 \ubcc4\ub3c4\ub85c \uad6c\ud604\ud558\uc9c0 \uc54a\uc558\uc73c\uba70 \uce90\ub9ad\ud130 \uc2a4\ud0ac \ubaa9\ub85d\uc5d0\uc11c\ub3c4 \ud45c\uc2dc\ud558\uc9c0 \uc54a\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.[\/p][p]\uadf8\ub9ac\uace0 \ud55c\uad6d\uc5b4\ud310 \uc6d0\uc791\uc5d0\uc11c \uae30\ub2a5\uc774 \ubbf8\uad6c\ud604\ub41c \uc77c\ubd80 \uc544\uc774\ud15c\uc758 \uacbd\uc6b0, \uc6d0\uc791\uc758 \uae30\ud68d\uacfc\ub294 \ub2e4\ub978 \ubc29\ud5a5\uc73c\ub85c \uae30\ub2a5\uc744 \ubcc0\uacbd\ud574 \uac1c\ubc1c\ud55c \uacbd\uc6b0\ub3c4 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.[\/p][p]\ub2e4\uad6d\uc5b4 \ub300\uc751\uc744 \ud1b5\ud574 \ub9ac\ub9c8\uc2a4\ud130\uc758 \uc77c\ubcf8\uc5b4\ud310\ub3c4 \uacc4\ud68d\ud558\uace0 \uc788\ub294 \uc0c1\ud669\uc774\uc5c8\uae30\uc5d0, \uc6d0\uc791\uc758 \ud55c\uad6d\uc5b4\ud310\uacfc \uc77c\ubcf8\uc5b4\ud310\uc758 \uc0ac\uc591\uc774 \uc11c\ub85c \ub2e4\ub978 \ubd80\ubd84\uc5d0 \ub300\ud574\uc11c\ub3c4 \ucda9\ubd84\ud788 \uac80\ud1a0\ud574 \uad6c\ud604 \ubc29\ud5a5\uc131\uc744 \uacb0\uc815\ud558\ub294 \uac83\uc774 \ud544\uc694\ud558\ub2e4\uace0 \uc0dd\uac01\ud574, \uc774\ubc88 \ub9ac\ub9c8\uc2a4\ud130 \ucd9c\uc2dc \ubc84\uc804\uc5d0\uc11c\ub294 \uc6d0\uc791\uc758 \ubbf8\uad6c\ud604 \uae30\ub2a5\uc744 \uac1c\ubc1c\ud558\uc9c0 \uc54a\uc740 \ubd80\ubd84\uc5d0 \ub300\ud574\uc11c\ub294 \uc720\uc800 \uc5ec\ub7ec\ubd84\ub4e4\uc758 \uc774\ud574\ub97c \ubd80\ud0c1\ub4dc\ub9ac\uace0\uc790 \ud569\ub2c8\ub2e4.[\/p][p]\ub2e4\uad6d\uc5b4 \ubc84\uc804 \uc900\ube44\uc640 \ud568\uaed8, \ud5a5\ud6c4 \uc6d0\uc791 \ubbf8\uad6c\ud604 \uae30\ub2a5\uc5d0 \ub300\ud55c \uae30\ub2a5 \ucd94\uac00\ub3c4 \uace0\ub824\ud558\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\ud604\uc7ac \ubcf5\uac01\ud310\uc740 \uac8c\uc784\uc758 \ucd08\ubc18\ub9cc \ud50c\ub808\uc774\uac00 \uac00\ub2a5\ud558\uac8c \ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.[\/p][p]\uc774\ubc88 \ub9ac\ub9c8\uc2a4\ud130 \ud504\ub85c\uc81d\ud2b8\uc758 \uc2dc\uc791 \uc790\uccb4\uac00 \uc6d0\uc791\uc758 \ubcf5\uac01\uc774\uc5c8\uc73c\uba70, \uc800\ud76c\ub294 \uc18c\ud504\ud2b8\ub9e5\uc2a4\uc640 \ucc3d\uc138\uae30\uc804 \ud504\ub79c\ucc28\uc774\uc988, \uadf8\ub9ac\uace0 \uc5ec\ub7ec\ubd84\uc5d0 \ub300\ud55c \ud070 \ub9c8\uc74c\uc758 \ube5a\uc744 \uac00\uc9c0\uace0 \uc788\uae30\uc5d0 \ubcf5\uac01\ud310\uc744 \ucd5c\ub300\ud55c \uc6d0\uc791\uc5d0 \uac00\uae5d\uac8c \ubcf5\uc6d0\ud558\ub294 \uac83 \ub610\ud55c \uc77c\uc885\uc758 \uc0ac\uba85\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.[\/p][p]\ub2e4\ub9cc, \uc800\ud76c\uac00 \uc6d0\uc791\uc758 \ucf54\ub4dc, \ub370\uc774\ud130, \uc5b4\uc14b\uc744 \uac00\uc9c0\uace0 \uc788\uae30\ub294 \ud558\uc9c0\ub9cc, \ud55c\ud3b8\uc73c\ub85c\ub294 \uadf8 \uc2dc\uc808\uc5d0 \uc9c1\uc811 \ud50c\ub808\uc774\ud558\uc168\ub358 \uc5ec\ub7ec\ubd84\ub4e4\uc758 \uae30\uc5b5\uacfc \uac10\uac01\uc774 \uac1c\ubc1c\uc9c4\uc758 \uadf8\uac83\uacfc\ub3c4 \uc870\uae08\uc740 \ub2e4\ub978 \ubd80\ubd84\ub3c4 \uc788\uc744 \uac70\ub77c\ub294 \uc0dd\uac01\uc774 \ub4ed\ub2c8\ub2e4. \uadf8\ub798\uc11c, \uc5ec\ub7ec\ubd84\uc758 \ub3c4\uc6c0\uc744 \ubc1b\uc544 \ud568\uaed8 \uc644\uc131\ud574\ub098\uac00\ub294 \ubc29\ubc95\ub3c4 \uc758\ubbf8\uc788\uc744 \uac83 \uac19\ub2e4\uace0 \uc0dd\uac01\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\uc5b4\ub290 \uc815\ub3c4 \uc5c5\ub370\uc774\ud2b8\uc758 \uac1c\ubc1c\uc774 \ub9c8\ubb34\ub9ac\ub418\uba74, \ud1a0\ub860 \uac8c\uc2dc\ud310\uc758 \ubcf5\uac01\ud310 \ud568\uaed8 \ub9cc\ub4e4\uae30\ub97c \ud1b5\ud574 \uc5ec\ub7ec\ubd84\uaed8 \ub3c4\uc6c0\uc744 \ubd80\ud0c1\ub4dc\ub9b4 \ub0b4\uc6a9\uc5d0 \ub300\ud574 \ub2e4\uc2dc \uc790\uc138\ud788 \uc548\ub0b4\ub4dc\ub9b4 \uc608\uc815\uc774\ub2c8, \uc6d0\uc791\uc5d0 \ub300\ud55c \uae30\uc5b5\uc774 \uc790\uc138\ud558\uc2e0 \ubd84\ub4e4\uc758 \ub9ce\uc740 \ub3c4\uc6c0\uc744 \ubd80\ud0c1\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uae30\ud0c0 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud574\uc11c\uc785\ub2c8\ub2e4.[\/p][p]\uc6b0\uc120\uc740 \uc704\uc5d0 \ub9d0\uc500\ub4dc\ub9b0 \ub2e4\uad6d\uc5b4 \ub300\uc751\uacfc \ub3c4\uc804\uacfc\uc81c\uc758 \uac1c\ubc1c \ubc0f \uc5c5\ub370\uc774\ud2b8\ub97c \uc9c4\ud589\ud558\uba74\uc11c, \ucf58\uc194 \ub4f1 \uae30\ud0c0 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \uc5f0\uad6c\ubd80\ud130 \uc2dc\uc791\ud558\ub824\uace0 \ud569\ub2c8\ub2e4.[\/p][p]\uae30\ud0c0 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \uad6c\uccb4\uc801\uc774\uace0 \ud604\uc2e4\uc801\uc778 \uacc4\ud68d\uc744 \uc138\uc6b8 \uc218 \uc788\ub294 \uc2dc\uc810\uc774 \ub418\uba74 \ucd94\uac00\ub85c \uc548\ub0b4\ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130>\ub97c \ud50c\ub808\uc774 \ud574 \uc8fc\uc154\uc11c \ub2e4\uc2dc \ud55c\ubc88 \uac10\uc0ac\ub4dc\ub9bd\ub2c8\ub2e4.[\/p][p]\uc800\ud76c\ub294 \uc774\ubc88 \ucd9c\uc2dc \ubc84\uc804\uacfc \ud55c\ub450\ubc88\uc758 \uc5c5\ub370\uc774\ud2b8\ub85c \uc774\ubc88 \ub9ac\ub9c8\uc2a4\ud130 \ud504\ub85c\uc81d\ud2b8\uac00 \ub9c8\ubb34\ub9ac\ub418\uc5c8\ub2e4\uace0 \uc0dd\uac01\ud558\uace0 \uc788\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4.[\/p][p]\uc704\uc5d0 \ub9d0\uc500\ub4dc\ub9b0 \uba87\uac00\uc9c0\uc758 \uc911\uc7a5\uae30 \uacc4\ud68d \uc678\uc5d0\ub3c4, \uc800\ud76c\uac00 \ub354 \ud560 \uc218 \uc788\ub294 \ubd80\ubd84\uc744 \uace0\ubbfc\ud574\uc11c \uc5ec\ub7ec\ubd84\uaed8 \ub354\uc6b1 \ucf8c\uc801\ud558\uace0 \uc990\uac70\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud574\ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\ub098\uc778\uc11c\ud074 \ub4dc\ub9bc[\/p]","commentcount":35,"tags":["mod_reviewed","ModAct_1889321037_1791126292_0"],"language":0,"hidden":0,"forum_topic_id":"581684201210823944","event_gid":"680763027479332670","voteupcount":191,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791122160,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"581684201210823944","rtime32_last_modified":1793715460,"news_post_gid":"0","rtime_mod_reviewed":1791126292,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791122025,"votes_up":191,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"569298022367809354","gidfeature2":"581684201210823944"},{"gid":"680763027479332569","clan_steamid":"103582791475813551","event_name":"<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130> \uc5c5\ub370\uc774\ud2b8 \uc548\ub0b4 (v.1.0.1802186)","event_type":12,"appid":5099430,"server_address":null,"server_password":null,"rtime32_start_time":1790997960,"rtime32_end_time":1791001801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"680763027479332570","clanid":"46292143","posterid":"0","headline":"<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130> \uc5c5\ub370\uc774\ud2b8 \uc548\ub0b4 (v.1.0.1802186)","posttime":1790997974,"updatetime":1791026176,"body":"[p]\uc548\ub155\ud558\uc138\uc694, \ub098\uc778\uc11c\ud074\uc785\ub2c8\ub2e4.[\/p][p][\/p][p]<\uc11c\ud48d\uc758 \uad11\uc2dc\uace1 \ub9ac\ub9c8\uc2a4\ud130>\ub97c \ud50c\ub808\uc774 \ud574 \uc8fc\uc154\uc11c \uac10\uc0ac\ub4dc\ub9bd\ub2c8\ub2e4.[\/p][p]\uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ubd88\ud3b8\uc744 \ub4dc\ub9b4 \uc218 \uc788\ub294 \ud604\uc0c1\uc744 \uac1c\uc120\ud558\uace0, \ub354 \ub098\uc740 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ub2e4\uc74c\uacfc \uac19\uc774 \uc5c5\ub370\uc774\ud2b8\uac00 \uc9c4\ud589\ub418\uc5c8\uc74c\uc744 \uc548\ub0b4\ub4dc\ub9bd\ub2c8\ub2e4.[\/p][p][\/p][p][b]\\[\uae30\ub2a5 \uac1c\uc120 \uc5c5\ub370\uc774\ud2b8][\/b][\/p][p][b]UI \uc635\uc158 \uac1c\uc120\uc0ac\ud56d[\/b][\/p][p]- \ud018\uc2a4\ud2b8 \ubaa9\ub85d \ud45c\uc2dc \uc635\uc158 \uac1c\uc120 : \uba54\uc778 \ud018\uc2a4\ud2b8\ub9cc \ud45c\uc2dc\ub418\ub294 \uc635\uc158\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p][b]\ud50c\ub808\uc774\/\uc870\uc791 \uc635\uc158 \uac1c\uc120\uc0ac\ud56d[\/b][\/p][p]- \uc778\uce74\uc6b4\ud130 \ube48\ub3c4 \uc635\uc158 \ucd94\uac00[\/p][p]\u3000: \uae30\uc874 4\ub2e8\uacc4(\ub4dc\ubb3c\uac8c\/\uae30\ubcf8\/\uc7a6\uac8c\/\ub9e4\uc6b0 \uc7a6\uac8c)\uc5d0\uc11c 5\ub2e8\uacc4(\ub4dc\ubb3c\uac8c\/\uae30\ubcf8\/\uc7a6\uac8c\/\ub354 \uc7a6\uac8c\/\ub9e4\uc8fc \uc7a6\uac8c)\ub85c \ube48\ub3c4\uac00 \ucd94\uac00\ub418\uc5c8\uc73c\uba70, \ub9e4\uc6b0 \uc7a6\uac8c\uc758 \ube48\ub3c4\ub97c \uc0c1\ud5a5 \uc870\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \ud0c4\uc57d \uc18c\ubaa8 \ubb34\uc2dc \uc635\uc158 \ucd94\uac00 : \ucd1d\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \uce90\ub9ad\ud130\uc758 \uacf5\uaca9\uc2dc \ud0c4\uc57d\uc744 \uc18c\ubaa8\ud558\uc9c0 \uc54a\ub294 \uc635\uc158\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p][b]\ubd80\uc2a4\ud2b8 \uc635\uc158 \uac1c\uc120\uc0ac\ud56d[\/b][\/p][p]- XP \uc99d\uac00 \ubc30\uc218 \uc635\uc158 \ucd94\uac00[\/p][p]\u3000: \uc804\ud22c \uc911 XP \uc99d\uac00\ub7c9\uc744 \uc870\uc815\ud560 \uc218 \uc788\ub294 \uc635\uc158\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. (\uae30\ubcf8\/2\ubc30\/5\ubc30\/10\ubc30\/\ud56d\uc0c1 \ucd5c\ub300)[\/p][p][\/p][p][b]\uac8c\uc784 \uc870\uc791 \ubc29\ubc95 \uac1c\uc120\uc0ac\ud56d[\/b][\/p][p]- \ubbf8\ub2c8\ub9f5 ON\/OFF \uc870\uc791\ubc29\ubc95 \ucd94\uac00[\/p][p]\u3000: \ud0a4\ubcf4\ub4dc M \ud0a4, \ucee8\ud2b8\ub864\ub7ec L2(LT) \ubc84\ud2bc\uc5d0 \ubbf8\ub2c8\ub9f5 \uae30\ubcf8\/\uc804\uccb4\ud654\uba74 \ud45c\uc2dc \ud1a0\uae00 \uae30\ub2a5\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. (\ubbf8\ub2c8\ub9f5 \ub044\uae30\uac00 \ub418\uc9c0 \uc54a\ub294 \ud1a0\uae00 \uae30\ub2a5)[\/p][p]- 2\ubc30\uc18d\/4\ubc30\uc18d \uc870\uc791\ubc29\ubc95 \ucd94\uac00[\/p][p]\u3000: \ud0a4\ubcf4\ub4dc \uc88c\uc6b0 CTRL \ud0a4\ub85c 2\ubc30\uc18d\uc744, \uc67c\ucabd SHIFT \ud0a4\ub85c 4\ubc30\uc18d\uc744 \uc870\uc791\ud558\ub294 \uae30\ub2a5\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\u3000\u203b \ud0a4\ubcf4\ub4dc\ub85c \ubc30\uc18d \uc870\uc791\ubc29\ubc95 \uc815\ub9ac[\/p][p]\u3000\u30002\ubc30\uc18d : \ub118\ubc84\ud328\ub4dc \\[+] \ud0a4, \\[\/] \ud0a4, \uc88c\uc6b0 CTRL \ud0a4[\/p][p]\u3000\u30004\ubc30\uc18d : \ub118\ubc84\ud328\ub4dc ENTER \ud0a4, \uc88c\uc6b0 SHIFT \ud0a4[\/p][p]- \uc804\ud22c \uc911 \ubc29\uc5b4 \ubc0f \uc989\uc2dc \ud134\uc885\ub8cc \uc870\uc791\ubc29\ubc95 \ucd94\uac00[\/p][p]\u3000: \ud0a4\ubcf4\ub4dc E \ud0a4, \ucee8\ud2b8\ub864\ub7ec R3 \ubc84\ud2bc(\uc624\ub978\ucabd \uc2a4\ud2f1 \ud074\ub9ad)\uc5d0 \ubc29\uc5b4 \ubc0f \uc989\uc2dc \ud134\uc885\ub8cc \uc870\uc791 \uae30\ub2a5\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]\u3000\u3000\ud134\uc774 \ub3cc\uc544\uc654\uc744 \ub54c \uce90\ub9ad\ud130 \uc774\ub3d9 \uc5c6\uc774 \ubc14\ub85c \ubc29\uc5b4 \ubaa8\ub4dc\ub85c \ub4e4\uc5b4\uac00\uac70\ub098, \uce90\ub9ad\ud130 \uc774\ub3d9 \ud6c4\uc5d0 \ub2e4\ub978 \ud589\ub3d9 \uc5c6\uc774 \ub2e8\ucd95\ud0a4\ub85c \ud134 \uc885\ub8cc\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4.[\/p][p][\/p][p]- \uc790\ub3d9\uc7a5\ube44 \uae30\ub2a5 \uac1c\uc120[\/p][p]\u3000: \ubb34\uae30 \ub0b4\uad6c\ub3c4 \uc801\uc6a9\uc774 OFF \uc0c1\ud0dc\uc77c \ub54c\ub294, \ub0b4\uad6c\ub3c4 1 \uc774\ud558\uc778 \uc7a5\ube44\ub3c4 \uc790\ub3d9 \uc7a5\ube44\ub418\ub3c4\ub85d \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4. \ud0c4\uc57d \uc18c\ubaa8 \ubb34\uc2dc\uac00 ON \uc77c\ub54c\ub294 \ub0a8\uc740 \ud0c4\uc57d\uc774 3 \uc774\ud558\uc778 \ud0c4\uc57d\ub3c4 \uc790\ub3d9 \uc7a5\ube44\ub429\ub2c8\ub2e4.[\/p][p]- \uc804\ud22c\uc911 \uc7a5\ube44 \uba54\ub274\uc5d0\uc11c\ub3c4 \uc7a5\ube44 \uc124\uba85\uc774 \ud45c\uc2dc\ub418\ub3c4\ub85d \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p][b]\\[\ubc84\uadf8 \ubc0f \uc624\ub958 \uc218\uc815][\/b][\/p][p]- \uac8c\uc784 \uc2e4\ud589\uc2dc \uac04\ud639 \ub85c\ub529 \ud654\uba74\uc5d0\uc11c \uc9c4\ud589\ub418\uc9c0 \uc54a\uac8c \ub418\ub294 \uacbd\uc6b0\uac00 \uc788\ub358 \uc624\ub958\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \ub808\ubca8 99\uc5d0 \ub3c4\ub2ec\ud588\uc744 \ub54c \uc804\ud22c \uacb0\uacfc\ucc3d\uc5d0\uc11c \uac8c\uc784\uc774 \uba48\ucd94\ub358 \uc624\ub958\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \ud30c\ud2f0\uc6d0\uc774 \uad50\uccb4\ub41c \ud6c4\uc5d0 MP \uac8c\uc774\uc9c0\uac00 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294 \uacbd\uc6b0\uac00 \uc788\ub358 \ubb38\uc81c\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uc804\ud22c \uc911 \ubb34\uae30 \uad50\uccb4\uc2dc, \ud544\uc0b4\uae30\uac00 \uc788\ub294 \ubb34\uae30\ub85c \uad50\uccb4\ud574\ub3c4 \ud544\uc0b4\uae30 \ubaa9\ub85d\uc5d0 \ucd94\uac00\ub418\uc9c0 \uc54a\uc544 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub358 \ud604\uc0c1\uc744 \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uc804\ud22c \uc911 \ud654\uba74 \ucd5c\uc0c1\ub2e8\/\ucd5c\ud558\ub2e8\uc5d0 \uc801\uc774 \uc788\uc744 \uacbd\uc6b0, \uc77c\ubc18\uacf5\uaca9\uc758 \ucee4\ub9e8\ub4dc \ucc3d\uc774 \uc81c\ub300\ub85c \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub358 \ud604\uc0c1\uc744 \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \ud30c\uc774\uc5b4 \ube14\ub808\uc774\ub4dc, \uc544\uc774\uc2a4 \ube14\ub808\uc774\ub4dc, \uc36c\ub354 \ube14\ub808\uc774\ub4dc\uc758 \uc774\ud399\ud2b8\uac00 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub358 \ud604\uc0c1\uc744 \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uc804\ud22c \uc911 \uc544\uc774\ud15c \uc0ac\uc6a9\uc2dc \uce90\ub9ad\ud130\uc758 \uc544\uc774\ud15c \uc0ac\uc6a9 \ub3d9\uc791\uc774 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub358 \ud604\uc0c1\uc744 \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p][b]\\[\uae30\ud0c0 \uac1c\uc120 \uc0ac\ud56d][\/b][\/p][p]- \uac80 \uc885\ub958 \ubb34\uae30\uc758 \uc0c1\uc138 \uad6c\ubd84\uc744 \ud655\uc778\ud560 \uc218 \uc788\ub294 \ud14d\uc2a4\ud2b8\ub97c \uc7a5\ube44 \uc124\uba85\uc5d0 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. (\uc138\uac80\ub958\/\uc911\uac80\ub958\/\uc7a5\uac80\ub958\/\ub300\uac80\ub958\ub85c \ud45c\uc2dc)[\/p][p]- \uc77c\ubd80 \uce90\ub9ad\ud130\uc758 \uc804\ud22c \uc74c\uc131 \ubcfc\ub968\uc744 \uc870\uc815\ud588\uc2b5\ub2c8\ub2e4. (\uc2e4\ubc84, \uce74\ub098, \uc5d0\uc2a4\uba54\ub784\ub2e4)[\/p][p]- \uc804\ud22c \uc911 XP\uac00 \uac00\ub4dd \ucc3c\uc744 \ub54c \ub208\uc5d0 \ub354 \uc798 \ub744\ub3c4\ub85d \uc804\ud22c UI\ub97c \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uba54\ub514\uce58 \uc804\uaca9\ucc38\uc758 \uc774\ud399\ud2b8 \ud45c\uc2dc \uc704\uce58\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uc804\ud22c \uc885\ub8cc \ud6c4 \ud544\ub4dc \ud654\uba74\uc73c\ub85c \ub3cc\uc544\uc654\uc744 \ub54c \ub9c8\uc6b0\uc2a4 \ucee4\uc11c\uac00 \uc790\ub3d9\uc73c\ub85c \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub3c4\ub85d \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.[\/p][p]- \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud0c0\uc774\ud2c0\ub85c \ub3cc\uc544\uac08 \ub54c BGM\uc774 \ud398\uc774\ub4dc \uc544\uc6c3\ub418\ub3c4\ub85d \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.[\/p][p][\/p][p]\ucf8c\uc801\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc81c\uacf5\ud574\ub4dc\ub9b4 \uc218 \uc788\ub3c4\ub85d \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4.[\/p][p]\uac10\uc0ac\ud569\ub2c8\ub2e4.[\/p][p][\/p][p](2026.10.3 20:15 \ucd94\uac00)[\/p][p][b]\\[\uc54c\ub824\uc9c4 \ubb38\uc81c][\/b][\/p][p]- \uce90\ub9ad\ud130\ubcc4\ub85c \uc124\uc815\ud55c \uc790\ub3d9\uc804\ud22c \uc0c1\uc138 \uc635\uc158\uc774 \uc800\uc7a5\ub418\uc9c0 \uc54a\uace0, \uc804\ud22c\uac00 \uc2dc\uc791\ub420 \ub54c \ucd08\uae30\ud654 \ub418\ub294 \ud604\uc0c1\uc774 \ud655\uc778\ub418\uc5c8\uc2b5\ub2c8\ub2e4.[\/p][p]  \uc870\uc18d\ud55c \uc2dc\uc77c \ub0b4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud1b5\ud574 \uc218\uc815\ud560 \uc608\uc815\uc774\ub2c8 \uc591\ud574 \ubd80\ud0c1\ub4dc\ub9ac\uba70, \uc774\uc6a9\uc5d0 \ubd88\ud3b8\uc744 \ub4dc\ub824 \uc8c4\uc1a1\ud569\ub2c8\ub2e4.[\/p]","commentcount":20,"tags":["patchnotes","mod_reviewed","ModAct_1519738978_1790999046_0","ModAct_1889357040_1791026495_4"],"language":0,"hidden":0,"forum_topic_id":"581684105333197972","event_gid":"680763027479332569","voteupcount":107,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"581684105333197972","rtime32_last_modified":1793541351,"news_post_gid":"0","rtime_mod_reviewed":1791026496,"featured_app_tagid":0,"referenced_appids":[],"build_id":25674418,"build_branch":"","unlisted":0,"rtime_created":1790997903,"votes_up":107,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"569298022367809354","gidfeature2":"581684105333197972"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["680763027479332671"],"last_update_event":{"rtime":1790997960,"event_gid":"680763027479332569","announcement_gid":"680763027479332570","clan_account_id":46292143}}};

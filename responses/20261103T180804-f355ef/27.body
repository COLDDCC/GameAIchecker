4739481785239","gidfeature2":"568175573451657286"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":[],"last_update_event":{"rtime":1793362234,"event_gid":"689772763384121388","announcement_gid":"689772763384121389","clan_account_id":46160074}}};

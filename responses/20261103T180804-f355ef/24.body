							var StoreDefaults = {"PartnerEventStore":[{"gid":"696526894227522225","clan_steamid":"103582791475797408","event_name":"No Trust Fund Required\u2014L.A. Heartbreaker Is 15% Off!","event_type":20,"appid":4870960,"server_address":null,"server_password":null,"rtime32_start_time":1792029600,"rtime32_end_time":1792047600,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Step into L.A.\u2019s high life for less. Launch offers are live, with more community celebrations on the way.\",null,null,null,null,null,\"\u9996\u53d185\u6298\uff0c\u6346\u7ed1\u5305\u6298\u4e0a\u6298\uff01\u4e0a\u7ebf\u6d3b\u52a8\u540c\u6b65\u5f00\u542f\uff0c\u4eb2\u7b7e\u3001\u5370\u7b7e\u4e0e\u89d2\u8272\u5468\u8fb9\u7b49\u4f60\u6765\u8d62\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The Fame Game II: L.A. Heartbreaker is live! Save 15% on the sequel, 50% on the first game, and an extra 10% with the bundle.\",null,null,null,null,null,\"\u300a\u540d\u5229\u573a2\uff1a\u5192\u724c\u5bcc\u5c11\u300b\u73b0\u5df2\u4e0a\u7ebf\uff01\u9996\u53d1\u9650\u65f685\u6298\uff0c\u524d\u4f5c\u540c\u671f5\u6298\uff0c\u6346\u7ed1\u5305\u6298\u4e0a\u518d\u4eab9\u6298\u3002\u53c2\u4e0e\u4e0a\u7ebf\u6d3b\u52a8\uff0c\u8d62\u53d6\u4eb2\u7b7e\u3001\u5370\u7b7e\u3001\u543b\u7b7e\u53ca\u89d2\u8272\u5468\u8fb9\uff01\u6d3b\u52a8\u8be6\u60c5\u4e0e\u62a5\u540d\u5165\u53e3\u89c1\u6b63\u6587\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"3029be3e06dbdafad65f8a5a3c54ac6ec9dadfbf.png\",null,null,null,null,null,\"892cec826ea6526b522bb45405e5940c59e17b30.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c8f2a767505ee5f3c103c517aa53d8a426b36d4b.png\",null,null,null,null,null,\"027ea46ad7fcbe0f524c79c22cbd271b574d6451.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"696526894227522226","clanid":"46276000","posterid":"0","headline":"No Trust Fund Required\u2014L.A. Heartbreaker Is 15% Off!","posttime":1792029674,"updatetime":1792029674,"body":"[p][b]You\u2019ve borrowed a rich boy\u2019s identity. Thankfully, you don\u2019t need his bank account.[\/b][\/p][p][\/p][p][b]The Fame Game II: L.A. Heartbreaker[\/b] is live on Steam! The high life is calling, and we\u2019re celebrating with a few ways to make your entrance for less.[\/p][p][\/p][h3]Big Secrets. Smaller Price Tag.[\/h3][p][\/p][p]Five tangled romances. An identity that isn\u2019t yours. What could possibly go wrong?[\/p][p][\/p][p]Find out for [b]$10.19 USD\u201415% off the regular price of $11.99[\/b] during the limited-time launch offer.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/3317d2cc6dbabfd8b0a256e259dd1e108d674e24.png\"][\/img][\/p][p][\/p][h3]Make It a Double Feature[\/h3][p][\/p][p]The first game, [b]The Fame Game: Welcome to Hollywood[\/b], is also [b]50% off[\/b].[\/p][p][\/p][p]Pick up both in [b]The Fame Game: Love, Lies & Limelight[\/b] and enjoy an [b]additional 10% off[\/b] on top of each game\u2019s current discount. Two games, one invitation to get caught up in the drama.[\/p][p][\/p][p][\/p][p][\/p][h2][b]FOLLOW THE FAME GAME[\/b][\/h2][p][b]YouTube:[\/b][\/p][p][\/p][p][dynamiclink href=\"https:\/\/www.youtube.com\/channel\/UC027mEkkU396SIsD3pE9VeQ\"][\/dynamiclink][\/p][p][\/p][p][b]TikTok: [\/b][\/p][p][\/p][p][url=\"https:\/\/www.tiktok.com\/@playthefamegame\"]https:\/\/www.tiktok.com\/@playthefamegame[\/url][\/p][p][\/p][p][\/p][p][b]Instagram: [\/b][\/p][p][\/p][p][url=\"https:\/\/www.instagram.com\/playthefamegame\/\"]https:\/\/www.instagram.com\/playthefamegame\/[\/url][\/p][p][\/p][p][\/p][p][b]Keep your story straight. Your feelings? Good luck with those.[\/b][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4870960\/2\/\"][\/dynamiclink][\/p][p][\/p]","commentcount":0,"tags":["ModAct_1426387032_1792031259_2_20","mod_reviewed","ModAct_1426387032_1792031260_0"],"language":0,"hidden":0,"forum_topic_id":"706660083369529859","event_gid":"696526894227522225","voteupcount":14,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792029600,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369529859","rtime32_last_modified":1792362285,"news_post_gid":"0","rtime_mod_reviewed":1792031261,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792011102,"votes_up":14,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"580554442217361025","gidfeature2":"706660083369529859"},{"gid":"696526894227522204","clan_steamid":"103582791475797408","event_name":"Fake It Till They Love You \u2014 The Fame Game II: L.A. Heartbreaker Is Out Now!","event_type":10,"appid":4870960,"server_address":null,"server_password":null,"rtime32_start_time":1792029600,"rtime32_end_time":1792035001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"The identity is fake. Are the feelings real? Five tangled romances. One lie that could change everything.\",null,null,null,null,null,\"\u8eab\u4efd\u662f\u5047\u7684\uff0c\u5fc3\u52a8\u5462\uff1f\u4e94\u6bb5\u5173\u7cfb\uff0c\u91cd\u91cd\u79d8\u5bc6\u2014\u2014\u5728\u6d1b\u6749\u77f6\u540d\u5229\u573a\uff0c\u8c01\u4f1a\u7231\u4e0a\u771f\u5b9e\u7684\u4f60\uff1f\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The Fame Game II: L.A. Heartbreaker is out now! Save 15% at launch, and catch Zhong Chenyao live on Douyin.\",null,null,null,null,null,\"\u300a\u540d\u5229\u573a2\uff1a\u5192\u724c\u5bcc\u5c11\u300b\u73b0\u5df2\u4e0a\u7ebf\uff01\u5316\u8eab\u5192\u724c\u5bcc\u5c11\uff0c\u5728\u8c0e\u8a00\u4e0e\u771f\u5fc3\u4e4b\u95f4\u505a\u51fa\u9009\u62e9\u3002\u9996\u53d1\u9650\u65f685\u6298\uff0c\u949f\u6668\u7476\u6296\u97f3\u76f4\u64ad\u52a9\u9635\uff0c\u66f4\u6709\u4eb2\u7b14\u7b7e\u540d\u7167\u3001\u6d77\u62a5\u3001\u89d2\u8272\u5c0f\u5361\u7b49\u597d\u793c\u9646\u7eed\u9001\u51fa\uff01\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"3029be3e06dbdafad65f8a5a3c54ac6ec9dadfbf.png\",null,null,null,null,null,\"892cec826ea6526b522bb45405e5940c59e17b30.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c8f2a767505ee5f3c103c517aa53d8a426b36d4b.png\",null,null,null,null,null,\"62789053198fe4e52f14f27613e6b58de80b966d.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"696526894227522205","clanid":"46276000","posterid":"0","headline":"Fake It Till They Love You \u2014 The Fame Game II: L.A. Heartbreaker Is Out Now!","posttime":1792029666,"updatetime":1792029666,"body":"[h3][b]One borrowed identity. Five tangled romances. Welcome to L.A.[\/b][\/h3][p][\/p][p][b]The Fame Game II: L.A. Heartbreaker[\/b] launches today, [b]October 14,[\/b] on Steam! [\/p][p][\/p][p]Developed and published by Interactive Films LLC, the game combines live-action storytelling, branching choices, and romance\u2014with you at the center of it all.[\/p][p][\/p][p]Celebrate the launch with [b]15% off for a limited time: $10.19 USD, down from $11.99.[\/b][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/3317d2cc6dbabfd8b0a256e259dd1e108d674e24.png\"][\/img][\/p][p][\/p][h2]Filmed on Location in Los Angeles[\/h2][p][\/p][p]From the Hollywood Walk of Fame to the beaches of Santa Monica, this story unfolds against the real sights of Los Angeles.[\/p][p][\/p][p]A professional Los Angeles-based film crew brought the game to life at more than ten real-world locations, including Griffith Observatory and Redondo Beach. Ayaka\u2019s mansion was filmed at a real Beverly Hills estate, while the lavish home your character lives in once belonged to the founder of a well-known magazine.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/a75ded49b66497ed2fb285282a32c9764abc40c6.jpg\"][\/img][\/p][h2]Meet the Cast[\/h2][p][\/p][p][b]Zhong Chenyao[\/b] leads the cast as Ayaka, a [b]Yakuza[\/b] heiress. Joining her is [b]Tian Shiyu[\/b], winner of the 2021 Miss Asia Global Popularity Award, as your childhood sweetheart, [b]Li Sisi[\/b]. The other three leads bring experience from the opera stage and the Los Angeles film and television scene.[\/p][p][\/p][p]Zhong Chenyao will also host a [b]livestream on Douyin[\/b] to celebrate the release with players.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/4e7612a5ba05b230b6cc35092dba05601aa3a914.png\"][\/img][\/p][p][\/p][h2]How Far Will You Take the Lie?[\/h2][p][\/p][p]A cash-strapped international student. A case of mistaken identity. A wealthy heir\u2019s name that isn\u2019t yours.[\/p][p][\/p][p]Suddenly, you\u2019re living a lie among L.A.\u2019s elite, caught up in five relationships with people who each have their own motives\u2014and their own secrets.[\/p][p][\/p][p]Every nod, every evasive answer, every moment you choose to stay silent: someone is paying attention. How far will you take the lie? And who will you trust with the truth first?[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/c2cd21e0784262351c63e0c8c92f41dffbf78916.jpg\"][\/img][\/p][p][\/p][h2]Launch Offers: Save on Both Games[\/h2][p][\/p][p]Pick up [b]The Fame Game II: L.A. Heartbreaker[\/b] for $10.19 USD\u2014[b]15% off its regular price of $11.99[\/b] during the launch offer.[\/p][p][\/p][p]The first game, [b]The Fame Game: Welcome to Hollywood[\/b], is also [b]50% off[\/b].[\/p][p][\/p][p]Get both games in [b]The Fame Game: Love, Lies & Limelight[\/b] and enjoy an [b]additional 10% off[\/b] their already-discounted prices.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276000\/2c6f159c287e279c04d717eff9f6484390291263.jpg\"][\/img][\/p][p][\/p][h2][b]FOLLOW THE FAME GAME[\/b][\/h2][p][b]YouTube:[\/b][\/p][p][dynamiclink href=\"https:\/\/www.youtube.com\/channel\/UC027mEkkU396SIsD3pE9VeQ\"][\/dynamiclink][\/p][p][\/p][p][b]TikTok: [\/b][\/p][p][url=\"https:\/\/www.tiktok.com\/@playthefamegame\"]https:\/\/www.tiktok.com\/@playthefamegame[\/url][\/p][p][\/p][p][b]Instagram: [\/b][\/p][p][url=\"https:\/\/www.instagram.com\/playthefamegame\/\"]https:\/\/www.instagram.com\/playthefamegame\/[\/url][\/p][p][\/p][p]Borrow a name. Steal a heart. Try not to get caught.[\/p][p][\/p][p][b]Play The Fame Game II: L.A. Heartbreaker now\u2014and find out who\u2019s falling for the lie, and who\u2019s falling for you.[\/b][\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4870960\/The_Fame_Game_II_LA_Heartbreaker\/\"][\/dynamiclink][\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1426387032_1792031240_0"],"language":0,"hidden":0,"forum_topic_id":"706660083369529847","event_gid":"696526894227522204","voteupcount":30,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369529847","rtime32_last_modified":1793677443,"news_post_gid":"0","rtime_mod_reviewed":1792031241,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792004168,"votes_up":30,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"580554442217361025","gidfeature2":"706660083369529847"},{"gid":"672884264786723129","clan_steamid":"103582791475797408","event_name":"Update Announcement - October 28, 2026","event_type":12,"appid":4870960,"server_address":null,"server_password":null,"rtime32_start_time":1793155914,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"672884264786723130","clanid":"46276000","posterid":"0","headline":"Update Announcement - October 28, 2026","posttime":1793155914,"updatetime":1793155914,"body":"1.Improved the video playback quality for the \"Battle with the Dragon\" sequence, delivering more refined visuals.\n2.Fixed an issue in Chapter 3's Paladin route that prevented Camille's affinity animation from displaying.","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1751555285_1793156440_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630404173","event_gid":"672884264786723129","voteupcount":7,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630404173","rtime32_last_modified":1793571933,"news_post_gid":"0","rtime_mod_reviewed":1793156440,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793155914,"votes_up":7,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"580554442217361025","gidfeature2":"565923773630404173"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["696526894227522226","696526894227522205"],"last_update_event":{"rtime":1793155914,"event_gid":"672884264786723129","announcement_gid":"672884264786723130","clan_account_id":46276000}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/9645d91067f581f2ec128b2441836828.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >Brought to life by a professional team with experience in Hollywood film and television, The Fame Game II is crafted to feature-film standards across direction, cinematography, lighting, costume, makeup, and production design.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Filmed on location at landmarks across Los Angeles, the city's unmistakable light and atmosphere become part of the story.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/c7c97c2fef5f90dc5b617c9f7a1e302c.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/c7c97c2fef5f90dc5b617c9f7a1e302c.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/c7c97c2fef5f90dc5b617c9f7a1e302c.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/5d3b76c7cfb864c66264a8dab069302b.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >More than 200,000 player votes helped shape the cast, led by Zhong Chenyao as Ayaka. Five actresses bring every relationship, secret, and emotional turning point to life through live-action performances.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/2d245fe9e6796ce57bd209b858529a7f.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/2d245fe9e6796ce57bd209b858529a7f.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/2d245fe9e6796ce57bd209b858529a7f.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/38bacf3479682cce8b448626516503eb.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >You are He Shuhan, an ordinary international student—until a deal lands you at the gates of a Los Angeles mansion.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >You put on a tailored three-piece suit. You learn how to hold a champagne flute. You step into the life of someone born to wealth.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >This city respects only winners.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >And winners never ask where you came from.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >A mask you cannot remove. Designer clothes you must learn to wear. Lies delivered at exactly the right moment. Five dangerous relationships balanced on a knife’s edge.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Before long, you have almost everyone fooled.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Almost.</p><h2 class="bb_tag" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/65bb1dffe93a48230224d898f04a221d.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/65bb1dffe93a48230224d898f04a221d.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/65bb1dffe93a48230224d898f04a221d.mp4?t=1792029524" type="video/mp4"></video></span></h2><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/352af03ac2bf6cff8279abc486f3fcbf.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f47f3d59c0d1961eef3f0c4fe9a126fa.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f47f3d59c0d1961eef3f0c4fe9a126fa.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f47f3d59c0d1961eef3f0c4fe9a126fa.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" style="text-align: center"></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/e8ccbcf76dd8caf3f861d29671a96e31.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >She has already decided that you are her fiancé. She says it with the sweetest innocence—and the certainty of someone who will not take no for an answer.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Her love is less a romance than a kidnapping, and there is no way out.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/753e79081ca3a635accdefa20bda0941.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/753e79081ca3a635accdefa20bda0941.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/753e79081ca3a635accdefa20bda0941.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f2a4e230852b92e7a6b9d9f25394f209.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >She is the only person who sees straight through your disguise—and the only one who has never tried to expose you.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/59734d0fad9a907d436af96480e48383.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/59734d0fad9a907d436af96480e48383.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/59734d0fad9a907d436af96480e48383.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/baf955eca216d69c855d732bcf7d7b38.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >Every tender moment comes with a price.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >She is not falling for you. She is falling for the wealthy heir she believes you are.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f1c27a207e424d8bdd5e57614d9c2fa5.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f1c27a207e424d8bdd5e57614d9c2fa5.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/f1c27a207e424d8bdd5e57614d9c2fa5.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/4919e039630edaa51a9891ed2beba749.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >She knows every secret that could destroy you, threatening you one moment and protecting you the next.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >No one understands what it means to live as an impostor better than she does—and no one is harder to read.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/bc84a3ef80dc2a0764ce13f9dd6b5ab4.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/bc84a3ef80dc2a0764ce13f9dd6b5ab4.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/bc84a3ef80dc2a0764ce13f9dd6b5ab4.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/d91469599e2c6448ed307f46df49535c.avif?t=1792029524" width=600 height=100 /></span></p><p class="bb_paragraph" >She is the first to notice the cracks in your story—and still chooses to cover for you.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >But you can never tell: does she see a younger brother who needs protecting… or a man she cannot afford to let too close?</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/a028e4b62ccae3e9c8426753847b8179.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/a028e4b62ccae3e9c8426753847b8179.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/a028e4b62ccae3e9c8426753847b8179.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/6d882c04fc469a656a940cbde791ad40.avif?t=1792029524" width=600 height=100 /></span></p><h2 class="bb_tag" ><strong>HUNDREDS OF CHOICES. COUNTLESS CONSEQUENCES.</strong></h2><p class="bb_paragraph" >Every lie demands another lie to protect it.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Throw money around like a real heir, or tear off the mask with a single choice and face the consequences.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Some keep the performance going until the very end. Some are crushed by debt and left on the streets. Some are killed when the underworld turns against them.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >And some, after every disguise is gone, find someone waiting to catch them—someone who knew the truth all along and never said a word.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >The greatest danger is not being exposed.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >It is playing the role so well that even you can no longer tell which self is real.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Identity is the game. Your heart is on the line.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/1f494e7c9a7fefb0260f31e0de308c8b.poster.avif?t=1792029524" width=1170 height=658 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/1f494e7c9a7fefb0260f31e0de308c8b.webm?t=1792029524" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4870960/extras/1f494e7c9a7fefb0260f31e0de308c8b.mp4?t=1792029524" type="video/mp4"></video></span></p><p class="bb_paragraph" > </p>						</div>
					</div>
					<div class="game_page_autocollapse">

l,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"704408827984875378","clanid":"46544568","posterid":"0","headline":"One Way Tickets Releasing Date and Price","posttime":1792648628,"updatetime":1792648628,"body":"[p]Everyone, thank you for waiting! [\/p][p]The EA release date for [i]One Way Tickets[\/i] is now confirmed!\nRelease time: October 23, 13:00 Beijing Time\nBase price: $17.99USD\nLaunch discount: $14.4 USD (20% off for the first week)\nDuration time: about 15\u201320 hours[\/p][p][\/p][p align=\"start\"]This game blends roguelike and incremental elements. As you play and explore more deeply during your journey, mechanics and content will gradually unlock, offering a unique experience that unfolds step by step.[\/p][p][\/p][p align=\"start\"]The Early Access version may contain many parts that still need polishing. We hope you'll share plenty of feedback to help us identify shortcomings and find the way forward.[\/p][p align=\"start\"]Thank you all for your continued support, patience, and understanding.[\/p][p][\/p][p align=\"start\"]We look forward to meeting you on this journey![\/p]","commentcount":27,"tags":["mod_reviewed","ModAct_1751692459_1792648986_0"],"language":0,"hidden":0,"forum_topic_id":"568174939259130414","event_gid":"704408827984875377","voteupcount":177,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568174939259130414","rtime32_last_modified":1793447701,"news_post_gid":"0","rtime_mod_reviewed":1792648986,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792648112,"votes_up":177,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"568174939259130413","gidfeature2":"568174939259130414"},{"gid":"704409462168881688","clan_steamid":"103582791476065976","event_name":"11.2 update v0.8.0.6","event_type":12,"appid":4817620,"server_address":null,"server_password":null,"rtime32_start_time":1793621460,"rtime32_end_time":1793626201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Small Fixes\",null,null,null,null,null,\"\u5c0f\u5c0f\u66f4\u65b0\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,n
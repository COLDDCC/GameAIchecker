ll,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"704409462168881689","clanid":"46544568","posterid":"0","headline":"11.2 update v0.8.0.6","posttime":1793621514,"updatetime":1793621514,"body":"[p]v0.8.0.6[\/p][p]Bug fixes[\/p][olist][*][p]Unified the health bar display issues for all elite monsters.[\/p][\/*][*][p]Fixed an issue where the speed boost effect was not removed after the Boiler was damaged.[\/p][\/*][\/olist][p]Optimizations[\/p][olist][*][p]Fixed frame drops after opening the Jianmu Astrolabe interface.[\/p][\/*][*][p]Clicking a button on the main menu now immediately enters the loading screen instead of freezing on the current screen.[\/p][\/*][\/olist][p]Devices and Curios[\/p][olist][*][p]Updated the animation and mechanics of the \"Kraken Tentacle\" Device, increasing its attack angle range.[\/p][\/*][*][p]Increased the appearance chance of high-quality curios.[\/p][\/*][*][p]Adjusted the selling prices and bonus values of some relics.[\/p][\/*][\/olist][p]\n[\/p]","commentcount":3,"tags":["patchnotes","mod_reviewed","ModAct_768955665_1793622084_0"],"language":0,"hidden":0,"forum_topic_id":"569301797587599073","event_gid":"704409462168881688","voteupcount":21,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"569301797587599073","rtime32_last_modified":1793692162,"news_post_gid":"0","rtime_mod_reviewed":1793622085,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793620504,"votes_up":21,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"568174939259130413","gidfeature2":"569301797587599073"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["704408827984875378"],"last_update_event":{"rtime":1793621460,"event_gid":"704409462168881688","announcement_gid":"704409462168881689","clan_account_id":46544568}}};

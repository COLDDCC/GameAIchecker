es] Complete Translation Revision & QoL Improvements","event_type":12,"appid":3208930,"server_address":null,"server_password":null,"rtime32_start_time":1791795240,"rtime32_end_time":1791799201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"689770861148769718","clanid":"45575929","posterid":"0","headline":"[Patch Notes] Complete Translation Revision & QoL Improvements","posttime":1791795291,"updatetime":1791795291,"body":"[p]Hello. [\/p][p]This is the development team, BLANBEE.[\/p][p][\/p][p]The complete re-inspection and revision of the English and Chinese translations, which many of you have been waiting for, are finally complete.[\/p][p]In addition, we have added a new feature to improve your gameplay experience and fixed some bugs. Please check the details below.[\/p][p][\/p][p][b]\\[Translation Updates][\/b][\/p][p][b]Complete re-inspection and revision of all English and Chinese (Simplified\/Traditional) texts[\/b][\/p][list][*][p]As promised in our previous announcement, we have completely redone the Localization Quality Assurance (LQA) for all texts from scratch, including reviews by native speakers.[\/p][\/*][*][p]Rather than making partial corrections, we conducted a full re-inspection and revision across all chapters, correcting mistranslations, typos, and inconsistent terminology.[\/p][\/*][\/list][p][\/p][p][b]\\[New Features & Bug Fixes][\/b][\/p][p][b]Added a 'Load' feature allowing you to manually select your desired save data[\/b][\/p][list][*][p]By clicking the 'Save Icon' on the main screen, you can open the save data list and load your preferred save point.[\/p][\/*][\/list][p][b]Fixed an issue where cooking recipes were displayed multiple times[\/b][\/p][list][*][p]Cooking recipes (details) will now be displayed only once.[\/p][\/*][\/list][p][\/p][p]If you find any additional issues or have suggestions, please report them via our official Discord, and we will check and respond as quickly as possible.[\/p][p][\/p][p]Thank you.[\/p][p]Sincerely, BLANBEE[\/p]","commentcount":4,"tags":["patchnotes","mod_reviewed","ModAct_1425146861_1791796248_0"],"language":0,"hidden":0,"forum_topic_id":"592943924842112903","event_gid":"689770861148769717","voteupcount":104,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"592943924842112903","rtime32_last_modified":1793579411,"news_post_gid":"0","rtime_mod_reviewed":1791796248,"featured_app_tagid":0,"referenced_appids":[],"build_id":25877425,"build_branch":"","unlisted":0,"rtime_created":1791769185,"votes_up":104,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"591773674360556823","gidfeature2":"592943924842112903"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["679635858932891966","702153223322994077"],"last_update_event":{"rtime":1791795240,"event_gid":"689770861148769717","announcement_gid":"689770861148769718","clan_account_id":45575929}}};

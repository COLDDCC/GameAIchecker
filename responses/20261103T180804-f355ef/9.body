							var StoreDefaults = {"PartnerEventStore":[{"gid":"714541927145413543","clan_steamid":"103582791475643230","event_name":"The Legend of Fancy Realm Remake v2.2.6 Patch Notes","event_type":13,"appid":4030150,"server_address":null,"server_password":null,"rtime32_start_time":1793070300,"rtime32_end_time":1793075401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"905b2b0fc8e543a617b6d29174970ac6abcd3d7d.png\",null,null,null,\"905b2b0fc8e543a617b6d29174970ac6abcd3d7d.png\",null,\"dd6cc1a885e68d9ea1af96ce122c5ea1de344a37.png\",\"dd6cc1a885e68d9ea1af96ce122c5ea1de344a37.png\",null,null,\"905b2b0fc8e543a617b6d29174970ac6abcd3d7d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"714541927145413544","clanid":"46121822","posterid":"0","headline":"The Legend of Fancy Realm Remake v2.2.6 Patch Notes","posttime":1793070367,"updatetime":1793088178,"body":"[p]Dear Players,[\/p][p]It has been one month since The Legend of Fancy Realm Remake launched! Thank you for your continued support and for being part of this journey with us. We take every piece of feedback we have received during this time seriously and continue to incorporate your suggestions into our update plans.[\/p][p]Here are the changes included in this update:[\/p][p]\u30fbOne-Month Anniversary Gifts[\/p][p]\u30fbNew Special Costume for Cloti[\/p][p]\u30fbAdded Hold-to-Auto-Increase\/Decrease for Stat Resets[\/p][p]\u30fbImproved Sorting for Magic and Skill Lists[\/p][p]\u30fbStat Adjustments and Multiple Bug Fixes[\/p][p]1. One-Month Anniversary Gifts[\/p][p]To celebrate the one-month anniversary of the game's launch, we have prepared the following gifts for all players:[\/p][p]\u30fbCloti's Special Costume \u00d71[\/p][p]\u30fbFalcon Source \u00d79 (Each use permanently increases Hit Rate by 10%.)[\/p][p]Each main game save file can claim these gifts once. DLC save files are not eligible.[\/p][p]After updating the game, a notification will appear on the main menu, and the gifts will be delivered directly to your Storage. Be sure to check them out![\/p][p]\u203b The main menu notification will be displayed until November 15, 2026, at 23:59. The gifts can still be claimed after the notification period ends.[\/p][p]2. New Features and Adjustments[\/p][p]Cloti's Special Costume[\/p][p]\u30fbAdded a special costume appearance for Cloti, along with a dedicated turn-order icon.[\/p][p]\u30fbThe special costume appearance is automatically unlocked once Cloti joins your party.[\/p][p]\u30fbOnce you own the required costume, you can switch to its appearance directly, whether the costume is in your Storage, inventory, or currently equipped.[\/p][p]Stat Reset[\/p][p]\u30fbAdded the ability to hold the button to continuously increase or decrease stat points when resetting stats.[\/p][p]Magic and Special Skill Lists[\/p][p]\u30fbUnified the sorting of skill lists in the Battle Skill menu, Party Status screen, and Class Change interface.[\/p][p]\u30fbSkills are now sorted by element in the following order: None > Fire > Water > Wind > Earth > Mind, followed by MP cost from highest to lowest, making skills easier to find.[\/p][p]Stats and Stages[\/p][p]\u30fbAdjusted the maximum Magic Attack value for final classes.[\/p][p]\u30fbIncreased Hao's initial strength when first encountered in New Game+ playthroughs.[\/p][p]\u30fbAdjusted event content in the \"Raging Tide\" and \"Legacy\" stages.[\/p][p]\u30fbUpdated the description of the Weakness status to clarify that affected characters cannot use skills.[\/p][p]3. Bug Fixes[\/p][p]Achievements[\/p][p]\u30fbFixed an issue where certain achievements could not be unlocked.[\/p][p]\u30fbFixed an issue where certain achievements would only be completed after reloading a save file.[\/p][p]Characters and Costumes[\/p][p]\u30fbFixed an issue where certain story events would not trigger when entering a village while wearing a costume.[\/p][p]Equipment[\/p][p]\u30fbFixed an issue where the resistance values shown in the equipment preview did not match the actual values after equipping the item.[\/p][p]Save Data and New Game+[\/p][p]\u30fbFixed an issue where compensation items could not be claimed after starting a new playthrough.[\/p][p]Other[\/p][p]\u30fbFixed abnormal behavior affecting certain enemies.[\/p][p]\u30fbImproved game stability to reduce occasional errors and crashes under certain circumstances.[\/p][p]If there are still areas that need improvement after this update, please feel free to share your feedback. We will continue working to make the game better.[\/p][p]Thank you once again for your continued support and for being with us on this journey.[\/p][p]The Legend of Fancy Realm Remake Development Team[\/p]","commentcount":7,"tags":["workshop","mod_reviewed","ModAct_1426387032_1793072502_0","ModAct_1866137740_1793087989_4","ModAct_1415716708_1793088821_4"],"language":0,"hidden":0,"forum_topic_id":"565923440615533055","event_gid":"714541927145413543","voteupcount":165,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923440615533055","rtime32_last_modified":1793628252,"news_post_gid":"0","rtime_mod_reviewed":1793088821,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793069180,"votes_up":165,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"590684692649358513","gidfeature2":"565923440615533055"},{"gid":"699903325897754941","clan_steamid":"103582791475643230","event_name":"v2.2.3 Patch Notes","event_type":13,"appid":4030150,"server_address":null,"server_password":null,"rtime32_start_time":1791270600,"rtime32_end_time":1791275401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"905b2b0fc8e543a617b6d29174970ac6abcd3d7d.png\",null,null,null,null,null,\"dd6cc1a885e68d9ea1af96ce122c5ea1de344a37.png\",\"dd6cc1a885e68d9ea1af96ce122c5ea1de344a37.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"699903325897754942","clanid":"46121822","posterid":"0","headline":"v2.2.3 Patch Notes","posttime":1791270613,"updatetime":1791276558,"body":"[p]This update adds the New Game+ Enemy Difficulty option and the ability to change your character's appearance after changing jobs. It also includes adjustments and fixes to combat balance, quest progression, UI behavior, and performance.[\/p][p]\u25a1 New Features[\/p][p]\u30fbAdded the New Game+ Enemy Difficulty option.[\/p][p]Starting from the second playthrough, you can choose whether to strengthen enemies when loading your save data. When enabled, enemies will use equipment from later stages of the game, providing a more challenging gameplay experience.[\/p][p]\u30fbThe enemy difficulty setting is saved with your save data and can be selected again when starting a new playthrough.[\/p][p]\u30fbStarting from the second playthrough, the following stat-enhancing items are now available for purchase in shops:[\/p][p]\"Source of Power,\" \"Source of Defense,\" \"Source of Magic,\" and \"Source of Speed.\"[\/p][p]\u30fbAdded the ability to change your character's appearance after changing classes.[\/p][p]\u25a1 Combat & Balance Adjustments[\/p][p]\u30fbAdjusted the level cap of enemies in Main Story stages.[\/p][p]\u30fbAdjusted the base evasion rate of enemies to 0.[\/p][p]\u30fbIncreased the success rate of Steal for the normal version of Golden Hand.[\/p][p]\u30fbAdjusted the effects and description of Divine Axe: Seven-Star Dragon.[\/p][p]The Counter Rate and All Elemental Resistance bonuses can now stack up to 7 times, for a maximum increase of 35%.[\/p][p]\u30fbFixed an issue where the weakening effect value was not displayed in the description of Weakness Arrow.[\/p][p]\u30fbFixed an issue where ally and enemy target detection could behave incorrectly within the area of effect of certain skills.[\/p][p]\u30fbFixed an issue with Gulu's second action in the Classic version and adjusted its attack range after changing jobs.[\/p][p]\u203b If Gulu has already changed classes in your current save data, only the attack range adjustment will be applied automatically with this update.[\/p][p]To fully apply the fix related to the second action, return to the stage \"Unknown\" and have Gulu change jobs again. We apologize for any inconvenience.[\/p][p]\u25a1 Bug Fixes & Performance Improvements[\/p][p]\u30fbFixed an issue where some quest events could stop progressing or map events could fail to restore correctly after loading save data.[\/p][p]\u30fbFixed an issue where the Main Menu could still be opened while entering a village or displaying the village name.[\/p][p]\u30fbFixed an issue where turns could be ended prematurely while the effects of Card Game were being resolved.[\/p][p]\u30fbFixed class restriction settings for certain equipment.[\/p][p]\u30fbFixed incorrect descriptions for certain equipment, items, and status effects.[\/p][p]\u30fbFixed an issue where incorrect background music could play during the \"Imbalance\" and \"Dawn\" animations in the Memoirs.[\/p][p]\u30fbFixed various issues that could occur during certain battlefield sequences.[\/p][p]\u30fbOptimized character outline rendering performance.[\/p][p]\u25a1 Other[\/p][p]Added the following launch options:[\/p][p]\u30fbEnter -godset[\/p][p]When enabled, press the Del key while selecting a target for a normal attack to instantly defeat the character currently under the cursor.[\/p][p]\u30fbEnter -walker n[\/p][p]Allows you to specify which character walks around on the World Map:[\/p][p]0: Leonard[\/p][p]1: Tina[\/p][p]2: Hu[\/p][p]3: Hanks[\/p][p]4: Sheila[\/p][p]5: Rett[\/p][p]6: Hao[\/p][p]7: Gulu[\/p][p]8: Cloti[\/p][p]For example, to enable the cheat and set Tina as the World Map character, enter the following in the launch options:[\/p][p]-godset -walker 1[\/p][p]Thank you to all players for your continued feedback and suggestions. We will continue working to improve the game's content and overall gameplay experience.[\/p]","commentcount":15,"tags":["workshop","mod_reviewed","ModAct_1866137740_1791271310_0","ModAct_1866137740_1791277521_4"],"language":0,"hidden":0,"forum_topic_id":"585061900942036091","event_gid":"699903325897754941","voteupcount":239,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,
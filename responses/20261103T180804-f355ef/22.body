fdd6255c7d8f09e00f63ff064f9723428bd\/ss_ef041fdd6255c7d8f09e00f63ff064f9723428bd.600x338.jpg?t=1792803036","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/ef041fdd6255c7d8f09e00f63ff064f9723428bd\/ss_ef041fdd6255c7d8f09e00f63ff064f9723428bd.1920x1080.jpg?t=1792803036"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/5819a2c86296308df26823bfdfbbe418ab124f10\/ss_5819a2c86296308df26823bfdfbbe418ab124f10.600x338.jpg?t=1792803036","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/5819a2c86296308df26823bfdfbbe418ab124f10\/ss_5819a2c86296308df26823bfdfbbe418ab124f10.1920x1080.jpg?t=1792803036"},{"id":10,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/fc67279b25f5f1c342db12cd315f1cbcdd46c9da\/ss_fc67279b25f5f1c342db12cd315f1cbcdd46c9da.600x338.jpg?t=1792803036","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/fc67279b25f5f1c342db12cd315f1cbcdd46c9da\/ss_fc67279b25f5f1c342db12cd315f1cbcdd46c9da.1920x1080.jpg?t=1792803036"},{"id":11,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/9d15b65efc5ffa5c7853927016c40117279fe55c\/ss_9d15b65efc5ffa5c7853927016c40117279fe55c.600x338.jpg?t=1792803036","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/9d15b65efc5ffa5c7853927016c40117279fe55c\/ss_9d15b65efc5ffa5c7853927016c40117279fe55c.1920x1080.jpg?t=1792803036"},{"id":12,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/ce00ea8f2df61a0fb4620164b3797b434ac8550f\/ss_ce00ea8f2df61a0fb4620164b3797b434ac8550f.600x338.jpg?t=1792803036","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5195600\/ce00ea8f2df61a0fb4620164b3797b434ac8550f\/ss_ce00ea8f2df61a0fb4620164b3797b
 right to update event details, revoke rewards, or cancel the event at any time.\u00a0[\/p][\/*][\/list]","commentcount":13,"tags":["mod_reviewed","ModAct_1896160435_1793670839_0"],"language":0,"hidden":0,"forum_topic_id":"574931289648688749","event_gid":"675135430408018891","voteupcount":71,"votedowncount":17,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793670300,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574931289648688749","rtime32_last_modified":1793695645,"news_post_gid":"0","rtime_mod_reviewed":1793670840,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793091695,"votes_up":71,"votes_down":17,"comment_type":"ForumTopic","gidfeature":"802345591601371154","gidfeature2":"574931289648688749"},{"gid":"675135430408018893","clan_steamid":"103582791475596239","event_name":"[Winner's Announcement] Daeva Makeover","event_type":28,"appid":3393110,"server_address":null,"server_password":null,"rtime32_start_time":1793664000,"rtime32_end_time":1793692800,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"82bb0e536d1996af470da9910f34292313bf8ce2.png\",\"9e8c1e0efa4a04250fe78e178a5cd7bf6d2b88b6.png\",\"c2f8fffc02abc49968ef996fed5e4b3eabd9e3dd.png\",null,null,\"4832473e5c9504f5ff332d4712216a5934c810d7.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"a8b0b693bc3adc0e89f3c37278798a530098419b.png\",null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"9dac2c5116bcdf15959c9168ee14d739d4277791.png\",\"af070deda8bc5623e071c98ad4e1952137818abe.png\",\"0e872227e830fcb49dcb940c61d1b6253ed99663.png\",null,null,\"6ea5711663b43fef9bbabf7b7387400ce8a350cb.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"7599dfe7d806d2b2d9690e238ca4934b7a01e56c.png\",null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"675135430408018894","clanid":"46074831","posterid":"0","headline":"[Winner's Announcement] Daeva Makeover","posttime":1793664044,"updatetime":1793665447,"body":"[p]Hello Daevas,\u00a0[\/p][p][\/p][p]We\u2019re excited to announce the winners of our first community event, Daeva Makeover.[\/p][p]We were so happy to see the enthusiasm around this event which ended with over 1,400 submissions![\/p][p][\/p][p][b]Daeva Makeover[\/b], a contest with a simple rule: Show us your best character creation and we will select a winner from a set of categories.[\/p][p]\nWe knew selecting just one winner for each category would be difficult, so we made sure to include a reward for participating to thank you for your passion for character creation.[\/p][p][\/p][p]Now, (drum roll please) look below to check out some of the coolest characters from across Atreia![\/p][p][\/p][h2][u][b]Rewards[\/b][\/u][\/h2][table equalcells=\"1\" colwidth=\"170,\"][tr][th colwidth=\"170\"][p]Categories\u00a0[\/p][\/th][th][p]Rewards\u00a0[\/p][\/th][\/tr][tr][td colwidth=\"170\"][p]Ugly\u00a0[\/p][\/td][td][p]6,000 Quna\u00a0[\/p][\/td][\/tr][tr][td colwidth=\"170\"][p]Cute\u00a0[\/p][\/td][td][p]6,000 Quna\u00a0[\/p][\/td][\/tr][tr][td colwidth=\"170\"][p]Attractive\u00a0[\/p][\/td][td][p]6,000 Quna\u00a0[\/p][\/td][\/tr][tr][td colwidth=\"170\"][p]Unique\u00a0[\/p][\/td][td][p]6,000 Quna\u00a0\u00a0[\/p][\/td][\/tr][tr][td colwidth=\"170\"][p]Participation\u00a0[\/p][\/td][td][p]Customization Voucher (Bound) x2[\/p][\/td][\/tr][\/table][h2]\n[u][b]Winners[\/b][\/u][\/h2][table equalcells=\"1\" colwidth=\"103,193,\"][tr][th colwidth=\"103\"][p]\u200bCategory[\/p][\/th][th colwidth=\"193\"][p]Winner\u200b[\/p][\/th][th][p]Submission[\/p][\/th][\/tr][tr][td colwidth=\"103\"][p][b]\u200bUgly[\/b][\/p][\/td][td colwidth=\"193\"][p]\u200bRegion: NA East[\/p][p]Server: Fregion[\/p][p]Character Name: Stretch[\/p][\/td][td][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46074831\/9423a25709ce140727e64b90f8605e9dc4f2b404.png\"][\/img][\/p][\/td][\/tr][tr][td colwidth=\"103\"][p][b]Cute\u200b[\/b][\/p][\/td][td colwidth=\"193\"][p]\u200bRegion: NA West[\/p][p]Server: Lumiel[\/p][p]Character Name: BingBong[\/p][\/td][td][p][img src=\"{STEAM_CLAN_IMAGE}\/46074831\/99cfad0c199f59fa7b2f2ab33184ce88c99f5308.png\"][\/img][\/p][\/td][\/tr][tr][td colwidth=\"103\"][p][b]Attractive\u200b[\/b][\/p][\/td][td colwidth=\"193\"][p]\u200bRegion: NA East[\/p][p]Server: Zikel[\/p][p]Character Name: Koi\u30c3[\/p][\/td][td][p][img src=\"{STEAM_CLAN_IMAGE}\/46074831\/905819be4fde37e75055a09065b07126d4f1b9c3.png\"][\/img][\/p][\/td][\/tr][tr][td colwidth=\"103\"][p][b]Unique\u200b[\/b][\/p][\/td][td colwidth=\"193\"][p]\u200bRegion: EU[\/p][p]Server: Israphel[\/p][p]Character Name: Agamennone[\/p][\/td][td][p][img src=\"{STEAM_CLAN_IMAGE}\/46074831\/f1506d55f036b6be92603d6c018f7d2e795b1ef7.png\"][\/img][\/p][\/td][\/tr][\/table][p][\/p][p][b]Important Notes:[\/b]\u00a0[\/p][list][*][p]Participation was limited to the following regions: Europe, NA East, NA West, and South America.[\/p][\/*][*][p]The rewards will be sent via in-game mail no later than November 6, 2026 at 23:59 PDT.[\/p][\/*][*][p]NC has the right to update event details, revoke rewards, or cancel the event at any time.\u00a0[\/p][\/*][\/list]","commentcount":24,"tags":["mod_reviewed","ModAct_1751656904_1793666760_0"],"language":0,"hidden":0,"forum_topic_id":"574931289648681362","event_gid":"675135430408018893","voteupcount":73,"votedownc
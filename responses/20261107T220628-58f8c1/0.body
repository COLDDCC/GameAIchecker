	<div  data-featuretarget="apppage-store-browse-cache" data-props="{&quot;rgPayloads&quot;:[{&quot;dataRequestStoreItems&quot;:{&quot;include_assets&quot;:null,&quot;include_release&quot;:null,&quot;include_platforms&quot;:null,&quot;include_all_purchase_options&quot;:null,&quot;include_screenshots&quot;:null,&quot;include_trailers&quot;:null,&quot;include_ratings&quot;:true,&quot;include_tag_count&quot;:null,&quot;include_reviews&quot;:null,&quot;include_basic_info&quot;:null,&quot;include_supported_languages&quot;:null,&quot;include_full_description&quot;:null,&quot;include_included_items&quot;:null,&quot;included_item_data_request&quot;:null,&quot;include_assets_without_overrides&quot;:null,&quot;apply_user_filters&quot;:null,&quot;include_links&quot;:null,&quot;include_extra_details&quot;:null,&quot;include_best_purchase_option&quot;:true,&quot;include_optin_registration_tags&quot;:null},&quot;rgStoreItems&quot;:[{&quot;item_type&quot;:0,&quot;id&quot;:4917440,&quot;gid&quot;:null,&quot;success&quot;:1,&quot;visible&quot;:1,&quot;unvailable_for_country_restriction&quot;:null,&quot;name&quot;:&quot;MOGGED: Looksmaxx or Die&quot;,&quot;store_url_path&quot;:&quot;app/4917440/MOGGED_Looksmaxx_or_Die&quot;,&quot;store_url_slug&quot;:&quot;MOGGED_Looksmaxx_or_Die&quot;,&quot;appid&quot;:4917440,&quot;type&quot;:0,&quot;included_types&quot;:[],&quot;included_appids&quot;:[],&quot;is_free&quot;:null,&quot;is_early_access&quot;:1,&quot;related_items&quot;:null,&quot;included_items&quot;:null,&quot;content_descriptorids&quot;:[2,5],&quot;tagids&quot;:[],&quot;categories&quot;:{&quot;supported_player_categoryids&quot;:[1,9,38],&quot;feature_categoryids&quot;:[62],&quot;controller_categoryids&quot;:[]},&quot;reviews&quot;:null,&quot;basic_info&quot;:null,&quot;tags&quot;:[],&quot;assets&quot;:null,&quot;release&quot;:null,&quot;platforms&quot;:null,&quot;game_rating&quot;:{&quot;type&quot;:null,&quot;rating&quot;:null,&quot;descriptors&quot;:[],&quot;interactive_elements&quot;:null,&quot;agency&quot;:null,&quot;banned&quot;:null,&quot;esrb_online_music_not_rated&quot;:null,&quot;esrb_online_interactions_not_rated&quot;:null,&quot;survey_interactive_elements&quot;:[],&quot;required_age&quot;:null,&quot;use_age_gate&quot;:null,&quot;descriptor_images&quot;:[],&quot;content_survey_notes&quot;:&quot;MOGGED is a horror comedy about looksmaxxing culture. It contains:\r\n\r\nViolence and gore. Players and NPCs are killed with fists, a hammer and a shotgun. There is blood, corpses and ragdolls. One machine in the game grinds bodies into meat.\r\n\r\nDrugs and alcohol. The game is built around performance enhancing drugs. Players inject peptides and steroids, some named after real substances, and can manufacture and sell them. Beer and cigarettes can be consumed. Characters speak favourably about drug use. The tone is satirical and the drugs carry side effects, but the subject is central to the game.\r\n\r\nSelf-harm. The game references bonesmashing, a real practice where people strike their own face to change its bone structure. It is not something to try. In the game, using the hammer for bonesmashing provides an insignificant, nearly immeasurable improvement at the cost of significantly injuring your player.\r\n\r\nHorror. Sudden scares, stalking enemies and dark environments.\r\n\r\nLanguage and humor. Swearing and crude jokes about bodies, death, mental health and drug use.\r\n\r\nOnline. The game has open voice chat. Valve does not rate what other players say.&quot;,&quot;agency_rating&quot;:null,&quot;image_url&quot;:null,&quot;image_target&quot;:null},&quot;is_coming_soon&quot;:null,&quot;best_purchase_option&quot;:{&quot;packageid&quot;:1707026,&quot;bundleid&quot;:null,&quot;purchase_option_name&quot;:&quot;MOGGED: Looksmaxx or Die&quot;,&quot;final_price_in_cents&quot;:&quot;699&quot;,&quot;original_price_in_cents&quot;:null,&quot;formatted_final_price&quot;:&quot;$6.99&quot;,&quot;formatted_original_price&quot;:null,&quot;discount_pct&quot;:null,&quot;bundle_discount_pct&quot;:null,&quot;is_free_to_keep&quot;:null,&quot;price_before_bundle_discount&quot;:null,&quot;formatted_price_before_bundle_discount&quot;:null,&quot;active_discounts&quot;:[],&quot;user_can_purchase_as_gift&quot;:1,&quot;is_commercial_license&quot;:null,&quot;should_suppress_discount_pct&quot;:null,&quot;hide_discount_pct_for_compliance&quot;:0,&quot;included_game_count&quot;:1,&quot;lowest_recent_price_in_cents&quot;:null,&quot;requires_shipping&quot;:null,&quot;recurrence_info&quot;:null,&quot;free_to_keep_ends&quot;:null,&quot;must_purchase_as_set&quot;:0,&quot;package_group&quot;:&quot;default&quot;,&quot;is_edition&quot;:null,&quot;free_to_keep_base_package&quot;:null,&quot;price_cannot_be_displayed_as_discount&quot;:0,&quot;price_to_base_discount_on&quot;:null,&quot;free_with_master_sub_appid&quot;:null,&quot;formatted_lowest_recent_price&quot;:null,&quot;is_free_license&quot;:null,&quot;combined_discount_pct&quot;:null},&quot;purchase_options&quot;:[],&quot;self_purchase_option&quot;:null,&quot;screenshots&quot;:null,&quot;trailers&quot;:null,&quot;supported_languages&quot;:[],&quot;store_url_path_override&quot;:null,&quot;free_weekend&quot;:null,&quot;unlisted&quot;:null,&quot;game_count&quot;:null,&quot;internal_name&quot;:null,&quot;full_description_bbcode&quot;:null,&quot;is_free_temporarily&quot;:null,&quot;assets_without_overrides&quot;:null,&quot;user_filter_failure&quot;:null,&quot;links&quot;:[],&quot;purchase_description_bbcode&quot;:null,&quot;package_groups&quot;:[],&quot;extra_details&quot;:null,&quot;optin_registration_tags&quot;:[],&quot;purchase_notes&quot;:[]}]}]}"></div><div  data-featuretarget="apppage-gameinterest-cache" data-props="{&quot;appid&quot;:4917440,&quot;userInterest&quot;:{&quot;owned&quot;:null,&quot;wishlist&quot;:null,&quot;ignored&quot;:null,&quot;following&quot;:null,&quot;in_queues&quot;:[],&quot;queues_with_skip&quot;:[],&quot;queue_items_remaining&quot;:[],&quot;queue_items_n
							var StoreDefaults = {"PartnerEventStore":[{"gid":"694276363007297388","clan_steamid":"103582791475652040","event_name":"34% Off at Launch! Expedition of the Guild Is Out Now!","event_type":10,"appid":4261080,"server_address":null,"server_password":null,"rtime32_start_time":1793344260,"rtime32_end_time":1793349001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b309426132f78c77a5dab1439a6b06b9f58f8814.png\",null,null,null,\"84dcde180c2fdf85fe69375bfd2c33239e80af15.png\",null,\"9ac0d92968cee8d1d6812cd610d82cdd52f9ad33.png\",\"cff4efbf9c0c21ac5ce89806b2670f1f6f6ee6c7.png\",null,null,\"f79616dde9d2b1a4900aafca322f1c57cbb56b7b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694276363007297389","clanid":"46130632","posterid":"0","headline":"34% Off at Launch! Expedition of the Guild Is Out Now!","posttime":1793344317,"updatetime":1793344317,"body":"[p]Hello everyone! I'm Chubby Meow, the developer of Expedition of the Guild, and the game is officially out now![\/p][p][\/p][p]Set out on a journey to rediscover the magic of the golden age of MMOs. Collect 83 heroes across classes such as Paladins, Mages, Hunters, and Priests, then build a raid team of up to 20. Your tanks hold the front line, your DPS take turns unleashing their burst damage, and your healers keep everyone's health topped up. You manually activate each key ability, putting you right in the thick of commanding the raid.[\/p][p][\/p][p]Start with a small band of just a few heroes. Unlock talent trees, farm best-in-slot gear, and fight your way to fame across the continent. Before each raid, you decide the lineup. After each boss kill, you decide who gets the loot. No loot rolls needed: give each item to whoever you want. Loot fallen enemies, crack open treasure chests, and kit out every member with best-in-slot gear. All 20 heroes answer to you.[\/p][p][\/p][p]Gear, talents, and your hero roster: everything you build up translates into real strength for your team. What comes next? Compete for a place on the Black Market Arena leaderboards? Climb ever higher in the Infinite Magic Tower? Or recruit all 9 of the most powerful heroes, push your builds to the limit, and take on the toughest raid? How far you go comes down to your team composition\u2014and a little luck![\/p][p][\/p][p][img src=\"https:\/\/co8bxcnzo3.feishu.cn\/space\/api\/box\/stream\/download\/asynccode\/?code=MzYyZTU2YzZmMWQ3NGM2YzZmNmJiYTQ4MzllMzYzNjdfV05oRjZvQUcyVkFZVERsdk5WeGlwUlFrWUE3SWRvY2dfVG9rZW46RWhLWWJsRU5Vb1F5NG94R0RYWWNaeTQ5bmRnXzE3OTMzNDI0Nzg6MTc5MzM0NjA3OF9WNA&add_watermark=true&scene_type=CCM\"][\/img][\/p][p]Thank you for following the game, adding it to your wishlists, and supporting it along the way.[\/p][p]Raid leaders, it's time to pull![\/p]","commentcount":6,"tags":["mod_reviewed","ModAct_1434278705_1793344999_0"],"language":0,"hidden":0,"forum_topic_id":"565923773630641543","event_gid":"694276363007297388","voteupcount":18,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923773630641543","rtime32_last_modified":1793708660,"news_post_gid":"0","rtime_mod_reviewed":1793345000,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793342598,"votes_up":18,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"842880570655530347","gidfeature2":"565923773630641543"},{"gid":"687519694976975333","clan_steamid":"103582791475652040","event_name":"Expedition of the Guild Launches October 29","event_type":16,"appid":4261080,"server_address":null,"server_password":null,"rtime32_start_time":1792055100,"rtime32_end_time":1792060201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b309426132f78c77a5dab1439a6b06b9f58f8814.png\",null,null,null,\"84dcde180c2fdf85fe69375bfd2c33239e80af15.png\",null,\"29da2950d0fa0c7dbed91db1beb04c48e8be7142.png\",null,null,null,\"f79616dde9d2b1a4900aafca322f1c57cbb56b7b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"687519694976975334","clanid":"46130632","posterid":"0","headline":"Expedition of the Guild Launches October 29","posttime":1792055157,"updatetime":1792741505,"body":"[p]Hello everyone, I'm Chubby Meow, the developer of [i]Expedition of the Guild[\/i].[\/p][p][\/p][p]I'm thrilled to announce that [i]Expedition of the Guild[\/i] officially launches on October 29 at 12:00 PM (Pacific Time)![\/p][p][\/p][p]Over this past stretch, we've been steadily updating the game and reworking parts of the experience:[\/p][p][\/p][p][b]Feature Improvements[\/b][\/p][list][*][p]Added new dungeons: Hidden Forest and Hidden Swamp. (The demo now has 5 dungeons, roughly 5\u20136 hours to clear.)[\/p][\/*][*][p]Hero level cap raised to 8.[\/p][\/*][*][p]Team Talent System unlocked. In the demo, talent points cap at 22. (In the full release: 56 points in the Outer World, 100 points in the Magic Tower world.)[\/p][\/*][*][p]Heroes available in the demo: 6 Epic, 18 Legendary, and 19 Elite \u2014 43 in total. (The full release has 83.)[\/p][\/*][*][p]Updated character art, adding a grittier illustration style. (Now the default style.)[\/p][\/*][*][p]Added new NPCs and building entrances to the maps: the Black Market Arena and the Infinite Magic Tower. (Visible and interactable, but not yet enterable.)[\/p][\/*][\/list][p][\/p][p][b]Major Control and Handling Improvements[\/b][\/p][list][*][p]Holding down the left mouse button for forced movement now behaves differently in and out of combat. In combat, the whole team shifts together \u2014 much easier to dodge abilities. Out of combat, they follow behind the leader.[\/p][\/*][*][p]Frontline tanks hold aggro more reliably. Enemy targeting priority is now: Tank \u2192 Melee \u2192 Ranged.[\/p][\/*][\/list][p][\/p][p][b]Other Improvements[\/b][\/p][list][*][p]UI: added a real-time team info panel, draggable floating windows on the main screen, and cursor-avoidance for various UI elements.[\/p][\/*][*][p]Various other refinements and bug fixes.[\/p][\/*][\/list][p][\/p][p]Some of this new content will be pushed to the playable demo as well. Whether you've been following the game for a long time or are just now hearing about [i]Expedition of the Guild[\/i], you're welcome to get your party together and dive in right now![\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4261080\/\"][\/dynamiclink][\/p][p]I hope you can rediscover the joy of those late nights spent grinding dungeons and farming gear back in the day.[\/p][p][\/p][p]Thank you all so much for your support of [i]Expedition of the Guild[\/i]![\/p]","commentcount":2,"tags":["mod_reviewed","ModAct_1434278705_1792056645_0","ModAct_1526778620_1792741826_4"],"language":0,"hidden":0,"forum_topic_id":"706660083369560144","event_gid":"687519694976975333","voteupcount":18,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369560144","rtime32_last_modified":1793521871,"news_post_gid":"0","rtime_mod_reviewed":1792741827,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792052514,"votes_up":18,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"842880570655530347","gidfeature2":"706660083369560144"},{"gid":"694277107352600577","clan_steamid":"103582791475652040","event_name":"Post-Launch Updates V 1.08.6 - V 1.08.9","event_type":12,"appid":4261080,"server_address":null,"server_password":null,"rtime32_start_time":1793849940,"rtime32_end_time":1793854801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b309426132f78c77a5dab1439a6b06b9f58f8814.png\",null,null,null,\"84dcde180c2fdf85fe69375bfd2c33239e80af15.png\",null,\"9ac0d92968cee8d1d6812cd610d82cdd52f9ad33.png\",\"cff4efbf9c0c21ac5ce89806b2670f1f6f6ee6c7.png\",null,null,\"f79616dde9d2b1a4900aafca322f1c57cbb56b7b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"694277107352600578","clanid":"46130632","posterid":"0","headline":"Post-Launch Updates V 1.08.6 - V 1.08.9","posttime":1793849986,"updatetime":1793849986,"body":"[p][b]November 3, 2026 | V 1.08.8\u2013V 1.08.9[\/b][\/p][p]Update Notes:[\/p][olist][*][p]You can now equip two copies of the same weapon skill simultaneously.[\/p][\/*][*][p]Reworked mana and health potion mechanics. Mana potion usage has been removed, but existing mana potions will be retained and converted into currency for future content.[\/p][\/*][*][p]Added an auto-idle feature.[\/p][\/*][*][p]Added three selectable difficulty levels.[\/p][\/*][*][p]Added a boss training dummy for testing damage output.[\/p][\/*][*][p]Added the ability to drag equipment from the inventory into the corresponding slots, along with inventory filters.[\/p][\/*][*][p]Fixed an issue where stack icons above bosses obscured ability indicators and focus-fire markers.[\/p][\/*][*][p]Increased the interval between boss ability casts and made warning indicators more noticeable.[\/p][\/*][*][p]Improved ranged attack logic and positioning.[\/p][\/*][*][p]Added an option to disable automatic prayer, preventing statues from being generated automatically.[\/p][\/*][*][p]Added an option to disable automatic health potion use.[\/p][\/*][*][p]Added health potions to the environments.[\/p][\/*][*][p]Training dummy testing: health locking and enemy clearing.[\/p][\/*][*][p]Various other quality-of-life improvements and bug fixes.[\/p][\/*][\/olist][p][\/p][p][b]October 31, 2026 | V 1.08.7[\/b][\/p][p]Update Notes:[\/p][olist][*][p]Added automatic conversion of statues into Prayer Points.[\/p][\/*][*][p]Fixed an issue where Priests would not use resurrection abilities outside combat.[\/p][\/*][*][p]Fixed an issue where equipping identical talent skills could cause them to disappear unexpectedly.[\/p][\/*][*][p]Added one-click equipment optimization, automatically equipping recommended gear for the entire team.[\/p][\/*][*][p]Fixed an issue where equipment above level 15 could drop incorrectly.[\/p][\/*][*][p]Added a Magic Tower floor reset feature, allowing floor progress to be reset without any loss.[\/p][\/*][*][p]Fixed mismatches between quest objectives and location or portal names.[\/p][\/*][*][p]Fixed an issue with claiming dungeon completion chests.[\/p][\/*][\/olist][p][\/p][p][b]October 31, 2026 | V 1.08.6[\/b][\/p][p]Update Notes:[\/p][olist][*][p]Fixed issues in the \u201cDefend the Royal City\u201d dungeon.[\/p][\/*][*][p]Improved Inn controls, adding drag-and-drop repositioning and the ability to remove heroes from the team.[\/p][\/*][*][p]Added skill tooltips to the quickbar, displaying skill names and basic information.[\/p][\/*][*][p]Added a clear pause indicator when configuring the skill quickbar.[\/p][\/*][*][p]Improved loot collection.[\/p][\/*][*][p]Removed branching paths from the \u201cUnderground Ruins\u201d dungeon, creating a direct route to the end.[\/p][\/*][*][p]Revised save and load controls: saving is available in-game, while loading is now accessed from the main menu.[\/p][\/*][*][p]Skill cooldowns now reset automatically upon leaving a dungeon.[\/p][\/*][*][p]Fixed inconsistencies between quest names and location names.[\/p][\/*][*][p]Increased the visual size of final dungeon bosses and made the route to completion clearer.[\/p][\/*][*][p]Revised several ambiguous descriptions.[\/p][\/*][\/olist]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1426387032_1793852860_0"],"language":0,"hidden":0,"forum_topic_id":"565924517973591380","event_gid":"694277107352600577","voteupcount":12,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565924517973591380","rtime32_last_modified":1794049784,"news_post_gid":"0","rtime_mod_reviewed":1793852860,"featured_app_tagid":0,"referenced_appids":[],"build_id":26404661,"build_branch":"","unlisted":0,"rtime_created":1793848909,"votes_up":12,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"842880570655530347","gidfeature2":"565924517973591380"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["694276363007297389","687519694976975334"],"last_update_event":{"rtime":1793849940,"event_gid":"694277107352600577","announcement_gid":"694277107352600578","clan_account_id":46130632}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>Join the Community!</h2>				<p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/32bd6eeed74a2d885eff2b1ef54d16fe.avif?t=1793618696" width=800 height=120 /></span></p></p>
			</div>
			</div>				<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/bf8f79a5b6e697f9c9bf84bcbc1b9d3a.avif?t=1793618696" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras_big/bf8f79a5b6e697f9c9bf84bcbc1b9d3a.avif?t=1793618696 width=1560 height=878 /></span></p><h2 class="bb_tag" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/cb4425253b70a5de5596a6f095551b49.avif?t=1793618696" width=800 height=154 /></span></h2><p class="bb_paragraph" >Create your own guild and recruit heroes during your journey: Paladins, Mages, Hunters, Priests, and more. Tanks, DPS, and Healers all play important roles in raids. Unlock talent trees, collect powerful gear, and grow your team from a small party into a legendary guild renowned throughout the land!</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/f73677a5be182674ac1dc90dd82251cc.poster.avif?t=1793618696" width=1170 height=658 ><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/f73677a5be182674ac1dc90dd82251cc.webm?t=1793618696" type="video/webm; codecs=vp9"><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/f73677a5be182674ac1dc90dd82251cc.mp4?t=1793618696" type="video/mp4"></video></span></p><h2 class="bb_tag" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/974290fa324d6e1a19958662ce48ef48.avif?t=1793618696" width=800 height=154 /></span></h2><p class="bb_paragraph" >Choose durable Tanks, powerful DPS builds, and skilled healers to keep your party alive. Build your party your way: Choose safe and balanced raid setups, rush levels with high-damage teams, or experiment with fun combinations to push your limits. Pick your lineup before every raid and overcome challenges through teamwork and strategy.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/3fd690c7716960a766beecdf158c5aed.poster.avif?t=1793618696" width=1170 height=658 ><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/3fd690c7716960a766beecdf158c5aed.webm?t=1793618696" type="video/webm; codecs=vp9"><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/3fd690c7716960a766beecdf158c5aed.mp4?t=1793618696" type="video/mp4"></video></span></p><h2 class="bb_tag" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/6e962d465e615d5359704a10e717f448.avif?t=1793618696" width=800 height=154 /></span></h2><p class="bb_paragraph" >Fight towering giants and ancient gods hidden within ruins. Every BOSS features unique mechanics and intense battles. Defeat them to loot chests and powerful class-based gear. No random loot rolls — you decide how every reward is distributed. Build the perfect endgame setup for your heroes and enjoy the thrill of classic MMORPG raids once again!</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/496baf1ce4f8aca3b5d325c25956385f.poster.avif?t=1793618696" width=1170 height=658 ><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/496baf1ce4f8aca3b5d325c25956385f.webm?t=1793618696" type="video/webm; codecs=vp9"><source src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4261080/extras/496baf1ce4f8aca3b5d325c25956385f.mp4?t=1793618696" type="video/mp4"></video></span></p>						</div>
					</div>

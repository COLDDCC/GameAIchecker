re_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"715667192644897017","clanid":"46530998","posterid":"0","headline":"SplaChess is available now on Steam!","posttime":1792504608,"updatetime":1792504608,"body":"SplaChess is now available on Steam!\nThank you to everyone who wishlisted the game and waited for launch.\n\n[h2]Target the king. Paint the board.[\/h2]\nEvery move paints the moved piece's destination and the empty squares it attacks. Familiar chess pieces become tools for controlling the board as well as protecting your king.\n\nCheckmate wins immediately. If all 64 squares are painted first, the player with more squares in their color wins. Equal territory and stalemate are draws. Protect your king or cover more ground: each move can take you toward a different kind of victory.\n\n[h2]Play solo or challenge another player[\/h2]\nFace 20 CPU characters with different strengths and playing styles, share a PC for local matches, or compete online through Steam. SplaChess supports eight languages, including English and Japanese.\n\n[h2]Available for Windows PC[\/h2]\nPrice: US$2.99 \/ JPY 400. There is no launch discount on the individual game.\n\n[url=https:\/\/store.steampowered.com\/app\/5352620\/]Visit the SplaChess store page[\/url]\n\n[h2]Three-game bundle at 30% off[\/h2]\nA Steam bundle containing SHOGITOON, SplaChess, and MOVETOON offers 30% off the three games together. See the store page for bundle details. Please note that SHOGITOON supports Japanese only.\n\nShare your thoughts or report an issue on the [url=https:\/\/steamcommunity.com\/app\/5352620\/discussions\/]Steam discussion board[\/url].\nSee you on the board!\n\nmayoaji\n","commentcount":0,"tags":["mod_reviewed","ModAct_1691520782_1792505975_0"],"language":0,"hidden":0,"forum_topic_id":"574930130477193073","event_gid":"715667192644897016","voteupcount":0,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930130477193073","rtime32_last_modified":1792505976,"news_post_gid":"0","r
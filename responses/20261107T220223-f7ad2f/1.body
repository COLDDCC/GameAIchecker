																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"687520963569385475","clan_steamid":"103582791475816553","event_name":"Addressing Feedback about Prologue Performance","event_type":28,"appid":5088140,"server_address":null,"server_password":null,"rtime32_start_time":1793153340,"rtime32_end_time":1793156820,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Operators! Thank you to everyone who played Phantom Line: Prologue and took the time to share your feedback.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"3fd19d671ca6341636f22d614063840e40a5d6b4.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"687520963569385476","clanid":"46295145","posterid":"0","headline":"Addressing Feedback about Prologue Performance","posttime":1793153399,"updatetime":1793153399,"body":"[p]Operators,[\/p][p][\/p][p]Thank you to everyone who played Phantom Line: Prologue and took the time to share your feedback.[\/p][p][\/p][p]We fully acknowledge that the Prologue ran poorly and failed to meet performance expectations. It reached a wider range of hardware in a day than any of our playtests before it, and that made it painfully clear how much optimization and polish the game still needs.\u00a0[\/p][p][\/p][p]Since our last playtest, we have continued rebuilding core systems for the stable foundation we need to develop the game. This includes the 3 Cs (Character, Camera, Controls) and the procedurally generated Anomaly Pockets essential for the core experience of the full game. We have also spent a lot of time improving crashes, which were players\u2019 biggest pain point in the last playtest. Because of these priorities, we were not able to dedicate as much time to optimization as we should have. Not spending enough time on it is our biggest regret of the Prologue, and as we look forward to the continued development of Phantom Line, performance has become one of our top priorities.[\/p][p][\/p][p]The Prologue needs more than a band-aid. Our work from here on will go into optimizing and polishing the full game rather than patching The Prologue. We hear you loud and clear! Your feedback is actively guiding this work, and we are fully committed to delivering a much smoother experience in the future.[\/p][p][\/p][p]We are currently evaluating all the feedback and technical data we've gathered from the Prologue. These reports will be analyzed to fully understand your pain points and identify the best ways to optimize and polish the final game. As we are still in the evaluation process, we don't have specific details or timelines to share just yet, but our community channels are always open.[\/p][p]\nWe welcome your continued feedback and invite you to join our communities to stay updated on our development progress and the latest news:[\/p][p][\/p][p][url=\"https:\/\/linktr.ee\/antistaticstudios\"]https:\/\/linktr.ee\/antistaticstudios[\/url][\/p][p][\/p][p]Thank you again to everyone who played and shared their thoughts. We know we have a lot of work ahead of us, and we\u2019re grateful to everyone who has given us their time and honesty.\n[\/p][p]Kris Teper, Game Director[\/p][p]and the Phantom Line team[\/p][p]\n[\/p]","commentcount":7,"tags":["mod_reviewed","ModAct_1751555285_1793155914_0"],"language":0,"hidden":0,"forum_topic_id":"572679173079840814","event_gid":"687520963569385475","voteupcount":60,"votedowncount":3,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572679173079840814","rtime32_last_modified":1794049522,"news_post_gid":"0","rtime_mod_reviewed":1793155914,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793142897,"votes_up":60,"votes_down":3,"comment_type":"ForumTopic","gidfeature":"591816835949712830","gidfeature2":"572679173079840814"},{"gid":"698779328450664786","clan_steamid":"103582791475816553","event_name":"JOIN THE FULL HUNT - Wishlist Phantom Line","event_type":28,"appid":5088140,"server_address":null,"server_password":null,"rtime32_start_time":1793016000,"rtime32_end_time":1793019600,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Your first assignment is only the beginning. Join the full hunt.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The free Prologue is just your first assignment. Wishlist the full game, share your field reports and prepare for Early Access in 2027.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"152fcfb99466e884680e1e28720e4335136fd9d9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"698779328450664787","clanid":"46295145","posterid":"0","headline":"JOIN THE FULL HUNT - Wishlist Phantom Line","posttime":1793016028,"updatetime":1793142531,"body":"[p][b]Phantom Line: Prologue is OUT NOW![\/b] [url=\"https:\/\/store.steampowered.com\/app\/5088140\/Phantom_Line_Prologue\/\"]Try it for free[\/url], and remember, Operator: this is only the beginning.[\/p][p]Your first assignment with Mortfield Industries has officially begun, but there's a much bigger world waiting beyond the introductory island. Consider this your first briefing: a taste of the tension, horror and tactical challenges of our disturbed world.[\/p][p]The Prologue isn't the final shape of the game. Phantom Line is still in development, and we're working hard to improve and expand the experience. Your feedback and support mean the world to us, and every field report helps us shape what's coming next.[\/p][h3][b]FURTHER ASSIGNMENTS AWAIT[\/b][\/h3][p]\u25b8 [b][url=\"https:\/\/store.steampowered.com\/app\/2400840\/Phantom_Line\/\"]Wishlist Phantom Line on Steam[\/url][\/b] and prepare to join the full hunt.[\/p][p]The full game is planned to enter Early Access in 2027.[\/p][p][\/p][p][i]\u2014 The Antistatic Studios Team[\/i][\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_773020726_1793018122_0","ModAct_1889321037_1793031829_4","ModAct_1890460210_1793145797_4"],"language":0,"hidden":0,"forum_topic_id":"562545740485979732","event_gid":"698779328450664786","voteupcount":25,"votedowncount":5,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793016000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"562545740485979732","rtime32_last_modified":1793828244,"news_post_gid":"0","rtime_mod_reviewed":1793145797,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793016018,"votes_up":25,"votes_down":5,"comment_type":"ForumTopic","gidfeature":"591816835949712830","gidfeature2":"562545740485979732"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["687520963569385476","698779328450664787"],"last_update_event":[]}};

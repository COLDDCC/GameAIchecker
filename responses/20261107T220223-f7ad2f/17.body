,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"667254765243075828","clanid":"46489386","posterid":"0","headline":"Five New Languages & Guidance That Keeps Going","posttime":1793714325,"updatetime":1793714325,"body":"[b]Guild Master 0.15.1 is live![\/b]\n\nThe gold guide now keeps helping as your guild grows.\n\n[list]\n[*][b]Guidance that keeps going:[\/b] Full walkthrough is now the default, with one-click help continuing beyond the first eight orders. If you previously chose a lighter guide mode, you can switch back to Full walkthrough in Settings.\n[*][b]Five new languages:[\/b] German, French, Spanish (Spain), Korean and Japanese join English and Simplified Chinese.\n[*][b]Automatic language selection:[\/b] The game follows your Steam language. The new flag-and-language menu opens upward for quick manual changes.\n[*][b]Better text fit:[\/b] Improved layouts for longer translations, larger text and resolution changes, including German, Korean and Japanese.\n[*][b]Clearer early steps:[\/b] Improved bank, equipment and supplies guidance. Opening a recipe from Skills now clears an old crafting search so the recipe is visible.\n[\/list]\n\nThanks for the feedback. If something still gets in your way, please share what you clicked, your language and a screenshot in the comments or discussions.","commentcount":1,"tags":["mod_reviewed","ModAct_1691520782_1793716220_0"],"language":0,"hidden":0,"forum_topic_id":"564798468972881658","event_gid":"667254765243075827","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564798468972881658","rtime32_last_modified":1793741558,"news_post_gid":"0","rtime_mod_reviewed":1793716220,"featured_app_tagid":0,"referenced_appids":[],"build_id":26406855,"build_branch":"","unlisted":0,"rtime_created":1793714232,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"564797873721682405","gidfeature2":"564798468972881658"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["667254765243075828"],"last_update_event":{"rtime":1793714280,"event_gid":"667254765243075827","announcement_gid":"667254765243075828","clan_account_id":46489386}}};

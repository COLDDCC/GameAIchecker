							var StoreDefaults = {"PartnerEventStore":[{"gid":"686395970023325719","clan_steamid":"103582791476010286","event_name":"More guild bank space for every profession","event_type":13,"appid":5338720,"server_address":null,"server_password":null,"rtime32_start_time":1794024360,"rtime32_end_time":1794029401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Materials overflow into your Items tabs, and level-20 guilds can expand Reagents storage to 1,024 slots.\",null,null,null,null,null,\"\u6750\u6599\u4ed3\u5e93\u6ee1\u4e86\u4f1a\u81ea\u52a8\u5b58\u5165\u7269\u54c1\u5206\u9875\uff0c20\u7ea7\u516c\u4f1a\u8fd8\u80fd\u628a\u6750\u6599\u4ed3\u5e93\u6269\u5145\u52301024\u683c\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"When Reagents storage is full, new materials go to your guild bank's Items tabs, and level-20 guilds can expand Reagents five more times, up to 1,024 slots.\",null,null,null,null,null,\"\u6750\u6599\u4ed3\u5e93\u6ee1\u4e86\u4ee5\u540e\uff0c\u65b0\u6750\u6599\u4f1a\u5b58\u5165\u516c\u4f1a\u94f6\u884c\u7684\u7269\u54c1\u5206\u9875\uff1b20\u7ea7\u516c\u4f1a\u8fd8\u53ef\u4ee5\u518d\u6269\u5145\u6750\u6599\u4ed3\u5e93\u4e94\u6b21\uff0c\u6700\u591a1024\u683c\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"430866edc2cd40ca17157630fbe9c835f027306b.jpg\",null,null,null,null,null,\"cdb1badb02d8395a030d612cbb6efef05ef32be4.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"cdf1959b803c561b23daad9838acb3a3f60d3d8a.jpg\",null,null,null,null,null,\"7a4105b44b295b9a1a4fdd4208fc64bd2e788ebe.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"686395970023325712\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"686395970023325720","clanid":"46488878","posterid":"0","headline":"More guild bank space for every profession","posttime":1794024370,"updatetime":1794024370,"body":"[b]Guild bank[\/b]\n[list]\n[*]When the Reagents storage is full, new materials now go to your Items tabs instead of being refused or mailed. Crafting uses materials from both, and crafting queues no longer pause.\n[*]Level-20 guilds can expand Reagents five more times: 512, 640, 768, 896 and finally 1,024 slots (2g to 12g each). The game has 586 different materials, so a guild working every profession now has room for all of them.\n[*]Every Reagents expansion now asks for confirmation and shows the price first.\n[*]The Reagents tab says when it is full and where new materials go, and its name is now translated in every language.\n[\/list]\n\nCo-op needs both players on this update.\n\nThanks to \u5e55\u767d for the report. Always open to feedback!","commentcount":1,"tags":["mod_reviewed","ModAct_1896160435_1794026106_0"],"language":0,"hidden":0,"forum_topic_id":"573805817326942534","event_gid":"686395970023325719","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805817326942534","rtime32_last_modified":1794050398,"news_post_gid":"0","rtime_mod_reviewed":1794026106,"featured_app_tagid":0,"referenced_appids":[],"build_id":26500611,"build_branch":"","unlisted":0,"rtime_created":1794023767,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"573805072991012559","gidfeature2":"573805817326942534"},{"gid":"686395970023325712","clan_steamid":"103582791476010286","event_name":"Every dungeon on the map, quests that lead to the door","event_type":13,"appid":5338720,"server_address":null,"server_password":null,"rtime32_start_time":1794014160,"rtime32_end_time":1794018601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Dungeon and raid entrances on every map, dungeon quests that lead to the door, and recipes that say what's missing.\",null,null,null,null,null,\"\u6240\u6709\u5730\u4e0b\u57ce\u548c\u56e2\u961f\u526f\u672c\u5165\u53e3\u5747\u5df2\u6807\u5728\u5730\u56fe\u4e0a\uff0c\u5730\u4e0b\u57ce\u4efb\u52a1\u76f4\u63a5\u6307\u5411\u5165\u53e3\uff0c\u672a\u89e3\u9501\u7684\u914d\u65b9\u4f1a\u8bf4\u660e\u7f3a\u5c11\u4ec0\u4e48\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The world map marks every dungeon and raid entrance, dungeon quests lead to the door (or your ferry first), and a locked recipe says what your crafter is missing.\",null,null,null,null,null,\"\u4e16\u754c\u5730\u56fe\u73b0\u5728\u6807\u51fa\u6240\u6709\u5730\u4e0b\u57ce\u548c\u56e2\u961f\u526f\u672c\u5165\u53e3\uff0c\u5730\u4e0b\u57ce\u4efb\u52a1\u4f1a\u6307\u5f15\u4f60\u524d\u5f80\u5165\u53e3\uff08\u5fc5\u8981\u65f6\u5148\u6307\u5411\u6e21\u8239\uff09\uff0c\u672a\u89e3\u9501\u7684\u914d\u65b9\u4e5f\u4f1a\u8bf4\u660e\u5236\u4f5c\u8005\u8fd8\u7f3a\u5c11\u4ec0\u4e48\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"430866edc2cd40ca17157630fbe9c835f027306b.jpg\",null,null,null,null,null,\"cdb1badb02d8395a030d612cbb6efef05ef32be4.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"cdf1959b803c561b23daad9838acb3a3f60d3d8a.jpg\",null,null,null,null,null,\"7a4105b44b295b9a1a4fdd4208fc64bd2e788ebe.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"686395808002605388\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"686395970023325713","clanid":"46488878","posterid":"0","headline":"Every dungeon on the map, quests that lead to the door","posttime":1794014207,"updatetime":1794014207,"body":"[b]Maps and quests[\/b]\n[list]\n[*]The world map now marks every dungeon and raid entrance on the map where it stands. The Sunken Noon and the Azure Court were missing from the frontier map.\n[*]Following a quest whose target is inside a dungeon now leads to that dungeon's entrance, including the level-20 quests for the Azure Court, the Infernal Crucible, the Last Colossus and the Kindled Vaults. Inside, the quest's own markers take over.\n[*]If a quest's destination is across the sea, its marker first points to your ferry or sky-route stop, and the quest list says so.\n[\/list]\n\n[b]Professions[\/b]\n[list]\n[*]A locked recipe now says what the chosen crafter is missing: more skill, the next profession rank, a higher hero level, or just learning it at the workshop.\n[*]Skill stops at 75 until a hero trains the Artisan rank. When that is what holds a crafter back, Train rank is offered right on the locked recipe.\n[\/list]\n\nThanks to Valkerion and \u5e55\u767d for the reports. Always open to feedback!","commentcount":1,"tags":["mod_reviewed","ModAct_1896160435_1794015641_0"],"language":0,"hidden":0,"forum_topic_id":"573805817326932519","event_gid":"686395970023325712","voteupcount":2,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805817326932519","rtime32_last_modified":1794039322,"news_post_gid":"0","rtime_mod_reviewed":1794015641,"featured_app_tagid":0,"referenced_appids":[],"build_id":26498626,"build_branch":"","unlisted":0,"rtime_created":1794013566,"votes_up":2,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"573805072991012559","gidfeature2":"573805817326932519"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["686395970023325720","686395970023325713"],"last_update_event":{"rtime":1794024360,"event_gid":"686395970023325719","announcement_gid":"686395970023325720","clan_account_id":46488878}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<p class="bb_paragraph" ><strong>Your next party member could be a hero you created.</strong></p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Guild of Souls is a fantasy RPG for <strong>1-5 players</strong>, inspired by classic MMOs. A solo game dev trying to build his dream game.</p><p class="bb_paragraph" >  </p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/c6afe06edf94d370b7e53c4b47241ab4.poster.avif?t=1793753207" width=440 height=248 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/c6afe06edf94d370b7e53c4b47241ab4.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/c6afe06edf94d370b7e53c4b47241ab4.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Build a guild of playable heroes, switch characters at any moment mid-combat with one click, bring your own characters into battle as soul companions, and turn a growing roster into a party that works together. Adventure solo or invite up to four friends to join you.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/45eecebc207d699ed6ea1c39fa59f9d0.poster.avif?t=1793753207" width=480 height=270 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/45eecebc207d699ed6ea1c39fa59f9d0.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/45eecebc207d699ed6ea1c39fa59f9d0.mp4?t=1793753207" type="video/mp4"></video></span></p><h2 class="bb_tag" >Fight beside your own heroes</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/a49f6c0084e8933e213132b568cb1143.poster.avif?t=1793753207" width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/a49f6c0084e8933e213132b568cb1143.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/a49f6c0084e8933e213132b568cb1143.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Start building your own party early in the adventure. Bind a hero at the Soul Shrine, create another, and call your previous character to fight beside you. Your companions keep their equipment, talents and personal progression, and remain playable whenever you want to take control.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Earn more follower places as your guild grows. Mix tanks, healers and damage dealers, prepare class boons and supplies, and use optional level sync to bring veterans along with a newer hero.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >40 starter classes. A guild full of possibilities. An endgame rougelike hero class: Chaosborn.</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/f52f2c6c118400158e1c81c851b34e7a.poster.avif?t=1793753207" width=616 height=346 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/f52f2c6c118400158e1c81c851b34e7a.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/f52f2c6c118400158e1c81c851b34e7a.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Choose from <strong>40 playable starter classes</strong>, each with its own abilities, resources and talent paths. Line up a Hunter shot while a Warrior charges in. Counter spells as a Spellbreaker, shape the battlefield as a Geomancer, or exchange places with your Puppeteer's creation.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/225af83759a46b7373be1b23e4be9eca.poster.avif?t=1793753207" width=520 height=292 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/225af83759a46b7373be1b23e4be9eca.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/225af83759a46b7373be1b23e4be9eca.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Learn new ability ranks, build around your favourite talents, command pets, and combine interrupts, crowd control and cooldowns. Classic tab-target combat gives every member of your party a job to do.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>960 talent nodes</strong>: three talent paths per calling, capstones, combo talents and free respecs.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/46dfbdd0163981c191e609165eeae670.poster.avif?t=1793753207" width=520 height=292 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/46dfbdd0163981c191e609165eeae670.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/46dfbdd0163981c191e609165eeae670.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Unlock the <strong>Chaosborn</strong> <strong>hero class</strong> after you complete the final raid for an <strong>endless roguelike RPG experience.</strong> Each Chaosborn is unique in it's own way. 3 options, 1 choice. Pick a new ability every level from the games entire ability pool. No Chaosborn is the same.</p><h2 class="bb_tag" >Tab-target Combat + Keep a hero training while you are AFK + Legendary Loot + Mounts</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/ccda1cc295c82cd16e588f1cf4fc9906.poster.avif?t=1793753207" width=780 height=520 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/ccda1cc295c82cd16e588f1cf4fc9906.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/ccda1cc295c82cd16e588f1cf4fc9906.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Once unlocked, camp training lets <strong>one resting guild member earn XP automatically</strong> while you adventure in solo play or step away. Return to a stronger hero and decide what they should learn next.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Tab-target combat with a real attack table</strong>: miss, dodge, parry, glancing blows, block, crits and crushing blows, spell resists, threat, tank stances and taunts.</p><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/82aea49ded71973e5214bb15c37f43e2.poster.avif?t=1793753207" width=520 height=292 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/82aea49ded71973e5214bb15c37f43e2.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/82aea49ded71973e5214bb15c37f43e2.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" ><strong>Personal loot</strong> from Common to Legendary, with light beams on blue and purple drops. <strong>570 named dungeon and raid rewards</strong>, 6 elite gear sets and 40 class legendaries.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Mounts</strong> (+60%, then +100%), a <strong>stone that carries you home</strong>, ferries and sky routes.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Rested XP</strong>, rare spawns with Wanted posters, named elites, quest chains, hidden mysteries and fishing records.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >Gather, craft and equip your guild + Auction House</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/3c0fa5d9e4f549317fbc70371b01c5c7.poster.avif?t=1793753207" width=780 height=520 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/3c0fa5d9e4f549317fbc70371b01c5c7.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/3c0fa5d9e4f549317fbc70371b01c5c7.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" ><strong>24 professions</strong>: gathering, crafting queues, recipes, masterwork gear, gems, sockets and enchants.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Build a network of specialists across <strong>24 professions</strong>. Each hero can choose two primary professions, with secondary pursuits including Cooking, Fishing, Farming, Archaeology and Cartography. Gather ore, herbs, timber and other materials; make equipment, bags, tools, food, potions and enchantments.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Share reagents through your Guild Bank, queue crafts, pursue mastery recipes and masterwork gear, and prepare supplies for your next expedition. Gardens, apiaries and animal pens give your guild more ways to produce what it needs.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>An auction house, mailbox, vendors with buyback, bags, a bank, and a guild bank that grows to 1,000 slots.</strong></p><h2 class="bb_tag" >Turn spare loot into your next upgrade</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/fc79ba4cc7e8c9881cb517a7f88e13cb.poster.avif?t=1793753207" width=640 height=360 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/fc79ba4cc7e8c9881cb517a7f88e13cb.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/fc79ba4cc7e8c9881cb517a7f88e13cb.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Put spare gear, crafted items and materials up for sale in the <strong>auction house</strong>. Set your prices, sell to NPC buyers while you adventure, and collect proceeds from your mailbox in gold, silver and copper. Browse rotating stock as you progress, fulfil guild orders, and put your earnings back into the next adventure.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >Take your party into dungeons and raids</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/0bd9d2f50183767e0bfb0e8879f8fad0.poster.avif?t=1793753207" width=616 height=346 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/0bd9d2f50183767e0bfb0e8879f8fad0.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/0bd9d2f50183767e0bfb0e8879f8fad0.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Explore five-hero dungeons and build towards raids for <strong>10,  20 or 40 heroes and soul companions</strong>. Break into the Blackglass Menagerie, answer the bells of the Drowned Cathedral, and coordinate forge teams in Skyforge Citadel.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" >Play solo or with up to four friends, filling available party places with your own companions. Read enemy attacks, assign control, protect your healers and claim personal boss rewards. Consult the encounter journal, track expedition records, and bring rare crafting materials back to your workshop.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>11 five-hero dungeons with 33 bosses</strong>, a heroic mode, <strong>5 raids for 10, 20 and 40 heroes</strong>, and <strong>3 wave-defense adventures</strong>.</p><p class="bb_paragraph" ></p><h2 class="bb_tag" >Explore beyond the next quest marker</h2><p class="bb_paragraph" ><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/1ac42414083bdaf1c8ec5b9986a9b3f7.poster.avif?t=1793753207" width=616 height=346 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/1ac42414083bdaf1c8ec5b9986a9b3f7.webm?t=1793753207" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/5338720/extras/1ac42414083bdaf1c8ec5b9986a9b3f7.mp4?t=1793753207" type="video/mp4"></video></span></p><p class="bb_paragraph" >Ride out with your guild on wolves and discover Sunwake's shores, wilds and uplands. Follow quest chains, hunt rare enemies, uncover hidden stories and build a collection of heroes with reasons to return.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>Guild Legacy &amp; achievements:</strong> Complete hundreds of guild achievements to earn Legacy points and unlock cosmetic milestone rewards. Every hero can invest the guild's full earned allowance independently in the Adventurer, Artisan and Oddities perk trees.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>No subscription, no queues and no raid lockouts.</strong> The whole guild is yours, solo or with up to four friends.</p><p class="bb_paragraph" ></p><p class="bb_paragraph" ><strong>One hero begins the journey. Your whole guild carries it forward.</strong></p>						</div>
					</div>

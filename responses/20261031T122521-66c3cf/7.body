eam\/apps\/4294030\/8ad8d434e6717ca5c3b43e3cc096542830b3839a\/ss_8ad8d434e6717ca5c3b43e3cc096542830b3839a.600x338.jpg?t=1792835480","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4294030\/8ad8d434e6717ca5c3b43e3cc096542830b3839a\/ss_8ad8d434e6717ca5c3b43e3cc096542830b3839a.1920x1080.jpg?t=1792835480"}],"movies":[{"id":257469208,"name":"Steam Next Fest Trailer","thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/257469208\/d18f33c7bb0b721fc36c53e60797aac7da39ccf8\/movie_600x337.jpg?t=1792669410","dash_av1":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4294030\/983464969\/cd3058727e6decd256a316b53ce21249cab1f258\/1792427644\/dash_av1.mpd?t=1792669410","dash_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4294030\/983464969\/cd3058727e6decd256a316b53ce21249cab1f258\/1792427644\/dash_h264.mpd?t=1792669410","hls_h264":"https:\/\/video.akamai.steamstatic.com\/store_trailers\/4294030\/983464969\/cd3058727e6decd256a316b53ce21249cab1f258\/1792427644\/hls_264_master.m3u8?t=1792669410","highlight":true}],"release_date":{"coming_soon":true,"date":"November 2026"},"support_info":{"url":"","email":"support@pixelgalaxies.io"},"background":"https:\/\/store.akamai.steamstatic.com\/images\/storepagebackground\/app\/4294030?t=1792835480","background_raw":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/4294030\/059512e7d1a6b90bfb6a88a2ba97ec54bc71d0cb\/page_bg_raw.jpg?t=1792835480","content_descriptors":{"ids":[],"notes":null},"ratings":{"dejus":{"rating_generated":"1","rating":"18","required_age":"18","banned":"0","use_age_gate":"0","descriptors":""},"steam_germany":{"rating_generated":"1","rating":"16","required_age":"16","banned":"0","use_age_gate":"0","descriptors":""}}}}}
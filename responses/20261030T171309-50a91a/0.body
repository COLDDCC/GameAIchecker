<style id="wp-custom-css">
/* MonsterVine Review Box (Squashed) */
.mv-review-box {
  background: #1a1a1a;
  color: #f1f1f1;
  border-left: 5px solid #6b8e23;
  border-radius: 4px;
  padding: 15px; /* Squashed from 20px */
  max-width: 100%;
  margin: 20px 0; /* Squashed from 30px */
  box-shadow: 0 4px 15px rgba(0,0,0,0.6);
  font-family: inherit;
}

.mv-review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #333;
  padding-bottom: 12px; /* Squashed */
  margin-bottom: 12px; /* Squashed */
}

.mv-review-title {
  font-size: 1.8em;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1px;
  text-transform: uppercase;
}

.mv-review-score {
  background: #6b8e23; /* MonsterVine Green */
  color: #fff;
  padding: 8px 12px;
  border-radius: 4px;
  font-weight: bold;
  text-align: center;
}

.score-number { font-size: 1.3em; }
.score-max { font-size: 0.9em; opacity: 0.8; }
.score-word { display: block; font-size: 0.8em; text-transform: uppercase; margin-top: 3px;}

.mv-review-body h4 {
  color: #6b8e23;
  margin-top: 0;
  margin-bottom: 8px; /* Squashed */
  text-transform: uppercase;
  font-size: 1.15em;
  letter-spacing: 1px;
}

.mv-review-body p {
  line-height: 1.5;
  margin-bottom: 15px; /* Squashed */
  font-size: 1.05em;
  color: #e0e0e0;
}

.mv-review-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px; /* Squashed gap between grid items */
  background: #252525;
  padding: 12px; /* Squashed */
  border-radius: 4px;
  margin-bottom: 15px; /* Squashed */
}

.meta-item {
  text-align: center;
}

.meta-item strong {
  display: block;
  color: #999;
  text-transform: uppercase;
  font-size: 0.85em;
  margin-bottom: 4px;
  letter-spacing: 0.5px;
}

.meta-item span {
  font-size: 1.05em;
  font-weight: 600;
  color: #ffffff;
}

.mv-review-footer {
  font-size: 0.85em;
  color: #888;
  text-align: center;
  font-style: italic;
  border-top: 1px solid #333;
  padding-top: 10px; /* Squashed */
}
</style>
</head>

	<div class="zox-post-head zoxrel">
		<h3 class="zox-post-cat">
			<a class="zox-post-cat-link" href="https://monstervine.com/category/news/"><span class="zox-post-cat">News</span></a>
		</h3>
		<h1 class="zox-post-title left entry-title" itemprop="headline">ReBlade: The Death Spiral Steam Demo Available Through November 10</h1>
				<div class="zox-post-info-wrap">
							<div class="zox-post-byline-wrap">
					<div class="zox-author-thumb">
						<img alt='' src='https://secure.gravatar.com/avatar/e3910f3e3578972adbd67ff62c469fa91b2323c6fe904de45d63a104a089fedb?s=40&#038;d=identicon&#038;r=g' srcset='https://secure.gravatar.com/avatar/e3910f3e3578972adbd67ff62c469fa91b2323c6fe904de45d63a104a089fedb?s=80&#038;d=identicon&#038;r=g 2x' class='avatar avatar-40 photo' height='40' width='40' decoding='async'/>					</div><!--zox-author-thumb-->
					<div class="zox-author-info-wrap">
						<div class="zox-author-name-wrap" itemprop="author" itemscope itemtype="https://schema.org/Person">
							<p>By</p><span class="zox-author-name vcard fn author" itemprop="name"><a href="https://monstervine.com/author/admin/" rel="author">William Saw</a></span>
						</div><!--zox-author-name-wrap-->
						<div class="zox-post-date-wrap">
							<p>Published</p> <span class="zox-post-date updated"><time class="post-date updated" itemprop="datePublished" datetime="2026-10-20">October 20, 2026</time></span>
							<meta itemprop="dateModified" content="2026-10-20"/>
						</div><!--zox-post-date-wrap-->

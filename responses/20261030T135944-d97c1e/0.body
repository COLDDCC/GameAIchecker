            <script>
            (function () {
            var identityCookieName = 'valnet-identity';
            var identitySyncCookieName = 'valnet-identity-sync';
            var identitySourceCookieName = 'valnet-identity-source';
            var cookieMaxAge = 34560000;

            function getCookie(name) {
                var prefix = name + '=';
                var cookies = document.cookie ? document.cookie.split('; ') : [];
                for (var i = 0; i < cookies.length; i++) {
                    if (cookies[i].indexOf(prefix) === 0) {
                        return decodeURIComponent(cookies[i].substring(prefix.length));
                    }
                }
                return '';
            }

            function setCookie(name, value) {
                var cookie = name + '=' + encodeURIComponent(value) + '; Max-Age=' + cookieMaxAge + '; Path=/; SameSite=Lax';
                if (window.location.protocol === 'https:') {
                    cookie += '; Secure';
                }
                document.cookie = cookie;
            }

            function encodeStructuredCookie(payload) {
                return btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
            }

            function decodeIdentityEmail() {
                var encoded = getCookie(identityCookieName);
                if (!encoded) {
                    return '';
                }

                try {
                    return atob(encoded).trim().toLowerCase();
                } catch (e) {
                    return '';
                }
            }

            function centralOrigin(centralBaseUrl) {
                try {
                    return new URL(centralBaseUrl).origin;
                } catch (e) {
                    return '';
                }
            }

            function centralIdentityHeaders() {
                return {'Content-Type': 'application/json'};
            }

            function isChrome() {
                return /Chrome\//.test(navigator.userAgent)
                    && !/Edg\//.test(navigator.userAgent)
                    && !/OPR\//.test(navigator.userAgent);
            }

            function postSyncToken(centralBaseUrl, token) {
                if (!token || !centralBaseUrl) {
                    return Promise.resolve();
                }

                var email = decodeIdentityEmail();
                return fetch(centralBaseUrl.replace(/\/$/, '') + '/sync', {
                    method: 'POST',
                    credentials: 'include',
                    headers: centralIdentityHeaders(),
                    body: JSON.stringify({token: token})
                }).then(function (response) {
                    if (!response.ok) {
                        throw new Error('identity sync failed');
                    }
                    return response.json();
                }).then(function (payload) {
                    if (payload && payload.ok && email) {
                        setCookie(identitySyncCookieName, encodeStructuredCookie({
                            email: email,
                            checked_at: Math.floor(Date.now() / 1000)
                        }));
                    }
                }).catch(function () {
                    var iframeName = 'valnet-identity-sync-' + Math.random().toString(36).slice(2);
                    var iframe = document.createElement('iframe');
                    iframe.name = iframeName;
                    iframe.style.display = 'none';
                    document.body.appendChild(iframe);

                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = centralBaseUrl.replace(/\/$/, '') + '/sync';
                    form.target = iframeName;
                    form.style.display = 'none';

                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'token';
                    input.value = token;
                    form.appendChild(input);
                    document.body.appendChild(form);
                    form.submit();
                });
            }

            function discoverCentralIdentity(centralBaseUrl, brand) {
                if (!isChrome() || getCookie(identityCookieName) || !brand || !centralBaseUrl) {
                    return;
                }

                var origin = centralOrigin(centralBaseUrl);
                if (!origin) {
                    return;
                }

                var state = Math.random().toString(36).slice(2) + String(Date.now());
                setCookie(identitySyncCookieName, encodeStructuredCookie({
                    email: '',
                    checked_at: Math.floor(Date.now() / 1000)
                }));

                window.addEventListener('message', function (event) {
                    var message = event.data || {};
                    if (event.origin !== origin || message.type !== 'valnet_identity_code' || message.brand !== brand || message.state !== state) {
                        return;
                    }

                    if (message.status !== 'found' || !message.code) {
                        return;
                    }

                    fetch('/identity/token/', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({code: message.code})
                    }).then(function (response) {
                        return response.ok ? response.json() : null;
                    }).then(function (payload) {
                        if (payload && payload.ok && payload.email) {
                            setCookie(identityCookieName, btoa(payload.email));
                            setCookie(identitySourceCookieName, encodeStructuredCookie({
                                source: 'central',
                                set_at: Math.floor(Date.now() / 1000)
                            }));
                            setCookie(identitySyncCookieName, encodeStructuredCookie({
                                email: payload.email,
                                checked_at: Math.floor(Date.now() / 1000)
                            }));
                            window.VALNET_GLOBAL_IDENTITYSOURCE = 'central';
                        }
                    }).catch(function () {});
                });

                var iframe = document.createElement('iframe');
                iframe.src = centralBaseUrl.replace(/\/$/, '') + '/discover?brand=' + encodeURIComponent(brand) + '&origin=' + encodeURIComponent(window.location.origin) + '&state=' + encodeURIComponent(state);
                iframe.style.display = 'none';
                iframe.referrerPolicy = 'no-referrer';
                document.body.appendChild(iframe);
            }

            function start() {
                postSyncToken("https:\/\/secure.valnetinc.com", "");
                discoverCentralIdentity("https:\/\/secure.valnetinc.com", window.VALNET_GLOBAL_BRAND_SHORT_NAME || '');
            }

            window.valnetIdentitySyncToken = function (token) {
                return postSyncToken("https:\/\/secure.valnetinc.com", token || '');
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', start);

<script>
    (self.PREFERRED_SOURCE = self.PREFERRED_SOURCE || []).push(function(preferredSource) {
        preferredSource.init({ theme: 'light' });

        isIosDevice = () => {
            return (/iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 0 && !window.MSStream);
        }

        document.addEventListener('click', function(event) {
            var trigger = event.target.closest('[data-google-add-preferred-source]');

            if (!trigger || isIosDevice()) {
                return;
            }

            event.preventDefault();
            preferredSource.addPreferredSource();
        });
    });
</script>
    
                                        
                                                
    

    
        
    
    


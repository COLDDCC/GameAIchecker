            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
    </button>
    <audio
        preload="none"
        data-src="https&#x3A;&#x2F;&#x2F;static1.srcdn.com&#x2F;wordpress&#x2F;wp-content&#x2F;uploads&#x2F;audio-reader&#x2F;2026&#x2F;10&#x2F;article-6371253-673fabcb35c9-20261028062500.mp3"
            ></audio>

    <div class="audio-reader-player-header">
        <strong>Listen</strong>
        <span data-audio-reader-duration></span>
    </div>

    <div class="audio-reader-waveform" data-audio-reader-waveform data-waveform-bars="76" aria-hidden="true"></div>

    <div class="audio-reader-player-controls">
        <button type="button" class="audio-reader-player__skip" data-audio-reader-rewind aria-label="Rewind 15 seconds">
            <svg viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4h8a7 7 0 0 1 0 14H7"/>
                <polyline points="11 1 7 4 11 7"/>
                <text x="13" y="12" text-anchor="middle" dominant-baseline="middle" font-size="6.5" font-weight="500" fill="currentColor" stroke="none" font-family="system-ui,-apple-system,sans-serif">15</text>
            </svg>
        </button>
        <button type="button" class="audio-reader-player__play" data-audio-reader-toggle aria-label="Play Audio Reader">
            <span class="audio-reader-player__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
            </span>
            <span class="audio-reader-player__pause-icon is-hidden" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            </span>
        </button>
        <button type="button" class="audio-reader-player__skip" data-audio-reader-forward aria-label="Forward 15 seconds">
            <svg viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 4H9a7 7 0 0 0 0 14h8"/>
                <polyline points="13 1 17 4 13 7"/>
                <text x="11" y="12" text-anchor="middle" dominant-baseline="middle" font-size="6.5" font-weight="500" fill="currentColor" stroke="none" font-family="system-ui,-apple-system,sans-serif">15</text>
            </svg>
        </button>
    </div>

    <div class="audio-reader-player__scrubber-row">
        <input type="range" min="0" max="1000" value="0" data-audio-reader-progress aria-label="Audio Reader progress">
        <span class="audio-reader-player__time">
            <em data-audio-reader-current>0:00</em> / <span data-audio-reader-total>0:00</span>
        </span>
        <button type="button" class="audio-reader-player__speed" data-audio-reader-speed data-speed-value="1" aria-label="Playback speed">1×</button>
    </div>
</div>

<script>
    (function () {
        var speedSteps = [0.75, 1, 1.25, 1.5, 2];

        function formatTime(seconds) {
            if (!isFinite(seconds) || seconds < 0) {
                seconds = 0;
            }

            var rounded = Math.floor(seconds);
            var hours = Math.floor(rounded / 3600);
            var minutes = Math.floor((rounded % 3600) / 60);
            var remainingSeconds = rounded % 60;

            if (hours > 0) {
                return hours + ':' + String(minutes).padStart(2, '0') + ':' + String(remainingSeconds).padStart(2, '0');
            }

            return minutes + ':' + String(remainingSeconds).padStart(2, '0');
        }

        function formatHeaderDuration(seconds) {
            if (!isFinite(seconds) || seconds <= 0) {
                return '';
            }

            var minutes = Math.round(seconds / 60);
            if (minutes < 1) {
                minutes = 1;
            }

            return ' · ' + minutes + ' min';
        }

        function formatSpeedLabel(rate) {
            var label = String(rate);
            if (label.indexOf('.') !== -1) {
                label = label.replace(/0+$/, '').replace(/\.$/, '');
            }
            return label + '×';
        }

        function setPlayingState(toggle, playing) {
            var playIcon = toggle.querySelector('.audio-reader-player__play-icon');
            var pauseIcon = toggle.querySelector('.audio-reader-player__pause-icon');

            if (playIcon) {
                playIcon.classList.toggle('is-hidden', playing);
            }
            if (pauseIcon) {
                pauseIcon.classList.toggle('is-hidden', !playing);
            }

            toggle.setAttribute('aria-label', playing ? 'Pause Audio Reader' : 'Play Audio Reader');
        }

        function initPlayer(player) {
            if (player.getAttribute('data-audio-reader-ready') === 'true') {
                return;
            }

            player.setAttribute('data-audio-reader-ready', 'true');

            var audio = player.querySelector('audio');
            var toggle = player.querySelector('[data-audio-reader-toggle]');
            var rewind = player.querySelector('[data-audio-reader-rewind]');
            var forward = player.querySelector('[data-audio-reader-forward]');
            var progress = player.querySelector('[data-audio-reader-progress]');
            var current = player.querySelector('[data-audio-reader-current]');
            var duration = player.querySelector('[data-audio-reader-duration]');
            var total = player.querySelector('[data-audio-reader-total]');
            var speed = player.querySelector('[data-audio-reader-speed]');
            var waveform = player.querySelector('[data-audio-reader-waveform]');
            var close = player.querySelector('[data-audio-reader-close]');
            var knownDuration = 0;
            var speedIndex = 1;

            if (waveform && !waveform.children.length) {
                var barCount = parseInt(waveform.getAttribute('data-waveform-bars') || '200', 10);
                for (var i = 0; i < barCount; i++) {
                    var bar = document.createElement('span');
                    var t = i / barCount;
                    var h = 18
                        + Math.abs(Math.sin(t * Math.PI * 6))      * 28
                        + Math.abs(Math.sin(t * Math.PI * 13 + 1)) * 20
                        + Math.abs(Math.sin(t * Math.PI * 27 + 2)) * 14;
                    bar.style.height = Math.min(100, Math.round(h)) + '%';
                    waveform.appendChild(bar);
                }
            }
            var bars = waveform ? waveform.querySelectorAll('span') : [];

            function getDuration() {
                return audio.duration || knownDuration || 0;
            }

            function ensureAudioLoaded() {
                if (!audio.getAttribute('src')) {
                    var audioUrl = audio.getAttribute('data-src') || '';
                    if (!audioUrl) {
                        return false;
                    }
                    audio.setAttribute('src', audioUrl);
                    audio.load();
                }

                return true;
            }

            function setPlaybackPosition(value) {
                var durationValue = getDuration();
                if (!durationValue) {
                    return;
                }

                if (!ensureAudioLoaded()) {
                    return;
                }
                audio.currentTime = Math.max(0, Math.min(durationValue, value));
            }

            function updateProgress() {
                var durationValue = getDuration();
                var ratio = durationValue ? audio.currentTime / durationValue : 0;
                var playedBars = Math.round(ratio * bars.length);

                progress.value = Math.round(ratio * Number(progress.max));
                current.textContent = formatTime(audio.currentTime);
                total.textContent = formatTime(durationValue);

                duration.textContent = formatHeaderDuration(durationValue);

                Array.prototype.forEach.call(bars, function (bar, index) {
                    bar.classList.toggle('is-played', index < playedBars);
                });
            }

            toggle.addEventListener('click', function () {
                if (audio.paused) {
                    if (!ensureAudioLoaded()) {
                        return;
                    }
                    audio.play();
                } else {
                    audio.pause();
                }
            });

            rewind.addEventListener('click', function () {
                setPlaybackPosition(audio.currentTime - 15);
            });

            forward.addEventListener('click', function () {
                setPlaybackPosition(audio.currentTime + 15);
            });

            progress.addEventListener('input', function () {
                var durationValue = getDuration();
                if (!durationValue) {
                    return;
                }

                setPlaybackPosition((Number(progress.value) / Number(progress.max)) * durationValue);
            });

            speed.addEventListener('click', function () {
                speedIndex = (speedIndex + 1) % speedSteps.length;
                var rate = speedSteps[speedIndex];
                audio.playbackRate = rate;
                speed.textContent = formatSpeedLabel(rate);
                speed.setAttribute('data-speed-value', String(rate));
            });

            if (close) {
                close.addEventListener('click', function () {
                    // Pause, don't reset — reopening resumes from here.
                    audio.pause();
                    hidePlayer(player);
                });
            }

            if (waveform) {
                waveform.addEventListener('click', function (event) {
                    var bounds = waveform.getBoundingClientRect();
                    var ratio = (event.clientX - bounds.left) / bounds.width;
                    setPlaybackPosition(ratio * getDuration());
                });
            }

            audio.addEventListener('loadedmetadata', updateProgress);
            audio.addEventListener('timeupdate', updateProgress);
            audio.addEventListener('play', function () {
                setPlayingState(toggle, true);
            });
            audio.addEventListener('pause', function () {
                setPlayingState(toggle, false);
            });
            audio.addEventListener('ended', function () {
                setPlayingState(toggle, false);
            });

            updateProgress();
            loadMetadata(audio, bars, function (metadataDuration) {
                knownDuration = metadataDuration;
                updateProgress();
            });
        }

        function isMobileViewport() {
            return window.matchMedia('(max-width: 1023px)').matches;
        }

        // Desktop only: aligns the card's width/left edge to the sidebar
        // column's real rendered size instead of the CSS fallback width.
        function alignPlayerToSidebarColumn(player) {
            var sidebarColumn = document.querySelector('#secondary.sidebar, aside.sidebar, #secondary');
            if (!sidebarColumn) {
                return;
            }

            var columnRect = sidebarColumn.getBoundingClientRect();
            if (columnRect.width > 0) {
                // Sub-pixel values avoid a 1px gap at the right edge.
                player.style.boxSizing = 'border-box';
                player.style.left = columnRect.left + 'px';
                player.style.right = 'auto';
                player.style.width = columnRect.width + 'px';
            }
        }

        // Static position on both breakpoints — bottom offset comes from CSS
        // (desktop/tablet-max blocks in audio-reader-player.scss), no ad
        // measurement or scroll/resize recalculation. A late-loading bottom
        // ad may cover the player rather than the player dodging it.
        function positionPlayer(player) {
            if (!player) {
                return;
            }

            if (isMobileViewport()) {
                // Clear inline desktop alignment so the CSS bottom bar applies.
                player.style.left = '';
                player.style.right = '';
                player.style.width = '';
                player.style.bottom = '';
                return;
            }

            // Clear any inline bottom offset left over from mobile.
            player.style.bottom = '';
            alignPlayerToSidebarColumn(player);
        }

        function syncTriggerPressedState(visible) {
            Array.prototype.forEach.call(document.querySelectorAll('[data-audio-reader-trigger]'), function (trigger) {
                trigger.setAttribute('aria-pressed', visible ? 'true' : 'false');
            });
        }

        function isPlayerVisible(player) {
            return player && !player.classList.contains('is-hidden');
        }

        function hidePlayer(player) {
            if (!player || !isPlayerVisible(player)) {
                return;
            }

            player.classList.add('is-hidden');
            player.setAttribute('aria-hidden', 'true');
            syncTriggerPressedState(false);
        }

        function showPlayer(player) {
            if (!player) {
                return;
            }

            player.classList.remove('is-hidden');
            player.setAttribute('aria-hidden', 'false');
            syncTriggerPressedState(true);
            // Build the UI first so it has its final height.
            initPlayer(player);

            positionPlayer(player);

            var audio = player.querySelector('audio');
            var toggle = player.querySelector('[data-audio-reader-toggle]');
            if (audio && toggle && audio.paused) {
                toggle.click();
            }
        }

        function togglePlayer(player) {
            if (!player) {
                return;
            }

            if (isPlayerVisible(player)) {
                hidePlayer(player);
            } else {
                showPlayer(player);
            }
        }

        function applyMetadata(metadata, bars, onDuration) {
            if (!metadata || typeof metadata !== 'object') {
                return;
            }

            var metadataDuration = Number(metadata.duration || 0);
            if (metadataDuration > 0) {
                onDuration(metadataDuration);
            }

            if (metadata.waveform && Array.isArray(metadata.waveform.peaks) && bars && bars.length) {
                metadata.waveform.peaks.slice(0, bars.length).forEach(function (peak, index) {
                    var normalizedPeak = Math.max(0, Math.min(1, Number(peak)));
                    var height = 12 + Math.round(normalizedPeak * 88);
                    bars[index].style.height = height + '%';
                });
            }
        }

        function loadMetadata(audio, bars, onDuration) {
            var inlineMetadata = audio.getAttribute('data-audio-reader-metadata');
            if (inlineMetadata) {
                try {
                    applyMetadata(JSON.parse(inlineMetadata), bars, onDuration);
                } catch (error) {}
                return;
            }

            var metadataUrl = getMetadataUrl(audio.currentSrc || audio.src || audio.getAttribute('data-src'));
            if (!metadataUrl) {
                return;
            }

            fetch(metadataUrl, { credentials: 'same-origin' })
                .then(function (response) {
                    return response.ok ? response.json() : null;
                })
                .then(function (metadata) {
                    applyMetadata(metadata, bars, onDuration);
                })
                .catch(function () {});
        }

        function getMetadataUrl(audioUrl) {
            if (!audioUrl || !/\.mp3($|\?)/i.test(audioUrl)) {
                return '';
            }

            return audioUrl.replace(/\.mp3(?=($|\?))/i, '.metadata.json');
        }

        function initAudioReaderTriggers() {
            Array.prototype.forEach.call(document.querySelectorAll('[data-audio-reader-trigger]'), function (trigger) {
                if (trigger.getAttribute('data-audio-reader-trigger-ready') === 'true') {
                    return;
                }
                trigger.setAttribute('data-audio-reader-trigger-ready', 'true');

                trigger.addEventListener('click', function (event) {
                    event.preventDefault();
                    togglePlayer(document.querySelector('[data-audio-reader-player]'));
                });
            });
        }

        function initAudioReaders() {
            initAudioReaderTriggers();

            // Only reposition on a genuine resize that crosses the mobile/
            // desktop breakpoint or changes width — AdsNinja fires spurious
            // resize events during scroll without the width actually changing.
            var resizeTimer;
            var lastWidth = window.innerWidth;
            var lastIsMobile = isMobileViewport();
            window.addEventListener('resize', function () {
                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(function () {
                    var nowWidth = window.innerWidth;
                    var nowMobile = isMobileViewport();

                    if (nowWidth === lastWidth && nowMobile === lastIsMobile) {
                        return;
                    }

                    lastWidth = nowWidth;
                    lastIsMobile = nowMobile;

                    var player = document.querySelector('[data-audio-reader-player]:not(.is-hidden)');
                    if (player) {
                        positionPlayer(player);
                    }
                }, 150);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAudioReaders);
        } else {
            initAudioReaders();
        }
    })();
</script>
        

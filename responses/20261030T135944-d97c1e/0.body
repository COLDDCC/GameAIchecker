<header id="js-header" class="w-header  layout-rich" data-type="header">

											
																				
	

		
	
								
				
				

	<div class="wrapper main-navigation">
		<div class="header-nav nav-menu  has-secondary-header  ">

			<div class="header-section nav-left">
				<label class="menu-icon topnav-icon icon i-menu-new css-menu--toggle" for="side_menu">
					<span>Menu</span>
				</label>
							</div>

			<div class="header-section nav-center">
				<a
					href="/" rel="home" class="header-logo">
					<!-- Full Logo Picture Element -->
					<picture class="header-full-logo">
						
							<source srcset="https://static0.srcdn.com/assets/images/sr-logo-full-colored-light.svg?v=3.8" media="(prefers-color-scheme: dark)">
							<img src="https://static0.srcdn.com/assets/images/sr-logo-full-colored-light.svg?v=3.8" alt="ScreenRant logo" title="ScreenRant" height="35" width="326"/>

											</picture>

				</a>
			</div>

			<div
				class="header-section nav-right static">

								                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="header-preferred-source" data-nosnippet data-stnl="%7B%22category%22%3A%22Click%20Interactions%22%2C%22name%22%3A%22Website%20Header%22%2C%22action%22%3A%22Add%20to%20Google%22%7D">
                    <div class="header-preferred-source__link">
                        <span class="icon i-google" aria-hidden="true"></span>
						
						<a class="header-preferred-source__link-pill" href="https://www.google.com/preferences/source?q=screenrant.com" data-google-add-preferred-source target="_blank" rel="noopener noreferrer">					

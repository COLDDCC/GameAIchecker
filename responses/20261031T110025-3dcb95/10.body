hen your lab is full\n[*]32 achievements and Steam Cloud saves\n[*]All-new, human-made music\n[*]11 languages and full controller support\n[\/list]\n\n[h3]Played the demo?[\/h3]\nYour progress carries over. Start the full game on the same computer, press Continue, and you're right where the demo stopped.\n\n[h3]Launch discount[\/h3]\n15% off until November 11.\n\n[h3]Tell us how it goes[\/h3]\nFound a bug or have an idea? Post it in the [url=https:\/\/steamcommunity.com\/app\/5189500\/discussions\/]Steam discussions[\/url] or join us on [url=https:\/\/discord.gg\/FDGpRAqyvt]Discord[\/url].\n\nIf you're enjoying the game, a review here on Steam helps a small game like ours more than anything.\n\nHappy sorting!\n\nhttps:\/\/store.steampowered.com\/app\/5189500\/","commentcount":15,"tags":["mod_reviewed","ModAct_1751656904_1793217708_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173066510","event_gid":"668380665149915743","voteupcount":52,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173066510","rtime32_last_modified":1793403244,"news_post_gid":"0","rtime_mod_reviewed":1793217708,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793217228,"votes_up":52,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"594069606514321668","gidfeature2":"571553273173066510"},{"gid":"702155760121941429","clan_steamid":"103582791475812643","event_name":"We're removing generative AI from the game","event_type":28,"appid":5189500,"server_address":null,"server_password":null,"rtime32_start_time":1791869880,"rtime32_end_time":1791873420,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"The music is already replaced. The textures are in progress\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The full game is moving away from generative AI: the music has already been replaced, and we're working on the textures now. The demo stays as it is.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"2c35099b8d00edac22ca3c6691130cb3d5aa5645.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e538eddc8a130aae35405aee08b1848789cd28c3.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"702155760121941430","clanid":"46291235","posterid":"0","headline":"We're removing generative AI from the game","posttime":1791869930,"updatetime":1791869930,"body":"[p]Hey everyone,\n\nWhen we made A Place for Every Potion, we used generative AI for some of the textures and for the music. Many of you asked us to change that, so now we're replacing it.\n\n[\/p][h3]Music[\/h3][p]This part is done. All the music in the full game has been replaced with human-made music. We're also updating the AI disclosure on the store page, so music will no longer be listed there.\n\n[\/p][h3]Textures[\/h3][p]A freelance artist kindly offered to help, and now we're replacing the textures together! We can't promise it will all be finished by launch, but we'll do our best.\n\n[\/p][h3]What about the demo?[\/h3][p]The demo stays as it is, with the old music and textures. All of these changes are for the full game, which comes out on October 28.\n\nThanks for playing, and for caring about how games are made.[\/p]","commentcount":26,"tags":["mod_reviewed","ModAct_1751692459_1791874389_0"],"language":0,"hidden":0,"forum_topic_id":"594069880290996132","event_gid":"702155760121941429","voteupcount":202,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"594069880290996132","rtime32_last_modified":1793410652,"news_post_gid":"0","rtime_mod_reviewed":1791874390,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791869576,"votes_up":202,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"594069606514321668","gidfeature2":"594069880290996132"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["668380665149915744","702155760121941430"],"last_update_event":[]}};

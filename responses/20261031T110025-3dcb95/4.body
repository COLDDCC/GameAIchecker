							var StoreDefaults = {"PartnerEventStore":[{"gid":"693149828915402367","clan_steamid":"103582791475798374","event_name":"Mildmay Line Richmond Extension - CCTV & District Line Notes","event_type":28,"appid":4678800,"server_address":null,"server_password":null,"rtime32_start_time":1792749660,"rtime32_end_time":1792753260,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"50ffa46c2efbe2bb3942be0d9db4ee3461509caf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6780170c168f04830a9187308099aceac21c58bf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"693149828915402368","clanid":"46276966","posterid":"0","headline":"Mildmay Line Richmond Extension - CCTV & District Line Notes","posttime":1792749712,"updatetime":1792749712,"body":"[p]Good morning folks, [\/p][p]The [b]Mildmay Line Richmond Extension[\/b] arrived yesterday as a free upgrade for everyone owning the London Overground: Mildmay Line Route Add-On. [\/p][p][\/p][p]We\u2019ve seen a lot of feedback and wanted to share a quick follow-up regarding the most common reports: [\/p][p][\/p][p][u][b]CCTV isn't working[\/b]:[\/u] The following settings need to be turned on for the DOO CCTV feature to work: [\/p][list][*][p]Settings > Player Assist > Player Assist Default Level > Set this to [b]\u201cExpert\u201d[\/b][\/p][\/*][*][p]Settings > Player Assist > Expert Mode (Expert Locos Only) > Set this to [b]\u201cOn\u201d[\/b][\/p][\/*][\/list][p] [\/p][p][u][b]Stuck District Line AI trains:[\/b][\/u] If AI-operated trains get stuck at Richmond, remove [u]any installed mods[\/u]. Some mods, including [b]\u201cD78 Stock Branding Patch for GWER\u201d [\/b]have been confirmed to cause this issue. If it persists, try a clean install and reintroduce mods gradually to identify the culprit. [\/p][p][b]We generally recommend doing this[\/b] if you are on PC and experiencing issues, as mods can cause conflicts, leading to wider issues we won't be able to easily reproduce if these issues are reported as bugs. [\/p][p][\/p][p][u][b]Blurry textures:[\/b][\/u] The extension adds content that can strain memory, which can cause blurry textures in busy areas like Camden. We\u2019re continuing to work on reducing memory use, but for now, we recommend you disable the following layers; they are AI statics which don\u2019t affect gameplay and may help reduce blurriness: [\/p][list][*][p][b]Southeastern Highspeed (SEHS) [\/b][\/p][\/*][*][p][b]Class 801 [\/b][\/p][\/*][*][p][b]Class 700[\/b][\/p][\/*][\/list][p][\/p][p]Thank you to everyone who provided feedback so far.[\/p]","commentcount":12,"tags":["mod_reviewed","ModAct_1415716708_1792754746_0"],"language":0,"hidden":0,"forum_topic_id":"570426739071866334","event_gid":"693149828915402367","voteupcount":156,"votedowncount":13,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426739071866334","rtime32_last_modified":1793411007,"news_post_gid":"0","rtime_mod_reviewed":1792754746,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792749657,"votes_up":156,"votes_down":13,"comment_type":"ForumTopic","gidfeature":"591813764140102096","gidfeature2":"570426739071866334"},{"gid":"693149828915400986","clan_steamid":"103582791475798374","event_name":"The Mildmay Extension is Out Now!","event_type":28,"appid":4678800,"server_address":null,"server_password":null,"rtime32_start_time":1792661040,"rtime32_end_time":1792664460,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"A FREE update for existing owners of TSW 7: London Overground Mildmay line: Stratford - Willesden Junction!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"50ffa46c2efbe2bb3942be0d9db4ee3461509caf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6780170c168f04830a9187308099aceac21c58bf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"693149828915400987","clanid":"46276966","posterid":"0","headline":"The Mildmay Extension is Out Now!","posttime":1792661080,"updatetime":1792661080,"body":"[p]The [b]Mildmay line Richmond Extension is OUT NOW[\/b], taking London Overground services beyond Willesden Junction and all the way to Richmond.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/eadeebcf48746678b335d9985da1648cadd6b66e.png\"][\/img][\/p][p]Available as a [b]FREE update for existing owners of Train Sim World 7: London Overground Mildmay line: Stratford - Willesden Junction Route Add-On[\/b], the expansion adds around 5 miles of railway, five new stations and a range of new features and gameplay opportunities across West London.[\/p][p]For players joining the Mildmay line for the first time, the complete expanded route is now available for [b]\u00a329.99 \/ \u20ac35.99 \/ $39.99[\/b].[\/p][p][\/p][previewyoutube=\"MyoE5Un8Fj8;full\"][\/previewyoutube][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4680200\/Train_Sim_World_7_London_Overground_Mildmay_line_Stratford_Willesden_Junction_Route_AddOn\/\"][\/dynamiclink][\/p][h2]The Mildmay line, Now Extended to Richmond[\/h2][p]Your London Overground journeys can now continue beyond Willesden Junction through to [b]Richmond[\/b], adding five new stations to the route:[\/p][list][*][p][b]Acton Central[\/b][\/p][\/*][*][p][b]South Acton[\/b][\/p][\/*][*][p][b]Gunnersbury[\/b][\/p][\/*][*][p][b]Kew Gardens[\/b][\/p][\/*][*][p][b]Richmond[\/b][\/p][\/*][\/list][p][\/p][p]Along the way, the Class 378 transitions from [b]25 kV AC overhead power to 750 V DC third rail[\/b] at Acton Central before continuing through West London towards the River Thames and Richmond.[\/p][p]The update also brings a number of new features and improvements to the wider Mildmay line experience, including [b]working in-cab CCTV screens[\/b], audible passenger announcements and additional detail for the Class 378.[\/p][p]Around the new section, additional railway and environmental activity helps bring West London to life, from the shared railway with the District line around Gunnersbury to animated traffic around the River Thames.[\/p][p]And because this is an expansion to the existing Mildmay line rather than a separate Add-On, existing owners can jump straight in at [b]no additional cost[\/b].[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/7fe169fcb60e1eacc2be05aa714794d568bc396e.png\"][\/img][\/p][h2]Timetable Deep Dive[\/h2][p]Extending the route to Richmond naturally brings changes to the Mildmay line timetable, but much of the existing experience remains familiar.[\/p][p]The biggest passenger addition is a [b]full diagram of BR Class 710 services[\/b].[\/p][p]Owners of [b]London Overground Suffragette line[\/b] can now regularly put the Aventra to work across the expanded Mildmay line timetable alongside the Class 378.[\/p][p]Freight players have some new options too.[\/p][p]The [b]BR Class 90[\/b] and the recently released [b]Freightliner BR Class 70[\/b] can now substitute into [b]all existing Class 66 freight services[\/b] on the Mildmay line, giving you considerably more choice when taking freight across North and West London.[\/p][p]Outside of these additions, the timetable itself remains largely unchanged, retaining the existing passenger, freight and AI operations while extending core London Overground services through to Richmond.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/80aa5d3a62f56abdd42cba217ffc6e11bc1aa956.png\"][\/img][\/p][h2]Layers and AI Traffic[\/h2][p]The Richmond Extension sits at the heart of a very busy part of London's railway network, and compatible Add-Ons from your collection can add even more traffic and gameplay.[\/p][p][\/p][h3]BR Class 710[\/h3][p]Own [b]London Overground Suffragette line[\/b]?[\/p][p]The [b]BR Class 710[\/b] adds a full playable diagram to the Mildmay line timetable, allowing the Aventra to work regular London Overground passenger services alongside the Class 378.[\/p][p][\/p][h3]District line[\/h3][p]Players who own both [b]Great Western Express[\/b] and the [b]BR Class 484[\/b] can also take control of playable [b]District line services between Richmond and Gunnersbury[\/b].[\/p][p]The Class 484 is presented in London Underground-inspired colours to represent District line stock, introducing a very different style of passenger service to the western end of the route.[\/p][p][\/p][h3]Freightliner Class 70 and BR Class 90[\/h3][p]The freight timetable also benefits from your wider collection.[\/p][p]Both the [b]Freightliner BR Class 70[\/b] and [b]BR Class 90[\/b] can substitute for the Class 66 across its freight workings, opening up more ways to tackle the existing freight timetable.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/a4b37bf6062a5bf0280f8597c3b9e0657b4c2222.png\"][\/img][\/p][h3]South West Trains at Richmond[\/h3][p]Owners of [b]West Coast Main Line: London Euston - Milton Keynes[\/b] will also see additional activity around Richmond.[\/p][p]The included Class 350 appears in a licensed [b]South West Trains livery[\/b], representing Class 450 services as AI traffic around the station and helping make the new terminus feel much busier.[\/p][p][\/p][h3]Great Western Main Line Traffic[\/h3][p]Where the Mildmay line crosses the Great Western Main Line, additional AI traffic can also appear around the railway.[\/p][p]This includes [b]Class 345 Elizabeth line services[\/b] and [b]GWR Class 802 intercity trains[\/b], adding more movement to the wider London railway network.[\/p][p]You'll also encounter passing [b]London Underground AI services[\/b] where the route intersects with the Underground network.[\/p][p]Together, these layers help make the expanded Mildmay line feel part of the much larger railway system surrounding it.[\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/886c53536385ca9e3ec2dfb2401e47ee8f057b65.png\"][\/img][\/p][h2]Catch Up on the Mildmay line Preview[\/h2][p]Ahead of release, we were joined by [b]Johannes from Incredible Trains[\/b] for a closer look at the Richmond Extension.[\/p][p]The stream takes a deeper dive into the new section of the route, its features and what players can expect from the expanded Mildmay line experience.[\/p][p][\/p][previewyoutube=\"8kto_XtPyCg;full\"][\/previewyoutube][p][\/p][h2]Catch British Ace Later Today[\/h2][p]Want another look at the extension in action?[\/p][p][b]British Ace[\/b] will be taking to the Mildmay line later today alongside Johannes, showcasing the Richmond Extension and exploring what the new section brings to the route.[\/p][p][\/p][previewyoutube=\"EXHuB3HCqJc;full\"][\/previewyoutube][p][\/p][h2]Train Sim World 7 Update - October 22nd[\/h2][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/4ea3838a4a25dc79acd8d7f3c2ce545637313c30.jpg\"][\/img][\/p][p]Our work to improve Train Sim World 7 continues with today\u2019s smaller optimisation patch.\nThis update optimises textures across various rolling stock, reducing overall memory usage. This should improve performance across multiple routes and may also help reduce blurry textures.\nYou can read the full changelog in this article.[\/p][p]We\u2019ll continue our efforts to improve performance and will keep you updated on future developments.[\/p][p][\/p][h2]Find Your Next Journey[\/h2][p]Finished exploring Richmond and wondering where to head next?[\/p][p]The [b]Train Sim World Add-On Explorer[\/b] can help you find another route based on the way you like to play.[\/p][p]Choose from preferences including [b]country, gameplay, environment, speed and session length[\/b] to discover routes that might be the right fit for your collection.[\/p][p]Whether you're looking for busy commuter services, high-speed running, heavy freight or something a little more relaxed, the Explorer can help point you in the right direction.[\/p][p][url=\"https:\/\/trainsimworld.com\/gb\/find-your-next-journey\"]Find Your Next Journey with the Add-On Explorer[\/url][\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/45631e9573690039ada4805c028ef7cb9ab6b8fb.png\"][\/img][\/p][h2]The Mildmay line Richmond Extension is OUT NOW![\/h2][p]The [b]Mildmay line Richmond Extension is available now[\/b], adding five new stations and extending London Overground services all the way to Richmond.[\/p][p]Existing owners of [b]Train Sim World 7: London Overground Mildmay line: Stratford - Willesden Junction Route Add-On[\/b] receive the expansion as a [b]FREE update[\/b].[\/p][p]For new players, the complete expanded route is available now for [b]\u00a329.99 \/ \u20ac35.99 \/ $39.99[\/b].[\/p][p]From Class 378 and Class 710 passenger workings to District line services, freight substitutions and a much busier Richmond, there's more to discover across the Mildmay line than ever before.[\/p][p]See you out west![\/p]","commentcount":16,"tags":["mod_reviewed","ModAct_1434278705_1792662015_0"],"language":0,"hidden":0,"forum_topic_id":"570426739071775909","event_gid":"693149828915400986","voteupcount":158,"votedowncount":13,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426739071775909","rtime32_last_modified":1793384806,"news_post_gid":"0","rtime_mod_reviewed":1792662015,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792659301,"votes_up":158,"votes_down":13,"comment_type":"ForumTopic","gidfeature":"591813764140102096","gidfeature2":"570426739071775909"},{"gid":"712290761518875139","clan_steamid":"103582791475798374","event_name":"Mildmay Line Update Notes - October 29th 2026","event_type":12,"appid":4678800,"server_address":null,"server_password":null,"rtime32_start_time":1793268000,"rtime32_end_time":1793273401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"2020e00c486de9413a6b2e0fb4f6dd612a6dd94f.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"712290761518875140","clanid":"46276966","posterid":"0","headline":"Mildmay Line Update Notes - October 29th 2026","posttime":1793268014,"updatetime":1793268014,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46276966\/673d768b3ea20e1c6372a2da7799c73cde8b5125.png\"][\/img][\/p][p]Today we have a small update for the new Mildmay line extension, targeting key fixes and a few areas spotted from community feedback following the launch.[\/p][p]This will be going live across all platforms at 10:00am BST.[\/p][p][\/p][h3][b]Full Changelog[\/b][\/h3][list][*][p]Improved lighting quality on the South Acton footbridge[\/p][\/*][*][p]Improved snow rendering issues at Gunnersbury, Kew Gardens, and Acton Central[\/p][\/*][*][p]Fixed clipping passenger information displays and floating station assets at Richmond[\/p][\/*][*][p]Added collision boundaries at Gunnersbury to prevent players from leaving the playable area[\/p][\/*][*][p]Resolved collision issues and station floor gaps at Willesden Junction[\/p][\/*][*][p]Fixed terrain geometry overlapping track sections at Willesden Junction[\/p][\/*][*][p]Corrected floating railings and restored missing parking garage support poles at Gunnersbury[\/p][\/*][*][p]Fixed signal placement and functionality issues on Richmond Bridge and the southbound exit from Gunnersbury[\/p][\/*][*][p]Corrected additional floating scenery assets across the route[\/p][\/*][*][p]Improved the quality and clarity of Class 378 cab textures[\/p][\/*][*][p]Fixed NPC passenger boarding behaviour on the Class 378[\/p][\/*][*][p]Added additional Scenario Designer pathing options[\/p][\/*][\/list][p][\/p][p]We're continuing to work on additional optimisations and reports of crashing\/blurred textures, which are being aimed at future updates. Please share your feedback in our community spaces in the meantime, thank you![\/p]","commentcount":8,"tags":["patchnotes","mod_reviewed","ModAct_773020726_1793270424_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451559041","event_gid":"712290761518875139","voteupcount":94,"votedowncount":5,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1793268000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568175573451559041","rtime32_last_modified":1793411006,"news_post_gid":"0","rtime_mod_reviewed":1793270424,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793266117,"votes_up":94,"votes_down":5,"comment_type":"ForumTopic","gidfeature":"591813764140102096","gidfeature2":"568175573451559041"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["693149828915402368","693149828915400987"],"last_update_event":{"rtime":1793268000,"event_gid":"712290761518875139","announcement_gid":"712290761518875140","clan_account_id":46276966}}};

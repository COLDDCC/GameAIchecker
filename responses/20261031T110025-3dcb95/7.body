																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"689772129194874466","clan_steamid":"103582791475418281","event_name":"\ud83c\udf83 Barfender Halloween Update: Dishwashers, Handcart & a Spooky Carnival!","event_type":14,"appid":4159680,"server_address":null,"server_password":null,"rtime32_start_time":1792783020,"rtime32_end_time":1792787401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Dishwashers, a Handcart, a Halloween carnival with a fortune teller, toy \\\"weapons\\\", hidden vinyls and new furniture!\",\"Sp\u00fclmaschinen, eine Sackkarre, ein Halloween-Jahrmarkt mit Wahrsagerin, Spielzeug-\u201eWaffen\u201c, versteckte Platten und mehr!\",\"Lave-vaisselle, diable de manutention, f\u00eate foraine d'Halloween avec voyante, \u00ab\u00a0armes\u00a0\u00bb jouets, vinyles cach\u00e9s et plus\u00a0!\",\"Lavastoviglie, carrello, un luna park di Halloween con cartomante, \\\"armi\\\" giocattolo, vinili nascosti e tanto altro!\",\"\uc2dd\uae30\uc138\ucc99\uae30, \uc190\uc218\ub808, \uc810\uc220\uac00\uac00 \uc788\ub294 \ud57c\ub7ec\uc708 \uce74\ub2c8\ubc1c, \uc7a5\ub09c\uac10 '\ubb34\uae30', \uc228\uaca8\uc9c4 \ub808\ucf54\ub4dc, \uc0c8 \uac00\uad6c\uae4c\uc9c0!\",\"Lavavajillas, carretilla, una feria de Halloween con pitonisa, \u00abarmas\u00bb de juguete, vinilos ocultos y muebles nuevos.\",\"\u6d17\u7897\u673a\u3001\u624b\u63a8\u8f66\u3001\u6709\u5360\u535c\u5e08\u5750\u9547\u7684\u4e07\u5723\u8282\u5609\u5e74\u534e\u3001\u73a9\u5177\u201c\u6b66\u5668\u201d\u3001\u9690\u85cf\u9ed1\u80f6\u5531\u7247\u3001\u65b0\u5bb6\u5177\u7b49\u4f60\u6765\u4f53\u9a8c\uff01\",\"\u6d17\u7897\u6a5f\u3001\u624b\u63a8\u8eca\u3001\u6709\u5360\u535c\u5e2b\u5750\u93ae\u7684\u842c\u8056\u7bc0\u5609\u5e74\u83ef\u3001\u73a9\u5177\u300c\u6b66\u5668\u300d\u3001\u96b1\u85cf\u9ed1\u81a0\u5531\u7247\u3001\u65b0\u5bb6\u5177\u7b49\u4f60\u4f86\u9ad4\u9a57\uff01\",\"\u041f\u043e\u0441\u0443\u0434\u043e\u043c\u043e\u0439\u043a\u0438, \u0442\u0435\u043b\u0435\u0436\u043a\u0430, \u0445\u0435\u043b\u043b\u043e\u0443\u0438\u043d\u0441\u043a\u0430\u044f \u044f\u0440\u043c\u0430\u0440\u043a\u0430 \u0441 \u0433\u0430\u0434\u0430\u043b\u043a\u043e\u0439, \u0438\u0433\u0440\u0443\u0448\u0435\u0447\u043d\u043e\u0435 \u00ab\u043e\u0440\u0443\u0436\u0438\u0435\u00bb, \u0441\u043f\u0440\u044f\u0442\u0430\u043d\u043d\u044b\u0435 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0438 \u0438 \u043d\u043e\u0432\u0430\u044f \u043c\u0435\u0431\u0435\u043b\u044c!\",null,\"\u98df\u6d17\u6a5f\u3001\u53f0\u8eca\u3001\u5360\u3044\u5e2b\u306e\u3044\u308b\u30cf\u30ed\u30a6\u30a3\u30f3\u30ab\u30fc\u30cb\u30d0\u30eb\u3001\u304a\u3082\u3061\u3083\u306e\u300c\u6b66\u5668\u300d\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b3\u30fc\u30c9\u3001\u65b0\u3057\u3044\u5bb6\u5177\u306a\u3069\u304c\u767b\u5834\uff01\",\"M\u00e1quinas de lavar loi\u00e7a, carrinho, feira de Halloween com cartomante, \u00abarmas\u00bb de brincar, vinis escondidos e mais!\",\"Zmywarki, w\u00f3zek, halloweenowe weso\u0142e miasteczko z wr\u00f3\u017ck\u0105, zabawkowa \u201ebro\u0144\u201d, ukryte winyle, nowe meble i wi\u0119cej!\",null,null,null,null,null,\"Mosogat\u00f3g\u00e9pek, k\u00e9zikocsi, halloweeni vid\u00e1mpark j\u00f3sn\u0151vel, j\u00e1t\u00e9k \u201efegyverek\u201d, elrejtett bakelitek, \u00faj b\u00fatorok \u00e9s m\u00e9g t\u00f6bb!\",null,null,\"Bula\u015f\u0131k makineleri, el arabas\u0131, falc\u0131l\u0131 Cad\u0131lar Bayram\u0131 lunapark\u0131, oyuncak silahlar, gizli plaklar ve yeni mobilyalar!\",\"Lava-lou\u00e7as, carrinho de carga, um parque de Halloween com cartomante, \\\"armas\\\" de brinquedo, vinis escondidos e mais!\",null,null,null,null,\"Lavaplatos, carrito de carga, feria de Halloween con adivina, \\\"armas\\\" de juguete, vinilos escondidos y muebles nuevos.\",null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"92059de6941ae3344a4c56b1a6294dfad3acbf44.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"9d37cd15f1bbb98009d3f979a633a26a395d6607.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"689772129194874467","clanid":"45896873","posterid":"0","headline":"\ud83c\udf83 Barfender Halloween Update: Dishwashers, Handcart & a Spooky Carnival!","posttime":1792783029,"updatetime":1792783029,"body":"[h1][i][b]Hello Everyone![\/b][\/i][\/h1][p]\nThe nights are getting darker, the pumpkins are out, and something strange has set up shop in the neighbourhood... \ud83c\udf83[\/p][p][\/p][p]Our [b]Halloween Update[\/b] is here! It isn't just a spooky makeover, though. It also brings two of your most requested features: the [b]Dishwasher[\/b] and the [b]Handcart[\/b]. On top of that, there's a whole Halloween carnival to explore, new furniture and a big round of fixes.[\/p][p]Let's take a look!\n[\/p][carousel][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/bc9e86d5b52a2a2705e62c6a438b2a626cf3fdb2.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/0c0a5b221f362dd51466cbcce6bf830a4d815d14.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/963bde1a6c94db538524a231fc52e0ee951d84e3.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/f99975bb9edf47ee42a52f38ea68a6cf5260a24a.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/fb96abceaa683d877260dfafb8be33ed0d3eb4a1.jpg\"][\/img][\/carousel][p][\/p][h2]\ud83c\udf7d\ufe0f Dishwashers Are Here![\/h2][p]You asked for it more than anything else, so we moved it up. No more spending half your shift at the sink![\/p][list][*][p][b]Load your dirty dishes into a dishwasher[\/b] one by one, or drop a whole tray in at once, then start it with a press.[\/p][\/*][*][p]Look at a running dishwasher to see its progress. When the cycle ends, the door pops open and your dishes are sparkling clean.[\/p][\/*][*][p][b]Your waiters use dishwashers too![\/b] They'll load an idle dishwasher before heading to the sink.[\/p][\/*][*][p][b]Four models to choose from:[\/b] the trusty [b]Old Dishwasher[\/b], the [b]Faster Dishwasher 3000[\/b], the [b]Bigger Dishwasher 3000[\/b] and the top-of-the-line [b]Dishwasher Ultra 7000[\/b]. Upgrade as your bar grows![\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/237121127097f1d056f2c0631e3a132bfb3c1568.gif\"][\/img][\/p][h2]\ud83d\uded2 The Handcart[\/h2][p]Moving stock one box at a time is over.[\/p][list][*][p][b]Every bar now has its own Handcart[\/b], waiting next to the backyard delivery zone. Existing saves get one too![\/p][\/*][*][p]Stack your delivery boxes onto the cart, then push the whole load inside in one trip.[\/p][\/*][*][p]Boxes are packed neatly onto the cart and stay put while you push it around.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/1e81e8c4e65b1a2a4fe7185c12630f887db5a924.gif\"][\/img][\/p][h2]\ud83d\udd2b You Asked for Weapons...[\/h2][p]Weapons have been one of your most requested features since launch. You asked, and we delivered: [b]weapons are finally in Barfender![\/b][\/p][p]...Toy ones. With foam darts. For shooting ducks. \ud83d\udc25[\/p][list][*][p]Grab the [b]toy gun[\/b] at the carnival's [b]Shoot the Duck[\/b] booth and show those ducks who runs this neighbourhood.[\/p][\/*][*][p]Pay the entry fee, hit as many ducks as you can before time runs out, and get paid for every hit. The more you hit, the more each one pays![\/p][\/*][*][p]Land a big enough score and you'll take home the exclusive [b]Dracula Duck[\/b]![\/p][\/*][\/list][p]Hussein and his brothers can relax... for now. \ud83d\ude0f[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/5877909648ed8bde8ca9fc1ac74aa1078cc37f2c.gif\"][\/img][\/p][h2]\ud83c\udf83 Halloween Has Arrived[\/h2][list][*][p][b]The neighbourhood is dressed for Halloween:[\/b] pumpkins, candles, cobwebs, spooky lights and decorations all around the streets, the bar and even the main menu.[\/p][\/*][*][p][b]Customers are in costume![\/b] Around 40% of your guests now show up wearing Halloween masks.[\/p][\/*][*][p]A new [b]Twerk[\/b] emote, because why not.[\/p][\/*][\/list][carousel][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/0c0a5b221f362dd51466cbcce6bf830a4d815d14.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/f99975bb9edf47ee42a52f38ea68a6cf5260a24a.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/963bde1a6c94db538524a231fc52e0ee951d84e3.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/fb96abceaa683d877260dfafb8be33ed0d3eb4a1.jpg\"][\/img][\/carousel][p][\/p][h2]\ud83c\udfa1 The Halloween Carnival[\/h2][p]A carnival has popped up in the neighbourhood, with games, prizes and one very mysterious lady.[\/p][list][*][p][b]\ud83d\udd2e Madame Zora, the Fortune Teller:[\/b] visit her and she'll read your bar's fortune. Whatever the cards say will come true, today or tomorrow. It might be a king's tip, a sudden crowd or a bar that cleans itself... or a power cut, an early visit from Hussein, or every guest getting sick on your floor. Sweet or bitter? Even she can't tell.[\/p][\/*][*][p][b]\ud83c\udf81 Mystery Box:[\/b] some fortunes leave a mystery box in your bar. Open it and you might find goodies to serve... or it might go [b]KABOOM[\/b].[\/p][\/*][*][p][b]\ud83e\udd86 Shoot the Duck:[\/b] put your brand-new \"weapon\" to the test (see above!).[\/p][\/*][*][p][b]\ud83c\udfb0 Lucky Spin:[\/b] spin the prize wheel for a chance at shop items, with a fresh prize lineup every day. Jackpot or bust?[\/p][\/*][*][p]Spooky carnival music and lively carnival crowds to set the mood.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/e20be63ff1b6d919600e3e6ed1a1cf4af7d16301.gif\"][\/img][\/p][h2]\ud83c\udfb5 Jukebox Vinyls[\/h2][list][*][p][b]Two new playlists, \"Halloween Pumpkin\" and \"Luxury Life\"[\/b], are waiting to be found... literally.[\/p][\/*][*][p]Their [b]vinyl records are hidden somewhere around the neighbourhood[\/b]. Find one to unlock its playlist on your jukebox for the whole bar.[\/p][\/*][*][p]Each playlist on the jukebox now has its own colour, and locked playlists hint that there's a vinyl out there to find.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/fb96abceaa683d877260dfafb8be33ed0d3eb4a1.jpg\"][\/img][\/p][h2]\ud83e\ude91 New Furniture & Better Storage[\/h2][list][*][p][b]5 new storage pieces:[\/b] Arched Cupboard, Steel Cupboard, Red Cupboard, Industrial Cupboard and the [b]Back Bar Cabinet[\/b], which has a countertop you can work on. The classic Cupboard also has a fresh new look.[\/p][\/*][*][p][b]New Bottle Holder and Long Bottle Holder[\/b] that snap onto your cocktail station. The cocktail station and its bottle holder are now separate pieces at the same total price, and existing stations are converted automatically.[\/p][\/*][*][p][b]Shelves, cupboards and the drinks cooler now store items in neat, aligned rows[\/b], with capacities that match their real size. The drinks cooler now opens with its lid.[\/p][\/*][*][p]When you take something from storage, you now get the item you put in most recently.[\/p][\/*][*][p]Dirty dishes can no longer be put into regular storage. The game now tells you to wash them first.[\/p][\/*][\/list][p][\/p][carousel][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/5f1ee376507635bce97155da22a54c776ed5e5a3.png\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/dec8313f44241adb0f4b5233964feb09ec62286e.png\"][\/img][\/carousel][h2]\ud83d\udcfa Twitch: New Poll Events[\/h2][p]Your chat has a lot more ways to mess with your night![\/p][list][*][p]New poll options include an early visit from [b]Hussein[\/b], a [b]thief[\/b] sneaking in, a [b]power cut[\/b], [b]everyone fainting[\/b], [b]bartenders getting drunk[\/b] and a [b]mystery gift[\/b].[\/p][\/*][*][p][b]Health Inspector:[\/b] if chat calls the inspector, you'll have a few seconds to clean up. A messy bar gets fined, and a spotless one earns a bonus![\/p][\/*][\/list][h2]\u2699\ufe0f More Improvements & Fixes[\/h2][list][*][p][b]Customers now tell you why they won't sit down:[\/b] no free tables, a dirty table, not enough chairs, or a bar that's too filthy to enter.[\/p][\/*][*][p]Characters' mouths now move while they talk in dialogues, and the dialogue screen has been improved.[\/p][\/*][*][p]Staff now have a proper wiping animation when they clean tables.[\/p][\/*][*][p][b]Multiplayer bandwidth reduced:[\/b] the game now sends a lot less data between players, which should help co-op on weaker connections.[\/p][\/*][*][p]Clearer message when joining a friend fails a version check. It now shows both game versions and where to find them.[\/p][\/*][*][p]Improved compatibility with older Steam clients.[\/p][\/*][*][p]Lower memory usage thanks to optimized textures.[\/p][\/*][*][p]Fixed the [b]Loss Leader[\/b] and [b]Highway Robbery[\/b] achievements. Highway Robbery now also counts Overpriced prices.[\/p][\/*][*][p]Fixed the menu price slider showing absurd numbers when dragged off-screen.[\/p][\/*][*][p]Pasting the same colour code again in the character creator now applies it.[\/p][\/*][*][p]Fixed customers taking odd routes from the back door, and several other pathing issues.[\/p][\/*][*][p]Fixed staff getting stuck trying to put away a tray they couldn't reach.[\/p][\/*][*][p]Fixed the drum kit's ride and crash cymbal sounds being swapped.[\/p][\/*][*][p]Lots of smaller fixes and polish.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/63d366cc577b100f43bf1cb18b70085c6db7c699.gif\"][\/img][\/p][p][\/p][h2]\ud83d\udcac You Asked, We Listened[\/h2][list][*][p][b]\"Please add a dishwasher!\"[\/b]: it's here, with four models, and your waiters use it too. Thanks to everyone in the Dishwasher thread. You're the reason we sped this one up![\/p][\/*][*][p][b]\"Moving boxes one by one takes forever\"[\/b]: meet the Handcart.[\/p][\/*][*][p][b]\"We need weapons!\"[\/b]: technically done. \ud83e\udd86[\/p][\/*][*][p][b]\"Loss Leader \/ Highway Robbery won't unlock\"[\/b]: both achievements are fixed. Special thanks to Lunar Jellyfish for helping us track this down![\/p][\/*][*][p][b]\"Co-op lags on my connection\"[\/b]: this update brings our first round of bandwidth reductions, and more are on the way.[\/p][\/*][\/list][h2]\ud83d\udd1c What We're Working On Next[\/h2][list][*][p][b]Cleaners[\/b] are still coming, so even fewer chores will land on you. [b]Bouncers[\/b] are also on our roadmap to help with all those fights, especially for solo players.[\/p][\/*][*][p]More multiplayer network optimizations.[\/p][\/*][*][p]An option to choose which side your fridge door opens on (yes, we heard you!).[\/p][\/*][*][p]Still in the works: furniture colours at Mikea, a bucket for puking customers and changing your bar's floor textures.[\/p][\/*][\/list][h2]\ud83d\udcac Keep the Feedback Coming![\/h2][p]Your feedback, suggestions and bug reports shape every update. We read every thread, review and Discord message.[\/p][p]If you run into a crash, please send us your [b]Player.log[\/b] through our [url=\"https:\/\/discord.gg\/hV2AFbZHVU\"]Discord[\/url] or at [b]support@protodivision.com[\/b].[\/p][p][\/p][p]Happy Halloween, and see you behind the bar! \ud83c\udf83\ud83c\udf78[\/p][p][b][i]Proto Division & Rock Paper Publisher[\/i][\/b][\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4159680\/Barfender_COOP_Bar_Simulator\/\"][\/dynamiclink][\/p]","commentcount":16,"tags":["workshop","mod_reviewed","ModAct_1447510170_1792783866_0"],"language":0,"hidden":0,"forum_topic_id":"564797239535771918","event_gid":"689772129194874466","voteupcount":96,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797239535771918","rtime32_last_modified":1793372920,"news_post_gid":"0","rtime_mod_reviewed":1792783867,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792766662,"votes_up":96,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"759555730939585685","gidfeature2":"564797239535771918"},{"gid":"689772129194868861","clan_steamid":"103582791475418281","event_name":"Barfender Update: Smarter Pathing, Chaos Balance & Cocktail Tweaks","event_type":13,"appid":4159680,"server_address":null,"server_password":null,"rtime32_start_time":1792598400,"rtime32_end_time":1792603801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Smoother pathing, gentler chaos scaling, shaker inspection, Twitch fixes and a first look at the Halloween update!\",\"Fl\u00fcssigere Wegfindung, sanfteres Chaos, Shaker-Inspektion, Twitch-Fixes und ein erster Blick aufs Halloween-Update!\",\"D\u00e9placements plus fluides, chaos mieux dos\u00e9, shaker inspectable, correctifs Twitch et un avant-go\u00fbt d'Halloween\u00a0!\",\"Percorsi pi\u00f9 fluidi, caos pi\u00f9 gestibile, ispezione dello shaker, fix per Twitch e un primo sguardo ad Halloween!\",\"\ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uc774\ub3d9 \uacbd\ub85c, \uc644\ud654\ub41c \ud63c\ub3c8, \uc170\uc774\ucee4 \ud655\uc778 \uae30\ub2a5, Twitch \uc218\uc815, \uadf8\ub9ac\uace0 \ud57c\ub7ec\uc708 \uc5c5\ub370\uc774\ud2b8 \ubbf8\ub9ac \ubcf4\uae30!\",\"Rutas m\u00e1s fluidas, caos m\u00e1s suave, inspecci\u00f3n de la coctelera, arreglos de Twitch y un primer vistazo a Halloween.\",\"\u66f4\u987a\u7545\u7684\u5bfb\u8def\u3001\u66f4\u5e73\u7f13\u7684\u6df7\u4e71\u5ea6\u3001\u53ef\u67e5\u770b\u6447\u9152\u58f6\u3001Twitch \u4fee\u590d\uff0c\u4ee5\u53ca\u4e07\u5723\u8282\u66f4\u65b0\u9884\u544a\uff01\",\"\u66f4\u9806\u66a2\u7684\u5c0b\u8def\u3001\u66f4\u5e73\u7de9\u7684\u6df7\u4e82\u5ea6\u3001\u53ef\u67e5\u770b\u6416\u9152\u5668\u3001Twitch \u4fee\u6b63\uff0c\u4ee5\u53ca\u842c\u8056\u7bc0\u66f4\u65b0\u9810\u544a\uff01\",\"\u041f\u043b\u0430\u0432\u043d\u044b\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b, \u043c\u044f\u0433\u043a\u0438\u0439 \u0440\u043e\u0441\u0442 \u0445\u0430\u043e\u0441\u0430, \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0448\u0435\u0439\u043a\u0435\u0440\u0430, \u043f\u0440\u0430\u0432\u043a\u0438 Twitch \u0438 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u0445\u0435\u043b\u043b\u043e\u0443\u0438\u043d\u0441\u043a\u043e\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435!\",null,\"\u79fb\u52d5\u30eb\u30fc\u30c8\u306e\u6539\u5584\u3001\u30ab\u30aa\u30b9\u306e\u7de9\u548c\u3001\u30b7\u30a7\u30fc\u30ab\u30fc\u306e\u78ba\u8a8d\u6a5f\u80fd\u3001Twitch\u4fee\u6b63\u3001\u305d\u3057\u3066\u30cf\u30ed\u30a6\u30a3\u30f3\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u306e\u4e88\u544a\uff01\",\"Percursos mais fluidos, caos mais suave, inspe\u00e7\u00e3o da coqueteleira, corre\u00e7\u00f5es da Twitch e uma antevis\u00e3o do Halloween!\",\"P\u0142ynniejsze \u015bcie\u017cki, \u0142agodniejszy chaos, podgl\u0105d shakera, poprawki Twitcha i pierwsze spojrzenie na Halloween!\",null,null,null,null,null,\"Sim\u00e1bb \u00fatvonalak, szel\u00eddebb k\u00e1osz, belen\u00e9zhet\u0151 shaker, Twitch-jav\u00edt\u00e1sok \u00e9s egy kis \u00edzel\u00edt\u0151 a halloweeni friss\u00edt\u00e9sb\u0151l!\",null,null,\"Daha ak\u0131c\u0131 rotalar, yumu\u015fak kaos, shaker'\u0131 inceleme, Twitch d\u00fczeltmeleri ve Cad\u0131lar Bayram\u0131 g\u00fcncellemesine ilk bak\u0131\u015f!\",\"Rotas mais suaves, caos mais equilibrado, inspe\u00e7\u00e3o da coqueteleira, corre\u00e7\u00f5es na Twitch e uma pr\u00e9via do Halloween!\",null,null,null,null,\"Rutas m\u00e1s fluidas, caos m\u00e1s suave, revisi\u00f3n de la coctelera, arreglos de Twitch y un primer vistazo a Halloween.\",null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"a555aee194592f8e4f32947f4502b507a321b983.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e6bd5858e31283ee48284d5a4e4716a48877bc1a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"689772129194868862","clanid":"45896873","posterid":"0","headline":"Barfender Update: Smarter Pathing, Chaos Balance & Cocktail Tweaks","posttime":1792570948,"updatetime":1792570948,"body":"[h1][i][b]Hey everyone![\/b][\/i][\/h1][p][\/p][p]Another update is here! We've been listening closely to your feedback since launch, and this update addresses some of the most common issues you've brought to our attention.[\/p][p][\/p][h2]\ud83d\udeb6 [b]Staff & Customer Pathing[\/b][\/h2][p]We've made several improvements to how customers and staff move around your bar![\/p][list][*][p][b]Chairs now stay in place when NPCs walk past them![\/b] Don't worry, you can still hit them with thrown chairs![\/p][\/*][*][p][b]Reworked bar navigation[\/b] for smoother, more natural routes.[\/p][\/*][*][p]Waiters now take more direct routes instead of making unnecessary trips around the building.[\/p][\/*][*][p]Waiters now choose garbage cans with available space. If all cans are full, they'll leave the trash next to the nearest can.[\/p][\/*][*][p]Fixed an issue where assigning tables to staff only worked while the player was moving.[\/p][\/*][*][p]Fixed customers occasionally getting stuck outside shops when leaving.[\/p][p][\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/558a83c39de78e1e6ef73a539895ef080728989a.gif\"][\/img][\/p][p][\/p][h2]\u2696\ufe0f [b]Chaos & Balance[\/b][\/h2][p]We love the chaos in Barfender, but we also want it to feel manageable, especially for solo players![\/p][list][*][p][b]Chaos now scales much more gently with your star rating.[\/b] Bigger crowds still bring more action, but fights and other chaotic events won't increase as aggressively.[\/p][\/*][*][p]Menu prices now adjust in clean, consistent steps, with more reliable price controls.[\/p][\/*][*][p]Improved how customers judge whether drink prices are cheap, fair, or expensive.[\/p][\/*][*][p]Recommended drink prices now vary more between days, without exceeding twice the base cost.[\/p][\/*][\/list][p][\/p][h2]\ud83c\udf78 [b]Cocktails & Sink Improvements[\/b][\/h2][list][*][p][b]You can now inspect your cocktail shaker![\/b] See its ingredients and remaining capacity. After shaking, you'll also see the prepared cocktail and remaining servings.[\/p][\/*][*][p]New cocktail recipes are now discovered as soon as you shake the correct mix.[\/p][\/*][*][p][b]Clearer sink feedback![\/b] The game now lets you know when the clean side is full, so you'll know exactly when it's time to make some space.[\/p][\/*][*][p]Fixed an issue where dishes could get stuck in the sink. Dishes affected in older saves can now be moved with a click.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/25859cb5601fbceaab3a22c2da7a06f5641ec3d6.gif\"][\/img][\/p][p][\/p][h2]\ud83d\udcfa [b]Twitch Integration Improvements[\/b][\/h2][p]We've made Streamer Mode more reliable and responsive![\/p][list][*][p][b]Viewer chaos commands now queue properly![\/b] Commands like [b]!puke[\/b], [b]!cry[\/b], [b]!dance[\/b], [b]!throw[\/b], [b]!faint[\/b] and [b]!choke[\/b] now activate once the viewer's customer is seated.[\/p][\/*][*][p]Viewer characters now explain why a chaos command can't be performed, making it easier to understand what's happening.[\/p][\/*][*][p]Viewer chaos commands now work independently of the night's regular chaos limit.[\/p][\/*][*][p]Viewers can now join as customers from the moment the bar opens.[\/p][\/*][*][p]Improved viewer joining reliability when the frequency is set to every group.[\/p][\/*][*][p][b]Poll results now appear on screen[\/b], so you won't miss the winning choice while managing your bar![\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/f7b7cb662fac0cea3852c76b61a8a48dfe39e1f5.png\"][\/img][\/p][h2]\u2699\ufe0f [b]Quality of Life & Bug Fixes[\/b][\/h2][list][*][p]Added clearer Steam connection error messages with troubleshooting instructions.[\/p][\/*][*][p]Improved interaction outline rendering across different Render Scale settings.[\/p][\/*][*][p]Fixed occasional UI text flickering.[\/p][\/*][*][p]Reduced on-screen notification clutter.[\/p][\/*][*][p]Improved input handling when closing the end-of-day report and faint screen to prevent accidental interactions.[\/p][\/*][*][p]Additional performance improvements, decoration fixes, and smaller bug fixes.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45896873\/41317eb9ebb0e1cad48ec3ae671c51e4e58b9143.png\"][\/img][\/p][h2]\ud83d\udcac [b]You Asked, We Listened![\/b][\/h2][p]A lot of these improvements came directly from your feedback![\/p][list][*][p][b]\"NPCs keep knocking my chairs over!\"[\/b] Chairs now stay in place when customers and staff walk past them.[\/p][\/*][*][p][b]\"My waiters walk around the whole building!\"[\/b] Navigation has been reworked for more direct routes.[\/p][\/*][*][p][b]\"Busy nights are overwhelming when playing solo!\"[\/b] Chaos now scales more gently with your star rating.[\/p][\/*][*][p][b]\"I can't tell what's in my shaker!\"[\/b] You can now inspect its contents and see the prepared cocktail.[\/p][\/*][\/list][p][\/p][h2]\ud83c\udf83 [b]Coming Next: Halloween Update![\/b][\/h2][p]Things are about to get spooky behind the bar! Our next update will bring a special [b]Halloween event[\/b] with some exciting new features and surprises themed around the occasion! \n\nAnd that's not all! We're also adding a [b]dishwasher[\/b] as a permanent addition to Barfender, so you can spend less time washing dishes and more time running your bar.[\/p][p]Stay tuned for more details![\/p][p][\/p][h2]\u2764\ufe0f [b]Thank You![\/b][\/h2][p]Your feedback genuinely shapes every update. Keep sharing your suggestions, bug reports, and ideas! Thanks for supporting Barfender through Early Access![\/p][p][\/p][p]See you behind the bar! \ud83c\udf78[\/p][p][i][b]Proto Division & Rock Paper Publisher[\/b][\/i][\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4159680\/Barfender_COOP_Bar_Simulator\/\"][\/dynamiclink][\/p]","commentcount":5,"tags":["workshop","mod_reviewed","ModAct_1415716708_1792572073_0"],"language":0,"hidden":0,"forum_topic_id":"564797239535393207","event_gid":"689772129194868861","voteupcount":63,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797239535393207","rtime32_last_modified":1793177767,"news_post_gid":"0","rtime_mod_reviewed":1792572074,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792569715,"votes_up":63,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"759555730939585685","gidfeature2":"564797239535393207"},{"gid":"689772129194875932","clan_steamid":"103582791475418281","event_name":"Barfender Patch 0.16.5: Pathfinding & Bug Fixes!","event_type":12,"appid":4159680,"server_address":null,"server_password":null,"rtime32_start_time":1793109600,"rtime32_end_time":1793115001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Smarter pathfinding, a chicken coop jail for your co-op friends, a new game rule, shop and dishwasher fixes, and more!\",\"Kl\u00fcgere Wegfindung, ein H\u00fchnerstall-Knast f\u00fcr eure Koop-Freunde, eine neue Spielregel, Shop- und Sp\u00fclmaschinen-Fixes!\",\"D\u00e9placements plus malins, une prison \u00e0 poules pour vos amis en coop, une nouvelle r\u00e8gle de jeu et des correctifs !\",\"Percorsi pi\u00f9 intelligenti, un pollaio-prigione per gli amici in co-op, una nuova regola di gioco e tante correzioni!\",\"\ub354 \ub611\ub611\ud574\uc9c4 \uc774\ub3d9 \uacbd\ub85c, \ud611\ub3d9 \uce5c\uad6c\ub97c \ub2ed\uc7a5\uc5d0 \uac00\ub450\ub294 \uae30\ub2a5, \uc0c8 \uac8c\uc784 \uaddc\uce59, \uc0c1\uc810 \ubc0f \uc2dd\uae30\uc138\ucc99\uae30 \uc218\uc815 \ub4f1!\",\"Rutas m\u00e1s inteligentes, un gallinero-c\u00e1rcel para vuestros amigos del cooperativo, una nueva regla y m\u00e1s arreglos.\",\"\u66f4\u806a\u660e\u7684\u5bfb\u8def\u3001\u628a\u5408\u4f5c\u961f\u53cb\u5173\u8fdb\u9e21\u820d\u3001\u65b0\u6e38\u620f\u89c4\u5219\u3001\u5546\u5e97\u4e0e\u6d17\u7897\u673a\u4fee\u590d\u7b49\uff01\",\"\u66f4\u8070\u660e\u7684\u5c0b\u8def\u3001\u628a\u5408\u4f5c\u968a\u53cb\u95dc\u9032\u96de\u820d\u3001\u65b0\u904a\u6232\u898f\u5247\u3001\u5546\u5e97\u8207\u6d17\u7897\u6a5f\u4fee\u6b63\u7b49\uff01\",\"\u0423\u043c\u043d\u043e\u0435 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435, \u043a\u0443\u0440\u044f\u0442\u043d\u0438\u043a-\u0442\u044e\u0440\u044c\u043c\u0430 \u0434\u043b\u044f \u0434\u0440\u0443\u0437\u0435\u0439 \u043f\u043e \u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u0443, \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0438\u0433\u0440\u044b, \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438 \u043f\u043e\u0441\u0443\u0434\u043e\u043c\u043e\u0435\u043a!\",null,\"\u79fb\u52d5\u30eb\u30fc\u30c8\u306e\u6539\u5584\u3001\u5354\u529b\u30d7\u30ec\u30a4\u4ef2\u9593\u3092\u9d8f\u5c0f\u5c4b\u306b\u9589\u3058\u8fbc\u3081\u308b\u65b0\u6a5f\u80fd\u3001\u65b0\u3057\u3044\u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\u3001\u30b7\u30e7\u30c3\u30d7\u3068\u98df\u6d17\u6a5f\u306e\u4fee\u6b63\u306a\u3069\uff01\",\"Percursos mais inteligentes, uma pris\u00e3o-galinheiro para os amigos do cooperativo, nova regra de jogo, corre\u00e7\u00f5es e mais!\",\"M\u0105drzejsze \u015bcie\u017cki, kurnik-wi\u0119zienie dla znajomych z co-opa, nowa zasada gry, poprawki sklepu i zmywarek i nie tylko!\",null,null,null,null,null,\"Okosabb \u00fatvonalak, ty\u00fak\u00f3lb\u00f6rt\u00f6n a co-op t\u00e1rsaknak, \u00faj j\u00e1t\u00e9kszab\u00e1ly, bolt- \u00e9s mosogat\u00f3g\u00e9p-jav\u00edt\u00e1sok \u00e9s m\u00e9g t\u00f6bb!\",null,null,\"Daha ak\u0131ll\u0131 yol bulma, co-op arkada\u015flar\u0131n\u0131za k\u00fcmes hapsi, yeni oyun kural\u0131, ma\u011faza ve bula\u015f\u0131k makinesi d\u00fczeltmeleri!\",\"Rotas mais inteligentes, uma pris\u00e3o no galinheiro para os amigos do co-op, nova regra de jogo, corre\u00e7\u00f5es e mais!\",null,null,null,null,\"Rutas m\u00e1s inteligentes, un gallinero-c\u00e1rcel para sus amigos del cooperativo, una nueva regla de juego, arreglos y m\u00e1s.\",null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"2e59b1aed55e410e28d438829bf79ff9dcbb734b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"449d9968eae2ba70be838b5a1edec71b97216785.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"689772129194875933","clanid":"45896873","posterid":"0","headline":"Barfender Patch 0.16.5: Pathfinding & Bug Fixes!","posttime":1793108797,"updatetime":1793108797,"body":"[h1][i][b]Hello everyone![\/b][\/i][\/h1][p][\/p][p]Thank you for all the love you've shown the Halloween Update! \ud83c\udf83 This patch focuses on one thing you've reported a lot: [b]customers and staff taking strange routes around the bar[\/b]. There are also a few other fixes and a couple of fun additions.[\/p][p][\/p][p][\/p][h2]\ud83d\udeb6 Pathfinding Improvements[\/h2][list][*][p][b]Customers and staff now stay inside the bar[\/b] when walking between the bar room and the garden, instead of heading out onto the street and walking around the building.[\/p][\/*][*][p]If the front door gets blocked by furniture, customers now use another entrance instead of standing still until they give up.[\/p][\/*][*][p]A handcart or crate parked in the side alley no longer sends people cutting through the kitchen.[\/p][\/*][*][p]Fixed waiters getting stuck in a loop of grabbing their tray and putting it back down.[\/p][\/*][*][p]Staff no longer try to use sinks, dishwashers or garbage cans that you've packed into a box.[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udc14 New: Jail Your Friends![\/h2][p]Someone in your co-op crew causing trouble? Vote to [b]lock them in the chicken coop[\/b] from the pause menu! When everyone else agrees, they get a little time-out with the chickens. You can also pardon them... if you're feeling generous.[\/p][p]\n[\/p][h2]\ud83d\udd27 More Fixes & Improvements[\/h2][list][*][p]New game rule: [b]Dancing customers[\/b]. Turn it off if you'd rather keep the dance floor empty.[\/p][\/*][*][p]Mikea's shop categories are now grouped into expandable Furniture and Decorations sections, with a new Dishwashing category.[\/p][\/*][*][p][b]Controller \/ Steam Deck:[\/b] shop lists now scroll properly with the gamepad instead of stopping partway down.[\/p][\/*][*][p]Dishwasher fixes: staff now fill the emptier rack first, and NPCs no longer close the door while you're unloading it.[\/p][\/*][*][p]Boxed chairs and counters no longer keep their old spots at tables, and drunk customers can no longer grab boxed chairs to throw.[\/p][\/*][*][p]Clearer customer complaints about a dirty bar, and more natural reactions when you hit someone.[\/p][\/*][*][p]Empty refill bags can no longer restock a dispenser.[\/p][\/*][*][p]The Popcorn Machine now shows how much popcorn is left.[\/p][\/*][*][p]Fixed the [b]Patient Zero[\/b] achievement not tracking progress properly in dirty bars.[\/p][\/*][*][p]Fixed the camera while ragdolling, plus other smaller fixes.[\/p][\/*][\/list][p]\n[\/p][h2]\ud83d\udc65 Coming Next: A Bigger Crew![\/h2][p]Many of you told us that your bar grows faster than your team. In the next update, [b]you'll be able to hire more staff[\/b] as your star rating goes up. More hands behind the bar, less running around for you![\/p][p] [\/p][p]As always, thanks for the reports! If you run into a crash, please send us your [b]Player.log[\/b] through our [url=\"https:\/\/discord.gg\/hV2AFbZHVU\"]Discord[\/url] or at [b]support@protodivision.com[\/b].[\/p][p][\/p][p]See you behind the bar! \ud83c\udf78[\/p][p][\/p][p][i][b]Proto Division & Rock Paper Publisher[\/b][\/i][\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4159680\/Barfender_COOP_Bar_Simulator\/\"][\/dynamiclink][\/p]","commentcount":7,"tags":["patchnotes","workshop","mod_reviewed","ModAct_1894626024_1793109961_0"],"language":0,"hidden":0,"forum_topic_id":"564797531878879562","event_gid":"689772129194875932","voteupcount":42,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797531878879562","rtime32_last_modified":1793403299,"news_post_gid":"0","rtime_mod_reviewed":1793109962,"featured_app_tagid":0,"referenced_appids":[],"build_id":26239824,"build_branch":"","unlisted":0,"rtime_created":1793101616,"votes_up":42,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"759555730939585685","gidfeature2":"564797531878879562"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["689772129194874467","689772129194868862"],"last_update_event":{"rtime":1793109600,"event_gid":"689772129194875932","announcement_gid":"689772129194875933","clan_account_id":45896873}}};
						</script>
					


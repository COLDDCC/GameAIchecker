				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>Roadmap</h2>				<p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4159680/extras/0954d528c3b792251abe8a1464ba9ac7.avif?t=1792782343" width=1080 height=1350 /></span></p></p>

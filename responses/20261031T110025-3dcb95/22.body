null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"669502126020362338","clanid":"45557445","posterid":"0","headline":"Race in Style now with New Liveries!","posttime":1788969838,"updatetime":1788969838,"body":"[p][\/p][p][b]Owners can jump in-game now to claim 3 liveries for free![\/b]* [\/p][p][\/p][p]Customise your F1 car and hit the track in style.\n[\/p][p][\/p][p]Save up to 30%* on the F1 25: 2026 Season Edition til Sept. 14!\n[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3059520\/F1_25\/\"][\/dynamiclink]\n\n[\/p][p][\/p][p]*Claim via in-game mail by October 14. Not available in F1 25 base game. Requires F1 25: 2026 Season Edition or 2026 Season Pack (sold separately), F1 25 (sold separately), & all game updates.[\/p]","commentcount":12,"tags":["mod_reviewed","ModAct_1894963720_1788971473_0"],"language":0,"hidden":0,"forum_topic_id":"568171134404585814","event_gid":"669502126020362337","voteupcount":662,"votedowncount":66,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"568171134404585814","rtime32_last_modified":1793305479,"news_post_gid":"0","rtime_mod_reviewed":1788971473,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788959072,"votes_up":662,"votes_down":66,"comment_type":"ForumTopic","gidfeature":"604151733808043768","gidfeature2":"568171134404585814"},{"gid":"667249691758430283","clan_steamid":"103582791475078853","event_name":"THE F1\u00ae 2026 SEASON GETS EVEN BIGGER WITH THE SEPTEMBER UPDATE (PATCH v1.25)","event_type":13,"appid":3059520,"server_address":null,"server_password":null,"rtime32_start_time":1788795360,"rtime32_end_time":1788800401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"This September content update brings the F2\u2122 2026 season to the game, the Ferrari \u201cMacarena\u201d Wing and more...\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"4d7753dae1042b53a99a47444efa429152ce1fe9.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"667249691758430284","clanid":"45557445","posterid":"0","headline":"THE F1\u00ae 2026 SEASON GETS EVEN BIGGER WITH THE SEPTEMBER UPDATE (PATCH v1.25)","posttime":1788795415,"updatetime":1788795415,"body":"[h2][b]F2\u2122 ARRIVES IN THE 2026 SEASON[\/b][\/h2][p align=\"start\"]The next generation of racing talent takes centre stage as the longed-for 2026 F2\u2122 season arrives for F1\u00ae 25: 2026 Season Edition and F1\u00ae 25: 2026 Season Pack owners, complete with the latest drivers, teams, cars, and race calendar.[\/p][p align=\"start\"]With four rounds remaining and the fight at the top of the real-world standings still wide open, the Championship is far from decided. Head into Grand Prix mode, take control of a title contender, and see whether you can change their fate before the final checkered flag falls. Or, take the F2\u2122 cars for a spin on the MADRING circuit, a hybrid street and purpose-built track that will challenge you in high-speed action.\u00a0[\/p][p align=\"start\"]You can also hit the track in Time Trial, Multiplayer, split-screen, and LAN, or explore the 2026 cars in Showroom.\n\n[b]NEW CONTENT: SPORTS UPDATE[\/b][\/p][p align=\"start\"]The Formula 1\u00ae grid never stands still. The September Sports Update brings eight teams closer to their latest real-world counterparts, headlined by the arrival of Ferrari\u2019s distinctive \u201cMacarena\u201d rear wing.[\/p][p align=\"start\"]But that\u2019s not all. Teams have updated their liveries and brought in new sponsors throughout the season, and we have brought this to life in-game. These changes will be applied to the relevant 2026 cars once you install the September update.\n\n[b]SEVEN NEW SPECIAL LIVERIES[\/b][\/p][p align=\"start\"]On top of all this, seven special liveries will arrive across three September drops. Here is the full list of updates:[\/p][h3][b]AVAILABLE SEP 9-OCT 14[\/b][\/h3][list][*][p]Racing Bulls \u2013 Suzuka[\/p][\/*][*][p]Audi \u2013 Monaco[\/p][\/*][*][p]Cadillac \u2013 Silverstone[\/p][\/*][\/list][h3][b]AVAILABLE SEP 11-OCT 14[\/b][\/h3][list][*][p]Cadillac \u2013 Miami[\/p][\/*][*][p]McLaren \u2013 Monaco[\/p][\/*][\/list][h3][b]AVAILABLE SEP 16-OCT 14[\/b][\/h3][list][*][p]Aston Martin \u2013 Monaco[\/p][\/*][*][p]Racing Bulls \u2013 Miami[\/p][\/*][\/list][p align=\"start\"]These liveries will be available for free to everyone who owns the 2026 Season Pack or Edition and can be claimed through the in-game mailbox.\n\n[b]v1.25 Patch Notes[\/b][\/p][h2][b]Highlights[\/b][\/h2][list][*][p]Addition of the 2026 F2\u2122 Championship in game, including all cars and drivers.[\/p][\/*][*][p]Sports Update for F1 cars and drivers: Visual updates and sponsor changes in the 2026 Formula 1\u00ae season have been included.[\/p][\/*][*][p]Added a number of Special Edition Liveries for 2026 F1 cars. Keep your eyes on the News over the next month and collect them from your Mail in the game![\/p][\/*][*][p]Updated a number of Team Principals in various locations in the game.[\/p][\/*][*][p]To better reflect the 2026 regulations, Boost Mode with limited deploy power is now available in wet conditions.[\/p][\/*][*][p]To better reflect the regulations, Straight Mode and DRS will now only remain active when the driver's throttle input is above 90%.[\/p][\/*][*][p]An \"Overtake Enabled\" Race Control message will now show at the correct times during race using 2026 F1 cars. This has also been added to the UDP output.[\/p][\/*][\/list][h2][b]Cars & Tracks[\/b][\/h2][list][*][p]Fixed an issue on certain Sponsor Liveries where the driver number was overlapping a sponsor logo.[\/p][\/*][*][p]Updated the Rev light pattern on Franco Colapinto's steering wheel.[\/p][\/*][*][p]Raised the position of the 2026 Red Bull steering wheel to match the real car.[\/p][\/*][*][p]The Front Suspension on the 2026 Aston Martin and Haas cars now appear correctly attached to the wheel.[\/p][\/*][*][p]Corrected some of the trackside barriers at Australia, which had previously been on loan from Austria.[\/p][\/*][\/list][h2][b]Career[\/b][\/h2][list][*][p]Updated the tyre allocation for several 2026 F1 Race Weekends.[\/p][\/*][*][p]Fixed an issue where the amount of available Pitcoin was not shown when accessing the Store within Career mode.[\/p][\/*][*][p]Fixed an issue on the Driver Career Team Select screen, so the Recognition Values shown will now always be correct.[\/p][\/*][*][p]In Driver Career mode, completing an F2 season will now give you bonus Recognition when you start your first season in F1.[\/p][\/*][*][p]Fixed an issue which was preventing Accolades from being shown correctly when starting a Driver Career with an Official F2 driver.[\/p][\/*][\/list][h2][b]Wheels & Controllers[\/b][\/h2][list][*][p]Slight adjustment for Wheel users, ensuring a better match of control inputs to physics output during rapid input range changes.[\/p][\/*][*][p]Fixed a stability issue which could affect users with both Moza and Simucube peripherals.[\/p][\/*][*][p]Fixed an issue affecting certain hardware where Force Feedback calls could prevent players from achieving higher frame rates.[\/p][\/*][*][p]Improved control schemes for existing Simagic hardware.[\/p][\/*][*][p]Additional support for Simagic P500 & P700 Pedals, Neo X Hub, Zeus Formula, GT and Sport Steering Wheels..[\/p][\/*][\/list][h2][b]Misc[\/b][\/h2][list][*][p]Various UI and Stability Improvements.[\/p][\/*][\/list]","commentcount":52,"tags":["mod_reviewed","ModAct_1691520782_1788797354_0"],"language":0,"hidden":0,"forum_topic_id":"583933421007620519","event_gid":"667249691758430283","voteupcount":603,"votedowncount":58,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"583933421007620519","rtime32_last_modified":1793241606,"news_post_gid":"0","rtime_mod_reviewed":1788797355,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1788795280,"votes_up":603,"votes_down":58,"comment_type":"ForumTopic","gidfeature":"604151733808043768","gidfeature2":"583933421007620519"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["690894858003416136","669502126020362338"],"last_update_event":{"rtime":1788795360,"event_gid":"667249691758430283","announcement_gid":"667249691758430284","clan_account_id":45557445}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>F1® 25: 2026 Season Edition</h2>				<p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3059520/extras/ba30b35c0c6dcdbae36cc4d0b508af26.avif?t=1786646076" width=1080 height=1350 /></span></p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3059520/extras/ecf7785f76aeae5a926b02e760c6c4a3.avif?t=1786646076" width=1080 height=1350 /></span></p><br>Buy the 2026 Season Edition to receive:<br><ul class="bb_ul"><li>F1® 25<br></li><li>F1® 25: 2026 Season Pack</li></ul><br>Rewrite The Grid with the ultimate evolution in racing: EA SPORTS™ F1® 25: 2026 Season Edition. Get F1® 25 and the 2026 Season Pack in one bundle for the most complete Formula One® experience. Race through the action-packed 2025 season, then step into a new era with the ground breaking 2026 cars, the next generation of Grand Prix™ racing.</p>
			</div>
						<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>F1® 25: 2026 Season Pack, Available Now!</h2>				<p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3059520/extras/ecf7785f76aeae5a926b02e760c6c4a3.avif?t=1786646076" width=1080 height=1350 /></span></p><br>Rewrite the grid with the 2026 Season Pack for EA SPORTS™ F1® 25, the official video game of the 2026 FIA Formula One World Championship™. Audi, following its takeover of Sauber, and Cadillac, the first major American manufacturer in Formula One, join the grid to begin a new chapter in F1's history. Driver line-ups have shifted across the field, with rookie Arvid Lindblad racing alongside Liam Lawson at Racing Bulls, Isack Hadjar joining Oracle Red Bull Racing to partner Max Verstappen, and fan favourites Valtteri Bottas and Sergio Pérez leading Cadillac's debut entry.<br><br>For the first time since 2023, a new circuit joins the calendar: MADRING. Set in Madrid, this hybrid street and purpose-built track delivers high-speed action across 5.4 km and 22 adrenaline-filled corners. To master it, step into the cockpit of next-generation cars shaped by the biggest regulatory overhaul in F1 history. These new machines are lighter and more responsive, whether you're using a gamepad or a wheel. With cutting-edge active aerodynamics and the introduction of Overtake Mode, you'll have greater control as you go wheel-to-wheel in the new era of Formula One.</p>
			</div>
			</div>				<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							Rewrite The Grid with the ultimate evolution in racing: EA SPORTS™ F1® 25: 2026 Season Edition. Get F1® 25 and the 2026 Season Pack in one bundle for the most complete Formula One® experience. Race through the action-packed 2025 season, then step into a new era with the groundbreaking 2026 cars, the next generation of Grand Prix™ racing.<br><br><ul class="bb_ul"><li><strong>All New Teams:</strong> Two new teams join the 2026 grid; Audi, taking over Sauber, and Cadillac, marking the arrival of the first major American car manufacturer in Formula 1.<br><br></li><li><strong>New Driver Lineups:</strong> Race against the latest driver lineups. Racing Bulls welcomes Arvid Lindblad alongside Liam Lawson, Isack Hadjar joins Max Verstappen at Oracle Red Bull Racing, and fan favorites Valtteri Bottas and Sergio Pérez headline Cadillac’s entry.<br><br></li><li><strong>New Track:</strong> Get ready to race at MADRING†, the first new F1® circuit since 2023. Set in Madrid, this hybrid street and purpose-built track will challenge you in high-speed action across 5.4 km and 22 adrenaline-filled corners.<br><br></li><li><strong>New Cars and Regulations††:</strong> Feel the thrill of the 2026 F1® grid and get behind the wheel of lighter, smaller cars with cutting-edge active aerodynamics for a more responsive drive, whether you're using a gamepad or a wheel. These next-gen cars, enhanced by F1® 25's improved physics, offer exhilarating racing for both seasoned pros and newcomers ready to conquer the new F1® era.</li></ul><br>Leave your mark on the world of racing in F1® 25, the official video game of the 2025 FIA Formula One World Championship™<br><br><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3059520/extras/d3e1e71e4d7024f99c7c5a430a68dd7b.avif?t=1786646076" width=610 height=3037 /></span></p><ul class="bb_ul"><li><strong>Konnersport's Legacy:</strong> For the first time ever, extend your Konnersport experience in Career &amp; My Team Modes<br><br></li><li><strong>Design your own Team:</strong> Enhance both My Team and F1® World cars and create liveries that are more reflective of Formula One® as you customize driver numbers and move, scale, or rotate logos<br><br></li><li><strong>Accurate LIDAR Circuits:</strong> Experience 5 rebuilt tracks, including fan-favorite Suzuka with laser-scanned models of the real venues<br><br></li><li><strong>New Online Co-op Events:</strong> Brand new multiplayer mode in F1® World, where you and your friends race as a squad against AI drivers<br><br></li><li><strong>And more:</strong> New cinematics, updated podium scenes, and Reverse Tracks on select circuits</li></ul><br>This game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items.<br><br>Custom teams and career saves from the 2025 season do not transfer to 2026 season. Konnersport or APXGP teams cannot be added to the 2026 season of Driver Career or My Team.<br><br>†MADRING circuit can only be driven with 2026 cars.<br>††Some final car models will release in a post-launch update; internet connection required.						</div>
					</div>
					<div class="game_page_autocollapse">
		<div id="game_area_content_descriptors" class="game_area_description">
			<h2>AI Generated Content Disclosure</h2>
			<p>The developers describe how their game uses AI Generated Content like this:</p>
			<p><i>

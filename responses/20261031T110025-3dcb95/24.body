,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"702157028173288291","clanid":"46224406","posterid":"0","headline":"NBA is Back!!","posttime":1792767657,"updatetime":1792767657,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/4745ac36b6313978fd675b11cb721226ed60673f.jpg\"][\/img][\/p][p][\/p][p]The NBA season is in full effect, and the stars are out in MyTEAM! Greatness Series: NBA is Back Packs, Exchanges, and Challenges are LIVE. Add top NBA talent in the all-new Magma Tier and go be great![\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_783923276_1792782619_0"],"language":0,"hidden":0,"forum_topic_id":"570426739071886520","event_gid":"702157028173288290","voteupcount":119,"votedowncount":17,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792767600,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426739071886520","rtime32_last_modified":1793406845,"news_post_gid":"0","rtime_mod_reviewed":1792782619,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792704014,"votes_up":119,"votes_down":17,"comment_type":"ForumTopic","gidfeature":"594062392368870295","gidfeature2":"570426739071886520"},{"gid":"707785259656154563","clan_steamid":"103582791475745814","event_name":"NBA 2K27: Season 2 Courtside Report","event_type":14,"appid":4356430,"server_address":null,"server_password":null,"rtime32_start_time":1792162800,"rtime32_end_time":1792168201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Celebrate NBA Tip-Off during Season 2 with new rewards!\",\"\",null,null,\"\",null,\" \u300aNBA 2K27\u300b\u7b2c 2 \u5b63\u5c06\u81f4\u656c\u7bee\u7403\u5de8\u661f Caitlin Clark \u548c Tyrese Halburton\u3002\u5728\u7bee\u7403\u4e4b\u57ce\u3001\u8f89\u714c\u751f\u6daf\u548c\u68a6\u5e7b\u7403\u961f\u4e2d\u8d5a\u53d6\u7ecf\u9a8c\u503c\uff0c\u4ee5\u89e3\u9501\u5168\u65b0\u7684\u8d5b\u5b63\u5956\u52b1\u3002\",\"\u300aNBA 2K27\u300b\u7b2c2\u5b63\u5411\u7c43\u7403\u660e\u661fCaitlin Clark\u548cTyrese Haliburton\u81f4\u656c\u3002\u5728\u7c43\u7403\u4e4b\u57ce\u3001MyCAREER\u548cMyTEAM\u6a21\u5f0f\u4e2d\u8cfa\u53d6\u7d93\u9a57\u503c\uff0c\u89e3\u9396\u5168\u65b0\u8cfd\u5b63\u734e\u52f5\u3002\",null,null,\"\u300eNBA 2K27\u300f\u306e\u30b7\u30fc\u30ba\u30f32\u306f\u3001\u30d0\u30b9\u30b1\u754c\u306e\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u3001\u30b1\u30a4\u30c8\u30ea\u30f3\u30fb\u30af\u30e9\u30fc\u30af\u3068\u30bf\u30a4\u30ea\u30fc\u30b9\u30fb\u30cf\u30ea\u30d0\u30fc\u30c8\u30f3\u304c\u4e3b\u5f79\u3002\u30b6\u30fb\u30b7\u30c6\u30a3\u3001\u30de\u30a4\u30ad\u30e3\u30ea\u30a2\u3001\u30de\u30a4\u30c1\u30fc\u30e0\u3067XP\u3092\u7372\u5f97\u3057\u3066\u3001\u65b0\u305f\u306a\u30b7\u30fc\u30ba\u30f3\u5831\u916c\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3088\u3046\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Season 2 of NBA 2K27 celebrates basketball stars Caitlin Clark and Tyrese Halburton. Earn XP in The City, MyCAREER, and MyTEAM to unlock new Season rewards.\\n\",\"Saison 2 von NBA 2K27 feiert die Basketball-Stars Caitlin Clark und Tyrese Haliburton. Verdiene XP in The City, MyCAREER und MyTEAM, um neue Saisonbelohnungen freizuschalten.\",\"\",\"La Stagione 2 di NBA 2K27 celebra le star del basket Caitlin Clark e Tyrese Haliburton. Guadagna XP in The City, MyCAREER e MyTEAM per sbloccare nuove ricompense stagionali.\",\"NBA 2K27 \uc2dc\uc98c 2\ub294 \ub18d\uad6c \uc2a4\ud0c0 Caitlin Clark\uc640 Tyrese Halburton\uc744 \uae30\ub150\ud569\ub2c8\ub2e4. The City, MyCAREER, MyTEAM\uc5d0\uc11c \uacbd\ud5d8\uce58\ub97c \ud68d\ub4dd\ud558\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uc98c \ubcf4\uc0c1\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uc138\uc694.\",\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"\",null,null,null,null,\"\",null,null,null,null],\"localized_title_image\":[\"e91cc9c2562c890e19fc13faf3ee67d047592c69.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ce5a598c26bcd0733a191125061f95019395f50e.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"707785259656154564","clanid":"46224406","posterid":"0","headline":"NBA 2K27: Season 2 Courtside Report","posttime":1791990037,"updatetime":1792433404,"body":"[p][\/p][previewyoutube=\"itpKsTuI1gY;full\"][\/previewyoutube][p][\/p][p]The basketball world is in full motion.\u00a0[\/p][p][\/p][p]NBA Tip-Off is here, a new WNBA champion is about to be crowned, and Season 2 of [i]NBA 2K27[\/i] is about to drop![\/p][p][\/p][p]Season 2 is headlined by Tyrese Haliburton and Caitlin Clark, two of the biggest names in Indiana basketball. Every game, every possession, every moment is an opportunity to overcome the opposition and prove they have what it takes to lead their teams to glory.\u00a0[\/p][p][\/p][p]The offseason is over; the road to the NBA Finals starts now.\u00a0[\/p][p][\/p][p]Caitlin Clark just wrapped up her third season in the W, earning her third All-Star nod and leading Indiana to the playoffs for the second time in her young basketball career. Meanwhile, Tyrese Haliburton looks towards Tip-Off, when he\u2019ll aim to reclaim a spot atop the NBA world by bringing a championship to the Pacers.[\/p][p][\/p][p]Perfect your build, make a name for yourself in MyCAREER, ball out in The City, and stack Ws on your way to Level 40, earning all-new rewards for your MyPLAYER and your MyTEAM, so you can make an impression as soon as you get on the floor.[\/p][p][\/p][h2][b]INTRODUCING GOAT BUILDS[\/b][\/h2][p][\/p][p]We\u2019re changing the game this season with GOAT Builds. Inspired by NBA legends, these are tailored recreations of past and present NBA stars that break the standard attribute [i]and[\/i] physical caps of the MyPLAYER Builder. Want to run a guard with elite playmaking and size that exceeds the 6\u20197\u201d height limit of a Create Your Own PG? You can, with the Magic Johnson GOAT Build.\u00a0\n[\/p][p]They even feature unique archetype names based on your chosen NBA player.\n[\/p][p]Note that signature animations are locked to maintain the authentic feel of the legend, but you'll still have full access to customize Badges, Cap Breakers, and Takeovers.\n[\/p][p]There will be eight GOAT Builds available immediately when Season 2 starts, and you\u2019ll unlock three more as part of the Season Rewards track, featuring some of your favorite NBA legends. Lace up and play like a superstar!\n[\/p][p]View the full list of GOAT Builds\u2014and how to unlock them\u2014below:\n[\/p][p][b]Available immediately via new GOAT Builds builder path:[\/b][\/p][list][*][p]Penny Hardaway (PG)[\/p][\/*][*][p]Gilbert Arenas (PG)[\/p][\/*][*][p]Klay Thompson (SG)[\/p][\/*][*][p]Carmelo Anthony (SF)[\/p][\/*][*][p]Andrei Kirilenko (SF)[\/p][\/*][*][p]Kawhi Leonard (SF)[\/p][\/*][*][p]Anthony Davis (PF)[\/p][\/*][*][p]Dwight Howard (C)\u00a0\n[\/p][\/*][\/list][p][b]Unlock via Season 2 Rewards:[\/b][\/p][list][*][p]Level 26: Magic Johnson (PG)[\/p][\/*][*][p]Level 33: Dirk Nowitzki (PF)[\/p][\/*][*][p]Level 37: Kobe Bryant (SG)[\/p][\/*][\/list][p][\/p][p][b]Unlock via REP:[\/b][\/p][list][*][p]Elite V: Ray Allen (SG) and Hakeem Olajuwon (C)[\/p][\/*][*][p]Elite VIII: Derrick Rose (PG) and Michael Jordan (SG)[\/p][\/*][*][p]Legend I: LeBron James (SF)[\/p][\/*][\/list][p][\/p][p][b]Unlock via Lifetime Challenges:[\/b][\/p][list][*][p]300 Challenges: Anthony Edwards (SG)[\/p][\/*][*][p]350 Challenges: Wilt Chamberlain (C)[\/p][\/*][\/list][p][\/p][h2][b]PATCH UPDATE 2.0[\/b][\/h2][p][\/p][p]Update 2.0 is now available on PlayStation\u00ae5 and XBOX Series X|S. The update releases on Nintendo Switch 2 and PC shortly before the start of Season 2 on October 16.[\/p][p][\/p][p]This update refines gameplay across shooting, passing, defense, steals, dribbling, and more, brings full 25-year careers to MyCAREER Eras, increases REP and Crew XP earnings in Crew Divisions, along with fixes and improvements across the game.[\/p][p][\/p][p]For more details, learn more in the full patch notes breakdown [url=\"https:\/\/store.steampowered.com\/news\/app\/4356430\/view\/707785259656151916\"]here[\/url].[\/p][p][\/p][h2][b]THE CITY[\/b][\/h2][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/43f776170db7072d3e7f59e2abb9043e3fcc2d09.jpg\"][\/img][\/p][p]Celebrate the return of NBA basketball and the epic conclusion of the WNBA season by jumping into Season 2 of [i]NBA 2K27[\/i]!\u00a0[\/p][p][\/p][p]It\u2019s been seven weeks since The City first opened its gates to [i]NBA 2K [\/i]players, but it\u2019s still early enough to get in on the action! Stay ahead of the opposition by suiting up today and securing your spot in the standings\u2014all while you reap powerful rewards in the process. This Season, step onto the court, flex your muscle, and put your skills to the test against the toughest competition around.[\/p][p][\/p][p]Play games in The REC, Park, The Theater, and all other City game modes to gain XP, climb the rewards ladder, and unlock MyPLAYER cosmetics alongside game-changing Cap Breakers, Bonus Badge Slots & Tokens, and Synergy Slots.[\/p][p][\/p][p]This is your moment. It\u2019s time to get in the game![\/p][p][\/p][h3][b]Hoop Under the Stars at Sunset Beach[\/b][\/h3][p][\/p][p]Enjoy the seaside vibes at Sunset Beach, remastered from [i]NBA 2K17[\/i]. Grab your Crew and splash some threes against an iconic coastal backdrop, featuring a towering volcano and massive fish tank. Dominate games to rack up VC and unlock head-turning medals to put your game on display. Remember to take down the squad with the longest win streak for maximum rewards and become the Park MVP![\/p][p][\/p][h3][b]American Express NBA Tip-Off*[\/b][\/h3][p][\/p][p]American Express NBA Tip-Off is right around the corner, and the basketball world is poised for another thrilling NBA season!\u00a0\n[\/p][p]To celebrate, Amex will be taking over The Theater in The City for one week starting Friday, October 16 at 8 AM PDT. Be one of the first 200,000 players to play three games in The Theater on Friday, Saturday, and Sunday to receive custom Amex apparel.\u00a0\n[\/p][p]This apparel will be 2XREP-eligible for the Amex Wear & Earn on November 7\u2014and more eligible apparel is also available in pop-up shops around The City.\n[\/p][p]Note that rewards for the Amex Theater Takeover are only available to players in the United States. Official Terms & Conditions provided [u][url=\"https:\/\/nba.2k.com\/2k27\/amex-challenge-rules\/\"]here[\/url][\/u].\u00a0\n[\/p][h3][b]Crew Divisions[\/b][\/h3][p][\/p][p]Crew Divisions is receiving some serious upgrades for Season 2, making it easier than ever for you to hit the hardwood with your friends and maximize your progress.\n[\/p][p]You\u2019ll immediately begin to earn Double Crew XP towards the rewards track alongside a +25% REP bonus for all Crew Divisions games played.\u00a0\n[\/p][p]The difficulty level in Crew HQ has been adjusted to match The REC for more accessible gameplay. For those looking for a more competitive experience, the Squad Showdown Kiosk still retains competitive difficulty sliders for private matchmaking.\u00a0\n[\/p][p]Whether you\u2019re looking to climb the ranks or just shoot hoops with friends, these improvements make Crew HQ the ultimate destination for your squad in [i]NBA 2K27[\/i].[\/p][p][\/p][h3][b]Chase Level 40 and Earn Scary Good Rewards[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/bf8a5cf24445e692f2fd8a24e39f75a35e308e9f.jpg\"][\/img][\/p][p]Lock in! A new Season of rewards and fresh content are waiting for you. On your rise to Level 40, you\u2019ll earn spooktacular cosmetics to ring in the Halloween season\u2014alongside four Synergy Badge Slots, two Bonus Badge Tokens, and two Bonus Badge Slots. Keep competing during Season 2 and check out some of the rewards below:[\/p][p][\/p][list][*][p]Level 7: Synergy Badge Slot[\/p][\/*][*][p]Level 11: Bonus Badge Slot[\/p][\/*][*][p]Level 15: Synergy Badge Slot[\/p][\/*][*][p]Level 16: Bonus Badge Token[\/p][\/*][*][p]Level 18: 4-Person Golf Cart[\/p][\/*][*][p]Level 20: \u2018Boomer\u2019 - Indiana Pacers Mascot[\/p][\/*][*][p]Level 24: \u2018Temperature\u2019 Teammote, Featuring Sean Paul[\/p][\/*][*][p]Level 25: Synergy Badge Slot[\/p][\/*][*][p]Level 26: Magic Johnson GOAT Build[\/p][\/*][*][p]Level 27: New Balance x Cameron Brink P400 Low \u2018Malibu Melt\u2019[\/p][\/*][*][p]Level 31: Bonus Badge Slot[\/p][\/*][*][p]Level 33: Dirk Nowitzki GOAT Build[\/p][\/*][*][p]Level 35: Synergy Badge Slot[\/p][\/*][*][p]Level 36: Bonus Badge Token[\/p][\/*][*][p]Level 37: Young Kobe GOAT Build[\/p][\/*][*][p]Level 39: Clown Costume: Ankle Taker[\/p][\/*][*][p]Level 40: +1 Cap Breaker[\/p][\/*][\/list][p][\/p][h3][b]Community Builds[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/84a58a0d4d147ae889e8cef18a5ab4e39734a8e1.jpg\"][\/img][\/p][p]Created by some of the best builders in the [i]NBA 2K27[\/i] community, these builds are designed to push you to your ultimate hoops potential and provide new, exciting ways to play the game.[\/p][p][\/p][list][*][p][b]Blix[\/b] \u2013 Point Guard, 6\u20194\u2019\u2019, Posterizing Iso Sniper[\/p][\/*][*][p][b]Yaadmangaming[\/b] \u2013 Shooting Guard, 6\u20198\u201d, 2-Way Bucket Chaser[\/p][\/*][*][p][b]Aije[\/b] \u2013 Small Forward, 6\u20199\u2019\u2019, 2-Way 3-Level Slammer[\/p][\/*][*][p][b]VBucketss[\/b] \u2013 Power Forward, 6\u20196\u2019\u2019, Slashing Board Enforcer[\/p][\/*][*][p][b]TTYME[\/b] \u2013 Center, 7\u20190\u2019\u2019, Gun & Give Paint Protector[\/p][\/*][\/list][p][\/p][p]Equip these community builds to slash your way to the rim and shoot with authority. Think your build has what it takes to be featured in [i]NBA 2K27[\/i]? Hit up the[url=\"https:\/\/nba.2k.com\/2k26\/community-builds\/\"] [\/url][url=\"https:\/\/nba.2k.com\/2k27\/community-builds\/\"][u]MyPLAYER Community Builds[\/u][\/url] page to submit your creation.[\/p][p][\/p][h2][b]MyTEAM[\/b][\/h2][p][\/p][p]Season 2\u2019s MyTEAM rewards let you lock up the opposition and rock the rim with elite defenders, shifty scorers, and imposing bigs.\u00a0\n[\/p][h3][b]Premier Exchange: Pixel Cut Kareem Abdul-Jabbar[\/b][\/h3][p]\nThe Premier Exchange allows you to exchange an assortment of cards from your collection for a brand-new exclusive card each Season. Separate from the Exchange\u2019s regular Friday card drops, the Premier Exchange is available all Season long and offers some of the most powerful cards in MyTEAM.\u00a0[\/p][p]\nWith the exception of Free Agent cards, you\u2019re able to trade in any player card you own, whether it came from a pack, the Auction House, rewards, or a Locker Code. Plus, persistent progress towards your target card ensures that, as long as you begin submitting cards while it\u2019s active in the Exchange, even once the timer runs out for a specific card, you can still earn it at any time by satisfying its requirements.[\/p][p]\nFlexibility is a key component of [i]NBA 2K27[\/i]\u2019s Premier Exchange, making it easier for you to grab exclusive cards and build your dream roster.[\/p][p]\nSeason 2\u2019s Premier Exchange card lets you stuff every shot and put your opponents on a poster with Kareem Abdul-Jabbar, one of the most impactful two-way centers in league history. An 11-time member of the NBA All-Defensive Team and four-time NBA Blocks Leader, Kareem won six NBA championships during his legendary 20-year career with the Milwaukee Bucks and Los Angeles Lakers.[\/p][p]\nIn addition to Pixel Cut Kareem Abdul-Jabbar, this Season brings electrifying new content throughout MyTEAM, featuring new opponents, challenges, and card drops.\u00a0[\/p][p]\nEarn Ascension Board Picks through a new set of Daily Challenges, assemble Mode Completion Event Cards through daily Play Now Challenges, pick up powerful cards with weekly updates in the Exchange, and compete in Limited Time Modes with versions of Triple Threat Online and Clutch Time Online available all Season long.[\/p][p]\nYou\u2019ll also be able to take on basketball\u2019s best in Domination by hitting the floor in two new tiers against Historic and All-Time teams.\u00a0[\/p][p]\nKeep competing to level up your roster with Season 2\u2019s MyTEAM rewards, including:[\/p][p][\/p][h3][b]Level 1 Diamond Jason Kidd[\/b][\/h3][p][\/p][h3][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/6a94c5f4c9bb46dee1a858f36e3c3b9b31c64b98.jpg\"][\/img][\/h3][p]A visionary playmaker, lockdown defender, and perennial triple-double threat, Jason Kidd is a 10-time All-Star and NBA champion. Add [b]Diamond Jason Kidd\u2019s [\/b]Hall of Fame pedigree to your team today and stuff the stat sheet![\/p][p][\/p][h3][b]Level 10 Pink Diamond Obi Toppin[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/937303a200fedfd3253fbfe9ceb7d0b5c3bd7ab0.jpg\"][\/img][\/p][p]Enhance your highlight reel with [b]Pink Diamond Obi Toppin[\/b], whose unmatched athleticism led him to a 2022 Dunk Contest Championship. Throw it down on all of your opponents and take your team to new heights with Indiana\u2019s rim-running forward.[\/p][p][\/p][h3][b]Level 20 Galaxy Opal Roy Hibbert[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/93e821396c208a7206fb22d8021ca83f287198bb.jpg\"][\/img][\/p][p]A lockdown defender and massive presence in the paint, Roy Hibbert\u2019s 7\u20192\u201d frame and daunting verticality anchored the Pacers\u2019 defense throughout multiple playoff runs. Add [b]Galaxy Opal Roy Hibbert[\/b] today and deny every shot.[\/p][p][\/p][h3][b]Level 28 Diamond Coach Joe Mazzulla [\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/4615397dc08a2e87c1a2a5aad46c014ab9e8661e.jpg\"][\/img][\/p][p]Boston\u2019s creative leader, Joe Mazzulla\u2019s coaching style is centered on smart passing reads and unique, cohesive rotations. Coach Mazzulla adds +3 to your team\u2019s Offensive & Defensive Rebound, Pass Perception, Steal, and Vertical. Get to Level 28 and let [b]Diamond Coach Joe Mazzulla[\/b] lead your team to victory.[\/p][p][\/p][h3][b]Level 30 Dark Matter Devin Vassell[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/da9e62b278a23792f3c99a7dd11d99b22af0efd7.jpg\"][\/img][\/p][p]The versatile, two-way wing from San Antonio, Devin Vassell\u2019s knock-down 3-point shooting keeps opposing defenses in check while his teammates wreak havoc under the rim. Drive into the lane, kick it out to [b]Dark Matter Devin Vassell[\/b], and drain every shot.[\/p][p][\/p][h3][b]Level 35 Pixel Cut WNBA Kelsey Mitchell[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/6216140235271be38f38958478485cc83259a460.jpg\"][\/img][\/p][p]An explosive athlete with incredible speed and shooting ability, Kelsey Mitchell is one of the W\u2019s premier offensive weapons. [b]Pixel Cut WNBA Kelsey Mitchell[\/b] needs to be in your rotation so you can get buckets![\/p][p][\/p][h3][b]Level 40 Pixel Cut Karl-Anthony Towns[\/b][\/h3][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/eccb3e2259412cd0136c814f4a9a603c2fc8e395.jpg\"][\/img][\/p][p]Elite floor-spacing big Karl-Anthony Towns just helped lead the New York Knicks to a title for the first time in 53 years. Reach Level 40, fill it up from three, and warp the defense as soon as you cross the half court line.[\/p][p][\/p][h2][b]SEASON PRO PASS**[\/b][\/h2][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/5cfb4c2dc5b708148dbf4648485318bdfd2b248f.jpg\"][\/img][\/p][p]Unlock 40 additional levels of [i]NBA 2K27[\/i] rewards with the Season 2 Pro Pass and Hall of Fame Pass. These seasonal add-on passes are available for individual purchase and feature Automatic and Premium Rewards.\u00a0[\/p][p][\/p][p]Season 2 Automatic Rewards:[\/p][list][*][p][b]Jack-O\u2019-Lantern Scarecrow Costume[\/b][\/p][\/*][*][p][b]Headhunter Mask[\/b][\/p][\/*][*][p][b]Dark Matter Pascal Siakam[\/b][\/p][\/*][*][p][b]Pro Pass Pack (Hall of Fame Interceptor, Diamond Shoe x2, Rim Guardian Takeover, See The Future Takeover)[\/b]\n[\/p][\/*][\/list][p]In addition to bonus VC, XP, and Skill Boosts, the Season 2 Pro Pass features terrifying cosmetics and rewards that ease you into spooky season. Set the scoreboard ablaze with the Fire Face Body Mod, strike fear into your opponents with the Molten Headhunter Mask, and become a monster in the paint with the [b]Level 40 Pro Pass Pixel Cut Karl-Anthony Towns [\/b]card, featuring special edition card art![\/p][p][\/p][p]Season 2 Premium Rewards:[\/p][list][*][p]Level 1: \u2018Work\u2019 Teammate, Featuring Rihanna[\/p][\/*][*][p]Level 3: Jack-O\u2019-Lantern Facepaint[\/p][\/*][*][p]Level 12: \u2018Sir C.C.\u2019 - Cleveland Cavaliers Mascot[\/p][\/*][*][p]Level 18: Fire Face Body Mod[\/p][\/*][*][p]Level 30: \u2018G-Wiz\u2019 - Washington Wizard Mascot[\/p][\/*][*][p]Level 36: Molten Headhunter Mask[\/p][\/*][*][p]Level 39: Clown Costume: Game Over[\/p][\/*][*][p]Level 40: Pro Pass Pixel Cut Karl-Anthony Towns[\/p][\/*][\/list][p][\/p][h2][b]2K BEATS[\/b][\/h2][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/46224406\/7260c5d87ca5d405e7dfa26e21b36f9bc0252b24.jpg\"][\/img][\/p][p]2K Beats is back with more tracks so you can get down on and off the court! As part of Season 2, the team is adding a stacked lineup of artists to [i]NBA 2K27[\/i] across five unique mixes. This Season features an eclectic mix of beats\u2014alongside one very special guest\u2014with new additions that capture the heart and rhythm of global hoops culture.[\/p][p][\/p][list][*][p][b]Fresh Tracks from Tyrese Haliburton[\/b]: The face of the Indiana Pacers and co-hero of [i]NBA 2K27 [\/i]Season Two, Tyrese Haliburton has compiled some of his favorite artists in this one-of-a-kind curation, featuring Drake, Jay-Z, Meek Mill, and more![\/p][\/*][*][p][b]Space Jam 30th Anniversary Celebration[\/b]: Take flight and throw down gravity-defying dunks to tracks from the classic 1996 film [i]Space Jam[\/i]![\/p][\/*][*][p][b]Curated by 2K Beats[\/b]: With a diverse set of artists\u2014including Kid Cudi, Linkin Park, and Blackpink, the 2K Beats team\u2019s latest additions to the [i]NBA 2K27[\/i] soundtrack are sure to inspire hoopers around the world to get on the court.[\/p][\/*][*][p][b]French Artist Spotlight[\/b]: We\u2019re shining a light on France with a few artists that are rapidly rising up the country\u2019s top charts: Charlotte Cardin, Genezio, and Nisko.[\/p][\/*][*][p][b]Rucker Park[\/b]: 2K Beats continues our celebration of Rucker Park\u2019s rich basketball history with ten added tracks. These in-game audio drops evoke the culture, feel, and soul of New York hoops\u2014and are the perfect soundtrack for your runs at Rucker!\n[\/p][\/*][\/list][p]Catch a vibe to 2K Beats while you hoop in-game\u2014or check out every track in [i]NBA 2K27 [\/i]on Spotify and Apple Music.[\/p][p][\/p][h2][b]THE BUZZER BEATER[\/b][\/h2][p]As the WNBA celebrates a new champion and the NBA gears up for another year of high-stakes basketball action, keep up the momentum and go all out in Season 2 of [i]NBA 2K27[\/i]. Hoop in The City, collect your favorite players in MyTEAM, and collect XP to earn all-new rewards. Be sure to download the [url=\"https:\/\/nba.2k.com\/nba-2k-hq\/\"][u]NBA 2K HQ companion app [\/u][\/url]to stay connected to [i]2K27[\/i], and learn more about in-game events and new content by following[i] NBA 2K[\/i] on [url=\"https:\/\/x.com\/intent\/user?screen_name=NBA2K\"][u]X[\/u][\/url], [url=\"https:\/\/www.instagram.com\/nba2k\/\"][u]Instagram[\/u][\/url], [url=\"https:\/\/discord.com\/invite\/nba2k\"][u]Discord[\/u][\/url], and [url=\"https:\/\/www.twitch.tv\/nba2k\"][u]Twitch[\/u][\/url].[\/p][p] [\/p][p][i]*NO PURCHASE NECESSARY. OPEN TO US RESIDENTS, 18+. CONTEST BEGINS 10\/16\/26 9AM PT AND ENDS 10\/19\/26 8:59AM PT. VOID WHERE PROHIBITED. SPONSOR: TAKE-TWO INTERACTIVE SOFTWARE, INC. SEE OFFICIAL RULES:\u00a0 [\/i][\/p][p][url=\"https:\/\/nba.2k.com\/2k27\/amex-challenge-rules\/\"]https:\/\/nba.2k.com\/2k27\/amex-challenge-rules\/[\/url][\/p][p][\/p][p][i]**NBA 2K27 Pro Passes and Hall of Fame passes are available for separate purchase and require base game, internet connection and NBA 2K account. Paid premium passes unlock additional rewards for the Season that are earnable through gameplay. Progress and rewards reset at the end of each Season.[\/i][\/p]","commentcount":16,"tags":["vo_marketing_message","mod_reviewed","ModAct_1894963720_1791990600_0","ModAct_1911576989_1792113363_4","ModAct_1911576989_1792115727_4","ModAct_1911576989_1792118536_4","ModAct_1607812438_1792166079_4","ModAct_487176015_1792442847_4"],"language":0,"hidden":0,"forum_topic_id":"571552004573293318","event_gid":"707785259656154563","voteupcount":176,"votedowncount":39,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791990000,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552004573293318","rtime32_last_modified":1793406039,"news_post_gid":"0","rtime_mod_reviewed":1792442848,"featured_app_tagid":0,"referenced_appids":[],"build_id":25761995,"build_branch":"","unlisted":0,"rtime_created":1791898732,"votes_up":176,"votes_down":39,"comment_type":"ForumTopic","gidfeature":"594062392368870295","gidfeature2":"571552004573293318"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["702157028173288291","707785259656154564"],"last_update_event":{"rtime":1792162800,"event_gid":"707785259656154563","announcement_gid":"707785259656154564","clan_account_id":46224406}}};
						</script>
					


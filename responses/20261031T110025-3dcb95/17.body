							var StoreDefaults = {"PartnerEventStore":[{"gid":"713416661425719242","clan_steamid":"103582791475142302","event_name":"Bruisers Roadmap Reveal: Vote on What Comes Next","event_type":28,"appid":3740090,"server_address":null,"server_password":null,"rtime32_start_time":1793387220,"rtime32_end_time":1793390820,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Vote on upcoming features, pitch your ideas, and help shape what comes next for Bruisers.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"The Bruisers roadmap is live! Explore upcoming features, vote for what you want sooner, and pitch your own ideas directly to the team.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"e5869d372d66998f23dddedc068f31c307431ae3.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"6b1987c297b8e3d7d02ce1991819da1a177bf82d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"713416661425719243","clanid":"45620894","posterid":"0","headline":"Bruisers Roadmap Reveal: Vote on What Comes Next","posttime":1793387223,"updatetime":1793387223,"body":"[p]Hey everyone,[\/p][p]From the beginning, we\u2019ve said that Early Access is a chance to build Bruisers alongside the people playing it.[\/p][p]Now, you can have a direct say in what comes next.[\/p][p]The new[url=\"https:\/\/bruisers2dboxing.com\"] [u]Bruisers 2D Boxing website[\/u][\/url] features an interactive roadmap where you can follow what we\u2019re working on, vote for the features you want sooner, and pitch your own ideas directly to the team.[\/p][p][\/p][h3][b]Vote on What Comes Next[\/b][\/h3][p]See something you want in Bruisers? Hit [b]Vote[\/b].[\/p][p]The most popular features will rise to the top, helping us understand what matters most to the community and where you want us to focus throughout Early Access.[\/p][p]The roadmap shows our current direction, but features and priorities may change as development continues.[\/p][p][\/p][h3][b]Pitch Your Ideas[\/b][\/h3][p]If the feature you want isn\u2019t already on the roadmap, select [b]Pitch Idea[\/b] and send it our way.[\/p][p]We\u2019ll read every submission before adding it to the Ideas section, where the rest of the community can vote on it too. Get enough votes and your idea could climb the roadmap.[\/p][p][\/p][h3][b]Check Out the New Website[\/b][\/h3][p]Take a trip back to the \u201990s and explore the desktop, complete with games, Easter eggs, and more.[\/p][p]You can also sign up under [b]Get Updates[\/b] to receive the latest Bruisers news, dev updates, deals and more.[\/p][p][b]Explore now and vote on the roadmap:[\/b] [\/p][p][url=\"https:\/\/bruisers2dboxing.com\/\"]https:\/\/bruisers2dboxing.com\/[\/url][\/p][p]\u00a0[\/p][p]Your feedback continues to shape Bruisers, so keep it coming![\/p]","commentcount":6,"tags":["mod_reviewed","ModAct_783923276_1793388502_0"],"language":0,"hidden":0,"forum_topic_id":"573805072991202142","event_gid":"713416661425719242","voteupcount":61,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805072991202142","rtime32_last_modified":1793411440,"news_post_gid":"0","rtime_mod_reviewed":1793388502,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793387213,"votes_up":61,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"655981814410713199","gidfeature2":"573805072991202142"},{"gid":"703282384630449898","clan_steamid":"103582791475142302","event_name":"Bruisers 2D Boxing is out now in Early Access!","event_type":10,"appid":3740090,"server_address":null,"server_password":null,"rtime32_start_time":1792602360,"rtime32_end_time":1792607401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Career Mode rebuilt, a brand-new combat system, full localization and much more since the June Demo.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"7e0007bd61c3af99a50434b07ed046c4fa8f5b8e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"0a60f0d78ceb04fc20df72aecdce68213c2c4040.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"703282384630449899","clanid":"45620894","posterid":"0","headline":"Bruisers 2D Boxing is out now in Early Access!","posttime":1792602239,"updatetime":1792602375,"body":"[h2][b]The bell has rung: Bruisers 2D Boxing is now in Early Access![\/b][\/h2][p]Bruisers 2D Boxing is officially available to play in Early Access. As we\u2019ve said in the past, we are huge boxing and boxing video game fans, and are genuinely excited to share this game with the community.\u00a0[\/p][p]We\u2019ve been working relentlessly over the last few months to get Bruisers to a state we are proud to stand behind. We know the wait was longer than planned, but we think once you play \u2014 you\u2019ll see where that time went.[\/p][p][\/p][p][dynamiclink href=\"https:\/\/youtu.be\/h2OfBrTTs-0\"][\/dynamiclink][\/p][p]Here are the full patch notes covering everything that\u2019s changed since our Demo back in June.[\/p][p][\/p][h3][b]CAREER MODE[\/b][\/h3][list][*][p]Guided trainer onboarding that teaches you the Career Hub step by step, plus in-ring tutorials for each fighter style[\/p][\/*][*][p]New create-a-fighter flow with presets and a confirmation screen[\/p][\/*][*][p]Rebuilt ranking ladder: a 60-deep Contenders list, scaling purses, retiring fighters, belt tracking, title defenses and win-loss records[\/p][\/*][*][p]Working rival system[\/p][\/*][*][p]New weight system. Coming in heavy or light on purpose is now a strategy with its own pros and cons, and CPU fighters manage their own weight[\/p][\/*][*][p]Injuries now carry over between fights, and you heal them from the health screen[\/p][\/*][*][p]Auto-training, skill point and XP feedback, and a cleaner shop and inventory[\/p][\/*][*][p]Deeper email system with connected story points, including mob ties, contraband, scouting reports, drug tests and betting storylines[\/p][\/*][*][p]Full save system overhaul with automatic backup and restore[\/p][\/*][\/list][p][\/p][h3][b]COMBAT AND FIGHT RULES[\/b][\/h3][list][*][p]New cut, swelling and blood system, including wiping blood off your screen and fighting through on-screen swelling[\/p][\/*][*][p]Real-time injury system for hands, arms, jaw, head and body, shown on the HUD[\/p][\/*][*][p]Headbutts and disqualifications[\/p][\/*][*][p]Reworked referee, doctor and stoppage logic[\/p][\/*][*][p]Reworked in-fight damage system[\/p][\/*][*][p]Full stamina and heart rate rebalance, including late-round fatigue[\/p][\/*][*][p]All-new judging: different judge types picked at random, with predicted scorecards between rounds[\/p][\/*][*][p]Smarter CPU movement and AI[\/p][\/*][*][p]All-new top-tier Pugilist difficulty. It thinks differently and fights like a top-ranked contender on the ladder[\/p][\/*][*][p]Many smaller combat tweaks and fixes[\/p][\/*][\/list][p][\/p][h3][b]MINI-GAMES AND ACTIVITIES[\/b][\/h3][list][*][p]All-new corner mini-game between rounds in Pro fights[\/p][\/*][*][p]Every training and job mini-game rebuilt, with a new look and high-score screens[\/p][\/*][*][p]Fishing game overhaul[\/p][\/*][*][p]Casino polish with new backgrounds and betting upgrades[\/p][\/*][*][p]Expanded Quick Play: items, round time options, and Hall of Fame and Custom character brackets[\/p][\/*][\/list][p][\/p][h3][b]UI AND HUD[\/b][\/h3][list][*][p]Full UI overhaul across the game: every menu and career screen, the PC desktop, email, shops, fridge, Hall of Fame and boxing licenses[\/p][\/*][*][p]New in-fight HUD with reactive fighter portraits and a round card, plus a HUD on\/off toggle[\/p][\/*][*][p]New feedback popups for money, food, items, belts and injuries[\/p][\/*][*][p]New logo and main menu artwork[\/p][\/*][\/list][p][\/p][h3][b]CONTROLS AND INPUT[\/b][\/h3][list][*][p]Dynamic controller icons and diagrams for PS4, PS5, Xbox and Switch Pro controllers[\/p][\/*][*][p]Full keyboard support and custom control mapping[\/p][\/*][\/list][p][\/p][h3][b]AUDIO[\/b][\/h3][list][*][p]Large batches of new commentary, referee and trainer lines, with a unique voice for each corner[\/p][\/*][*][p]Full audio balancing pass[\/p][\/*][\/list][p][\/p][h3][b]LANGUAGES[\/b][\/h3][list][*][p]Full localization in Spanish, Italian, German, French and Portuguese, with an in-game language selector[\/p][\/*][\/list][p][\/p][h3][b]DISPLAY AND PLATFORMS[\/b][\/h3][list][*][p]Now available on Mac[\/p][\/*][*][p]Fullscreen, windowed and borderless modes. The game remembers your last choice[\/p][\/*][\/list][p][\/p][h3][b]STABILITY AND POLISH[\/b][\/h3][list][*][p]Hundreds of bug fixes across crashes, tutorials, saves and UI, driven by countless rounds of internal playtesting and beta tester feedback[\/p][\/*][\/list][p][\/p][p]This is only the beginning. [b]Through Early Access, we will follow the community\u2019s feedback, which will directly shape the future of the game. Don\u2019t be scared, tell us what you think in the Discussions.[\/b][\/p][p]Thanks again, and we\u2019ll see you all in the virtual-ass-ring.[\/p][p]Jevon & Nick[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3740090\/Bruisers_2D_Boxing\/\"][\/dynamiclink][\/p]","commentcount":20,"tags":["ModAct_1847323374_1792605840_2_10","mod_reviewed","ModAct_1847323374_1792605843_0"],"language":0,"hidden":0,"forum_topic_id":"565923139446445942","event_gid":"703282384630449898","voteupcount":103,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565923139446445942","rtime32_last_modified":1793318961,"news_post_gid":"0","rtime_mod_reviewed":1792605843,"featured_app_tagid":0,"referenced_appids":[],"build_id":26051075,"build_branch":"","unlisted":0,"rtime_created":1792486797,"votes_up":103,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"655981814410713199","gidfeature2":"565923139446445942"},{"gid":"713416661425719196","clan_steamid":"103582791475142302","event_name":"Quickfix 10.30.2026","event_type":12,"appid":3740090,"server_address":null,"server_password":null,"rtime32_start_time":1793368630,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"713416661425719197","clanid":"45620894","posterid":"0","headline":"Quickfix 10.30.2026","posttime":1793368630,"updatetime":1793368630,"body":"Quick fixes :\n\n\u2022 Fixed the camera panning off to a grey room after a sparring knockout\n\u2022 Critical and counter punch counts are now accurate on the result card\n\u2022 Sparring now gives Heart and Grit XP for every round you box\n\u2022 Sparring no longer damages your heart\n\u2022 Sparring results screen tidied up\n\u2022 Improved 8BitDo Pro 3 controller triggers on Mac\n\nThanks as always for your support.\nJev & Nick","commentcount":8,"tags":["patchnotes","mod_reviewed","ModAct_1607812438_1793370199_0"],"language":0,"hidden":0,"forum_topic_id":"573805072991176149","event_gid":"713416661425719196","voteupcount":40,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573805072991176149","rtime32_last_modified":1793410230,"news_post_gid":"0","rtime_mod_reviewed":1793370200,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793368630,"votes_up":40,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"655981814410713199","gidfeature2":"573805072991176149"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["713416661425719243","703282384630449899"],"last_update_event":{"rtime":1793368630,"event_gid":"713416661425719196","announcement_gid":"713416661425719197","clan_account_id":45620894}}};
						</script>
					


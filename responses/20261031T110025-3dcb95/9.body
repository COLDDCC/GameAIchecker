ale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"711164926286104126","clanid":"46180470","posterid":"0","headline":"Construction Rework & Economic Fixes - 1.0.4","posttime":1793396798,"updatetime":1793396798,"body":"Hello players, i'm glad to release this new updates that resolve multiple points, including the construction bottleneck and confusion.\n\nHere the changes:\n\n[list]\n[*] Added 753 real-world deposits worldwide, across all 17 resources and 128 countries.\n[*] Fixed unemployment by skill level display.\n[*] Countries now start with realistic state ownership, from North Korea to oil states and Europe.\n[*] Updated Brazil loading images.\n[*] AI parties no longer try to undo laws your government just passed.\n[*] Central Bank screen now shows the same reserve coverage as the top bar.\n[*] Reworked construction: projects no longer freeze forever when money runs out, sites rely more on builders and less on raw steel.\n[*] More realistic sovereign interest rates\n[*] AI now restructures unsustainable debt earlier\n[*] AI budget decisions improved, including pensions and public services\n[*] Debt dynamics panel now matches the debt chart.\n[*] New equipment now forms new units properly.\n[*] You can now dismantle military equipments.\n[*] Annexing a poorer country no longer causes false income drops and unrest.\n[*] Fixed stalled ammo factory expansions; ammo orders now scale with capacity.\n[*] Improved UI clarity of \"Order of Battle\" in Defense.\n[*] Added transfers from military funds back to the national treasury.\n[*] Fixed clipped text in dropdown menus.\n[*] Fixed adopt_always and adopt_now console cheats: they now force all of the player\u2019s bills, and no longer force AI bills.\n[*] New mines now find domestic buyers faster.\n[\/list]\n\nThansk for being there with me in Early Acces.","commentcount":8,"tags":["mod_reviewed","ModAct_783923276_1793399323_0"],"language":0,"hidden":0,"forum_topic_id":"564797873721685429","event_gid":"711164926286104125","voteupcount":60,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797873721685429","rtime32_last_modified":1793410827,"news_post_gid":"0","rtime_mod_reviewed":1793399324,"featured_app_tagid":0,"referenced_appids":[],"build_id":26334905,"build_branch":"","unlisted":0,"rtime_created":1793396793,"votes_up":60,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561409060965099164","gidfeature2":"564797873721685429"},{"gid":"711164926286103928","clan_steamid":"103582791475701878","event_name":"Hungarian Language Added, GDP Consistency & UI Fixes","event_type":13,"appid":940230,"server_address":null,"server_password":null,"rtime32_start_time":1793350080,"rtime32_end_time":1793354401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"aee175a1454877dc7d7c028b1122b2aac38e1ed4.png\",null,\"15874d38aba22d3947d74b79c094bf169ea46632.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"711164926286103929","clanid":"46180470","posterid":"0","headline":"Hungarian Language Added, GDP Consistency & UI Fixes","posttime":1793350107,"updatetime":1793350107,"body":"Hi, added languages for our Hungarians friend along fixes.\n\n[list]\n[*] Add Hungarian Language.\n[*] GDP now shows the same figure everywhere (HUD, Economy, map, statistics), and amounts no longer shift with the dollar rate + clearer naming.\n[*] Fixed Science navigation blocking access to Space.\n[*] Renamed the \"Resources\" tab to \"Staff & Budget\" and clarified public service labels in all languages.\n[\/list]","commentcount":11,"tags":["mod_reviewed","ModAct_1751692459_1793350493_0"],"language":0,"hidden":0,"forum_topic_id":"564797873721633653","event_gid":"711164926286103928","voteupcount":96,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797873721633653","rtime32_last_modified":1793406508,"news_post_gid":"0","rtime_mod_reviewed":1793350493,"featured_app_tagid":0,"referenced_appids":[],"build_id":26318758,"build_branch":"","unlisted":0,"rtime_created":1793350046,"votes_up":96,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561409060965099164","gidfeature2":"564797873721633653"},{"gid":"711164926286104131","clan_steamid":"103582791475701878","event_name":"Resource Localization Fixes","event_type":12,"appid":940230,"server_address":null,"server_password":null,"rtime32_start_time":1793397956,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"711164926286104132","clanid":"46180470","posterid":"0","headline":"Resource Localization Fixes","posttime":1793397956,"updatetime":1793397956,"body":"Fixed untranslated French text in deposit details, prospecting confirmations, and mining units.","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_803139239_1793400214_0"],"language":0,"hidden":0,"forum_topic_id":"564797873721686748","event_gid":"711164926286104131","voteupcount":13,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797873721686748","rtime32_last_modified":1793410866,"news_post_gid":"0","rtime_mod_reviewed":1793400214,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793397956,"votes_up":13,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"561409060965099164","gidfeature2":"564797873721686748"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["711164926286104126","711164926286103929"],"last_update_event":{"rtime":1793397956,"event_gid":"711164926286104131","announcement_gid":"711164926286104132","clan_account_id":46180470}}};

,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"667251596450594946","clanid":"45793792","posterid":"0","headline":" R.I.P. - Reincarnation Insurance Program \u2014 250,000 Copies Sold!","posttime":1790213657,"updatetime":1790217075,"body":"[p]Greetings, elite Specialists![\/p][p][\/p][p]Since Reincarnation Insurance Program launched its full release, total sales have officially passed 250,000 copies![\/p][p]We could never have reached this milestone without the support and encouragement of every one of you. Thank you to every Specialist who has set foot in the Infection Zones \u2014 you are what makes this battlefield such a lively place![\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45793792\/c961a640595d9f49869022beee7c08a41f66cda0.png\"][\/img][\/p][p]We will keep listening to your feedback and shipping fixes promptly to make the game better.[\/p][p]We hope you enjoy every single battle you spend in R.I.P. - Reincarnation Insurance Program.[\/p][p]If you run into any problems while playing, come join our official community \u2014 a place to talk builds and share run reports with fellow Specialists.[\/p]\n \nForms:\nhttps:\/\/forms.office.com\/r\/jVC50yxVLn\n\nDiscord:\n2pgames.net\/discord","commentcount":33,"tags":["mod_reviewed","ModAct_1426387032_1790214380_0","ModAct_1426387032_1790219392_4"],"language":0,"hidden":0,"forum_topic_id":"588438602971727220","event_gid":"667251596450594945","voteupcount":393,"votedowncount":7,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1790213640,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"588438602971727220","rtime32_last_modified":1793368245,"news_post_gid":"0","rtime_mod_reviewed":1790219392,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790153444,"votes_up":393,"votes_down":7,"comment_type":"ForumTopic","gidfeature":"594036760294576281","gidfeature2":"588438602971727220"},{"gid":"685265358467105594","clan_steamid":"103582791475315200","event_name":"Ver 1.0.1  Version Update","event_type":13,"appid":3985950,"server_address":null,"server_password":null,"rtime32_start_time":1790035560,"rtime32_end_time":1790040601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",\"\",null,null,null,null,null,null,\"\",null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"8e654118b04b09f569f1174f5d70e6c51a01e9d2.png\",null,null,null,null,null,\"e243717f28f0581a5c63922dfeb93f3a0a8a0a9d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_sale_enabled\":false,\"clone_from_event_gid\":\"707773844292633664\"}","announcement_body":{"gid":"685265358467105595","clanid":"45793792","posterid":"0","headline":"Ver 1.0.1  Version Update","posttime":1790035620,"updatetime":1790395584,"body":"[p]Hello, Elite Operatives![\/p][p][\/p][h3][b]Details of this update are as follows: [\/b][\/h3][h3][\/h3][p]Experience Optimizations[\/p][list][*][p]Improved controller operation logic in the Settings interface, making it more convenient to adjust settings.[\/p][\/*][*][p]Added Twin-Stick Aiming mode for controllers. It is enabled by default in Settings; Specialists can disable it in the options to restore the original aiming method.[\/p][\/*][*][p]In Purge Zone \/ Headhunt Assault, when the Inventory is open or while interacting with the Logistics Robot, holding R (Controller RB) to prepare for teleportation or settlement will now automatically close the interaction interface first, preventing incorrect teleportation behavior while the game is paused.[\/p][\/*][\/list][p]Bug Fixes[\/p][list][*][p]Fixed an issue where opening the pause menu or combat information screen while interacting with the Logistics Robot or Sona at the end of combat with a controller could prevent the interaction interface from closing.[\/p][\/*][*][p]Fixed an issue where the focus could be moved with the D-pad in certain secondary confirmation prompts when using a controller, preventing the prompts from being closed.[\/p][\/*][*][p]Fixed an issue where holding R (Controller RB) to settle after winning a Purge Zone \/ Headhunt Assault battle while the Inventory was open caused incorrect result data to be displayed.[\/p][\/*][*][p]Fixed an issue where \\[Auxiliary Weapon] damage from the Mythic Sniper Rifle - \\[AI Pact] was incorrectly counted twice when converted to \\[Weapon] damage.[\/p][\/*][*][p]Fixed an issue where bullet casing ejection effects caused severe lag.[\/p][\/*][*][p]Fixed an issue where the game could crash when Thunder Guardian cast a skill under certain conditions.[\/p][\/*][*][p]Fixed an issue where the game could crash when Cataclysm Drake cast a skill under certain conditions.[\/p][\/*][*][p]Fixed an issue where Nidh-hotep's Blinding Virus skill could cause the game to crash under certain conditions.[\/p][\/*][*][p]Fixed an issue where the Orbital Laser could cause the game to crash under certain conditions.[\/p][\/*][*][p]Fixed an issue where some materials in the Resurgam map were missing.[\/p][p][\/p][\/*][\/list][p]If you encounter any issues during gameplay, welcome to join our official discussion community, where you can discuss the game with other players.[\/p][p][\/p][p]Forms:[\/p][p][url=\"https:\/\/forms.office.com\/r\/jVC50yxVLn\"]https:\/\/forms.office.com\/r\/jVC50yxVLn[\/url][\/p][p][\/p][p]Discord:[\/p][p][url=\"https:\/\/2pgames.net\/discord\"]2pgames.net\/discord[\/url][\/p][p][\/p][p]Ver 1.0.1[\/p][p]Version Date: 2026.9.21[\/p][p]\u00a0[\/p]","commentcount":33,"tags":["mod_reviewed","ModAct_1888979151_1790038256_0","ModAct_1434573178_1790395879_4"],"language":0,"hidden":0,"forum_topic_id":"565920396927440754","event_gid":"685265358467105594","voteupcount":252,"votedowncount":8,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"565920396927440754","rtime32_last_modified":1793292008,"news_post_gid":"0","rtime_mod_reviewed":1790395879,"featured_app_tagid":0,"referenced_appids":[],"build_id":25439521,"build_branch":"","unlisted":0,"rtime_created":1789986931,"votes_up":252,"votes_down":8,"comment_type":"ForumTopic","gidfeature":"594036760294576281","gidfeature2":"565920396927440754"},{"gid":"676260695908549355","clan_steamid":"103582791475315200","event_name":"Ver 1.0.3  Version Update","event_type":12,"appid":3985950,"server_address":null,"server_password":null,"rtime32_start_time":1792145160,"rtime32_end_time":1792150201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",\"\",null,null,null,null,null,null,\"\",null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_sale_enabled\":false,\"clone_from_event_gid\":\"667251596450596287\"}","announcement_body":{"gid":"676260695908549356","clanid":"45793792","posterid":"0","headline":"Ver 1.0.3  Version Update","posttime":1792145208,"updatetime":1792145208,"body":"[p]Hello, Elite Operatives![\/p][p][\/p][h3][b]Details of this update are as follows: [\/b][\/h3][p]Warehouse[\/p][list][*][p]Added equipment filtering, accessible via the new Filter button in the lower-right corner of the Warehouse interface. Specialists can filter stored equipment by Slot and affixes, making it easier to manage and find the equipment they need.[\/p][\/*][\/list][p][img src=\"{STEAM_CLAN_IMAGE}\/45793792\/362a96e7d6dcb09f63a62f903156d21eec7a4c59.png\"][\/img][\/p][p]Leaderboard[\/p][list][*][p]Added a Friend Rank feature to the Performance Leaderboard.[\/p][\/*][*][p]Viewing equipment used by players on the Leaderboard now shows complete equipment information.[\/p][\/*][\/list][p]Experience Optimizations[\/p][list][*][p]Added an option to switch voice language in the Settings interface.[\/p][\/*][*][p]Added Sell All support when selling to the Logistics Robot.[\/p][\/*][*][p]Improved visual effects for some missiles.[\/p][\/*][*][p]Added glow effects to Relic investigation events on maps.[\/p][\/*][*][p]Improved the visual presentation of the map selection interface.[\/p][\/*][*][p]Improved Controller operation logic in the Warwing interface.[\/p][\/*][\/list][p]Bug Fixes[\/p][list][*][p]Fixed an issue in Endless Journey where the combat level could become Level 1 when a character leveled up during combat.[\/p][\/*][*][p]Fixed an issue where Divine Tech abilities related to generating and firing ice shards could cause crashes.[\/p][\/*][*][p]Optimized game saves to reduce save file size and lower the risk of save corruption.[\/p][\/*][*][p]Fixed an issue where the detailed information for Mythic Modules was displayed with incorrect formatting in some interfaces.[\/p][\/*][*][p]Fixed an issue where the details of some Black Market items were displayed with incorrect formatting.[\/p][\/*][*][p]Fixed an issue where update announcements with lengthy content could not be scrolled up or down using a Controller.[\/p][\/*][*][p]Fixed an issue where the equipment details panel could obscure the icon of the equipment being viewed.[\/p][\/*][*][p]Fixed an issue where displaying attribute details in the character attributes panel could obscure the attribute being viewed.[\/p][p][\/p][\/*][\/list][p]If you encounter any issues during gameplay, welcome to join our official discussion community, where you can discuss the game with other players.[\/p][p][\/p][p]Forms:[\/p][p][url=\"https:\/\/forms.office.com\/r\/jVC50yxVLn\"]https:\/\/forms.office.com\/r\/jVC50yxVLn[\/url][\/p][p][\/p][p]Discord:[\/p][p][url=\"https:\/\/2pgames.net\/discord\"]2pgames.net\/discord[\/url][\/p][p][\/p][p]Ver 1.0.3[\/p][p]Version Date: 2026.10.16[\/p][p]\u00a0[\/p]","commentcount":18,"tags":["patchnotes","mod_reviewed","ModAct_1526778620_1792146268_0"],"language":0,"hidden":0,"forum_topic_id":"706660083369676446","event_gid":"676260695908549355","voteupcount":148,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"706660083369676446","rtime32_last_modified":1793375703,"news_post_gid":"0","rtime_mod_reviewed":1792146268,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792136727,"votes_up":148,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"594036760294576281","gidfeature2":"706660083369676446"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["667251596450594946","685265358467105595"],"last_update_event":{"rtime":1792145160,"event_gid":"676260695908549355","announcement_gid":"676260695908549356","clan_account_id":45793792}}};
						</script>
					


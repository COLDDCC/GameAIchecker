ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"708912427613294761","clanid":"45855663","posterid":"0","headline":"FIXES EVERY DAY","posttime":1792657498,"updatetime":1792657498,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45855663\/44a5e437bbe4b73df712d537f50d94c74beccbab.png\"][\/img][\/p][p]Dear Survivors,[\/p][p][\/p][p]Thank you for your feedback - both positive and negative.\u00a0[\/p][p][\/p][p]We're taking everything into account and continuing to work on the game.\u00a0[\/p][p][\/p][p]All the fixes arising from bug reports, that are required in the first place, will be released outside the schedule. Then we'll get back to our weekly update schedule.[\/p][p][\/p][p]Thanks again and see you in the next updates![\/p][p][\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45855663\/399a14ab3ef77984d9f6006498323782c3124bbb.jpg\"][\/img][\/p]","commentcount":47,"tags":["mod_reviewed","ModAct_1415716708_1792659217_0"],"language":0,"hidden":0,"forum_topic_id":"573804438794437156","event_gid":"708912427613294760","voteupcount":132,"votedowncount":5,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"573804438794437156","rtime32_last_modified":1793377902,"news_post_gid":"0","rtime_mod_reviewed":1792659217,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792657481,"votes_up":132,"votes_down":5,"comment_type":"ForumTopic","gidfeature":"837249163025507717","gidfeature2":"573804438794437156"},{"gid":"708913061799397383","clan_steamid":"103582791475377071","event_name":"Update, version 0.56.1","event_type":12,"appid":4094350,"server_address":null,"server_password":null,"rtime32_start_time":1793376134,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"708913061799397384","clanid":"45855663","posterid":"0","headline":"Update, version 0.56.1","posttime":1793376134,"updatetime":1793376134,"body":"[b]Update\n\nVersion 0.56.1[\/b]\n\n1. Added: a map marker showing where the player died.  \n2. Added: a visual indicator for the death backpack to make it easier to find at the location.  \n3. Improvement: fuel consumption for vehicles and generators has been reduced by half.  \n4. Fixed: translations were missing for some notes.  \n5. Fixed: pumpkins could not be placed.","commentcount":3,"tags":["patchnotes","mod_reviewed","ModAct_1827889981_1793379026_0"],"language":0,"hidden":0,"forum_topic_id":"574930972896974640","event_gid":"708913061799397383","voteupcount":26,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930972896974640","rtime32_last_modified":1793399331,"news_post_gid":"0","rtime_
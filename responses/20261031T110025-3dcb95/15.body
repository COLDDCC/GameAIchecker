ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"708913061799397152","clanid":"45855663","posterid":"0","headline":"Halloween Event 2026","posttime":1793324912,"updatetime":1793324912,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45855663\/04b681d70146afb0ed4cff6cec9f7b705a1046db.png\"][\/img][\/p][p][b]Update[\/b][\/p][p][b]Version 0.56[\/b][\/p][olist][*][p]Halloween event in [b]Online: 404[\/b]! Meet a special Halloween enemy, decorate your home, and find a music player and cassette tape to add some spooky atmosphere.[\/p][\/*][*][p]Fixed: the story dialogue with Charlie could sometimes break, preventing players from receiving further messages and objectives in [b]Reminders[\/b], which blocked story progression.[\/p][\/*][*][p]Fixed: the position of a base door could sometimes be different for the host and client.[\/p][\/*][*][p]Fixed: in co-op, the campfire flame could sometimes be invisible to the client, while cooking and smelting could continue even after the firewood had run out.[\/p][\/*][*][p]Fixed: if a placeable item was selected in the hotbar and then moved back into the inventory, its placement preview could remain active and allow the item to be placed without consuming it from the inventory.[\/p][\/*][*][p]Fixed: picking up an object with its own inventory could cause errors when adding that object to the player\u2019s inventory.[\/p][\/*][*][p]Fixed: zombies could attack player-built structures even in Peaceful Mode.[\/p][\/*][*][p]Fixed: the wooden base door had no opening or closing sound.[\/p][\/*][\/olist]","commentcount":10,"tags":["mod_reviewed","ModAct_1911576989_1793326254_0"],"language":0,"hidden":0,"forum_topic_id":"574930972896903921","event_gid":"708913061799397151","voteupcount":64,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"574930972896903921","rtime32_last_modified":1793410035,"news_post_gid":"0","rtime_mod_reviewed":1793326255,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793324897,"votes_up":64,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"837249163025507717","gidfeature2":"574930972896903921"},{"gid":"708912427613294760","clan_steamid":"103582791475377071","event_name":"FIXES EVERY DAY","event_type":28,"appid":4094350,"server_address":null,"server_password":null,"rtime32_start_time":1792657440,"rtime32_end_time":1792661040,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see an
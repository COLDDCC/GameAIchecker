ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"693149194510139760","clanid":"45761361","posterid":"0","headline":"Cheater's Table Nominated for Best Multiplayer Game at Kristal Piksel 2026!\ud83c\udf89","posttime":1791993039,"updatetime":1791994018,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45761361\/f7743b904adb41172a2c457ba20987059aa19bd8.png\"][\/img][\/p][p]We're excited to share that Cheater's Table has been nominated for \"Best Multiplayer Game\" at the Kristal Piksel 2026 Awards![\/p][p]What started as a project developed by just three people has grown into something we're incredibly proud of.[\/p][p]A huge thank you to everyone who has played Cheater's Table, shared it with friends, created videos, reported bugs, and helped us improve the game throughout Early Access.[\/p][p]Your support means a lot to our small indie team![\/p][p]The winners will be announced on October 16. Congratulations to all the other nominees![\/p][p]See you at the table![\/p][p]Lagari Team[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1607812438_1791994382_0"],"language":0,"hidden":0,"forum_topic_id":"570426104667501942","event_gid":"693149194510139759","voteupcount":6,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1791993120,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426104667501942","rtime32_last_modified":1793023457,"news_post_gid":"0","rtime_mod_reviewed":1791994383,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791992868,"votes_up":6,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"569288155748961656","gidfeature2":"570426104667501942"},{"gid":"711162959377728250","clan_steamid":"103582791475282769","event_name":"Major Update: Co-op, the Cadillac Train, the +333 Card & More!","event_type":14,"appid":3951810,"server_address":null,"server_password":null,"rtime32_start_time":1791414840,"rtime32_end_time":1791419401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"\ud83e\udd1d Co-op mode is here! Pick a partner and take your seats together. This update brings co-op mode, a new punishment, and new ways to bring players to the same table!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"df6adb4d5479f7333b831b58b804469a366e7c59.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"19d2f0b4a8b9550183a8564d7ebac7b85ab8ad5d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false,\"rt_migrated_time\":1791417847.589}","announcement_body":{"gid":"711162959377728251","clanid":"45761361","posterid":"0","headline":"Major Update: Co-op, the Cadillac Train, the +333 Card & More!","posttime":1791414887,"updatetime":1791489552,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45761361\/19d2f0b4a8b9550183a8564d7ebac7b85ab8ad5d.png\"][\/img]Pick a partner and take your seats! [\/p][p]This update brings co-op mode, a new reward for daring cheaters, the Cadillac Train, and new ways to bring players together.[\/p][p][\/p][p]\ud83e\udd1d Co-op Mode Is Here![\/p][p]Team up with a partner, take on your opponents, and share the risks![\/p][p]\u2022 You can request a card from your partner twice per match.\n\u2022 You and your partner share penalties for cheating and traps.[\/p][p]Watch each other\u2019s backs. Your partner\u2019s risky decisions can get you into trouble too![\/p][p][\/p][p]\ud83c\udccf New Card: +333![\/p][p]Successful cheating now comes with a reward![\/p][p]To earn the +333 card, you must:[\/p][p]\u2022 Survive 4 cheat checks without getting caught. [\/p][p][\/p][p]\ud83d\ude82 New Punishment: The Cadillac Train[\/p][p]A new disaster is heading for the table: the Cadillac Train! Keep your eyes open when the next punishment comes.[\/p][p][\/p][p]\ud83d\udce8 Invite Solo Players to Your Table[\/p][p]You can now invite players who are playing with bots to join your lobby. Playing solo? An incoming invitation lets you join a table with other players.[\/p][p]\u2022 Lobby invitations can appear during solo play, on the main menu, and on the host lobby screen.\n\u2022 The lobby now shows whether invitations to solo players are enabled or disabled.[\/p][p][\/p][p]\ud83c\udf0d 7 New Languages.[\/p][p]Cheater's Table now speaks 7 new languages: Japanese, French, German, Traditional Chinese, Korean, Hindi, and Thai. The game is now playable in 14 languages.[\/p][p][\/p][p]\ud83d\udd27 Improvements and Bug Fixes[\/p][p]\u2022 Fixed cards floating or remaining suspended in the air.\n\u2022 Fixed issues that made players\u2019 cards invisible to other players, including after drawing a large number of cards.\n\u2022 Fixed bots skipping too many players when playing a Stop card.\n\u2022 Fixed action sequencing, turn flow, and incorrectly timed voice lines when bots cheated.\n\u2022 Fixed an issue that gave the wrong player the right to challenge in co-op mode.\n\u2022 Fixed the camera facing the wrong direction during the train punishment, causing players to miss the action.\n\u2022 Main menu music now fades out smoothly when a match starts.\n\u2022 Fixed many other bugs.[\/p][p]Thank you to everyone who plays, shares the game with friends, and helps us by reporting issues![\/p][p]See you at the table![\/p][p]Lagari Team[\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_487176015_1791415621_0","ModAct_487176015_1791420431_4","ModAct_1866137740_1791462808_4","ModAct_1878895840_1791492977_4"],"language":0,"hidden":0,"forum_topic_id":"590691669350908022","event_gid":"711162959377728250","voteupcount":7,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"590691669350908022","rtime32_last_modified":1791831109,"news_post_gid":"0","rtime_mod_reviewed":1791492978,"featured_app_tagid":0,"referenced_appids":[],"build_id":25789673,"build_branch":"","unlisted":0,"rtime_created":1791412008,"votes_up":7,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"569288155748961656","gidfeature2":"590691669350908022"},{"gid":"693149194510140238","clan_steamid":"103582791475282769","event_name":"October 16 Update","event_type":12,"appid":3951810,"server_address":null,"server_password":null,"rtime32_start_time":1792157227,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"693149194510140239","clanid":"45761361","posterid":"0","headline":"October 16 Update","posttime":1792157227,"updatetime":1792157227,"body":"Some knife direction bugs fixed.","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1889321037_1792158464_0"],"language":0,"hidden":0,"forum_topic_id":"570426339809563885","event_gid":"693149194510140238","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426339809563885","rtime32_last_modified":1793319548,"news_post_gid":"0","rtime_mod_reviewed":1792158464,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792157227,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"569288155748961656","gidfeature2":"570426339809563885"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["693149194510139760","711162959377728251"],"last_update_event":{"rtime":1792157227,"event_gid":"693149194510140238","announcement_gid":"693149194510140239","clan_account_id":45761361}}};
						</script>
					


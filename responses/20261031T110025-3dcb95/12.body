																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"679637128142915277","clan_steamid":"103582791475370152","event_name":"Update 1.0.25","event_type":13,"appid":4072240,"server_address":null,"server_password":null,"rtime32_start_time":1791022560,"rtime32_end_time":1791027001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Now the bushes are definitely fixed.\",\"Jetzt ist das Problem mit den B\u00fcschen endg\u00fcltig behoben.\",\"Cette fois, les buissons sont bel et bien corrig\u00e9s.\",\"Ora i cespugli sono sistemati una volta per tutte.\",\"\uc774\ubc88\uc5d0\ub294 \ub364\ubd88 \ubb38\uc81c\uac00 \ud655\uc2e4\ud788 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",\"Ahora los arbustos est\u00e1n arreglados de verdad.\",\"\u8fd9\u6b21\u704c\u6728\u4e1b\u7684\u95ee\u9898\u786e\u5b9e\u4fee\u597d\u4e86\u3002\",\"\u9019\u6b21\u704c\u6728\u53e2\u7684\u554f\u984c\u78ba\u5be6\u4fee\u597d\u4e86\u3002\",\"\u0422\u0435\u043f\u0435\u0440\u044c \u043a\u0443\u0441\u0442\u044b \u0442\u043e\u0447\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b.\",\"\u0e04\u0e23\u0e32\u0e27\u0e19\u0e35\u0e49\u0e41\u0e01\u0e49\u0e1b\u0e31\u0e0d\u0e2b\u0e32\u0e1e\u0e38\u0e48\u0e21\u0e44\u0e21\u0e49\u0e44\u0e14\u0e49\u0e41\u0e19\u0e48\u0e19\u0e2d\u0e19\u0e41\u0e25\u0e49\u0e27\",\"\u4eca\u5ea6\u3053\u305d\u8302\u307f\u306e\u4e0d\u5177\u5408\u3092\u78ba\u5b9f\u306b\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\",\"Agora os arbustos est\u00e3o definitivamente corrigidos.\",\"Teraz krzaki s\u0105 ju\u017c na pewno naprawione.\",\"Nu er buskene helt sikkert rettet.\",\"Nu is het probleem met de struiken definitief opgelost.\",\"Nyt pensaat on varmasti korjattu.\",\"N\u00e5 er buskene helt sikkert rettet.\",\"Nu \u00e4r buskarna definitivt fixade.\",\"Most m\u00e1r biztosan kijav\u00edtottuk a bokrokat.\",\"Te\u010f u\u017e jsou ke\u0159e definitivn\u011b opraven\u00e9.\",\"Acum tufi\u0219urile sunt cu siguran\u021b\u0103 reparate.\",\"Bu kez \u00e7al\u0131lar kesin olarak d\u00fczeltildi.\",\"Agora os arbustos est\u00e3o definitivamente corrigidos.\",\"\u0421\u0435\u0433\u0430 \u0445\u0440\u0430\u0441\u0442\u0438\u0442\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043e \u0441\u0430 \u043f\u043e\u043f\u0440\u0430\u0432\u0435\u043d\u0438.\",\"\u03a4\u03ce\u03c1\u03b1 \u03bf\u03b9 \u03b8\u03ac\u03bc\u03bd\u03bf\u03b9 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03b1 \u03b4\u03b9\u03bf\u03c1\u03b8\u03c9\u03b8\u03b5\u03af.\",\"\u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0629 \u062a\u0645 \u0625\u0635\u0644\u0627\u062d \u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0634\u062c\u064a\u0631\u0627\u062a \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f.\",\"\u0422\u0435\u043f\u0435\u0440 \u043a\u0443\u0449\u0456 \u0442\u043e\u0447\u043d\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e.\",\"Ahora los arbustos est\u00e1n arreglados de verdad.\",\"L\u1ea7n n\u00e0y, l\u1ed7i b\u1ee5i c\u00e2y ch\u1eafc ch\u1eafn \u0111\u00e3 \u0111\u01b0\u1ee3c s\u1eeda.\",null,\"Kali ini masalah semak-semak benar-benar sudah diperbaiki.\",\"Kali ini masalah semak memang sudah diperbaiki.\"],\"localized_summary\":[\"Now the bushes are definitely fixed.\",\"Jetzt ist das Problem mit den B\u00fcschen endg\u00fcltig behoben.\",\"Cette fois, les buissons sont bel et bien corrig\u00e9s.\",\"Ora i cespugli sono sistemati una volta per tutte.\",\"\uc774\ubc88\uc5d0\ub294 \ub364\ubd88 \ubb38\uc81c\uac00 \ud655\uc2e4\ud788 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",\"Ahora los arbustos est\u00e1n arreglados de verdad.\",\"\u8fd9\u6b21\u704c\u6728\u4e1b\u7684\u95ee\u9898\u786e\u5b9e\u4fee\u597d\u4e86\u3002\",\"\u9019\u6b21\u704c\u6728\u53e2\u7684\u554f\u984c\u78ba\u5be6\u4fee\u597d\u4e86\u3002\",\"\u0422\u0435\u043f\u0435\u0440\u044c \u043a\u0443\u0441\u0442\u044b \u0442\u043e\u0447\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b.\",\"\u0e04\u0e23\u0e32\u0e27\u0e19\u0e35\u0e49\u0e41\u0e01\u0e49\u0e1b\u0e31\u0e0d\u0e2b\u0e32\u0e1e\u0e38\u0e48\u0e21\u0e44\u0e21\u0e49\u0e44\u0e14\u0e49\u0e41\u0e19\u0e48\u0e19\u0e2d\u0e19\u0e41\u0e25\u0e49\u0e27\",\"\u4eca\u5ea6\u3053\u305d\u8302\u307f\u306e\u4e0d\u5177\u5408\u3092\u78ba\u5b9f\u306b\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\",\"Agora os arbustos est\u00e3o definitivamente corrigidos.\",\"Teraz krzaki s\u0105 ju\u017c na pewno naprawione.\",\"Nu er buskene helt sikkert rettet.\",\"Nu is het probleem met de struiken definitief opgelost.\",\"Nyt pensaat on varmasti korjattu.\",\"N\u00e5 er buskene helt sikkert rettet.\",\"Nu \u00e4r buskarna definitivt fixade.\",\"Most m\u00e1r biztosan kijav\u00edtottuk a bokrokat.\",\"Te\u010f u\u017e jsou ke\u0159e definitivn\u011b opraven\u00e9.\",\"Acum tufi\u0219urile sunt cu siguran\u021b\u0103 reparate.\",\"Bu kez \u00e7al\u0131lar kesin olarak d\u00fczeltildi.\",\"Agora os arbustos est\u00e3o definitivamente corrigidos.\",\"\u0421\u0435\u0433\u0430 \u0445\u0440\u0430\u0441\u0442\u0438\u0442\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043e \u0441\u0430 \u043f\u043e\u043f\u0440\u0430\u0432\u0435\u043d\u0438.\",\"\u03a4\u03ce\u03c1\u03b1 \u03bf\u03b9 \u03b8\u03ac\u03bc\u03bd\u03bf\u03b9 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03b1 \u03b4\u03b9\u03bf\u03c1\u03b8\u03c9\u03b8\u03b5\u03af.\",\"\u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0629 \u062a\u0645 \u0625\u0635\u0644\u0627\u062d \u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0634\u062c\u064a\u0631\u0627\u062a \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f.\",\"\u0422\u0435\u043f\u0435\u0440 \u043a\u0443\u0449\u0456 \u0442\u043e\u0447\u043d\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e.\",\"Ahora los arbustos est\u00e1n arreglados de verdad.\",\"L\u1ea7n n\u00e0y, l\u1ed7i b\u1ee5i c\u00e2y ch\u1eafc ch\u1eafn \u0111\u00e3 \u0111\u01b0\u1ee3c s\u1eeda.\",null,\"Kali ini masalah semak-semak benar-benar sudah diperbaiki.\",\"Kali ini masalah semak memang sudah diperbaiki.\"],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"d82dd42f047623a16e58a78999ba955fdff8fb86.png\",null,null,null,null,null,null,null,\"d82dd42f047623a16e58a78999ba955fdff8fb86.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679637128142915278","clanid":"45848744","posterid":"0","headline":"Update 1.0.25","posttime":1791022578,"updatetime":1791029375,"body":"[list][*][p][b]The bushes are now FIXED FOR SURE. Due to the different loading order of the objects, they might not be able to restore their location and loaded at zero coordinates. The fix should also work on old saves.[\/b][\/p][\/*][*][p][b]Fixed an issue where quickly putting clothes in the washing machine could cause them to fall through. (Spam Q)[\/b][\/p][\/*][*][p][b]Fixed a bug where saving\/loading broke the Goal achievement[\/b][\/p][\/*][*][p][b]Fixed a bug: if you end the day without talking to Mikhail during the check, the dialogue with him was blocked.[\/b][\/p][\/*][*][p][b]During menstruation, the correct mood change is now shown in the UI (previously, the default values were shown, but actually decreased a little more.[\/b][\/p][\/*][*][p][b]Items that can be thrown into the trash can are now also magnetized to it.[\/b][\/p][\/*][\/list][p][\/p][h3][\/h3][h3]You can also add our other games to your wish list[\/h3][h3][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3424910\/_\/\"][\/dynamiclink][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4612860\/Delivery_Control\/\"][\/dynamiclink][\/h3][h3]Follow the news in [url=\"https:\/\/t.me\/sebasa_games\"][b]Telegram[\/b][\/url][b] [\/b]and [url=\"https:\/\/discord.gg\/yPceKfhNpV\"][b]Discord[\/b][\/url][\/h3]","commentcount":8,"tags":["mod_reviewed","ModAct_1889357040_1791023752_0","ModAct_1889357040_1791029514_4"],"language":0,"hidden":0,"forum_topic_id":"589565404421071287","event_gid":"679637128142915277","voteupcount":74,"votedowncount":4,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"589565404421071287","rtime32_last_modified":1793025558,"news_post_gid":"0","rtime_mod_reviewed":1791029515,"featured_app_tagid":0,"referenced_appids":[],"build_id":25694780,"build_branch":"","unlisted":0,"rtime_created":1791021116,"votes_up":74,"votes_down":4,"comment_type":"ForumTopic","gidfeature":"755052476150919865","gidfeature2":"589565404421071287"},{"gid":"679636495422719786","clan_steamid":"103582791475370152","event_name":"Update 1.0.23","event_type":13,"appid":4072240,"server_address":null,"server_password":null,"rtime32_start_time":1790611500,"rtime32_end_time":1790616601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Fixing clothes spawn and a bush quest\",\"Korrekturen an den Spawnpunkten der Kleidung und der Aufgabe zum Buschschneiden\",\"Corrections de l'apparition des v\u00eatements et de la qu\u00eate de taille des buissons\",\"Correzioni alla comparsa dei vestiti e alla missione di potatura dei cespugli\",\"\uc637 \uc0dd\uc131 \uc704\uce58 \ubc0f \ub364\ubd88 \ub2e4\ub4ec\uae30 \ud018\uc2a4\ud2b8 \uc218\uc815\",\"Correcciones en la aparici\u00f3n de ropa y en la misi\u00f3n de podar arbustos\",\"\u4fee\u590d\u8863\u7269\u751f\u6210\u548c\u4fee\u526a\u704c\u6728\u4efb\u52a1\u7684\u95ee\u9898\",\"\u4fee\u6b63\u8863\u7269\u751f\u6210\u548c\u4fee\u526a\u704c\u6728\u4efb\u52d9\u7684\u554f\u984c\",\"\u0420\u0443\u0441\u0441\u043a\u0430\u044f \u043e\u0437\u0432\u0443\u0447\u043a\u0430, \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0434\u0435\u0436\u0434\u044b \u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u0442\u0440\u0438\u0436\u043a\u0443 \u043a\u0443\u0441\u0442\u043e\u0432\",\"\u0e41\u0e01\u0e49\u0e44\u0e02\u0e08\u0e38\u0e14\u0e40\u0e01\u0e34\u0e14\u0e40\u0e2a\u0e37\u0e49\u0e2d\u0e1c\u0e49\u0e32\u0e41\u0e25\u0e30\u0e40\u0e04\u0e27\u0e2a\u0e15\u0e4c\u0e15\u0e31\u0e14\u0e41\u0e15\u0e48\u0e07\u0e1e\u0e38\u0e48\u0e21\u0e44\u0e21\u0e49\",\"\u8863\u985e\u306e\u51fa\u73fe\u4f4d\u7f6e\u3068\u8302\u307f\u306e\u526a\u5b9a\u30af\u30a8\u30b9\u30c8\u3092\u4fee\u6b63\",\"Corre\u00e7\u00f5es no aparecimento de roupa e na miss\u00e3o de podar arbustos\",\"Poprawki miejsc pojawiania si\u0119 ubra\u0144 i zadania przycinania krzew\u00f3w\",\"Rettelser til t\u00f8jets placering og opgaven med at klippe buske\",\"Oplossingen voor het verschijnen van kleding en de opdracht om struiken te snoeien\",\"Korjauksia vaatteiden ilmestymispaikkoihin ja pensaiden leikkausteht\u00e4v\u00e4\u00e4n\",\"Rettelser for hvor kl\u00e6r dukker opp og oppdraget med \u00e5 klippe busker\",\"Fixar f\u00f6r var kl\u00e4der dyker upp och uppdraget att klippa buskar\",\"A ruh\u00e1k megjelen\u00e9si helyeinek \u00e9s a bokorny\u00edr\u00e1si k\u00fcldet\u00e9snek a jav\u00edt\u00e1sa\",\"Opravy objevov\u00e1n\u00ed oble\u010den\u00ed a \u00fakolu se st\u0159\u00edh\u00e1n\u00edm ke\u0159\u016f\",\"Corec\u021bii la apari\u021bia hainelor \u0219i la misiunea de tundere a tufi\u0219urilor\",\"K\u0131yafet olu\u015fma noktalar\u0131 ve \u00e7al\u0131 budama g\u00f6revi d\u00fczeltildi\",\"Corre\u00e7\u00f5es no surgimento de roupas e na miss\u00e3o de podar arbustos\",\"\u041f\u043e\u043f\u0440\u0430\u0432\u043a\u0438 \u043f\u043e \u043f\u043e\u044f\u0432\u0430\u0442\u0430 \u043d\u0430 \u0434\u0440\u0435\u0445\u0438 \u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430 \u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0445\u0440\u0430\u0441\u0442\u0438\",\"\u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c1\u03bf\u03cd\u03c7\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae \u03ba\u03bb\u03b1\u03b4\u03ad\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b8\u03ac\u03bc\u03bd\u03c9\u03bd\",\"\u0625\u0635\u0644\u0627\u062d \u0638\u0647\u0648\u0631 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0648\u0645\u0647\u0645\u0629 \u062a\u0634\u0630\u064a\u0628 \u0627\u0644\u0634\u062c\u064a\u0631\u0627\u062a\",\"\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u043e\u044f\u0432\u0438 \u043e\u0434\u044f\u0433\u0443 \u0442\u0430 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0437 \u043f\u0456\u0434\u0441\u0442\u0440\u0438\u0433\u0430\u043d\u043d\u044f \u043a\u0443\u0449\u0456\u0432\",\"Correcciones en la aparici\u00f3n de ropa y en la misi\u00f3n de podar arbustos\",\"S\u1eeda v\u1ecb tr\u00ed xu\u1ea5t hi\u1ec7n qu\u1ea7n \u00e1o v\u00e0 nhi\u1ec7m v\u1ee5 t\u1ec9a b\u1ee5i c\u00e2y\",null,\"Perbaikan kemunculan pakaian dan misi pemangkasan semak\",\"Pembetulan kemunculan pakaian dan misi memangkas semak\"],\"localized_summary\":[\"Fixing clothes spawn and a bush quest\",\"Korrekturen an den Spawnpunkten der Kleidung und der Aufgabe zum Buschschneiden\",\"Corrections de l'apparition des v\u00eatements et de la qu\u00eate de taille des buissons\",\"Correzioni alla comparsa dei vestiti e alla missione di potatura dei cespugli\",\"\uc637 \uc0dd\uc131 \uc704\uce58 \ubc0f \ub364\ubd88 \ub2e4\ub4ec\uae30 \ud018\uc2a4\ud2b8 \uc218\uc815\",\"Correcciones en la aparici\u00f3n de ropa y en la misi\u00f3n de podar arbustos\",\"\u4fee\u590d\u8863\u7269\u751f\u6210\u548c\u4fee\u526a\u704c\u6728\u4efb\u52a1\u7684\u95ee\u9898\",\"\u4fee\u6b63\u8863\u7269\u751f\u6210\u548c\u4fee\u526a\u704c\u6728\u4efb\u52d9\u7684\u554f\u984c\",\"\u0420\u0443\u0441\u0441\u043a\u0430\u044f \u043e\u0437\u0432\u0443\u0447\u043a\u0430, \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0434\u0435\u0436\u0434\u044b \u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u0442\u0440\u0438\u0436\u043a\u0443 \u043a\u0443\u0441\u0442\u043e\u0432\",\"\u0e41\u0e01\u0e49\u0e44\u0e02\u0e08\u0e38\u0e14\u0e40\u0e01\u0e34\u0e14\u0e40\u0e2a\u0e37\u0e49\u0e2d\u0e1c\u0e49\u0e32\u0e41\u0e25\u0e30\u0e40\u0e04\u0e27\u0e2a\u0e15\u0e4c\u0e15\u0e31\u0e14\u0e41\u0e15\u0e48\u0e07\u0e1e\u0e38\u0e48\u0e21\u0e44\u0e21\u0e49\",\"\u8863\u985e\u306e\u51fa\u73fe\u4f4d\u7f6e\u3068\u8302\u307f\u306e\u526a\u5b9a\u30af\u30a8\u30b9\u30c8\u3092\u4fee\u6b63\",\"Corre\u00e7\u00f5es no aparecimento de roupa e na miss\u00e3o de podar arbustos\",\"Poprawki miejsc pojawiania si\u0119 ubra\u0144 i zadania przycinania krzew\u00f3w\",\"Rettelser til t\u00f8jets placering og opgaven med at klippe buske\",\"Oplossingen voor het verschijnen van kleding en de opdracht om struiken te snoeien\",\"Korjauksia vaatteiden ilmestymispaikkoihin ja pensaiden leikkausteht\u00e4v\u00e4\u00e4n\",\"Rettelser for hvor kl\u00e6r dukker opp og oppdraget med \u00e5 klippe busker\",\"Fixar f\u00f6r var kl\u00e4der dyker upp och uppdraget att klippa buskar\",\"A ruh\u00e1k megjelen\u00e9si helyeinek \u00e9s a bokorny\u00edr\u00e1si k\u00fcldet\u00e9snek a jav\u00edt\u00e1sa\",\"Opravy objevov\u00e1n\u00ed oble\u010den\u00ed a \u00fakolu se st\u0159\u00edh\u00e1n\u00edm ke\u0159\u016f\",\"Corec\u021bii la apari\u021bia hainelor \u0219i la misiunea de tundere a tufi\u0219urilor\",\"K\u0131yafet olu\u015fma noktalar\u0131 ve \u00e7al\u0131 budama g\u00f6revi d\u00fczeltildi\",\"Corre\u00e7\u00f5es no surgimento de roupas e na miss\u00e3o de podar arbustos\",\"\u041f\u043e\u043f\u0440\u0430\u0432\u043a\u0438 \u043f\u043e \u043f\u043e\u044f\u0432\u0430\u0442\u0430 \u043d\u0430 \u0434\u0440\u0435\u0445\u0438 \u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430 \u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0445\u0440\u0430\u0441\u0442\u0438\",\"\u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c1\u03bf\u03cd\u03c7\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae \u03ba\u03bb\u03b1\u03b4\u03ad\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b8\u03ac\u03bc\u03bd\u03c9\u03bd\",\"\u0625\u0635\u0644\u0627\u062d \u0638\u0647\u0648\u0631 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0648\u0645\u0647\u0645\u0629 \u062a\u0634\u0630\u064a\u0628 \u0627\u0644\u0634\u062c\u064a\u0631\u0627\u062a\",\"\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u043e\u044f\u0432\u0438 \u043e\u0434\u044f\u0433\u0443 \u0442\u0430 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0437 \u043f\u0456\u0434\u0441\u0442\u0440\u0438\u0433\u0430\u043d\u043d\u044f \u043a\u0443\u0449\u0456\u0432\",\"Correcciones en la aparici\u00f3n de ropa y en la misi\u00f3n de podar arbustos\",\"S\u1eeda v\u1ecb tr\u00ed xu\u1ea5t hi\u1ec7n qu\u1ea7n \u00e1o v\u00e0 nhi\u1ec7m v\u1ee5 t\u1ec9a b\u1ee5i c\u00e2y\",null,\"Perbaikan kemunculan pakaian dan misi pemangkasan semak\",\"Pembetulan kemunculan pakaian dan misi memangkas semak\"],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"d82dd42f047623a16e58a78999ba955fdff8fb86.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"679636495422719787","clanid":"45848744","posterid":"0","headline":"Update 1.0.23","posttime":1790611552,"updatetime":1790611552,"body":"[h3]We continue to fix the game, recently the sound, inaccuracies of the voiceover, inaccuracies of recipes, missing items in the laundry (this was a feature), the food timer, FOV settings, and the trash can were fixed.  At the moment, the new fixes are:[\/h3][list][*][p][i][b]Added Russian voiceover (voiceover language selection has also been added to the menu when starting a new game)[\/b][\/i][\/p][\/*][*][p][b][i]Added professional localization in Traditional and Simplified Chinese[\/i][\/b][\/p][\/*][*][p][i][b]Reworked dirty clothing spawn points, removing them from hard-to-see locations.[\/b][\/i][\/p][\/*][*][p][i][b]Fixed the bush trimming quest.[\/b][\/i][\/p][\/*][*][p][i][b]Added voiceover language selection and motion blur to the start menu when starting a new game.[\/b][\/i][\/p][\/*][*][p][i][b]Updated the cooking prompt to indicate that you can't turn off the stove\/oven prematurely.[\/b][\/i][\/p][\/*][*][p][i][b]Added a prompt when completing documents, if applicable.[\/b][\/i][\/p][\/*][*][p][i][b]Dialogue titles now fade out correctly.[\/b][\/i][\/p][\/*][*][p][b]Now you can reset the training in the settings[\/b][\/p][\/*][\/list][p][\/p][h3]We are currently working on new features and voice acting in French and German.[\/h3][h3][\/h3][h3]You may also be interested in the mushroom picking game.[\/h3][h3][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3424910\/_\/\"][\/dynamiclink]or dating simulator with elements of psychological horror and escape room[\/h3][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/3911120\/\"][\/dynamiclink][\/p][h2]Follow the news in [url=\"https:\/\/t.me\/sebasa_games\"][b]Telegram[\/b][\/url][b] [\/b]and [url=\"https:\/\/discord.gg\/yPceKfhNpV\"][b]Discord[\/b][\/url][\/h2]","commentcount":20,"tags":["mod_reviewed","ModAct_1889321037_1790615089_0"],"language":0,"hidden":0,"forum_topic_id":"589564796296449365","event_gid":"679636495422719786","voteupcount":67,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"589564796296449365","rtime32_last_modified":1792342943,"news_post_gid":"0","rtime_mod_reviewed":1790615090,"featured_app_tagid":0,"referenced_appids":[],"build_id":25582435,"build_branch":"","unlisted":0,"rtime_created":1790597471,"votes_up":67,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"755052476150919865","gidfeature2":"589564796296449365"},{"gid":"679637128142915808","clan_steamid":"103582791475370152","event_name":"Update 1.0.26","event_type":12,"appid":4072240,"server_address":null,"server_password":null,"rtime32_start_time":1791300240,"rtime32_end_time":1791304201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_heade
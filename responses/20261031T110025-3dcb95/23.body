							var StoreDefaults = {"PartnerEventStore":[{"gid":"689772129194871871","clan_steamid":"103582791475627290","event_name":"Title Update - October 21, 2026","event_type":13,"appid":3940610,"server_address":null,"server_password":null,"rtime32_start_time":1792621500,"rtime32_end_time":1792625401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"1d0701379c09e1727635a7978b51cc3eb2c03852.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e60ffdf8838cb6b2a318069e7822c952294706cb.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"689772129194871872","clanid":"46105882","posterid":"0","headline":"Title Update - October 21, 2026","posttime":1792621549,"updatetime":1792621549,"body":"Hey Madden fans!\n\nWelcome back to our Madden NFL 27 Gridiron Notes, your source for all news and updates straight from our developer team. Most Feared Season is here already and so is our latest Title Update. We have a lot of information to share with you today so let's get started. \n\n[h2][b]Gameplay[\/b][\/h2]\n[list]\n[*] Added 4 New Celebration Animations exclusively for Aaron Rodgers\n[list][*] [b]Dev Note:[\/b] [i]Last month, we invited Rodgers Realm to come in and collaborate with our motion capture team in the studio to exclusively record celebration animations. These are now available for you to try when you celebrate with Aaron Rodgers in Play Now, Franchise, Ultimate Team, and can be equipped on your Avatar in Superstar. Learn more about it [url=https:\/\/www.instagram.com\/p\/DesOSU3Gcwt\/?rpxt=M2lkMW12NWNlZWNm&img_index=1]here[\/url].[\/i] **[\/list][*] Fixed an issue with coverage-calls Pounder, Roll Ring, Roll King, and Cover 9 so that Quarters safeties will now appropriately match verticals regardless of the underneath man\/match assignments by teammates.\n[*] Slightly Tuned the Double or Nothing Ability to be less effective.\n[list][*] [b]Dev Note:[\/b] [i]This tuning was done to all tiers of the ability.[\/i][\/list][*] Fixed an issue where DBs would switch assignments in Combo and Point Combo when the receiver is blocking\n[*] Fixed an issue where players in rare situations were auto subbed out during hurry up.\n[*] Fixed an issue that allowed users to audible during hurry up without resetting the defensive package.\n[*] Tuning to improve AI logic when using Pass Commit vs. HB Double Pass.\n[*] Players outside of the tackle box will no longer be targeted with Empty Protection unless manually ID\u2019d. \n[*] Defenders \u2018Untargeted\u2019 by the User will now be completely ignored. \n[*] Lane assignments on kickoff will now flip for teams with left footed kickers. \n[\/list]\n[h2][b]Franchise Mode[\/b][\/h2]\n\n[b]From the Dev Team: [\/b][i]Hey Madden fans! In our last Title Update, we mentioned that additional salary-cap and CPU roster-management fixes were in progress. This update continues that work, alongside fixes to player progression, contracts, and custom roster and Custom Draft Classes. If you want to receive all of the Salary Cap updates that we included in this Title Update, we recommend that players start new Franchise Leagues, all of the additional updates will not require new leagues.[\/i]\n\n[h3][b]CPU Roster Management[\/b][\/h3]\n[list]\n[*] Improved CPU re-signing so teams are less likely to let key players reach free agency, and fixed player-mindset issues that could block negotiations or push a player toward free agency before his team had a chance to re-sign him.\n[*] Addressed inflated contract bonuses and CPU handling of large contracts that were contributing to salary-cap problems as leagues progressed.\n[*] Teams are less likely to restructure contracts when their roster needs don't call for it.\n[*] Fixed an issue that could leave recovered players stuck on a CPU team's injured reserve.\n[*] CPU teams will no longer sign non-exclusive franchise-tagged low-value players in free agency.\n[*] CPU teams will now cut low-performing players with large cap savings at the start of the offseason.\n[\/list]\n[h3][b]Contracts & Dynamic Salary Cap[\/b][\/h3]\n[list]\n[*] CPU salary-cap decisions now account for cap space carried over from the previous season.\n[*] Corrected salary-cap calculations involving contract incentives when extending, releasing, or trading players.\n[*] Corrected restructure calculations on contracts with void years that could let users avoid contract payments.\n[*] Improved the consistency of the annual Dynamic Salary Cap adjustment by correcting the financial data used at season rollover.\n[*] Fifth-year option money is now applied to guaranteed salary instead of signing bonus.\n[*] Fixed an issue where users could offer contracts below the required Franchise, Transition, and Non-Exclusive tag values.\n[*] Added the \"Next Year's Cap\" readout to player extension conversations.\n[*] Fixed an issue where, with the Salary Cap turned off, users were unable to offer max contracts, and corrected the over-the-cap warning popup not displaying correctly.\n[\/list]\n[h3][b]Player Progression & Wear and Tear[\/b][\/h3]\n[list]\n[*] Addressed excessive player progression during multi-season simulation, along with cases where players were retiring too early.\n[*] Fixed an issue where CPU players could still show Wear and Tear effects when the setting was turned off.\n[\/list]\n[h3][b]Custom Rosters, Draft Classes & Depth Charts[\/b][\/h3]\n[list]\n[*] Fixed an issue that prevented custom draft classes from downloading and importing through Franchise and the Download Center.\n[*] Corrected custom roster imports that were adding incorrect guaranteed contract years. Keeping the original NFL roster when importing a TeamBuilder team no longer incorrectly advances players' ages, years pro, or contracts.\n[*] Fixed an issue where Auto Reorder wasn't updating the depth chart correctly.\n[\/list]\n[i]We will continue monitoring your feedback on salary-cap management and CPU roster decisions as Franchise leagues progress.[\/i]\n\n[h2][b]Superstar[\/b][\/h2]\n\n[h3][b]Showdown Stability[\/b][\/h3]\n[list]\n[*] Addressed an issue where players could become stuck on a loading screen if another player disconnected immediately after the match countdown in Ranked Solo or Squad Practice vs. CPU.\n[\/list]\n[h3][b]Progression and Play Art[\/b][\/h3]\n[list]\n[*] Addressed an issue where the postgame progression screen displayed incorrect Player Grade XP.\n[*] Addressed an issue where the tight end block-and-release play art displayed the incorrect route color at the line of scrimmage.\n[\/list]\n[h3][b]Store Improvements[\/b][\/h3]\n[list]\n[*] Addressed an issue preventing eligible Skill Points bundles from being purchased multiple times within the same session.\n[*] Addressed an issue where Skill Points bundles remained available after reaching their purchase limit, resulting in a server error when attempting another purchase.\n[*] Addressed an issue where Superstar Pass level-purchase previews displayed cosmetic rewards already owned through another avatar\u2019s pass.\n[\/list]\n[h2][b]Presentation[\/b][\/h2]\n\n[h3][b]Drive Starters[\/b][\/h3]\n[list]\n[*] Fixed an issue that sometimes prevented highlights from appearing during a drive starter.\n[*] Fixed an issue with incorrect stats that could appear in the quarterback banner.\n[*] Fixed incorrect banner text for a quarterback in their 22nd NFL season.\n[\/list]\n[h3][b]Cameras[\/b][\/h3]\n[list]\n[*] Fixed the broken camera that could appear for iced kicks.\n[\/list]\n[h3][b]Equipment[\/b][\/h3]\n\n[b]New Helmet Facemasks[\/b]\n\n[b]Dev Note: [\/b][i]We have 47 total new facemasks available for you to try, here are some that we have highlighted below. [\/i]\n\n[list]\n[*][b] Axiom:[\/b]\n[list][*] 2 Bar variations\n[*] 3 Bar variations\n[*] 808 variations\n[*] Grid variations\n[*] Robot cage\n[*] Spyder variations\n[*] Axiom Bain Mask[\/list]\n[*] [b]Speedflex:[\/b]\n[list][*] 2 Bar\n[*] 4 Bar\n[*] Robot variations\n[*] Speedflex Bain Mask[\/list]\n[*] [b]Light:[\/b]\n[list][*] 2 Bar\n[*] 3 Bar\n[*] Fullcage\n[*] Kicker\n[*] Ranger\n[*] Trooper[\/list]\n[\/list][b]Mascot Uniform Updates\n[\/b]\n[list]\n[*] Eagles \n[*] Lions \n[*] Bengals \n[*] Rams \n[*] Falcons \n[\/list]\n[h3][b]Stadium Updates & Authenticity[\/b][\/h3]\n[list]\n[*] Reskin Updates made to Sofi Stadium.\n[*] Added Most Feared Seasonal Updates to MCS Field.\n[*] Authenticity Updates made to Highmark Stadium.\n[*] Nissan Stadium Endzone Authenticity Updates.\n[*] Updates to the Mercedes-Benz Stadium Field Paint.\n[\/list]\n[b]Stadium Rivalries Updates\n[\/b]\n[list]\n[*] Stadium NFL Rivalries Reskins\n[list][*] [b]Dev Note:[\/b] [i]To celebrate NFL Rivalries, the following teams are receiving stadium and field updates to match their uniforms. When you select their uniforms in Play Now, the stadium will receive those updates.[\/i][\/list][list][list][*] Detroit Lions\n[*] Tennessee Titans\n[*] Jacksonville Jaguars[\/list][\/list][\/list][b]International Stadium[\/b]\n[list]\n[*] Stade de France International Stadium added. \n[*] We have made updates to some International Stadium Coach Boxes & Inspire Change Endzone Updates.\n[\/list]\n[h2][b]Ultimate Team[\/b][\/h2]\n[list]\n[*] Addressed various issues to improve online stability and reduce disconnects in Ultimate Team.\n[*] Fixed an issue preventing users from favoriting an objective on an item.\n[*] Fixed an issue where the Opponent's first down line was not visible during H2H Seasons games.\n[*] Fixed an issue where the new item count was not always displayed after opening a pack.\n[\/list]\nThank you all for your feedback and see you on the Gridiron! \n\n- Madden NFL 27 Developer Team\n\nSee [url=\"https:\/\/www.ea.com\/games\/madden-nfl\/madden-nfl-27\/game-disclaimers\"]disclaimers[\/url] for details. Stay in the conversation by following us on [url=\"https:\/\/www.facebook.com\/EASPORTSMADDENNFL\"]Facebook[\/url], [url=\"https:\/\/x.com\/eamaddennfl\"]Twitter[\/url], [url=\"https:\/\/www.instagram.com\/eamaddennfl\/\"]Instagram[\/url], [url=\"https:\/\/www.youtube.com\/eamaddennfl\"]YouTube[\/url], and [url=\"https:\/\/forums.ea.com\/category\/ea-forums-en\"]Answers HQ[\/url].","commentcount":16,"tags":["mod_reviewed","ModAct_1751656904_1792621603_0"],"language":0,"hidden":0,"forum_topic_id":"570426739071736474","event_gid":"689772129194871871","voteupcount":33,"votedowncount":7,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426739071736474","rtime32_last_modified":1793406742,"news_post_gid":"0","rtime_mod_reviewed":1792621603,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792603428,"votes_up":33,"votes_down":7,"comment_type":"ForumTopic","gidfeature":"840627060265233411","gidfeature2":"570426739071736474"},{"gid":"683016095346459544","clan_steamid":"103582791475627290","event_name":"Be the Most Feared in Madden NFL 27","event_type":35,"appid":3940610,"server_address":null,"server_password":null,"rtime32_start_time":1792177860,"rtime32_end_time":1793944800,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Become a Madden monster during Most Feared and build your most terrifying roster yet.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"From upgradeable Scientists to all-new players with terrifying new abilities, Most Feared gives you everything you need to craft a monstrous roster.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"1d0701379c09e1727635a7978b51cc3eb2c03852.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"4792f60e87bd44e3c60c70ef965f0a990139d9b0.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016095346459545","clanid":"46105882","posterid":"0","headline":"Be the Most Feared in Madden NFL 27","posttime":1792177872,"updatetime":1792177872,"body":"[previewyoutube=X1cHpSLkDsM;full][\/previewyoutube]\n\nStarting on October 15, step into the Lab and see what it takes to become a Madden monster during Most Feared. Want to build your most terrifying roster yet? Recruit mad Scientists to your roster with each Most Feared drop, then upgrade their madness with Doctor\u2019s Research items. \n\nFill out your roster and make opponents quake in fear with a variety of monstrous player items with new Scary Good Chemistries (like Power, Speed, or Tall). But you\u2019re not locked into a single Chemistry; add a Trick or Treat Costume Evo to any player to change their Scary Good Chemistry to suit your roster. Next, complete Challenges or exchange your Candy currency to snag deliciously scary players with Trick or Treat-themed abilities that can be upgraded even further with a Candy Bar item.\n\nCreating a terrifying roster in College Football 27 Ultimate Team too during Nightmares? Earn crossover rewards in both games and go from campus nightmare to NFL monster. In Madden NFL 27, there will be a Nightmares event with five reward tiers\u2013work your way up and earn crossover rewards in College Football Ultimate Team in tiers 2-5. \n\nDon\u2019t forget to work your way up the Pumpkin Pass for more rewards, complete Sets to earn Most Feared players, jump into H2H and Solo Challenges, and more. Earn and upgrade the scariest player the league has to offer. Add them to your roster and unleash them on the league you\u2019ve built. \n\nhttps:\/\/store.steampowered.com\/app\/3940610\/EA_SPORTS_Madden_NFL_27\/","commentcount":3,"tags":["mod_reviewed","ModAct_1878895840_1792183604_0"],"language":0,"hidden":0,"forum_topic_id":"571552240778639475","event_gid":"683016095346459544","voteupcount":18,"votedowncount":6,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552240778639475","rtime32_last_modified":1793315684,"news_post_gid":"0","rtime_mod_reviewed":1792183604,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792177845,"votes_up":18,"votes_down":6,"comment_type":"ForumTopic","gidfeature":"840627060265233411","gidfeature2":"571552240778639475"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["689772129194871872","683016095346459545"],"last_update_event":{"rtime":1792621500,"event_gid":"689772129194871871","announcement_gid":"689772129194871872","clan_account_id":46105882}}};

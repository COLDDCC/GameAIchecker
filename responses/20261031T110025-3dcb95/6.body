				<div class="game_page_autocollapse" style="max-height: 300px;">			<div class="game_area_description" data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}">
				<h2>Roadmap</h2>				<p><p class="bb_paragraph" ><span class="bb_img_ctn"><img class="bb_img" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4164790/extras/5b4e315d7bb7659397fb4dff0b51628f.avif?t=1790679893" data-big-src=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4164790/extras_big/5b4e315d7bb7659397fb4dff0b51628f.avif?t=1790679893 width=1560 height=878 /></span></p></p>
			</div>

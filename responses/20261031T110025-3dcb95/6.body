							var StoreDefaults = {"PartnerEventStore":[{"gid":"688646863473082979","clan_steamid":"103582791475380303","event_name":"[Update Announcement] 10\/29 Update","event_type":13,"appid":4164790,"server_address":null,"server_password":null,"rtime32_start_time":1793272440,"rtime32_end_time":1793277001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"80203b496d4c2028243f0fb0b5e60ed209c8f103.png\",null,null,null,null,null,\"1644a47c7585fc423997fad2c5b7280be0839a67.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688646863473082980","clanid":"45858895","posterid":"0","headline":"[Update Announcement] 10\/29 Update","posttime":1793272473,"updatetime":1793272473,"body":"[p]Hello, survivors![\/p][p]Thank you all for your continuous feedback and suggestions. This update adds two sets of Random Events: \\[Delivery Zombie] and \\[Rising Water]. We've added 4 new wallpapers and 2 new floors for renovation, introduced a feature to search for specific items by name, adjusted the criteria for the \\[Fully Prepared] Achievement, and fixed a batch of Zombie Horde pathfinding issues. The details are as follows:[\/p][p][\/p][p][b]Version: 1.1.20151[\/b][\/p][p][\/p][h3][b]Key Updates[\/b][\/h3][list][*][p]New Content: Added two sets of Random Events: \\[Delivery Zombie] and \\[Rising Water]; Item Search now supports direct item name input; added 4 new wallpapers and 2 new floors to the renovation system; Action Recommendation optimized.[\/p][\/*][*][p]Frequently Asked Questions: The \\[Fully Prepared] Achievement now counts facilities built across different saves; fixed an issue where some zombies getting stuck prevented the Zombie Horde from ending; when Proficiency is maxed out, duplicate experience Planning Cards will no longer appear.[\/p][\/*][\/list][h3][b]\\[Survival & Interaction][\/b][\/h3][list][*][p]New Delivery Zombie Random Event: After the apocalypse, Delivery Zombies riding electric bikes and carrying insulated bags will occasionally appear at your door. You can choose different ways to deal with them; some will yield loot, while others will cost you.[\/p][\/*][*][p]New Rising Water Random Event: After continuous rain in the mid-to-late game, water may accumulate at intersections. You can choose to clear the sewers or ignore it. When the water rises, you need to block your door within a limited time. You can also take advantage of the puddle to fish once. The water will recede a while after the rain stops.[\/p][\/*][*][p]Action Recommendation Optimization: Added Action Recommendations for emergency door and window repairs, power generation, heating, disinfection, basket, stair repair, research, drone retrieval, etc., and slightly lowered the priority of daily entertainment recommendations.[\/p][\/*][*][p]\\[Fully Prepared] Achievement Optimization: Changed the requirement to building each of the eight new facilities once. You no longer need to build them all simultaneously in the same save; facilities built by different characters and across different saves will all count.[\/p][\/*][*][p]Planning Card Optimization: When a corresponding Proficiency is maxed out, experience bonus Planning Cards for that Proficiency will no longer appear; locked Planning Cards are unaffected.[\/p][\/*][*][p]Earlier Refined Sheet Metal Unlocks: The unlock condition for the Refined Sheet Metal recipe has been moved up to Crafting Proficiency Level 3.[\/p][\/*][*][p]Frozen Whole Turkey Optimization: Optimized the issue where the Frozen Whole Turkey was too heavy to pick up. Now it must be cut into frozen turkey meat chunks before eating or cooking, and the whole turkey can no longer be eaten directly. Thanksgiving Turkey and Black Pepper Turkey Steak are now made using frozen turkey meat chunks.[\/p][\/*][*][p]Zombie Horde Intensity Option Optimization: \\[Zombie Horde Intensity] in custom difficulty now affects the number of waves in the two major Zombie Hordes, in addition to zombie strength and numbers. When \\[Weak] or \\[Standard] is selected, the major Zombie Horde and the reinforced Zombie Horde will each have one less wave than \\[Strong] and \\[Extreme]. Ongoing Zombie Hordes are unaffected.[\/p][\/*][*][p]Fruit Cake Renamed: \\[Colorful Fruit Pudding], which originally shared a name with the dessert, has been renamed to \\[Colorful Fruit Cake], and \\[Weird Fruit Pudding] has been renamed to \\[Weird Fruit Cake]. Their icons have also been changed to avoid confusion with the desserts of the same name.[\/p][\/*][*][p]Story Endless Zombie Horde Fix: Fixed an issue where, after reaching an ending during a story Zombie Horde and entering story endless mode, the Zombie Horde countdown would continue but zombies would never arrive. Affected saves will recover after loading.[\/p][\/*][*][p]Zombie Horde Stuck Fix: Fixed an issue where, under special circumstances, individual lingering zombies would spawn stuck by a wall, preventing the Zombie Horde from ending.[\/p][\/*][*][p]Recorder Clue Fix: Fixed an issue where old clues could be found in the hospital, and after uploading, the incomplete file would still show \\[Not yet at home]. Old clues already obtained will be displayed as obsolete old records, and you will need to go to the hospital again to find new records.[\/p][\/*][*][p]City Channel Optimization: Optimized the text of some late-game messages in the City Channel.[\/p][\/*][\/list][h3][b]\\[Controls & Interface][\/b][\/h3][list][*][p]Item Search Supports Name Input: Added an input box at the top of the Item Search list on the right. Enter an item name to find and locate specific items in Containers at home.[\/p][\/*][*][p]Inventory Auto-Organize Optimization: When organizing the inventory, identical items will be sorted by their remaining shelf life, with items closer to expiration placed first.[\/p][\/*][*][p]Drone Delivery Panel Optimization: The delivery panel is now grouped and labeled by types such as commissions, requests for help, and emergency deliveries. The height of the description box will also adjust according to the content.[\/p][\/*][*][p]Ending Selection Page Optimization: Optimized the design of the selection page after the ending. The cards are cleaner, you can hover to view lines, and the confirmation box descriptions have been unified.[\/p][\/*][*][p]Wishlist Marker Display Fix: Fixed an issue where the wishlist marker on item slots was covered by the refrigeration effect when the Refrigerator was powered.[\/p][\/*][\/list][h3][b]\\[Scenes & Visuals][\/b][\/h3][list][*][p]New Wallpapers and Floors: Added 4 new wallpapers and 2 new floors for renovation. They can be crafted at the Workbench after unlocking the corresponding dyes.[\/p][\/*][*][p]Rainy Weather Visuals Optimization: When it rains, characters, outdoor furniture, defense facilities, and zombies standing outside will get wet. Characters will slowly dry off after returning indoors.[\/p][\/*][*][p]Selected Furniture Sound Effects Optimization: Reduced the operating noise of the Extra Large Power Storage and the Shredder; the household robot no longer emits a continuous buzzing sound when idle.[\/p][\/*][*][p]Wage Slave Pathfinding Fix: Fixed an issue where the Wage Slave would easily get stuck in the basement.[\/p][\/*][*][p]Robot Pathfinding Fix: Fixed an issue where robots might get stuck in place and be unable to continue working when on the same floor or going up and down stairs.[\/p][\/*][*][p]Drop Location Fix: Fixed an issue where dropped Cardboard Boxes could appear in locations inaccessible to the character.[\/p][\/*][*][p]Cold Wave Visuals Fix: Fixed an issue where ghosting appeared on character outlines during cold wave weather.[\/p][\/*][*][p]Drone Display Fix: Fixed an issue where the Drone might not display at all if its fly-in cutscene was interrupted.[\/p][\/*][*][p]Loading Optimization: Only the furniture needed for the current scene is loaded when entering the game, resulting in faster loading speeds.[\/p][\/*][\/list][p][\/p][p]Thank you for your support and feedback! If you encounter any bugs or have any suggestions while playing, please let us know through the [url=\"https:\/\/forms.gle\/93bp2Y1o1uVqMx3b8\"]feedback form[\/url], and we will handle them as soon as possible.[\/p][p]In addition to continually polishing existing content, we are concurrently creating more diverse game modes (such as the recently mentioned long-term sustainable modes and modes with alternative challenges) and developing future free major version updates. For more details, see the new [url=\"https:\/\/store.steampowered.com\/news\/app\/4164790\/view\/699900155194769472\"]roadmap[\/url]. We will strive to bring you a richer and deeper gaming experience.[\/p][p]We wish all Survivors the best of luck. Stock up on supplies and survive to the end![\/p][p]\u2014 Midnight Workshop[\/p]","commentcount":27,"tags":["mod_reviewed","ModAct_773020726_1793272943_0"],"language":0,"hidden":0,"forum_topic_id":"567049673541591903","event_gid":"688646863473082979","voteupcount":307,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049673541591903","rtime32_last_modified":1793410589,"news_post_gid":"0","rtime_mod_reviewed":1793272943,"featured_app_tagid":0,"referenced_appids":[],"build_id":26294912,"build_branch":"","unlisted":0,"rtime_created":1793269093,"votes_up":307,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"681859758980138102","gidfeature2":"567049673541591903"},{"gid":"688646229288031800","clan_steamid":"103582791475380303","event_name":"[Update Announcement] 10\/23 Update","event_type":13,"appid":4164790,"server_address":null,"server_password":null,"rtime32_start_time":1792752360,"rtime32_end_time":1792756801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ab1f5cec9bb201e7bc871fe7fc386895e3336148.png\",null,null,null,null,null,\"f88efff17551ebbdf3626b26be6393ac63692101.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"688646229288031801","clanid":"45858895","posterid":"0","headline":"[Update Announcement] 10\/23 Update","posttime":1792752423,"updatetime":1792752423,"body":"[p]Hello, survivors![\/p][p]Thank you for your continued feedback and suggestions. This update adds the \\[Garden Tending] function. Item hover tooltips now allow you to directly check how many are left at home and how much they restore when consumed; meanwhile, we have extended the shelf life of seasonings and some food, reduced the weight of large dishes, and optimized the workbench recipe list, daily plan refreshes, and furniture package unboxing. Details are as follows:[\/p][p][\/p][p][b]Version: 1.1.19611[\/b][\/p][p][\/p][h3][b]Key Updates[\/b][\/h3][list][*][p]New Content: Reach Planting Proficiency Level 3 to unlock \\[Garden Tending], allowing you to arrange all farming tasks at home at once. Item hover tooltips now display the \\[Available at Home] quantity; hold Shift to view their storage locations. The workbench recipe list now features category tabs, favorites, and \\[Craftable Only].[\/p][\/*][*][p]Community Concerns: Salt, white sugar, and honey no longer have a short shelf life and will no longer get moldy. The weight and grid slots taken up by large dishes have been greatly reduced. Furniture packages crafted at the workbench can be unboxed on the spot, so you no longer need to walk to the foyer.[\/p][\/*][\/list][h3][b]\\[Planting and Survival][\/b][\/h3][list][*][p]Added Garden Tending Function: Reach Planting Proficiency Level 3 to unlock the \\[Garden Tending] function. Once clicked, the character will automatically take care of nearby plants at home, arranging farming tasks such as pest control, watering, harvesting, plowing, and replanting at once. Urgent situations will be prioritized, and the processing order will be adjusted based on the route. A tutorial prompt will appear once the function is unlocked.[\/p][\/*][*][p]Extreme Weather Lighting Optimization: Solar panels can now receive a small amount of light during heavy rain, continuous rain, and freezing rain. Added new weather icon styles for heavy rain, smog, and clear and cold weather.[\/p][\/*][*][p]Planning Card Optimization: Daily plans will no longer refresh planning cards that are invalid for your current situation, such as duplicate planning cards for recipes you already own.[\/p][\/*][*][p]Earlier Compost Bin Unlocks: The intermediate compost bin recipe is now unlocked earlier at Planting Proficiency Level 2, and the advanced compost bin recipe is unlocked earlier at Level 3.[\/p][\/*][*][p]Seasoning Shelf Life Adjustments: Salt is now permanently preserved. The shelf life of white sugar and honey has been extended to 720 days, and aged vinegar to 360 days. Salt, white sugar, and honey will no longer get moldy.[\/p][\/*][*][p]Food Shelf Life Optimization: Freezer ingredients sold in pre-apocalypse stores are now fresher, with their remaining shelf life increased from 30%+ to 90%+. The shelf life of finished dishes and cooked food with a shelf life of less than 3 days has been uniformly extended to 3 days.[\/p][\/*][*][p]Planting Robot Optimization: After harvesting crops, planting robots will prioritize plowing and replanting in empty pots, and no longer need to wait for other farming tasks to be finished.[\/p][\/*][*][p]Dish Weight Optimization: Reduced the weight of most dishes. Large dishes such as the Whole Pork Leg Feast, Roast Whole Chicken, and Thanksgiving Turkey now take up fewer grid slots. \\[Whole Roast Sheep] has been renamed to \\[Roasted Lamb], and \\[Giant Turkey Feast] has been renamed to \\[Roasted Turkey], with their icons updated.[\/p][\/*][*][p]Brewing Barrel Collection Optimization: When clicking the brewing barrel after the wine is brewed, any wine that cannot fit in your inventory will drop on the ground next to the barrel. Uncollected wine will also drop nearby when dismantling the barrel. The brewing panel now includes completion status and collection destination prompts.[\/p][\/*][*][p]Drone Scavenging Additions: Drone scavenging now includes wood chips and wooden boards, as well as surprise harvests like crispy rice, sunflower seeds, and dried tofu.[\/p][\/*][*][p]Random Event Optimization: Reduced the frequent recurrence of similar random events. Events like waking up from a nightmare and food spoilage will now trigger under more appropriate conditions.[\/p][\/*][*][p]Reduced Plant Abnormal Statuses: Slightly reduced the probability of plants developing abnormal statuses when there is a large number of plants.[\/p][\/*][*][p]Late-Game Zombie Wave Optimization on Standard Difficulty: Slightly reduced the difficulty of the Day 49 zombie wave on the Normal Zombie Wave difficulty.[\/p][\/*][*][p]Return Gift Reward Fix: The reward for the return gift event \\[One More Pack of Medicine] has been corrected to a Military Medkit.[\/p][\/*][*][p]Pre-Apocalypse Acquaintance Optimization: When the Wage Slave talks to store clerks before the apocalypse, they can choose to exchange contact information to get to know them.[\/p][\/*][*][p]Commission Settlement Fix: Fixed an issue where the commission result pop-up might be lost when multiple windows pop up at the same time, making the commission impossible to complete even when the progress is full.[\/p][\/*][*][p]Warehouse Keeper Quest Optimization: The function of placing scrap paper underneath in the quest \\[Those Few Bags on the Ground] is no longer limited to a few pieces of furniture like the refrigerator.[\/p][\/*][*][p]Endless Story Residual Event Fix: Fixed an issue where unprocessable event prompts might remain after entering Endless Story from an ending save file.[\/p][\/*][*][p]Save File Protection: When using an older version of the game to load a new version save file, a prompt will appear and the launch will be stopped, preventing the save record from being overwritten or cleared.[\/p][\/*][*][p]Food Supply Box Drop Fix: The test item \\[Food Supply Box] will no longer randomly appear on the Premium Goods counter.[\/p][\/*][\/list][h3][b]\\[Controls and UI][\/b][\/h3][list][*][p]Workbench Crafting Interaction Optimization: The recipe list on the right side of the workbench now includes category icon tabs, favorites, \\[Craftable Only], and a grid view. The refresh speed of the recipe list has also been significantly increased, and some descriptions have been optimized.[\/p][\/*][*][p]Storage Furniture Renaming Optimization: After renaming storage furniture, the custom names will be displayed in the cabinet tabs of various panels such as cooking, crafting, and brewing, as well as in the robots' work records.[\/p][\/*][*][p]Item Inventory Tooltips: When hovering over items in the inventory, cabinets, trading, supermarket, and workbench, the \\[Available at Home] quantity will be displayed. Hold Shift to see which cabinets these items are stored in.[\/p][\/*][*][p]Food Stat Tooltips: When hovering over food in the trading interface, inventory, and cabinets, the restoration values for Satiety, Morale, Stamina, Fitness, and Life, as well as the number of uses, will be displayed, consistent with the display in the supermarket.[\/p][\/*][*][p]Furniture Unboxing Optimization: After crafting a furniture package at the workbench, you can choose to unbox it on the spot without needing to walk to the foyer. Once unboxed, a prompt will indicate that the furniture has been placed in the foyer.[\/p][\/*][*][p]Camera Zoom Fix: Fixed an issue where the camera zoom adjusted with the scroll wheel in follow view would be reset after walking on stairs, switching maps, entering\/exiting viewing mode, or exiting building mode.[\/p][\/*][*][p]Sprint Prompt: When holding the Shift sprint key, the interface will display a \\[Sprinting] prompt.[\/p][\/*][*][p]Character Movement Fix: Fixed an issue where a moving character might suddenly stop and prompt that the destination is unreachable after closing a panel.[\/p][\/*][*][p]Robot Pathing Optimization: Reduced situations where housework robots get blocked or stuck in place by stationary characters or other robots.[\/p][\/*][*][p]Story Pop-up Layout Optimization: Fixed an issue where longer text in story pop-ups was not fully displayed.[\/p][\/*][*][p]Help Message Text Optimization: Optimized the name and location text in the Rescue Platform and Help Channel.[\/p][\/*][\/list][h3][b]\\[Scenes and Visuals][\/b][\/h3][list][*][p]Wage Slave Kitchen Slot Optimization: Added a medium slot to the Wage Slave's kitchen sink.[\/p][\/*][*][p]Diesel Hut Clipping Fix: Fixed an issue where the pile of materials and oil drums overlapped with newly placed furniture in the Warehouse Keeper's Diesel Hut expansion area.[\/p][\/*][*][p]Housework Robot Sound Effect Fix: Fixed an issue where the sound of the housework robot running was intermittent.[\/p][\/*][\/list][p][\/p][p]Thank you for your support and feedback! If you encounter any bugs or have any suggestions while playing, please let us know via the [url=\"https:\/\/forms.gle\/93bp2Y1o1uVqMx3b8\"]feedback form[\/url], and we will handle them as soon as possible.[\/p][p]In addition to continuously polishing the existing content, we are also simultaneously designing and developing future free updates. For more details, see the new [url=\"https:\/\/store.steampowered.com\/news\/app\/4164790\/view\/699900155194769472\"]roadmap[\/url]. We will strive to bring you a richer and deeper gaming experience.[\/p][p]Good luck to all survivors! Stock up on supplies and survive to the end![\/p][p]\u2014 Midnight Workshop[\/p]","commentcount":43,"tags":["mod_reviewed","ModAct_1415716708_1792757981_0"],"language":0,"hidden":0,"forum_topic_id":"572678538884527310","event_gid":"688646229288031800","voteupcount":505,"votedowncount":6,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884527310","rtime32_last_modified":1793391990,"news_post_gid":"0","rtime_mod_reviewed":1792757981,"featured_app_tagid":0,"referenced_appids":[],"build_id":26157732,"build_branch":"","unlisted":0,"rtime_created":1792747982,"votes_up":505,"votes_down":6,"comment_type":"ForumTopic","gidfeature":"681859758980138102","gidfeature2":"572678538884527310"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["688646863473082980","688646229288031801"],"last_update_event":{"rtime":1793272440,"event_gid":"688646863473082979","announcement_gid":"688646863473082980","clan_account_id":45858895}}};
						</script>
					


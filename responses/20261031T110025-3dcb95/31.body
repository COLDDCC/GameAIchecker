																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"705532825431967680","clan_steamid":"103582791475537394","event_name":"Slotbound v0.4.0 - Major Update: The Jester Arrives!","event_type":14,"appid":4459590,"server_address":null,"server_password":null,"rtime32_start_time":1791179040,"rtime32_end_time":1791183601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"The Jester, Faction Synergies, Awakening, new items, Random Options, and much more have arrived!\",\"Der Narr, Fraktionssynergien, Erwachen, neue Items, zuf\u00e4llige Optionen und vieles mehr sind jetzt dabei!\",\"Le Bouffon, les synergies de faction, l\u2019\u00c9veil, de nouveaux objets, des options al\u00e9atoires et bien plus encore !\",\"Giullare, sinergie di fazione, Risveglio, nuovi oggetti, opzioni casuali e molto altro!\",\"\uad11\ub300, \uc9c4\uc601 \uc2dc\ub108\uc9c0, \uac01\uc131, \uc0c8\ub85c\uc6b4 \uc544\uc774\ud15c\uacfc \ub79c\ub364 \uc635\uc158\uae4c\uc9c0! Slotbound\uc758 \ub300\uaddc\ubaa8 \uc5c5\ub370\uc774\ud2b8\uac00 \ub3c4\ucc29\ud588\uc2b5\ub2c8\ub2e4.\",\"\u00a1El Buf\u00f3n, sinergias de facci\u00f3n, Despertar, nuevos objetos, opciones aleatorias y mucho m\u00e1s!\",\"\u5c0f\u4e11\u3001\u9635\u8425\u534f\u540c\u3001\u89c9\u9192\u3001\u65b0\u9053\u5177\u3001\u968f\u673a\u8bcd\u6761\u7b49\u5927\u91cf\u65b0\u5185\u5bb9\u6b63\u5f0f\u52a0\u5165\uff01\",null,\"\u0428\u0443\u0442, \u0441\u0438\u043d\u0435\u0440\u0433\u0438\u0438 \u0444\u0440\u0430\u043a\u0446\u0438\u0439, \u041f\u0440\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u0435, \u043d\u043e\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b, \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u0438 \u043c\u043d\u043e\u0433\u043e\u0435 \u0434\u0440\u0443\u0433\u043e\u0435!\",null,\"\u9053\u5316\u5e2b\u3001\u9663\u55b6\u30b7\u30ca\u30b8\u30fc\u3001\u899a\u9192\u3001\u65b0\u30a2\u30a4\u30c6\u30e0\u3001\u30e9\u30f3\u30c0\u30e0\u30aa\u30d7\u30b7\u30e7\u30f3\u306a\u3069\u591a\u6570\u306e\u65b0\u8981\u7d20\u3092\u8ffd\u52a0\uff01\",null,\"B\u0142azen, synergie frakcji, Przebudzenie, nowe przedmioty, losowe opcje i mn\u00f3stwo innych nowo\u015bci!\",null,null,null,null,null,null,null,null,null,\"Bobo da Corte, sinergias de fac\u00e7\u00e3o, Despertar, novos itens, op\u00e7\u00f5es aleat\u00f3rias e muito mais!\",null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",null,\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",null,\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",null,\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",null,null,null,null,null,null,null,null,null,\"1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\",null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"705532825431967681","clanid":"46015986","posterid":"0","headline":"Slotbound v0.4.0 - Major Update: The Jester Arrives!","posttime":1791179099,"updatetime":1791202359,"body":"[p]\n[img src=\"{STEAM_CLAN_IMAGE}\/46015986\/1562ddc8207c78b8a61c8c7ad5d7404b33237435.png\"][\/img]\n[\/p][p]Hello everyone![\/p][p][\/p][p]Slotbound has been updated to v0.4.0.[\/p][p]This is one of the biggest updates Slotbound has received so far. A large amount of new content and several new systems have been added, while many existing systems have also been reworked.[\/p][p][\/p][h1][b]Update Notes[\/b][\/h1][p][\/p][list][*][p]A new Special-rarity unit, the Jester, has arrived! The Jester is a very difficult unit to obtain. Will you be able to find one?![\/p][\/*][*][p]Stage 2, Deep Cave, is now available up through Normal difficulty.[\/p][\/*][*][p]The Faction Synergy system has been added. It is currently in beta and will continue to be refined over time.[\/p][\/*][*][p]A new Awakening system has been added.[\/p][\/*][*][p]The item system has been completely reworked, with new items added as well.[\/p][\/*][*][p]Trait Random Options have been rebalanced, and new options have been added.[\/p][\/*][*][p]Official keyboard and controller support has been added.[\/p][\/*][*][p]Several quality-of-life improvements and smaller issues have been addressed.[\/p][\/*][*][p]Various bugs, both large and small, have been fixed.[\/p][p][\/p][\/*][\/list][h1][b]New Language Support[\/b][\/h1][p][\/p][p]The following languages have been newly added:[\/p][list][*][p]French[\/p][\/*][*][p]Italian[\/p][\/*][*][p]Portuguese[\/p][\/*][*][p]Russian[\/p][\/*][*][p]German[\/p][\/*][*][p]Spanish[\/p][\/*][*][p]Polish[\/p][\/*][*][p]Brazilian Portuguese[\/p][\/*][\/list][p]If you notice any awkward translations or incorrect wording, please feel free to let me know![\/p][p][\/p][h1][b]About Early Access[\/b][\/h1][p][\/p][p]Thank you sincerely to everyone who believes in Slotbound and continues to support the game.[\/p][p]There are still many areas I want to polish and a lot of content I still want to add.[\/p][p]Because of this, I\u2019ve decided that Slotbound will launch in Early Access on November 10 instead of releasing as a full version.[\/p][p]Rather than rushing into a full release in its current state, I believe the better choice for Slotbound is to keep improving the game together with your feedback while continuing to add new content.[\/p][p]Slotbound will continue to grow and evolve.[\/p][p]I\u2019ll do my best to repay all of your excitement and support by making the game even more fun.[\/p][p]Thank you so much![\/p]","commentcount":25,"tags":["mod_reviewed","ModAct_784176946_1791182648_0","ModAct_1866137740_1791203150_4"],"language":0,"hidden":0,"forum_topic_id":"586187800873896757","event_gid":"705532825431967680","voteupcount":166,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"586187800873896757","rtime32_last_modified":1793399955,"news_post_gid":"0","rtime_mod_reviewed":1791203150,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1791178333,"votes_up":166,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"568165608207730876","gidfeature2":"586187800873896757"},{"gid":"696524994028504801","clan_steamid":"103582791475537394","event_name":"Slotbound Has Reached 100,000 Wishlists!","event_type":28,"appid":4459590,"server_address":null,"server_password":null,"rtime32_start_time":1790488380,"rtime32_end_time":1790491500,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Thank you for 100,000 wishlists! Slotbound enters Early Access on November 10.\",null,null,null,\"\uc704\uc2dc\ub9ac\uc2a4\ud2b8 10\ub9cc \uac10\uc0ac\ud569\ub2c8\ub2e4! Slotbound\ub294 11\uc6d4 10\uc77c \uc5bc\ub9ac\uc561\uc138\uc2a4\ub85c \ucd9c\uc2dc\ub429\ub2c8\ub2e4.\",null,\"\u611f\u8c22\u5927\u5bb6\u8ba9\u613f\u671b\u5355\u7a81\u783410\u4e07\uff01Slotbound\u5c06\u4e8e11\u670810\u65e5\u5f00\u542f\u62a2\u5148\u4f53\u9a8c\u3002\",null,null,null,\"10\u4e07\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u3001\u672c\u5f53\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01Slotbound\u306f11\u670810\u65e5\u306b\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u3092\u958b\u59cb\u3057\u307e\u3059\u3002\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"9449b07917027ea57f64769704bc7ec426f57b7a.png\",null,null,null,\"9449b07917027ea57f64769704bc7ec426f57b7a.png\",null,\"9449b07917027ea57f64769704bc7ec426f57b7a.png\",null,null,null,\"9449b07917027ea57f64769704bc7ec426f57b7a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"696524994028504802","clanid":"46015986","posterid":"0","headline":"Slotbound Has Reached 100,000 Wishlists!","posttime":1790488034,"updatetime":1790488446,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/46015986\/9449b07917027ea57f64769704bc7ec426f57b7a.png\"][\/img]\n[\/p][p]Slotbound has officially passed 100,000 wishlists on Steam![\/p][p][\/p][p]When I first started working on Slotbound, I never imagined this many people would be waiting to play it.[\/p][p]Thank you to everyone who played the demo, shared feedback, left reviews, recommended the game to others, or simply added Slotbound to your wishlist.[\/p][p][\/p][p]Your support has helped the game grow far beyond what I ever expected.[\/p][p]And I can finally confirm that Slotbound will launch in Early Access on November 10![\/p][p][\/p][p]There is still plenty of work ahead, and I\u2019ll continue polishing and improving the game so that it can live up to your expectations.[\/p][p][\/p][p]Thank you so much for waiting for Slotbound![\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1870293249_1790489256_0"],"language":0,"hidden":0,"forum_topic_id":"586187095760006692","event_gid":"696524994028504801","voteupcount":60,"votedowncount":10,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1790488380,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"586187095760006692","rtime32_last_modified":1793069429,"news_post_gid":"0","rtime_mod_reviewed":1790489256,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790487686,"votes_up":60,"votes_down":10,"comment_type":"ForumTopic","gidfeature":"568165608207730876","gidfeature2":"586187095760006692"},{"gid":"705532825431967922","clan_steamid":"103582791475537394","event_name":"Slotbound Demo v0.4.1 \u2013 Stability Fixes","event_type":12,"appid":4459590,"server_address":null,"server_password":null,"rtime32_start_time":1791269340,"rtime32_end_time":1791273601,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Fixed frame drops and crash issues.\",\"Probleme mit Framerate-Einbr\u00fcchen und Abst\u00fcrzen wurden behoben.\",\"Correction des chutes de FPS et des plantages.\",\"Risolti problemi di cali di FPS e crash.\",\"\ud504\ub808\uc784 \ub4dc\ub78d \ubc0f \ud06c\ub798\uc2dc \ubb38\uc81c\ub97c \uc218\uc815\ud588\uc2b5\ub2c8\ub2e4.\",\"Se han corregido problemas de ca\u00eddas de FPS y cierres inesperados.\",\"\u4fee\u590d\u4e86\u6389\u5e27\u548c\u5d29\u6e83\u95ee\u9898\u3002\",null,\"\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u043f\u0440\u043e\u0441\u0430\u0434\u043a\u0438 FPS \u0438 \u0432\u044b\u043b\u0435\u0442\u044b \u0438\u0433\u0440\u044b.\",null,\"\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u4f4e\u4e0b\u3084\u30af\u30e9\u
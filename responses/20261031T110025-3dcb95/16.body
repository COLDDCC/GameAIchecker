								<a id="ReportAppBtn" class="btnv6_blue_hoverfade btn_medium" href="javascript:void(0)" onclick="ShowReportDialog(3636930)"><span data-tooltip-text="Report this Product" aria-label="Report this Product"><i class="ico16 reportv6"></i>&nbsp;</span></a>
							</div>
						
						<div id="reportBtn" style="display:none;"><a class="btnv6_blue_hoverfade btn_medium" href="javascript:void(0)" onclick="ShowReportDialog(3636930)"><span><img src="https://store.fastly.steamstatic.com/public/shared/images/icon_report.svg" alt="Report this Product"></span></a></div>
					
					
															
											<div id="appLinksAndInfoCtn" style="display:none;">
							<div class="responsive_block_header">Links &amp; info</div>
							<div id="appLinksAndInfo" class="game_page_autocollapse" style="max-height: 180px;"></div>

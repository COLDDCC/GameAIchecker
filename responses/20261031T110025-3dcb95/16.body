																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"686395063661496317","clan_steamid":"103582791475116111","event_name":"Update 3 | Now available for everyone on the Default Branch!","event_type":13,"appid":3636930,"server_address":null,"server_password":null,"rtime32_start_time":1793367240,"rtime32_end_time":1793367660,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"b75a045655025acd7dfa79e2d4c6c6f42aa7ad7b.png\",\"b75a045655025acd7dfa79e2d4c6c6f42aa7ad7b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"686395063661496318","clanid":"45594703","posterid":"0","headline":"Update 3 | Now available for everyone on the Default Branch!","posttime":1793365236,"updatetime":1793367251,"body":"[h2][img src=\"{STEAM_CLAN_IMAGE}\/45594703\/af0208c54986350fe44c581d8a1e78253735c038.jpg\"][\/img][\/h2][h2]Early Access Update 3 is now available on the Main Branch![\/h2][p]This major update brings the brand-new Medium Trawler \"Seaborn\", selectable ferry destinations, a new heavy-weather docking tutorial, improved vessels, and the first beta version of our external Mission Editor![\/p][p]After testing on the Public Beta branch, these improvements are now available to all Early Access players.[\/p][p][\/p][h3]\ud83c\udfa3 NEW VESSEL \u2013 Meet the Seaborn![\/h3][p]We are excited to welcome the Seaborn, our new Medium Trawler, to the Early Access fleet![\/p][list][*][p]Explore and operate this new fishing vessel[\/p][\/*][*][p]Experience its handling, maneuverability and onboard systems[\/p][\/*][*][p]Take the Seaborn out to sea and share your experiences with us[\/p][\/*][\/list][p]The Seaborn is a great addition to our growing fleet, and we look forward to your feedback as we continue refining its handling and features.[\/p][p][\/p][h3]\u26f4\ufe0f NEW \u2013 Choose Your Ferry Destination![\/h3][p]Ferry missions now give you more freedom over where you sail![\/p][list][*][p]Choose your destination from a list of available ferry terminals when starting a ferry mission[\/p][\/*][*][p]Ferry missions no longer automatically select the nearest terminal as your destination[\/p][\/*][*][p]Plan your crossings and decide where your next journey takes you[\/p][\/*][\/list][p]This makes ferry operations more flexible and gives you greater control over your routes[\/p][p][\/p][h3]\u2693 Docking & Training Improvements[\/h3][list][*][p]NEW \u2013 Heavy Weather Spring Line Docking Tutorial! Learn how to use spring lines to maneuver your vessel alongside a pier, even when strong winds push your ship away from the dock[\/p][\/*][*][p]Shortened docking piers throughout the game, removing excessively long boarding structures to provide more room for realistic docking maneuvers[\/p][\/*][*][p]Ralswiek Training Pier: Remains extended to accommodate the Ship Handling Tutorial[\/p][\/*][*][p]Corrected wind direction and adjusted wind forces for more balanced handling[\/p][\/*][\/list][p][\/p][h3]\ud83c\udde7\ud83c\uddea Nieuwpoort Harbor \u2013 Work in Progress[\/h3][p]Development of our new Nieuwpoort harbor in Belgium continues![\/p][list][*][p]Added harbor structures, buildings, bridges, boats and scenery details[\/p][\/*][*][p]Expanded the navigable area around Nieuwpoort[\/p][\/*][*][p]Adjusted harbor water depths to improve navigation[\/p][\/*][\/list][p]Please note: Nieuwpoort is still under development. Some areas may be incomplete or subject to further changes.[\/p][p][\/p][h3]\ud83d\udee0\ufe0f NEW \u2013 Mission Editor (Beta)[\/h3][p]We are introducing the first beta version of our separate Mission Editor application, allowing the community to begin experimenting with custom missions for Professional Ship Simulator![\/p][list][*][p]Create and test your own missions using the external Mission Editor[\/p][\/*][*][p]Initial support for custom mission audio[\/p][\/*][*][p]Early beta functionality, with additional features and improvements planned[\/p][\/*][\/list][p]The Mission Editor is available on our Discord server for first trials![\/p][p]We are excited to see what our community creates and look forward to your suggestions as development continues.[\/p][p][\/p][h3]\ud83d\udea4 Vessel Updates[\/h3][list][*][p]Waverider: New custom texture design[\/p][\/*][*][p]Small Rescue Boat: Updated 3D model, textures, console and outboard engine, including improved character collision[\/p][\/*][*][p]Yacht: Additional texture corrections[\/p][\/*][*][p]Updated throttle controls and improved visual indicators for speed, rudder angle and rate of turn[\/p][\/*][\/list][p][\/p][h3]\ud83d\udd26 NEW \u2013 Player Flashlight[\/h3][p]Nighttime operations just became easier![\/p][list][*][p]Added a new player flashlight for better visibility during nighttime operations[\/p][\/*][*][p]Press F to toggle the flashlight on or off[\/p][\/*][\/list][p][\/p][h3]\ud83d\udee0\ufe0f Additional Improvements[\/h3][list][*][p]Improved Azipod steering behavior[\/p][\/*][*][p]Improved ocean buoyancy and prepared the underlying systems for future advanced visual effects[\/p][\/*][*][p]Fixed an issue where the Ctrl key could remain active after submitting a bug report[\/p][\/*][*][p]Improved localization fallback for unsupported Chinese 3D text[\/p][\/*][*][p]Additional ship handling, scenery and stability improvements[\/p][\/*][\/list][p][\/p][hr][\/hr][p][\/p][h2]\u2764\ufe0f Thank You for Your Continued Support![\/h2][p][\/p][p]With Early Access Update 3, we are taking another step forward in expanding Professional Ship Simulator.[\/p][p]We are especially excited to hear your thoughts on the new Seaborn trawler, selectable ferry destinations, the Heavy Weather Spring Line Docking Tutorial, and our new Mission Editor Beta.[\/p][p]Your feedback continues to play an important role in shaping the simulator.[\/p][p]You can submit a bug report at any time using Ctrl + Tab while in Ship Control Mode.[\/p][p][\/p][p]Enjoy Early Access Update 3, and happy sailing![\/p][p]\u00a0[\/p]","commentcount":3,"tags":["mod_reviewed","ModAct_1607812438_1793365839_0","ModAct_1607812438_1793369248_4"],"language":0,"hidden":0,"forum_topic_id":"567049673541719532","event_gid":"686395063661496317","voteupcount":77,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049673541719532","rtime32_last_modified":1793410942,"news_post_gid":"0","rtime_mod_reviewed":1793369248,"featured_app_tagid":0,"referenced_appids":[],"build_id":26152003,"build_branch":"","unlisted":0,"rtime_created":1793361336,"votes_up":77,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"591782690120923072","gidfeature2":"567049673541719532"},{"gid":"687520329382237493","clan_steamid":"103582791475116111","event_name":"Public Beta Update 3","event_type":13,"appid":3636930,"server_address":null,"server_password":null,"rtime32_start_time":1792756800,"rtime32_end_time":1792762201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"e393d4b3dc73b60bae5f4e40ea1bbe5bed8e6647.jpg\",\"e393d4b3dc73b60bae5f4e40ea1bbe5bed8e6647.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"667252863011916225\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"687520329382237494","clanid":"45594703","posterid":"0","headline":"Public Beta Update 3","posttime":1792756844,"updatetime":1792757322,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45594703\/e393d4b3dc73b60bae5f4e40ea1bbe5bed8e6647.jpg\"][\/img][\/p][p][\/p][p]A major new Public Beta update is here! This update introduces the brand-new Medium Trawler \"Seaborn\", a new docking training scenario, updated vessels and the first beta version of our external Mission Editor![\/p][p][\/p][h2]\ud83c\udfa3 NEW VESSEL \u2013 Meet the Seaborn![\/h2][p]We are excited to introduce the Seaborn, our new Medium Trawler, now available for the first time in Public Beta![\/p][list][*][p]Explore and operate this new fishing vessel.[\/p][\/*][*][p]Test its handling, maneuverability and onboard systems.[\/p][\/*][*][p]Help us evaluate the vessel through your feedback and bug reports.[\/p][\/*][\/list][p]If testing goes well, the Seaborn will also join the full Early Access version of Professional Ship Simulator![\/p][p][\/p][h2]\u2693 Docking & Training Improvements[\/h2][list][*][p]NEW \u2013 Heavy Weather Spring Line Docking Tutorial! Learn how to use spring lines to maneuver your vessel alongside a pier, even when strong winds push your ship away from the dock.[\/p][\/*][*][p]Shortened docking piers throughout the game, removing excessively long boarding structures to provide more room for realistic docking maneuvers.[\/p][\/*][*][p]Ralswiek Training Pier: Stays extended to accommodate the Ship Handling Tutorial.[\/p][\/*][*][p]Corrected wind direction and adjusted wind forces for more balanced handling.[\/p][\/*][\/list][p][\/p][h2]\u26f4\ufe0f NEW \u2013 Choose Your Ferry Destination![\/h2][p]Ferry missions now offer freedom of destination selection![\/p][list][*][p]Choose your destination from a list of available ferry terminals when starting a ferry mission.[\/p][\/*][*][p]Ferry missions no longer automatically select the nearest terminal as your destination.[\/p][\/*][*][p]Plan your ferry crossings and decide where your next journey takes you![\/p][\/*][\/list][p]This gives you more control over your ferry operations and makes ferry missions more flexible and varied.[\/p][p][\/p][h2]\ud83c\udde7\ud83c\uddea Nieuwpoort Harbor \u2013 Work in Progress[\/h2][p]Development of our new Nieuwpoort harbor in Belgium continues![\/p][list][*][p]Added harbor structures, buildings, bridges, boats and scenery details.[\/p][\/*][*][p]Expanded the navigable area around Nieuwpoort.[\/p][\/*][*][p]Adjusted harbor water depths to improve navigation.[\/p][\/*][\/list][p]Please note: Nieuwpoort is still under development. Some areas may be incomplete or subject to further changes.[\/p][p][\/p][h2]\ud83e\udde9 NEW \u2013 Mission Editor (Beta)[\/h2][p]We are introducing the first beta version of our separate Mission Editor application, allowing the community to begin experimenting with custom missions for Professional Ship Simulator![\/p][list][*][p]Create and test your own missions using the new external Mission Editor.[\/p][\/*][*][p]Initial support for custom mission audio.[\/p][\/*][*][p]Early beta functionality, with more features planned.[\/p][\/*][\/list][p]The Mission Editor is available on our Discord server for first trials! We look forward to seeing what the community creates.[\/p][p][\/p][h2]\ud83d\udea4 Vessel Updates[\/h2][list][*][p]Waverider: New custom texture design.[\/p][\/*][*][p]Small Rescue Boat: Updated 3D model, textures, console and outboard engine, including improved character collision.[\/p][\/*][*][p]Yacht: Additional texture corrections.[\/p][\/*][*][p]Updated throttle controls and improved visual indicators for speed, rudder angle and rate of turn.[\/p][\/*][\/list][p][\/p][h2]\ud83d\udd26 NEW \u2013 Player Flashlight[\/h2][list][*][p]Added a new player flashlight for nighttime operations.[\/p][\/*][*][p]Press F to toggle the flashlight on or off.[\/p][\/*][\/list][p][\/p][h2]\ud83d\udee0\ufe0f Additional Improvements[\/h2][list][*][p]Improved Azipod steering behavior.[\/p][\/*][*][p]Improved ocean buoyancy and prepared code for advanced visual effects.[\/p][\/*][*][p]Fixed an issue where the Ctrl key could remain active after submitting a bug report.[\/p][\/*][*][p]Improved localization fallback for unsupported Chinese 3D text.[\/p][\/*][*][p]Additional ship handling, scenery and stability improvements.[\/p][\/*][\/list][p][\/p][p][b]\u2764\ufe0f Thank you for your continued support and feedback![\/b][\/p][p]We are particularly excited to hear your thoughts on the new Seaborn trawler, the Spring Line Docking Tutorial and the Mission Editor Beta![\/p][p]Your feedback helps us prepare these additions for the full Early Access version.[\/p][p]You can submit a bug report at any time using Ctrl + Tab while in Ship Control Mode.[\/p][p][b]Enjoy our new Public Beta and happy sailing![\/b][\/p][p][\/p][hr][\/hr][p][b]\ud83d\udd11 How to access the Beta Branch:[\/b][\/p][list][*][p]Open your Steam Library[\/p][\/*][*][p]Right-click on Professional Ship Simulator \u2192 Properties[\/p][\/*][*][p]Go to the Betas tab[\/p][\/*][*][p]Select Open - Beta from the dropdown menu[\/p][\/*][*][p]Close the window \u2013 Steam will now automatically download the Beta version[\/p][\/*][\/list]","commentcount":16,"tags":["workshop","mod_reviewed","ModAct_1889321037_1792760788_0"],"language":0,"hidden":0,"forum_topic_id":"572678538884531625","event_gid":"687520329382237493","voteupcount":109,"votedowncount":2,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792756800,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884531625","rtime32_last_modified":1793408053,"news_post_gid":"0","rtime_mod_reviewed":1792760788,"featured_app_tagid":0,"referenced_appids":[],"build_id":26152003,"build_branch":"open_beta","unlisted":0,"rtime_created":1792734208,"votes_up":109,"votes_down":2,"comment_type":"ForumTopic","gidfeature":"591782690120923072","gidfeature2":"572678538884531625"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["686395063661496318","687520329382237494"],"last_update_event":{"rtime":1793367240,"event_gid":"686395063661496317","announcement_gid":"686395063661496318","clan_account_id":45594703}}};
						</script>
					


							var StoreDefaults = {"PartnerEventStore":[{"gid":"683017363938869592","clan_steamid":"103582791475835515","event_name":"New Games, Layouts & Hotfix (v0.2.0)","event_type":13,"appid":5127370,"server_address":null,"server_password":null,"rtime32_start_time":1793199720,"rtime32_end_time":1793205001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Plinko, Mines, Crash and High Low, a casino that changes every round, and a big round of fixes\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"4 new games on the casino floor and 3 layouts that rotate every round.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"4773d5f1952350559a2f322bff1bf5a71a446af9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"dc390a7b56aaf7a8747359dbb3dfd05c87ced480.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683017363938869593","clanid":"46314107","posterid":"0","headline":"New Games, Layouts & Hotfix (v0.2.0)","posttime":1793199758,"updatetime":1793199758,"body":"[h2]Update v0.2.0 is live: 4 new games, rotating layouts and a hotfix![\/h2]\n\nRestart Steam to grab the update. Players on the old version can't join lobbies on the new one, so make sure your whole group updates.\n\n[h3]4 new games on the casino floor[\/h3]\n[list]\n[*][b]Plinko[\/b]: drop the ball and chase the 10X.\n[*][b]Mines[\/b]: a shared table for up to 4 players. Take turns picking tiles and cash out before you hit a mine\n[*][b]Crash[\/b]: a 5-stand rocket machine. Jump out before it crashes\n[*][b]High Low[\/b]: dealer tables where you call if the next card is higher or lower.\n[\/list]\n\n[h3]Layouts[\/h3]\n[list]\n[*]Every round the casino rotates between 3 layouts\n[*]Same building, different placement of tables and machines,\n[*]Currently its non optional rotation, we will add in the future more layouts,  & voting for layouts if we get feedback about it\n[\/list]\n\n[h3]High Roller[\/h3]\n[list]\n[*]Max bet raised to [b]1,200[\/b] at the new 7-seat tables in Tony's area\n[\/list]\n\n[h3]Security[\/h3]\n[list]\n[*]The host can now choose when Security can shoot: anywhere from [b]30% to 95%[\/b] of the Cheater's progress (70% by default)\n[\/list]\n\nFound a bug? Use the [b]REPORT A BUG[\/b] button on the main menu. Thanks for playing!","commentcount":1,"tags":["mod_reviewed","ModAct_1894963720_1793204277_0"],"language":0,"hidden":0,"forum_topic_id":"571553273173044683","event_gid":"683017363938869592","voteupcount":3,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571553273173044683","rtime32_last_modified":1793391144,"news_post_gid":"0","rtime_mod_reviewed":1793204277,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793160964,"votes_up":3,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594069880290978828","gidfeature2":"571553273173044683"},{"gid":"683016729753819792","clan_steamid":"103582791475835515","event_name":"4 new machines are coming to the casino floor","event_type":28,"appid":5127370,"server_address":null,"server_password":null,"rtime32_start_time":1793055000,"rtime32_end_time":1793058600,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Plinko, Mines and two more we're not showing yet.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"f38576cbe09e3a0212b1631725361ce75eaeef2a.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"93b52b76936ac8db0b01150b14a1338ace99a47d.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"683016729753819793","clanid":"46314107","posterid":"0","headline":"4 new machines are coming to the casino floor","posttime":1793055056,"updatetime":1793055056,"body":"[h2]4 new machines are coming to the casino floor[\/h2][p]We've been building. Four new machines are on their way to Who's Cheating, and we can show you two of them.\n\n[\/p][h3]Plinko[\/h3][p]mythical.  [\/p][h3]Mines[\/h3][p]Up to 4 players at the same time [\/p][h3]And two more [\/h3][p]We're not showing them yet. One of them leaves the ground. If you cheat smart you will make bank out of them[\/p][p]Coming real soon. Follow the game so you don't miss it.\n\n[\/p]","commentcount":5,"tags":["mod_reviewed","ModAct_783923276_1793056624_0"],"language":0,"hidden":0,"forum_topic_id":"571552997743705915","event_gid":"683016729753819792","voteupcount":5,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"571552997743705915","rtime32_last_modified":1793391726,"news_post_gid":"0","rtime_mod_reviewed":1793056625,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793053902,"votes_up":5,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"594069880290978828","gidfeature2":"571552997743705915"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["683017363938869593","683016729753819793"],"last_update_event":{"rtime":1793199720,"event_gid":"683017363938869592","announcement_gid":"683017363938869593","clan_account_id":46314107}}};

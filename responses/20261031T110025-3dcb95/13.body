,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"710038327520139067\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"710038961706240025","clanid":"46406598","posterid":"0","headline":"Update 0.1.3.1 is OUT NOW! Major FPS Boost, Mini-Map & Multiplayer Fixes!","posttime":1793399114,"updatetime":1793399114,"body":"This update brings major performance improvements, a new mini-map, more transport options, improved settings, and numerous multiplayer fixes!\n\n[b]What\u2019s new?[\/b]\n\n[list]\n[*][b]Over 50% FPS improvements[\/b] across various PC hardware configurations.\n[*][b]New optional mini-map[\/b] with gold deposits, terrain contours, a compass, and equipment icons.\n[*][b]More transport options:[\/b] carry additional vehicles and equipment using low-loaders and platform trailers.\n[*][b]Worksite cleanup:[\/b] remove cut-down trees and individual map fences.\n[*][b]Increased limits[\/b] for pumps and conveyors.\n[*][b]Improved settings:[\/b] graphics options, camera sensitivity, and customizable control hints.\n[*][b]Multiplayer improvements:[\/b] better joining, reconnecting, world downloads, and terrain synchronization.\n[*][b]Bug fixes:[\/b] loading issues, shader problems, vehicle controls, and many other fixes.\n[\/list]\n\nMake sure everyone in your multiplayer session is running [b]v0.1.3.1[\/b]!\n\n[b]Still experiencing bugs?[\/b] Please report them in our Discord [b]bug-reports[\/b] forum channel with [b]v0.1.3.1[\/b] in the title. Include your game logs, what happened, and what you were doing when the issue occurred.\n\n[b]Thank you for your patience and continued support![\/b]","commentcount":10,"tags":["patchnotes","mod_reviewed","ModAct_803139239_1793401670_0"],"language":0,"hidden":0,"forum_topic_id":"564797873721688088","event_gid":"710038961706240024","voteupcount":65,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"564797873721688088","rtime32_last_modified":1793411074,"news_post_gid":"0","rtime_mod_reviewed":1793401671,"featured_app_tagid":0,"referenced_appids":[],"build_id":26333021,"build_branch":"","unlisted":0,"rtime_created":1793399009,"votes_up":65,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"574930338697203532","gidfeature2":"564797873721688088"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":[],"last_update_event":{"rtime":1793399100,"event_gid":"710038961706240024","announcement_gid":"710038961706240025","clan_account_id":46406598}}};

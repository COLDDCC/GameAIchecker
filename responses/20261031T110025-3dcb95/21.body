																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"678513764320938104","clan_steamid":"103582791475142694","event_name":"November Update: Black Ships on Dark Seas","event_type":13,"appid":2964090,"server_address":null,"server_password":null,"rtime32_start_time":1793602800,"rtime32_end_time":1793608201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"8227b1b11071002267ae898fd3a9c5aaecf21d3a.png\",\"439d605fb0159a4963621cad8f782aa7fffca1fb.png\",\"8b28b59b09d52907bd8b38717537c678b2b4a5ee.png\",null,\"7b814de2f23ad408567bc6e29471cfdd5ee13abb.png\",null,\"5a56e161c06b702a197c439385bfd13cb4d5567d.png\",\"5cef4d4a75464617219a5c1a91c8faa5bba92b9f.png\",\"8927073b7100fda943e0e5d90bdda2a9cc66f546.png\",null,\"cea441b9a76518eca8a01d15240623f078e1fda7.png\",null,null,null,null,null,null,null,null,null,null,null,\"31d442f87e7e7f434e4e4c9bb75bb5d555cb838d.png\",null,null,null,null,\"ce3ef832ca64d945db4c8527304d9162b3260da4.png\",null,null,null,null],\"localized_capsule_image\":[\"bf001e66a223cee5de1f34c1fcfe55a695ebc74d.png\",\"6fd1d0979da642113c75cb8196a1f4d03d538bc2.png\",\"0f0a7eedc77afeb1c3269c7ab5f68fa01d422ed3.png\",null,\"440a753e5617663126c1cef06b3d769acfbb7186.png\",null,\"29c73c3640aeffc9c1e391fdf368c89802e54f24.png\",\"32b0287fe13254b33bf9083726a8a0cb7da69062.png\",\"71ad467817ed708a866146d98115a8aa260b3519.png\",null,\"bfbfcd8fd955879491df7bd696083252900777b4.png\",null,null,null,null,null,null,null,null,null,null,null,\"bde0d1ca9cffa63086dfc26a68b5798a679ccd3e.png\",null,null,null,null,\"a63d9a799b512aa1a609fe0bad2cc85a08643466.png\",null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"678513764320938105","clanid":"45621286","posterid":"0","headline":"November Update: Black Ships on Dark Seas","posttime":1793373961,"updatetime":1793373961,"body":"[p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/22e0af27868c2e9e30b9cf5c5b0a8e2dad409ab6.png\"][\/img][\/p][p][previewyoutube=\"tZrFtwHuxkk;full\"][\/previewyoutube][\/p][p]Welcome to the new update information hub, Captains! Let's dive right in with a list of everything that's on the horizon.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/7f0fa526ca859390f29c64b6fef563b4d3beb4ef.jpg\"][\/img][\/p][list][*][p]The \"\u0421old Rain, Gray Steel\" campaign, rewarding Japanese Tier VII Premium destroyer Shigure[\/p][\/*][*][p]New black ships drop anchor[\/p][\/*][*][p]The Road to New Year continues[\/p][\/*][*][p]The Forrest Sherman marathon in full swing[\/p][\/*][*][p]The Advent Calendar awaits[\/p][\/*][*][p]Ranked & Brawl seasons[\/p][\/*][*][p]The Fleet Cup returns for Season 8[\/p][\/*][*][p]Pirates return to the Store[\/p][\/*][*][p]Battle of Taranto event[\/p][\/*][*][p]New battleship Commander for Soviet ships[\/p][\/*][*][p]Balance changes[\/p][\/*][*][p]Improvements and bug fixes[\/p][\/*][\/list][h1]\"\u0421old Rain, Gray Steel\" Campaign[\/h1][p]The new campaign, running November 2 through December 7, will feature a variety of goodies, with the all-new Japanese destroyer Shigure at the top of the pile. She's a hybrid option for playing Japanese destroyers. Her solid artillery suite and great concealment, paired with state-of-the-art, high-speed, hard-hitting torpedoes, put her in firmly in the running for the best in her tier. Plus, Shigure is the only Japanese destroyer to boast access to the combo of Exhaust Smoke Generator and Sonar. With the Engine Boost consumable further enhancing her speed, you're in for a rare treat.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/1f3375d7dd32b0222fd703235d870909490e4932.jpg\"][\/img][\/p][p]You get the new ship once you complete all 100 milestones of the campaign with Admiralty Backing active. You can always catch up on missed challenges using a special built-in mechanic. The full list of rewards is as follows:[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/6a73d64156afa7b7a32c68c07ede8142725b76cb.jpg\"][\/img][\/p][p][b]Rewards available without the Admiralty Backing:[\/b][\/p][list][*][p]50x Common Boosters[\/p][\/*][*][p]12x Imperial Japanese Navy camouflages[\/p][\/*][*][p]12x Shadow camouflages[\/p][\/*][*][p]10,000 Global XP[\/p][\/*][*][p]105,000 Commander XP[\/p][\/*][*][p]700,000 Research Points[\/p][\/*][*][p]600,000 credits[\/p][\/*][*][p]15x Promotion Orders[\/p][\/*][*][p]1x Insignia[\/p][\/*][*][p]1x Commendation[\/p][\/*][*][p]5 days of Premium Account[\/p][\/*][*][p]2,000 Ship Parts[\/p][\/*][*][p]2,500 Giftlets[\/p][\/*][*][p]1x Black Friday '26 crate[\/p][\/*][*][p]7x Fall Big Crates[\/p][\/*][*][p]1x Japanese Commander crate[\/p][\/*][*][p]Shigure patch base[\/p][\/*][*][p]Shigure patch symbol[\/p][\/*][\/list][p]Value of the rewards without the Admiralty Backing: [b]22,030 doubloons[\/b][\/p][p][b]Additional rewards with the Admiralty Backing (2,500 doubloons):[\/b][\/p][list][*][p]50x Rare Boosters[\/p][\/*][*][p]12x Imperial Japanese Navy camouflages[\/p][\/*][*][p]12x Shadow camouflages[\/p][\/*][*][p]35,000 Global XP[\/p][\/*][*][p]345,000 Commander XP[\/p][\/*][*][p]1,050,000 Research Points[\/p][\/*][*][p]2,400,000 credits[\/p][\/*][*][p]30x Promotion Orders[\/p][\/*][*][p]4x Insignia[\/p][\/*][*][p]4x Commendations[\/p][\/*][*][p]750 doubloons[\/p][\/*][*][p]2,000 Ship Parts[\/p][\/*][*][p]Shigure flag[\/p][\/*][*][p]Admiralty Backing special weekly mission rewarding Renown Points[\/p][\/*][*][p]Japanese Tier VII Premium destroyer Shigure[\/p][\/*][\/list][p]Total value of the rewards with the Admiralty Backing: [b]71,710 doubloons[\/b][\/p][h1]Black Ships: Dark Squadron Arrives[\/h1][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/f18d8c086b9448feac4d968c4e22a19d.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]Since Black Friday is upon us, this update comes with a selection of new black ships. As many as [b]six[\/b] of those will grace the Legendary waters this time, including the all-new Pan-American Tier VII Premium cruiser [b]Almirante Grau B[\/b], joined by [b]Rhode Island B,[\/b] [b]Lepanto B,[\/b] [b]Suwo B[\/b], [b]Osborne B[\/b], and [b]Asturias B[\/b]. All six ships feature stunning black skins, and their bundles include dedicated flags. This year's themed crate and content from previous Black Friday events will also be available. Stay tuned for more info in the dedicated article![\/p][h1]Pirates Return![\/h1][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/d790b8eb6974c1e9550457911cf263df4b44cc40.jpg\"][\/img][\/p][p]Yarrr! From November 16 till December 7, all Commanders, ships, and skins from the prior pirate events will be available in the Store. The same goes for the latest version of the pirate crrrate. It's a great way to enhance your collection, so don't miss out![\/p][h1]Ranked, Brawl, and Fleet Cup: Magnificent Trio[\/h1][p]There's plenty of ways to play your favorite game in this update! First of all, Fleet Cup returns for the 8th season, with 5v5 battles allowing only Tech Tree ships with no carriers included, available on each Friday, Saturday and Sunday of the update. The Ranked seasons are coming in hot, too: three straight week-long seasons of 1v1 Tier VII action, with the first one starting as early as November 3. Here's the full schedule:[\/p][list][*][p]Season 110: November 3\u20139, battleships only[\/p][\/*][*][p]Season 111: November 10\u201316, cruisers only[\/p][\/*][*][p]Season 112: November 17\u201323, destroyers only[\/p][\/*][\/list][p]Last but definitely not least comes the Asymmetric Brawl, challenging you to take on 12 AI-controlled enemies in a team of five between November 24 and 30. Keep your eyes peeled for the dedicated articles; each will dive into the details of the different battle types.[\/p][h1]Battle of Taranto Event[\/h1][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/15f7b20dd6904ce8bc1a2cafb24be7dd.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]A special event will be held to commemorate the anniversary of the Battle of Taranto. Within a free mission, active between November 9 and 30, you'll be able to score a variety of themed goods, including a unique flag. On top of that, expect discounts for British and Italian ships, all of that coupled with an option to acquire Napoli\u00a0B for doubloons and Warspite\u00a0B for Global XP through chained bundles.[\/p][h1]New Battleship Commander[\/h1][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/144802670b87483489123f9ebf8b7105.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]Besides that, Soviet battleships are receiving a new Commander you can put at their helm. Zinovy Rozhestvensky is a prominent historical figure and comes with an array of new skills (including a new Legendary skill) focused on improving both the offensive and defensive capabilities of your ship. His [b]Mad Dog[\/b] base trait improves your battleship's main battery damage within 11 km range by up to 6%, while his \"[b]The Long Voyage[\/b]\" unique skill increases Repair Party duration (by up to 30%) and reduces its cooldown time (by up to 20%), while also increasing the total citadel HP restored by that consumable by up to 20% in a new unique effect. However, HP healed per second decreases (by up to 10%) to balance out all the bonuses.[\/p][p]Here's a list of the new skills[\/p][list][*][p][b]Shrapnel-Proof[\/b] reduces the fire-catching chance for your ship and fire damage to your battleship by up to 10% and 5% respectively.[\/p][\/*][*][p][b]Concentrated Fire[\/b] improves battleship main battery shell grouping by up to 7.5%, and subsequent AP shell damage to the same target with each AP shell hit by up to 5% total.[\/p][\/*][*][p][b]All or Nothing[\/b] reduces minimum and guaranteed ricochet angles for shells that hit your battleship by up to 5% each; increases damage to your ship's extremities by up to 5%.[\/p][\/*][*][p][b]Test of Endurance[\/b] reduces Damage Control Party cooldown time by up to 10% and increases its duration by up to 10%; grants one extra charge to all consumables; and reduces incoming damage from shells, torpedoes, and bombs to your battleship while Damage Control Party is active by up to 10%.[\/p][\/*][*][p][b]Unbreakable (Legendary skill)[\/b] reduces torpedo damage to your ship (by up to 20%). It also grants a special effect that reduces incoming damage to your battleship by up to 10% and makes your modules immune to damage and disabling. This special effect activates when an enemy ship is within a range of 6 km (at maximum skill mastery).[\/p][\/*][\/list][p]You'll be able to acquire this Commander via a dedicated prolonged mission running throughout the update.[\/p][h1]The Road to New Year: Still To Come[\/h1][p]The Road to New Year event does not stop here! Continue accumulating Giftlets through various activities so that you can acquire a selection of rewards when the next update starts, with a choice between Ohio, Lenin, and Jean Bart as the biggest holiday treat. A detailed look, including a dedicated video, [url=\"https:\/\/wowslegends.com\/news\/588-road-to-new-year-begins-lenin-jean-bart-ohio-and-more-rewards\"]is available here[\/url].[\/p][p]That's not all! On December 1 (surprisingly!), the Advent Calendar arrives, with rewards each day just for checking in and more for completing missions, including up to 2,500 doubloons, with a surprise final prize that will be revealed as you progress through the Calendar. If you're working toward your Jean Bart, Lenin or Ohio, the holiday campaign's Admiralty Backing will have the last Giftlets you need!We'll keep you posted: look out for more information as the release date approaches.[\/p][h1]The Forrest Sherman Marathon Continues[\/h1][p]This update you'll be able to collect more Ship Parts to propel you on the way to acquiring U.S. Legendary Tier destroyer Forrest Sherman! You can obtain them through the campaign (both with and without Admiralty Backing), Weekly Assignments, and as a bonus with the black ships acquired from Store bundles or crates.[\/p][p]Before you go, take a break and reward yourself with a small bonus:[\/p][list][*][p]1x Fall Big Crate[\/p][\/*][*][p]10x Shadow camouflages[\/p][\/*][*][p]10x Common Battle Boosters[\/p][\/*][*][p]Captain Reader flag[\/p][\/*][\/list][p]Redeem the code: [b]X9JJXNVYWW[\/b][\/p][h1]Balance Changes[\/h1][p]This update brings improvements for the French alternative cruiser line and U.S. alternative destroyers. On top of that, Hood (she's getting torpedoes!), Genova, Hindenburg and more ships also receive various adjustments. That, [i]perhaps surprisingly[\/i], includes a [b]nerf[\/b] for Vanguard.[\/p][p]A detailed look at the changes is available in [url=\"https:\/\/wowslegends.com\/news\/600\"]another issue of our Ministry of Balance series[\/url]. The changes for this update are not limited to ships: the Shards map has been reworked to provide more strategic possibilities and improve overall gameplay, namely readjusting some of the island terrain.[\/p][h2]Grimshard Exchange[\/h2][p]Starting with this update, Grimshards will be no longer available in-game. You'll receive a compensation of 1,500 credits per 1 Grimshard. At the same time, Soulshards will be removed without compensation.[\/p][h1]Improvements and Bug Fixes[\/h1][p]The following bugs have been fixed:[\/p][h3]All platforms[\/h3][list][*][p]The camera for Theseus torpedo bombers has been improved[\/p][\/*][*][p]The Aerial Fire Support skill description has been improved[\/p][\/*][*][p]The H\u00e9rcules voiceover has been corrected[\/p][\/*][*][p]The torpedo upgrade on Orage is now depicted correctly in the Specs tab[\/p][\/*][*][p]The Kaga planes' sound with the Mecha Pioneer skin equipped has been improved[\/p][\/*][*][p]A couple of minor interface improvements have been made to the Service Record[\/p][\/*][\/list][h3]PC[\/h3][list][*][p]Start of battle crashes have been fixed[\/p][\/*][\/list][p]Brave the dark waters, and turn the tide![\/p]","commentcount":0,"tags":["mod_reviewed","ModAct_1889321037_1793375718_0"],"language":0,"hidden":0,"forum_topic_id":"568175573451669910","event_gid":"678513764320938104","voteupcount":7,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":5,"ignore_count":0,"forum_topic_id":"568175573451669910","rtime32_last_modified":1793400518,"news_post_gid":"0","rtime_mod_reviewed":1793375718,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793361343,"votes_up":7,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"612037567209046188","gidfeature2":"568175573451669910"},{"gid":"692022026548806696","clan_steamid":"103582791475142694","event_name":"Halloween Update: The Restless Fleet","event_type":13,"appid":2964090,"server_address":null,"server_password":null,"rtime32_start_time":1791183600,"rtime32_end_time":1791189001,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"e7677a48f51a070600ba4389dbe9f7bb98370e98.png\",\"ab35a845087c630bf2b837260fb9ec270bf596e6.png\",\"ee21996d707ffda0f65473a3f916636c5c783622.png\",null,\"b21202125c7eb5220c2b320cdfd58f8647667f99.png\",null,\"619c882aa100f98e5cec72ed4a32e7808a944ead.png\",\"38bd7c021bf3e4541f2c90fd43963747f045055f.png\",\"d36c116d20dcdd2b2d182b22f2abfa51a742d889.png\",null,\"7923fc856cfd77a4b91a77696e70686d819cb543.png\",null,null,null,null,null,null,null,null,null,null,null,\"8a2d59820f129d3fc136bce25258eb0d9417de06.png\",null,null,null,null,\"28348607807de7d6c1995cc9f92cbefdc3717033.png\",null,null,null,null],\"localized_capsule_image\":[\"a4736533ffad1dca4967fc45e48235f603ed7745.png\",\"92c3ea00e232f7f6b24400a8427af949e867dd41.png\",\"ef3d5f48ddfade3bb2bd27959abc5ec6b847db5d.png\",null,\"c1a1cf3aff9e16be7af1d9ac15ae30f985e952fb.png\",null,\"a87f11ab46d9b02cc455d82f153cdcf051c8c5bf.png\",\"99b7a2353ea19371bc2cf1ed80fd1af8ba43baec.png\",\"e59b4ed46d262d279182009403e4498467e860a7.png\",null,\"461950543404896c04618116903aaa315b9f893a.png\",null,null,null,null,null,null,null,null,null,null,null,\"4a225f76ec80f09875d478ef85fe2123f046f0d1.png\",null,null,null,null,\"6d5ab83175a6072c85590f94f36a8ac2e2f9bd47.png\",null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"692022026548806697","clanid":"45621286","posterid":"0","headline":"Halloween Update: The Restless Fleet","posttime":1790953649,"updatetime":1793373866,"body":"[p][\/p][previewyoutube=\"KauxGYfFfpY;full\"][\/previewyoutube][h2]Halloween Update: The Restless Fleet[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/images\/8.8_Aberdeen_j29022_NoLOGO_1920x1080_WoWSL_5181c9931c.png\"][\/img][\/p][p]Ahoy, Captains! Shadows are gathering on the horizon\u2014Halloween is coming, bringing new content and various changes along with it. Let's find out![\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/1461b5d7b9ae92efba403cd23822781bb9fe0c4c.jpg\"][\/img][\/p][p]Here's what's new in this update:[\/p][list][*][p]Campaign featuring British Tier VIII Premium cruiser Aberdeen[\/p][\/*][*][p]Halloween '26: new battle type with themed content[\/p][\/*][*][p]Road to New Year: Start collecting Giftlets to prepare for the winter update[\/p][\/*][*][p]Start of the marathon for U.S. Legendary Tier destroyer Forrest Sherman[\/p][\/*][*][p]The return of the Blue Archive collaboration\u00a0[\/p][\/*][*][p]400th anniversary of the French Navy[\/p][\/*][*][p]Battle of Trafalgar commemorative event[\/p][\/*][*][p]Battle of Leyte Gulf: Themed missions, new camouflages, and discounts[\/p][\/*][*][p]New ship for Steel: Pan-American Legendary Tier destroyer La Pampa[\/p][\/*][*][p]New Bureau Project: British Legendary Tier battleship St. Vincent[\/p][\/*][*][p]Balance changes[\/p][\/*][*][p]Improvements and bug fixes[\/p][\/*][\/list][h2]\"The Foghorn's Bride\" Campaign[\/h2][p]Complete the new 4-week \"The Foghorn's Bride\" campaign from October 5 to November 2 and get a variety of rewards! The final prize is British Tier VIII Premium cruiser Aberdeen. This ship is armed with four 152 mm twinturrets, exclusively firing AP shells with improved penetration angles. Combined with fast-reloading guns, these AP shells give Aberdeen high, consistent damage per minute. The ship is also equipped with a powerful Repair Party, Radar, and a short-burst Smoke Generator similar to those found on destroyers.[\/p][p][\/p][carousel][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/e0d94fbb302dcd6e0aaa1ea492c23300463012b3.jpg\"][\/img][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/47ed6d4b2a341ddd2ba06ff2ac33c9703ebb8a91.jpg\"][\/img][\/carousel][p]You get the new ship once you complete all 80 milestones of the campaign with an active Admiralty Backing. You can always catch up on missed challenges using a special built-in mechanic. In addition to Standard, Arcade, and Versus AI Battles, you can also complete challenges in the new Halloween battle type, but this may require more effort. Take a look at the full list of campaign rewards:[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/45621286\/19c68e6eb4985e2db08540a800a600483e73287c.jpg\"][\/img][\/p][p][b]Rewards available without the Admiralty Backing:[\/b][\/p][list][*][p]50x Common Boosters[\/p][\/*][*][p]8x Union Jack camouflages[\/p][\/*][*][p]8x \"Type 3 \u2013 Halloween\" camouflages[\/p][\/*][*][p]10,000 Global XP[\/p][\/*][*][p]100,000 Commander XP[\/p][\/*][*][p]525,000 Research Points[\/p][\/*][*][p]500,000 credits[\/p][\/*][*][p]14x Promotion Orders[\/p][\/*][*][p]1x Insignia[\/p][\/*][*][p]1x Commendation[\/p][\/*][*][p]5 days of Premium Account[\/p][\/*][*][p]3,000 Ship Parts[\/p][\/*][*][p]2,500 Grimshards[\/p][\/*][*][p]3x Halloween Ultimate Crates[\/p][\/*][*][p]1x Halloween '26 crate[\/p][\/*][*][p]2x Fall Big Crates[\/p][\/*][*][p]1x British Commander crate[\/p][\/*][*][p]Aberdeen patch base[\/p][\/*][*][p]Aberdeen patch symbol[\/p][\/*][\/list][p]Value of the rewards without the Admiralty Backing: [b]18,553 doubloons[\/b][\/p][p][b]Additional rewards with the Admiralty Backing (2,500 doubloons):[\/b][\/p][list][*][p]50x Rare Boosters[\/p][\/*][*][p]8x Union Jack camouflages[\/p][\/*][*][p]8x \"Type 3 \u2013 Halloween\" camouflages[\/p][\/*][*][p]35,000 Global XP[\/p][\/*][*][p]380,000 Commander XP[\/p][\/*][*][p]1,225,000 Research Points[\/p][\/*][*][p]2,650,000 credits[\/p][\/*][*][p]16x Promotion Orders[\/p][\/*][*][p]4x Insignia[\/p][\/*][*][p]4x Commendations[\/p][\/*][*][p]750 doubloons[\/p][\/*][*][p]3,000 Ship Parts[\/p][\/*][*][p]2,500 Grimshards[\/p][\/*][*][p]Aberdeen flag[\/p][\/*][*][p]Admiralty Backing special weekly mission rewarding Renown Points[\/p][\/*][*][p]British Tier VIII Premium cruiser Aberdeen[\/p][\/*][\/list][p]Total value of the rewards with the Admiralty Backing: [b]74,615 doubloons[\/b][\/p][h2]Halloween '26: New Battle Type[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/a1f6e02e1bfa4d3fb24a78c68a1dec94.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]Spooky season brings a new game mode! From October 5 to November 2, confront the headless admiral Ludwig Jackson and stop him from gathering the fragments of his charred soul. Earn Grimshards along the way and trade them for Halloween Commanders and skins, a new, higher-tier version of B\u0142yskawica, and more rewards. [url=\"https:\/\/wowslegends.com\/news\/587\"]Check out a dedicated article[\/url] for all the details![\/p][h2]The Road to New Year Begins![\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/1b32411edbd148ab8a0f0fc4a9e447f2.png\" style=\"max-width: 100%;\"][\/img][\/p][p]The new Road to New Year event starts on October 5, giving you a unique opportunity to receive a rare ship for free: Ohio, Lenin, Jean Bart, or one of the new ships we'll reveal later. Participate in various in-game activities across three consecutive updates and earn Giftlets. Once the winter holiday update begins, you'll be able to exchange them for these ships and more rewards. To be able to receive a ship for free, be sure to start collecting Giftlets as soon as the new update launches! Each Captain will also get a coupon for a free Premium ship. [url=\"https:\/\/wowslegends.com\/news\/588\"]Read the Road to New Year article[\/url] for the full event details and more info on rewards.[\/p][h2]New Marathon Starts: Forrest Sherman[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/1a6917870bcd46629681fd97dae24d5c.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]Join the marathon for U.S. Legendary Tier destroyer Forrest Sherman, starting October 5! Historically, she was the lead ship of a post-WWII destroyer series. In Legends, she wields three 127 mm guns with the fastest reload so far among Legendary Tier destroyers, firing both HE and SAP shells. You can earn Forrest Sherman by collecting Ship Parts over several updates. During the upcoming update, you can find Ship Parts in the campaign, Weekly Assignments, and as a bonus with some of the Halloween content.[\/p][h2]Blue Archive: The Big Comeback\u00a0[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/48dc03e6433a4ed18995c39b3118c711.png\" style=\"max-width: 100%;\"][\/img][\/p][p]Good news for all Blue Archive fans: Your favorite characters and ships from both waves of the collaboration are returning to Legends from October 5 through December 7! The returning content includes eight Commanders\u2014Hoshino, Nonomi, Ayane, Shiroko, Serika, Yuuka, Maki, and Wakamo\u2014as well as five unique ships: BA Montana, BA Tirpitz, BA Utnapishtim's Ship, BA Binah, and BA Hovercraft. A special skin for Takahashi is also returning.\u00a0[\/p][p]You can find all Blue Archive content in the Store and in Blue Archive II containers. Don't forget to complete the special mission available from October 5 through December 7 to receive one Blue Archive II container for free, along with a set of themed camouflages.\u00a0[\/p][p]\u00a9 2026 NEXON Korea Corporation. & NEXON Games co., Ltd. All Rights Reserved.\u00a0[\/p][h2]400th Anniversary of the French Navy[\/h2][p]This year marks the 400th anniversary of the founding of the French Navy! From October 12 to November 2, complete the \"Marine Nationale: 400 Years\" mission to earn a themed flag and background, 10x Promotion Orders, and 1x French Battleship crate. This crate offers you a chance to receive Tier VI Premium battleship Strasbourg, Tier VII Premium battleship Flandre, or one of the R\u00e9publique Fran\u00e7aise skins for French battleships.[\/p][h2]Battle of Trafalgar[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/4936ef5713c14ba2b980d4cf90804c67.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]From October 12 to November 2, commemorate the Battle of Trafalgar\u2014the decisive naval clash of the Napoleonic Wars fought on October 21, 1805, where the British fleet, commanded by Vice Admiral Horatio Nelson, defeated the combined Franco-Spanish fleet. Visit the Store to claim the \"Trafalgar: Breaking the Line\" free mission exclusively for British, French, and Spanish ships. Completing this mission will bring you British and French national camouflages, the Trafalgar Day flag, and 1x Royal Benevolence crate. This new crate can drop a British Premium ship, including two new ones\u2014Tier V battleship Royal Sovereign and Tier VII aircraft carrier Theseus\u2014plus Tier VI cruiser Belfast and Tier VII battleship Rodney. You'll also find various themed content in the Store, including discounted French battleships and a chained bundle with French Tier VII Premium battleship Picardie in the final bundle.[\/p][p]Also, don't miss a 30% discount on Tier IV\u2013VIII British, French, and Spanish Tech Tree ships, active from October 12 to November 2.[\/p][h2]Battle of Leyte Gulf[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/1c4edaa3a1c046d1b78664ec10b8f386.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]From October 19 to November 2, we'll be commemorating the biggest naval clash of World War II that took place on October 23\u201326, 1944. First of all, you can join three new missions, each reflecting a major phase of the battle: the San Bernardino Strait transit, Ozawa's decoy operation to lure Task Force 38 away, and the Battle of Surigao Strait. Completing each mission with specific historical ships will be much faster\u2014see the details for each mission once the event is live. The rewards include Commander crates and new player backgrounds.[\/p][p]Additionally, check out the Store during the event for discounts on ships that participated in the battle. You'll also find a special bundle where you can choose one of the two new history-inspired permanent camouflages\u2014one for Massachusetts and another for Atago\u2014and obtain it for Global XP. The remaining one will be available for doubloons.[\/p][h2]New Ship for Steel: La Pampa[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/9ed407466227405797d1f0c53ea89e3b.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]New Pan-American Legendary Tier destroyer La Pampa is coming to the Store for Steel on October 5 and will remain there indefinitely. This ship allows for a hybrid playstyle, combining strong firepower with potent torpedo armament. She's equipped with two 113 mm twin main battery turrets mounted on the bow, as well as 15 torpedo tubes arranged across three launchers at the stern. Both her main battery and torpedoes benefit from fast reload times, allowing her to effectively engage enemy destroyers with gunfire while maintaining consistent pressure on larger ships with torpedo attacks. La Pampa also boasts a versatile set of consumables, including a Smoke Generator, Torpedo Reload Booster, and the choice between an enhanced Repair Party and Advanced Sonar.[\/p][p]Need more Steel? Here's how to earn it in the upcoming update:[\/p][list][*][p]The Steel Harvest weekly mission for the new Halloween battle type, unlocked once you complete the Shard Harvest mission (which resets after two weeks of the event, so you need to complete it again to unlock Steel Harvest for weeks 3 and 4): Up to 3,200 Steel in total[\/p][\/*][*][p]\"The Foghorn's Bride\" campaign: Up to 250 Steel weekly through Endless Trials, which unlock after completing the campaign with the Admiralty Backing. If you buy out the campaign on day 1 and complete all the Endless Trials, you can get up to 1,000 Steel in total[\/p][\/*][*][p]The Premium Supplies mission for Premium ships, resetting weekly: Up to 600 Steel in total[\/p][\/*][\/list][h2]New Bureau Project: St. Vincent[\/h2][p][img src=\"https:\/\/navy-media-lepo-prod.wgcdn.co\/lepo\/media\/news_gallery\/53cb4726d663473b8a48e120969d2e11.jpg\" style=\"max-width: 100%;\"][\/img][\/p][p]British Legendary Tier battleship St. Vincent will arrive as a Bureau Project starting October 5 and remain there indefinitely. This new ship is based on the battlecruiser design I3. She's equipped with nine 457 mm guns, delivering some of the highest AP damage per second among battleships at her tier. Her good concealment lets her move closer to the fight before being spotted, while her high speed gives her the flexibility to reposition quickly, exploit weak flanks, and create crossfires.[\/p][p][i]Read this far? Here's a small gift: 1x Fall Big Crate, 10x Halloween '24 camouflages, 10x Common Credit Boosters, and the Captain Reader flag if you don't already have it. \nRedeem the code: [b]NP9JT74BLH[\/b][\/i][\/p][p][\/p][h2]Balance Changes[\/h2][p][b]Ships[\/b][\/p][p]We're introducing various adjustments to the following British alternative battleships and Soviet Tech Tree battleships: Tiger, Renown, Rooke, Hawke, Duncan, Dover, Gangut, Pyotr Velikiy, Izmail, Sinop, Vladivostok, and Sovetsky Soyuz.[\/p][p]Find all the details of these changes in the new [url=\"https:\/\/wowslegends.com\/news\/589\"]Ministry of Balance article[\/url].[\/p][p][b]Module HP[\/b][\/p][p]We've also updated the way HP is assigned to secondary battery, AA, and torpedo modules at the start of each battle. Now, identical modules on the same ships will always have the same HP value rather than a randomized one each battle.[\/p][p][b]\"Farsight\" Skill Update[\/b][\/p][p]We've completely reworked the \"Farsight\" Commander skill for true sniping mastery:[\/p][list][*][p]New effects added:[\/p][list][*][p]Reducing main battery dispersion by 5% for the cost of reducing battleship gun traverse speed by 1.5\u00b0\/s[\/p][\/*][*][p]Showing a warning indicator for incoming long-range enemy fire[\/p][\/*][*][p]Special effect: When no detected enemy ships are within 9\/8.5\/8\/7.5 km range, dealing 10% more damage with citadel strikes and increasing battleship's AP shell penetration multiplier by 10%[\/p][\/*][\/list][\/*][*][p]Old effects removed:[\/p][list][*][p]Increasing torpedo acquisition range[\/p][\/*][*][p]Reducing torpedo damage to your ship[\/p][\/*][\/list][\/*][\/list][p]Here's the list of Commanders who have this skill: Jonathan Hawke, William Sims, Azur\u00a0Lane Colorado, Azur\u00a0Lane New Jersey, Justinian Lyons XIII, Andrew Cunningham, John Arbuthnot Fisher, Azur\u00a0Lane Hood, Azur\u00a0Lane Nelson, Azur\u00a0Lane Queen Elizabeth, Simon Cassidy, Takagi Takeo, Azur\u00a0Lane Fusou, ARP Kirishima, Godzilla, ARP Musashi, ARP Yamato, Franz von Hipper, Azur\u00a0Lane Prinz Heinrich, Henry J. Hide, John Luke Pickup, Robert Jaujard, Azur\u00a0Lane Richelieu, Azur\u00a0Lane Dunkerque, Lev Galler, Angelo Iachino, and Azur\u00a0Lane Littorio.[\/p][h2]Cross-Platform Item Access[\/h2][p]Starting with this update, items obtained on one platform will also be available on your other platforms. This includes ships, skins, permanent camouflages, containers, and flags. This applies retroactively\u2014everything you've already unlocked carries over, along with anything you unlock from now on.[\/p][p]The only exception: Items obtained outside the PlayStation Store will remain locked on PlayStation.[\/p][h2]Mariner's Coins Exchange[\/h2][p]Mariner's Coins are leaving the game in this update. You'll receive a compensation of 1,500 credits per 1 Mariner's Coin.[\/p][h2]Improvements and Bug Fixes[\/h2][p][b]All platforms[\/b][\/p][list][*][p]Fixed a bug causing Sejong's torpedo protection to drop to 0% when upgrading to Hull B.[\/p][\/*][*][p]Fixed a visual issue where a wooden deck was still visible when using certain camouflages on Tirpitz.[\/p][\/*][*][p]Fixed minor visual issues on \"The Atlantic\" and \"Greece\" maps.[\/p][\/*][\/list][p][b]PC[\/b][\/p][list][*][p]Fixed a bug where a container's list of guaranteed rewards sometimes appeared incomplete.[\/p][\/*][\/list][p]Play Legends and turn the tide![\/p]","commentcount":4,"tags":["mod_reviewed","ModAct_1889321037_1790954456_0","ModAct_1889321037_1793375680_4"],"language":0,"hidden":0,"forum_topic_id":"591816934842145305","event_gid":"692022026548806696","voteupcount":61,"votedowncount":4,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"591816934842145305","rtime32_last_modified":1793400528,"news_post_gid":"0","rtime_mod_reviewed":1793375681,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790943544,"votes_up":61,"votes_down":4,"comment_type":"ForumTopic","gidfeature":"612037567209046188","gidfeature2":"591816934842145305"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["678513764320938105","692022026548806697"],"last_update_event":{"rtime":1793602800,"event_gid":"678513764320938104","announcement_gid":"678513764320938105","clan_account_id":45621286}}};
						</script>
					


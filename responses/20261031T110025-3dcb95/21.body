	// Temporary code to allow React to move focus to elements that are non-React.
	function MoveFocusToId( id )
	{
		$el = $J( id );
		if ( $el.length )
		{
			$el[0].focus();
		}
	}
	window.MoveFocusToId = MoveFocusToId;

	$J( function() {
		var $Expander = $J('#devnotes_expander');

							var StoreDefaults = {"PartnerEventStore":[{"gid":"674008896091718835","clan_steamid":"103582791475404389","event_name":"Further improvements & fixes. Patch 1.3.5","event_type":28,"appid":4094660,"server_address":null,"server_password":null,"rtime32_start_time":1792414680,"rtime32_end_time":1792418100,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"a6a65563d1d7f81d67e9ac189f4ce2c823692eb2.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"674008896091718836","clanid":"45882981","posterid":"0","headline":"Further improvements & fixes. Patch 1.3.5","posttime":1792414711,"updatetime":1792414711,"body":"[p]Space adventurers,[\/p][p]We have continuously worked on improving your experience with Rivage and are now ready with a new patch. It includes:[\/p][p][\/p][p]Improvements:[\/p][list][*][p][spoiler]the glitch effect on the Arcade machine is removed, if the player has already looped previously [\/spoiler][\/p][\/*][*][p][spoiler]once the Arcade machine has been used at least once, a Loop option appears in the menu for easier and faster looping [\/spoiler][\/p][\/*][*][p][spoiler]the Cubik's Cube now has a fixed start position [\/spoiler][\/p][\/*][*][p][spoiler]Datalens.exe cannot be executed anymore on a computer that doesn't have the file [\/spoiler][\/p][\/*][*][p][spoiler]the Morse Code volume is now linked to the Global volume [\/spoiler][\/p][\/*][\/list][p]Bug fixes:[\/p][list][*][p]a fix for Linux and Steam Deck crashing (even though please note that we don't officially support them)[\/p][\/*][*][p][spoiler]if the player loses in the Arcade machine game, the boss will not continue firing, rather it is destroyed [\/spoiler][\/p][\/*][*][p]players cannot crouch and run at the same time anymore[\/p][\/*][*][p][spoiler]assembly machine in the Garage plays the activated sound when approached even when the power is off [\/spoiler][\/p][\/*][*][p][spoiler]accessibility icons no longer mismatch between Rafael's drawing and the safe in the Garage [\/spoiler][\/p][\/*][*][p]some minor texture overlapping in the Lobby and Garage has been fixed[\/p][\/*][*][p]anti-aliasing mode \"Nvidia DLSS Ray Reconstruction\" now fits the text block[\/p][\/*][*][p]setting reflections on Low in the Settings now shows ingredients on the table clearly[\/p][\/*][*][p]subtitles no longer cover part of the UI when the player takes an item for the first time[\/p][\/*][*][p][spoiler]it's no longer possible to break and lose the Loop cursor on the Arcade machine after losing the boss battle [\/spoiler][\/p][\/*][*][p]multi-monitor switching now works properly[\/p][\/*][*][p][spoiler]\"Already downloaded\" prompt persists on the UV light after re-collecting the Multi-pass card [\/spoiler][\/p][\/*][*][p][spoiler]walking backwards through the portal slowly no longer gets the player behind the portal [\/spoiler][\/p][\/*][*][p]when turning off the accessibility mode, part of the icons no longer remain visible[\/p][\/*][\/list][p][\/p][p]As usual, we continue looking into your feedback and improving the game. If you encounter any issues, please let us know at [url=\"https:\/\/rawfury.atlassian.net\/servicedesk\/customer\/portal\/1\"]https:\/\/rawfury.atlassian.net\/servicedesk\/customer\/portal\/1[\/url] This is the fastest way for us to work with your question directly.[\/p][p]Thank you for your continuous support and good luck on your journey through Rivage![\/p][p][\/p][p]- The Exnilo and Raw Fury Team[\/p]","commentcount":5,"tags":["mod_reviewed","ModAct_1889321037_1792418004_0"],"language":0,"hidden":0,"forum_topic_id":"570426530135642099","event_gid":"674008896091718835","voteupcount":91,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570426530135642099","rtime32_last_modified":1792915727,"news_post_gid":"0","rtime_mod_reviewed":1792418004,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792400310,"votes_up":91,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"685239361818698528","gidfeature2":"570426530135642099"},{"gid":"690896126641963072","clan_steamid":"103582791475404389","event_name":"Major improvements to puzzles & graphics. Patch 1.2.9","event_type":28,"appid":4094660,"server_address":null,"server_password":null,"rtime32_start_time":1790777580,"rtime32_end_time":1790778840,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"ea87f49064d0e1e773b3058a144658925a8b1a24.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"690896126641963073","clanid":"45882981","posterid":"0","headline":"Major improvements to puzzles & graphics. Patch 1.2.9","posttime":1790777606,"updatetime":1790777606,"body":"[p]Dear space adventurers,  [\/p][p]Since the release of Patch 1.1.6 last week and as per our commitment to make Rivage the best game it can be, we have been channeling our inner Miranda to find the best solutions for the issues you have reported. Thank you for your trust and patience. [\/p][p]For this patch, we've been cooking up further improvements to make Rivage look and feel the way we've always envisioned it to be. Our two-people dev time worked closely with the tech experts over at Fury Studios and together we managed to further optimize and improve the performance and visuals of Rivage. We've worked hard to give you more options to customize the settings, so that you could get the best experience possible. Please find the changelog below:[\/p][list][*][p]We fixed the root causes of several crash issues, especially Intel CPU laptops with NVIDIA GPUs.[\/p][\/*][*][p]We bring you major performance fixes and further optimization as [b]we have achieved 15% to 35% improvements[\/b] at certain points.[\/p][\/*][*][p]There are now latest vendor-specific tech solutions for visuals: [b]NVIDIA DLSS 4.5[\/b] and [b]AMD FSR Redstone (FSR 4[\/b]) as anti-aliasing modes with [b]DLSS Ray Reconstruction[\/b] for the fastest devices and [b]Intel XeSS for integrated GPUs[\/b]. These options combined with [b]cutting edge Frame Generation[\/b] should make the game run smoothly and look beautiful even on lower settings.[\/p][\/*][*][p]Low and Medium quality setups are now gorgeously looking, only slightly toned down from the Cinematic experience.[\/p][\/*][*][p]Fixed community reported grain and blur issues with [b]modern device-specific solutions[\/b].[\/p][\/*][*][p]Added more[b] rendering resolution options.[\/b][\/p][\/*][*][p]Added colorblind options: [spoiler] affected puzzles are the TV riddle in the Miranda's Room, the Lobby showcase puzzle, xylophone puzzle (both the drawing in Rafael's room and the instrument in the Lobby), Cubik's Cube vault, Rafael's drawing after completing the hexadecimal puzzle on the first floor of the Lobby, Cubik's Cube scheme on the first floor of the Lab. [\/spoiler] [\/p][\/*][*][p] [spoiler]Fixed the Horizon Probe's tarot card animation after the players move too far away. [\/spoiler] [\/p][\/*][*][p][spoiler]Morse code volume has been increased. [\/spoiler][\/p][\/*][*][p] [spoiler]Players can now scan and add the Tarot cards to their K9 interface. [\/spoiler] [\/p][\/*][*][p] [spoiler]Fixed descriptions of the Tarot cards. [\/spoiler] [\/p][\/*][*][p]Ares Station video in the Observatory will stop playing, if the players open the shutters.[\/p][\/*][*][p] [spoiler]Reworked the Cubik's Cube puzzle \u2013 players no longer need to stand in a specific spot to solve it and teleport to Rafael's hiding space. [\/spoiler] [\/p][\/*][*][p] [spoiler]Reworked the Laboratory fingerprint puzzle \u2013 players can now only scan items with the Jonny Kim's fingerprint. Other items will no longer display a scanable fingerprint. [\/spoiler] [\/p][\/*][*][p] [spoiler]Added extra clues for the vault in the Laboratory \u2013 blood trail near the vault now informs the player to search for other blood spots in the Lab.[\/spoiler][\/p][\/*][*][p]Removed a lighting issue near the vending machine in the Observatory,[\/p][\/*][*][p][spoiler]Added correct new art that shows the in-game version of the Jahi's train part. [\/spoiler][\/p][\/*][\/list][p][\/p][p]We remain hard at work to further improve and fix any issues you might encounter. As before, if you have an issue with the game, please report it at [url=\"https:\/\/rawfury.atlassian.net\/servicedesk\/customer\/portal\/1\"]https:\/\/rawfury.atlassian.net\/servicedesk\/customer\/portal\/1[\/url] That way we can investigate your files directly.[\/p][p][\/p][p]Enjoy your adventure aboard A.R.E.S.![\/p][p][\/p][p]- The Exnilo and Raw Fury Team[\/p]","commentcount":39,"tags":["mod_reviewed","ModAct_1894963720_1790778654_0"],"language":0,"hidden":0,"forum_topic_id":"590691034935123334","event_gid":"690896126641963072","voteupcount":167,"votedowncount":4,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"590691034935123334","rtime32_last_modified":1792865699,"news_post_gid":"0","rtime_mod_reviewed":1790778654,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1790774956,"votes_up":167,"votes_down":4,"comment_type":"ForumTopic","gidfeature":"685239361818698528","gidfeature2":"590691034935123334"},{"gid":"686383649529004262","clan_steamid":"103582791475404389","event_name":"Demo Patch Notes: 0.9.68","event_type":12,"appid":4094660,"server_address":null,"server_password":null,"rtime32_start_time":1782306720,"rtime32_end_time":1782311401,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"686383649529004263","clanid":"45882981","posterid":"0","headline":"Demo Patch Notes: 0.9.68","posttime":1782306743,"updatetime":1782306743,"body":"[p]\u2728Space travelers,\u2728[\/p][p][\/p][p]Thank you for continuing to play the Rivage demo. The new patch is introducing the following fix:[\/p][p][\/p][list][*][p]rendering resolution is now being properly saved.[\/p][\/*][\/list][p][\/p][p]We continue looking into your feedback on the demo, so if you have anything to share, let us know here on Steam or in the #demo-forum channel on our Discord.[\/p][p][\/p][p]See you aboard A.R.E.S![\/p][p][\/p][p] - The Exnilo & Raw Fury Team\u00a0[\/p][p] [\/p][hr][\/hr][p]Welcome aboard mysterious A.R.E.S. - join the community to piece Miranda\u2019s captivating story together, and get immersed into the adventure fueled by the time-space phenomenon.[\/p][p] [url=\"https:\/\/x.com\/RivageTheGame\" style=\"button\"]\ud83c\udf00X\ud83c\udf00[\/url]   [url=\"https:\/\/www.facebook.com\/rivagethegame\" style=\"button\"]\ud83c\udf00Facebook\ud83c\udf00[\/url]   [url=\"https:\/\/www.instagram.com\/rivagethegame\/\" style=\"button\"]\ud83c\udf00Instagram\ud83c\udf00[\/url]   [url=\"https:\/\/www.tiktok.com\/@rivagethegame\" style=\"button\"]\ud83c\udf00TikTok\ud83c\udf00[\/url]   [url=\"https:\/\/discord.gg\/cZw4tH5Enb\" style=\"button\"]\ud83c\udf00Discord\ud83c\udf00[\/url][\/p]","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_1894963720_1782308732_0"],"language":0,"hidden":0,"forum_topic_id":"570415959124257806","event_gid":"686383649529004262","voteupcount":35,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"570415959124257806","rtime32_last_modified":1790034496,"news_post_gid":"0","rtime_mod_reviewed":1782308733,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1782306535,"votes_up":35,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"685239361818698528","gidfeature2":"570415959124257806"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["674008896091718836","690896126641963073"],"last_update_event":{"rtime":1782306720,"event_gid":"686383649529004262","announcement_gid":"686383649529004263","clan_account_id":45882981}}};

																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"704408827984878291","clan_steamid":"103582791475109056","event_name":"0.7.1-14 Fix & Optimization","event_type":13,"appid":3299050,"server_address":null,"server_password":null,"rtime32_start_time":1793094000,"rtime32_end_time":1793098801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Fixing some immediate issues.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",null,null,null,null,null,\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",null,null,null,null,null,\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"704408827984875590\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"704408827984878292","clanid":"45587648","posterid":"0","headline":"0.7.1-14 Fix & Optimization","posttime":1793094018,"updatetime":1793096461,"body":"[h2]0.7.1-14[\/h2][p][\/p][h2]Important Changes[\/h2][p]In this update, we made major changes to the experience acquisition and requirements for the skills within Ability Score Chart. Agents will now find the overall experience requirement to level skills massively reduced, and some skills had their experience acquisition changed; now the experience for obtaining experience should be on a smoother curve, and the last level of all skills should be reasonably within reach. Also, agents will no longer lost all their current skill progression upon mission failure.[\/p][list][*][p]Now agents will only lost 50% of the cumulated experience for the current level of the Ability Score Chart skills upon mission failure.[\/p][\/*][\/list][h3]Bodily Functions[\/h3][list][*][p][b]Strength[\/b]: slightly increased the experience requirement for lvl1 and lvl2, greatly reduced the experience requirement for lvl4.[\/p][\/*][*][p][b]Cardio[\/b]: slightly increased the experience requirement for lvl1, greatly reduced the experience requirement for lvl4; changed how related experience is gained:[\/p][list][*][p]Now gains experience while consuming Stamina.[\/p][\/*][*][p]Now gains extra experience while Stamina is depleted.[\/p][\/*][*][p]Due to changes in experience acquisition, some agents may experience a reduction in current level's progression. However, with the new acquisition and requirement, the time required to level up will still be shorter compared to the time required at previous skill progression.[\/p][\/*][\/list][\/*][*][p][b]Agility[\/b]: slightly increased the experience requirement for lvl1 and lvl2, greatly reduced the experience requirement for lvl3 and lvl4; changed how related experience is gained:[\/p][list][*][p]Now gains experience while actively moving in any ways.[\/p][\/*][\/list][\/*][*][p]Dexterity: slightly increased the experience requirement for lvl1 and lvl2, greatly reduced the experience requirement for lvl4.[\/p][\/*][\/list][h3]Weapon Mastery[\/h3][list][*][p]Reduced the experience requirement for all weapon's mastery levels.[\/p][list][*][p]Additionally reduced the experience requirement for all weapon's mastery level 4.[\/p][\/*][*][p]Due to difference in experience calculation, Shotgun received lower reduction in experience requirement.[\/p][\/*][\/list][\/*][\/list][p][i]*If you found one of your skills has reached max experience for the current level but not leveling up, performing any action that gives experience to this skill will trigger a recalculation of the experience that has already overflowed and resolve this issue.[\/i][\/p][p][\/p][h3]Other Skills-Related Changes[\/h3][p]Fixed that Strength experience is gained when not moving while overloaded.[\/p][p]Fixed that skills with Movement Speed penalty reduction were not working.[\/p][p][\/p][h3]Items[\/h3][p]Fixed that Attachments with low Corruption Stability will provide wrong stats on Receivers.[\/p][p]Fixed that Armor Plates slotted inside Body Armor are wrongly protected by Item Insurance.[\/p][p]Fixed that Armor Plates with depleted durability can still function.[\/p][p]Now Body Armor type equipment will display their max \\[Health] bonus.[\/p][p][\/p][h3]Animation[\/h3][p]Fixed that \"TasteBliss Group Overseer\" has a chance to play wrong animation upon death.[\/p][p]Slightly increased the animation transition speed for player character.[\/p][p][\/p][h3]Localization[\/h3][p]Changed the name of \\[Transmitter] to \\[Transceiver] to better convey its function.[\/p][p]Fixed several typos in mission script.[\/p][p]With help from a community volunteer, KillerBeanSprouts, we have overhauled parts of our Japanese localization. More improvements will come in the future. [\/p][table equalcells=\"1\" colwidth=\"616\"][tr][td colwidth=\"616\"][p][b]A message from our Japanese localizer:[\/b] [\/p][\/td][\/tr][tr][td colwidth=\"616\"][p]Hi everyone, I'm DeathMoyashi (KillerBeanSprouts), and I've taken over the Japanese localization overhauling for \u300eNo Such Place\u300f. To fully deliver the charm of the game's serious sci-fi survival world to our Japanese players, I am currently working on polishing the translation, with a strict focus on the tone and feel of the language. To ensure the most comfortable gaming experience for everyone, we will continue to update and brush up the Japanese translation in the future. If you encounter any typos, unnatural phrasing, or UI text-clipping issues in the game, please feel free to report them directly to me via DM on the official Discord @KillerBeanSprouts.[\/p][\/td][\/tr][tr][td colwidth=\"616\"][p]\u300eNo Such Place\u300f\u306e\u65e5\u672c\u8a9e\u30ed\u30fc\u30ab\u30e9\u30a4\u30ba\u6821\u6b63\u3092\u62c5\u5f53\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3057\u305f\u3001\u30c7\u30b9\u3082\u3084\u3057\u3067\u3059\u3002\u672c\u4f5c\u306e\u6301\u3064\u30b7\u30ea\u30a2\u30b9\u306aSF\u30b5\u30d0\u30a4\u30d0\u30eb\u4e16\u754c\u89b3\u306e\u9b45\u529b\u3092100\uff05\u304a\u5c4a\u3051\u3059\u3079\u304f\u3001\u8a00\u8449\u306e\u97ff\u304d\u306b\u5fb9\u5e95\u7684\u306b\u3053\u3060\u308f\u3063\u3066\u7ffb\u8a33\u306e\u6539\u826f\u3092\u9032\u3081\u3066\u304a\u308a\u307e\u3059\u3002 \u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7686\u69d8\u306b\u3088\u308a\u5feb\u9069\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u304a\u5c4a\u3051\u3059\u308b\u305f\u3081\u3001\u65e5\u672c\u8a9e\u7ffb\u8a33\u306f\u4eca\u5f8c\u3082\u7d99\u7d9a\u3057\u3066\u30d6\u30e9\u30c3\u30b7\u30e5\u30a2\u30c3\u30d7\u3092\u884c\u3063\u3066\u307e\u3044\u308a\u307e\u3059\u3002 \u3082\u3057\u30b2\u30fc\u30e0\u5185\u3067\u8aa4\u5b57\u8131\u5b57\u3001\u4e0d\u81ea\u7136\u306a\u8868\u73fe\u3001\u307e\u305f\u306fUI\u306e\u6587\u5b57\u5207\u308c\u306a\u3069\u306e\u554f\u984c\u3092\u898b\u3064\u3051\u3089\u308c\u307e\u3057\u305f\u3089\u3001\u5927\u5909\u304a\u624b\u6570\u3067\u3059\u304c\u516c\u5f0fDiscord\u306e @KillerBeanSprouts \u307e\u3067\u76f4\u63a5DM\u306b\u3066\u3054\u5831\u544a\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002[\/p][\/td][\/tr][\/table]","commentcount":11,"tags":["mod_reviewed","ModAct_1866137740_1793094176_0","ModAct_1866137740_1793096714_4"],"language":0,"hidden":0,"forum_topic_id":"567049623178316980","event_gid":"704408827984878291","voteupcount":143,"votedowncount":4,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049623178316980","rtime32_last_modified":1793406483,"news_post_gid":"0","rtime_mod_reviewed":1793096715,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793092606,"votes_up":143,"votes_down":4,"comment_type":"ForumTopic","gidfeature":"596272446063048339","gidfeature2":"567049623178316980"},{"gid":"704408827984875590","clan_steamid":"103582791475109056","event_name":"0.7.1-12 Fix & Optimization","event_type":13,"appid":3299050,"server_address":null,"server_password":null,"rtime32_start_time":1792658100,"rtime32_end_time":1792663201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"Fixing some immediate issues.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",null,null,null,null,null,\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",\"19b17b37eb979e23f051d8f1c636a8f7864b9464.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",null,null,null,null,null,\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",\"29fd0357ccddf4c5d12992c0315c250e6d40eeb9.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"clone_from_event_gid\":\"760703279879423788\",\"clone_from_sale_enabled\":false}","announcement_body":{"gid":"704408827984875591","clanid":"45587648","posterid":"0","headline":"0.7.1-12 Fix & Optimization","posttime":1792658135,"updatetime":1792658135,"body":"[h2]0.7.1-12[\/h2][p][\/p][h2]Important Changes[\/h2][p]\/\/U.R.C. departments reviewed the combat experience requirement for agent promotion and adjusted the previous evaluation criteria.[\/p][p]We adjusted the amount of experience required to increase Agent Level and the amount of experience gained from kills, now agents will no longer need an enormous amount to experience to increase their level. In future updates, we will adjust Department Skills to make each and every Department of the U.R.C. powerful and unique.[\/p][list][*][p]Significantly lowered the amount of experience required to increase Agent Level.[\/p][\/*][*][p]Significantly increased the amount of experience gained from killing nearly all enemies.[\/p][\/*][\/list][p][\/p][p]\/\/U.R.C. Operations Department and Support Department recently made new discoveries while reviewing early expedition logs of \\[Origin-00] Forest Region. The Operations Department's previous designation of the organization \"Fallen Leaf\" was wrong, this name is the call sign of a certain squad deployed to this region instead of the name of the organization they belong to. U.R.C. Operations Department has issued new recon mission to further investigate the unknown armed personnel in this Dimensional Fragment.[\/p][list][*][p]Adjusted the names of certain humanoid enemies within \\[Origin-00] Forest Region.[\/p][\/*][*][p]Adjusted the mission script of \\[Unknown Armed Personnel] and subsequent missions.[\/p][\/*][*][p]Adjusted the mission trigger and completion requirement for \\[Unknown Armed Personnel].[\/p][\/*][*][p][i]\\[REDACTED] will appear in the past, in the future...[\/i][\/p][\/*][\/list][p][\/p][h3]Weapons[\/h3][p]Changed \\[Oarin C79] from Assault Rifle to Submachine Gun.[\/p][list][*][p]Added Submachine Gun interface restriction to \\[Oarin C79 Nylon Rear Grip] and \\[Oarin C79 Foldable Stock]\u3002[\/p][\/*][\/list][p]Fixed the wrong animation for \\[AD Laser Sight] during firearm reload.[\/p][p]Fixed the wrong animation for semi-auto firearms.[\/p][p][\/p][h3]Items[\/h3][p]Increased the drop rate of \\[BLAK-TIDE Equipment Crate Key].[\/p][p][\/p][h3]Map[\/h3][p]Fixed that some enemies can spawn outside the map in \\[Origin-00] Forest Region.[\/p][p]Fixed that some cabinets in \\[Origin-12]Grey Birch Mountain were missing collision box.[\/p][p]Now agents will no longer be able to go from the Plateau to the Summit from \\[Origin-12]Grey Birch Mountain 15:35 Time Node.[\/p][p]Now agents will be left to sober by themselves when they pass out from alcohol poisoning in \\[Neutral-82] \"The Bazaar\" instead of being sent back to safehouse by Support Department.[\/p][p][\/p][h3]Enemies[\/h3][p]The TasteBliss Group's Supervisors made a shocking discovery that they have suffered severe lost to their security personnel. As such, they hired new interns to fill the spot. These interns, with high work enthusiasm, ignored some of the company's dressing code and carries less personal items.[\/p][list][*][p]\\[TasteBliss Group Supervisor] will now summon \\[TasteBliss Group Security Intern] instead of \\[TasteBliss Group Security].[\/p][\/*][*][p]\\[TasteBliss Group Security Intern] have the same performance and abilities just like formal employees, but rewards significantly less items and experience on kill.[\/p][\/*][\/list][p]Fixed that \\[Patient Zero] will not mark its killer in some cases.[\/p][p]Fixed that \\[TasteBliss Group Employee] was missing movement animation.[\/p][p][\/p][h3]Shop[\/h3][p]Fixed that some of the \u201cNew Items in Shop\u201d prompts were missing in mission rewards.[\/p][p]Optimized the content of \\[Emergency Rations & Armor Pack] in U.R.C. Terminal shop.[\/p][p][\/p][h3]UI[\/h3][p]Adjusted the inventory space display of Chest Rigs and Safe Boxes.[\/p][p]Fixed that the tooltip for Safe Box was wrongly displayed while inspecting the content of Key Rings.[\/p][p]Fixed that duplicated hints will show up when Armor Plates are broken by a single instance of damage with multiple damage type.[\/p][p]Fixed that crosshair effects will affect all players inside the same multiplayer lobby.[\/p][p][\/p][h3]Localization[\/h3][p]Made several minor improvements to English and Russian localization for better consistency.[\/p][p]Renamed \\[Gas Canister] to \\[Propane Tank].[\/p][p]Fixed a spelling error in the icon of \\[Unknown Arms Dealer].[\/p]","commentcount":15,"tags":["mod_reviewed","ModAct_1415716708_1792659374_0"],"language":0,"hidden":0,"forum_topic_id":"567049039351248312","event_gid":"704408827984875590","voteupcount":152,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049039351248312","rtime32_last_modified":1793351342,"news_post_gid":"0","rtime_mod_reviewed":1792659375,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792656670,"votes_up":152,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"596272446063048339","gidfeature2":"567049039351248312"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["704408827984878292","704408827984875591"],"last_update_event":{"rtime":1793094000,"event_gid":"704408827984878291","announcement_gid":"704408827984878292","clan_account_id":45587648}}};
						</script>
					


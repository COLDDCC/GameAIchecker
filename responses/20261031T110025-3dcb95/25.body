																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"676261964507251167","clan_steamid":"103582791475736631","event_name":"Stream Train - Content Update 01","event_type":13,"appid":4071650,"server_address":null,"server_password":null,"rtime32_start_time":1793219580,"rtime32_end_time":1793224801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"What's new in the Uncanny Valley?\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"This content update adds a new interesting location to visit, new items, new interactables, and quality of life improvements.\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"7975f11ca7261db0bce066f0c46184252f1b25bf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"96f773d9d9cbf19564d72df792e90d56560cd276.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"676261964507251168","clanid":"46215223","posterid":"0","headline":"Stream Train - Content Update 01","posttime":1793219618,"updatetime":1793219618,"body":"Hi Everyone!\n\nWe are happy to be pushing our first proper content update today. The feedback and player engagement we have gotten over the last couple of weeks has been great, hopefully you get a kick out of the new elements getting added to the game today.\n\nWe are also working on a roadmap to give you a better idea of what we plan to tackle next, and to get feedback on the direction we intend to take over the next few months. Keep an eye out for that.\n\n[h2]What's New?[\/h2]\nWe have added a brand new [i]interesting location[\/i] that can be generated in the Uncanny Valley.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/947a088d5ff7e1229a681c39e942d73fb69475f9.gif[\/img]\n\nWe have added a [i]Baby Not Deer[\/i] cryptid. Not Deer can now spawn in small herds with a baby in the group. These Not Deer will act a bit differently around players (I won't spoil the surprise). We are testing the waters for a larger Not Deer change later down the line as some players have noted that the current version of the monster feels like too much of a bully. As of right now, if a Not Deer is spawned alone, it acts in the same way as it has in the past.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/8825a561205aafd8e817ae609823fc5a3e080748.gif[\/img]\n\nCryptids can now be attracted to players depending on their held item or head gear. For now, Jackalopes are attracted to Whisky (just like real life), and Baby Not Deers are attracted to players with the antler hat. More to come as we expand on the cryptids in the game.\n\nWe have added a bunch of new items to the game. From Bigfoot Spray that you can use to make Bigfoot flee, to laser pens that you can use to better communicate with your friends. In total there are 7 new items to play with, some can be bought in the shop, and others you need to find around the valley.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/cc8c8e4947bb33cc13d93e3af21a0961d469fa96.gif[\/img]\n\nWe have added a player state system. This update adds 3 new player states, and we will look at adding more in future. Adrenaline gives players infinite stamina for a set amount of time. Some drinks can get you buzzed, which increases your speed, but causes you to ragdoll for longer if you're hit. Finally, players can get sick if they eat bad food, or just eat waaayyyy to much.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/9ded26717d4f9f4e4b5c1c09021d43343b6f5e24.gif[\/img]\n\nWe have added an old slot machine to the saloon in the town. Many players asked if there was a reason to pick up the coins they were finding on their journey. The slot machine will deposit random items as prizes if you win, so grab as many coins as you can see and try your luck. We will be adding more elements like the slot machine in future.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/de1a7835abbe7dfdcd4f3b03052204da983710bf.gif[\/img]\n\nWe have added small storage boxes to the train. You can continue to leave your items laying around in the train if you like, but these new storage boxes are great for keeping this tidy. Also, anything you put in storage in the lobby will be carried with you into the Uncanny Valley when you start a run.\n\nWe have added a new phone app that allows you to buy and sell a little crypto coin (in the game with in game currency). This is another way that players can now make money without the camera. If you lose the camera on a run and you are low on Gems, you can now play the Dino Game and the crypto market to get back on your feet.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/7ea081bdb876d215fc431028ab6be01f4006c784.gif[\/img]\n\nWe also added a new Soundboard App, so you can punctuate your content with funny sounds while you explore the valley.\n\nLastly, we have added preloading for game shaders. Some players have complained about frame drops or lag, our best guess for what is causing this was the fact that we were compiling shaders live when playing the game. That means certain effects would cause stuttering the first time they were seen by a player. With this update, it might take a little longer to load into the game, but the experience will be smooth once you're in!\n\nAlongside all of the above, we have continued to fix bugs of all shapes and sizes. We have also added a bunch of small quality of life features and polish. We are excited to hear what you think!\n\n[h2]Out Launch Discount is Ending![\/h2]\nLastly, we want to point out that the launch discount for Stream Train is coming to an end on Friday the 30th of October (approximately 17:00 CEST). If you want to grab the game (or convince a friend to buy it), there has never been a better time.\n\nhttps:\/\/store.steampowered.com\/app\/4071650\/Stream_Train\/\n\nThat's all for now, enjoy the update!\nMax.","commentcount":3,"tags":["mod_reviewed","ModAct_1878895840_1793220464_0"],"language":0,"hidden":0,"forum_topic_id":"567049673541519310","event_gid":"676261964507251167","voteupcount":17,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049673541519310","rtime32_last_modified":1793409103,"news_post_gid":"0","rtime_mod_reviewed":1793220464,"featured_app_tagid":0,"referenced_appids":[],"build_id":26279043,"build_branch":"","unlisted":0,"rtime_created":1793192354,"votes_up":17,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"579425059539654076","gidfeature2":"567049673541519310"},{"gid":"678513130127497125","clan_steamid":"103582791475736631","event_name":"A week of bug fixes and polish","event_type":28,"appid":4071650,"server_address":null,"server_password":null,"rtime32_start_time":1792775940,"rtime32_end_time":1792779360,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[\"Learning from the community and updating Stream Train for the better!\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[\"For the last 7 days, we have been listening to feedback, refining game balance, fixing bugs, and polishing the game. \",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"7975f11ca7261db0bce066f0c46184252f1b25bf.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"8bb3897723307fc25dbcd06f8801b0f6a2ecfb6f.jpg\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":false}","announcement_body":{"gid":"678513130127497126","clanid":"46215223","posterid":"0","headline":"A week of bug fixes and polish","posttime":1792775963,"updatetime":1793192403,"body":"Hi Everyone,\n\nSince launch, we have been hard at work listening to feedback, refining game balance, fixing bugs, and polishing the game. During that time we have release a range of updates and patches and we are really happy with the direction the game is moving in.\n\nWe appreciate all the feedback we got early on and we can't wait to hear what you think of the next batch of improvements we dropped today.\n\n[h2]Content Update Next Week[\/h2]\nWe are still on track to release our first content update next week on Wednesday. The coming update will introduce some new items and a new location to the game. A roadmap with our plans beyond next week will be coming SOON \ud83d\udc40\n\n[h2]What's New Today![\/h2]\nLots of updates, changes, and fixes are coming at you today. I can't outlining everything, but I will give you the headlines. Full patch notes can be found here: https:\/\/store.steampowered.com\/news\/app\/4071650\/view\/678513130127497142\n\n[h3]Lobby Experience[\/h3]\nWe have moved the \"Game Start\" interaction from the wooden barrier in front of the train to the train throttle control. This will hopefully lead to less confusion in the lobby area for new players.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/0e843b229259ff7aaf58766ef69e9a773881e6ed.gif[\/img]\n\nWe have also updated the train so that the fuel you add to it in the lobby area is reflected in the Uncanny Valley when you load the level. Items dropped on the floor in the back of the train will still be left behind when you leave though, so make sure you keep all your valuables in your pockets.\n\nAlso, we are now saving your customisation settings, so feel free to spend as long as you like setting up your look. It will be kept from session to session.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/e2fe920330aac075ffea6c7efd2b610ea856c965.jpg[\/img]\n\n[h3]Feedback[\/h3]\nGeneral pass on all SFX and VFX, adding new effects and polishing the ones we have, to make in game actions more clear.\n\nIf the Livestream Camera is ever unreachable (like dropped into water), players will see static in the Livestream App to better communicate that it is unrecoverable. You will still need to buy a replacement camera in the Shop.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/d763986b3ab4c369862a2ccee9c7320c72412073.gif[\/img]\n\n[h3]Balance[\/h3]\nYou can now earn money by playing the Dino Game. We have made this change to give players a better chance to recover if they lose the camera or if they are just a couple of gems off of a fuel purchase. This is the first of a few changes we have planned in this area. More to come next week.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/e35ee778a50f3431a001b523b5652d2403e1446a.gif[\/img]\n\nBigfoot has also been changed slightly, so it doesn't camp the train if it cannot reach players. We have also given more recovery time to players who have just been attacked.\n\n[h3]Fun Stuff[\/h3]\nThe Dino Game (TTTTTT-Rex) now has SFX, these are shared across the network, so you always know if your friends are slacking off!\n\nYou can now moderate chat messages. If you see a message you don't like, just use the Livestream App on the phone to get rid of it. This was one of the most requested features we saw in YouTube videos and on Livestreams and we are happy to oblige. Have a good time swinging the ban hammer.\n[img]{STEAM_CLAN_IMAGE}\/46215223\/915e567278b7637562212481532c07dac85f08db.gif[\/img]\n\n[h2]Stay Up To Date![\/h2]\nRemember to follow us on Steam and\/or join our Discord, so you don't miss any news. That's all for now, enjoy your weekend and keep an eye out for the update next week!\n\nCheers,\nMax.","commentcount":2,"tags":["mod_reviewed","ModAct_1878895840_1792787062_0","ModAct_1787316731_1792792677_4","ModAct_1894963720_1793192913_4"],"language":0,"hidden":0,"forum_topic_id":"572678538884554190","event_gid":"678513130127497125","voteupcount":16,"votedowncount":1,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1792775940,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"572678538884554190","rtime32_last_modified":1793241955,"news_post_gid":"0","rtime_mod_reviewed":1793192913,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1792760038,"votes_up":16,"votes_down":1,"comment_type":"ForumTopic","gidfeature":"579425059539654076","gidfeature2":"572678538884554190"},{"gid":"676261964507253119","clan_steamid":"103582791475736631","event_name":"Bugfixes v. 1.0.6c","event_type":12,"appid":4071650,"server_address":null,"server_password":null,"rtime32_start_time":1793379612,"rtime32_end_time":0,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"[]","announcement_body":{"gid":"676261964507253120","clanid":"46215223","posterid":"0","headline":"Bugfixes v. 1.0.6c","posttime":1793379612,"updatetime":1793379612,"body":"New:\n- Scroll input can be rebound\n\nBalance:\n- Player condition now restored in DYING state \n- Drinking Antidote while HEALTHY now makes players BUZZED\n\nBugfixes:\n- Small items can get lost under Solar Panel\n- Only lit lighters can be stored\n- Edible items play their eat sfx when stored\n- Bigfoot stuck on the front of a moving train\n- Banshee and Shadow person smoke VFX missing\n- Wonky collision response can occasionally launch held items when dropped\n- Camera can only be grabbed from certain angles in TRIPOD mode\n- Bigfoot clipping too much through certain walls\n- Level geometry fixes","commentcount":0,"tags":["patchnotes","mod_reviewed","ModAct_871423085_1793381046_0"],"language":0,"hidden":0,"forum_topic_id":"567049673541744769","event_gid":"676261964507253119","voteupcount":1,"votedowncount":0,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"567049673541744769","rtime32_last_modified":1793381047,"news_post_gid":"0","rtime_mod_reviewed":1793381047,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1793379612,"votes_up":1,"votes_down":0,"comment_type":"ForumTopic","gidfeature":"579425059539654076","gidfeature2":"567049673541744769"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["676261964507251168","678513130127497126"],"last_update_event":{"rtime":1793379612,"event_gid":"676261964507253119","announcement_gid":"676261964507253120","clan_account_id":46215223}}};
						</script>
					

					<div data-featuretarget="events-row"></div>
				
								
				
				


								<div id="contentForThisGame_ctn">
				</div>
									<div data-panel="{&quot;type&quot;:&quot;PanelGroup&quot;}" id="aboutThisGame" class="game_page_autocollapse" style="max-height: 850px;">
						<div id="game_area_description" class="game_area_description">
							<h2>About This Game</h2>
							<h2 class="bb_tag" style="text-align: center"><strong>A co-op horror adventure for up to 6 players!</strong></h2><p class="bb_paragraph" >Go viral or get stranded in the Uncanny Valley! Stream Train is a first-person co-op horror game where your livestream is your lifeline. Up to 6 players can get together to film cryptids, take on dangerous dares and prank their friends to keep a reactive chat entertained. Their donations pay for the fuel and gear you need to keep your train moving deeper into the valley.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a02f0758a444f7b6f89b172a4923c1f1.poster.avif?t=1793176158" aria-label="The player picks up a camera item which reveals a streaming UI. Other players pose for the camera." width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a02f0758a444f7b6f89b172a4923c1f1.webm?t=1793176158" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a02f0758a444f7b6f89b172a4923c1f1.mp4?t=1793176158" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><h2 class="bb_tag" style="text-align: center"><strong>Keep Chat Entertained</strong></h2><p class="bb_paragraph" >Your audience reacts to whatever happens on camera, makes requests, and pushes your crew to take bigger risks. Taunt cryptids, investigate derelict buildings, pull reckless stunts. The better the livestream, the more donations you earn.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/279c1835c1c01d277f6c3007bda57995.poster.avif?t=1793176158" aria-label="The player films different interesting objects around the world." width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/279c1835c1c01d277f6c3007bda57995.webm?t=1793176158" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/279c1835c1c01d277f6c3007bda57995.mp4?t=1793176158" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><h2 class="bb_tag" style="text-align: center"><strong>See What's Waiting in the Uncanny Valley</strong></h2><p class="bb_paragraph" >Leave the safety of the visitor’s centre and follow the railway deeper into the Uncanny Valley. Explore abandoned locations, hunt for useful gear, and come face-to-face with cryptids, ghosts, and other strange creatures along the way. Not everything you meet will attack on sight, but if you decide to make something angry, make sure the camera is rolling. The chat will love it.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/600e552c451fed02e9d83377be91c78d.poster.avif?t=1793176158" width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/600e552c451fed02e9d83377be91c78d.webm?t=1793176158" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/600e552c451fed02e9d83377be91c78d.mp4?t=1793176158" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><h2 class="bb_tag" style="text-align: center"><strong>Keep the Train Moving</strong></h2><p class="bb_paragraph" >Put the donations to work. Stock up on fuel and gear, then get your steam train moving toward the next stop. Every station brings you closer to escaping the Uncanny Valley, but the farther you travel, the more dangerous the journey becomes.</p><p class="bb_paragraph" >Linger too long and you might attract something you really don’t want to meet. Chat loves a close call, just make sure you’re back on the train before it becomes your last one!</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a80a2966728a3916476252d84276d2d5.poster.avif?t=1793176158" aria-label="The player uses the train controls, pulls the steam whistle, disengages the break, then activates the throttle." width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a80a2966728a3916476252d84276d2d5.webm?t=1793176158" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/a80a2966728a3916476252d84276d2d5.mp4?t=1793176158" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><h2 class="bb_tag" style="text-align: center"><strong>Every Run Brings New Encounters</strong></h2><p class="bb_paragraph" >No two trips through the Uncanny Valley play out quite the same. Each run reshuffles the points of interest along the railway, changing the locations, creatures, items, and encounters your crew will face on the journey. Some parts of the route may feel familiar, but you never know exactly what’s waiting at the next stop.</p><p class="bb_paragraph" >Make it to the end of the valley and escape with your crew. If everyone goes down, the run is over, and it’s back to the visitor’s center to try again.</p><p class="bb_paragraph" style="text-align: center"><span class="bb_img_ctn"><video class="bb_img" autoplay muted loop playsinline poster="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/9237b1caaef318d1f2d5e6bbfc4e3fef.poster.avif?t=1793176158" aria-label="The player sees a monster standing close to them, after a second, the monsters eyes turn red and it dives towards the player." width=720 height=404 ><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/9237b1caaef318d1f2d5e6bbfc4e3fef.webm?t=1793176158" type="video/webm; codecs=vp9"><source src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4071650/extras/9237b1caaef318d1f2d5e6bbfc4e3fef.mp4?t=1793176158" type="video/mp4"></video></span></p><p class="bb_paragraph" ></p><h2 class="bb_tag" >Features</h2><ul class="bb_ul"><li><p class="bb_paragraph" >Up to 6 player online co-op</p></li><li><p class="bb_paragraph" >Reactive livestream chat system</p></li><li><p class="bb_paragraph" >Procedural, run-based journey</p></li><li><p class="bb_paragraph" >Train controls</p></li><li><p class="bb_paragraph" >Character Customization</p></li><li><p class="bb_paragraph" >Physics-driven action</p></li><li><p class="bb_paragraph" >Cryptids and supernatural encounters</p></li></ul>						</div>
					</div>

<div data-featuretarget="community-awards"></div>
<script type="text/javascript">
	$J( function() {
		InitializeForumTopic( {"owner":"44858192","type":"General","feature":"0","gidforum":"596278264013526538","forum_display_name":"General Discussions","forum_url":"https:\/\/steamcommunity.com\/app\/2798330\/discussions\/0\/","forum_search_url":"https:\/\/steamcommunity.com\/app\/2798330\/discussions\/search\/","is_public":1,"permissions":{"can_view":1,"can_post":1,"can_reply":1,"is_banned":0,"can_delete":0,"can_edit":0},"appid":2798330}, "https:\/\/steamcommunity.com\/forum\/44858192\/General\/",
		"592940297913236882", {"author":"BlyZeraz","text":"I remember keeping tabs on this one now and then over the past few months but seeing the AI disclosure added now just erased any interest. Welcome to the ignore list. Not just the game but your dev and publisher pages too."}		);

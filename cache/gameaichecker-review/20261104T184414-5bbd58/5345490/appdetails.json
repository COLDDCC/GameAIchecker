ets tidier.","short_description":"Restore order to a lab left in complete chaos! Sort over 7,000 items, examine unknown samples in a centrifuge, catch escaped animals, and handle radioactive waste with care. Unlock skills and turn piles of clutter into neatly organized shelves.","supported_languages":"English, Russian, French, Italian, German, Spanish - Spain, Spanish - Latin America, Traditional Chinese, Simplified Chinese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Turkish, Japanese","header_image":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5345490\/ba93d064b3e8cc399ed8b4258bb155ef0115deea\/header.jpg?t=1793356772","capsule_image":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5345490\/290b7da29551ea210a133f2949ebd4b36c93dee7\/capsule_231x87.jpg?t=1793356772","capsule_imagev5":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5345490\/290b7da29551ea210a133f2949ebd4b36c93dee7\/capsule_184x69.jpg?t=1793356772","website":null,"pc_requirements":{"minimum":"<strong>Minimum:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Windows 10<br><\/li><li><strong>Processor:<\/strong> Intel Core i7 8700K<br><\/li><li><strong>Memory:<\/strong> 16 GB RAM<br><\/li><li><strong>Graphics:<\/strong> RTX 3060<br><\/li><li><strong>Storage:<\/strong> 5 GB available space<\/li><\/ul>","recommended":"<strong>Recommended:<\/strong><br><ul class=\"bb_ul\"><li><strong>OS:<\/strong> Windows 10<br><\/li><li><strong>Processor:<\/strong> Intel Core i7 8700K<br><\/li><li><strong>Memory:<\/strong> 16 GB RAM<br><\/li><li><strong>Graphics:<\/strong> RTX 3060<br><\/li><li><strong>Storage:<\/strong> 5 GB available space<\/li><\/ul>"},"mac_requirements":[],"linux_requirements":[],"developers":["Tovarishch Games"],"publishers":["PlayWay S.A."],"price_overview":{"currency":"CNY","initial":2000,"final":1600,"discount_percent":20,"initial_formatted":"¥ 20.00","final_formatted":"¥ 16.00"},"packages":[18
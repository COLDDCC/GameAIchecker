ts\/steam\/apps\/5352720\/6ac3a437d161d18f3786c4eaaf64a2129ddfda23\/ss_6ac3a437d161d18f3786c4eaaf64a2129ddfda23.1920x1080.jpg?t=1793028648"},{"id":5,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/a4ca86bd4f0fafefc03229f1d2c3bf5039033439\/ss_a4ca86bd4f0fafefc03229f1d2c3bf5039033439.600x338.jpg?t=1793028648","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/a4ca86bd4f0fafefc03229f1d2c3bf5039033439\/ss_a4ca86bd4f0fafefc03229f1d2c3bf5039033439.1920x1080.jpg?t=1793028648"},{"id":6,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/e28106dcb7de8d3b56f2c012c6b284d638f56388\/ss_e28106dcb7de8d3b56f2c012c6b284d638f56388.600x338.jpg?t=1793028648","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/e28106dcb7de8d3b56f2c012c6b284d638f56388\/ss_e28106dcb7de8d3b56f2c012c6b284d638f56388.1920x1080.jpg?t=1793028648"},{"id":7,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/670fe63d28e5580a8fb25e31ed9a7b5888aa2c4f\/ss_670fe63d28e5580a8fb25e31ed9a7b5888aa2c4f.600x338.jpg?t=1793028648","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/670fe63d28e5580a8fb25e31ed9a7b5888aa2c4f\/ss_670fe63d28e5580a8fb25e31ed9a7b5888aa2c4f.1920x1080.jpg?t=1793028648"},{"id":8,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/ae11b69b55399195a994545da43d8e4232fba24a\/ss_ae11b69b55399195a994545da43d8e4232fba24a.600x338.jpg?t=1793028648","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/ae11b69b55399195a994545da43d8e4232fba24a\/ss_ae11b69b55399195a994545da43d8e4232fba24a.1920x1080.jpg?t=1793028648"},{"id":9,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/5352720\/b73a5b548ab119eee9fd1bde9ec28f8